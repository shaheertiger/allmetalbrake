# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# Used only by `npm run images:fetch:all`, which matches products through the
# Amazon Creators API and writes src/data/product-images.json and
# src/data/product-asins.json. Nothing at build or runtime reads these.

# From the Amazon Product Advertising / Creators API console.
AMAZON_CREATORS_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
AMAZON_CREATORS_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxx

# Your Associates store/tracking ID. Public — it is in every outbound link.
AMAZON_CREATORS_PARTNER_TAG=sktiger-20

# Optional overrides
# AMAZON_CREATORS_VERSION=3.1
# AMAZON_CREATORS_MARKETPLACE=www.amazon.com
