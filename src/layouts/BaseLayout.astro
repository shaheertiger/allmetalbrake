---
/**
 * Shared site shell. Renders the standardized <head> with full SEO metadata
 * (canonical, Open Graph, and JSON-LD structured data) plus the global CSS and
 * shared client script. Page-specific markup is provided through <slot/>.
 */
export interface Props {
  title: string;
  description?: string;
  /** Set true for long-form article/review pages that need article.css */
  articleCss?: boolean;
  /** Emit Article/Breadcrumb/FAQ schema. Defaults to articleCss when omitted. */
  isArticle?: boolean;
  /** Raw article HTML, used to auto-extract FAQ schema. */
  articleBody?: string;
  /** Override the social-share image (absolute or root-relative path). */
  image?: string;
  /** Set true to keep the page out of search indexes (e.g. the search page). */
  noindex?: boolean;
}

const SITE = 'https://www.allmetalbrake.com';
const SITE_NAME = 'Home Fix Reviews';
const DATE_MODIFIED = '2026-06-04';
const DATE_PUBLISHED = '2026-01-15';

const {
  title,
  description = '',
  articleCss = false,
  articleBody = '',
  image = '/og-image.png',
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname.endsWith('/') || Astro.url.pathname.includes('.')
  ? Astro.url.pathname
  : Astro.url.pathname + '/';
const canonical = new URL(pathname, SITE).href;
const ogImage = new URL(image, SITE).href;
const isArticle = Astro.props.isArticle ?? articleCss;

// Short, human-readable page name derived from the SEO <title>.
const leafName = title.split(/\s+[—|]\s+|:\s/)[0].trim();

// --- Breadcrumbs -----------------------------------------------------------
const slug = pathname.replace(/^\/|\/$/g, '');
const breadcrumbItems = [{ name: 'Home', item: `${SITE}/` }];
if (slug) {
  if (slug.startsWith('best-') || slug.startsWith('reviews/')) {
    breadcrumbItems.push({ name: 'Best Lists', item: `${SITE}/best-lists/` });
  } else if (/^(how-|when-)/.test(slug)) {
    breadcrumbItems.push({ name: 'Buying Guides', item: `${SITE}/guides/` });
  }
  breadcrumbItems.push({ name: leafName, item: canonical });
}

// --- FAQ extraction --------------------------------------------------------
function stripTags(html: string): string {
  return html
    .replace(/<[^>]+>/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&#39;|&rsquo;/g, "'")
    .replace(/&quot;/g, '"')
    .replace(/&nbsp;/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

const faqItems: { q: string; a: string }[] = [];
if (articleBody) {
  const itemRe = /<div class="faq-item[^"]*">[\s\S]*?<div class="faq-question">([\s\S]*?)<\/div>[\s\S]*?<div class="faq-answer">([\s\S]*?)<\/div>\s*<\/div>/g;
  let m: RegExpExecArray | null;
  while ((m = itemRe.exec(articleBody)) !== null) {
    const q = stripTags(m[1]);
    const a = stripTags(m[2]);
    if (q && a) faqItems.push({ q, a });
  }
}

// --- Product extraction (ranked review cards) ------------------------------
type Prod = { name: string; brand: string; desc: string; rating?: number; count?: number };
const products: Prod[] = [];
if (articleBody) {
  const cards = articleBody.split(/<div class="product-card"/).slice(1);
  for (const card of cards) {
    const nameM = card.match(/<div class="product-name">([\s\S]*?)<\/div>/);
    if (!nameM) continue;
    const name = stripTags(nameM[1]);
    if (!name) continue;
    const ratingM = card.match(/<div class="rating-number">\s*([\d.]+)\s*<\/div>/);
    const countM = card.match(/<div class="rating-count">[^\d]*([\d,]+)/);
    const descM = card.match(/<div class="product-card-body">[\s\S]*?<p>([\s\S]*?)<\/p>/);
    const brand = name.split(/\s+/)[0].replace(/[^A-Za-z0-9-]/g, '');
    products.push({
      name,
      brand,
      desc: descM ? stripTags(descM[1]) : '',
      rating: ratingM ? parseFloat(ratingM[1]) : undefined,
      count: countM ? parseInt(countM[1].replace(/,/g, ''), 10) : undefined,
    });
  }
}

// --- JSON-LD ---------------------------------------------------------------
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: `${SITE}/`,
  logo: `${SITE}/favicon.svg`,
  description:
    'Independent, hands-on home improvement product reviews and buying guides. We buy and test every product we recommend.',
  sameAs: [],
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: `${SITE}/`,
  description:
    'Expert-tested reviews and buying guides for driveway sealers, deck stains, garage floor epoxy, power tools, and more.',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE}/search/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const graph: any[] = [];
if (isArticle) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: c.item,
    })),
  });
  graph.push({
    '@type': 'Article',
    headline: leafName,
    description,
    image: ogImage,
    author: { '@type': 'Organization', name: SITE_NAME, url: `${SITE}/` },
    publisher: {
      '@type': 'Organization',
      name: SITE_NAME,
      logo: { '@type': 'ImageObject', url: `${SITE}/favicon.svg` },
    },
    datePublished: DATE_PUBLISHED,
    dateModified: DATE_MODIFIED,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  });
  if (faqItems.length) {
    graph.push({
      '@type': 'FAQPage',
      mainEntity: faqItems.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    });
  }
  for (const p of products) {
    const node: any = {
      '@type': 'Product',
      name: p.name,
      description: p.desc,
      brand: { '@type': 'Brand', name: p.brand },
    };
    if (p.rating != null) {
      node.aggregateRating = {
        '@type': 'AggregateRating',
        ratingValue: p.rating,
        reviewCount: p.count ?? 1,
      };
    }
    graph.push(node);
  }
}
const articleGraph = graph.length
  ? { '@context': 'https://schema.org', '@graph': graph }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    <!-- Open Graph -->
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1a1f36" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    {articleCss && <link rel="stylesheet" href="/css/article.css" />}
    <style is:global>
      body { font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif; }
    </style>

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    {articleGraph && (
      <script type="application/ld+json" set:html={JSON.stringify(articleGraph)} />
    )}
  </head>
  <body>
    <slot />
    <script is:inline src="/js/main.js"></script>
  </body>
</html>
