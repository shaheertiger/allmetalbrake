const title = "How to Get Oil Out of Concrete: What Actually Works in 2026";
const description =
  "Step-by-step methods for removing fresh and old oil stains from concrete — poultices, degreasers, enzymes, and what to skip. Tested results.";

const PRODUCTS = [
  {
