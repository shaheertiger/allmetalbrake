---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/privacy.html?raw';

const title = "Privacy Policy — Home Fix Reviews";
const description = "Home Fix Reviews privacy policy: learn what data we collect, how we use cookies and analytics, our affiliate disclosures, and how we keep your information safe.";
---

<BaseLayout title={title} description={description} articleCss={false} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
