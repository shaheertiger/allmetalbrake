---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/best-deck-sealant.html?raw';

const title = "Best Deck Sealant in 2026: Clear vs Toned, and What Lasts";
const description = "A clear deck sealant stops water but not UV, so the deck greys anyway. What sealant actually does, how the categories compare, and which suits your deck.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
