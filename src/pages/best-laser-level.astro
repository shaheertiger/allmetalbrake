    ],
    "cons": [
      "Expensive for occasional home use",
      "Larger and heavier than a cross-line"
    ],
    "bottomLine": "The laser to buy for remodeling, cabinets and tile work where you want every reference line at once.",
    "amazonUrl": ""
  },
  {
    "id": "dewalt-dw089lg",
    "name": "DeWalt DW089LG 3x360 Green Laser",
    "category": "Three 360-degree green planes, 12V/20V battery",
