const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Laser Level Picks",
          item: "https://www.allmetalbrake.com/best-laser-level/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which laser level should a homeowner buy first?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A compact self-leveling cross-line laser, such as the Bosch GLL55, covers most household jobs: shelves, art, televisions, curtain rods and trim. Choose a green version if your rooms are bright. Move up to a three-plane laser only when you take on cabinets, tile, framing or ceilings, and to a rotary only for outdoor grading."
          }
        },
        {
          "@type": "Question",
          "name": "Are green beams really easier to see than red?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The eye is more sensitive to green light, so a green beam appears several times brighter than a red beam of similar output. That makes green lines readable at longer distances and in sunlit rooms. Red lasers cost less and run longer on batteries, and they are fine for short distances in controlled light."
          }
        },
        {
          "@type": "Question",
          "name": "Will a laser level work outside?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A line laser alone is hard to see outdoors in daylight, even in green. For outside work, use a laser with a pulse mode and a compatible detector, or a rotary laser kit. The receiver picks up the beam electronically and sounds a tone when it is on the plane, which works in full sun at long distances."
          }
        },
        {
          "@type": "Question",
          "name": "What accuracy do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For hanging and shelving, any self-leveling laser rated around an eighth of an inch at 30 feet is more than precise enough. For long cabinet runs, large tile floors and drop ceilings, look for ratings closer to a sixteenth of an inch at 30 feet, and check the tool against two walls before starting."
          }
        },
        {
          "@type": "Question",
          "name": "Should I choose a cross-line or a 360 laser?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Choose a cross-line if most of your work is on one wall at a time. Choose a 360 or three-plane laser when you need the same level line on every wall of a room, or plumb lines on the floor and ceiling, such as for cabinets, framing and drop ceilings. Many homeowners own both."
          }
        },
        {
          "@type": "Question",
          "name": "Is a tripod necessary, or can I skip it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not always, but it helps. A tripod lets you set the line height precisely and keeps the laser steady. Many lasers include a magnetic bracket or clamp that works on studs, shelves or doors. For grading with a rotary, a sturdy tripod and a grade rod are essentially required."
          }
        },
        {
          "@type": "Question",
          "name": "Are laser levels safe to use around kids and pets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They are designed to be safe when used as directed, but never look into the beam or point it at anyone's eyes, including pets. Most are Class 2 or 3R lasers. Switch the tool off when you leave it, keep it out of reach of children, and avoid setting it at eye height in busy rooms."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
