const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 7 Best Laser Levels: Cross-Line, 360 and Rotary Ranked";
const description =
  "Seven laser levels ranked by job, from compact cross-lines for shelves to three-plane green lasers and a rotary for grading, plus how to read accuracy and range.";

const PRODUCTS = [
  {
    "id": "bosch-gll3-330cg",
    "name": "Bosch Three-Plane Green GLL3-330CG",
