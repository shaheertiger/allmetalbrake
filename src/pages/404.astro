---
import Layout from "../layouts/Layout.astro";

const title = "Page Not Found";
const description = "That page does not exist. Here is where to go instead.";

const HUBS = [
  { title: "All Buyer's Guides", body: "Every tested guide we have published, by category.", url: "/best-of/" },
  { title: "Garage Floors", body: "Epoxy, polyaspartic and tile systems compared.", url: "/best-garage-floor-epoxy/" },
  { title: "Outdoor Power", body: "Generators, power stations and pressure washers.", url: "/best-home-generator-for-power-outages/" },
  { title: "How We Test", body: "Our process, our funding, and what our verdicts mean.", url: "/how-we-test/" },
  { title: "Contact Us", body: "Found a broken link? Tell us and we will fix it.", url: "/contact/" },
];
---

<Layout title={title} description={description} noindex={true}>
  <article class="max-w-3xl mx-auto px-4 py-20 lg:py-28">
    <p class="text-xs font-black uppercase tracking-widest text-[#FF4500] mb-4">Error 404</p>
    <h1 class="text-4xl lg:text-5xl font-black text-gray-900 leading-tight mb-6">
      That page is not here
    </h1>
    <p class="text-xl text-gray-600 leading-relaxed mb-10">
      The link may be mistyped, or the guide may have been renamed or replaced. Everything we publish is reachable from the pages below.
    </p>

    <div class="grid sm:grid-cols-2 gap-4 mb-12">
      {HUBS.map((h) => (
        <a href={h.url} class="bg-gray-50 border border-gray-200 rounded-2xl p-6 no-underline hover:shadow-md transition-shadow group">
          <p class="text-gray-900 font-black text-lg group-hover:text-[#1E90FF] transition-colors m-0">{h.title}</p>
          <p class="text-sm text-gray-500 mt-2 m-0">{h.body}</p>
        </a>
      ))}
    </div>

    <div class="border-t border-gray-200 pt-8">
      <p class="text-gray-700 leading-relaxed m-0">
        If you followed a link from another site and landed here, <a href="/contact/" class="text-[#1E90FF] font-bold no-underline hover:underline">let us know</a> — we would rather fix it than lose you.
      </p>
    </div>
  </article>
</Layout>
