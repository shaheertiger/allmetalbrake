---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found | All Metal Brake" description="The page you were looking for could not be found." noindex>
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <p class="text-6xl" aria-hidden="true">⚡</p>
    <h1 class="mt-4 text-3xl font-extrabold">Page not found</h1>
    <p class="mt-3 text-slate-600">That page has moved or never existed. Try one of our most popular guides:</p>
    <p class="mt-6 flex flex-wrap justify-center gap-3 text-sm">
      <a href="/best-home-generator-for-power-outages/" class="underline text-brand-600">Home generators</a>
      <a href="/best-portable-power-station/" class="underline text-brand-600">Power stations</a>
      <a href="/best-generator-transfer-switch/" class="underline text-brand-600">Transfer switches</a>
      <a href="/best-of/" class="underline text-brand-600">All best lists</a>
    </p>
  </div>
</Base>
