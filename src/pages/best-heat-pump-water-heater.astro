---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Gas Water Heaters",
    "url": "/best-gas-water-heater/"
  },
  {
    "title": "Best Basement Dehumidifiers",
    "url": "/best-dehumidifier-for-basement/"
  },
  {
    "title": "Best Whole House Fans",
    "url": "/best-whole-house-fan/"
  },
  {
    "title": "Best Whole House Surge Protector",
    "url": "/best-whole-house-surge-protector/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "6 Best Heat Pump Water Heaters (2026): Where Each One Fits";
const description =
  "The Rheem ProTerra 50-gallon hybrid is the best heat pump water heater for most homes; the top units deliver 3 to 4 units of heat per unit of power. 6 picks.";

const PRODUCTS = [
  {
    "name": "Rheem ProTerra Hybrid 50 Gallon",
    "badge": "Best Overall",
    "category": "240V Hybrid, 50 Gallon",
    "amazonUrl": "",
    "id": "rheem-proterra-50",
    "pros": [
      "UEF in the high 3s to around 4 depending on version, among the highest available",
      "Multiple modes, from heat-pump-only to high-demand hybrid",
      "Wi-Fi app with leak detection and scheduling on connected versions",
      "Long tank and parts warranty, up to 10 years per Rheem",
      "Widely sold, with broad installer familiarity"
    ],
    "cons": [
      "Needs a 240-volt circuit and a condensate drain",
      "Requires substantial surrounding air space or ducting"
    ],
    "bottomLine": "The best all-around pick for a basement or garage that has room around the tank and a 240-volt circuit.",
    "description": "Rheem has made the ProTerra its flagship heat pump water heater for several generations, and the 50-gallon version is where most households should begin. Its Uniform Energy Factor ranks among the highest in the category, from the high 3s to around 4 depending on the exact version, which means a large cut in electricity use compared with a resistance tank. Several operating modes let you trade between maximum efficiency and faster recovery, and connected versions add Rheem's app for scheduling, vacation settings, energy tracking and leak alerts. Leak detection earns its keep on an appliance that holds 50 gallons of water in a basement. Rheem covers the tank and parts with a warranty of up to 10 years. The site requirements match most hybrids: a 240-volt circuit, a condensate drain and plenty of surrounding air, typically several hundred cubic feet, or ducting or louvered doors in a smaller room. Owners commonly report big drops in their electric bills, along with the usual note that recovery is slower in heat-pump-only mode."
  },
  {
    "name": "A.O. Smith Voltex AL Hybrid, 66 Gallon",
    "badge": "Best for Big Households",
    "category": "240V Hybrid, Larger Tank",
    "amazonUrl": "",
    "id": "ao-smith-voltex-al",
    "pros": [
      "Available in larger tank sizes, including 66 and 80 gallons",
      "High first-hour delivery in hybrid mode for larger families",
      "Strong efficiency ratings across the line",
      "Connected controls on current versions",
      "Well-supported by professional installers"
    ],
    "cons": [
      "Large and heavy; check stairs and doorways before ordering",
      "Costs more than 50-gallon units"
    ],
    "bottomLine": "The pick for four or more people, where a bigger tank stops slower heat pump recovery from turning into cold showers.",
    "description": "Running out of hot water is the complaint heard most often about heat pump water heaters, and the usual cause is a tank sized like the electric resistance model it replaced. A heat pump reheats more slowly, so a bigger tank is the simple cure, and A.O. Smith builds its Voltex AL hybrids in sizes up to 80 gallons. The 66-gallon model suits a household of four or five, with a first-hour rating in hybrid mode that keeps up with back-to-back morning showers. Efficiency ratings are strong across the line, so moving to the larger tank costs little in running expense. Current versions add connected controls for scheduling and monitoring. The compromises are size and price. A 66-gallon heat pump water heater is tall, wide and heavy, and the heat pump module on top adds more height, so measure the ceiling, stairwell and doorways before ordering. It also costs more than a 50-gallon unit, but for a bigger household that premium is cheaper than living with a tank that runs short every morning."
  },
  {
    "name": "Rheem ProTerra Plug-In 120V Heat Pump Water Heater",
    "badge": "Best No-Rewire Option",
    "category": "120V Plug-In, 50 or 65 Gallon",
    "amazonUrl": "",
    "id": "rheem-proterra-plug-in-120v",
    "pros": [
      "Plugs into a standard 120-volt outlet, avoiding a new 240-volt circuit in many homes",
      "Can often share an existing circuit with a compatible configuration",
      "High efficiency rating",
      "Available in larger tank sizes to offset slower recovery",
      "Simplifies replacing a gas tank where the panel is full"
    ],
    "cons": [
      "Slower recovery than 240-volt hybrids",
      "Little or no resistance backup, so sizing up is essential"
    ],
    "bottomLine": "The pick when a new 240-volt circuit would force a costly panel upgrade, as long as you choose a generous tank size.",
    "description": "When people switch from gas to a heat pump water heater, the cost that surprises them is often electrical. A typical 240-volt hybrid needs its own 30-amp circuit, and in a full or undersized panel the electrical work can approach the price of the heater itself. Rheem's ProTerra Plug-In models run on ordinary 120-volt power, and certain configurations are built to share an existing circuit, which can turn a complicated job into a far simpler one. What you give up is recovery speed. A 120-volt unit leans mostly on its heat pump, without the large resistance elements a 240-volt hybrid uses to catch up quickly, so it reheats more slowly after heavy use. Rheem sells larger tank sizes to make up for it, and the larger tank is strongly recommended for anything beyond a small household. Owners who sized up commonly say they never notice the slower recovery in daily life; those who did not often run short. If your panel can take a 240-volt circuit, a standard hybrid is more flexible. If it cannot, this is the most practical route."
  },
  {
    "name": "Bradford White AeroTherm Series",
    "badge": "Best Pro-Installed",
    "category": "240V Hybrid, 50 to 80 Gallon",
    "amazonUrl": "",
    "id": "bradford-white-aerotherm",
    "pros": [
      "Sold and supported through professional plumbers",
      "Range of tank sizes from 50 to 80 gallons",
      "Multiple operating modes",
      "Strong reputation among installers for durability",
      "Clear service and parts channel through the installer"
    ],
    "cons": [
      "Not available at retail, so pricing is through the contractor",
      "Fewer smart features than some competitors"
    ],
    "bottomLine": "A dependable choice for homeowners who want a plumber-supplied unit with a clear chain of support.",
    "description": "Bradford White sells only through professional plumbers, and that shapes the AeroTherm series: a heat pump water heater designed around the installer and supported through the contractor who fits it. The range runs from 50 to 80 gallons, so a plumber can match capacity to the household without changing brands, and it offers several operating modes from efficiency-first to high demand. Plumbers have long regarded Bradford White tanks as durable, and the AeroTherm line carries that reputation into hybrid units. It puts less emphasis on apps and connected features than Rheem, which some owners count as a plus and others as a gap. Because the purchase goes through a contractor, the price includes their markup and labor, which makes side-by-side comparison harder but leaves you with one point of contact for service and warranty claims. If a plumber you already trust carries Bradford White, this is a straightforward, well-supported option that is likely to be installed correctly the first time."
  },
  {
    "name": "Ruud Ultra Series Hybrid 50 Gallon",
    "badge": "Best Value",
    "category": "240V Hybrid, 50 Gallon",
    "amazonUrl": "",
    "id": "ruud-ultra-hybrid",
    "pros": [
      "Shares much of its engineering with Rheem hybrids",
      "High efficiency rating for the price",
      "Multiple operating modes",
      "Often priced below the ProTerra",
      "Sold through contractors, with broad parts availability"
    ],
    "cons": [
      "Fewer retail channels, so typically bought through an installer",
      "Connected features vary by version"
    ],
    "bottomLine": "Much of what the ProTerra offers for less money, if your installer carries Ruud.",
    "description": "Ruud and Rheem are sister brands owned by the same parent company, and the Ruud Ultra Series hybrid shares much of its engineering with Rheem's heat pump water heaters. Its efficiency rating sits in the same high range, its operating modes are comparable, and parts and service knowledge overlap heavily, which helps with long-term support. Distribution is the main difference. Ruud sells mostly through contractors rather than home centers, so it usually arrives as part of an installation quote. That can work for you, because contractors who carry Ruud often price the Ultra hybrid below a ProTerra of similar capacity. Connected features differ by version, so if leak alerts or app control matter, confirm the exact model before you sign. Owners and installers generally describe it as dependable and efficient, with little to set it apart from its Rheem sibling beyond the badge and the price. If one of your quotes comes back with a Ruud hybrid for less, there is little reason to hold out for the Rheem."
  },
  {
    "name": "SanCO2 Split Heat Pump Water Heater",
    "badge": "Best for Cold Climates",
    "category": "CO2 Split System, Outdoor Compressor",
    "amazonUrl": "",
    "id": "sanden-sanco2-split",
    "pros": [
      "Outdoor heat pump uses CO2 refrigerant and is rated to operate well below freezing per the maker",
      "Indoor tank has no heat pump on top, so no indoor noise or cooling",
      "Very high delivered water temperatures",
      "Long expected service life",
      "Works where indoor air space is limited"
    ],
    "cons": [
      "Expensive, often several times the cost of an integrated hybrid",
      "Requires a specialist installer and outdoor unit placement"
    ],
    "bottomLine": "A premium answer for cold climates or tight homes where an integrated hybrid cannot draw enough warm air.",
    "description": "The SanCO2 moves the heat pump outside. A compact outdoor unit that uses carbon dioxide as its refrigerant heats the water and sends it through insulated lines to a separate storage tank indoors. That layout fixes two weaknesses of integrated hybrids. First, the indoor tank neither cools nor dehumidifies the room, and there is no compressor noise inside the house. Second, the maker rates the CO2 heat pump to keep working at outdoor temperatures well below freezing, whereas integrated hybrids need the indoor air to stay above roughly the 40s. CO2 systems also make very hot water efficiently, so a smaller tank can supply more usable hot water through a mixing valve. The drawbacks are price and installation. At the time of writing the system costs several times as much as an integrated hybrid, and it needs an installer who knows split systems plus an outdoor spot for the unit. For a tight, well-insulated house in a cold region, or a home with no suitable indoor space, it is the strongest heat pump option available."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Heat Pump Water Heater",
          item: "https://www.allmetalbrake.com/best-heat-pump-water-heater/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which heat pump water heater should most households buy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Rheem ProTerra 50-gallon hybrid is the best fit for most homes that have a basement or garage and a 240-volt circuit, thanks to its efficiency, controls and warranty. Bigger households should move to a 65 or 66-gallon model such as the A.O. Smith Voltex AL. Where a new 240-volt circuit would be costly, a generously sized 120-volt plug-in model is the practical choice."
          }
        },
        {
          "@type": "Question",
          "name": "Is it worth replacing a working gas water heater with a heat pump?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "That depends on local gas and electricity prices, the rebates available and whether new electrical work is needed. Payback against a gas tank usually takes longer than against an electric resistance tank, and where gas is cheap it may never come. Many homeowners wait until the gas heater is near the end of its life, then compare installed and running costs side by side."
          }
        },
        {
          "@type": "Question",
          "name": "How cold can the space be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most integrated units keep running the heat pump down to somewhere around 37 to 45 degrees, depending on the model, then switch to resistance heat. Efficiency also falls as the air cools, so spaces that stay above the high 40s give the best results. For a cold garage or a cold climate, a split system with an outdoor CO2 heat pump is the better match."
          }
        },
        {
          "@type": "Question",
          "name": "How loud is a heat pump water heater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Published sound levels typically fall roughly between the mid-40s and mid-50s decibels, comparable to a refrigerator or a quiet window air conditioner. Most owners with the unit in a basement or garage stop noticing it after a while. If noise would bother you, keep it out of a closet beside a bedroom or main living area."
          }
        },
        {
          "@type": "Question",
          "name": "Does a heat pump water heater dehumidify the room?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Pulling heat from the air also pulls out moisture, which leaves as condensate through the drain line. In a damp basement that can noticeably lower summer humidity and ease the load on a dehumidifier. It helps, but it does not replace proper moisture control in a basement that has water problems."
          }
        },
        {
          "@type": "Question",
          "name": "What maintenance does a heat pump water heater need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clean the air filter every few months and make sure the condensate drain runs freely. Once a year, drain a few gallons from the tank to cut sediment and test the relief valve. Check the anode rod every few years if the design has one. Connected models often send filter and fault alerts through their app."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a new circuit for a heat pump water heater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 240-volt hybrid needs its own 240-volt circuit, typically 30 amps, which is usually already in place when an electric tank is being replaced. Swapping out a gas tank may mean running a new circuit and possibly upgrading the panel. A 120-volt plug-in model avoids that, and some can share an existing circuit, but they recover more slowly."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Air, Mold & Water Heaters",
    tags: [
      "best heat pump water heater",
      "hybrid water heater",
      "120v heat pump water heater",
      "heat pump water heater cost",
      "water heater efficiency",
      "uef rating"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          Best Heat Pump Water Heater
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          The Rheem ProTerra 50-gallon hybrid is the best heat pump water heater for most homes, and the top units turn each unit of electricity into three to four units of heat. Air space, room temperature, voltage and tank size can change the pick. This guide compares six models, then covers sizing, placement, cold spaces, payback, installation and upkeep.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/shaheer-ali-khan/" class="font-bold text-gray-900 no-underline hover:underline">Shaheer Ali Khan</a></p>
            <p class="text-xs text-gray-500 m-0">Materials &amp; Product Performance Specialist &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          Based on published UEF and first-hour ratings, operating ranges, warranties, and owner and installer feedback. Not hands-on tested. No paid placements. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">14 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#short-answer" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>The Short Answer</span></a>
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>The 6 Best, Ranked</span></a>
              <a href="#how-it-saves" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>How Does It Save Energy?</span></a>
              <a href="#types" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>240V, 120V or Split?</span></a>
              <a href="#sizing" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>What Size Do You Need?</span></a>
              <a href="#space" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Where Can It Go?</span></a>
              <a href="#cold" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Will It Work in a Cold Garage?</span></a>
              <a href="#payback" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>How Much Does It Save?</span></a>
              <a href="#install" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>What Does Installation Cost?</span></a>
              <a href="#noise" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Is It Noisy?</span></a>
              <a href="#modes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>Which Mode to Use?</span></a>
              <a href="#upkeep" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">12.</span><span>How Long Does It Last?</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">13.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">14.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A resistance water heater converts one unit of electricity into roughly one unit of heat. A heat pump model instead pulls warmth from the surrounding air and moves it into the water, and the best ones deliver three to four units of hot-water energy for every unit of electricity they use. That efficiency is the entire argument for them. The trade-offs: they need breathing room, they perform best in spaces that stay above the 40s, and they reheat more slowly than the tank you have now.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Best Heat Pump Water Heater: The Short Answer
          </h2>

          <p>
            Buy the <strong>Rheem ProTerra Hybrid 50 Gallon</strong> if you have a basement or garage with room around it and a 240-volt circuit. Households of four or more should move up to the 66-gallon <strong>A.O. Smith Voltex AL</strong>. If a new 240-volt circuit would mean a panel upgrade, choose the <strong>Rheem ProTerra Plug-In 120V</strong> and size it up. Buy through a plumber for the <strong>Bradford White AeroTherm</strong> or the lower-priced <strong>Ruud Ultra</strong>, and look at the <strong>SanCO2</strong> split for cold climates.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pick</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Capacity</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">UEF</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">First-hour rating</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Voltage</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Rheem ProTerra Hybrid 50</td>
