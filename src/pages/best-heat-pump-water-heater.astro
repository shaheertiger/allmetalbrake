---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Gas Water Heaters",
    "url": "/best-gas-water-heater/"
  },
  {
    "title": "Best Basement Dehumidifiers",
    "url": "/best-dehumidifier-for-basement/"
  },
  {
    "title": "Best Whole House Fans",
    "url": "/best-whole-house-fan/"
  },
  {
    "title": "Best Whole House Surge Protector",
    "url": "/best-whole-house-surge-protector/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 6 Best Heat Pump Water Heaters: Where Each One Fits";
const description =
  "Six heat pump water heaters compared on efficiency, first-hour rating, voltage, space, and noise, with honest payback math and the install details that matter.";

const PRODUCTS = [
  {
    "name": "Rheem ProTerra Hybrid 50 Gallon",
    "badge": "Best Overall",
    "category": "240V Hybrid, 50 Gallon",
    "amazonUrl": "",
    "id": "rheem-proterra-50",
    "pros": [
      "UEF in the high 3s to around 4 depending on version, among the highest available",
      "Multiple modes, from heat-pump-only to high-demand hybrid",
      "Wi-Fi app with leak detection and scheduling on connected versions",
      "Long tank and parts warranty, up to 10 years per Rheem",
      "Widely sold, with broad installer familiarity"
    ],
    "cons": [
      "Needs a 240-volt circuit and a condensate drain",
      "Requires substantial surrounding air space or ducting"
    ],
    "bottomLine": "The best all-around heat pump water heater for a basement or garage with space and a 240-volt circuit.",
    "description": "The ProTerra line has been Rheem's flagship heat pump water heater for several generations, and the 50-gallon model is the one most households should start with. Its Uniform Energy Factor sits among the highest in the category, in the high 3s to around 4 depending on the exact version, which translates to a large reduction in electricity use compared with a resistance tank. Several operating modes let you choose between maximum efficiency and faster recovery, and connected versions use Rheem's app for scheduling, vacation settings, energy tracking, and leak alerts. That leak detection is genuinely useful on an appliance that sits in a basement holding 50 gallons of water. Rheem backs the tank and parts with up to a 10-year warranty. The practical requirements are the same as most hybrids: a 240-volt circuit, a condensate drain, and enough surrounding air, typically several hundred cubic feet, or ducting or louvered doors in a smaller space. Owners commonly report large drops in their electric bills, with the usual note that recovery is slower in heat-pump-only mode."
  },
  {
    "name": "A.O. Smith Voltex AL Hybrid, 66 Gallon",
    "badge": "Best for Big Households",
    "category": "240V Hybrid, Larger Tank",
    "amazonUrl": "",
    "id": "ao-smith-voltex-al",
    "pros": [
      "Available in larger tank sizes, including 66 and 80 gallons",
      "High first-hour delivery in hybrid mode for larger families",
      "Strong efficiency ratings across the line",
      "Connected controls on current versions",
      "Well-supported by professional installers"
    ],
    "cons": [
      "Large and heavy; check stairs and doorways before ordering",
      "Costs more than 50-gallon units"
    ],
    "bottomLine": "The right pick for four or more people, where a bigger tank keeps slower heat pump recovery from becoming a cold-shower problem.",
    "description": "The most common complaint about heat pump water heaters is running out of hot water, and the most common cause is a tank that was sized like the electric resistance unit it replaced. Because a heat pump reheats water more slowly, a larger tank is the straightforward fix, and A.O. Smith's Voltex AL hybrids come in sizes up to 80 gallons. The 66-gallon model is a good middle ground for a household of four or five, with a first-hour rating in hybrid mode that covers stacked morning showers. Efficiency ratings across the line are strong, so the bigger tank does not mean giving up much in running cost. Current versions include connected controls for scheduling and monitoring. The trade-offs are physical and financial. A 66-gallon heat pump water heater is tall, wide, and heavy, and the heat pump module on top adds height, so measure the ceiling, stairwell, and doorways before buying. It also costs more than a 50-gallon unit. For bigger households, that extra cost is cheaper than living with a tank that runs short every morning."
  },
  {
    "name": "Rheem ProTerra Plug-In 120V Heat Pump Water Heater",
    "badge": "Best No-Rewire Option",
    "category": "120V Plug-In, 50 or 65 Gallon",
    "amazonUrl": "",
    "id": "rheem-proterra-plug-in-120v",
    "pros": [
      "Plugs into a standard 120-volt outlet, avoiding a new 240-volt circuit in many homes",
      "Can often share an existing circuit with a compatible configuration",
      "High efficiency rating",
      "Available in larger tank sizes to offset slower recovery",
      "Simplifies replacing a gas tank where the panel is full"
    ],
    "cons": [
      "Slower recovery than 240-volt hybrids",
      "Little or no resistance backup, so sizing up is essential"
    ],
    "bottomLine": "The pick when adding a 240-volt circuit would mean a costly panel upgrade, provided you size the tank generously.",
    "description": "The biggest hidden cost in switching from gas to a heat pump water heater is often electrical. A typical 240-volt hybrid needs a dedicated 30-amp circuit, and if the panel is full or undersized, the electrical work can rival the price of the heater. Rheem's ProTerra Plug-In models run on standard 120-volt power, and certain configurations are designed to share an existing circuit, which can turn a complicated job into a far simpler one. The trade-off is recovery speed. A 120-volt unit relies mostly on its heat pump, without the large resistance elements that 240-volt hybrids use to catch up quickly, so it reheats more slowly after heavy use. Rheem offers larger tank sizes to compensate, and choosing the larger tank is strongly recommended for anything beyond a small household. Owners who sized up commonly report the slower recovery is unnoticeable in daily life; those who did not often run short. If your panel has room for a 240-volt circuit, a standard hybrid is more flexible. If it does not, this is the most practical route."
  },
  {
    "name": "Bradford White AeroTherm Series",
    "badge": "Best Pro-Installed",
    "category": "240V Hybrid, 50 to 80 Gallon",
    "amazonUrl": "",
    "id": "bradford-white-aerotherm",
    "pros": [
      "Sold and supported through professional plumbers",
      "Range of tank sizes from 50 to 80 gallons",
