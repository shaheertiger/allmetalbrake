---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/barn-door-vs-french-door.html?raw';

const title = "Barn Door vs. French Door vs. Pocket Door — Cost & Which to Choose | Home Fix Reviews";
const description = "Sliding barn doors, French doors and pocket doors solve the same problem in completely different ways. Real installed costs, floor and wall space requirements, sound blocking, and which one belongs in each room.";
