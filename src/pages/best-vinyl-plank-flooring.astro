];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 7 Best Vinyl Plank Floors: Ranked by Room and Budget";
const description =
  "Seven luxury vinyl plank lines compared on wear layer, core type, pad and warranty, plus how to pick SPC or WPC, prep the subfloor and avoid the mistakes that void it.";

const PRODUCTS = [
  {
    "id": "coretec-plus-premium",
    "name": "COREtec Plus Premium",
    "category": "Cork-Backed WPC, 20 mil Top Layer",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "Thick 20 mil wear layer for busy rooms",
      "Attached cork back is quiet and warm underfoot",
      "Long, wide planks with realistic visuals",
      "Widely sold through flooring dealers",
      "Tolerates many slight subfloor flaws thanks to a thick core"
    ],
    "cons": [
      "Priced at the top of the residential range",
      "Foamed WPC core can dent under narrow, heavy loads"
    ],
    "bottomLine": "The comfortable, quiet premium plank for main living areas where budget allows.",
    "description": "COREtec effectively created the rigid-core category, and the Plus Premium line is its comfort-focused flagship. It pairs a thick WPC core with an attached cork underlayment, so it walks softer and sounds less hollow than most stone-core planks, which owners commonly mention after living with it. The 20 mil wear layer, per the brand's specs, suits kitchens, family rooms and pet households. Planks are long and wide in many colors, so a room looks less busy and there are fewer seams to stagger. The thicker core bridges small subfloor flaws better than thin planks, though you still need to hit the flatness tolerance. The caveats are price, typically at the upper end of what homeowners pay for vinyl, and the foamed core's susceptibility to dents from narrow furniture feet and appliances, which wide coasters solve. If you want vinyl's waterproofing without the hard, clicky feel, this is the line to look at first."
  },
  {
    "id": "lifeproof-rigid-core",
    "name": "Lifeproof Rigid Core",
