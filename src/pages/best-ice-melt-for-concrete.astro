---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Paver Sealer",
    "url": "/best-paver-sealer/"
  },
  {
    "title": "Best Water-Based Paver Sealers",
    "url": "/best-water-based-paver-sealer-reviews/"
  },
  {
    "title": "How to Stain a Concrete Patio to Look Like Stone",
    "url": "/how-to-stain-concrete-patio-to-look-like-stone/"
  },
  {
    "title": "How to Seal a Concrete Driveway",
    "url": "/how-to-seal-a-concrete-driveway/"
  },
  {
    "title": "Best Polymeric Sand for Pavers",
    "url": "/best-polymeric-sand/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "7 Best Ice Melts for Concrete (2026): Gentlest Chemistry First";
const description =
  "Snow Joe Melt-2-Go Nature+, a CMA blend, tops 7 ice melts for concrete; keep de-icers off a new slab its first winter and shovel brine off to limit scaling.";

const PRODUCTS = [
  {
    "id": "snow-joe-melt-2-go",
    "name": "Snow Joe Melt-2-Go Nature+ CMA-Blended Ice Melter",
    "category": "Chloride Blend With CMA",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "CMA in the blend reduces corrosiveness versus plain salt",
      "Melts faster than pure acetate products",
      "Marketed as gentler on pets and plants",
      "Sold in jugs and bags at moderate prices",
      "Easy to spread evenly"
    ],
    "cons": [
      "Still contains chloride salts",
      "Not a choice for first-winter concrete",
      "Slower than straight calcium chloride in deep cold"
    ],
    "bottomLine": "A sensible everyday mix of melting speed, price and reduced corrosiveness for driveways and walks more than a year old.",
    "description": "Melt-2-Go Nature+ is Snow Joe's blended ice melter, and the headline ingredient on its label is calcium magnesium acetate, or CMA, the de-icer highway agencies choose where they want to limit corrosion. Here the CMA is mixed with faster-acting chloride salts, so the product is not chloride-free. That compromise is deliberate: it melts quicker and costs less than a pure acetate, while the CMA content and lower chloride load make it less harsh than plain rock salt. For a typical homeowner whose driveway is a few years old, that balance is hard to beat. Snow Joe markets it as easier on pets, plants and surfaces than ordinary salt, and owners commonly mention fewer white salt residues on floors. Spread it at the label rate, shovel the slush once the ice breaks, and leave it off any concrete poured within the last 12 months."
  },
  {
    "id": "cryotech-cma",
    "name": "Cryotech CMA Calcium Magnesium Acetate De-Icer",
    "category": "Pure Calcium Magnesium Acetate",
    "badge": "Gentlest on Concrete",
    "amazonUrl": "",
    "pros": [
      "Chloride-free acetate chemistry",
      "Much less corrosive to rebar and metal than salt",
      "Widely used on bridges and parking decks",
      "Low concern for vegetation at normal rates",
      "Also works as an anti-icer before storms"
    ],
    "cons": [
      "Expensive per pound",
      "Slow to act, and weak below about 20 F",
      "Harder to find at local stores"
    ],
    "bottomLine": "The pick for valuable decorative concrete, steps over rebar, and anyone willing to pay more and wait longer to spare the slab.",
    "description": "Cryotech CMA is pure calcium magnesium acetate, a chloride-free de-icer developed for bridges and structures where salt corrosion of reinforcing steel is an expensive problem. For homeowners, that background makes it the gentlest widely available option for stamped concrete, stained patios, newer slabs past their first year, and steps with embedded rebar or metal railings. CMA does not work like salt: rather than melting quickly through thick ice, it mainly interferes with ice bonding to the surface, so it performs best spread before or early in a storm and followed by plowing or shoveling. Its practical range is mild winter weather, with most guidance placing it around 20 degrees Fahrenheit and above; colder than that, it slows dramatically. It also costs several times more per pound than rock salt. In a very cold climate, pair it with shoveling, and with sand for traction on the coldest days."
  },
  {
    "id": "safe-paw-non-toxic",
    "name": "Safe Paw Pet-Safe Ice Melter",
    "category": "Salt-Free Amide/Glycol Formula",
    "badge": "Best for Pets",
    "amazonUrl": "",
    "pros": [
      "Salt-free formula per the maker",
      "Marketed as safe for pets and children",
      "Less residue tracked into the house",
      "Labeled as safe for concrete surfaces",
      "Effective in sub-freezing temperatures per the bag"
    ],
    "cons": [
      "Expensive for large driveways",
      "Slower melting than chloride products",
      "Pellets can be tracked if not swept"
    ],
    "bottomLine": "Worth paying extra for on walkways, steps and patios that pets and kids use every day.",
    "description": "Safe Paw is designed for homes where a dog or cat will walk through the melt and lick its paws afterward. The manufacturer describes it as salt-free, built on a modified amide core with a glycol coating, and markets it as non-toxic and safe for concrete, targeting the two biggest complaints about rock salt: burned paws and damaged surfaces. With no chlorides, it avoids the chemical attack on cement paste associated with calcium and magnesium chloride. It still turns ice into water, though, so freeze-thaw cycles still happen; no de-icer can avoid that. Owners commonly report that it melts more slowly than chloride products and costs much more per pound. That makes it a better fit for the front steps, the walk to the door and the patio the dog uses than for a long driveway. Sweep up leftover pellets once the ice is gone so they are not tracked inside."
  },
  {
    "id": "morton-safe-t-pet",
    "name": "Morton Safe-T-Pet Ice Melter",
    "category": "Pet-Friendly Ice Melter",
    "badge": "Best Pet Option at Big-Box Stores",
    "amazonUrl": "",
    "pros": [
      "Easy to find at hardware and grocery stores",
      "Marketed as gentler on paws than rock salt",
      "Lower corrosion risk than standard chlorides",
      "Reasonable price for a pet-focused melter",
      "Familiar brand with clear label directions"
    ],
    "cons": [
      "Slower than calcium chloride",
      "Less effective in deep cold",
      "Still a good idea to keep off brand-new concrete"
    ],
    "bottomLine": "A practical pet-friendly melter you can pick up on the way home when a storm is in the forecast.",
    "description": "Safe-T-Pet is the pet-friendly melter many shoppers can buy locally rather than ordering online, which counts when a storm is a day away. Morton positions it as easier on paws and gentler than ordinary rock salt, and the formula targets the same problems Safe Paw does: irritated pads, pets sickened by licking, and harsh residue. On concrete, any formula that avoids or reduces chlorides lowers the risk of salt scaling and chemical attack compared with straight rock salt or calcium chloride. Like other gentler melters, it is not the fastest option, and it lags in very cold snaps, a fair trade on the front walk and steps. Read the bag for the working temperature, use the recommended rate rather than a heavy hand, and keep in mind that even pet-friendly products are not meant to be eaten. On first-winter concrete, rely on shoveling and sand instead."
  },
  {
    "id": "bare-ground-liquid",
    "name": "Bare Ground Bolt Liquid De-Icer",
    "category": "Liquid Chloride Brine With Inhibitor",
    "badge": "Best Pre-Treatment",
    "amazonUrl": "",
    "pros": [
      "Spray on before a storm to stop ice from bonding",
      "Uses much less product than granules",
      "Even coverage with a pump sprayer",
      "Works faster than pellets on thin ice",
      "Less tracking of pellets into the house"
    ],
    "cons": [
      "Chloride-based, so not for new concrete",
      "Liquid can refreeze if over-applied in deep cold",
      "Needs a dedicated sprayer"
    ],
    "bottomLine": "A smarter way to use less chemical overall: pre-treat older concrete before storms instead of chasing ice after it forms.",
    "description": "Bolt from Bare Ground is a liquid de-icer you spray on concrete before snow or freezing rain arrives. That method, called anti-icing, is what many highway departments use, because a thin layer of brine on the pavement keeps ice from bonding in the first place. Shoveling gets easier, and you use far less chemical than you would scattering pellets on ice after it forms. Bare Ground markets the formula with a corrosion inhibitor, but it is a chloride-based brine, so it belongs on concrete that is at least a year old and in good condition. Its benefit for concrete is control: a measured, even spray is easier to achieve than a scatter of pellets, which land in clumps that concentrate brine in spots. Do not flood the surface, do not spray in deep cold where the brine itself can refreeze, and shovel promptly once snow falls."
  },
  {
    "id": "redmond-ice-slicer",
    "name": "Redmond Ice Slicer Mined Ice Melt",
    "category": "Mined Complex Chloride",
    "badge": "Best Budget (Older Concrete)",
    "amazonUrl": "",
    "pros": [
      "Lower cost than specialty pet and acetate products",
      "Coarse granules give traction while melting",
      "Natural mined product with trace minerals",
      "Visible reddish color shows coverage",
      "Works at colder temperatures than plain rock salt per the maker"
    ],
    "cons": [
      "Chloride-based, harder on concrete than acetates",
      "Can leave reddish residue",
      "Not for concrete under about a year old"
    ],
    "bottomLine": "A cost-effective choice for long, older driveways when you want more than rock salt delivers without paying acetate prices.",
    "description": "Ice Slicer comes from Redmond's mine in Utah, a natural complex chloride salt carrying trace minerals that give it a reddish color. Redmond markets it as working at colder temperatures than ordinary rock salt, and its coarse granules add some traction as they melt. Many road departments in the West use the product, and homeowners buy the bagged version for long driveways where specialty melters would get expensive. Be realistic about concrete: it is still a chloride product, better suited to older, well-cured, air-entrained concrete than to new slabs, stamped or stained decorative work, or concrete that is already scaling. Use it sparingly, shovel off the slush once the ice breaks, and rinse the driveway in spring. The reddish residue can track onto light floors, so keep a mat at the door. When budget matters and the slab is in good shape, it is a solid choice."
  },
  {
    "id": "peladow-calcium-chloride",
    "name": "Peladow Calcium Chloride Pellets",
    "category": "Calcium Chloride Pellets",
    "badge": "Best for Extreme Cold",
    "amazonUrl": "",
    "pros": [
      "Works far below the range of rock salt",
      "Releases heat as it dissolves for fast melting",
      "Pellet shape bores through thick ice",
      "Less product needed per square foot than salt",
      "Widely used by contractors"
    ],
    "cons": [
      "Hardest on concrete of all the picks",
      "Irritating to paws and skin",
      "Not for new, decorative or scaling concrete"
    ],
    "bottomLine": "Save it for mornings far below zero when the ice has to go, and keep it to older, well-built concrete.",
    "description": "Peladow is calcium chloride in pellet form from a major chemical producer, and it is what contractors reach for once the thermometer falls well below zero. Calcium chloride draws moisture from the air, dissolves and gives off heat, and keeps working in deep cold where rock salt stops. The pellet shape helps it bore through thick ice. Its place on this list comes with a warning, though. Research on concrete deterioration has linked calcium and magnesium chloride to chemical damage in the cement paste, on top of the freeze-thaw stress any de-icer causes. That rules it out for new concrete, stamped or stained decorative slabs, and concrete that is already flaking. On an older driveway during the coldest mornings, a light, targeted application followed by quick shoveling is reasonable. Wear gloves when handling it, keep pets off treated areas, and rinse the concrete in spring."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Ice Melt for Concrete",
          item: "https://www.allmetalbrake.com/best-ice-melt-for-concrete/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which de-icer is the gentlest on concrete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Calcium magnesium acetate, sold as CMA, is generally regarded as the gentlest common de-icer for concrete and steel, and pet-safe products based on urea or amides are also low risk. Both melt more slowly and work less well in deep cold than chlorides. No de-icer is entirely harmless, since any meltwater can soak in and refreeze, so prompt shoveling still matters."
          }
        },
        {
          "@type": "Question",
          "name": "Is rock salt or calcium chloride worse for concrete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Calcium chloride works in far colder weather, but research ties it, together with magnesium chloride, to chemical damage in cement paste on top of freeze-thaw scaling. Rock salt mainly drives scaling and corrodes rebar. On older, sound concrete, either is acceptable in small amounts. On new or decorative concrete, skip both and use CMA, a pet-safe melter or sand."
          }
        },
        {
          "@type": "Question",
          "name": "How long should new concrete go without de-icers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Common guidance says to keep de-icing chemicals off concrete through its first winter, and some contractors recommend waiting two winters after a late-season pour. In the meantime, rely on shoveling and sand for traction. Once the concrete has cured, typically at least 28 days, a penetrating sealer adds protection for the winters that follow."
          }
        },
        {
          "@type": "Question",
          "name": "Will de-icers hurt my pavers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Concrete pavers are dense and generally handle moderate use of common de-icers better than poured slabs, though many paver makers caution against heavy use and ammonium-based products. Joint sand is the bigger concern, since brine and shoveling can loosen it. Clay pavers and natural stone vary widely, so follow the manufacturer's guidance and favor gentler products on sealed surfaces."
          }
        },
        {
          "@type": "Question",
          "name": "How cold is too cold for ice melt to work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "That depends on the chemistry. Rock salt slows sharply below about 15 to 20 degrees Fahrenheit, and CMA and urea products work best above roughly 20 degrees. Magnesium chloride keeps working to about 0 to 5 degrees, while calcium chloride works well below zero. Read the working range on the bag and match the product to the forecast."
          }
        },
        {
          "@type": "Question",
          "name": "Are liquid de-icers easier on concrete than pellets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They can be, because liquids spread evenly and use less total chemical, especially when sprayed before a storm to keep ice from bonding. They are weaker at cutting through thick ice that has already formed. Most are chloride brines, so keep them off new or decorative concrete, and avoid over-applying them on any slab."
          }
        },
        {
          "@type": "Question",
          "name": "Should I seal concrete to protect it from salt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most exterior concrete in cold climates, yes. A penetrating silane or siloxane sealer limits how much water and brine soak into the slab, which slows scaling and chloride damage. Apply it in fall to dry, cured concrete within the temperature range on the label, and reapply every several years as the manufacturer directs."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Pavers & Patios",
    tags: [
      "best ice melt for concrete",
      "concrete safe ice melt",
      "pet safe ice melt",
      "calcium magnesium acetate",
      "de-icer for pavers",
      "ice melt new concrete"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The Best Ice Melt for Concrete
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          Snow Joe Melt-2-Go Nature+, a CMA blend, is the best ice melt for most concrete more than a year old, and a first-winter slab should get no de-icer at all. Deep cold, pets and decorative or sealed surfaces shift the pick toward calcium chloride, a pet-safe melter or pure CMA. This guide covers seven picks, how salt damages concrete, safe amounts, costs and long-term protection.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          Based on de-icer chemistry, makers' stated working temperatures, published concrete-damage guidance and owner feedback. Not hands-on tested. No paid placements. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">14 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#short-answer" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>The Short Answer</span></a>
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>The 7 Best Ice Melts</span></a>
              <a href="#how-damage-happens" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>How Ice Melt Damages Concrete</span></a>
              <a href="#chemistry" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Safest De-Icer Chemistry</span></a>
              <a href="#avoid" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>What Never to Use</span></a>
              <a href="#new-concrete" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Ice Melt on New Concrete</span></a>
              <a href="#pavers-sealed" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Pavers and Sealed Surfaces</span></a>
              <a href="#application" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>How Much and When</span></a>
              <a href="#liquid-granular" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>Liquid or Granular?</span></a>
              <a href="#pets-plants" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Pets, Plants and Floors</span></a>
              <a href="#cost" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>Cost Per Winter</span></a>
              <a href="#protect" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">12.</span><span>Protecting Concrete From Salt</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">13.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">14.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          No ice melt is harmless to concrete in the strict sense. Anything that turns ice into water also lets that water seep into the slab and freeze again. What you do control is how aggressive the chemistry is, how much goes down and how long the brine is left sitting. Pick a gentler product, use less of it and clear the slush, and a well-made slab can handle winter after winter for decades.
        </p>

        <QuickPicks products={PRODUCTS} />

        <!-- Short Answer -->
        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Best Ice Melt for Concrete: The Short Answer
