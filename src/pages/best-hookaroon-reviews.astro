---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Log Splitter Picks",
    "url": "/best-log-splitter/"
  },
  {
    "title": "Chainsaw Picks",
    "url": "/best-chainsaw/"
  },
  {
    "title": "Weed Eater Picks",
    "url": "/best-weed-eater/"
  },
  {
    "title": "Best Cordless Leaf Blowers",
    "url": "/best-cordless-leaf-blower/"
  },
  {
    "title": "Best Compact Tractors",
    "url": "/best-compact-tractor/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 6 Best Hookaroons: Save Your Back at the Woodpile";
const description =
  "Six hookaroons and log-handling tools compared on handle length, head design and materials, plus how to use one safely when moving rounds and splits.";

const PRODUCTS = [
  {
    "badge": "Best Overall",
    "category": "Composite Handle, 28-Inch Class",
    "name": "Fiskars 28-Inch Hookaroon",
    "description": "Fiskars' 28-inch hookaroon is the easiest recommendation for most homeowners. The length lets you reach rounds on the ground and toss splits onto a pile without bending deeply, while staying short enough to swing in a tight spot next to a splitter. Fiskars pairs a hardened steel head with a composite handle that resists weather and does not need the oiling a wood handle does, and the handle has a textured grip that helps with wet gloves. It is widely available and priced in the middle of the market. Owners commonly praise how easily the point bites into rounds and how the curve helps pull wood toward you. As with any hookaroon, keep the tip sharp and store it so the point cannot injure someone. If you only buy one log-handling tool for a homeowner firewood setup, this is a sensible choice.",
    "pros": [
      "Length works for both ground pickup and stacking",
      "Weather-resistant composite handle",
      "Hardened steel head bites easily",
      "Widely available at a fair price"
    ],
    "cons": [
      "Not ideal for very large logs that need a cant hook",
      "Composite handle cannot be replaced like wood",
      "Point needs occasional touch-ups"
    ],
    "bottomLine": "Our first pick for nearly any home firewood setup.",
    "amazonUrl": "",
    "id": "fiskars-hookaroon"
  },
  {
    "badge": "Best Traditional Build",
    "category": "Hickory Handle, Forged Head",
    "name": "Council Tool Hookaroon",
    "description": "Council Tool is an American maker known for forged axes and forestry tools, and its hookaroon follows that tradition with a forged steel head on a hickory handle. Hickory is strong and absorbs shock well, and a damaged wood handle can be replaced rather than tossing the whole tool. The forged head holds a point and takes a sharpening file easily. Wood handles need a little care, such as an occasional coat of boiled linseed oil and storage out of the weather, but many owners prefer the feel and balance of hickory over composites. It is a good fit for owners who process a lot of wood every year and want a tool that can be maintained for decades. Check the exact handle length when buying, since Council Tool has offered different lengths over time.",
    "pros": [
      "Forged steel head",
      "Shock-absorbing hickory handle",
      "Replaceable handle extends tool life",
      "American-made forestry heritage"
    ],
    "cons": [
      "Wood handle needs periodic oiling",
      "Should be stored out of the weather",
      "Usually costs more than composite models"
    ],
    "bottomLine": "A traditional, repairable hookaroon for owners who process wood every year.",
    "amazonUrl": "",
    "id": "council-tool-hookaroon"
  },
  {
    "badge": "Best Brand Ecosystem",
    "category": "Forestry Hookaroon",
    "name": "Husqvarna Hookaroon",
    "description": "Husqvarna sells a hookaroon as part of its forestry accessory line, alongside its chainsaws, splitting axes and log tongs. It uses a hardened steel head and a curved point designed to grab rounds and splits, and it is sold through Husqvarna dealers and many retailers that also carry its saws. For owners already shopping for a Husqvarna saw, picking up the hookaroon from the same dealer is convenient. It is a straightforward, durable tool rather than a specialized one. Check the length of the version you are buying, since Husqvarna's forestry line includes both short pickaroon-style tools and longer hookaroons, and the right one depends on whether you work mostly at the splitter or stack from the ground. Like any steel-headed hookaroon, it benefits from an occasional touch-up with a file and a light coat of oil to keep rust off the point.",
    "pros": [
      "Hardened steel head with a curved point",
      "Sold alongside Husqvarna saws and axes",
      "Durable, straightforward design",
      "Widely available through dealers"
    ],
    "cons": [
      "Several lengths in the line, so check before buying",
      "Not specialized for large logs",
      "Pricing varies by dealer"
    ],
    "bottomLine": "A solid, easy-to-find hookaroon for Husqvarna saw owners.",
    "amazonUrl": "",
    "id": "husqvarna-hookaroon"
  },
  {
    "badge": "Best Lightweight",
    "category": "Aluminum Handle",
    "name": "LogRite Hookaroon",
    "description": "LogRite is best known for its aluminum-handled cant hooks and peaveys, and its hookaroon uses the same idea: a light, strong aluminum handle with a steel hook. The weight savings add up over a long day of feeding a splitter and stacking, and aluminum does not rot or swell in wet weather. LogRite tools have a strong following among owners who process a lot of wood and value well-made, American-built equipment. The trade-offs are price, which is higher than mass-market hookaroons, and the different feel of aluminum compared with hickory; some users find it transmits more vibration when striking. For heavy users who already appreciate LogRite's cant hooks, it is a natural companion. Its light weight is especially noticeable for anyone spending a full weekend feeding a splitter and stacking, when every ounce at the end of a handle adds up.",
    "pros": [
      "Light aluminum handle reduces fatigue",
      "Does not rot or swell in wet weather",
      "Strong reputation among heavy users",
      "Pairs with LogRite cant hooks"
    ],
    "cons": [
      "Priced above mass-market models",
      "Aluminum feels different from wood",
      "Less common in big-box stores"
    ],
    "bottomLine": "A premium, lightweight hookaroon for people who split a lot of wood.",
    "amazonUrl": "",
    "id": "logrite-hookaroon"
  },
  {
    "badge": "Best Dealer Pick",
    "category": "Forestry Hookaroon",
    "name": "Stihl Hookaroon",
    "description": "Stihl offers a hookaroon in its forestry tool lineup, sold through the same dealer network as its chainsaws. The head is designed to grab and pull rounds, and the handle gives enough reach to move and stack wood without bending as much. Buying from a Stihl dealer makes sense if you are already there for a saw, chain or bar oil, and dealers can often advise on the right length for your setup. It is a practical, durable tool without exotic features. As with the Husqvarna, check the exact version and handle length, since dealer stock and lineup can vary by region. Dealers can also show you how to set and free the point safely, which helps first-time users. For a homeowner who already trusts a Stihl dealer for saw service, it is a convenient, sensible add-on that will handle years of firewood work.",
    "pros": [
      "Sold through Stihl's dealer network",
      "Durable head designed for pulling rounds",
      "Easy to add to a saw purchase",
      "Practical length for stacking"
    ],
    "cons": [
      "Lineup and length vary by region",
      "Mostly sold through dealers",
      "No standout features over rivals"
    ],
    "bottomLine": "A practical choice for Stihl owners buying at a dealer.",
    "amazonUrl": "",
    "id": "stihl-hookaroon"
  },
  {
    "badge": "Best Multi-Tool",
    "category": "Cant Hook, Hookaroon and Log Jack",
    "name": "LogOX 3-in-1 Forestry Multitool",
    "description": "The LogOX is not a pure hookaroon. It is a modular forestry tool that combines a hookaroon-style tine with a cant hook and a log jack, built on a steel frame with a handle you can reconfigure. That makes it useful for owners who need to roll larger logs for bucking, lift logs off the ground so the saw chain stays out of dirt, and carry rounds with two hands instead of bending. It is heavier and more expensive than a simple hookaroon, and if all you do is feed a splitter and stack, a lighter dedicated hookaroon is faster to use. But for someone cutting their own trees on a property, it can replace two or three separate tools and makes handling bigger logs much safer. Read the instructions for each configuration before use.",
    "pros": [
      "Combines hookaroon, cant hook and log jack functions",
      "Lifts logs to keep the chain out of dirt",
      "Helps carry and roll large logs",
      "Can replace several tools"
    ],
    "cons": [
      "Heavier than a dedicated hookaroon",
      "Higher price",
      "Slower for simple stacking"
    ],
    "bottomLine": "A smart buy for owners who cut and handle their own logs, not just split firewood.",
    "amazonUrl": "",
    "id": "logox-3-in-1-forestry-multitool"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Hookaroon Picks",
          item: "https://www.allmetalbrake.com/best-hookaroon-reviews/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What do people actually do with a hookaroon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is used to grab, drag, lift, flip and toss rounds and split firewood without bending over or putting hands near rough bark and splinters. Most owners use it to feed a log splitter, pull split halves off the beam, move rounds from a pile and stack splits. It is a firewood handling tool, not a tool for rolling large logs."
          }
        },
        {
          "@type": "Question",
          "name": "Is a pickaroon different from a hookaroon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The names are often used interchangeably. Where people distinguish them, a pickaroon usually has a shorter, more axe-like head with a straighter spike, while a hookaroon has a more pronounced curved point for pulling. In practice, manufacturers choose one name or the other, and length and point shape matter more than the label."
          }
        },
        {
          "@type": "Question",
          "name": "What length hookaroon is best?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homeowners, a tool in the upper 20-inch range is the best single choice, since it reaches the ground from a nearly upright stance and still works at the splitter. Shorter tools around 15 to 18 inches are quick at the splitter but need more bending. Taller users benefit most from longer handles."
          }
        },
        {
          "@type": "Question",
          "name": "Do I still need a cant hook if I own a hookaroon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if you buck your own logs. A cant hook has a long handle and hinged hook for rolling logs on the ground while bucking them into rounds. A hookaroon is for moving rounds and splits. They do different jobs, and people who cut their own trees usually own both, or choose a multi-tool such as the LogOX that combines functions."
          }
        },
        {
          "@type": "Question",
          "name": "How do I sharpen a hookaroon point?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use a mill file, following the existing profile and filing toward the tip, keeping the point slim and symmetrical. Avoid overheating the steel on a bench grinder, which can ruin its temper. Clean and lightly oil the head afterward to prevent rust. Touch up the point whenever it starts glancing off wood instead of setting easily."
          }
        },
        {
          "@type": "Question",
          "name": "Should I choose wood or composite handles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hickory is strong, absorbs shock and is replaceable, but it needs oiling and storage out of the weather. Composite and fiberglass handles shrug off rain, need no maintenance and resist overstrike damage. Aluminum is lightest. Choose based on how you store tools; if they live near the woodpile, composite or aluminum is the easier choice."
          }
        },
        {
          "@type": "Question",
          "name": "Does a hookaroon work on frozen or green wood?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, though it behaves differently. Green wood is softer and the point sets easily, but it can grip deeply and need a twist to free. Frozen wood is harder, so the point may glance off; a sharp tip and a deliberate, controlled swing help. Be careful on icy ground, where pulling on a stuck tool can lead to a fall."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Yard & Outdoor Tools",
    tags: [
      "best hookaroon reviews",
      "hookaroon",
      "pickaroon for firewood",
      "log handling tools",
      "firewood hand tools",
      "hookaroon vs pickaroon"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 6 Best <span class="text-[#38BDF8]">Hookaroons</span> for Moving Firewood Without Bending
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A hookaroon is a cheap tool that pays for itself the first time you process a cord of wood. It keeps your hands away from sharp edges and your back upright while you drag, flip and toss rounds and splits.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#fiskars-hookaroon"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="5.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#what-it-does" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. What a Hookaroon Does</a>
          <a href="#length" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Choosing a Length</a>
          <a href="#head-design" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Head and Tip Design</a>
          <a href="#handles" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Handle Materials</a>
          <a href="#technique" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. How to Use One</a>
          <a href="#workflow" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. The Firewood Workflow</a>
          <a href="#safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Safe Handling</a>
          <a href="#care" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Sharpening and Care</a>
          <a href="#value" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Who Needs One</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Anyone who has split and stacked a few cords by hand knows the hard part is not the splitting. It is bending over hundreds of times to pick up rounds, feed the splitter and throw splits onto the pile. A hookaroon puts a sharp, curved spike on the end of a handle so you can do most of that standing upright, and it is the cheapest back-saver in the firewood workflow.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 6 Best Hookaroons, Ranked
          </h2>

          <p>
            Picks are based on manufacturer details such as overall length, handle material, head construction and warranty, along with each tool's design for the jobs homeowners do most: pulling rounds, feeding a splitter and stacking. We also weighed patterns in owner feedback. No ranking depends on durability trials we did not run.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-gray-500 text-sm font-bold">{product.rating}</span>
                    <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} ratings on Amazon)</span>
                  </div>
                  )}

                  <p class="text-gray-700 leading-relaxed mb-6">{product.description}</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 rounded-xl p-4">
                      <p class="text-xs font-black uppercase tracking-widest text-green-700 mb-3">Pros</p>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="flex items-start gap-2 text-sm text-green-800">
                            <svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            {pro}
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-red-50 rounded-xl p-4">
                      <p class="text-xs font-black uppercase tracking-widest text-red-700 mb-3">Cons</p>
                      <ul class="space-y-2">
                        {product.cons.map((con) => (
                          <li class="flex items-start gap-2 text-sm text-red-800">
                            <svg class="w-4 h-4 text-red-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            {con}
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <div class="bg-gray-50 rounded-xl p-4 border border-gray-100">
                    <p class="text-xs font-black uppercase tracking-widest text-gray-500 mb-1">The Bottom Line</p>
                    <p class="text-gray-900 font-bold">{product.bottomLine}</p>
                  </div>

                  <a
                    href={amazonLink(product.amazonUrl, product.name, product.id)}
