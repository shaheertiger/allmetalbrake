---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Portable Power Station for Camping",
    "url": "/best-portable-power-station-for-camping/"
  },
  {
    "title": "Best Solar Generators",
    "url": "/best-solar-generator/"
  },
  {
    "title": "Best Home Battery Backup",
    "url": "/best-home-battery-backup/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "6 Best Jackery Power Stations in 2026: Explorer Ranked by Use";
const description =
  "Jackery's Explorer v2 and Plus power stations ranked by job, from the 300 Plus to the 5000 Plus, with which to buy for camping, RVs, CPAP and home backup.";

const PRODUCTS = [
  {
    "id": "jackery-explorer-1000-v2",
    "name": "Jackery Explorer 1000 v2 Portable Power Station",
    "category": "1,070Wh LFP, 1,500W, 3,000W Surge, About 24 lb",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "About 24 pounds, among the lightest 1kWh LFP units",
      "3,000W surge rating handles fridge compressor starts",
      "One-hour emergency wall charge switched on in the app",
      "Simple controls that work without touching the app",
      "Widely bundled with SolarSaga panels"
    ],
    "cons": [
      "Not expandable; outgrowing it means a second unit",
      "1,500W continuous is tight for kettles and toasters",
      "120V only"
    ],
    "bottomLine": "The Jackery most people should buy: a light, simple 1kWh station for camping and short outages, as long as you know 1kWh is enough.",
    "description": "The Explorer 1000 v2 is the model Jackery is best known for and the one most buyers should start with. Jackery lists it at 1,070Wh of LFP storage with a 1,500W inverter and a 3,000W surge rating, in a case of about 24 pounds. That surge figure matters more than the continuous rating for most outage use, because a refrigerator compressor pulls a short spike at start-up and the 1000 v2 swallows it comfortably. On the runtime math in this guide it keeps a typical fridge going for roughly 10 to 20 hours, or a CPAP, router and lights through a long night. Jackery's app unlocks an emergency charging mode that it quotes at about an hour from the wall. The catch is that the battery is fixed. If you are unsure whether 1kWh will be enough, look at the expandable Explorer 1000 Plus instead; if you are sure, this is the lighter and simpler buy."
  },
  {
    "id": "jackery-explorer-2000-v2",
    "name": "Jackery Explorer 2000 v2 Portable Power Station",
    "category": "2,042Wh LFP, 2,200W, About 40 lb",
    "badge": "Best 2kWh Single Box",
    "amazonUrl": "",
    "pros": [
      "2kWh in a single case of about 40 pounds",
      "Runs a fridge for about a day on its own",
      "2,200W covers a microwave or a sump pump start",
      "Fits in an RV or car trunk without a ramp"
    ],
    "cons": [
      "Not expandable",
      "No 240V output",
      "Heavier than it looks for a one-handed carry"
    ],
    "bottomLine": "The lightest practical way to get 2kWh in one box; the right Jackery for RV owners and overnight outages with a fridge and CPAP.",
    "description": "The Explorer 2000 v2 is where Jackery's lightweight approach pays off most. Jackery lists 2,042Wh of LFP storage and a 2,200W inverter in a single case of about 40 pounds, which is unusually light for the capacity. That combination runs a typical refrigerator for about a day by the runtime math in this guide, or a fridge, CPAP, router and lights through a long outage night, and it handles a microwave, a coffee maker or a sump pump start. Because it is one box with a handle rather than a base unit and battery stack, it moves easily between a house, a car trunk and an RV. The trade-offs are the same as the 1000 v2: no expansion port and no 240V. If you know 2kWh is enough and you value moving the station around, there is no better Jackery. If you want to grow into home backup later, the Explorer 2000 Plus is the better platform."
  },
  {
    "id": "jackery-explorer-300-plus",
    "name": "Jackery Explorer 300 Plus Portable Power Station",
    "category": "288Wh LFP, 300W, About 8 lb",
    "badge": "Best Budget",
    "amazonUrl": "",
    "pros": [
      "About 8 pounds with LFP chemistry",
      "Covers phones, laptops, lights and a CPAP night",
      "Small enough for a backpack or glovebox-sized space",
      "Usually sold in the under $300 class"
    ],
    "cons": [
      "300W rated output rules out anything with a heater",
      "Not expandable"
    ],
    "bottomLine": "A good small station for devices and CPAP nights; do not buy it expecting to run kitchen appliances.",
    "description": "The Explorer 300 Plus is Jackery's small LFP station and its most direct answer to EcoFlow's River 3 series. Jackery lists it at 288Wh of storage and 300W of output in a case of about 8 pounds, small enough to toss in a daypack or behind a car seat. That is plenty for laptops, camera batteries, phones, string lights, a fan and a 12V cooler for a few hours, and it covers a night of CPAP use with the heated humidifier off. It is not enough for anything with a heating element or a meaningful motor: kettles, hair dryers, coffee makers and refrigerators are all out of reach. Within that brief it is a well-built, simple box, and LFP cells mean it tolerates years of regular charging. Buy it as a device charger and campsite light source, or as a second unit for a home office, and it will do exactly what you expect."
  },
  {
    "id": "jackery-explorer-1000-plus",
    "name": "Jackery Explorer 1000 Plus Portable Power Station",
    "category": "1,264Wh LFP, 2,000W, Expandable to about 5kWh",
    "badge": "Best Expandable Mid-Size",
    "amazonUrl": "",
    "pros": [
      "2,000W continuous, more than the 1000 v2",
      "Takes up to three add-on battery packs",
      "Grows to about 5kWh by Jackery's figures",
      "LFP cells and a roughly five-year warranty"
    ],
    "cons": [
      "About 32 pounds, noticeably heavier than the 1000 v2",
      "Battery packs add real cost and weight"
    ],
    "bottomLine": "The Jackery to buy if you want 1kWh-class portability today and the option of a much bigger home setup later.",
    "description": "The Explorer 1000 Plus is the answer to the 1000 v2's biggest weakness. Jackery lists it at 1,264Wh of LFP storage with a 2,000W inverter, both a step up from the v2, and it has an expansion port that takes up to three of Jackery's Battery Pack 1000 Plus units for about 5kWh in total. That makes it a much more flexible platform: carry the base unit to a campsite, then stack the battery packs at home for a multi-day outage. The extra 500 watts of continuous output also helps with kitchen loads like a coffee maker or a small microwave that sit right at the 1000 v2's limit. The price of that flexibility is weight. At about 32 pounds the 1000 Plus is roughly a third heavier than the v2, which campers will notice. If you are certain you will never want more than 1kWh, the v2 is the better carry; if not, buy the Plus."
  },
  {
    "id": "jackery-explorer-2000-plus",
    "name": "Jackery Explorer 2000 Plus Portable Power Station",
    "category": "2,042Wh LFP, 3,000W, Expandable, 240V When Paired",
    "badge": "Best for Home Backup",
    "amazonUrl": "",
    "pros": [
      "3,000W continuous for larger kitchen and shop loads",
      "Expands with battery packs into the double-digit kWh range",
      "Two units can be linked for 120/240V output",
      "Wheels and a telescoping handle",
      "Works with Jackery's home transfer options"
    ],
    "cons": [
      "About 61 pounds before any battery packs",
      "240V needs two units and a connection kit",
      "Expensive once fully built out"
    ],
    "bottomLine": "The most flexible Jackery for home backup; start with one unit and grow into a 240V, multi-day system if you need it.",
    "description": "The Explorer 2000 Plus is Jackery's modular home backup platform. Jackery lists the base unit at 2,042Wh of LFP storage with a 3,000W inverter, and it takes add-on Battery Pack 2000 Plus units to push a single station into the double-digit kilowatt-hour range. Link two 2000 Plus units with Jackery's connection kit and the pair delivers 120/240V, which opens up well pumps, dryers and the kind of transfer-switch installation that a single 120V box cannot support. That growth path is the point; on its own, the 2000 Plus is a heavy alternative to the 2000 v2 with more output. At about 61 pounds it rolls on wheels with a telescoping handle rather than being carried, and a fully built-out system with several battery packs runs into serious money. For a household that wants to start with one unit for a fridge and internet and build toward a real circuit-level backup system, it is the Jackery to buy."
  },
  {
    "id": "jackery-explorer-5000-plus",
    "name": "Jackery Explorer 5000 Plus Portable Power Station",
    "category": "5,040Wh LFP, 7,200W, 120/240V",
    "badge": "Best Whole-Home Jackery",
    "amazonUrl": "",
    "pros": [
      "5kWh in the base unit",
      "7,200W, 120/240V output from a single box",
      "Starts large motor loads like central air and well pumps",
      "Expandable with add-on battery packs",
      "Designed for a transfer switch installation"
    ],
    "cons": [
      "Very heavy; wheels and two people for stairs",
      "Effectively requires an electrician to use well",
      "Priced like a home battery"
    ],
    "bottomLine": "Jackery's flagship for whole-home backup; only worth it if you are wiring it into the house.",
    "description": "The Explorer 5000 Plus is Jackery's flagship and the model aimed at people who want a battery to replace a portable gas generator for home backup. Jackery lists it at 5,040Wh of LFP storage with a 7,200W inverter that delivers both 120V and 240V from a single unit, which is enough to start the motor loads that defeat smaller stations, including many well pumps and central air compressors. Add-on battery packs extend runtime toward multi-day coverage, and Jackery designs it to connect to the house through a transfer switch, installed by an electrician, so it can run the circuits you choose rather than extension cords. It is portable only in the sense that it has wheels. The unit is very heavy and lives in a garage or utility room, and the price puts it in the same conversation as wall-mounted home batteries and standby generators. If you are not planning a hardwired install, the 2000 Plus is the better value."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Jackery Power Stations",
          item: "https://www.allmetalbrake.com/best-jackery-power-station/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which Jackery power station is best for most people?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Explorer 1000 v2. Jackery lists it at 1,070Wh and 1,500W with a 3,000W surge in about 24 pounds, which runs a fridge through an evening outage and carries easily to a campsite. Buy the Explorer 1000 Plus instead if you might want more capacity later, because the v2 cannot be expanded."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between Jackery v2 and Plus models?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Explorer v2 models are fixed-size, lightweight stations built for carrying and simplicity. Explorer Plus models are heavier but take add-on battery packs, offer more output at the same size, and at the 2000 and 5000 sizes support 240V for home backup. Choose v2 if you know the capacity you need and Plus if you might grow."
          }
        },
        {
          "@type": "Question",
          "name": "Is a Jackery solar generator worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can be, if the bundle includes enough panel for the station. A Jackery solar generator is an Explorer sold with SolarSaga panels, so the station is the same as the standalone unit. Bundles with one small panel for a large battery are poor value for outage use; aim for roughly one watt of panel per three watt-hours."
          }
        },
        {
          "@type": "Question",
          "name": "Can a Jackery run a refrigerator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, from the Explorer 1000 v2 upward. A typical fridge uses 1 to 2kWh a day and briefly pulls a start-up surge that the 1000 v2's 3,000W surge rating handles comfortably. Expect roughly 10 to 20 hours from a 1kWh unit, about a day from a 2kWh unit, and several days from the 5000 Plus."
          }
        },
        {
          "@type": "Question",
          "name": "Can a Jackery power my whole house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not a portable v2 model. The Explorer 5000 Plus, or two linked 2000 Plus units, can deliver 120/240V and run selected essential circuits through a transfer switch installed by an electrician. Even those will be drained quickly by central air, an electric range or an electric water heater, so plan backup around essential circuits only."
          }
        },
        {
          "@type": "Question",
          "name": "Jackery 1000 v2 or 2000 v2: which should I buy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buy the 1000 v2 if you mainly camp or need a fridge and internet through outages of a few hours, and value a 24-pound carry. Buy the 2000 v2 if you have an RV, run a CPAP and a fridge overnight, or want a full day of fridge runtime. Neither expands, so size up if unsure."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a Jackery battery last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Jackery's current Explorer models use LFP cells, which Jackery rates for thousands of charge cycles before capacity drops significantly. For occasional outage and camping use, the battery will likely outlast the station's electronics. Store it partially charged somewhere cool and top it up every few months, and avoid leaving it in a hot car for long periods."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "best jackery power station",
      "jackery power station",
      "jackery portable power station",
      "jackery solar generator",
      "jackery explorer 1000 v2",
      "jackery 2000 v2",
      "jackery homepower 3600 plus",
      "jackery generator"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The Best Jackery Power Stations
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          Jackery makes some of the lightest power stations for their capacity. Here is which Explorer fits your job, and when to step up to the expandable Plus line.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">11 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#lineup" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>Lineup at a Glance</span></a>
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>The Six Picks</span></a>
              <a href="#which-one" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Which One to Buy</span></a>
              <a href="#v2-vs-plus" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>v2 vs Plus</span></a>
              <a href="#home-backup" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>Home Backup and HomePower</span></a>
              <a href="#solar" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Solar Generator Bundles</span></a>
              <a href="#app-charging" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Charging and the App</span></a>
              <a href="#where-jackery-loses" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>Where Jackery Loses</span></a>
              <a href="#runtime" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>Runtime by Model</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          For most people the right Jackery is the Explorer 1000 v2. The real decision is whether you want a light, fixed-size v2 or an expandable Plus model you can grow into home backup.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="lineup" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Jackery Lineup at a Glance
          </h2>

          <p>
            Jackery's range is easier to follow than EcoFlow's once you know the two suffixes. The <strong>Explorer v2</strong> models are fixed-size, lightweight boxes built for carrying: the 1000 v2 and 2000 v2 are the ones most people buy. The <strong>Explorer Plus</strong> models are expandable platforms that take add-on battery packs, and the larger ones add 240V output for home backup. Jackery's newer <strong>HomePower</strong> models, such as the HomePower 3600 Plus, are aimed squarely at home backup rather than camping.
          </p>

          <p>
            That split is the most important decision you will make. A v2 is lighter and simpler for its capacity, and it is the better buy if you know the size you need. A Plus is heavier and costs more for the same watt-hours, but it can grow, and at the top of the range it can feed house circuits through a transfer switch. Buying a v2 when you will eventually want home backup, or a Plus when you only ever go camping, are the two most common Jackery mistakes.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Model</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Battery</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">AC Output</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Expandable</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best For</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Explorer 300 Plus</td>
                    <td class="px-4 py-4 text-gray-700">288Wh LFP</td>
                    <td class="px-4 py-4 text-gray-700">300W</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                    <td class="px-4 py-4 text-gray-700">Devices, CPAP, day trips</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Explorer 1000 v2</td>
                    <td class="px-4 py-4 text-gray-700">1,070Wh LFP</td>
                    <td class="px-4 py-4 text-gray-700">1,500W (3,000W surge)</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                    <td class="px-4 py-4 text-gray-700">Camping, short outages</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Explorer 1000 Plus</td>
                    <td class="px-4 py-4 text-gray-700">1,264Wh LFP</td>
                    <td class="px-4 py-4 text-gray-700">2,000W</td>
