---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Solar Power Banks",
    "url": "/best-solar-power-bank/"
  },
  {
    "title": "Best Portable Chargers for Power Outages",
    "url": "/best-portable-chargers-for-power-outages/"
  },
  {
    "title": "Best Emergency Lanterns",
    "url": "/best-emergency-lantern/"
  },
  {
    "title": "Best MagSafe Power Banks",
    "url": "/best-magsafe-power-bank/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-10", modified: "2026-11-10" });
const title = "The 6 Best Hand Crank Radios: NOAA Alerts First, Phone Charging Second";
const description =
  "Six hand crank emergency radios compared on NOAA weather alerts, battery, solar, AA backup and light, with an honest look at how little a crank charges a phone.";

const PRODUCTS = [
  {
    "id": "midland-er310",
    "name": "Midland ER310 E+Ready Emergency Crank Weather Radio",
    "category": "AM/FM/NOAA alert radio with crank, solar, Li-ion pack and AA backup",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "specs": [
      [
        "Weather",
        "NOAA weather radio with automatic alert"
      ],
      [
        "Power Sources",
        "Hand crank, solar, rechargeable Li-ion, 6 x AA backup"
      ],
      [
        "Battery",
        "Li-ion (Midland lists both 2,600mAh and 3,500mAh)"
      ],
      [
        "Rated Runtime",
        "Up to 45 hours normal use (Midland)"
      ],
      [
        "Light",
        "Cree LED flashlight, low/high, SOS beacon"
      ],
      [
        "Size",
        "8.0 x 3.4 x 2.4 in"
      ]
    ],
    "pros": [
      "Automatic NOAA weather alert sounds when a warning is issued locally",
      "Four ways to power it, including six AA batteries as a backup",
      "Long rated runtime for a radio this size",
      "Bright Cree LED flashlight with SOS beacon",
      "Midland is a long-established weather radio brand"
    ],
    "cons": [
      "Midland itself says it will not reliably charge newer phones",
      "Alerts cannot be filtered by county, and the weekly test sounds too",
      "Midland’s own page lists two different battery capacities"
    ],
    "bottomLine": "The most complete emergency radio here: real alerts, long runtime, and an AA backup for when every other source is gone.",
    "description": "The ER310 is the radio we would put in a household storm kit first. It covers AM, FM and NOAA weather radio, and with the weather alert switched on it sounds a siren when a warning is broadcast on your local channel. It can be powered four ways: its rechargeable lithium-ion pack, the hand crank, the solar panel, and six AA batteries as a backup. That AA option is the feature that sets it apart, because store-bought batteries are the one power source that works on day ten with no sun. Midland rates it for up to 45 hours of normal use. Midland’s own product page lists the battery as 3,500mAh in its features and 2,600mAh in its FAQ, so treat the exact capacity as unsettled. Midland is also refreshingly honest: its FAQ says the radio will not reliably charge newer iPhones and Android phones, that phone charging is for emergencies, and that solar alone will not revive a dead battery. Buy it for alerts, light and radio, which it does very well. Check today’s price and confirm stock, since Midland’s own store has listed it as out of stock at times."
  },
  {
    "id": "eton-frx3-plus",
    "name": "Eton American Red Cross FRX3+ Weather Alert Radio",
    "category": "Compact AM/FM/NOAA alert radio with crank, solar, USB and AAA backup",
    "badge": "Best Compact Alert Radio",
    "amazonUrl": "#",
    "specs": [
      [
        "Weather",
        "All 7 NOAA weather bands with alert"
      ],
      [
        "Power Sources",
        "Hand crank, solar, USB, AAA backup"
      ],
      [
        "Battery",
        "2,600mAh 3.7V lithium (per manual)"
      ],
      [
        "Light",
        "LED flashlight, red flashing beacon"
      ],
      [
        "Weight",
        "About 15 oz (retailer listings)"
      ]
    ],
    "pros": [
      "NOAA weather alert in a compact, light body",
      "AAA battery backup in addition to crank and solar",
      "Red flashing beacon and glow-in-the-dark locator for night use",
      "USB output for an emergency phone top-up",
      "American Red Cross licensed and widely stocked"
    ],
    "cons": [
      "Small solar panel; reviewers describe solar charging as slow",
      "Phone charging from a 2,600mAh pack is a partial top-up at best",
      "Some retailers list it as discontinued, so check stock"
    ],
    "bottomLine": "A smaller, lighter alert radio with a battery backup, ideal for a go-bag or a second room.",
    "description": "The FRX3+ is the Red Cross-licensed radio from Eton, and it packs the important features into a smaller body than the Midland ER310. It receives all seven NOAA weather bands with an alert function, plus AM and FM. It runs on an internal lithium pack, which Eton’s manual lists as 2,600mAh at 3.7V, and it can be recharged by hand crank, by the small solar panel on top, or over USB. A AAA battery compartment gives you a backup that does not depend on the internal pack at all. For outage use, the light is well thought out: an LED flashlight, a red flashing beacon for signaling, and a glow-in-the-dark locator so you can find the radio in a dark room. Retail listings put it at about 15 oz, which makes it a sensible go-bag radio. The honest caveats: its solar panel is small, and reviewers note that solar charging is slower than on some competitors; and a 2,600mAh pack can only give a phone a partial top-up. Some retailers have listed the FRX3+ as no longer available, so check today’s price and stock on Amazon before you count on it."
  },
  {
    "id": "midland-er210",
    "name": "Midland ER210 E+Ready Compact Emergency Crank Weather Radio",
    "category": "Compact AM/FM/NOAA alert radio with crank, solar and USB charging",
    "badge": "Best Small Midland",
    "amazonUrl": "#",
    "specs": [
      [
        "Weather",
        "NOAA weather radio with automatic alert"
      ],
      [
        "Power Sources",
        "Hand crank, solar, USB-rechargeable Li-ion"
      ],
      [
        "Battery",
        "2,600mAh Li-ion (Midland key features)"
      ],
      [
        "Rated Runtime",
        "Up to 25 hours normal use (Midland)"
      ],
      [
        "Light",
        "Cree LED, 130 lumens, SOS beacon"
      ],
      [
        "Size",
        "6.5 x 2.8 x 1.9 in"
      ]
    ],
    "pros": [
      "Automatic weather alert in Midland’s smallest crank radio",
      "Rated 130-lumen Cree LED is genuinely useful as a flashlight",
      "Small enough for a car kit or go-bag",
      "Midland publishes clear FAQs about what it can and cannot do"
    ],
    "cons": [
      "No AA or AAA backup, unlike the ER310 and FRX3+",
      "Midland warns many newer phones may not charge from it",
      "Alert siren cannot be disabled; you hear the weekly test too"
    ],
    "bottomLine": "The ER310’s little brother: same alert, smaller body, but no disposable-battery backup.",
    "description": "The ER210 takes the core of the ER310 and shrinks it. You still get AM, FM and NOAA weather radio with an automatic alert that sounds when a warning is issued on your local channel; Midland says the siren runs for eight seconds and can be silenced by holding the weather button. Power comes from a rechargeable lithium-ion pack, which Midland’s key features list as 2,600mAh, and it can be recharged by crank, by solar or over USB. Midland rates it for up to 25 hours of normal use. The flashlight is a Cree LED rated at 130 lumens with an SOS beacon, which is bright enough to move around a dark house. At 6.5 by 2.8 by 1.9 inches, it fits in a glovebox. What you give up compared with the ER310 is the AA backup, and that matters for long outages: once the internal pack is empty, you are cranking or waiting for sun. Midland’s FAQ is candid that solar extends the charge but does not fully charge the radio, and that many newer iPhones and Android phones may not charge from it. Check today’s price, as Midland often discounts the ER210 alongside the ER310."
  },
  {
    "id": "kaito-ka500",
    "name": "Kaito KA500 Voyager Solar/Crank AM/FM/SW/NOAA Weather Alert Radio",
    "category": "Full-size alert radio with shortwave, adjustable solar panel and AA backup",
    "badge": "Best With Shortwave",
    "amazonUrl": "#",
    "specs": [
      [
        "Bands",
        "AM, FM, SW1, SW2, 7 NOAA weather channels"
      ],
      [
        "Weather",
        "NOAA alert mode"
      ],
      [
        "Power Sources",
        "Crank, adjustable solar panel, USB, AC adapter, 3 x AA"
      ],
      [
        "Light",
        "LED flashlight plus 5-LED reading lamp"
      ],
      [
        "Weight",
        "1.8 lb (retailer listings)"
      ],
      [
        "Size",
        "8 x 5 x 2.5 in"
      ]
    ],
    "pros": [
      "Shortwave bands for long-distance news if local stations go down",
      "NOAA alert mode for automatic weather warnings",
      "Solar panel tilts to face the sun, which helps real output",
      "Reading lamp on the back of the panel lights a table, not just a path",
      "AA backup when crank and sun are not enough"
    ],
    "cons": [
      "Heaviest radio here at about 1.8 lb",
      "Internal pack is small in the standard version; battery specs vary by variant",
      "Phone charging depends on the variant you buy"
    ],
    "bottomLine": "The radio for people who want shortwave and a proper reading lamp, and do not mind the size.",
    "description": "The Kaito KA500 Voyager is the most radio in this roundup. Alongside AM, FM and seven NOAA weather channels with an alert mode, it adds two shortwave bands, which listings give as roughly 3.2 to 8 MHz and 9 to 22 MHz. Shortwave is a niche feature most households will never use, but it is the one way to hear distant broadcasters if a regional disaster takes local stations off the air. Power options are the most flexible here: hand crank, a solar panel that tilts to face the sun, USB, an AC adapter and three AA batteries. Tilting matters, because a panel aimed at the sun produces noticeably more than one lying flat, a point our solar power bank guide makes about folding panels too. On the back of the panel is a 5-LED reading lamp, which is a better room light than a pinpoint flashlight. The drawbacks are size and variant confusion. Retail listings put it at about 1.8 lb and 8 by 5 by 2.5 inches. Battery specs differ by version: listings describe a small Ni-MH pack in the standard model, and some variants add a larger lithium pack or a dedicated phone charger. Check the exact listing and today’s price before buying."
  },
  {
    "id": "runningsnail-md-090p",
    "name": "RunningSnail MD-090P Emergency Crank Weather Radio",
    "category": "AM/FM/NOAA radio with large battery and motion-sensor reading lamp",
    "badge": "Biggest Battery",
    "amazonUrl": "#",
    "specs": [
      [
        "Bands",
        "AM, FM, 7 NOAA weather channels"
      ],
      [
        "Battery",
        "4,000mAh rechargeable (manual)"
      ],
      [
        "Power Sources",
        "Hand crank, solar, USB"
      ],
      [
        "Light",
        "Flashlight plus motion-sensor reading lamp"
      ]
    ],
    "pros": [
      "Largest internal battery among the picks",
      "Motion-sensor reading lamp is handy in a dark hallway",
      "Receives all seven NOAA weather channels",
      "Usually priced well below the Midland and Eton models"
    ],
    "cons": [
      "No automatic NOAA alert function listed",
      "Lesser-known brand with thinner documentation",
      "Retailer listings disagree on battery figures"
    ],
    "bottomLine": "A good outage radio and phone top-up battery, but not a warning device, because it does not list an alert.",
    "description": "The MD-090P is the pick for people who want the biggest battery in a crank radio and will rely on other sources for weather warnings. RunningSnail’s manual lists a 4,000mAh rechargeable battery, the largest here, and some retail listings express it as 14,800mWh, which is roughly the same pack described in energy rather than charge. It receives AM, FM and all seven NOAA weather channels, so you can listen to the forecast whenever you like. It can be recharged by crank, solar or USB. The light is a nice touch: a flashlight for walking and a reading lamp with a motion sensor that comes on when you pass in the dark, provided the switch is set to auto. The important limitation is that we could not find an automatic NOAA alert function listed for this model. That means it will not wake you for a tornado warning at 3 a.m. the way the Midland or Eton radios will. If you already have a weather alert radio or alerts on your phone, that is fine; if this is your only warning device, buy an alert radio instead. Check today’s price, as RunningSnail sells several similar models."
  },
  {
    "id": "fospower-a1",
    "name": "FosPower A1 Emergency Weather Radio (FOSPWB-2376)",
    "category": "Budget AM/FM/NOAA radio with crank, solar, AAA backup and 2,000mAh pack",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "specs": [
      [
        "Bands",
        "AM, FM, NOAA weather band (162.400-162.550 MHz)"
      ],
      [
        "Battery",
        "2,000mAh / 7,400mWh 3.7V Li-ion"
      ],
      [
        "Power Sources",
        "Hand crank, solar, micro-USB, AAA backup"
      ],
      [
        "Light",
        "1W flashlight"
      ],
      [
        "Water Resistance",
        "IPX3"
      ]
    ],
    "pros": [
      "Low price for crank, solar and battery backup",
      "AAA backup works when the internal pack is empty",
      "IPX3 splash resistance for use outdoors in rain",
      "Small enough for a car kit or day pack"
    ],
    "cons": [
      "No automatic NOAA alert function listed",
      "Small 2,000mAh pack gives only a modest phone top-up",
      "Flashlight is basic compared with the Midland Cree LEDs"
    ],
    "bottomLine": "A sensible spare radio for a car or second kit, as long as something else handles weather alerts.",
    "description": "The FosPower A1 is the radio to buy when you want crank and solar backup in a car kit or a second go-bag and do not want to spend Midland money. Retail listings describe a 2,000mAh (7,400mWh) lithium-ion pack, recharged by hand crank, solar panel or micro-USB, plus a AAA battery compartment for backup. It receives AM, FM and the NOAA weather band from 162.400 to 162.550 MHz, so you can tune in to forecasts and emergency broadcasts. The flashlight is a modest 1W LED, and the IPX3 rating means it can handle splashes and light rain. What it does not list is an automatic weather alert, so like the RunningSnail it is a radio you listen to, not one that wakes you up. The small pack also limits its value as a phone charger; one owner review put it plainly, saying the crank is not enough to recharge other electronics, which matches what every maker in this category says in its own documentation. Charge the internal battery before storm season and keep spare AAAs with it. Check today’s price, as FosPower sells several similar models with different battery sizes, and confirm the model number."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Hand Crank Radio",
          item: "https://www.allmetalbrake.com/best-hand-crank-radio/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best hand crank radio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most households, the Midland ER310. It has an automatic NOAA weather alert, a long rated runtime, a Cree LED flashlight and four power sources, including six AA batteries as a backup. For a smaller go-bag radio, the Eton American Red Cross FRX3+ adds a AAA backup in a lighter body."
          }
        },
        {
          "@type": "Question",
          "name": "Do hand crank radios really work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, for what they are designed to do. A crank reliably powers the radio and light for short periods when the battery is flat. It is not an efficient way to charge a phone or fill the internal battery. Charge the radio from an outlet or power bank beforehand and use the crank as a backup."
          }
        },
        {
          "@type": "Question",
          "name": "Can a hand crank radio charge a phone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only a little, and slowly. Midland says its ER310 will not reliably charge newer iPhones and Android phones, and that a 2,600mAh battery may barely raise a newer phone’s charge. For phones, keep a charged 10,000 to 20,000mAh power bank in your kit and treat the radio’s USB port as a last resort."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a NOAA weather radio and a weather alert radio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A NOAA weather radio receives the National Weather Service broadcasts on seven channels. A weather alert radio also listens for the warning tone while silent and sounds a siren when a warning is issued. Every alert radio is a NOAA radio, but not every NOAA radio has an alert."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a crank radio battery last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the radio and how loud you play it. Midland rates the ER310 for up to 45 hours of normal use and the ER210 for up to 25 hours. Midland also says a charged ER310 in the sun can last about two to three weeks between charges, versus about a week without sun."
          }
        },
        {
          "@type": "Question",
          "name": "Are solar crank radios worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, as a backup to the internal battery. The small panel extends a charged battery rather than filling an empty one; Midland says solar alone will not charge a dead ER310. A radio that also takes AA or AAA batteries is the most reliable choice for long outages."
          }
        },
        {
          "@type": "Question",
          "name": "Where should I keep an emergency radio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Somewhere central and easy to reach in the dark, with spare batteries stored next to it, not inside it. Many people keep one in the household kit and a smaller one in the car. If you rely on its alert, keep it switched on in alert mode near where you sleep during storm season."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "best hand crank radio",
      "emergency crank radio",
      "solar crank radio",
      "noaa weather radio",
      "emergency radio with phone charger",
      "weather alert radio"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The Best Hand Crank Radios
        </h1>
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          An emergency radio earns its place by waking you up when a warning is issued and still playing on day five of an outage. Here are the six worth buying, and the features that actually matter.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">11 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#short-answer" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>The Short Answer</span></a>
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>The Six Picks</span></a>
              <a href="#comparison" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Comparison Table</span></a>
              <a href="#noaa-alerts" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>How NOAA Alerts Work</span></a>
              <a href="#power-sources" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>Crank, Solar, USB and Batteries</span></a>
              <a href="#phone-charging" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>The Truth About Phone Charging</span></a>
              <a href="#buying-guide" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Specs That Matter</span></a>
