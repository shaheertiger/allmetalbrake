const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "The Best Battery Powered Fans: Runtime, Batteries and Airflow";
const description =
  "Rechargeable, tool-battery and D-cell fans for outages, camping and jobsites, with runtime math by battery size and how to run a box fan from a power station.";

const PRODUCTS = [
  {
