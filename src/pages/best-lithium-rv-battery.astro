---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Power Inverters",
    "url": "/best-power-inverter/"
  },
  {
    "title": "Best Portable Solar Panels",
    "url": "/best-portable-solar-panel/"
  },
  {
    "title": "Best RV Generators",
    "url": "/best-rv-generator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "The Best Lithium RV Batteries: 12V LiFePO4 for RVs, Vans and Boats";
const description =
  "Six 12V LiFePO4 batteries for RVs, vans and boats, with Ah vs Wh, BMS current limits, cold-weather charging, converter and DC-DC setup, and bank sizing math.";

const PRODUCTS = [
  {
    "id": "battle-born-100ah-12v-lifepo4-battery",
    "name": "Battle Born 100Ah 12V LiFePO4 Deep Cycle Battery",
    "category": "12V, 100Ah (about 1.28kWh), drop-in LiFePO4",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "The most established drop-in lithium brand in the RV market",
      "Assembled in Reno, Nevada, with U.S.-based technical support",
      "Backed by a 10-year warranty",
      "Built-in BMS with low-temperature charge protection",
      "Heated version available for cold-climate campers"
    ],
    "cons": [
      "Costs substantially more per amp-hour than budget brands",
      "100A continuous BMS limit means larger inverters need two or more in parallel"
    ],
    "bottomLine": "The lithium RV battery to buy if you want the safest bet on support and longevity and are willing to pay for it.",
    "description": "Battle Born is the name most RV technicians and van builders mention first, and its 100Ah drop-in battery is the reason. It is a 12V LiFePO4 battery with an internal battery management system that handles cell balancing, overcharge and over-discharge protection, and blocks charging in freezing temperatures. Battle Born rates the BMS at 100A continuous with a higher short surge, which comfortably supports a 1,000W inverter on one battery; for a 2,000W inverter you parallel two or more. What you pay extra for is the company behind it: batteries assembled in Reno, a 10-year warranty, and a support line that will talk you through converter settings and DC-DC charging. If you camp below freezing, look at the heated version, which warms the cells before it accepts a charge. If budget matters more than brand, the LiTime below stores the same energy for far less."
  },
  {
    "id": "litime-12v-100ah-lifepo4-battery",
    "name": "LiTime 12V 100Ah LiFePO4 Lithium Battery",
    "category": "12V, 100Ah (about 1.28kWh), budget LiFePO4",
    "badge": "Best Value",
    "amazonUrl": "",
    "pros": [
      "Same rated capacity as premium 100Ah batteries at a fraction of the price",
      "100A BMS covers a 1,000W inverter on a single battery",
      "Several variants, including low-temperature-protected and self-heating models",
      "Can be paralleled to build larger banks cheaply"
    ],
    "cons": [
      "Support and warranty handling are less proven than Battle Born's",
      "Variant names are easy to mix up; check the cold-weather features on the listing",
      "Formerly sold as Ampere Time, which confuses reviews and listings"
    ],
    "bottomLine": "The best lithium battery for an RV on a budget; buy the variant that matches your climate.",
    "description": "LiTime, the brand formerly sold as Ampere Time, is what made 12V LiFePO4 affordable for ordinary RV and van owners. Its 100Ah battery stores the same roughly 1,280Wh as a premium drop-in, uses a 100A BMS that comfortably supports a 1,000W inverter, and costs a fraction of the big-name price, which means two LiTime batteries can cost less than one premium battery. That changes the sizing conversation: for many budgets, the choice is not premium versus budget but 100Ah versus 200Ah. The trade-offs are support depth and consistency of documentation, plus a product line with several near-identical 100Ah variants. LiTime sells versions with low-temperature charging protection and self-heating, so if you camp in shoulder seasons or winter, make sure the listing specifies the cold-weather feature you need. For warm-weather boondocking, a weekend trailer or a fishing boat, it is an easy recommendation."
  },
  {
    "id": "renogy-12v-100ah-self-heating-lifepo4-battery",
    "name": "Renogy 12V 100Ah Self-Heating LiFePO4 Battery",
    "category": "12V, 100Ah (about 1.28kWh), built-in heating",
    "badge": "Best for Cold Weather",
    "amazonUrl": "",
    "pros": [
      "Self-heating warms the cells so they can accept a charge below freezing",
      "Fits naturally into Renogy solar, DC-DC and inverter systems",
      "Monitoring available through Renogy's app with compatible accessories",
      "Priced between budget and premium brands"
    ],
    "cons": [
      "Heating uses charging energy, which slows cold-morning solar recovery",
      "Renogy's battery naming changes frequently between generations"
    ],
    "bottomLine": "The pick for shoulder-season and winter campers who want solar charging to keep working on frosty mornings.",
    "description": "LiFePO4 batteries must not be charged below freezing, and that rule catches a lot of RV owners off guard on the first cold trip: the BMS blocks charging, the solar controller shows panels producing and the battery stays flat. Renogy's self-heating 100Ah battery addresses that directly. When it is cold and a charge source is connected, it uses incoming power to warm the cells to a safe temperature, then starts charging normally. That makes it a better fit than an unheated battery for anyone who camps in fall, winter or at altitude, or who stores a trailer outdoors with solar keeping the battery topped up. Renogy also sells the solar controllers, DC-DC chargers and inverters that sit around a battery, so building a matched system is straightforward. Confirm the exact model, monitoring options and heating thresholds on the listing, because Renogy revises its battery line often."
  },
  {
    "id": "sok-12v-206ah-lifepo4-battery",
    "name": "SOK 12V 206Ah LiFePO4 Battery",
    "category": "12V, 206Ah (about 2.6kWh), serviceable case",
    "badge": "Best Big Single Battery",
    "amazonUrl": "",
    "pros": [
      "About twice the capacity of a 100Ah battery in one case",
      "Serviceable design that can be opened, rather than a sealed block",
      "Strong value per amp-hour",
      "Heated versions offered for cold climates"
    ],
    "cons": [
      "Heavy, and too large for some RV battery boxes",
      "Smaller company with less retail presence than Renogy or Battle Born"
    ],
    "bottomLine": "A strong value when you want around 200Ah in one battery and have the space to fit it.",
    "description": "SOK built its reputation among DIY van and solar builders by making a LiFePO4 battery you can actually open. Instead of a sealed plastic block, its batteries use a serviceable case, so the BMS and connections can be inspected and, in principle, replaced. The 206Ah model packs roughly 2.6kWh into a single battery, which is the capacity of two 100Ah batteries without the paralleling cables, busbars and balancing between separate units. For a camper that wants a 200Ah-class bank in one box, it is among the better values per amp-hour. Check the BMS continuous current rating on the listing before pairing it with a large inverter, as with any lithium battery. The practical limits are size and weight: measure your battery compartment first, because a 206Ah battery is considerably larger than a Group 24 or Group 27 lead-acid battery, and lifting it in and out is a two-hand job."
  },
  {
    "id": "battle-born-270ah-12v-gc3-lifepo4-battery",
    "name": "Battle Born 270Ah 12V GC3 LiFePO4 Battery",
    "category": "12V, 270Ah (about 3.5kWh), GC3 format",
    "badge": "Best for Large Banks",
    "amazonUrl": "",
    "pros": [
      "270Ah in one 12V battery, the equivalent of nearly three 100Ah units",
      "Same company support and warranty as the 100Ah",
      "Fewer interconnects than a bank of small batteries",
      "Suited to full-time RVs and big inverter loads"
    ],
    "cons": [
      "Very expensive in absolute terms",
      "Heavy and specific in size; measure before ordering"
    ],
    "bottomLine": "The premium way to build a big lithium bank in a motorhome or full-time fifth wheel with fewer batteries.",
    "description": "Battle Born's GC3 battery is designed for RV owners who need a lot of storage and would rather not wire together three or four small batteries. At 270Ah of 12V LiFePO4, one battery holds roughly 3.5kWh, enough for a day of fridge, furnace fan, lights, laptops and a few microwave sessions, and a pair makes a bank large enough for heavy inverter use, subject to the BMS current ratings. Fewer batteries mean fewer cables, fewer lugs to work loose and simpler balancing, which matters in a vehicle that bounces down highways. The trade-off is cost and size. It is a large, heavy battery with a specific footprint, so measure your compartment, check how you will lift it into place and confirm the BMS current ratings against your inverter before you order. For weekend campers it is far more battery than needed; for full-time travelers who boondock, it is one of the cleanest ways to build a big bank."
  },
  {
    "id": "dakota-lithium-12v-100ah-lifepo4-battery",
    "name": "Dakota Lithium 12V 100Ah LiFePO4 Deep Cycle Battery",
    "category": "12V, 100Ah (about 1.28kWh), marine and RV",
    "badge": "Best for Boats",
    "amazonUrl": "",
    "pros": [
      "Popular with anglers for trolling motors and house loads",
      "Dakota advertises a long warranty, longer than most rivals",
      "Drop-in replacement for many lead-acid deep-cycle batteries",
      "U.S.-based company with established dealer presence"
    ],
    "cons": [
      "Priced closer to premium than budget",
      "Check BMS current limits and cold-weather features on the specific listing"
    ],
    "bottomLine": "A solid premium alternative when the battery spends its life on a boat as much as in a camper.",
    "description": "Dakota Lithium is better known on the water than in campgrounds, but its 12V 100Ah LiFePO4 battery works in both. Anglers adopted it for trolling motors and house loads because lithium holds voltage steady as it discharges, so a trolling motor keeps its speed late in the day instead of fading the way it does on lead-acid. The same trait helps an RV inverter avoid low-voltage shutdowns. Dakota advertises an unusually long warranty, which is part of what you pay for, and the battery is offered as a drop-in replacement for many lead-acid deep-cycle units. As with any lithium battery, the charger matters: marine chargers and RV converters both need a lithium profile, and the battery should not be charged below freezing. Check the BMS current limit on the listing before pairing it with an inverter larger than about 1,000W, and parallel batteries when you need more current."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Lithium RV Batteries",
          item: "https://www.allmetalbrake.com/best-lithium-rv-battery/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best lithium RV battery for most people?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most RV owners, a 12V 100Ah LiFePO4 battery from an established brand is the right starting point. The Battle Born 100Ah is the premium choice with the strongest support; the LiTime 12V 100Ah offers the same rated energy for far less. Buy two if you run a 2,000W inverter or a fridge and furnace through cold nights."
          }
        },
        {
          "@type": "Question",
          "name": "How many lithium batteries do I need for my RV?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Add up your daily watt-hours, multiply by the number of days between charges and by 1.2 for margin, then divide by 12.8 to get amp-hours. Weekend campers often need 100Ah. A fridge, furnace and laptops push most people to 200Ah, and full-time boondockers commonly run 400Ah or more with solar to recharge it."
          }
        },
        {
          "@type": "Question",
          "name": "Can I just drop a lithium battery into my RV?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Physically, usually yes; electrically, check the chargers first. Your converter, solar controller and any alternator connection need lithium-compatible settings. Replace the voltage-based battery gauge with a shunt monitor, confirm the cable and fuse sizes, and do not mix lithium with leftover lead-acid batteries. With those done, the swap is straightforward."
          }
        },
        {
          "@type": "Question",
          "name": "Is a LiFePO4 RV battery safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "LiFePO4 is the most thermally stable of the common lithium chemistries and does not vent gas during normal charging like flooded lead-acid. The built-in BMS protects against overcharge, over-discharge, short circuits and charging in the cold. As with any battery, fuse the positive cable close to the battery, secure the battery against movement and use properly crimped cables."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a DC-DC charger for a lithium RV battery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you charge from a vehicle alternator, yes in most cases. Lithium accepts current so readily that a deeply discharged bank can overheat an alternator, and a DC-DC charger limits current, applies the correct lithium profile and keeps the starting battery isolated. For travel trailers charged through the 7-pin connector, it also makes the most of thin wiring."
          }
        },
        {
          "@type": "Question",
          "name": "Can lithium RV batteries be used in the winter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, with care. LiFePO4 can usually discharge down to around -4°F, but it must not be charged below about 32°F. Batteries with low-temperature cutoff block charging until they warm up; self-heating batteries warm themselves using incoming charge power. Mounting the batteries inside the heated part of the RV is the simplest way to avoid the issue."
          }
        },
        {
          "@type": "Question",
          "name": "Is a portable power station better than a lithium RV battery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the setup. For an RV or van with built-in 12V circuits, a lithium house battery is cheaper per watt-hour and feeds the existing lights, pump and fans. For tents, car camping or a trailer you do not want to rewire, a portable power station with a LiFePO4 battery is simpler and can come into the house during an outage."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "best lithium rv battery",
      "best rv battery",
      "lifepo4 rv battery",
      "best lithium battery for rv",
      "rechargeable lithium battery",
      "portable lithium battery pack"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Lithium RV Batteries</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Six 12V LiFePO4 batteries from budget 100Ah drop-ins to a 270Ah full-timer battery, plus the BMS, cold-weather and charging rules that decide whether a lithium swap works.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#battle-born-100ah-12v-lifepo4-battery"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare the Batteries
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#at-a-glance" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Batteries at a Glance</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The Six Picks</a>
          <a href="#ah-vs-wh" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Amp-Hours vs Watt-Hours</a>
          <a href="#bms" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. What the BMS Limits</a>
          <a href="#cold" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Cold-Weather Charging</a>
          <a href="#charging" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Converter and DC-DC Charging</a>
          <a href="#swap" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Lead-Acid Swap Checklist</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Sizing a Bank</a>
          <a href="#portable" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Portable Lithium Packs</a>
          <a href="#which" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Which One to Buy</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A lithium battery roughly doubles the usable power in an RV and halves the weight. Whether it delivers depends less on the brand than on the charger, the cold and the current your inverter asks of it.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="at-a-glance" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Batteries at a Glance
          </h2>

          <p>
            Swapping lead-acid house batteries for lithium iron phosphate is the single biggest upgrade most RV, van and boat owners can make. A 12V LiFePO4 battery gives you nearly all of its rated capacity instead of about half, holds steady voltage until it is almost empty, weighs roughly half as much, and is commonly rated for thousands of charge cycles rather than hundreds. It also costs more up front and asks more of your charging system, which is where most of the bad experiences come from.
          </p>

          <p>
            This guide covers six 12V LiFePO4 batteries that are widely sold and well supported, from budget 100Ah units to a 270Ah battery for full-time travelers. The picks are based on manufacturers' published specifications and documentation, not on our own testing. The sections after the picks cover what actually decides whether a lithium RV battery works for you: the difference between amp-hours and watt-hours, what the BMS limits, cold-weather charging, converter and alternator compatibility, and how to size a bank.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Battery</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Capacity</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Energy (approx.)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cold-weather option</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Battle Born 100Ah</td>
                    <td class="px-4 py-4 text-gray-700">100Ah</td>
                    <td class="px-4 py-4 text-gray-700">1,280Wh</td>
                    <td class="px-4 py-4 text-gray-700">Low-temp protection; heated version sold</td>
                    <td class="px-4 py-4 text-gray-700">Premium drop-in</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">LiTime 12V 100Ah</td>
                    <td class="px-4 py-4 text-gray-700">100Ah</td>
                    <td class="px-4 py-4 text-gray-700">1,280Wh</td>
                    <td class="px-4 py-4 text-gray-700">Varies by variant</td>
                    <td class="px-4 py-4 text-gray-700">Budget banks</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Renogy 12V 100Ah Self-Heating</td>
                    <td class="px-4 py-4 text-gray-700">100Ah</td>
                    <td class="px-4 py-4 text-gray-700">1,280Wh</td>
                    <td class="px-4 py-4 text-gray-700">Built-in heating</td>
                    <td class="px-4 py-4 text-gray-700">Cold-weather camping</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">SOK 12V 206Ah</td>
                    <td class="px-4 py-4 text-gray-700">206Ah</td>
                    <td class="px-4 py-4 text-gray-700">2,640Wh</td>
                    <td class="px-4 py-4 text-gray-700">Heated versions sold</td>
                    <td class="px-4 py-4 text-gray-700">200Ah in one case</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
