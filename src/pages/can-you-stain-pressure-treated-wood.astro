                    <td class="px-4 py-4 font-black text-gray-900">Meter above about 18 to 20 percent</td>
                    <td class="px-4 py-4 text-gray-700">Still wet</td>
                    <td class="px-4 py-4 text-gray-700">Keep waiting</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Meter in the low to mid teens</td>
                    <td class="px-4 py-4 text-gray-700">Generally ready</td>
                    <td class="px-4 py-4 text-gray-700">Confirm with water test</td>
