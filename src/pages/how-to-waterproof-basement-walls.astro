---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/how-to-waterproof-basement-walls.html?raw';

const title = "How to Waterproof Basement Walls | Home Fix Reviews";
const description = "A wet basement is a water-management problem that shows at the wall. How to tell condensation from seepage, what to fix outside first, and which coating to use.";
