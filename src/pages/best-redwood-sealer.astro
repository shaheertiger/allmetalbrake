---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Deck Stains",
    "url": "/best-deck-stain-reviews/"
  },
  {
    "title": "Best Deck Sealant",
    "url": "/best-deck-sealant/"
  },
  {
    "title": "Best Exterior Wood Sealer",
    "url": "/best-exterior-wood-sealer/"
  },
  {
    "title": "Best Fence Stain",
    "url": "/best-fence-stain/"
  },
  {
    "title": "Deck Stain Colors Guide",
    "url": "/deck-stain-colors-guide/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 7 Best Redwood Sealers: Keeping the Red in Redwood";
const description =
  "Seven redwood sealers compared on how well they hold redwood's color, handle tannins and sapwood, and recoat without stripping, plus how to revive gray boards.";

const PRODUCTS = [
  {
    "id": "penofin-original",
    "badge": "Best Overall",
    "category": "Oil-based penetrating finish",
    "name": "Penofin Blue Label Penetrating Oil Finish",
    "amazonUrl": "",
    "bottomLine": "The redwood finish professionals reach for most often, with tones that keep redwood looking like redwood.",
    "pros": [
      "Long-standing contractor favorite on redwood and cedar",
      "Penetrates without forming a film to peel",
      "Transparent tones suited to redwood",
      "Recoats with cleaning only",
      "Works on decks, siding and fences"
    ],
    "cons": [
      "Oil-based, with mineral spirits cleanup",
      "Some formulas restricted in low-VOC areas",
      "Needs careful wiping of excess"
    ],
    "description": "Penofin has deep roots on the West Coast, where redwood decks and siding are common, and its Blue Label penetrating oil is the product many contractors use on redwood. It is an oil-based finish built around Brazilian rosewood oil, according to the company, and it soaks into redwood rather than sitting on top. That means it does not peel; when it wears, the wood looks drier and lighter, and a cleaning and fresh coat restores it. The line includes clear and several transparent tones, and choosing a redwood-friendly tone is what keeps the boards from fading toward tan. It works on decks, siding, fences and furniture, so one product can cover a whole property. Apply thin coats, back-brush and wipe off anything not absorbed. Owners often mention how natural it looks compared with heavier stains. The cautions are standard for oils: longer dry times, solvent cleanup and availability limits in some low-VOC areas. Prices were roughly 45 to 70 dollars per gallon at the time of writing."
  },
  {
    "id": "ready-seal-520",
    "badge": "Easiest to Apply",
    "category": "Oil-based, redwood tone",
    "name": "Ready Seal 520 Redwood Exterior Stain and Sealer",
    "amazonUrl": "",
    "bottomLine": "A forgiving, sprayable redwood-toned finish that is hard to apply badly.",
    "pros": [
      "Redwood tone made for this species",
      "Marketed as no back-brushing and no lap marks",
      "Spray, roll or brush",
      "Fades gradually instead of peeling",
      "Widely available in five-gallon pails"
    ],
    "cons": [
      "Color develops over about two weeks",
      "Longer dry time than water-based products",
      "Can look strong on pale sapwood"
    ],
    "description": "Ready Seal 520 Redwood is the brand's redwood tone, and it suits owners who want the job to be easy. Ready Seal markets its formula as needing no back-brushing and leaving no lap marks, and owner feedback largely supports that: people who struggled with streaky finishes often say Ready Seal looked even on the first try. It can be sprayed, rolled or brushed, which helps on long fences and big decks. The redwood tint adds back color and blocks UV, and it evens out sapwood and heartwood better than a clear. Like other Ready Seal colors, it looks lighter when wet and deepens over roughly two weeks as it cures, so judge the color after that window. On very pale sapwood it can look stronger than on red heartwood; test a board first. It is oil-based, so cleanup takes mineral spirits and it needs dry weather to cure. Maintenance is simple: clean and add another coat when water stops beading. Prices were roughly 40 to 55 dollars per gallon at the time of writing."
  },
  {
    "id": "twp-1500-series",
    "badge": "Most Durable Oil",
    "category": "Oil-based preservative stain",
    "name": "TWP 1500 Series Wood Preservative",
    "amazonUrl": "",
    "bottomLine": "A durable penetrating preservative with redwood-friendly tones for decks that see heavy sun.",
    "pros": [
      "Marketed as a wood preservative with mildew resistance",
      "Redwood and cedar tones available",
      "Penetrates deeply into weathered wood",
      "Recoats without stripping",
      "Contractor favorite for restoration work"
    ],
    "cons": [
      "Restricted in some low-VOC states",
      "Often ordered online",
      "Longer cure time"
    ],
    "description": "TWP 1500 Series is a penetrating oil-based finish that the company positions as a wood preservative, with mildew resistance noted on the label. It is popular with deck restoration contractors because it soaks into weathered wood and fades rather than peeling, which makes recoats a matter of cleaning and reapplying. The line includes redwood and cedar tones, and those tints add the pigment that keeps redwood from fading quickly. On sunny redwood decks, owners often report that it holds color longer than clear products, though the traffic lanes still need attention every year or two. It also handles rough and weathered boards well, filling the texture instead of sitting on it. The tradeoffs are availability and patience. VOC rules restrict which TWP formulas are sold in some states, many buyers order it online, and it needs warm, dry weather to cure properly. Test the tone on a board first, since redwood heartwood and sapwood take color differently. Prices ran roughly 45 to 60 dollars per gallon at the time of writing."
  },
  {
    "id": "cabot-australian-timber-oil",
    "badge": "Richest Color",
    "category": "Oil-based translucent finish",
    "name": "Cabot Australian Timber Oil",
    "amazonUrl": "",
    "bottomLine": "A warm, rich translucent oil for owners who want redwood to look deep and saturated.",
    "pros": [
      "Rich, translucent color enhances grain",
      "Penetrates hardwoods and softwoods",
      "Widely available at major retailers",
      "No film to peel",
      "Several warm tones suited to redwood"
    ],
    "cons": [
      "Some tones read orange on pale wood",
      "Longer dry times",
      "Excess must be wiped carefully"
    ],
    "description": "Cabot Australian Timber Oil is a translucent oil-based finish known for rich color. It was designed with dense hardwoods in mind but works on redwood and cedar too, and many redwood owners choose it for the depth it adds to the grain. Its warm tones suit redwood well, giving boards a saturated, almost furniture-like look when first applied. Because it penetrates rather than forming a film, it fades gradually and can be refreshed after cleaning. It is widely stocked at major retailers, which makes touch-ups easy. The main caution is color. Some tones read orange or very dark on pale sapwood, so test on a scrap or hidden board and judge it in sunlight. Apply thin coats and wipe off what the wood does not absorb, since excess can stay tacky. Dry times are longer than water-based products, and cleanup requires mineral spirits. For owners who want redwood to look richer than its natural color, it is the strongest choice here. Prices were roughly 45 to 65 dollars per gallon at the time of writing."
  },
  {
    "id": "sikkens-proluxe-cetol-srd",
    "badge": "Best Semi-Transparent",
    "category": "Semi-transparent alkyd stain",
    "name": "Sikkens ProLuxe Cetol SRD",
    "amazonUrl": "",
    "bottomLine": "A semi-transparent stain with strong UV protection for redwood decks and siding in harsh sun.",
    "pros": [
      "One-coat semi-transparent stain per the maker",
      "Transparent iron oxide pigments for UV protection",
      "Long reputation on cedar and redwood",
      "Works on decks, siding and fences",
      "Rich natural tones"
    ],
    "cons": [
      "Mostly sold at paint stores and online",
      "Higher price per gallon",
      "Darker look than penetrating oils"
    ],
    "description": "Sikkens ProLuxe Cetol SRD is a semi-transparent stain with a long reputation on cedar and redwood, particularly in sunny regions. The manufacturer describes it as a one-coat, penetrating, semi-transparent product, and it relies on transparent iron oxide pigments to block UV while letting grain show. That gives it more sun protection than the lighter penetrating oils above, at the cost of a slightly darker, more stain-like look. It is a good fit for redwood decks and siding that face south or west, or for older redwood that needs more color to look uniform. Owners commonly describe it as holding color well on vertical surfaces, with horizontal traffic areas needing touch-ups over time. It is sold mainly through paint stores and online, and it costs more per gallon than most big-box finishes. Follow the label's prep and coverage guidance closely, and test the tone on a sample board, since redwood heartwood and sapwood absorb it differently. Prices were roughly 55 to 75 dollars per gallon at the time of writing."
  },
  {
    "id": "defy-extreme-wood-stain",
    "badge": "Best Water-Based",
    "category": "Water-based semi-transparent stain",
    "name": "DEFY Extreme Semi-Transparent Wood Stain",
    "amazonUrl": "",
    "bottomLine": "The water-based option for redwood owners in low-VOC states or with short weather windows.",
    "pros": [
      "Soap-and-water cleanup and low odor",
      "Zinc oxide particles for UV resistance",
      "Redwood-friendly tones available",
      "Fast drying",
      "Sold where many oil finishes are restricted"
    ],
    "cons": [
      "Needs warm, dry conditions to cure",
      "Can look flatter than an oil",
      "Shorter life on very sunny decks"
    ],
    "description": "DEFY Extreme Semi-Transparent Wood Stain is a water-based finish that uses zinc oxide nanoparticles and pigment to resist UV. For redwood owners, its main advantages are practical: soap-and-water cleanup, low odor, fast drying and legal sale in states with strict VOC limits, where some oil-based finishes are unavailable. The line includes tones that suit redwood, and the semi-transparent pigment helps keep the red from fading. It penetrates rather than forming a heavy film, so wear shows as fading instead of peeling. The cautions are typical for water-based products. It wants warm, dry weather and no dew while it dries, and owners note it can look a little flatter than an oil on redwood, without the wet, warm glow oil gives the grain. Expect yearly or every-other-year recoats on sunny decks and longer intervals on siding. If you prefer oil finishes, the picks above suit redwood better; if you need a water-based product, this is the one to start with. Prices ran roughly 40 to 55 dollars per gallon at the time of writing."
  },
  {
    "id": "olympic-maximum-stain-sealant",
    "badge": "Best Big-Box Pick",
    "category": "Stain and sealant in one",
    "name": "Olympic Maximum Stain + Sealant in One, Semi-Transparent",
    "amazonUrl": "",
    "bottomLine": "An easy-to-find, mid-priced stain and sealant for redwood owners shopping at Lowe's.",
    "pros": [
      "Widely available at Lowe's with tinting",
      "Stain and sealant in one product",
      "Mildew-resistant finish per the label",
      "Range of redwood-friendly colors",
      "Moderate price"
    ],
    "cons": [
      "Can build up with repeated coats",
      "Less natural look than penetrating oils",
      "Shorter life on horizontal surfaces in full sun"
    ],
    "description": "Olympic Maximum Stain + Sealant in One is Lowe's mainstream semi-transparent finish, and it makes sense for redwood owners who want to buy locally and have the color tinted in store. The label promises water repellency and mildew resistance on the finish, and the semi-transparent pigment helps redwood hold color better than a clear. The convenience is real: the same line includes clear, transparent, semi-transparent and solid versions, so you can change the look later without switching brands. Owners commonly report good results on fences and siding and more frequent touch-ups on sunny decks. Because it behaves somewhat more like a coating than a pure penetrating oil, repeated heavy coats can build up, so apply thin coats and only recoat when water soaks in. It also tends to look a little less natural on redwood than the penetrating oils at the top of this list. For a mid-priced, easy-to-find option, it does the job. Prices were roughly 35 to 50 dollars per gallon at the time of writing."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Redwood Sealers",
          item: "https://www.allmetalbrake.com/best-redwood-sealer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is sealing redwood actually necessary?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Redwood heartwood resists decay naturally, so it can survive unsealed, but it will turn gray and check over time. Sealing slows water absorption, cracking and mildew, and a toned finish keeps the red color. Sapwood boards and decks in wet climates benefit even more. If you want redwood to look like redwood, a finish is necessary."
          }
        },
        {
          "@type": "Question",
          "name": "What color sealer should I use on redwood?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most redwood, choose a transparent redwood tone. It adds back color, blocks more UV than a clear and evens out sapwood and heartwood. Lighter cedar or natural tones suit owners who want a golden look, and darker semi-transparent stains help on weathered or mismatched boards. Test on a sample board and judge it in sunlight."
          }
        },
        {
          "@type": "Question",
          "name": "How soon can I seal a new redwood deck?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Redwood is usually kiln-dried or air-dried before sale, so it can often be finished soon after installation once it is clean and dry. Do a water drop test: if water soaks in within a minute or two, the wood is ready. If it beads, there may be mill glaze or moisture; wait a few weeks or lightly sand."
          }
        },
        {
          "@type": "Question",
          "name": "How do I get the red color back on gray redwood?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clean the deck with an oxygen-based cleaner, rinse at low pressure and then use an oxalic acid brightener. The brightener restores much of the red and removes iron stains. Once the wood is dry, apply a redwood-toned penetrating finish. The color will not match brand-new lumber exactly but can come close."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use Thompson's WaterSeal on redwood?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can, but it is not ideal if you want to keep the red. Clear water repellents keep redwood dry but offer little UV protection, so the color still fades. If you only want to slow water damage and do not mind graying, a clear repellent is fine. For color retention, choose a toned finish."
          }
        },
        {
          "@type": "Question",
          "name": "Oil or water base: which suits redwood better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many professionals prefer oil-based penetrating finishes on redwood because they soak in well, enrich the color and fade gradually. Water-based finishes dry faster, have less odor, clean up with soap and water and are legal in low-VOC states. Both can work if they carry enough pigment and are applied to clean, dry wood."
          }
        },
        {
          "@type": "Question",
          "name": "How often should a redwood deck be resealed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most redwood decks need a fresh coat every one to three years, depending on sun, climate, foot traffic and the finish. Clear finishes often need yearly attention, while toned or semi-transparent finishes last longer. Siding and fences can go longer. Use the water drop test and recoat when water soaks in quickly."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Deck & Wood Finishes",
    tags: [
      "best redwood sealer",
      "redwood deck finish",
      "redwood stain",
      "sealing redwood",
      "redwood tannin bleed",
      "restore gray redwood"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Redwood Sealers</span> for Color That Lasts
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Bare redwood turns from red to tan to silver within a season or two of sun. A clear sealer slows the water damage but not the color loss. These seven finishes are chosen for how well they keep redwood looking red.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#penofin-original"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="6.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#why-redwood-fades" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Why Redwood Fades</a>
          <a href="#heart-and-sap" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Heartwood and Sapwood</a>
          <a href="#tone-choice" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Clear vs Toned</a>
          <a href="#prep" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Cleaning and Brightening</a>
          <a href="#restoring" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Restoring Gray Redwood</a>
          <a href="#application" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Application</a>
          <a href="#by-project" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Decks, Siding, Furniture</a>
          <a href="#cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Coverage and Cost</a>
          <a href="#upkeep" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Upkeep Schedule</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Redwood is bought for its color, and its color is the first thing it loses. The rich red of fresh heartwood comes from extractives near the surface that sunlight breaks down quickly, which is why a new redwood deck can look noticeably paler by its first fall. Water then leaches the faded extractives and leaves dark tannin streaks, and eventually the surface turns a uniform gray. Keeping redwood red is mostly a question of pigment: a finish needs some red or brown tint to block UV at the surface and to replace the color that sun takes away. The products below are chosen for that job, with clear finishes only where the owner has a specific reason to want one.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Best Redwood Sealers, Ranked
          </h2>

          <p>
            Picks are ranked from manufacturer data sheets and labels, available redwood-friendly tones, stated recoat guidance and recurring owner feedback on how each product ages on redwood. We did not run our own weathering trials. Products that can be maintained without stripping were favored, since redwood is soft and loses wood every time it is sanded hard.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
