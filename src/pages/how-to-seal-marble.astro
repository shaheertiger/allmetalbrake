const title = "How to Seal Marble: 6 Steps for Counters, Floors and Tables";
const description =
  "Seal marble in 6 steps: water-drop check, clean, dry 24 hours, apply an impregnator, wipe off in 5-15 minutes, cure 24-72 hours. It stops stains, not etching.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How to Seal Marble",
          item: "https://www.allmetalbrake.com/how-to-seal-marble/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is there a sealer to put on marble that keeps it looking natural?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. A penetrating impregnator labeled for marble soaks into the pores and leaves no film, so the stone looks and feels the same once cured. Look for wording such as no change in appearance, avoid products marked as enhancers, and try any product on a hidden spot first."
          }
        },
        {
          "@type": "Question",
          "name": "What product seals marble best for a kitchen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An impregnator with strong oil repellency, because cooking oil leaves the hardest stains to remove. Our marble sealer rankings list Tenax Proseal as the overall pick and Dry-Treat Stain-Proof Plus as the premium choice for kitchens with heavy cooking, both chosen for oil repellency on calcite stone."
          }
        },
        {
          "@type": "Question",
          "name": "How long after sealing marble can I use it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most labels allow light use within a few hours but call for 24 to 72 hours before water, cleaners or food sit on the surface. Floors usually take socks after a few hours and shoes and furniture after the full cure. Follow your product's label, since formulas differ."
          }
        },
        {
          "@type": "Question",
          "name": "How many coats of sealer does marble need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Polished marble usually takes one coat, sometimes two near the sink. Honed marble generally needs two, and tumbled marble two to three. Apply a second coat within the window the label gives, and stop once the stone no longer absorbs; extra product only dries on top as haze."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use granite sealer on marble?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Often, yes. Many impregnators are labeled for granite, marble, limestone and travertine together. Check that marble or calcite stone is listed, since a few granite products target only dense silicate stone. A spray granite cleaner-and-sealer is fine for upkeep but does not replace a full impregnator coat."
          }
        },
        {
          "@type": "Question",
          "name": "Does sealing marble make it shiny?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Impregnators add no gloss; the shine on polished marble comes from grinding and polishing the stone. For more shine on a dull floor, the lasting fix is professional polishing. Topical sealer-and-shine products add gloss through a film, but that film scuffs and must be stripped and recoated."
          }
        },
        {
          "@type": "Question",
          "name": "Should outdoor marble be sealed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can be, with a breathable impregnator rated for exterior use, which helps against dirt and staining. It will not stop acid rain from slowly etching the surface, so outdoor marble develops a soft patina. Avoid film-forming coatings outside, since they trap moisture and can peel or cloud."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
  ],
};
