---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Deck Stains",
    "url": "/best-deck-stain-reviews/"
  },
  {
    "title": "Best Stain for Pressure-Treated Decks",
    "url": "/best-deck-stain-for-pressure-treated-wood/"
  },
  {
    "title": "Top Oil-Based Deck Stains",
    "url": "/best-oil-based-deck-stain/"
  },
  {
    "title": "Best Exterior Wood Sealer",
    "url": "/best-exterior-wood-sealer/"
  },
  {
    "title": "Deck Stain Drying Time",
    "url": "/deck-stain-drying-time/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "Cedar Deck Stain Guide: 7 Finishes That Hold the Warm Color";
const description =
  "Seven stains suited to soft, tannin-rich cedar, ranked by look and upkeep, plus how to handle mill glaze, tannin bleed and graying on a cedar deck.";

const PRODUCTS = [
  {
    "id": "armstrong-clark-cedar",
    "name": "Armstrong Clark Semi-Transparent Stain (Cedar)",
    "category": "Oil-based penetrating stain",
    "badge": "Best Overall for Cedar",
    "amazonUrl": "",
    "pros": [
      "Penetrates soft cedar without building a film",
      "Mix of drying and non-drying oils stays flexible",
      "Cedar tone closely matches the natural wood",
      "Fades evenly, so recoats need no stripping",
      "Semi-solid version available for older boards"
    ],
    "cons": [
      "Usually ordered online or from specialty dealers",
      "Premium price per gallon",
      "Mineral spirits needed for cleanup"
    ],
    "bottomLine": "The finish that best keeps cedar looking like cedar while cutting recoat effort to a minimum.",
    "description": "Armstrong Clark suits cedar because it behaves like the wood wants it to. The formula combines oils that cure inside the fibers with oils that stay soft and keep the surface supple, so the finish moves with cedar as it swells in wet weather and shrinks in dry spells. It sinks in rather than sitting on top, which matters on a soft wood that a film-forming finish can trap moisture in. The Cedar color is close to the natural tone of new western red cedar, so the deck looks refreshed rather than painted, while the pigment is enough to slow the silvering that bare cedar goes through in its first summer. When it wears, it fades rather than flaking, and the maintenance coat is a cleaning, a brightener and one thin coat. It costs more than store brands and is not always on the shelf locally, but for a cedar deck you intend to keep looking like cedar, it is the most complete answer. Order a sample first, since cedar varies from board to board and the shade looks different on pale and dark heartwood."
  },
  {
    "id": "twp-1500-cedartone",
    "name": "TWP 1500 Series Wood Protector (1516 Cedartone)",
    "category": "Oil-based semi-transparent preservative",
    "badge": "Best for Damp, Shaded Cedar",
    "amazonUrl": "",
    "pros": [
      "Mildewcides and fungicides in the formula",
      "VOC-compliant and sold in all 50 states",
      "Cedartone color warms up weathered boards",
      "Penetrates rough-sawn and smooth cedar"
    ],
    "cons": [
      "Strong solvent smell",
      "Puddles turn tacky if not wiped",
      "Some owners find the color more orange than natural cedar"
    ],
    "bottomLine": "The best choice for a cedar deck that lives in shade or humidity and keeps growing mildew.",
    "description": "Cedar resists rot, but its surface still grows mildew and algae when it stays damp, and that is the problem the TWP 1500 Series is built to fight. It is an oil-based semi-transparent stain registered as a wood preservative, with mildewcides and fungicides in the mix, and it is the VOC-compliant member of the TWP family, so it can be bought anywhere in the country. On cedar it soaks in quickly, and the 1516 Cedartone shade adds a warm, slightly orange tone that brings tired gray cedar back to a convincing wood color. On new, very light cedar, that same shade can look a little brighter than expected, so test a sample on a hidden board first. TWP often recommends a second wet-on-wet coat on thirsty wood, but cedar can saturate quickly, so wipe any stain that is still glossy after the time listed on the label. Owners in humid regions commonly report it holds back mildew noticeably better than plain oils, which saves a scrubbing session every spring."
  },
  {
    "id": "ready-seal-natural-cedar",
    "name": "Ready Seal Exterior Stain and Sealer (Natural Cedar)",
    "category": "Oil-based penetrating stain",
    "badge": "Easiest Application",
    "amazonUrl": "",
    "pros": [
      "Designed to go on without lap marks",
      "No back-brushing or primer required per the label",
      "Sprays easily for large decks",
      "Natural Cedar shade suits cedar and redwood",
      "Simple maintenance recoats"
    ],
    "cons": [
      "Looks too orange until it cures for about two weeks",
      "Moderate pigment means more frequent recoats in hot sun",
      "Strong odor while applying"
    ],
    "bottomLine": "The most forgiving stain for a cedar deck if you are doing the job yourself for the first time.",
    "description": "Cedar soaks up stain fast and unevenly, which makes lap marks and dark overlaps a constant risk with quick-drying products. Ready Seal sidesteps that. The oil-based formula is designed to stay workable long enough that you can stop partway through a board or come back to an area without leaving visible lines, and the manufacturer says it needs no back-brushing. That makes it the friendliest option for a first-time stainer or for a large cedar deck you want to spray. Natural Cedar is the obvious shade for cedar; it looks strongly orange on the day you apply it but settles into a warm, natural tone over roughly two weeks as the solvent evaporates. The moderate pigment load means sunny cedar decks often need a floor refresh after one to two years, but that refresh is straightforward: clean, let dry and apply again. If you value an easy, low-stress job over maximum longevity, it is hard to beat. The 5-gallon pail also keeps a big deck on one consistent batch."
  },
  {
    "id": "defy-extreme-cedar-tone",
    "name": "DEFY Extreme Semi-Transparent Stain (Cedar Tone)",
    "category": "Water-based semi-transparent stain",
    "badge": "Best Water-Based for Cedar",
    "amazonUrl": "",
    "pros": [
      "Zinc oxide nano-particles for UV resistance",
      "Low odor and soap-and-water cleanup",
      "Low VOC and legal in all states",
      "Dries quickly so the deck is usable sooner"
    ],
    "cons": [
      "Fast drying increases the risk of lap marks",
      "Tannin-rich cedar must be cleaned and brightened carefully",
      "Thin coats needed to avoid a surface film"
    ],
    "bottomLine": "The water-based pick for cedar decks where low odor and quick turnaround matter most.",
    "description": "Plenty of oil-stain loyalists have come around to DEFY Extreme, and on cedar it makes a strong case for water-based chemistry. On cedar, its UV protection comes from zinc oxide nano-particles, which help the Cedar Tone color hold against sun bleaching, and it is formulated to penetrate rather than build a film, which is important on soft wood. It dries quickly, cleans up with water and carries a low-VOC formula that is legal in every state. Cedar brings two challenges for any water-based stain. First, its tannins can bleed through as brownish marks if the wood is not cleaned and brightened properly beforehand. Second, cedar absorbs quickly, so fast-drying stain is prone to lap marks if you work in the sun or stop mid-board. Work early or late in the day, keep a wet edge and apply thin coats. With good prep, owners commonly report that the color holds well for two years or more on the floor."
  },
  {
    "id": "cabot-australian-timber-oil",
    "name": "Cabot Australian Timber Oil",
    "category": "Translucent penetrating oil",
    "badge": "Best Rich, Translucent Look",
    "amazonUrl": "",
    "pros": [
      "Linseed and tung oil blend for deep penetration",
      "Translucent finish shows off cedar grain",
      "Warm tones such as Honey Teak and Natural",
      "Sold widely in paint and home stores"
    ],
    "cons": [
      "Less pigment means faster fading in direct sun",
      "Slow to cure in cool or humid weather",
      "Over-application leaves a sticky finish"
    ],
    "bottomLine": "Choose it when you want the grain to be the star and you are fine refreshing the floor every year.",
    "description": "Cabot Australian Timber Oil gives cedar a finish that looks closer to oiled furniture than to a typical deck stain. The oil blend, which includes linseed and tung oil, soaks into the open grain of cedar easily, and the translucent tints add warmth without hiding the figure of the wood. Honey Teak and Natural are the colors most people choose for cedar, because they deepen its natural honey and red tones rather than replacing them. That beauty comes with more maintenance. Translucent oils carry less pigment than semi-transparent stains, so they offer less UV protection, and a sunny cedar deck will usually need a floor refresh about once a year. On a covered or shaded cedar deck, the interval stretches considerably. Apply one thin coat, wipe off any surplus before it gets tacky, and avoid application on cold or humid days when curing slows down. For cedar where appearance matters most, it is a beautiful option."
  },
  {
    "id": "penofin-blue-label",
    "name": "Penofin Penetrating Oil Finish (Blue Label)",
    "category": "Oil-based penetrating oil",
    "badge": "Best Natural-Oil Finish",
    "amazonUrl": "",
    "pros": [
      "Penetrating oil made for softwoods such as cedar",
      "Rosewood-oil based formula",
      "Enhances grain with a natural, low-sheen look",
      "Easy to spot-maintain worn areas"
    ],
    "cons": [
      "Harder to find than mainstream brands",
      "Needs a maintenance coat more often on sunny decks",
      "Oily rags must be handled carefully to prevent fire"
    ],
    "bottomLine": "A strong choice for cedar owners who want an oiled, natural look and are happy with regular maintenance.",
    "description": "Penofin has long been a favorite of cedar and redwood owners who want a natural, oiled look. Its penetrating finishes are built around Brazilian rosewood oil, and the Blue Label line is aimed at softwoods such as cedar, pine and fir. On cedar it soaks in deeply, enriches the grain and leaves a low-sheen surface that looks like well-cared-for wood rather than a coating. Transparent and tinted versions are available; the tinted ones give meaningfully more UV protection, so they are the better choice for a sunny deck. Because it is a penetrating oil, maintenance is simple: clean the deck and apply another thin coat to the worn areas, with no stripping and no visible patch lines once it settles. Like any linseed or drying-oil product, rags and pads soaked with it can self-heat and catch fire, so lay them flat to dry outside or seal them in a metal can filled with water before disposal."
  },
  {
    "id": "thompsons-waterseal-timber-oil",
    "name": "Thompson's WaterSeal Penetrating Timber Oil",
    "category": "Oil-based penetrating stain",
    "badge": "Best Budget",
    "amazonUrl": "",
    "pros": [
      "Low price per gallon",
      "Sold at most home centers",
      "Oil-based penetration on softwoods",
      "Several wood-tone colors suit cedar"
    ],
    "cons": [
      "Generally shorter life on floors than premium oils",
      "Limited color range",
      "Coverage varies widely on weathered wood"
    ],
    "bottomLine": "A reasonable budget oil for a small or shaded cedar deck when you plan to recoat often.",
    "description": "This is the budget choice for cedar owners who want an oil-based finish without a premium price. It is sold at most home centers, it soaks into softwoods the way a penetrating oil should, and its wood-tone colors suit cedar reasonably well. It adds water repellency and some UV protection, which slows graying and limits checking on the boards. Where it trails the premium oils is longevity, especially on the floor of a sunny deck. Owners commonly report needing to recoat the walking surfaces every year or two, while railings hold up longer. Thompson's product is widely stocked and simple to apply. For a small deck, a shaded deck or a rental, that trade is perfectly sensible, because recoating a penetrating oil is just a cleaning and another thin coat. Do the prep properly, test the color first on a cleaned and dried cedar board, and apply in thin coats, and it will give you an honest, affordable finish."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Cedar Deck Stain Picks",
          item: "https://www.allmetalbrake.com/best-deck-stain-for-cedar/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which kind of stain suits a cedar deck best?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A penetrating, oil-based semi-transparent stain in a cedar or natural tone is the best fit for most cedar decks. It soaks into the porous wood, adds enough pigment to slow graying, shows the grain and wears by fading rather than peeling. Water-based semi-transparent stains also work if the wood is cleaned and brightened well."
          }
        },
        {
          "@type": "Question",
          "name": "How do I stop cedar from turning silver?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Graying comes from UV light breaking down the wood surface, so you need pigment, not just water repellent. Use a semi-transparent or translucent stain with real color, recoat when the color fades, and wash the deck each spring. Clear sealers keep water out but will not stop the sun from graying cedar."
          }
        },
        {
          "@type": "Question",
          "name": "Should new cedar weather before it is stained?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "New cedar usually needs a short wait or some prep because of mill glaze, a crushed and glossy surface left by planing. You can let it weather for a few weeks to a few months, or clean, brighten and lightly sand it right away. Either way, use the water-drop test to confirm the wood absorbs before staining."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use water-based stain on cedar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, but prep matters more. Cedar tannins can bleed through water-based finishes and leave brown marks. Clean the deck, apply a wood brightener to remove surface tannins, rinse and let the boards dry fully. Apply thin coats in the shade, keep a wet edge, and choose a product that specifically lists cedar on the label."
          }
        },
        {
          "@type": "Question",
          "name": "Is a clear finish enough for cedar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only in limited cases. Clear finishes keep water out but offer little protection from UV, so cedar in the sun will still turn gray. They suit covered decks, very shaded decks and owners willing to reapply every year. For most cedar decks, a lightly pigmented semi-transparent stain gives far better color retention."
          }
        },
        {
          "@type": "Question",
          "name": "How long does stain last on a cedar deck?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A semi-transparent stain on a cedar deck floor typically lasts about two to three years, while railings often go three to five. Translucent oils may need yearly attention in full sun. Shade, foot traffic, climate and the quality of the prep all shift those numbers, so inspect the deck each spring and recoat when the color fades."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to strip cedar before restaining?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not if the previous finish was a penetrating stain that has worn evenly. Clean, brighten and apply a thin coat of the same product. Stripping is needed if the old finish is peeling, if it is a solid stain, if you are switching between oil and water-based chemistry, or if you want a noticeably lighter color."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Deck & Wood Finishes",
    tags: [
      "best deck stain for cedar",
      "cedar deck stain",
      "western red cedar finish",
      "stop cedar graying",
      "tannin bleed",
      "penetrating oil stain"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best Stain for a <span class="text-[#38BDF8]">Cedar Deck</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Cedar is the reason many people build a wood deck at all. The right finish keeps that warm color; the wrong one hides it, blotches it or peels within a year.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#armstrong-clark-cedar"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="12.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top 7 Picks</a>
          <a href="#which-pick" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Which Pick Fits</a>
          <a href="#cedar-nature" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. How Cedar Behaves</a>
          <a href="#opacity" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Picking an Opacity</a>
          <a href="#tannins" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Oil, Water and Tannins</a>
          <a href="#new-cedar" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. New Cedar Decks</a>
          <a href="#prep" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Prep for Cedar</a>
          <a href="#application" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Applying the Stain</a>
          <a href="#species" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Cedar Species</a>
          <a href="#upkeep" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Stopping the Gray</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Cedar does not need a heavy coating. It is naturally resistant to decay, it is soft and porous, and it is full of oils and tannins that react badly to some finishes. What it needs is a light, penetrating stain with enough pigment to stop the sun from bleaching it gray, applied thin enough that the wood can still breathe.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Best Stains for Cedar Decks
          </h2>

          <p>
            These rankings draw on manufacturer data sheets and labels (penetration, resin type, pigment level, VOC compliance and recoat instructions), on how each product is positioned for softwoods such as cedar, and on recurring themes in owner feedback about color, blotching and peeling. We have not run our own field trials, and no manufacturer paid to be included.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
