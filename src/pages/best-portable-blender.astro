const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Portable Blender",
          item: "https://www.allmetalbrake.com/best-portable-blender/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Can a portable blender crush ice?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some can handle small amounts with enough liquid, but none crush ice like a corded blender. Ninja markets both Blast models for frozen drinks, and owners report they cope with normal frozen-fruit smoothies. Use crushed ice rather than whole cubes, add liquid first, and blend in short bursts. If you want icy drinks daily, a corded personal blender is the better tool."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a portable blender battery last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Makers quote battery life in blends per charge, and those are best-case figures for easy recipes. Frozen fruit that makes the motor work hard uses much more energy per blend. In regular use, expect to charge every few days. The lithium-ion cell also loses capacity over hundreds of cycles and is usually not replaceable in a portable blender."
          }
        },
        {
          "@type": "Question",
          "name": "Can I charge a portable blender with a power bank?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if it charges over USB-C, as the Ninja Blast, Blast Max and BlendJet 2 do. Any reasonable power bank or USB-C car charger will top it up. Many cordless blenders are designed not to run while plugged in, so charge it fully rather than expecting to blend on the cable when the battery is flat."
          }
        },
        {
          "@type": "Question",
          "name": "Are portable blenders dishwasher-safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The jar and lid often are, but check each model: Ninja lists the Blast's vessel and lid as dishwasher-safe. The motor base never is. The quickest routine is to blend warm water with a drop of dish soap right after use, rinse, and wipe the base with a damp cloth. Check the silicone gasket is seated properly after every wash."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best portable blender for smoothies with frozen fruit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Among cordless models, the Ninja Blast Max gives the most room for liquid and Ninja positions it for thicker drinks, while the standard Ninja Blast is the best all-rounder. If frozen smoothies are the main reason you are buying, and you have an outlet or a power station, the corded NutriBullet Pro 900 will give you a smoother result than any battery blender."
          }
        },
        {
          "@type": "Question",
          "name": "Can I run a regular blender on a portable power station?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if the station's continuous AC output exceeds the blender's rated wattage with a margin for startup surge. A 900-watt personal blender suits a station rated around 1,000 watts or more. Many full-size blenders draw 1,200 to 1,500 watts or more and need a large station. Energy use per smoothie is small, so the inverter rating matters more than battery size."
          }
        },
        {
          "@type": "Question",
          "name": "Is a portable blender worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is worth it if you want fresh shakes and fruit smoothies away from an outlet, at the gym, office or campsite. It is not worth it if you mostly make thick blends, large batches or icy drinks, or if your blender will always sit near an outlet. In those cases a cheap corded personal blender does more and has no battery to wear out."
          }
