const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "The Best Portable Blenders: Cordless Picks That Handle Frozen Fruit";
const description =
  "Six portable blenders for the gym, office and campsite, with honest limits on ice and frozen fruit, USB-C charging, cleaning and when a corded blender wins.";

