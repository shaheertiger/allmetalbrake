---
// Home page in the sister-site order (besthometheaterreview.com): hero → quick answer → browse by
// category → picks by need → top 10 → spec-sheet promise → how we're different → latest → identity.
import Base from '../layouts/Base.astro';
import Score from '../components/Score.astro';
import NavIcon from '../components/NavIcon.astro';
import ProductImage from '../components/ProductImage.astro';
import { SITE } from '../data/site';
import { CATEGORIES } from '../data/categories';
import { NAV_GROUPS } from '../data/nav';
import { HOME, NICHE } from '../data/niche';
import { PRODUCTS, GUIDES, BRANDS, getGuide, getProduct, guidePath, productPath, priceBand, categoryOf, guideUpdated, inline } from '../lib/data';
const hero = getGuide(HOME.hero);
const heroPick = hero ? getProduct(hero.picks[0].id) : undefined;
const top10 = [...PRODUCTS].sort((a, b) => b.score.overall - a.score.overall).slice(0, 10);
const featured = CATEGORIES.map((c) => getGuide(c.hero)).filter((g) => g && !g.noindex && g.picks?.length);
const latest = [...GUIDES.filter((g) => g.type !== 'article' && !g.noindex)].sort((a, b) => guideUpdated(b).localeCompare(guideUpdated(a)) || a.slug.localeCompare(b.slug)).filter((g) => !featured.includes(g)).slice(0, 6);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const browse = NAV_GROUPS.filter((grp) => grp.home);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'ItemList', name: `Best ${NICHE.lower} guides`, itemListElement: featured.map((g, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}${guidePath(g!)}`, name: g!.h1 })) },
  ],
};
---
<Base title={HOME.title(SITE.name)} description={HOME.description(PRODUCTS.length)} jsonLd={jsonLd}>
  <section class="home-hero">
    <div class="wrap">
      <p class="kicker">{HOME.kicker}</p>
      <h1>{HOME.h1}</h1>
      <p class="hub-dek">{HOME.dek(PRODUCTS.length, new Set(PRODUCTS.map((p) => p.brand)).size)}</p>
      <div class="hero-cta"><a class="buy" href={HOME.ctas[0].href}>{HOME.ctas[0].label}</a><a class="btn-ghost dark" href={HOME.ctas[1].href}>{HOME.ctas[1].label}</a></div>
      <p class="hero-trust">Independent · Spec-sheet first · No paid rankings</p>
    </div>
  </section>

  <div class="wrap">
    {hero && heroPick && (
      <section class="home-answer">
        <p class="mini">Quick answer</p>
        <h2>{HOME.answerH2}</h2>
        <p set:html={inline(hero.quickAnswer)} />
        <p><a href={guidePath(hero)}>{HOME.answerLink(hero.picks!.length)}</a></p>
      </section>
    )}

    <section>
      <h2 class="section-title">Browse by Category</h2>
      <div class="browse">
        {browse.map((grp) => (
          <div class="browse-col">
            <h3>{grp.label}</h3>
            <ul>{grp.items.map((it) => <li><a href={it.href}><NavIcon icon={it.icon} size={28} />{it.label}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="section-title">{HOME.featuredH2}</h2>
      <div class="grid grid-4">
        {featured.map((g) => {
          const p = getProduct(g!.picks![0].id)!;
          return (
            <a class="card" href={guidePath(g!)}>
              <ProductImage p={p} size={96} />
              <span class="card-k">{categoryOf(g!.category).label}</span>
              <h3>{g!.h1}</h3>
              <span class="card-sub">Top pick: {p.short} · {p.score.overall}/100</span>
            </a>
          );
        })}
      </div>
    </section>

    <section>
      <h2 class="section-title">The {PRODUCTS.length} {cap(NICHE.parts)} We Track: Top 10 by {SITE.score}</h2>
      <ol class="rank-list">
        {top10.map((p, i) => (
          <li>
            <span class="rk-n">{i + 1}</span>
            <ProductImage p={p} size={64} />
            <span class="rk-main"><a href={productPath(p)}>{p.name}</a><small>{categoryOf(p.category).label} · {priceBand(p)}</small></span>
            <Score value={p.score.overall} />
          </li>
        ))}
      </ol>
      <p class="fine"><a href="/gear/">See all {PRODUCTS.length} {NICHE.parts} ranked →</a></p>
    </section>

    <section class="home-prose">
      <h2 class="section-title">{HOME.promiseH2}</h2>
      <p>{HOME.promise(SITE.score)}</p>
    </section>

    <section>
      <h2 class="section-title">How We're Different From Other Review Sites</h2>
      <div class="diff-grid">
        {HOME.different.map(([h, html]) => (
          <div>
            <h3>{h}</h3>
            <p set:html={html} />
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="section-title">Latest Guides and Brand Reviews</h2>
      <div class="grid grid-3">
        {latest.map((g) => (
          <a class="card" href={guidePath(g)}>
            <span class="card-k">{g.type === 'brand' ? 'Brand Reviews' : 'Guides'}</span>
            <h3>{g.h1}</h3>
            <span class="card-sub">{g.dek}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-id">
      <h2 class="section-title">{SITE.name}</h2>
      <p>{HOME.about(SITE.name, SITE.founded)}</p>
      <p class="mini">Brands we track</p>
      <p class="term-cloud">{BRANDS.map((b) => <a href={`/brands/${b.key}/`}>{b.name}</a>)}</p>
      <p class="fine">As an Amazon Associate we earn from qualifying purchases. Rankings are never sold. <a href="/disclosure/">How we make money</a></p>
    </section>
  </div>
</Base>
