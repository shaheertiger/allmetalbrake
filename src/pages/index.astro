---
import Base from '../layouts/Base.astro';
import ProductImage from '../components/ProductImage.astro';
import Score from '../components/Score.astro';
import RelatedCards from '../components/RelatedCards.astro';
import { SITE, CATEGORY_LABELS } from '../data/site';
import { NAV } from '../data/nav';
import { products, articles, articleMap, productUrl, brands } from '../lib/data';
import { itemList, graph } from '../lib/schema';

const goalPicks = [
  { slug: 'best-home-generator-for-power-outages', label: 'Whole-home outages' },
  { slug: 'best-portable-power-station', label: 'Battery backup' },
  { slug: 'best-inverter-generator', label: 'Quiet power' },
  { slug: 'best-dual-fuel-generator', label: 'Gas or propane' },
  { slug: 'best-home-battery-backup', label: 'Home batteries' },
  { slug: 'best-generator-transfer-switch', label: 'Connect it safely' },
  { slug: 'best-solar-generator', label: 'Solar backup' },
  { slug: 'best-battery-backup-for-cpap', label: 'Medical devices' },
].map((g) => ({ ...g, a: articleMap.get(g.slug) })).filter((g) => g.a);
const top = products.filter((p) => ['generator', 'inverter', 'dual-fuel', 'power-station', 'home-battery', 'solar'].includes(p.category)).slice(0, 10);
const guides = articles.filter((a) => a.kind !== 'roundup').slice(0, 6);
const schema = graph(itemList(goalPicks.map((g) => ({ name: g.a!.h1, url: `/${g.slug}/` })), 'Best backup power gear'));
---
<Base title="Backup Power Buying Guides: Generators and Power Stations (2026)" description={SITE.description} schema={schema}>
  <section class="bg-[#0b1120] text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-gold">Independent · Spec-sheet first · No paid rankings</p>
      <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight leading-[1.1] max-w-3xl">Read the Spec Sheet. Keep the Lights On.</h1>
      <p class="mt-5 text-lg text-slate-300 max-w-2xl">We match generators, power stations and home batteries to the loads you need to run and the outages you actually get, and we show the maths behind every pick. {products.length} products from {brands.length} brands, scored.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/best-home-generator-for-power-outages/" class="rounded-xl bg-gold text-ink font-bold px-5 py-3 no-underline hover:brightness-95">Best Home Generators</a>
        <a href="/best-portable-power-station/" class="rounded-xl border border-white/30 font-semibold px-5 py-3 no-underline hover:bg-white/10">Best Power Stations</a>
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <section class="mt-14">
      <h2 class="text-2xl font-extrabold text-ink">Browse by Category</h2>
      <div class="mt-5 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {NAV.slice(0, 4).map((g) => (
          <div class="rounded-2xl border border-slate-200 p-5">
            <h3 class="font-bold text-ink">{g.label}</h3>
            <ul class="mt-3 space-y-2 text-sm">{g.links.slice(0, 5).map((l) => <li><a href={l.url} class="text-slate-600 hover:text-brand-600 no-underline"><span aria-hidden="true">{l.icon}</span> {l.title}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-extrabold text-ink">Best Backup Power Gear: Picks by Need</h2>
      <div class="mt-5 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {goalPicks.map((g) => {
          const first = g.a!.picks?.[0];
          const p = first ? products.find((x) => x.slug === first.product) : undefined;
          return (
            <a href={`/${g.slug}/`} class="group rounded-2xl border border-slate-200 p-5 hover:border-brand-500 hover:shadow-sm no-underline">
              <p class="text-xs font-bold uppercase tracking-wider text-gold-dark">{g.label}</p>
              <h3 class="mt-1 font-bold text-ink group-hover:text-brand-600 leading-snug">{g.a!.h1}</h3>
              {p && <p class="mt-2 text-sm text-slate-500">Top pick: <span class="font-semibold text-slate-700">{p.name}</span></p>}
            </a>
          );
        })}
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-extrabold text-ink">The {products.length} Products We Track: Top 10 by AMB Score</h2>
      <ol class="mt-5 grid md:grid-cols-2 gap-3">
        {top.map((p, i) => (
          <li class="min-w-0"><a href={productUrl(p)} class="flex items-center gap-3 sm:gap-4 rounded-xl border border-slate-200 p-3 hover:border-brand-500 no-underline">
            <span class="w-6 sm:w-7 shrink-0 text-center font-extrabold text-slate-500">{i + 1}</span>
            <ProductImage product={p} size={160} class="w-14 h-14 shrink-0 rounded-lg" />
            <span class="min-w-0 flex-1"><span class="block font-semibold text-ink leading-snug break-words">{p.name}</span><span class="text-xs text-slate-500">{CATEGORY_LABELS[p.category]}</span></span>
            <Score score={p.score} />
          </a></li>
        ))}
      </ol>
      <p class="mt-4"><a href="/gear/" class="font-semibold text-brand-600">See all {products.length} products ranked →</a></p>
    </section>

    <section class="mt-16 rounded-3xl bg-slate-50 border border-slate-200 p-6 sm:p-10">
      <h2 class="text-2xl font-extrabold text-ink">Built on the Spec Sheet, Not the Marketing</h2>
      <p class="mt-3 text-slate-600 max-w-3xl">"9,500 watts" is usually the starting surge, not what it runs. "1,000Wh" is rarely all usable once the inverter takes its cut. We read past the headline numbers, convert them into what they mean in your outage, and say plainly who should skip a product.</p>
      <h2 class="mt-10 text-2xl font-extrabold text-ink">How We're Different From Other Review Sites</h2>
      <div class="mt-5 grid md:grid-cols-3 gap-6">
        <div><h3 class="font-bold text-ink">We Do the Maths</h3><p class="mt-2 text-sm text-slate-600">Running and starting watts for your appliances, runtime for your power station, fuel for your outage. Try the <a href="/tools/generator-wattage-calculator/" class="underline">wattage calculator</a>.</p></div>
        <div><h3 class="font-bold text-ink">Loads First, Product Second</h3><p class="mt-2 text-sm text-slate-600">Every pick says who it suits and who should skip it, by load, fuel, noise and budget.</p></div>
        <div><h3 class="font-bold text-ink">No Paid Placements</h3><p class="mt-2 text-sm text-slate-600">Brands can't buy a spot or a score. <a href="/how-we-test/" class="underline">See how we score</a>.</p></div>
      </div>
    </section>

    {guides.length > 0 && (
      <section class="mt-14"><h2 class="text-2xl font-extrabold text-ink">Latest Guides &amp; Brand Reviews</h2><RelatedCards articles={guides} /></section>
    )}
  </div>
</Base>
