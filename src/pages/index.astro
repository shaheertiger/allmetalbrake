---
import Layout from '../layouts/Layout.astro';
import TrustBadge from '../components/TrustBadge.astro';
import { NAV_GROUPS } from '../data/nav';
import TOP_PICKS from '../data/top-picks.json';
import { amazonLink } from '../data/affiliate';
import productImages from '../data/product-images.json';

// Most-read guides, in order of reader traffic.
const byUrl = new Map(NAV_GROUPS.flatMap((g) => g.links).map((l) => [l.url, l]));
const POPULAR = [
  '/best-home-generator-for-power-outages/', '/how-to-get-oil-out-of-concrete/', '/best-gas-water-heater/',
  '/best-water-filter-pitcher/', '/best-vinyl-plank-flooring/', '/best-solar-power-bank/',
].map((url) => byUrl.get(url)).filter(Boolean) as { url: string; title: string; blurb: string }[];

// The #1 pick of each most-read guide, for the picks table.
const PILLARS = TOP_PICKS.pillars as Record<string, { id: string; name: string; badge?: string; guide: string; amazonUrl?: string }>;
const TOP_TABLE = [
  'best-solar-power-bank', 'best-water-filtration-system-for-home', 'best-home-generator-for-power-outages',
  'best-garage-floor-epoxy', 'best-50-pint-dehumidifier', 'best-mold-remover', 'best-portable-power-station',
  'best-oil-stain-remover-for-concrete', 'best-stud-finder', 'best-shop-vac',
].filter((slug) => PILLARS[slug]).map((slug) => ({ slug, ...PILLARS[slug], thumb: (productImages as Record<string, string>)[PILLARS[slug].id] }));

// Seasonal guides, refreshed about four weeks before their season so Bing has
// recrawled them when demand arrives. Swap the list each season:
//   Nov-Feb  outages, heat, ice      Mar-May  lawn, deck, driveway prep
//   Jun-Aug  sealing, AC, camping    Sep-Oct  leaves, gutters, generators
const SEASON_LABEL = 'Get Ready for Winter Storms and Outages';
const SEASONAL = [
  '/best-home-generator-for-power-outages/', '/best-indoor-heater-for-power-outage/', '/best-portable-power-station-for-home-backup/',
  '/best-ice-melt-for-concrete/', '/best-generator-transfer-switch/', '/best-dual-fuel-generator/',
].map((url) => byUrl.get(url)).filter(Boolean) as { url: string; title: string; blurb: string }[];

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'All Metal Brake',
  url: 'https://www.allmetalbrake.com',
  description: 'Independent buying guides for driveways, garage floors, basements, backup power, lawn equipment and tools.',
};
---
<Layout
  title="Home Improvement Buying Guides: Generators, Driveways and More"
  description="Honest buying guides for home generators, power stations, driveway sealers, garage floors, basements, water filters, yard equipment and tools, updated for 2026."
  jsonLd={siteSchema}
  aiSummary="Home page of All Metal Brake, an independent home-improvement review site. It links to the site's buying guides, comparisons and how-to articles on driveways, garage floors, basements, generators, lawn equipment and tools."
>
  <div class="space-y-20">
    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-16 pb-24 lg:pt-32 lg:pb-40 bg-gradient-to-br from-white to-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:gap-8 items-center">
          <div class="text-center lg:text-left">
            <div class="inline-block mb-4">
              <TrustBadge />
            </div>
            <h1 class="text-5xl lg:text-7xl font-black tracking-tight text-[#333333] mb-6 leading-[1.1]">
              Stop Guessing. <br />
              <span class="text-[#1E90FF]">Start Buying Smarter.</span>
            </h1>
            <p class="text-xl text-gray-600 mb-10 max-w-xl mx-auto lg:mx-0 leading-relaxed">
              Independent buying guides for the jobs around your house: driveways, garage floors, basements, backup power, lawn equipment and tools.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a
                href="/best-of/"
                class="bg-[#FF4500] hover:bg-[#E63E00] text-white px-8 py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2 shadow-xl hover:shadow-2xl transition-all no-underline"
              >
                View Best of 2026
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </a>
              <a href="/how-we-test/" class="bg-white hover:bg-gray-50 text-[#333333] border-2 border-gray-200 px-8 py-4 rounded-xl font-bold text-lg shadow-sm no-underline text-center">
                How We Pick
              </a>
            </div>
          </div>
          <div class="mt-16 lg:mt-0 relative">
            <div class="absolute -top-12 -right-12 w-64 h-64 bg-[#1E90FF]/10 rounded-full blur-3xl"></div>
            <div class="relative bg-gray-900 rounded-3xl p-8 lg:p-10 shadow-2xl">
              <p class="text-xs font-black uppercase tracking-[0.18em] text-[#38BDF8] mb-6">What we check on every product</p>
              <ul class="space-y-5 list-none p-0 m-0">
                {[
                  ['The spec sheet', 'output, capacity and ratings, read from the maker'],
                  ['Certifications', 'UL, NSF, EPA and Energy Star, looked up, not assumed'],
                  ['Real-world fit', 'what the job actually needs, not the biggest number'],
                  ['Owner reports', 'how it holds up after the first season'],
                  ['The catch', 'every pick gets a cons list'],
                ].map(([title, note]) => (
                  <li class="flex items-start gap-3">
                    <span class="w-6 h-6 rounded-full bg-[#FF4500] text-white flex items-center justify-center shrink-0 mt-0.5">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    </span>
                    <span>
                      <span class="block font-bold text-white">{title}</span>
                      <span class="block text-sm text-gray-400">{note}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Seasonal -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-black text-gray-900 mb-2">{SEASON_LABEL}</h2>
      <p class="text-gray-500 mb-8">The guides readers need most this time of year.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {SEASONAL.map((g) => (
          <a href={g.url} class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md hover:border-[#1E90FF]/40 transition-all no-underline group">
            <h3 class="text-lg font-black text-gray-900 group-hover:text-[#1E90FF] m-0">{g.title}</h3>
            <p class="text-sm text-gray-500 mt-2 mb-0">{g.blurb}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Browse by Category -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-10">
        <h2 class="text-3xl font-bold flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#1E90FF]"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
          Browse by Category
        </h2>
        <a href="/best-of/" class="text-[#1E90FF] font-bold hover:underline flex items-center gap-1 no-underline">
          See all
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-5 gap-6">
        {NAV_GROUPS.map(group => (
          <a
            href={group.links[0].url}
            class="group bg-white border border-gray-100 p-8 rounded-3xl text-center hover:border-[#1E90FF] hover:shadow-xl transition-all no-underline"
          >
            <span class="text-5xl block mb-6 transform group-hover:scale-110 transition-transform">{group.icon}</span>
            <h3 class="font-bold text-lg text-gray-900 group-hover:text-[#1E90FF]">{group.label}</h3>
            <p class="text-gray-400 text-sm mt-2">{group.links.length} guides</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Best-Of Guides -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-10">
        <h2 class="text-3xl font-bold flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#FF4500]"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          Best-Of Buying Guides
        </h2>
        <a href="/best-of/" class="text-[#1E90FF] font-bold hover:underline flex items-center gap-1 no-underline">
          See all
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
      </div>

      <!-- Featured Guide -->
      <div class="grid grid-cols-1 lg:grid-cols-2 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 rounded-3xl overflow-hidden shadow-2xl border border-gray-700">
        <div class="p-10 lg:p-14">
          <span class="inline-flex px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">#1 Guide</span>
          <h3 class="text-3xl lg:text-4xl font-black text-white leading-tight mt-6 mb-4">
            The Best Solar Power Banks:<br/>
            <span class="text-[#1E90FF]">What Actually Charges From the Sun</span>
          </h3>
          <p class="text-gray-400 text-lg leading-relaxed mb-8">
            A solar cell on the lid adds a few percent a day. Here is what really keeps a phone alive off-grid, and the picks worth buying to do it.
          </p>
          <a href="/best-solar-power-bank/" class="inline-flex items-center gap-2 bg-[#FF4500] hover:bg-[#E63E00] text-white px-8 py-4 rounded-xl font-black no-underline shadow-lg">
            Read the Full Guide
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
        <div class="bg-white/5 border-t lg:border-t-0 lg:border-l border-white/10 p-10 lg:p-14 flex flex-col justify-center gap-3">
          <p class="text-gray-400 text-xs font-black uppercase tracking-widest mb-2">More Buying Guides</p>
          {POPULAR.filter((g) => g.url !== '/best-solar-power-bank/').map((g) => (
            <a href={g.url} class="flex items-center gap-4 bg-white/5 hover:bg-white/10 rounded-2xl px-5 py-4 border border-white/10 no-underline">
              <span class="flex-1 min-w-0">
                <span class="block font-bold text-white text-sm">{g.title}</span>
                <span class="block text-xs text-[#38BDF8] font-semibold truncate">{g.blurb}</span>
              </span>
              <svg class="w-4 h-4 text-gray-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6" /></svg>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Top Picks Table -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-black uppercase tracking-[0.18em] text-[#D93A00] mb-2">Our #1 Picks</p>
      <h2 class="text-3xl font-black text-gray-900 mb-2">The Product We'd Buy, Guide by Guide</h2>
      <p class="text-gray-600 mb-8 max-w-2xl">The top pick from each of our most-read buying guides. Open the guide for the runners-up, the specs and the cons.</p>
      <div class="border border-gray-200 rounded-2xl overflow-x-auto">
        <table class="w-full text-left min-w-[640px]">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr class="text-xs font-black uppercase tracking-wider text-gray-500">
              <th class="px-4 py-3 w-10">#</th>
              <th class="px-4 py-3">Guide</th>
              <th class="px-4 py-3">Our #1 Pick</th>
              <th class="px-4 py-3">Why</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody>
            {TOP_TABLE.map((row, i) => (
              <tr class="border-b border-gray-100 last:border-0">
                <td class="px-4 py-4 text-gray-400 font-semibold">{i + 1}</td>
                <td class="px-4 py-4"><a href={`/${row.slug}/`} class="font-bold text-gray-900 no-underline hover:text-[#1E90FF]">{row.guide}</a></td>
                <td class="px-4 py-4">
                  <span class="flex items-center gap-3">
                    {row.thumb && (
                      <img src={row.thumb} alt="" width="40" height="40" loading="lazy" class="w-10 h-10 object-contain shrink-0" />
                    )}
                    <span class="text-sm text-gray-800">{row.name}</span>
                  </span>
                </td>
                <td class="px-4 py-4"><span class="inline-block text-xs font-bold text-green-800 bg-green-50 border border-green-100 rounded-md px-2 py-1">{row.badge}</span></td>
                <td class="px-4 py-4 text-right">
                  <a href={amazonLink(row.amazonUrl, row.name, row.id)} target="_blank" rel="sponsored nofollow noopener" class="inline-block bg-[#FF4500] hover:bg-[#E63E00] text-white text-xs font-black px-3 py-2 rounded-lg no-underline whitespace-nowrap">Check Price</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gray-900 rounded-3xl p-10 lg:p-14 text-white">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-black mb-3">Built on the Spec Sheet, Not the Marketing</h2>
          <p class="text-gray-400 max-w-xl mx-auto">The rules every guide on this site follows.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <p class="text-4xl font-black text-[#FF4500]">{NAV_GROUPS.reduce((n, g) => n + g.links.length, 0)}</p>
            <p class="text-gray-400 text-sm mt-1">In-depth guides</p>
          </div>
          <div>
            <p class="text-4xl font-black text-[#1E90FF]">100%</p>
            <p class="text-gray-400 text-sm mt-1">Of picks get a cons list</p>
          </div>
          <div>
            <p class="text-4xl font-black text-[#FF4500]">Sourced</p>
            <p class="text-gray-400 text-sm mt-1">Specs from the maker, not the listing</p>
          </div>
          <div>
            <p class="text-4xl font-black text-[#1E90FF]">$0</p>
            <p class="text-gray-400 text-sm mt-1">Paid placements accepted</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How We're Different -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold">How We're Different From Other Review Sites</h2>
        <p class="text-gray-500 mt-3 max-w-2xl mx-auto">Most "reviews" rewrite the front of the box. We start from the spec sheet on the back of it.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          ['🧮', 'We Do the Maths', 'Watts against your actual load, square feet against real coverage, cost per year of use. We size the job before we name a product.'],
          ['🔬', 'Verification Over Claims', 'EPA registrations, UL and NSF listings and Energy Star certifications are looked up in the certifier’s own database, not taken from the box.'],
          ['🙅', 'We Tell You When to Skip It', 'If a cheaper product, a repair or nothing at all is the better answer, the guide says so before it shows you anything to buy.'],
        ].map(([icon, title, body]) => (
          <div class="bg-white rounded-3xl border border-gray-200 p-8 hover:shadow-xl transition-shadow">
            <span class="text-4xl block mb-5" aria-hidden="true">{icon}</span>
            <h3 class="font-bold text-xl mb-3">{title}</h3>
            <p class="text-gray-600 leading-relaxed m-0">{body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Most-Read Guides -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
      <h2 class="text-3xl font-bold mb-10 flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#1E90FF]" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
        Most-Read Guides
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {POPULAR.map((guide) => (
          <a href={guide.url} class="block bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-xl hover:border-[#1E90FF]/30 transition-all group no-underline">
            <span class="inline-block text-[10px] font-black uppercase tracking-widest text-[#D93A00] bg-[#FF4500]/10 rounded-md px-2 py-1 mb-3">{guide.url.startsWith('/best-') ? 'Buying Guide' : 'How-To'}</span>
            <h3 class="text-lg font-black text-gray-900 group-hover:text-[#1E90FF] transition-colors mb-2">{guide.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed m-0">{guide.blurb}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
