---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Heat Pump Water Heaters",
    "url": "/best-heat-pump-water-heater/"
  },
  {
    "title": "Best Basement Dehumidifiers",
    "url": "/best-dehumidifier-for-basement/"
  },
  {
    "title": "Best Whole House Fans",
    "url": "/best-whole-house-fan/"
  },
  {
    "title": "Best Home Generator for Power Outages",
    "url": "/best-home-generator-for-power-outages/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 6 Best Gas Water Heaters: Tank Models by Household Size";
const description =
  "Six gas tank water heaters ranked by first-hour rating, venting type, efficiency, and warranty, plus sizing, install code basics, and what one really costs.";

const PRODUCTS = [
  {
    "name": "A.O. Smith Signature 100 Gas, 50 Gallon",
    "badge": "Best Overall",
    "category": "Atmospheric Vent, Natural Gas",
    "amazonUrl": "",
    "id": "ao-smith-signature-100",
    "pros": [
      "Standard atmospheric venting fits most existing installs",
      "Roughly 40,000 BTU burner gives solid recovery for a 50-gallon tank",
      "No electrical connection needed on standard versions",
      "Six-year tank and parts warranty",
      "Stocked widely, so same-day replacement is realistic"
    ],
    "cons": [
      "Standard efficiency, not a high-UEF model",
      "Shorter warranty than premium lines"
    ],
    "bottomLine": "The straightforward, widely available 50-gallon replacement that suits most families of three to four with an existing chimney or B-vent.",
    "description": "For the typical household replacing a typical gas tank, the A.O. Smith Signature 100 is the most sensible starting point. It is a 50-gallon atmospheric-vent model, which means it uses the same chimney or metal B-vent the old heater did, so installation usually does not involve new venting or an electrical outlet. The burner is in the 40,000 BTU range, giving a first-hour rating that comfortably covers a family of three to four with back-to-back showers in the morning; check the label of the exact model for its figure. It carries a six-year tank and parts warranty, which is standard for this class. Owners and plumbers generally describe it as a reliable, unremarkable appliance, which is exactly what you want from a water heater. The main argument for spending more is efficiency: it is a standard-efficiency tank, so a condensing or high-efficiency model will cost less to run over 10 to 12 years. Expect roughly $700 to $1,000 for the unit at the time of writing, with installation on top. It is easy to find, easy to install, and easy to service."
  },
  {
    "name": "Rheem Performance Platinum 50 Gal. Power Vent",
    "badge": "Best Power Vent",
    "category": "Power Vent, Natural Gas",
    "amazonUrl": "",
    "id": "rheem-performance-platinum-50",
    "pros": [
      "Power venting allows sidewall exhaust where no chimney exists",
      "Long tank and parts warranty, up to 12 years per Rheem",
      "Higher efficiency than standard atmospheric tanks",
      "Electronic controls on many versions",
      "Allows installation further from an existing chimney"
    ],
    "cons": [
      "Needs a 120V outlet, so it will not run during a power outage",
      "Blower adds some noise and another part to maintain"
    ],
    "bottomLine": "The pick when the heater has to vent through a sidewall or the old chimney is no longer usable.",
    "description": "A power-vent water heater uses a small blower to push exhaust through plastic pipe, so it can vent horizontally through a sidewall rather than up a chimney. That flexibility is the reason to buy one. If the furnace has been replaced by a high-efficiency model, the chimney may now be oversized for a water heater alone; if you are relocating the heater; or if the house never had a suitable chimney, a power-vent model solves the problem. The Rheem Performance Platinum is a strong choice in this category, with a long warranty, up to 12 years on tank and parts according to Rheem, and better efficiency than a standard atmospheric tank. The trade-offs are the usual power-vent ones. It needs a 120-volt outlet near the heater, the blower makes a steady hum when the burner runs, and it will not heat water during a power outage. It also costs considerably more than an atmospheric model. Expect roughly $1,600 to $2,200 for the unit at the time of writing, plus installation, which often includes new PVC venting."
  },
  {
    "name": "Bradford White RG240T6N 40-Gallon",
    "badge": "Best Build Quality",
    "category": "Atmospheric Vent, Pro-Installed",
    "amazonUrl": "",
    "id": "bradford-white-rg240t6n",
    "pros": [
      "Sold and supported through professional plumbers",
      "Built-in sediment-reduction design per the maker",
      "Glass-lined tank with a durable reputation among plumbers",
      "No electricity required",
      "Compact 40-gallon size for smaller homes"
    ],
    "cons": [
      "Not sold at retail, so you buy through an installer",
      "Standard warranty length for its class"
    ],
    "bottomLine": "A plumber-favored atmospheric tank for smaller households, bought through the installer rather than a store.",
    "description": "Bradford White does not sell through big-box stores; its heaters come through licensed plumbers, and that distribution model is part of why so many plumbers prefer the brand. The RG240T6N is a 40-gallon atmospheric-vent natural gas model, a good fit for one to three people or a household that does not stack showers. Bradford White builds in a sediment-reduction inlet design meant to keep minerals in suspension rather than settling on the tank bottom, which is a main cause of noise and early failure in hard-water areas. The glass-lined tank and simple controls have a reputation for durability, and parts are easy for your plumber to source. Because you buy through an installer, the price you pay reflects their markup and labor, and you have less ability to shop around for the unit itself. For many owners that is a fair trade for a pro-installed product with a clear support chain. Owners and installers commonly describe it as a heater that simply works for its full lifespan. Its six-year warranty is typical for this class."
  },
  {
    "name": "Rheem Professional Prestige Condensing 50 Gal.",
    "badge": "Best Efficiency",
    "category": "Condensing, High Efficiency",
    "amazonUrl": "",
    "id": "rheem-professional-condensing",
    "pros": [
      "Condensing design captures heat from exhaust gases",
      "Much higher efficiency than standard gas tanks",
      "Vents through PVC, often horizontally",
      "Fast recovery from a high-input burner",
      "Long warranty on the Professional line"
    ],
    "cons": [
      "Expensive to buy and install",
      "Needs power and a condensate drain"
    ],
    "bottomLine": "The best choice for high hot-water use and long ownership, where lower gas bills offset the higher upfront cost.",
    "description": "A condensing gas water heater pulls so much heat from the exhaust that water vapor in the flue gases condenses, which raises efficiency well above a standard tank. Rheem's Professional Prestige condensing model is one of the most widely installed residential options. Because the exhaust is cool, it vents through PVC pipe, often horizontally through a sidewall, and the heater needs a 120-volt outlet and a drain for the acidic condensate, which installers typically route through a neutralizer. It pairs a high-input burner with a 50-gallon tank, so recovery and first-hour delivery are strong enough for larger households. The economics depend on use. A household of four or more that runs a lot of hot water, in an area with higher gas prices, recovers the extra cost faster. A couple in a mild climate with a short ownership horizon may never break even. Expect roughly $2,500 to $3,500 for the unit at the time of writing, with installation adding more for new venting and drainage. Check for local utility rebates, which sometimes apply to condensing gas models."
  },
  {
    "name": "A.O. Smith ProLine 75-Gallon Gas",
    "badge": "Best for Large Homes",
    "category": "Large Capacity, High Input",
    "amazonUrl": "",
    "id": "ao-smith-proline-75",
    "pros": [
      "Large tank and high-input burner for big households",
      "High first-hour delivery covers simultaneous showers and soaking tubs",
      "Sold and supported through professional installers",
      "Several venting configurations available in the line",
      "Long-standing pro product line"
    ],
    "cons": [
      "Expensive and heavy; check stairs and doorways",
      "May require larger gas supply and venting than a 50-gallon unit"
    ],
    "bottomLine": "For large families, multiple bathrooms, or a big soaking tub, a 75-gallon tank with a strong burner solves the morning bottleneck.",
    "description": "Some households simply use more hot water than a 50-gallon tank can deliver, especially those with five or more people, two or three bathrooms in use at once, or a large soaking tub. A.O. Smith's ProLine series, sold through professional installers, includes 75-gallon gas models with high-input burners that push first-hour delivery well beyond a standard 50-gallon tank. That combination of stored volume and fast recovery is what prevents the last person in line from getting a cold shower. Larger residential gas tanks face stricter federal efficiency standards than 55-gallon and smaller units, so models in this size class use designs and venting that differ from small tanks; your installer will match the exact model to your gas supply and venting. That is also why installation costs can rise: a bigger burner may need a larger gas line, and the venting may change. Make sure the heater will physically fit through doorways and down basement stairs, because a 75-gallon tank is large and heavy. For very large households, it is often simpler and cheaper than adding a second heater."
  },
  {
    "name": "Rheem Performance 40 Gal. Gas",
    "badge": "Best Budget",
    "category": "Atmospheric Vent, Budget",
    "amazonUrl": "",
    "id": "rheem-performance-40",
    "pros": [
      "Low purchase price",
      "Atmospheric venting matches most older installations",
      "No electrical connection needed on standard versions",
      "Widely stocked at home centers",
      "Six-year tank and parts warranty"
    ],
    "cons": [
      "Smaller capacity suits only smaller households",
      "Basic efficiency and features"
    ],
    "bottomLine": "A no-frills replacement for one to two people, or a rental, that gets hot water back on quickly and cheaply.",
    "description": "When the budget is tight, the household is small, or the property is a rental, the Rheem Performance 40-gallon is a practical replacement. It is a standard atmospheric-vent gas heater, so it drops into the space and venting of most older installs without extra work, and standard versions need no electrical connection. The burner input is in the mid-30,000 to 40,000 BTU range depending on version, giving recovery that suits one or two people, or a small family that spaces out showers. Rheem backs it with a six-year tank and parts warranty, typical for this class, and it is stocked at most home centers, which matters on the day the old heater fails. Owners commonly describe it as reliable for the price, with the expected caveat that a 40-gallon tank runs out faster than a 50 when several people shower in a row. Do not buy it for a family of four or more just because it is cheap; you will notice the difference every morning. Expect roughly $600 to $850 for the unit at the time of writing."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Gas Water Heater",
          item: "https://www.allmetalbrake.com/best-gas-water-heater/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How big a gas water heater does a family of four need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most families of four do well with a 50-gallon gas tank with a first-hour rating in the 75 to 90 gallon range. If several people shower back to back, or there is a large soaking tub, look for a higher first-hour rating or a 75-gallon unit. Check the EnergyGuide label for the specific model's figure."
          }
        },
        {
          "@type": "Question",
          "name": "How is first-hour rating different from tank size?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tank size is how much water the heater stores. First-hour rating is how much hot water it can supply in one hour starting with a full tank, including what the burner reheats during that hour. Because burner sizes vary, two tanks of the same size can have quite different first-hour ratings, which is why it is the better sizing number."
          }
        },
        {
          "@type": "Question",
          "name": "What is the typical lifespan of a gas tank?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many gas tank water heaters last roughly 8 to 12 years. Hard water, high usage, and skipped maintenance shorten that range, while annual draining and replacing the anode rod when it is depleted can extend it. Warranties of six to twelve years give a rough sense of how long the maker expects the tank to hold up."
          }
        },
        {
          "@type": "Question",
          "name": "Will I have hot water when the power goes out?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard atmospheric models with a standing pilot and a thermocouple-powered gas valve keep heating water without electricity. Power-vent, condensing, and many electronic-ignition models need power for their blower or controls and stop heating during an outage, though the tank stays warm for a while. Check the specifications before buying if outages are common."
          }
        },
        {
          "@type": "Question",
          "name": "What causes rumbling or popping in a gas water heater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually sediment. Minerals settle on the tank bottom, trap small pockets of water that boil against the hot steel, and make rumbling or popping sounds. Draining and flushing the tank can reduce it. Persistent loud noise in an older heater often signals heavy buildup, reduced efficiency, and a tank that may be nearing the end of its life."
          }
        },
        {
          "@type": "Question",
          "name": "Is a power-vent water heater worth the extra cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is worth it when you need it, typically when there is no suitable chimney, when the furnace was upgraded and the shared chimney is no longer appropriate, or when the heater must be relocated. Otherwise, a standard atmospheric model is cheaper to buy and works without electricity. Power-vent models also add a blower that hums when running."
          }
        },
        {
          "@type": "Question",
          "name": "Can I install a gas water heater myself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is possible, but most jurisdictions require a permit, and the work involves gas piping, venting, and relief valve installation where mistakes can cause carbon monoxide exposure, gas leaks, or tank failure. Many homeowners hire a licensed plumber, and some manufacturers require professional installation for full warranty coverage. If you do it yourself, follow the manual and get the inspection."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Air, Mold & Water Heaters",
    tags: [
      "best gas water heater",
      "gas tank water heater",
      "first hour rating",
      "power vent water heater",
      "condensing water heater",
      "water heater sizing"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 6 Best <span class="text-[#38BDF8]">Gas Water Heaters</span>, Ranked
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A gas tank is still the most common water heater in America for good reason: fast recovery, a modest price, and hot showers through a power cut on many models. The right one depends on your household's morning rush and how the old one was vented.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#ao-smith-signature-100"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Shaheer Ali Khan</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Consumer Product Testing &amp; Materials Performance Specialist</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="10.2k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Sizing by First Hour</a>
          <a href="#venting" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Venting Types</a>
          <a href="#uef" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Reading UEF</a>
          <a href="#compare" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Gas vs Other Options</a>
          <a href="#install" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Install & Code</a>
          <a href="#maintenance" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Making It Last</a>
          <a href="#cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Running & Installed Cost</a>
          <a href="#outage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Power Outages</a>
          <a href="#propane" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Natural Gas or Propane</a>
          <a href="#replace" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Repair or Replace?</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">13. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most people replace a gas water heater in a hurry, with a cold shower behind them, and end up with whatever the installer has on the truck. That is usually fine, but spending ten minutes on two numbers, the first-hour rating and the venting type, avoids the two most common regrets: running out of hot water and paying for venting work nobody mentioned.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 6 Best Gas Water Heaters, Ranked
          </h2>

          <p>
            These picks are ranked on published first-hour ratings and input ratings, venting requirements, Uniform Energy Factor, warranty length, availability of parts and installers, and recurring themes in owner and plumber feedback. We have not bench-tested these units. Specifications vary by exact model number, so confirm the label figures on the version you buy.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} index={index} />
          ))}
        </div>

        <div id="sizing" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Size by First-Hour Rating, Not Tank Gallons
          </h2>

          <p>
            Tank size tells you how much hot water is stored. The first-hour rating, printed on the EnergyGuide label and in the specs, tells you how much hot water the heater can deliver in an hour starting with a full tank, counting both stored water and what the burner reheats during that hour. Because gas burners recover quickly, a 40-gallon gas tank often delivers a first-hour rating in the 60s or 70s, and a 50-gallon in the 80s or 90s, depending on burner size.
          </p>

          <p>
            To size yours, estimate your busiest hour. Most households peak in the morning, when showers, a dishwasher, and a sink are all in use. A typical shower uses roughly 10 to 20 gallons of hot water depending on length and flow rate, a dishwasher about 6, and a clothes washer on warm somewhere around 7 to 15. Add up what happens in that hour and choose a heater whose first-hour rating meets or exceeds the total.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Household</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical peak hour</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">First-hour rating to look for</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Usual tank</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">1-2 people</td>
                    <td class="px-4 py-4 text-gray-700">1-2 showers</td>
                    <td class="px-4 py-4 text-gray-700">45-60 gallons</td>
                    <td class="px-4 py-4 text-gray-700">30-40 gallon</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">3 people</td>
                    <td class="px-4 py-4 text-gray-700">2-3 showers, dishwasher</td>
                    <td class="px-4 py-4 text-gray-700">60-75 gallons</td>
                    <td class="px-4 py-4 text-gray-700">40-50 gallon</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">4 people</td>
                    <td class="px-4 py-4 text-gray-700">3 showers, sink, dishwasher</td>
                    <td class="px-4 py-4 text-gray-700">75-90 gallons</td>
                    <td class="px-4 py-4 text-gray-700">50 gallon</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">5+ people</td>
                    <td class="px-4 py-4 text-gray-700">4+ showers, tub, laundry</td>
                    <td class="px-4 py-4 text-gray-700">90+ gallons</td>
                    <td class="px-4 py-4 text-gray-700">50 gallon high input or 75 gallon</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Match the old heater only if it worked well. If you were running out of hot water, size up. If the household has shrunk, you may be able to size down and save on both purchase and standby loss. A soaking tub deserves special attention; a large tub can use most of a 40-gallon tank by itself.
          </p>

          <p>
            Check physical space too. A 50-gallon tank is usually taller or wider than a 40, and a 75 is much larger. Measure the height to the ceiling or any obstructions, the floor space, and doorways and stairs on the way in. Clearances for combustion air and service are listed in the installation manual.
          </p>
        </div>

        <div id="venting" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Atmospheric, Power Vent, Direct Vent, or Condensing
          </h2>

          <p>
            Atmospheric vent heaters rely on hot exhaust rising naturally up a chimney or metal B-vent. They need no electricity on standard models, are the least expensive, and are what most older homes have. They do require a properly sized, unobstructed vertical vent and enough combustion air in the room.
          </p>

          <p>
            Power-vent heaters add a blower that pushes exhaust through plastic pipe, so they can vent horizontally through a wall. They suit homes without a usable chimney, or where the furnace has been upgraded and the old shared chimney is no longer appropriate for the water heater alone. They need a 120-volt outlet and do not heat water without power.
          </p>

          <p>
            Direct-vent heaters draw combustion air from outdoors and exhaust outdoors through a concentric or two-pipe vent, sealing the combustion process from the living space. Many work without electricity. They are useful in tight, well-sealed homes and small utility closets where room air is limited.
          </p>

          <p>
            Condensing heaters extract so much heat that the exhaust is cool enough for PVC pipe and produces condensate that must be drained. They are the most efficient gas tanks and also the most expensive. They need power, a drain, and new venting if replacing an atmospheric unit.
          </p>

