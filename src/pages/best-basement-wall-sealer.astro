---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Flex Seal Review",
    "url": "/flex-seal-review/"
  },
  {
    "title": "How to Waterproof a Basement",
    "url": "/how-to-waterproof-a-basement/"
  },
  {
    "title": "Best Basement Waterproofing Systems",
    "url": "/best-basement-waterproofing-systems/"
  },
  {
    "title": "How to Fix a Damp Basement",
    "url": "/how-to-fix-a-damp-basement/"
  },
  {
    "title": "Best Cinder Block Sealers",
    "url": "/best-cinder-block-sealer-reviews/"
  },
  {
    "title": "Best Paint for Cinder Block",
    "url": "/best-paint-for-cinder-block/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "7 Best Basement Wall Sealers (2026): Matched to Your Leak Type";
const description =
  "DRYLOK Extreme is the best basement wall sealer for most damp block or concrete walls; 7 picks sorted by damp walls, seeping cracks and real water pressure.";

const PRODUCTS = [
  {
    "id": "drylok-extreme",
    "name": "DRYLOK Extreme Masonry Waterproofer",
    "category": "Acrylic-Cement Waterproofing Coating",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "Label rating of 15 psi hydrostatic pressure, the highest in the DRYLOK line",
      "Fills pores in block and poured concrete when brushed in",
      "Contains a mildewcide in the dried film",
      "Water cleanup and low odor compared with solvent coatings",
      "Can be tinted to light colors at many stores"
    ],
    "cons": [
      "Requires bare, clean masonry; will not perform as rated over paint",
      "First coat coverage is low on rough block",
      "Hard work to brush in properly"
    ],
    "bottomLine": "The first pick for a damp or seeping interior block or concrete wall that has been scrubbed back to bare masonry.",
    "description": "Start here unless your wall gives you a reason not to. DRYLOK Extreme is a heavy, latex-based masonry waterproofer, and its maker rates it to resist 15 psi of hydrostatic pressure, more than a typical below-grade wall is exposed to. That number depends on the coating actually entering the masonry, which is why the label tells you to scrub the first coat in with a nylon brush until no pinholes remain. Owners who do that commonly report walls that stay dry through wet seasons, while those who roll on a thin coat often report pinhole leaks. It is suitable for poured concrete and concrete block, indoors or out, above or below grade, provided the surface is bare. First-coat coverage is modest, roughly 75 to 100 square feet per gallon on smooth surfaces and less on textured block, so buy extra. At the time of writing a gallon costs roughly $40 to $60, and five-gallon pails are the better value."
  },
  {
    "id": "radonseal-penetrating-sealer",
    "name": "RadonSeal Plus Penetrating Concrete Sealer",
    "category": "Reactive Silicate Penetrant",
    "badge": "Best Penetrating",
    "amazonUrl": "",
    "pros": [
      "No surface film, so nothing to peel or blister",
      "Leaves the look of the concrete unchanged",
      "Reacts inside the pores to reduce water and vapor movement",
      "Single product treats both walls and slabs"
    ],
    "cons": [
      "Needs unpainted, unsealed concrete to soak into",
      "No hydrostatic pressure rating like film coatings",
      "Results are slow to judge since nothing visible changes"
    ],
    "bottomLine": "The pick for bare poured concrete walls and floors when you want less seepage without adding a coating.",
    "description": "RadonSeal Plus works the opposite way to a masonry paint. This water-based, silicate-type sealer soaks into poured concrete, where it reacts with the free lime to form a gel that plugs capillaries beneath the surface; the maker claims it penetrates several inches into dense concrete. With nothing on top of the wall, there is no film for water pressure or efflorescence to push off, and the concrete looks unchanged afterward, a plus if you like the plain finish or will leave the walls exposed. The catch is that it needs bare concrete that can absorb it. Painted, sealed or heavily contaminated surfaces have to be stripped first, and it is less effective on hollow block than on solid poured walls. Because it carries no psi rating, think of it as a way to reduce dampness and seepage, not as a dam. A gallon kit runs roughly $80 to $130 at the time of writing, and coverage varies with how porous the concrete is."
  },
  {
    "id": "drylok-original",
    "name": "DRYLOK Original Masonry Waterproofer",
    "category": "Acrylic-Cement Waterproofing Coating",
    "badge": "Best Budget",
    "amazonUrl": "",
    "pros": [
      "Labeled for 10 psi hydrostatic pressure",
      "Usually cheaper per gallon than DRYLOK Extreme",
      "Widely available in white and tintable bases",
      "Same proven application method as Extreme"
    ],
    "cons": [
      "Lower pressure rating than the Extreme version",
      "Same need for bare, clean masonry and careful brushing",
      "Strong scrubbing on the first coat is unavoidable"
    ],
    "bottomLine": "A cheaper, dependable option for damp walls that see no serious water pressure.",
    "description": "DRYLOK Original is the older formula in the same family, and plenty of basements need nothing more. Its label lists a 10 psi hydrostatic pressure rating: below the Extreme version, yet still comfortably above what most residential walls with sensible drainage experience. Application is identical. Stir it thoroughly, brush the first coat hard into bare masonry and add a second coat once the first is dry. What separates the two in practice is margin. For a wall that is merely damp, sweats in summer or shows a dark band near the floor after storms, Original does the job for less money. For seepage lines or wet patches that spread, the higher rating of Extreme is the safer purchase. They share one weakness: each is only as good as the surface underneath, so paint, efflorescence or mold left on the wall will shorten its life. At the time of writing, Original is often a few dollars per gallon cheaper than Extreme."
  },
  {
    "id": "liquid-rubber-foundation",
    "name": "Liquid Rubber Foundation & Basement Sealant",
    "category": "Elastomeric Foundation Membrane",
    "badge": "Best for Exterior Walls",
    "amazonUrl": "",
    "pros": [
      "Flexible membrane bridges hairline cracks",
      "Water-based and low odor for indoor use",
      "Works on exterior foundations during excavation",
      "Can be brushed, rolled or sprayed"
    ],
    "cons": [
      "Thick coats mean low coverage per gallon",
      "Interior use on pressurized walls can bubble",
      "Expensive for large areas"
    ],
    "bottomLine": "Our pick for a positive-side exterior coat, or for crack-prone walls that are damp rather than wet.",
    "description": "Liquid Rubber Foundation and Basement Sealant cures to a thick, stretchy membrane, which gives it something rigid film coatings lack: it moves with the wall. Freeze-thaw cycles open and close hairline cracks, and that movement can tear a stiff masonry paint, whereas an elastomeric coat built to the recommended thickness rides over it. That makes it a strong option for the outside of a foundation while the soil is dug back, since water pressure on that side pushes the membrane into the wall rather than off it. Indoors it handles dampness and condensation-prone block well, though owners occasionally report bubbling where water pushes from behind, the usual limit of any rubber film on the negative side. It is water-based, low in odor and cleans up with water while wet. Thick coats mean lower coverage than paint, so price the whole job: at roughly $100 to $150 per gallon at the time of writing, a full basement gets expensive fast."
  },
  {
    "id": "ames-block-wall",
    "name": "Ames Block & Wall Liquid Rubber",
    "category": "Flexible Block Coating",
    "badge": "Best for Block Cracks",
    "amazonUrl": "",
    "pros": [
      "Elastomeric film tolerates small crack movement",
      "Formulated specifically for masonry and block",
      "Water-based with soap-and-water cleanup",
      "Can be topcoated with paint once cured"
    ],
    "cons": [
      "Not intended to resist strong hydrostatic pressure from inside",
      "Needs multiple coats for full membrane thickness",
      "Harder to find in local stores"
    ],
    "bottomLine": "A sensible flexible coating for block walls with hairline cracks and seasonal dampness.",
    "description": "Ames Block and Wall is a water-based elastomeric coating made for concrete block and other masonry. As with other liquid rubbers, flexibility is the main draw: the cured film stretches over hairline and shrinkage cracks instead of splitting along them, which helps on older block foundations whose mortar joints have opened a little. Ames typically recommends several coats to build film thickness, and you can paint over it once it has cured if you want a particular color. It is a weaker fit for an interior wall with water actively pushing through, because a flexible film on the negative side can lift and blister under sustained pressure; a cement-based waterproofer is the safer choice there. Where it excels is exterior block, garage walls, retaining walls and basements dealing with mild seepage and cracking rather than water. Prep matches any other coating: clean, sound, dry and free of efflorescence. Expect roughly $70 to $110 a gallon at the time of writing."
  },
  {
    "id": "xypex-concentrate",
    "name": "Xypex Concentrate Crystalline Waterproofing",
    "category": "Cement-Based Crystalline Slurry",
    "badge": "Best for Poured Concrete",
    "amazonUrl": "",
    "pros": [
      "Crystals form inside the concrete and self-seal hairline cracks when wet",
      "Works against water from either side of the wall",
      "Becomes part of the concrete rather than a film on it",
      "Long track record on tanks and below-grade structures"
    ],
    "cons": [
      "Must be mixed and applied to a saturated, properly prepared surface",
      "Gray cement finish, not decorative",
      "Best results from trained applicators"
    ],
    "bottomLine": "A pro-grade choice for poured concrete walls when you want a permanent treatment rather than a film.",
    "description": "Xypex Concentrate is the professional choice on this list. It arrives as a dry powder of cement, fine sand and proprietary chemicals that you mix into a slurry and brush onto concrete that has been prepared and soaked with water. Its active chemicals migrate into the concrete and react with moisture to grow insoluble crystals in pores and hairline cracks, and the company says those crystals can reactivate when fresh water appears. Since it becomes part of the concrete instead of sitting on it, it suits negative-side use, which explains why it is common in elevator pits and water tanks. It is also unforgiving. The concrete has to be open-textured and saturated, the slurry has to be mixed and applied at the specified rate, and the coating has to stay moist while it cures. It is designed for poured concrete, not hollow block. If you can follow a technical data sheet to the letter, it can be excellent; if not, hire an approved applicator."
  },
  {
    "id": "flex-seal-liquid",
    "name": "Flex Seal Liquid Rubber Sealant",
    "category": "Spot-Repair Rubber Coating",
    "badge": "Best for Spot Repairs",
    "amazonUrl": "",
    "pros": [
      "Easy to buy almost anywhere",
      "Thick rubber coating for small patches and penetrations",
      "Bonds to many materials besides masonry",
      "Useful for pipe penetrations and window wells"
    ],
    "cons": [
      "Poor value for coating whole walls",
      "Not formulated as a masonry waterproofer with a pressure rating",
      "Solvent odor indoors"
    ],
    "bottomLine": "Keep a can for small exterior patches and penetrations, and buy a masonry product for the walls themselves.",
    "description": "Flex Seal Liquid earns a spot because so many people reach for it, and it does have a role in a basement. It is a thick rubber coating that brushes onto nearly any material and cures to a flexible, watertight skin. That is handy around pipe penetrations, window well seams, the outside face of a cracked foundation where it meets the soil, and small spots where several materials need a quick seal. As a whole-wall basement sealer it is the weakest option here. It is not made to fill block pores the way a masonry waterproofer does, it has no hydrostatic pressure rating for negative-side use, and its cost per square foot is high next to DRYLOK. The solvent-based formula also smells strong indoors, so ventilation matters. Owner feedback tends to be positive for patches and disappointed for full walls, which fits what the product is designed to do. Use it for spot repairs and leave whole walls to a dedicated masonry product."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Basement Wall Sealers",
          item: "https://www.allmetalbrake.com/best-basement-wall-sealer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which sealer works best on a basement wall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On a bare block or concrete wall that seeps or stays damp, a cement-and-latex masonry waterproofer such as DRYLOK Extreme is the most reliable option, since it fills pores and carries a published hydrostatic pressure rating. On unpainted poured concrete that you want to look untouched, a penetrating sealer like RadonSeal Plus suits better. Where water actually runs, neither one replaces drainage."
          }
        },
        {
          "@type": "Question",
          "name": "Will an interior sealer hold back outside water?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Up to a point. An interior sealer resists water that has already reached the wall, so it handles dampness and slow seepage best, and that is how most homeowners use one. Heavy, sustained pressure is harder, because the water pushes the coating away from the masonry. Fix the gutters and grading outside first and any interior sealer stands a far better chance of lasting."
          }
        },
        {
          "@type": "Question",
          "name": "Is one coat of sealer enough on a basement wall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not for a masonry waterproofer: most walls need two coats with the first brushed in, and rough or split-face block may need a third pass over stubborn pinholes. Penetrating sealers typically need one saturating coat, sometimes with a second wet-on-wet application on very porous block. Follow the label for your product, because recoat windows change with product and temperature."
          }
        },
        {
          "@type": "Question",
          "name": "Why pick DRYLOK over Flex Seal for a whole wall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because DRYLOK is built for that job. It is formulated to bond into masonry pores and carries a pressure rating, whereas Flex Seal Liquid is a general-purpose rubber coating better suited to small patches, flashing and exterior spots. Flex Seal can handle a damp-proofing touch-up, but coating an entire foundation wall with it is poor value."
          }
        },
        {
          "@type": "Question",
          "name": "Does a basement wall sealer stop mold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only indirectly. By cutting the moisture that wicks through the wall, a sealer removes one source of the dampness mold depends on, and some masonry waterproofers carry a mildewcide in the film. It does nothing about mold that grows where humid air condenses on surfaces. To control mold, hold relative humidity below 60 percent, ideally between 30 and 50 percent."
          }
        },
        {
          "@type": "Question",
          "name": "How long does basement waterproofing paint last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Typically five to ten years on an interior wall before it needs touch-ups, and sometimes much longer, provided the wall was well prepared and the coating properly applied. How much water reaches the wall matters most. Early failures usually trace back to efflorescence left underneath, a first coat rolled on thin, or gutters and grading that still send water toward the foundation."
          }
        },
        {
          "@type": "Question",
          "name": "Can I paint over a basement wall sealer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Over a masonry waterproofer, usually yes: use a latex paint once the coating has cured, though many owners skip that step because waterproofers come tinted. Over a penetrating sealer, often no, since silane-siloxane repellents in particular can stop paint from bonding. If paint is part of the plan, pick the sealer with that in mind and confirm compatibility on the data sheet."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Basement & Waterproofing",
    tags: [
      "best basement wall sealer",
      "masonry waterproofer",
      "basement waterproofing paint",
      "penetrating concrete sealer",
      "foundation sealant",
      "drylok"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The 7 Best Basement Wall Sealers in 2026
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          DRYLOK Extreme is the best basement wall sealer for most damp or seeping block and concrete walls, with a 15 psi label rating when it is brushed onto bare masonry. The wall material, any old paint and whether water dampens, seeps or runs can change that pick. This guide covers seven sealers, leak diagnosis, pressure ratings, coverage, prep, application, cost and when to skip sealing.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          Based on manufacturer labels and data sheets for pressure rating, coverage and cure times, plus owner feedback. Not hands-on tested. No paid placements. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">14 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>Which Sealer to Buy</span></a>
              <a href="#short-answer" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>The Short Answer</span></a>
              <a href="#diagnose" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Condensation or Seepage?</span></a>
              <a href="#chemistry" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Types of Wall Sealer</span></a>
              <a href="#pressure" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>What Pressure Ratings Mean</span></a>
              <a href="#coverage" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>How Much You Need</span></a>
              <a href="#prep" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>How to Prep the Wall</span></a>
              <a href="#application" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>How to Apply It</span></a>
              <a href="#inside-outside" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>Inside or Outside?</span></a>
              <a href="#cost" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>What It Costs</span></a>
              <a href="#brands" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>Brands Compared</span></a>
              <a href="#skip-it" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">12.</span><span>When to Skip the Sealer</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">13.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">14.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Sealers for basement walls sit side by side on the shelf as if they were interchangeable, and that is where most bad purchases begin. A coating that dries out a sweating block wall can blister away from one with water pressing behind it, and a penetrating sealer that hardens a slab does nothing about a crack that leaks every spring. Choose by the kind of water on your wall, not by which aisle the can happens to sit in.
        </p>

        <QuickPicks products={PRODUCTS} />

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Best Basement Wall Sealers in 2026, Ranked
          </h2>

          <p>
