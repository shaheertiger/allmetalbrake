---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "How to Waterproof a Basement",
    "url": "/how-to-waterproof-a-basement/"
  },
  {
    "title": "Best Basement Waterproofing Systems",
    "url": "/best-basement-waterproofing-systems/"
  },
  {
    "title": "How to Fix a Damp Basement",
    "url": "/how-to-fix-a-damp-basement/"
  },
  {
    "title": "Best Cinder Block Sealers",
    "url": "/best-cinder-block-sealer-reviews/"
  },
  {
    "title": "Best Paint for Cinder Block",
    "url": "/best-paint-for-cinder-block/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 7 Best Basement Wall Sealers: Matched to Your Leak Type";
const description =
  "Seven basement wall sealers sorted by the problem they solve: damp block, seeping cracks, or real water pressure. Coverage, prep and limits included.";

const PRODUCTS = [
  {
    "id": "drylok-extreme",
    "name": "DRYLOK Extreme Masonry Waterproofer",
    "category": "Acrylic-Cement Waterproofing Coating",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "Label rating of 15 psi hydrostatic pressure, the highest in the DRYLOK line",
      "Fills pores in block and poured concrete when brushed in",
      "Contains a mildewcide in the dried film",
      "Water cleanup and low odor compared with solvent coatings",
      "Can be tinted to light colors at many stores"
    ],
    "cons": [
      "Requires bare, clean masonry; will not perform as rated over paint",
      "First coat coverage is low on rough block",
      "Hard work to brush in properly"
    ],
    "bottomLine": "The default choice for a seeping or damp interior block or concrete wall that has been cleaned to bare masonry.",
    "description": "DRYLOK Extreme is the product most basements should start with. It is a thick, latex-based masonry waterproofer that the manufacturer rates to withstand 15 psi of hydrostatic pressure, which is more than the pressure a typical below-grade wall sees. The rating only means something if the coating gets into the masonry, so the label directs you to scrub the first coat in with a nylon brush until every pinhole disappears. Owners who follow that instruction commonly report dry walls through wet seasons; owners who roll it on thin often report pinhole leaks. It works on poured concrete and concrete block, inside or outside, above or below grade, as long as the surface is bare. Coverage on the first coat is low, roughly 75 to 100 square feet per gallon on smooth surfaces and less on textured block, so buy more than you think you need. Expect to pay roughly $40 to $60 a gallon at the time of writing, with five-gallon pails offering the best value."
  },
  {
    "id": "radonseal-penetrating-sealer",
    "name": "RadonSeal Plus Penetrating Concrete Sealer",
    "category": "Reactive Silicate Penetrant",
    "badge": "Best Penetrating",
    "amazonUrl": "",
    "pros": [
      "No surface film, so nothing to peel or blister",
      "Leaves the look of the concrete unchanged",
      "Reacts inside the pores to reduce water and vapor movement",
      "Single product treats both walls and slabs"
    ],
    "cons": [
      "Needs unpainted, unsealed concrete to soak into",
      "No hydrostatic pressure rating like film coatings",
      "Results are slow to judge since nothing visible changes"
    ],
    "bottomLine": "Best for bare poured concrete walls and floors where you want reduced seepage without a coating.",
    "description": "RadonSeal Plus takes the opposite approach to a masonry paint. It is a water-based, silicate-type sealer that soaks into poured concrete and reacts with the free lime inside to form a gel that fills capillaries below the surface. The maker claims penetration of several inches into dense concrete. Because nothing sits on top of the wall, there is no film for water pressure or efflorescence to push off, and the wall looks the same afterward, which matters if you like the plain concrete finish or plan to leave walls exposed. The tradeoff is that it only works on bare concrete that can absorb it: painted, sealed or heavily contaminated surfaces must be stripped first, and it is less effective on hollow block than on solid poured walls. It does not carry a psi rating, so treat it as a dampness and seepage reducer, not a dam. Prices run roughly $80 to $130 for a gallon kit at the time of writing; coverage depends on how porous the concrete is."
  },
  {
    "id": "drylok-original",
    "name": "DRYLOK Original Masonry Waterproofer",
    "category": "Acrylic-Cement Waterproofing Coating",
    "badge": "Best Budget",
    "amazonUrl": "",
    "pros": [
      "Labeled for 10 psi hydrostatic pressure",
      "Usually cheaper per gallon than DRYLOK Extreme",
      "Widely available in white and tintable bases",
      "Same proven application method as Extreme"
    ],
    "cons": [
      "Lower pressure rating than the Extreme version",
      "Same need for bare, clean masonry and careful brushing",
      "Strong scrubbing on the first coat is unavoidable"
    ],
    "bottomLine": "A solid, cheaper choice for damp walls that do not see serious water pressure.",
    "description": "DRYLOK Original is the older formula in the same family, and for many basements it is all you need. The label lists a 10 psi hydrostatic pressure rating, lower than the Extreme version but still comfortably above the pressure on most residential walls with sensible drainage. It is applied the same way: stir thoroughly, brush the first coat hard into bare masonry, then follow with a second coat once the first has dried. The difference in practice is margin. If your wall is merely damp, sweats in summer, or shows a dark band near the floor after storms, Original does the job for less money. If you see seepage lines or wet spots that spread, the extra rating of Extreme is the safer buy. Both share the same weakness: they are only as good as the surface beneath them, so any paint, efflorescence or mold left on the wall will shorten their life. At the time of writing, Original often runs a few dollars per gallon cheaper than Extreme."
  },
  {
    "id": "liquid-rubber-foundation",
    "name": "Liquid Rubber Foundation & Basement Sealant",
    "category": "Elastomeric Foundation Membrane",
    "badge": "Best for Exterior Walls",
    "amazonUrl": "",
    "pros": [
      "Flexible membrane bridges hairline cracks",
      "Water-based and low odor for indoor use",
      "Works on exterior foundations during excavation",
      "Can be brushed, rolled or sprayed"
    ],
    "cons": [
      "Thick coats mean low coverage per gallon",
      "Interior use on pressurized walls can bubble",
      "Expensive for large areas"
    ],
    "bottomLine": "The best pick for a positive-side exterior coating or for crack-prone walls that are damp rather than wet.",
    "description": "Liquid Rubber Foundation and Basement Sealant cures into a thick, stretchy membrane, which gives it an advantage film coatings lack: it moves with the wall. Hairline cracks that open and close through freeze-thaw cycles can tear a rigid masonry paint; an elastomeric coat built to the recommended thickness rides over them. That makes it a strong choice for the outside of a foundation when you have the soil dug back, where water pressure pushes the membrane into the wall instead of away from it. On interior walls it does well on dampness and condensation-prone block, but owners occasionally report bubbling where water pushes from behind, which is the general limitation of any rubber film on the negative side. It is water-based with low odor and cleans up with water while wet. Coverage is lower than paint because it is applied in thick coats, so price out the full job: at roughly $100 to $150 per gallon at the time of writing, a whole basement adds up quickly."
  },
  {
    "id": "ames-block-wall",
    "name": "Ames Block & Wall Liquid Rubber",
    "category": "Flexible Block Coating",
    "badge": "Best for Block Cracks",
    "amazonUrl": "",
    "pros": [
      "Elastomeric film tolerates small crack movement",
      "Formulated specifically for masonry and block",
      "Water-based with soap-and-water cleanup",
      "Can be topcoated with paint once cured"
    ],
    "cons": [
      "Not intended to resist strong hydrostatic pressure from inside",
      "Needs multiple coats for full membrane thickness",
      "Harder to find in local stores"
    ],
    "bottomLine": "A good flexible option for block walls with hairline cracking and seasonal dampness.",
    "description": "Ames Block and Wall is a water-based elastomeric coating aimed at concrete block and other masonry. Like other liquid rubber products, its main advantage is flexibility: the cured film stretches across hairline and shrinkage cracks rather than splitting along them, which is useful on older block foundations where mortar joints have opened slightly. Ames typically recommends applying it in multiple coats to build film thickness, and it can be painted over once cured if you want a specific color. Where it is less suited is an interior wall with water actively pushing through; a flexible film on the negative side can lift and blister under sustained pressure, so in that case a cement-based waterproofer is the safer bet. It shines on exterior block, garage walls, retaining walls and basements where the problem is mild seepage and cracking rather than water. Prep is the same as for any coating: clean, sound, dry and free of efflorescence. Expect roughly $70 to $110 a gallon at the time of writing."
  },
  {
    "id": "xypex-concentrate",
    "name": "Xypex Concentrate Crystalline Waterproofing",
    "category": "Cement-Based Crystalline Slurry",
    "badge": "Best for Poured Concrete",
    "amazonUrl": "",
    "pros": [
      "Crystals form inside the concrete and self-seal hairline cracks when wet",
      "Works against water from either side of the wall",
      "Becomes part of the concrete rather than a film on it",
      "Long track record on tanks and below-grade structures"
    ],
    "cons": [
      "Must be mixed and applied to a saturated, properly prepared surface",
      "Gray cement finish, not decorative",
      "Best results from trained applicators"
    ],
    "bottomLine": "A professional-grade option for poured concrete walls where you want a permanent, non-film treatment.",
    "description": "Xypex Concentrate is the professional option on this list. It is a dry powder of cement, fine sand and proprietary chemicals mixed into a slurry and brushed onto concrete that has been prepared and soaked with water. The active chemicals migrate into the concrete and react with moisture to grow insoluble crystals in pores and hairline cracks, and the company states those crystals can reactivate when new water appears. Because it becomes part of the concrete rather than sitting on it, it is suited to negative-side use, which is why it is common in elevator pits and water tanks. The catch is that it is unforgiving. The concrete must be open-textured and saturated, the slurry must be mixed and applied at the specified rate, and the coating must be kept moist while it cures. It is also designed for poured concrete, not hollow block. If you are comfortable following a technical data sheet exactly, it can be excellent; if not, hire an approved applicator."
  },
  {
    "id": "flex-seal-liquid",
    "name": "Flex Seal Liquid Rubber Sealant",
    "category": "Spot-Repair Rubber Coating",
    "badge": "Best for Spot Repairs",
    "amazonUrl": "",
    "pros": [
      "Easy to buy almost anywhere",
      "Thick rubber coating for small patches and penetrations",
      "Bonds to many materials besides masonry",
      "Useful for pipe penetrations and window wells"
    ],
    "cons": [
      "Poor value for coating whole walls",
      "Not formulated as a masonry waterproofer with a pressure rating",
      "Solvent odor indoors"
    ],
    "bottomLine": "Keep a can for small exterior patches and penetrations; buy a masonry product for the walls.",
    "description": "Flex Seal Liquid is on this list because people reach for it, and it does have a place in a basement. It is a thick rubber coating that brushes onto almost anything and cures to a flexible, watertight skin. That makes it handy around pipe penetrations, window well seams, the outside face of a cracked foundation where it meets the soil, and small spots where you need a quick seal on a mix of materials. As a whole-wall basement sealer it is the weakest choice here. It is not built to fill block pores the way a masonry waterproofer is, it carries no hydrostatic pressure rating for negative-side use, and the cost per square foot is high compared with DRYLOK. The solvent-based formula also has a strong smell indoors, so ventilation matters. Owner feedback is generally positive for patches and generally disappointed for full walls, which matches what the product is designed to do. Buy it for spot repairs and leave the wall coating to a dedicated masonry product."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Basement Wall Sealers",
          item: "https://www.allmetalbrake.com/best-basement-wall-sealer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which sealer works best on a basement wall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a bare block or concrete wall that seeps or stays damp, a cement-and-latex masonry waterproofer such as DRYLOK Extreme is the most dependable choice, because it carries a published hydrostatic pressure rating and fills pores. For unpainted poured concrete where you want no visible film, a penetrating sealer like RadonSeal Plus is the better pick. Neither replaces drainage when water actually runs."
          }
        },
        {
          "@type": "Question",
          "name": "Will an interior sealer hold back outside water?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, and most homeowners do. Interior sealers work against water that has already reached the wall, so they suit dampness and slow seepage best. They are less reliable against heavy, sustained pressure, because the water is pushing the coating away from the masonry. Fixing gutters and grading outside first makes any interior sealer much more likely to last."
          }
        },
        {
          "@type": "Question",
          "name": "Is one coat of sealer enough on a basement wall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Masonry waterproofers call for two coats on most walls, with the first worked in by brush. Rough or split-face block may need a third pass on stubborn pinholes. Penetrating sealers usually take one saturating coat, sometimes a second wet-on-wet application on very porous block. Always follow the specific label, since recoat windows vary by product and temperature."
          }
        },
        {
          "@type": "Question",
          "name": "Why pick DRYLOK over Flex Seal for a whole wall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For an interior basement wall, DRYLOK is the better tool. It is formulated to bond into masonry pores and carries a pressure rating, while Flex Seal Liquid is a general-purpose rubber coating better suited to small patches, flashing and exterior spots. Flex Seal can work on a damp-proofing touch-up, but it is a poor value for coating an entire foundation wall."
          }
        },
        {
          "@type": "Question",
          "name": "Does a basement wall sealer stop mold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can help indirectly. A sealer that reduces moisture wicking through the wall takes away one source of the dampness mold needs, and some masonry waterproofers include a mildewcide in the film. It will not stop mold caused by humid air condensing on surfaces. Keep relative humidity below 60 percent, ideally 30 to 50 percent, to control mold."
          }
        },
        {
          "@type": "Question",
          "name": "How long does basement waterproofing paint last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A well-prepared, properly applied masonry waterproofer typically lasts five to ten years on an interior wall before it needs touch-ups, and sometimes much longer. The biggest factor is how much water reaches the wall. Coatings fail early when efflorescence was left underneath, when the first coat was rolled thin, or when gutters and grading still send water against the foundation."
          }
        },
        {
          "@type": "Question",
          "name": "Can I paint over a basement wall sealer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Over a masonry waterproofer, usually yes, with a latex paint once the coating has cured, though many owners skip it because waterproofers come tinted. Over a penetrating sealer, often no: silane-siloxane repellents in particular can prevent paint from bonding. If you plan to paint, choose your sealer with that in mind and check the data sheet for compatibility."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Basement & Waterproofing",
    tags: [
      "best basement wall sealer",
      "masonry waterproofer",
      "basement waterproofing paint",
      "penetrating concrete sealer",
      "foundation sealant",
      "drylok"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Basement Wall Sealers</span>, Matched to the Leak
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A damp wall, a weeping crack and water pushing through under pressure need three different products. Here is which one to buy for each, and when to skip the sealer entirely.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#drylok-extreme"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The 7 Picks</a>
          <a href="#diagnose" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Which Wet Wall You Have</a>
          <a href="#chemistry" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Four Sealer Chemistries</a>
          <a href="#pressure" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Pressure Ratings, Explained</a>
          <a href="#coverage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. How Much You Need</a>
          <a href="#prep" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Prep That Decides It</a>
          <a href="#application" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. How to Apply It</a>
          <a href="#inside-outside" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Interior vs. Exterior</a>
          <a href="#cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. What It Costs</a>
          <a href="#brands" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Brands Compared</a>
          <a href="#skip-it" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. When to Skip the Sealer</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">13. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most basement wall sealers are sold as if they all do the same job. They do not. A coating that stops a damp, sweating block wall can blister off a wall with water pushing behind it, and a penetrating sealer that hardens a slab will do nothing for a crack that runs every spring. Pick the product by the kind of water you have, not by the shelf it sits on.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Best Basement Wall Sealers, Ranked
          </h2>

          <p>
            These rankings weigh what each manufacturer publishes on its label and data sheet (hydrostatic pressure rating, coverage, cure and recoat times, surface requirements), how the chemistry suits poured concrete versus block, and recurring patterns in owner feedback. No product here was lab-tested by us; where a claim comes from the maker, we say so.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
