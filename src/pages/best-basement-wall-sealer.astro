                    <td class="px-4 py-4 text-gray-700">$3,000-$7,000</td>
                    <td class="px-4 py-4 text-gray-700">Same as DIY, done for you</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Interior drain + sump</td>
                    <td class="px-4 py-4 text-gray-700">$5,000-$15,000</td>
                    <td class="px-4 py-4 text-gray-700">Water at the cove joint, high water table</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Exterior membrane</td>
                    <td class="px-4 py-4 text-gray-700">$15,000-$30,000+</td>
                    <td class="px-4 py-4 text-gray-700">Saturated soil, structural repairs</td>
