---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/caulk-vs-sealant.html?raw';

const title = "Caulk vs Sealant: What's the Difference and Which to Use?";
const description = "Caulk and sealant overlap on the shelf. The real difference is movement: ASTM C920 classes, paintability, and what to use on windows, siding, concrete and tubs.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
