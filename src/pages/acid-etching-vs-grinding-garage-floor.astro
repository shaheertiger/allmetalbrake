---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/acid-etching-vs-grinding-garage-floor.html?raw';

const title = "Acid Etching vs Grinding a Garage Floor: Which to Use?";
const description = "Grinding beats acid etching on most garage floors. See when etching works, why it fails on sealed or oily slabs, CSP profile, costs, dust and safety.";
