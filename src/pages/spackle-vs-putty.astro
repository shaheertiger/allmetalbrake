---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/spackle-vs-putty.html?raw';

const title = "Spackle vs. Joint Compound vs. Painter's Putty — Which to Use | Home Fix Reviews";
const description = "Spackle, joint compound and painter's putty sit side by side in the paint aisle and are used interchangeably by almost everyone. What each is formulated for, dry times for every product and condition, and how to patch a hole so the repair never shows.";
