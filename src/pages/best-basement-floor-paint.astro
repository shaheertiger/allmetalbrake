---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/best-basement-floor-paint.html?raw';

const title = "6 Best Basement Floor Paints of 2026: Compared & Ranked";
const description = "Basement slabs push moisture up through paint. Run the plastic-sheet test, then pick breathable latex, 1-part epoxy-acrylic or 2-part epoxy for your floor.";
