const title = "The 7 Best Ceiling Paints: Flat, Low-Spatter Picks by Room";
const description =
  "Seven ceiling paints ranked by room and ceiling type, plus the sheen, primer, roller and technique choices that prevent flashing, lap marks and stains.";

const PRODUCTS = [
