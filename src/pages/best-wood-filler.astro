                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Outdoors</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Latex or acrylic</td>
                    <td class="px-4 py-4 text-gray-700">Slight</td>
                    <td class="px-4 py-4 text-gray-700">Low</td>
