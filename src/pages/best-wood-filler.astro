---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Exterior Caulk",
    "url": "/best-exterior-caulk/"
  },
  {
    "title": "Caulking Exterior Windows, Step by Step",
    "url": "/how-to-caulk-exterior-windows/"
  },
  {
    "title": "How Long Does Caulk Take to Dry",
    "url": "/how-long-does-caulk-take-to-dry/"
  },
  {
    "title": "Best Gutter Guards",
    "url": "/best-gutter-guards/"
  },
  {
    "title": "Best Deck Stain",
    "url": "/best-deck-stain-reviews/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "8 Best Wood Fillers (2026): The Right Filler for Each Hole";
const description =
  "DAP Plastic Wood-X tops 8 wood fillers for small holes; anything deeper than 1/4 inch, outdoors or rotted needs a two-part epoxy or polyester filler instead.";

const PRODUCTS = [
  {
    "id": "dap-plastic-wood-x-7079800540",
    "badge": "Best Overall",
    "category": "Latex, Interior and Exterior",
    "name": "DAP Plastic Wood-X Wood Filler with DryDex",
    "amazonUrl": "",
    "description": "Plastic Wood-X takes first place because it handles the most common job, filling small and medium holes in trim, doors and furniture, with almost no fuss. It goes on pink and shifts to a natural wood tone as it dries, a DryDex feature that removes the guesswork about when to sand. The knife-grade paste spreads smoothly, stays put on vertical surfaces and sands to a crisp, fine edge without gumming up the paper. DAP rates it for interior and exterior use, lists it as paintable and stainable, and it cleans up with water. Under paint it is about as foolproof as filler gets. Like any one-part latex filler, it is not structural and is not meant for very deep voids in a single pass; build anything deeper than a quarter inch in layers, and move to a two-part product for rot or broken edges. Owners commonly report that it holds up well on exterior trim once primed and painted.",
    "pros": [
      "Color change shows when it is ready to sand",
      "Smooth, non-sag texture",
      "Sands cleanly without clogging paper",
      "Interior and exterior rated",
      "Water cleanup"
    ],
    "cons": [
      "Fill deep holes in layers",
      "Not for structural or rotted wood repairs"
    ],
    "bottomLine": "The default tub for nail holes, dings and trim repairs that will be painted."
  },
  {
    "id": "minwax-stainable-wood-filler-42853",
    "badge": "Best for Stained Projects",
    "category": "Stainable, Interior and Exterior",
    "name": "Minwax Stainable Wood Filler",
    "amazonUrl": "",
    "description": "Plenty of fillers claim to be stainable, but few take stain anywhere close to the wood around them. Minwax designed this one specifically to accept oil-based and water-based stain more the way real wood fibers do, and owners commonly report that it blends better than typical latex fillers on stained furniture, cabinets and floors. It comes in several wood tones so you can start near your final color, which matters more than the stain itself. Plan to experiment: put a test patch on scrap, stain it next to the surrounding wood, and adjust before committing. Minwax lists it for indoor and outdoor work; it sands well and holds an edge on small breaks and gouges. It is the wrong product for large voids or rotted wood, and like any stainable filler it will still look slightly different from the grain up close. Among widely sold options, it is the best starting point for a near-invisible stained repair.",
    "pros": [
      "Formulated to accept stain more evenly than typical fillers",
      "Several wood-tone colors",
      "Interior and exterior rated",
      "Sands to a smooth edge"
    ],
    "cons": [
      "Still not a perfect match without testing",
      "Not for deep or structural repairs"
    ],
    "bottomLine": "The best widely sold choice when the repair will be stained rather than painted."
  },
  {
    "id": "abatron-woodepox-weab6or",
    "badge": "Best for Rotted Wood",
    "category": "Two-Part Epoxy Paste",
    "name": "Abatron WoodEpox Epoxy Wood Replacement Compound",
    "amazonUrl": "",
    "description": "Restoration carpenters turn to WoodEpox to rebuild rotted window sills, door jambs, columns and trim that would otherwise be torn out and replaced. It is a two-part epoxy paste, mixed in equal parts, that cures into a hard, wood-like mass with essentially no shrinkage; once cured, it can be sawn, planed, drilled, nailed, sanded and carved like wood. Abatron designs it to work alongside its LiquidWood consolidant, which soaks into softened fibers and hardens them before the paste goes on, and together the two form a durable, waterproof repair bonded to sound wood. The tradeoffs are cost, a working time that means mixing only what you can apply, and a learning curve on technique. It is also a paint-grade repair that will not take stain like wood. For exterior rot where the alternative is a carpenter and a new sill, it is by a wide margin the most capable product here.",
    "pros": [
      "Rebuilds missing and rotted sections",
      "No meaningful shrinkage",
      "Can be sawn, planed, drilled and nailed when cured",
      "Waterproof and suited to exterior use",
      "Pairs with LiquidWood consolidant"
    ],
    "cons": [
      "Expensive compared with one-part fillers",
      "Mixing and working time take practice",
      "Paint-grade only"
    ],
    "bottomLine": "The serious choice for rot repair, worth the price when the alternative is replacing the wood."
  },
  {
    "id": "minwax-high-performance-wood-filler-41600",
    "badge": "Best Fast Exterior Repair",
    "category": "Two-Part, Paint-Grade",
    "name": "Minwax High Performance Wood Filler",
    "amazonUrl": "",
    "description": "Minwax High Performance is a two-part filler, a can of filler plus a tube of hardener, mixed in small batches. The chemistry hardens quickly, so sanding and painting can follow far sooner than with a deep layer of latex, and it does not shrink as it sets. That suits it to exterior trim, broken corners, deep gouges and other repairs on wood that will be painted and has to stand up to weather. Minwax pairs it with its Wood Hardener for softened wood, a lighter take on the consolidant-plus-filler method the Abatron system uses. The quick set is also the main drawback: mix only what you can apply in a few minutes, and work somewhere ventilated because the odor is strong. It is paint-grade, so do not plan to stain it. For quick, durable exterior repairs on a budget, it is the practical middle ground between latex and epoxy.",
    "pros": [
      "Sets fast and sands soon after",
      "No shrinkage on deep fills",
      "Strong, weather-resistant repair",
      "Can pair with Minwax Wood Hardener"
    ],
    "cons": [
      "Short working time once mixed",
      "Strong odor",
      "Not stainable"
    ],
    "bottomLine": "A fast, durable paint-grade repair for exterior trim when epoxy is more than the job needs."
  },
  {
    "id": "j-b-weld-kwikwood-8258",
    "badge": "Best Quick Epoxy Fix",
    "category": "Epoxy Putty Stick",
    "name": "J-B Weld KwikWood Epoxy Putty Stick",
    "amazonUrl": "",
    "description": "KwikWood is an epoxy stick you knead: slice off a piece, work it until the two parts blend to an even tan, press it into the damage and shape it. J-B Weld lists a set time of around a quarter hour and a cure time of about an hour, after which it can be drilled, sanded, painted and, to some degree, stained. With nothing to measure and no mixing cup, it excels at small, awkward repairs: a stripped screw hole in a cabinet, a chipped table leg, a broken door corner or a damaged stretch of exterior trim. It is not economical over large areas, and its tan color means stained repairs will rarely disappear. For a quick, strong fix that can hold a fastener and survive outdoors, though, it is hard to beat in a toolbox, and the stick keeps well when sealed between uses.",
    "pros": [
      "No measuring, just knead and press",
      "Sets and cures quickly per the label",
      "Strong enough to hold screws",
      "Works on small exterior repairs"
    ],
    "cons": [
      "Expensive per ounce for large repairs",
      "Tan color shows through stain"
    ],
    "bottomLine": "A toolbox essential for small, strong repairs and stripped screw holes."
  },
  {
    "id": "goodfilla-wood-grain-filler-8oz",
    "badge": "Best for Woodworkers",
    "category": "Water-Based, Tintable",
    "name": "Goodfilla Water-Based Wood and Grain Filler",
    "amazonUrl": "",
    "description": "Goodfilla targets furniture makers and flooring installers more than house painters. It is water-based, sold in a long list of species-matched colors, and can be thinned with water to act as a grain filler on open-pored woods like oak and ash before finishing, a job most wood fillers cannot do. It also stays usable in the container: the company says a batch that dries out can be brought back with water, which means less waste than tubs that harden for good. Owners commonly praise how well it sands and how close the colors come when chosen carefully, and it accepts both stain and topcoats. Its limit is where it can go: it is intended for interior use, which rules it out for exterior trim, decks or anything exposed to weather. For indoor work where looks matter most, it ranks among the best available, and the grain-filling ability adds real value for anyone building furniture.",
    "pros": [
      "Species-matched color range",
      "Doubles as a grain filler when thinned",
      "Can be revived with water",
      "Sands easily",
      "Accepts stain and topcoats"
    ],
    "cons": [
      "Interior use only",
      "Smaller containers cost more per ounce"
    ],
    "bottomLine": "The furniture maker's choice for indoor repairs and grain filling."
  },
  {
    "id": "gorilla-wood-filler-107104",
    "badge": "Best Budget All-Purpose",
    "category": "Acrylic, Interior and Exterior",
    "name": "Gorilla All Purpose Wood Filler",
    "amazonUrl": "",
    "description": "Gorilla's filler is an inexpensive, general-purpose acrylic for the jobs most homeowners run into: nail holes, dents, gouges and small cracks inside and outside the house. The company lists it as water resistant, shrink resistant and sandable, rates it for interior and exterior use, and it cleans up with water. It spreads easily, stays put on vertical surfaces and sands without much effort. Gorilla markets it as paintable and stainable; treat the stain claim as you would for any latex-type filler and test on scrap first, because the color will rarely blend perfectly. Like any one-part filler it does best on shallow repairs, so build deep holes in layers and keep it away from structural or rotted wood. As a garage tub that covers most everyday patching for less than premium brands, it is a sensible buy, and owners commonly report that it stores well with the lid sealed tightly.",
    "pros": [
      "Low price for a general-purpose tub",
      "Interior and exterior rated",
      "Water resistant once dry",
      "Easy to spread and sand"
    ],
    "cons": [
      "Stain match is approximate",
      "Layer deep fills"
    ],
    "bottomLine": "A solid low-cost tub for everyday patching inside and out."
  },
  {
    "id": "famowood-latex-wood-filler-40022126",
    "badge": "Fastest Drying Latex",
    "category": "Latex, Fast-Drying",
    "name": "FamoWood Latex Wood Filler",
    "amazonUrl": "",
    "description": "FamoWood's latex filler is made for speed. Thin applications dry fast enough to sand in minutes rather than hours, which makes it a favorite of trim carpenters and anyone filling dozens of nail holes in one session. It comes in a range of wood tones, cleans up with water and is rated for interior and exterior use. The quick drying cuts both ways: the filler skins over in the tub if the lid is left off, so work from a small amount and close the container between scoops. It also shrinks a bit more than some rivals on deeper fills, so a second skim coat is common. On painted trim, cabinets and baseboard, that speed saves real time. For stained work the color choices help, though as with any filler, test first. Keep it for fast production work, not deep or structural repairs.",
    "pros": [
      "Dries and sands quickly in thin layers",
      "Several wood-tone colors",
      "Water cleanup",
      "Interior and exterior rated"
    ],
    "cons": [
      "Skins in the tub if left open",
      "May need a second coat on deeper holes"
    ],
    "bottomLine": "Best when you are filling many small holes and want to sand and paint the same afternoon."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Wood Filler",
          item: "https://www.allmetalbrake.com/best-wood-filler/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which filler should I use on outdoor trim and siding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On painted exterior wood with small holes, DAP Plastic Wood-X holds up well once it is primed and painted. Larger damage, broken edges and weathered trim call for a two-part product such as Minwax High Performance or Abatron WoodEpox, which lasts longer because it does not shrink and resists moisture. Rotted wood needs a consolidant first, then an epoxy filler."
          }
        },
        {
          "@type": "Question",
          "name": "Is wood putty the same as wood filler?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, they are different products. Filler hardens; it goes onto bare wood, is sanded flush and is then painted or finished. Putty stays soft, is usually oil-based and fills nail holes after the finish is already on, mostly on stained work. Putty is never sanded, and it should not be used on bare wood that is going to be painted."
          }
        },
        {
          "@type": "Question",
          "name": "How do I make wood filler match stain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Choose a filler shade that matches the finished, stained color rather than the bare wood. Once it is applied, dry and sanded, stain a sample board carrying both the wood and the filler, and change the filler shade if the patch reads wrong. Products built to take stain, Minwax Stainable and Goodfilla among them, are easier to fine-tune than all-purpose tubs."
          }
        },
        {
          "@type": "Question",
          "name": "How long before I can sand wood filler?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A thin latex fill often sands in 15 minutes to an hour, while a deep latex fill can need several hours or more. Two-part polyester fillers usually sand within about half an hour, and epoxy pastes may need several hours to overnight. Depth and temperature change everything, so follow the label and confirm the center is hard, not just the skin."
          }
        },
        {
          "@type": "Question",
          "name": "How do I fill a big hole or a missing chunk of wood?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Reach for a two-part product instead of a one-part latex. Polyester fillers and epoxy pastes cure all the way through without shrinking and can be built up thick. For a very large void, glue in a block of wood to take up most of the space and fill around it. In rotted areas, remove all soft wood and apply a consolidant before filling."
          }
        },
        {
          "@type": "Question",
          "name": "Will a screw hold in wood filler?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not in one-part latex filler; it crumbles as the screw bites. A cured two-part epoxy or epoxy putty stick can hold one, provided you drill a pilot hole once it has cured. For stripped hinge screws and other fasteners under load, the most dependable fix is still to glue a hardwood dowel or wood slivers into the hole and drill it again."
          }
        },
        {
          "@type": "Question",
          "name": "Can wood filler be used on decks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only for small cosmetic repairs on painted or solid-stained decks, and even then the patch tends to show. Deck boards move with moisture, carry foot traffic and usually wear semi-transparent stain that will not hide filler, so badly damaged boards are better replaced. Save epoxy for small, localized damage on railings or trim."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Caulk & Exterior Repair",
    tags: [
      "best wood filler",
      "stainable wood filler",
      "epoxy wood filler",
      "exterior wood filler",
      "wood rot repair",
      "two-part wood filler"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The 8 Best Wood Fillers in 2026
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          DAP Plastic Wood-X is the best wood filler for most nail holes, dings and trim repairs that will be painted. The hole decides the product: deeper than about a quarter inch, outdoors, rotted or due for stain each call for a two-part, epoxy or stainable filler instead. This guide matches 8 fillers to each job, with drying times, stain tips and costs.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          Based on manufacturer specifications and labels, including set and sanding times, plus recurring owner feedback. Not hands-on tested. No paid placements. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">13 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>Which Filler to Buy</span></a>
              <a href="#short-answer" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>The Short Answer</span></a>
              <a href="#types" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Types of Wood Filler</span></a>
              <a href="#filler-putty-caulk" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Filler vs Putty vs Caulk</span></a>
              <a href="#stain" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>Is Stainable Filler Stainable?</span></a>
              <a href="#exterior" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Exterior and Rotted Wood</span></a>
              <a href="#apply" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>How to Apply and Sand</span></a>
              <a href="#drying" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>How Long It Takes to Dry</span></a>
              <a href="#strength" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>Screws and Nails</span></a>
              <a href="#cost" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Cost and Shelf Life</span></a>
              <a href="#choose" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>Best Filler by Project</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">12.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">13.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          With wood filler, the cheapest tub on the shelf is often exactly right and occasionally exactly wrong. One-part latex filler is ideal for nail holes and small dents. It is a poor fit for a hole more than a quarter inch deep, for a joint that moves, or for an outdoor spot that holds water. Match the chemistry to the damage and nearly every product below does its job well.
        </p>

        <QuickPicks products={PRODUCTS} />

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 8 Best Wood Fillers in 2026, Ranked
          </h2>

          <p>
            Begin with the hole in front of you, then think about the finish going over it. The first card is the everyday tub for painted work. The other seven each answer a narrower job, from stained furniture to rotted sills to dozens of nail holes in a single afternoon, and the badge on each card names that job.
          </p>

