---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Exterior Caulk",
    "url": "/best-exterior-caulk/"
  },
  {
    "title": "Caulking Exterior Windows, Step by Step",
    "url": "/how-to-caulk-exterior-windows/"
  },
  {
    "title": "How Long Does Caulk Take to Dry",
    "url": "/how-long-does-caulk-take-to-dry/"
  },
  {
    "title": "Best Gutter Guards",
    "url": "/best-gutter-guards/"
  },
  {
    "title": "Best Deck Stain",
    "url": "/best-deck-stain-reviews/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 8 Best Wood Fillers: From Nail Holes to Rotted Sills";
const description =
  "Eight wood fillers ranked by job, from stainable latex for furniture to two-part epoxy for rotted exterior trim, plus how to choose, apply and finish each type.";

const PRODUCTS = [
  {
    "id": "dap-plastic-wood-x-7079800540",
    "badge": "Best Overall",
    "category": "Latex, Interior and Exterior",
    "name": "DAP Plastic Wood-X Wood Filler with DryDex",
    "amazonUrl": "",
    "description": "Plastic Wood-X earns the top spot because it does the most common job, filling small to medium holes in trim, doors and furniture, with almost no fuss. It goes on pink and turns its natural wood tone as it dries, a DryDex feature that takes the guesswork out of when to sand. The knife-grade consistency spreads smoothly, stays put on vertical surfaces and sands to a fine, crisp edge without gumming the paper. DAP rates it for interior and exterior use and lists it as paintable and stainable, and it cleans up with water. For painted work it is as close to foolproof as filler gets. Like every one-part latex filler, it is not structural and it is not meant for very deep voids in one pass; fill in layers on anything deeper than a quarter inch, and switch to a two-part product for rot or broken edges. Owners commonly report it holding up well on exterior trim once it is primed and painted.",
    "pros": [
      "Color change shows when it is ready to sand",
      "Smooth, non-sag texture",
      "Sands cleanly without clogging paper",
      "Interior and exterior rated",
      "Water cleanup"
    ],
    "cons": [
      "Fill deep holes in layers",
      "Not for structural or rotted wood repairs"
    ],
    "bottomLine": "The default tub for nail holes, dings and trim repairs that will be painted."
  },
  {
    "id": "minwax-stainable-wood-filler-42853",
    "badge": "Best for Stained Projects",
    "category": "Stainable, Interior and Exterior",
    "name": "Minwax Stainable Wood Filler",
    "amazonUrl": "",
    "description": "Most fillers claim to be stainable. Few take stain anywhere near the surrounding wood. Minwax built this one specifically to accept oil-based and water-based stain more like real wood fibers do, and owners commonly report it blending better than typical latex fillers on stained furniture, cabinets and floors. It is sold in several wood tones so you can start close to your final color, which matters more than the stain itself. Expect to experiment: apply a test patch on scrap, stain it alongside the surrounding wood, and adjust before committing. Minwax lists it for indoor and outdoor work; it sands well, and holds an edge on small breaks and gouges. It is not the right product for large voids or rotted wood, and like every stainable filler it will still read a little different from the wood grain under close inspection. For a near-invisible stained repair it is the best starting point among the widely available options.",
    "pros": [
      "Formulated to accept stain more evenly than typical fillers",
      "Several wood-tone colors",
      "Interior and exterior rated",
      "Sands to a smooth edge"
    ],
    "cons": [
      "Still not a perfect match without testing",
      "Not for deep or structural repairs"
    ],
    "bottomLine": "The best widely sold choice when the repair will be stained rather than painted."
  },
  {
    "id": "abatron-woodepox-weab6or",
    "badge": "Best for Rotted Wood",
    "category": "Two-Part Epoxy Paste",
    "name": "Abatron WoodEpox Epoxy Wood Replacement Compound",
    "amazonUrl": "",
    "description": "WoodEpox is what restoration carpenters use to rebuild rotted window sills, door jambs, columns and trim that would otherwise be replaced. It is a two-part epoxy paste mixed in equal parts that cures into a hard, wood-like mass with essentially no shrinkage, and once cured it can be sawn, planed, drilled, nailed, sanded and carved like wood. Abatron designs it to work with its LiquidWood consolidant, which soaks into softened fibers and hardens them before the paste goes on; together they form a durable, waterproof repair bonded to sound wood. The tradeoffs are cost, a working time that requires you to mix only what you can apply, and a technique learning curve. You also must accept that it is a paint-grade repair; it will not take stain like wood. For exterior rot where the alternative is a carpenter and a new sill, it is the most capable product here by a wide margin.",
    "pros": [
      "Rebuilds missing and rotted sections",
      "No meaningful shrinkage",
      "Can be sawn, planed, drilled and nailed when cured",
      "Waterproof and suited to exterior use",
      "Pairs with LiquidWood consolidant"
    ],
    "cons": [
      "Expensive compared with one-part fillers",
      "Mixing and working time take practice",
      "Paint-grade only"
    ],
    "bottomLine": "The serious choice for rot repair, worth the price when the alternative is replacing the wood."
  },
  {
    "id": "minwax-high-performance-wood-filler-41600",
    "badge": "Best Fast Exterior Repair",
    "category": "Two-Part, Paint-Grade",
    "name": "Minwax High Performance Wood Filler",
    "amazonUrl": "",
    "description": "Minwax High Performance is a two-part filler: a can of filler and a tube of hardener you mix in small batches. The chemistry hardens quickly, so you can sand and paint far sooner than with a deep layer of latex filler, and it does not shrink as it sets. That makes it a strong fit for exterior trim, broken corners, deep gouges and other repairs on wood that will be painted and that needs to stand up to weather. Minwax pairs it with its Wood Hardener for softened wood, a lighter version of the consolidant-plus-filler approach the Abatron system uses. The fast set is also its main drawback: mix only what you can apply in a few minutes, and work in a ventilated space because the odor is strong. It is paint-grade, so do not plan on staining it. For quick, durable exterior repairs on a budget, it is the practical middle ground between latex and epoxy.",
    "pros": [
      "Sets fast and sands soon after",
      "No shrinkage on deep fills",
      "Strong, weather-resistant repair",
      "Can pair with Minwax Wood Hardener"
    ],
    "cons": [
      "Short working time once mixed",
      "Strong odor",
      "Not stainable"
    ],
    "bottomLine": "A fast, durable paint-grade repair for exterior trim when epoxy is more than the job needs."
  },
  {
    "id": "j-b-weld-kwikwood-8258",
    "badge": "Best Quick Epoxy Fix",
    "category": "Epoxy Putty Stick",
    "name": "J-B Weld KwikWood Epoxy Putty Stick",
    "amazonUrl": "",
    "description": "KwikWood is a kneadable epoxy stick: cut off a slice, knead it until the two parts are blended to a uniform tan, press it into the damage and shape it. J-B Weld lists a set time in the range of a quarter hour and a cure time of about an hour; once cured, it can be drilled, sanded, painted and stained to some degree. There is nothing to measure and no mixing cup, which is why it shines on small, awkward repairs: a stripped screw hole in a cabinet, a chipped table leg, a broken corner on a door, or a damaged section of exterior trim. It is not economical for large areas, and the tan color means stained repairs will rarely disappear. But for a fast, strong fix that can hold a fastener and survive outdoors, it is hard to beat in a toolbox, and the stick keeps well when sealed between uses.",
    "pros": [
      "No measuring, just knead and press",
      "Sets and cures quickly per the label",
      "Strong enough to hold screws",
      "Works on small exterior repairs"
    ],
    "cons": [
      "Expensive per ounce for large repairs",
      "Tan color shows through stain"
    ],
    "bottomLine": "A toolbox essential for small, strong repairs and stripped screw holes."
  },
  {
    "id": "goodfilla-wood-grain-filler-8oz",
    "badge": "Best for Woodworkers",
    "category": "Water-Based, Tintable",
    "name": "Goodfilla Water-Based Wood and Grain Filler",
    "amazonUrl": "",
    "description": "Goodfilla is aimed at furniture makers and flooring installers rather than house painters. It is water-based, comes in a long list of species-matched colors, and can be thinned with water to work as a grain filler on open-pored woods like oak and ash before finishing, a job most wood fillers cannot do. It also stays workable in the container: if it dries out, the company says you can add water to bring it back, which cuts waste compared with tubs that harden. Owners commonly praise how well it sands and how close the colors get when chosen carefully, and it accepts both stain and topcoats. The limitation is environment: it is intended for interior use, so it is the wrong pick for exterior trim, decks or anything that will see weather. For indoor projects where appearance matters most, it is one of the best options available, and the grain-filling ability adds real value for anyone building furniture.",
    "pros": [
      "Species-matched color range",
      "Doubles as a grain filler when thinned",
      "Can be revived with water",
      "Sands easily",
      "Accepts stain and topcoats"
    ],
    "cons": [
      "Interior use only",
      "Smaller containers cost more per ounce"
    ],
    "bottomLine": "The furniture maker's choice for indoor repairs and grain filling."
  },
  {
    "id": "gorilla-wood-filler-107104",
    "badge": "Best Budget All-Purpose",
    "category": "Acrylic, Interior and Exterior",
    "name": "Gorilla All Purpose Wood Filler",
    "amazonUrl": "",
    "description": "Gorilla's wood filler is an inexpensive, general-purpose acrylic product for the jobs most homeowners face: nail holes, dents, gouges and small cracks inside and outside the house. The company lists it as water resistant, shrink resistant and sandable, and rates it for interior and exterior use, with water cleanup. It spreads easily, holds on vertical surfaces and sands without much effort. Gorilla markets it as paintable and stainable; treat the stainable claim the way you would for any latex-type filler and test on scrap first, since the color will rarely blend perfectly. Like any one-part filler it works best on shallow repairs, so fill deep holes in layers and keep it out of structural or rotted wood. For a garage tub that handles most everyday patching at a lower price than premium brands, it is a sensible buy, and owners commonly report it storing well when the lid is sealed tightly.",
    "pros": [
      "Low price for a general-purpose tub",
      "Interior and exterior rated",
      "Water resistant once dry",
      "Easy to spread and sand"
    ],
    "cons": [
      "Stain match is approximate",
      "Layer deep fills"
    ],
    "bottomLine": "A solid low-cost tub for everyday patching inside and out."
  },
  {
    "id": "famowood-latex-wood-filler-40022126",
    "badge": "Fastest Drying Latex",
    "category": "Latex, Fast-Drying",
    "name": "FamoWood Latex Wood Filler",
    "amazonUrl": "",
    "description": "FamoWood's latex filler is built for speed. Thin applications dry quickly enough to sand in minutes rather than hours, which makes it popular with trim carpenters and anyone filling dozens of nail holes in a single session. It comes in a range of wood tones, cleans up with water, and is rated for both interior and exterior use. The fast drying is a double-edged sword: the product skins in the tub if the lid is left off, so work from a small amount and close the container between scoops. It also shrinks a little more than some competitors on deeper fills, so a second skim coat is common. On painted trim, cabinets and baseboard, its speed shaves real time off a job. For stained work, the color options help, though as with any filler, test before committing. Keep it for fast production work rather than deep or structural repairs.",
    "pros": [
      "Dries and sands quickly in thin layers",
      "Several wood-tone colors",
      "Water cleanup",
      "Interior and exterior rated"
    ],
    "cons": [
      "Skins in the tub if left open",
      "May need a second coat on deeper holes"
    ],
    "bottomLine": "Best when you are filling many small holes and want to sand and paint the same afternoon."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Wood Filler",
          item: "https://www.allmetalbrake.com/best-wood-filler/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which filler should I use on outdoor trim and siding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For small holes on painted exterior wood, DAP Plastic Wood-X performs well once primed and painted. For larger damage, broken edges or weathered trim, a two-part product such as Minwax High Performance or Abatron WoodEpox is more durable because it does not shrink and resists moisture. For rot, use a consolidant followed by epoxy."
          }
        },
        {
          "@type": "Question",
          "name": "Is wood putty the same as wood filler?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They are different products. Filler hardens and is applied to bare wood, sanded flush and then painted or finished. Wood putty stays soft, is usually oil-based, and fills nail holes once the finish is already on, mainly on stained work. Putty is not sanded and should not be used under paint on bare wood."
          }
        },
        {
          "@type": "Question",
          "name": "How do I make wood filler match stain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Choose a filler color close to the final stained color rather than the raw wood. Apply, dry and sand it, then stain a test board with both wood and filler. Adjust the filler tone if the patch is off. Products formulated to accept stain, such as Minwax Stainable or Goodfilla, are easier to tune than general-purpose fillers."
          }
        },
        {
          "@type": "Question",
          "name": "How long before I can sand wood filler?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Thin latex fills are often sandable in 15 minutes to an hour; deep latex fills can take several hours or more. Two-part polyester fillers typically sand within about half an hour, while epoxy pastes may need several hours to overnight. Temperature and depth change everything, so follow the label and make sure the center is hard, not just the surface."
          }
        },
        {
          "@type": "Question",
          "name": "How do I fill a big hole or a missing chunk of wood?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use a two-part product rather than a one-part latex. Two-part polyester fillers and epoxy pastes cure throughout without shrinking and can be built up thick. For very large voids, glue in a block of wood first to take up most of the space, then fill around it. For rotted areas, remove all soft wood and use a consolidant before filling."
          }
        },
        {
          "@type": "Question",
          "name": "Will a screw hold in wood filler?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not in one-part latex filler, which crumbles under a screw. Cured two-part epoxy and epoxy putty sticks can hold screws if you drill a pilot hole after cure. For stripped hinge screws and other loaded fasteners, gluing a hardwood dowel or wood slivers into the hole and redrilling is still the most reliable fix."
          }
        },
        {
          "@type": "Question",
          "name": "Can wood filler be used on decks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only for small, cosmetic repairs on painted or solid-stained decks, and even then it tends to show. Deck boards move with moisture, take foot traffic and are usually finished with semi-transparent stain that will not hide filler. Badly damaged deck boards are better replaced. Use an epoxy only for small, localized damage on railings or trim."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Caulk & Exterior Repair",
    tags: [
      "best wood filler",
      "stainable wood filler",
      "epoxy wood filler",
      "exterior wood filler",
      "wood rot repair",
      "two-part wood filler"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 8 Best <span class="text-[#38BDF8]">Wood Fillers</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A nail hole in painted trim and a rotted window sill need completely different products. Here is which filler belongs in which hole.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#dap-plastic-wood-x-7079800540"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.1k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Five Kinds of Filler</a>
          <a href="#filler-putty-caulk" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Filler vs Putty vs Caulk</a>
          <a href="#stain" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Stain Matching</a>
          <a href="#exterior" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Exterior and Rot Repair</a>
          <a href="#apply" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Applying and Sanding</a>
          <a href="#drying" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Drying and Recoat Times</a>
          <a href="#strength" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Screws and Strength</a>
          <a href="#cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Cost and Shelf Life</a>
          <a href="#choose" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Picking by Project</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Wood filler is one of those products where the cheapest tub is often exactly right and sometimes completely wrong. A one-part latex filler is perfect for nail holes and small dings. It is a poor choice for a hole deeper than a quarter inch, a joint that moves, or anything outside that holds water. Match the chemistry to the hole and almost every filler on this list does its job well.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 8 Best Wood Fillers, Ranked
          </h2>

          <p>
            Picks are ranked by fit for the job, based on manufacturer specifications and labels (chemistry, rated uses, interior or exterior rating, set and sanding times, stain and paint compatibility) and on recurring patterns in owner feedback. We did not run lab tests; where a manufacturer does not publish a figure, we leave it out rather than guess.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} index={index} />
          ))}
        </div>

        <div id="types" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Five Kinds of Wood Filler
          </h2>

          <p>
            The shelf looks crowded, but almost every wood filler fits into one of five groups. Each group has a clear set of jobs it does well and a clear set it should never be asked to do. Figure out which group you need before you compare brands.
          </p>

          <p>
            <strong>One-part latex or acrylic fillers</strong> are the familiar tubs. They are ready to use, clean up with water and sand easily. They harden by losing water, so they shrink slightly and work best in shallow holes. <strong>Solvent-based one-part fillers</strong> are older formulas that harden by solvent evaporation. They are tougher than most latex fillers but smell stronger and need solvent cleanup; many have been replaced by water-based products.
          </p>

          <p>
            <strong>Two-part polyester fillers</strong> (Minwax High Performance is the common example) mix a filler with a hardener. They set fast, do not shrink and are strong enough for exterior trim. <strong>Two-part epoxy pastes</strong>, such as Abatron WoodEpox, are the heavy-duty option for rot repair and rebuilding missing wood. <strong>Epoxy putty sticks</strong>, such as KwikWood, are a convenient form of the same chemistry for small, strong repairs.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Type</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Shrinkage</th>
