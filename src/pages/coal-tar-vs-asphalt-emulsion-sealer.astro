---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/coal-tar-vs-asphalt-emulsion-sealer.html?raw';

const title = "Coal Tar vs Asphalt Emulsion Sealer: Which Should You Use?";
const description = "Coal tar resists fuel and lasts longer, but carries far more PAHs and is banned in many places. How it compares to asphalt emulsion, and what to use instead.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
