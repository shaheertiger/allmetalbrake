---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/why-is-my-concrete-sealer-turning-white.html?raw';

const title = "Why Is My Concrete Sealer Turning White? Causes and Fixes";
const description = "White, milky concrete sealer is almost always trapped moisture. How to tell blush from efflorescence, fix it with xylene or stripping, and stop it coming back.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
