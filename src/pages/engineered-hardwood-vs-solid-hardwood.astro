---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/engineered-hardwood-vs-solid-hardwood.html?raw';

const title = "Engineered Hardwood vs Solid Hardwood: Which Should You Use?";
const description = "Engineered floors go where solid can't: basements, slabs, radiant heat. Wear layer refinish counts, stability, costs per sq ft and how to spot cheap veneer.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
