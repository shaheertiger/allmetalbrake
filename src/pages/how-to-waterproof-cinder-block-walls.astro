const dates = pageDates(Astro.url.pathname, { published: "2026-11-18", modified: "2026-11-18" });
const title = "How to Waterproof Cinder Block Walls: Test, Prep, Then Seal";
const description =
  "Tape foil to the block for 24 to 48 hours first: seepage needs a masonry waterproofer scrubbed in 2 coats; rain-soaked exterior block needs a silane-siloxane.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How to Waterproof Cinder Block Walls",
          item: "https://www.allmetalbrake.com/how-to-waterproof-cinder-block-walls/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best way to seal cinder blocks to avoid moisture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Find the water source first with a foil test, then fix gutters and grading outside. On a basement wall that seeps, scrub two coats of a masonry waterproofer into bare, clean block. On exterior, garage or garden walls hit by rain, spray on a silane-siloxane repellent. Clean off efflorescence and paint before either, and patch active leaks with hydraulic cement."
          }
        },
        {
          "@type": "Question",
          "name": "What type of sealer is best for waterproofing cinder block?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the side the water comes from. Cement-and-latex masonry waterproofers, the Drylok-type products, suit interior basement block because they resist water pressure to a labeled rating. Silane-siloxane penetrating repellents suit exterior above-grade block. Silicate densifiers are best on bare poured concrete, and clear acrylics are mainly cosmetic for dry, sheltered walls."
          }
        },
        {
          "@type": "Question",
          "name": "Do silicate sealers work on basement walls?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Silicate sealers work by reacting with lime inside bare concrete, so they suit clean, unpainted poured walls best and perform less predictably on hollow block. They will not react through paint, old sealers or a layer of dirt and dust, so scrub and rinse the wall first. They reduce dampness but are not designed to stop heavy seepage from saturated soil."
          }
        },
        {
          "@type": "Question",
          "name": "What product seals a basement wall from inside the house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A cement-based masonry waterproofer brushed onto bare block is the standard interior product. Makers rate these coatings for hydrostatic pressure; DRYLOK Extreme, for example, is rated by its manufacturer for 15 psi. Hydraulic cement handles active leaks and holes before coating. Ordinary latex paint, clear acrylics and repellents are not substitutes on a seeping basement wall."
          }
        },
        {
          "@type": "Question",
          "name": "Can you waterproof cinder block from the inside only?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Often, yes. Interior sealing handles dampness and slow seepage well once roof water and grading are under control, and it avoids excavation. It cannot stop water entering at the joint between wall and floor or hold back heavy pressure. If coatings blister or water pools along the floor after storms, the wall needs interior drain tile or exterior work."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a sealed cinder block wall stay waterproof?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Labels on silane-siloxane repellents commonly quote around five to ten years in typical exposure, and interior masonry waterproofers usually last a similar period before touch-ups. Sunny, wet exterior walls wear faster than sheltered ones. Splash water on a repellent-treated wall each year; when it soaks in instead of beading, clean the wall and reapply."
          }
        },
        {
          "@type": "Question",
          "name": "Can you paint over a sealed cinder block wall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the sealer. Masonry waterproofers are designed to be the finish or to take a latex topcoat after they cure, and most come in tintable colors. Many silane-siloxane repellents leave a surface that paint will not grip, so check the data sheet before sealing. If you want color, choose a waterproofer or a block filler and masonry paint system instead."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
  ],
};
