---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/rain-after-sealing-driveway.html?raw';

const title = "Rain After Sealing a Driveway? Timing & Fixes | Home Fix Reviews";
const description = "Most driveway sealers need about 24 hours rain-free. Windows by sealer type, how to read the forecast, and how to fix streaks, wash-off and runoff stains.";
