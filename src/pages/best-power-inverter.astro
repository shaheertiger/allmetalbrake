---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Lithium RV Batteries",
    "url": "/best-lithium-rv-battery/"
  },
  {
    "title": "Best Portable Power Station for Camping",
    "url": "/best-portable-power-station-for-camping/"
  },
  {
    "title": "Best Home Battery Backup",
    "url": "/best-home-battery-backup/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "The Best Power Inverters: 12V Picks for Cars, Trucks and RVs";
const description =
  "Six 12V power inverters for cars, trucks, RVs and battery banks, with pure vs modified sine, surge sizing, cable gauge, fusing and the socket limit explained.";

const PRODUCTS = [
  {
    "id": "renogy-1000w-pure-sine-wave-inverter",
    "name": "Renogy 1000W Pure Sine Wave Inverter",
    "category": "12V DC in, 1,000W continuous, pure sine",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "Pure sine output that is safe for laptops, CPAPs and chargers",
      "1,000W covers most van, truck-cab and small-RV loads",
      "Draws around 100A at full load, which ordinary 4 AWG-class wiring can handle on short runs",
      "Renogy sells matching batteries, fuses and cables, so the system is easy to piece together",
      "Widely stocked and frequently discounted"
    ],
    "cons": [
      "Will not run a full-size microwave or a coffee maker",
      "Cooling fan is audible in a quiet camper at night",
      "Must be hardwired to a battery; no cigarette-plug option at this size"
    ],
    "bottomLine": "The right size and the right waveform for most people who want household power from a 12V battery.",
    "description": "If you are not sure what size inverter you need, a 1,000W pure sine unit is the safest bet, and Renogy's is the one most people end up with. It is big enough to run a laptop, a TV, a CPAP, a blender, power-tool battery chargers and a small fridge, and it is small enough that the wiring stays manageable: at full load it pulls roughly 100 amps from a 12V battery, which a short run of heavy-gauge cable and a correctly sized fuse handle without drama. The pure sine output means nothing you plug in runs hot or buzzes. Renogy also makes the batteries, solar controllers and DC-DC chargers that usually sit beside an inverter in a van or trailer, which makes it simple to build a matched system. What it will not do is boil water: a 1,000W microwave actually draws closer to 1,500W, so kitchen appliances need the 2,000W class."
  },
  {
    "id": "gowise-power-2000w-pure-sine-wave-inverter",
    "name": "GoWISE Power 2000W Pure Sine Wave Inverter",
    "category": "12V DC in, 2,000W continuous, pure sine",
    "badge": "Best 2000 Watt Inverter",
    "amazonUrl": "",
    "pros": [
      "2,000W continuous runs a microwave, coffee maker or circular saw",
      "Pure sine output for sensitive electronics",
      "GoWISE lists a 4,000W peak rating for motor starts",
      "Usually priced well below the RV-industry brands"
    ],
    "cons": [
      "Pulls around 200A at full load, so cabling and fusing become a real project",
      "Large and heavy enough to need a proper mounting spot",
      "Idle draw is meaningful; switch it off when not in use"
    ],
    "bottomLine": "The value pick for a 2,000 watt power inverter, as long as your battery bank and cabling are built to feed it.",
    "description": "The 2,000W class is where an inverter starts running real kitchen and jobsite loads, and GoWISE Power's pure sine model is one of the most widely sold options at that size. GoWISE lists it at 2,000W continuous and 4,000W peak, enough to run a 1,000W-class microwave, a drip coffee maker or a corded circular saw. The catch with any 2,000 watt power inverter on a 12V system is current. At full output it draws in the region of 200 amps, which means cable in the 2/0 range on a short run, a fuse rated for that cable, and a battery bank that can actually deliver that current for minutes at a time. A single small lead-acid battery cannot, and a 100Ah lithium battery with a 100A BMS will shut off. Built around a capable bank, though, it gives you a lot of household capability for the money."
  },
  {
    "id": "victron-phoenix-12-1200-inverter",
    "name": "Victron Phoenix 12/1200 Inverter",
    "category": "12V DC in, 1,200VA, pure sine",
    "badge": "Best Premium for Vans",
    "amazonUrl": "",
    "pros": [
      "Very low idle draw, with an ECO search mode that cuts it further",
      "Built for continuous duty in vans, boats and off-grid cabins",
      "VE.Direct port links it to Victron monitoring",
      "Victron's documentation and installer support are excellent"
    ],
    "cons": [
      "Costs noticeably more than budget inverters of similar wattage",
      "1,200VA rating works out to roughly 1,000W of real load",
      "Outlet style and options vary by regional model; check the listing"
    ],
    "bottomLine": "Pay more for the Victron when the inverter will run all day, every day, and idle draw actually matters.",
    "description": "Victron is the brand van builders and marine electricians reach for when they want something to run for a decade, and the Phoenix 12/1200 is its mainstream 12V inverter. The 1,200VA rating translates to roughly 1,000W of continuous real-world load, so on paper it competes with the Renogy, but the difference is in how it behaves when you are not using much power. Victron designs the Phoenix range for low no-load consumption and adds an ECO mode that drops the inverter into a search state until something is switched on, which matters a great deal if you leave an inverter running around the clock to keep a fridge or router alive. The VE.Direct port lets it report into Victron's monitoring ecosystem. For a weekend truck setup it is overkill. For a full-time van or a boat with a modest battery bank, the efficiency pays back."
  },
  {
    "id": "aims-power-3000w-pure-sine-inverter",
    "name": "AIMS Power 3000W Pure Sine Inverter",
    "category": "12V DC in, 3,000W continuous, pure sine",
    "badge": "Best for Trucks and Work Rigs",
    "amazonUrl": "",
    "pros": [
      "3,000W continuous handles miter saws, compressors and microwaves together",
      "Pure sine output for tool chargers and electronics",
      "AIMS has a long record supplying the work-truck and off-grid market",
      "Hardwire and outlet options suit service bodies and job trailers"
    ],
    "cons": [
      "Can draw around 300A at full load, which most single batteries cannot supply",
      "Needs 4/0-class cable and a Class T or ANL fuse sized to the manual",
      "Idle draw is high enough to flatten a starting battery overnight"
    ],
    "bottomLine": "The best power inverter for a truck that does real work, provided it gets its own battery bank.",
    "description": "Contractors who want corded tools off the truck end up in the 3,000W class, and AIMS Power is one of the established names there. Its 3,000W pure sine inverter will run a miter saw, a small air compressor and a battery charger, or a microwave and coffee maker together, which is the jobsite and tailgate list most buyers have in mind. The engineering problem is feeding it. At full output a 3,000W inverter pulls roughly 300 amps from a 12V source, so it needs very short runs of 4/0-class cable, a properly rated fuse at the battery, and an auxiliary battery bank isolated from the truck's starting battery so the engine always cranks. Run it off the starting battery with the engine off and it will kill that battery fast. Installed correctly, with a DC-DC charger or a high-output alternator topping up the bank, it turns a pickup into a mobile workshop."
  },
  {
    "id": "go-power-gp-sw2000-pure-sine-wave-inverter",
    "name": "Go Power! GP-SW2000 Pure Sine Wave Inverter",
    "category": "12V DC in, 2,000W continuous, pure sine",
    "badge": "Best for RVs",
    "amazonUrl": "",
    "pros": [
      "From a brand that RV manufacturers commonly install at the factory",
      "2,000W pure sine runs a microwave or coffee maker from the house batteries",
      "Fits naturally alongside Go Power! solar and charging gear",
      "Remote switch available for mounting in a basement bay"
    ],
    "cons": [
      "Usually priced above generic 2,000W inverters",
      "Same 200A wiring and fusing demands as any 12V 2,000W unit"
    ],
    "bottomLine": "A sensible upgrade or replacement for RV owners who want a known name in the battery bay.",
    "description": "Go Power! is a name many RV builders already use for factory solar and inverter packages, so its GP-SW2000 is a natural choice when you are adding or replacing an inverter in a travel trailer or motorhome. It is a 2,000W pure sine unit, which is the size that lets you run a microwave or a coffee maker from the house batteries without starting the generator. Mounting it near the batteries in a basement bay and running it through an optional remote switch keeps cable runs short while still letting you turn it on from inside. The things to plan for are the same as any 2,000W inverter: about 200 amps at full load, heavy cable, a fuse at the battery, and a bank sized to supply it. If your RV already has lithium house batteries and a lithium-capable charger, this is a tidy way to make that bank useful for AC loads."
  },
  {
    "id": "bestek-300w-power-inverter",
    "name": "BESTEK 300W Power Inverter",
    "category": "12V socket plug, 300W, modified sine",
    "badge": "Best Plug-In Car Inverter",
    "amazonUrl": "",
    "pros": [
      "Plugs straight into a 12V accessory socket; no wiring",
      "AC outlets plus USB charging ports in a cup-holder-friendly case",
      "Fine for laptops, phones, camera batteries and small chargers",
      "Inexpensive and easy to keep in a glovebox"
    ],
    "cons": [
      "Modified sine output; not for CPAPs, medical gear or some chargers",
      "Realistically limited to about 150W through a lighter socket"
    ],
    "bottomLine": "The portable inverter to keep in the car for laptops and chargers; anything bigger needs a hardwired unit.",
    "description": "Most people searching for a portable inverter want exactly this: something that plugs into the car's 12V socket and runs a laptop on a road trip. BESTEK's 300W unit is the long-running bestseller in that category, with household AC outlets and USB charging ports in a compact case. Understand what the 300W figure means, though. Through a cigarette-lighter plug, the vehicle's socket wiring and fuse cap the real output at roughly 150W in most cars, so the 300W rating only applies if you use the battery clamps where the kit includes them. It is also a modified sine wave inverter, which is fine for laptop power bricks, phone chargers and many small devices but is not what you want for a CPAP, a medical device, some cordless-tool battery chargers or anything with a small motor. For a glovebox power inverter, that is an acceptable trade for the price and convenience."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Power Inverters",
          item: "https://www.allmetalbrake.com/best-power-inverter/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What size power inverter do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Add up the watts of everything you will run at the same time, multiply by about 1.25 for headroom, and check that the surge rating covers your largest motor start. Laptops and phone chargers need 150-300W. A CPAP, TV and small fridge fit a 1000W inverter. A microwave or coffee maker needs about 2,000W, and running heavy tools together pushes you toward 3,000W."
          }
        },
        {
          "@type": "Question",
          "name": "Is pure sine wave really necessary?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For anything you hardwire, yes. Pure sine output matches utility power, so motors, CPAPs, variable-speed tools, chargers and audio equipment behave as they do at home. Modified sine is acceptable for laptop power bricks, phone chargers and resistive loads like incandescent bulbs. Since the price gap has narrowed, most buyers are better off spending a little more for pure sine."
          }
        },
        {
          "@type": "Question",
          "name": "Can I run a 1000W inverter from my car's cigarette lighter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The accessory socket is usually fused at 10-20 amps and wired with light cable, which limits a plug-in inverter to roughly 150W of continuous AC output. A 1,000W inverter draws around 100 amps at full load and must be connected directly to the battery with heavy cable and a fuse close to the battery, as its manual specifies."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a battery run a power inverter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Divide the battery's usable watt-hours by the load in watts, then allow about 10-15 percent for inverter losses. A 100Ah lithium battery stores about 1,280Wh, nearly all of it usable, so a 100W load runs for roughly 11 hours. A similar lead-acid battery gives you about half that if you want it to last. Idle draw also eats into runtime."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best power inverter for a truck?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the job. For laptops and chargers, a plug-in like the BESTEK 300W is enough. For tools and a microwave, a 2,000-3,000W pure sine inverter such as the AIMS Power 3000W, wired to a separate auxiliary battery bank charged by a DC-DC charger or high-output alternator, is the dependable setup. Never rely on the starting battery for big loads."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a power inverter to run my house during an outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not safely through an outlet. Connecting an inverter to house wiring requires a transfer switch or interlock installed by a licensed electrician, and a vehicle battery cannot store enough energy to run a fridge, furnace and lights for long anyway. For outages, a home generator, a large portable power station or a dedicated home battery backup system is the better choice."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy a 4000 watt power inverter for 12V?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not. At 12V a 4,000W inverter draws around 400 amps at full load, which needs very heavy cable, a large Class T fuse and a battery bank able to supply that current. Most system designers switch to a 24V or 48V battery bank at this size to halve or quarter the current, and inverter chargers become the more practical choice."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "best power inverter",
      "2000 watt power inverter",
      "power inverter portable",
      "portable inverter",
      "1000w inverter",
      "4000 watt power inverter",
      "best power inverter for truck"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Power Inverters</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Six 12V inverters from a glovebox plug-in to a 3,000W work-truck unit, plus the waveform, sizing, cable and fuse rules that decide whether any of them works in your vehicle.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#renogy-1000w-pure-sine-wave-inverter"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare the Sizes
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#at-a-glance" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Inverters at a Glance</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The Six Picks</a>
          <a href="#sine-wave" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Pure vs Modified Sine</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Continuous vs Surge</a>
          <a href="#socket" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. The 150W Socket Limit</a>
          <a href="#wiring" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Cable, Fuses, Grounding</a>
          <a href="#battery" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Batteries and Alternators</a>
          <a href="#big-inverters" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. 2,000-4,000W Inverters</a>
          <a href="#vs-station" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Inverter or Power Station?</a>
          <a href="#which" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Which One to Buy</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A power inverter is the cheap part of putting household power in a vehicle. The battery, the cable and the fuse behind it decide whether it actually runs your microwave or just beeps and shuts off.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="at-a-glance" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Inverters at a Glance
          </h2>

          <p>
            A power inverter turns the 12V DC stored in a car, truck, RV or boat battery into the 120V AC that comes out of a wall outlet. That sounds like one product, but it is really three. There are plug-in units that live in a cup holder and run a laptop. There are hardwired inverters in the 1,000-2,000W range that turn a van or camper battery bank into usable household power. And there are 3,000W-plus units for work trucks and off-grid systems, where the inverter is the easy part and the battery bank and cabling are the actual project.
          </p>

          <p>
            We picked six widely sold inverters to cover those three jobs, from a 300W socket plug-in to a 3,000W work-truck unit. These picks are based on manufacturers' published specifications, the documentation that ships with each model, and what the electrical rules say about wiring them, not on our own bench testing. Where we give a current draw or a cable size, it comes from the basic arithmetic in this guide, and the inverter's own manual always takes precedence over our rules of thumb.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Inverter</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Continuous rating</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Waveform</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Connection</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Renogy 1000W Pure Sine</td>
                    <td class="px-4 py-4 text-gray-700">1,000W</td>
                    <td class="px-4 py-4 text-gray-700">Pure sine</td>
                    <td class="px-4 py-4 text-gray-700">Hardwired to battery</td>
                    <td class="px-4 py-4 text-gray-700">Vans, campers, laptops, CPAP</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">GoWISE Power 2000W Pure Sine</td>
                    <td class="px-4 py-4 text-gray-700">2,000W (4,000W peak listed)</td>
                    <td class="px-4 py-4 text-gray-700">Pure sine</td>
                    <td class="px-4 py-4 text-gray-700">Hardwired to battery</td>
                    <td class="px-4 py-4 text-gray-700">Microwave, coffee maker, tools</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Victron Phoenix 12/1200</td>
                    <td class="px-4 py-4 text-gray-700">1,200VA (about 1,000W)</td>
                    <td class="px-4 py-4 text-gray-700">Pure sine</td>
                    <td class="px-4 py-4 text-gray-700">Hardwired to battery</td>
                    <td class="px-4 py-4 text-gray-700">Full-time vans and boats</td>
                  </tr>
