const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "The Best Solar Power Banks: Why a Folding Panel Beats Built-In Cells";
const description =
  "Solar power banks and folding USB solar chargers compared, with the sun-hour math on built-in cells, panel sizing for phones, and which pairing to buy.";

const PRODUCTS = [
