                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">On 2,000Wh</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Wi-Fi router plus modem</td>
                    <td class="px-4 py-4 text-gray-700">15-25W</td>
