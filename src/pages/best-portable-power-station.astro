---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Solar Generators",
    "url": "/best-solar-generator/"
  },
  {
    "title": "Best Power Stations for Home Backup",
    "url": "/best-portable-power-station-for-home-backup/"
  },
  {
    "title": "Best Power Stations for Camping",
    "url": "/best-portable-power-station-for-camping/"
  },
  {
    "title": "Best Home Generators for Power Outages",
    "url": "/best-home-generator-for-power-outages/"
  },
  {
    "title": "Small Generators for Home Use",
    "url": "/best-small-generator-for-home/"
  },
  {
    "title": "Best Gas Generators",
    "url": "/best-gas-generator/"
  },
  {
    "title": "Generac Generator Cost",
    "url": "/generac-generator-cost/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 7 Best Portable Power Stations: Battery Backup Ranked";
const description =
  "Seven portable power stations ranked for outages, camping and CPAP use, with honest runtime math, LiFePO4 versus NMC, solar charging and when a generator wins.";

const PRODUCTS = [
  {
    "id": "ecoflow-delta-2",
    "name": "EcoFlow DELTA 2 LFP Power Station",
    "category": "1kWh LFP, 1,800W, Expandable",
    "badge": "Top Pick for Most Homes",
    "amazonUrl": "",
    "pros": [
      "1,024Wh of LiFePO4 storage rated for about 3,000 cycles to 80 percent capacity",
      "1,800W continuous output runs a full-size refrigerator, microwave or coffee maker",
      "Fast AC recharge with no external brick",
      "Expandable with an extra battery for roughly double or triple the capacity",
      "Six standard AC outlets plus USB-C and car port"
    ],
    "cons": [
      "About 27 pounds, heavier than it looks",
      "Fan noise during fast charging",
      "X-Boost mode lowers voltage rather than truly powering bigger loads"
    ],
    "bottomLine": "The best balance of capacity, output, charge speed and price for outage backup in a typical home.",
    "description": "The DELTA 2 sits in the class that makes the most sense for outage backup: around a kilowatt-hour of storage, enough output to start a refrigerator, and an AC charger built in. EcoFlow rates it at 1,024 watt-hours of LiFePO4 capacity, 1,800 watts continuous, and roughly 3,000 cycles before capacity falls to 80 percent, which works out to years of regular use. A modern refrigerator averaging around 100 watts runs for most of a day on it, and a CPAP without the heated humidifier can run for several nights. It refills from a wall outlet quickly, typically reaching 80 percent in under an hour, and accepts solar input for longer outages. The expansion port lets you add an extra battery later instead of buying a second station. Owners commonly mention the fan during fast charging and that the 27-pound weight makes it more home appliance than backpack gear. Expect roughly $450 to $650 at the time of writing."
  },
  {
    "id": "jackery-explorer-1000-v2",
    "name": "Jackery Explorer 1000 v2 Portable Power Station",
    "category": "1kWh LFP, 1,500W, Light",
    "badge": "Easiest to Live With",
    "amazonUrl": "",
    "pros": [
      "1,070Wh LiFePO4 battery in a roughly 24-pound case",
      "1,500W continuous and 3,000W surge for compressor starts",
      "App-enabled emergency fast charge to full in about an hour",
      "Simple, well-labeled front panel that anyone in the house can use",
      "Five-year warranty"
    ],
    "cons": [
      "Not expandable",
      "Fewer AC outlets than some rivals",
      "Lower continuous output than the DELTA 2 and Anker C1000"
    ],
    "bottomLine": "A lighter, simpler 1kWh station for households that want something grab-and-go without expansion.",
    "description": "The Explorer 1000 v2 is the station to buy if you want a kilowatt-hour of LiFePO4 storage that a non-technical family member can carry and operate. Jackery rates it at 1,070 watt-hours, 1,500 watts continuous and 3,000 watts surge, which covers a refrigerator, lights, a modem and phones, or a microwave on its own. It weighs about 24 pounds, a few less than most 1kWh competitors, and the front panel is laid out plainly. The app unlocks an emergency fast-charge mode that refills it in about an hour from a wall outlet, though slower charging is easier on the battery for routine use. Solar input pairs with Jackery's folding panels. What you give up is growth: there is no expansion battery port, so if your needs outgrow it, you are buying a second station. The five-year warranty is a meaningful plus. Expect roughly $400 to $600 at the time of writing, and it is frequently discounted."
  },
  {
    "id": "anker-solix-c1000",
    "name": "Anker SOLIX C1000 Portable Power Station",
    "category": "1kWh LFP, 1,800W, Rapid Recharge",
    "badge": "Fastest Refill",
    "amazonUrl": "",
    "pros": [
      "1,056Wh LiFePO4 and 1,800W continuous output",
      "Full recharge from a wall outlet in under an hour in UltraFast mode",
      "Very short switchover in UPS mode for a desktop or modem",
      "Expansion battery available",
      "Built-in light bar for outages"
    ],
    "cons": [
      "Around 27 to 28 pounds",
      "UPS switchover is fast but not suited to everything a true online UPS protects"
    ],
    "bottomLine": "The pick when you want the battery refilled during the short windows the grid or a generator is on.",
    "description": "The SOLIX C1000 competes directly with the DELTA 2 and wins on one specification that matters in intermittent outages: charge speed. Anker rates it at 1,056 watt-hours of LiFePO4 capacity and 1,800 watts continuous, and in its UltraFast mode it refills from a wall outlet in under an hour. That is valuable in rolling blackouts or when you run a gas generator for an hour at a time, because a quick refill makes each hour of engine time count. It also works as an uninterruptible power supply, switching to battery in milliseconds, which keeps a modem, router or desktop running through brief flickers. An expansion battery is available, and the integrated light bar is a small touch owners appreciate during outages. Weight is similar to other 1kWh LFP units at around 27 to 28 pounds. Expect roughly $450 to $650 at the time of writing."
  },
  {
    "id": "bluetti-ac200l",
    "name": "Bluetti AC200L Expandable Power Station",
    "category": "2kWh LFP, 2,400W, Expandable",
    "badge": "Most Capacity for the Money",
    "amazonUrl": "",
    "pros": [
      "2,048Wh LiFePO4 base capacity",
      "2,400W continuous output",
      "Expandable with Bluetti add-on batteries for multi-day outages",
      "Generous outlet panel including a 30A RV outlet",
      "Can run a fridge, freezer and internet together for a day or more"
    ],
    "cons": [
      "Over 60 pounds; it does not travel far",
      "Slower to recharge fully than the 1kWh class because there is twice as much battery to fill"
    ],
    "bottomLine": "The right size for outage households that want a full day of essentials or more without a generator.",
    "description": "Double the battery of the 1kWh class changes what a power station can do in an outage, and the AC200L is one of the better-value ways to get there. Bluetti rates it at 2,048 watt-hours of LiFePO4 storage and 2,400 watts continuous output, with expansion batteries that let you build out to several times the base capacity. In practice, that is a refrigerator, a chest freezer, a modem and lights through a full day, or a CPAP for a week of nights. The outlet panel is broad, including a 30A RV-style outlet. The trade-off is mass: at over 60 pounds it is a move-once appliance, not a camp chair companion, and filling twice the battery naturally takes longer from solar. For outage use where you want silence through the night and a refill from solar or a generator by day, this class is the sweet spot. Expect roughly $900 to $1,400 at the time of writing."
  },
  {
    "id": "goal-zero-yeti-1500x",
    "name": "Goal Zero Yeti 1500X Lithium Power Station",
    "category": "1.5kWh NMC, 2,000W, Rugged",
    "badge": "Rugged Off-Grid Workhorse",
    "amazonUrl": "",
    "pros": [
      "1,516Wh capacity with 2,000W continuous output",
      "Tough steel and plastic construction with a long track record in the field",
      "Large ecosystem of panels, links and home integration kits",
      "Charge controller handles high solar input"
    ],
    "cons": [
      "NMC chemistry has a shorter rated cycle life than LiFePO4",
      "Expensive per watt-hour at full price",
      "About 45 pounds"
    ],
    "bottomLine": "Worth it for off-grid and rugged use when it is discounted; otherwise LiFePO4 rivals give more for the money.",
    "description": "Goal Zero has been building portable power longer than most of the brands on this list, and the Yeti 1500X reflects that in its build and accessory ecosystem. It is rated at 1,516 watt-hours with 2,000 watts of continuous output and handles strong solar input through its built-in charge controller. The battery is lithium NMC rather than LiFePO4, which keeps weight down for the capacity but carries a shorter rated cycle life, roughly in the hundreds of full cycles rather than thousands. For a cabin, overlanding rig or home kit that sees occasional deep cycles, that is fine; for daily cycling, an LFP unit lasts longer. The real argument for it is ruggedness and the panel, link and home-integration accessories. At full list price it is expensive per watt-hour, so watch for sales. Expect roughly $1,300 to $2,000 at the time of writing, depending on bundles and discounts."
  },
  {
    "id": "ecoflow-river-3",
    "name": "EcoFlow RIVER 3 Compact Power Station",
    "category": "245Wh LFP, 300W, Compact",
    "badge": "Best Small Kit Battery",
    "amazonUrl": "",
    "pros": [
      "245Wh LiFePO4 in a body under 8 pounds",
      "Near-silent operation for bedside use",
      "Quick switchover for a modem or small UPS role",
      "Inexpensive way to keep phones, lights and Wi-Fi going"
    ],
    "cons": [
      "300W continuous output will not start a refrigerator",
      "Small capacity; think hours, not days"
    ],
    "bottomLine": "A smart first purchase for apartments and short outages: phones, lights, router, fans.",
    "description": "The RIVER 3 is the small end of the market done well. EcoFlow rates it at 245 watt-hours of LiFePO4 storage and 300 watts continuous output, with a boost mode that lets some higher-wattage resistive devices run at reduced power. At under 8 pounds it lives easily in a closet or go-bag. That capacity runs a modem and router for many hours, recharges several phones and a laptop, powers LED lights and a small fan overnight, or keeps a CPAP without humidifier going for a night or two depending on pressure settings. It will not run a refrigerator, a space heater or a microwave, and its makers do not pretend otherwise. As a UPS for a home office network or a first outage purchase in an apartment, it is excellent value. Many owners use it alongside a larger station or generator rather than instead of one. Expect roughly $170 to $250 at the time of writing."
  },
  {
    "id": "bluetti-eb3a",
    "name": "Bluetti EB3A Portable Power Station",
    "category": "268Wh LFP, 600W, Ultraportable",
    "badge": "Best Under $300",
    "amazonUrl": "",
    "pros": [
      "268Wh LiFePO4 and 600W continuous output",
      "About 10 pounds",
      "Fast AC charging with turbo mode",
      "Runs small appliances the RIVER 3 cannot"
    ],
    "cons": [
      "Still far too small for a refrigerator overnight",
      "Fan can be noticeable when charging fast"
    ],
    "bottomLine": "The small station to buy when you want a bit more output than the RIVER 3 for small appliances.",
    "description": "The EB3A is the step up for buyers who want a small station that can do slightly more than charge devices. Bluetti rates it at 268 watt-hours of LiFePO4 and 600 watts continuous, with a power-lifting mode that lets higher-wattage resistive loads like a kettle run at reduced output. At about 10 pounds it is still easy to carry, and its AC charging is quick for its size. Six hundred watts means it can run a small blender, a box fan, a TV and router together, or a CPAP through a night with room to spare. It is still a small battery, though, and a refrigerator would drain it in a few hours. Owners commonly use it for camping, tailgating and as a backup for the home network. Expect roughly $200 to $300 at the time of writing, and it is often bundled with a small folding solar panel."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Power Stations",
          item: "https://www.allmetalbrake.com/best-portable-power-station/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Roughly how long does a 1,000Wh station keep a fridge cold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most modern full-size refrigerators average 60 to 150 watts over a day because the compressor cycles. After inverter losses, a 1,000Wh station typically runs one for roughly 6 to 14 hours. Older, larger or garage fridges use more. Keep the door closed and consider powering the fridge in blocks of an hour or two to stretch the battery across a longer outage."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a portable power station indoors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Power stations have no engine and produce no exhaust, so there is no carbon monoxide risk, which is their main advantage over generators. Keep them on a hard surface with vents clear, away from heat, water and flammable materials, and do not cover them while charging or running. Any fuel-powered generator used to recharge one must stay outdoors."
          }
        },
        {
          "@type": "Question",
          "name": "Will a power station run a CPAP all night?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually, yes. Most CPAPs draw 30 to 60 watts without the heated humidifier, so even a 250Wh station can cover a night, and a 1,000Wh unit can cover several. Heated humidification and high pressure settings raise draw substantially. A manufacturer DC cable avoids inverter losses. Confirm your machine's actual draw with your equipment supplier."
          }
        },
        {
          "@type": "Question",
          "name": "Does LiFePO4 justify a higher price?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For home backup, yes. LiFePO4 stations are typically rated for 3,000 or more cycles before dropping to 70 to 80 percent capacity, several times the life of older NMC batteries, and the chemistry is more thermally stable. The extra weight matters for backpacking but not for a unit that lives in your house. The price gap has largely closed anyway."
          }
        },
        {
          "@type": "Question",
          "name": "Can a power station power my whole house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not a portable one. Even large expandable systems in the 3 to 6 kWh range cover essentials for a day or two, not central air, electric heat or an electric range. Whole-house battery backup means a permanently installed home battery system with professional installation. For whole-house coverage at lower cost, a standby or large portable generator is still the usual answer."
          }
        },
        {
          "@type": "Question",
          "name": "How many solar panels do I need to recharge a power station?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plan on real output of about half the panel rating in decent sun. A 1,000Wh station refilled in one day needs roughly 200 to 400 watts of panels in summer and more in winter. Stay within the station's solar input voltage and wattage limits, which are listed on its spec sheet, and wire panels accordingly."
          }
        },
        {
          "@type": "Question",
          "name": "What is the right way to keep a station between outages?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Store it indoors at moderate temperature with the battery around 50 to 80 percent, and check and top it up every three months or so. Avoid hot garages and car trunks. Before storm season or a forecast outage, charge it to full. Some models support staying plugged in as a UPS; follow the manufacturer's guidance on continuous charging."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "best portable power station",
      "battery power station",
      "lifepo4 power station",
      "solar generator",
      "power station runtime",
      "cpap battery backup"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Portable Power Stations</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Silent, fume-free battery power for the fridge, the CPAP and the Wi-Fi. Here is which capacity class fits your outage, and which seven units earn the money.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#ecoflow-delta-2"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="14.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Seven Picks</a>
          <a href="#wh-and-w" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Capacity vs Output</a>
          <a href="#chemistry" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Battery Chemistry</a>
          <a href="#runtime" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Runtime Math</a>
          <a href="#charging" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Charging Options</a>
          <a href="#outage-use" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Using One in an Outage</a>
          <a href="#features" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Features Worth Paying For</a>
          <a href="#vs-generator" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Station or Generator?</a>
          <a href="#care" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Safety, Storage and Lifespan</a>
          <a href="#size-guide" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Which Size to Buy</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A portable power station is a battery, an inverter and a charger in one box. It cannot make energy, only store it, so the buying question is never just which brand; it is how many watt-hours your loads use in a day and how you will refill them when the grid is down.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Seven Power Stations Worth Buying
          </h2>

          <p>
            These rankings draw on published specifications (capacity, continuous and surge output, battery chemistry and rated cycle life, charge speeds), warranty length, safety listings, and recurring themes in owner feedback. We did not put these units through a test program of our own. Each one is ranked for the job it does best rather than for the biggest number on its spec sheet.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
