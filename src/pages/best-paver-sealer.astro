const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 6 Best Paver Sealers: Picked by Finish and Paver Type";
const description =
  "Six paver sealers matched to the finish you want and the paver you have, plus how to prep, apply, and reseal a patio so the coat lasts years, not one season.";

