---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/concrete-floor-paint-vs-epoxy.html?raw';

const title = "Concrete Floor Paint vs Epoxy: Which Should You Use?";
const description = "Floor paint is cheap, breathable and easy to recoat; two-part epoxy is far thicker and tougher but traps moisture. Costs, lifespans and which to use where.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
