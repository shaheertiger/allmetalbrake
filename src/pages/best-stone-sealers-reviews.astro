---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/best-stone-sealers-reviews.html?raw';

const title = "Best Natural Stone Sealers 2026 — Limestone, Slate, Sandstone & Flagstone Tested | Home Fix Reviews";
const description = "A sealer that works superbly on granite can be pointless on limestone. We tested eight stone sealers over 18 months across limestone, travertine, slate, sandstone and flagstone, indoors and out, for absorption, oil staining and freeze-thaw.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
