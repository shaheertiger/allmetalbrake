const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Portable EV Charger",
          item: "https://www.allmetalbrake.com/best-portable-ev-charger/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best portable EV charger?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For Tesla owners, the Tesla Mobile Connector, thanks to its swappable adapters and travel flexibility. For J1772 cars, the Lectron 32A Portable Level 2 EV Charger is a straightforward choice for any correctly installed NEMA 14-50, with the MUSTART 32A as a budget alternative. For a charger that stays in the garage, the Grizzl-E Classic or ChargePoint Home Flex."
          }
        },
        {
          "@type": "Question",
          "name": "How fast does a portable Level 2 charger charge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 32-amp Level 2 charger delivers about 7.7 kilowatts, which typically adds somewhere around 20 to 30 miles of range per hour depending on the car's efficiency. Your car's onboard charger may cap the rate lower. Level 1 at 12 amps on a household outlet usually adds about 3 to 5 miles per hour, which can still cover a short daily commute overnight."
          }
        },
        {
          "@type": "Question",
          "name": "Can I plug an EV charger into a NEMA 14-50 outlet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, that is what most portable Level 2 chargers are designed for. The 14-50 should be on a dedicated circuit installed by a licensed electrician, ideally with a heavy-duty receptacle, and any required permit and GFCI protection. A 32-amp charger is safe on a 14-50 with a 40 or 50-amp breaker; a 40-amp charger needs the 50-amp breaker."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a 14-50 and a 6-50 for EV charging?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both are 240-volt, 50-amp receptacles. The 14-50 has four prongs including a neutral; the 6-50 has three, with no neutral. EV chargers do not use the neutral, so either works if the charger has the matching plug. The 14-50 is more common and matches RV park pedestals, which makes it the better choice for a portable cord."
          }
        },
        {
          "@type": "Question",
          "name": "Can I charge an EV from a dryer outlet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Possibly, at reduced current. A 30-amp dryer circuit allows 24 amps of continuous charging. Use only the charger maker's own adapter for that receptacle, which tells the charger to limit itself, never a homemade adapter, and never run the dryer and the car at the same time. A dedicated circuit installed by an electrician is the better long-term answer."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a J1772 or NACS charger?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Match the port on your car. Most non-Tesla EVs built before the industry's switch use J1772, while Teslas and a growing number of newer models from other makers use NACS. Adapters work in both directions for AC charging, but use a listed adapter rated for at least the charger's current, and follow your automaker's guidance on which adapters it supports."
          }
        },
        {
          "@type": "Question",
          "name": "Can a portable power station charge an electric car?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not meaningfully. A large station holds 1 to 3 kilowatt-hours, while an EV battery holds roughly 50 to 100 or more, so a full station adds only a handful of miles. Many stations cannot sustain Level 1 charging, and some chargers refuse to start on them. Charge the car before a forecast storm and use public chargers during long outages."
