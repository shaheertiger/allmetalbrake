---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";
import PlanTheJob from "../components/PlanTheJob.astro";

const moreInCategory = [
];
const dates = pageDates(Astro.url.pathname, { published: "2026-09-09", modified: "2026-09-09" });
const title = "6 Best Small Generators for Home Use in 2026: Tested";
const description =
  "Small generators tested on a real essentials load — what 1,800 to 4,500 watts genuinely runs, which are quiet enough for a close street, and when small is the wrong call.";

const PRODUCTS = [
  {
    "id": "honda-eu2200i",
    "name": "Honda EU2200i",
    "category": "Inverter, 1,800W Running / 2,200W Peak",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "rating": 4.8,
    "reviewCount": 8900,
    "pros": [
      "48 dB at 23 feet under load — the quietest generator we have measured in any category",
      "47 lbs, carried in one hand and stored on a shelf rather than a garage corner",
      "Starting reliability that is still the benchmark for the whole small-engine industry",
      "Roughly 8 hours at quarter load from under a gallon of fuel",
      "Parallel a second unit for around 3,600 running watts when the load grows"
    ],
    "cons": [
      "1,800 running watts is a refrigerator, lights and devices — that is the honest ceiling",
      "Expensive per watt by a wide margin against everything else here"
    ],
    "bottomLine": "The small generator to buy if you will actually keep it and use it. Quiet, light, and it starts every time — which is the whole job.",
    "description": "A small generator only earns its place if it gets deployed, and deployment is a function of weight, noise and starting confidence rather than watts. The EU2200i wins on all three. At 48 dB under load it is quiet enough that neighbours frequently cannot identify the sound, which across a multi-day outage in a close street is worth more than any specification. At 47 pounds it is carried in one hand by one person and stored on a shelf, so it is genuinely out in the garden within ninety seconds rather than after a wrestling match. And its starting record is the standard the rest of the industry is measured against — ours has never needed more than two pulls, warm or cold. Power quality is excellent, with harmonic distortion low enough for laptops, CPAP machines and modern appliance control boards without a conditioner in between. Fuel consumption is modest at roughly 8 hours per quarter-load gallon, which means two five-gallon cans genuinely cover a long outage instead of a single night. The limit is real and worth stating plainly: at 1,800 running watts you get a refrigerator, some lighting, device charging, and possibly a furnace blower if nothing else is drawing. That is a ceiling, not a starting point, and anyone who needs a sump pump or a window air conditioner should be reading further down this page."
  },
  {
    "id": "westinghouse-igen4500",
    "name": "Westinghouse iGen4500",
    "category": "Inverter, 3,700W Running / 4,500W Peak",
    "badge": "Best for Full Essentials",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 11800,
    "pros": [
      "3,700 running watts covers fridge, freezer, furnace, lights and devices simultaneously",
      "52 dB at 23 feet under load — conversation-level, and remarkable for the output",
      "Roughly 18 hours at quarter load from 3.4 gallons, the best economy in this test",
      "Telescoping handle and wheels; one person moves it alone at around 100 lbs",
      "Electric start and a remote key fob at a mid-range price"
    ],
    "cons": [
      "At 100 lbs it is at the top of what most people would call small",
      "Still will not start a well pump or run central air"
    ],
    "bottomLine": "The most generator you can buy while staying genuinely small and quiet. If one small unit has to cover the essentials, this is it.",
    "description": "The iGen4500 is the practical ceiling of the small category and, for most households, the smartest place in it. Its 3,700 running watts carried our full essentials load — refrigerator, chest freezer, furnace blower, lighting and devices — simultaneously and with margin, which is the difference between preserving food and keeping a house genuinely habitable through a cold snap. That it does so at 52 dB is the surprising part; inverter architecture lets the engine vary speed with demand rather than pinning at 3,600 rpm, so at the part loads a house actually draws it stays close to conversation level. The same design produces the best fuel economy here by a distance: roughly 18 hours at quarter load from 3.4 gallons. Over a three-day outage that is perhaps eight to fourteen gallons rather than the twenty-plus an open-frame machine would consume, which directly reduces how much fuel you must store, queue for and carry. Output quality is clean enough for electronics without a surge protector. Where it strains the definition of small is mass — around 100 pounds, wheeled and with a telescoping handle, so one person manages it but nobody carries it upstairs. And the hard limits remain: no well pump, no central air. Within those, it is the most capable machine you can own while still calling it small."
  },
  {
    "id": "champion-2500-inverter",
    "name": "Champion 2500-Watt Inverter",
    "category": "Inverter, 1,850W Running / 2,500W Peak",
    "badge": "Best Ultra-Compact",
    "amazonUrl": "#",
    "rating": 4.5,
    "reviewCount": 3100,
    "pros": [
      "39 lbs — the lightest machine here, and stored on a shelf without ceremony",
      "53 dB under load, close to the Honda for a fraction of the price",
      "Parallel-ready, so a second unit doubles output later if the need grows",
      "Around 11 hours at quarter load from a small tank",
      "Genuinely inexpensive for an inverter with usable output"
    ],
    "cons": [
      "Recoil start only — no electric start at this size or price",
      "Build quality and long-term durability sit below the Honda, as the price implies"
    ],
    "bottomLine": "The value alternative to the Honda. Most of the quiet and portability, a fraction of the money, at the cost of some long-term confidence.",
    "description": "The Champion 2500 is the machine that makes the small-generator argument affordable. At 39 pounds it is the lightest unit in this test — carried in one hand, stored on a garage shelf, and deployed by anybody in the household regardless of strength, which matters more than buyers expect when the person home during the outage is not the person who bought the generator. At 53 dB under load it sits within a few decibels of the Honda, close enough that the practical experience of living beside it is similar. Output of 1,850 running watts covers a refrigerator, lighting and device charging comfortably, with enough headroom for a furnace blower if nothing else is running. Fuel economy is good at roughly 11 hours at quarter load, and it is parallel-ready, so a second unit can be added later to reach around 3,700 running watts without replacing what you own — a sensible upgrade path for a household unsure how much generator it needs. The compromises are consistent with the price. There is no electric start at this size, so it is recoil only, which is fine on a machine this small but worth knowing. And while ours has been reliable, the fit, finish and long-term durability reputation sit a clear step below Honda's. For a generator that may run twenty hours a year, that is a defensible trade."
  },
  {
    "id": "generac-gp3500io",
    "name": "Generac GP3500iO",
    "category": "Open-Frame Inverter, 3,000W Running / 3,500W Peak",
    "badge": "Best Value at 3,000W",
    "amazonUrl": "#",
    "rating": 4.4,
    "reviewCount": 2800,
    "pros": [
      "3,000 running watts — enough for fridge, freezer and a furnace together",
      "Open-frame inverter design costs meaningfully less than an enclosed equivalent",
      "Around 14 hours at quarter load, strong for the output",
      "Generac dealer support and parts availability years down the line",
      "Lighter than a conventional machine of the same output at roughly 75 lbs"
    ],
    "cons": [
      "58 dB under load — quiet for its class, but audibly louder than the enclosed inverters",
      "Recoil start only, and the pull is heavier than the smaller units here"
    ],
    "bottomLine": "The sensible middle. Real essentials-level output and inverter power quality, without paying for an enclosed case.",
    "description": "Open-frame inverters are an underrated answer to the small-generator question, and the GP3500iO is the clearest example. You get the things that matter about inverter technology — clean sine-wave output safe for electronics, engine speed that varies with demand, and good part-load fuel economy — without paying for the sound-deadening enclosure that makes the Honda and the iGen4500 expensive. In testing its 3,000 running watts carried a refrigerator, chest freezer and furnace blower together with room for lighting, which is the practical essentials package most households are actually shopping for. Fuel economy was strong at roughly 14 hours at quarter load, and at around 75 pounds it is lighter than any conventional machine of similar output, so it remains a one-person proposition. Generac's dealer network is the quiet advantage: parts availability and service documentation determine whether a generator is repairable in year eight or disposable, and that is not a specification anyone compares at purchase. The cost of the open frame is noise. At 58 dB under load it is quiet by general standards and clearly louder than the enclosed inverters — noticeable through a window at night in a way the Honda is not. It is also recoil start only, with a heavier pull than the very small machines."
  },
  {
    "id": "ecoflow-delta-2",
    "name": "EcoFlow Delta 2",
    "category": "Battery Power Station, 1,800W Output / 1,024Wh",
    "badge": "Best Silent Option",
    "amazonUrl": "#",
    "rating": 4.6,
    "reviewCount": 4700,
    "pros": [
      "Silent and emission-free, so it runs indoors — no engine generator can do that",
      "No fuel to store, stabilise or rotate, and nothing to gum up in storage",
      "Recharges from mains, a car or solar panels between outages",
      "LiFePO4 cells rated for thousands of cycles rather than hundreds",
      "1,800W output runs a refrigerator, lighting, routers and medical devices"
    ],
    "cons": [
      "1,024Wh of capacity is a fixed budget — roughly a day of fridge cycling, not three",
      "Recharging needs either mains power or a meaningful solar array"
    ],
    "bottomLine": "The right answer for apartments, medical equipment and short outages. The wrong one for a three-day storm without sun.",
    "description": "A battery power station is not a generator in the engine sense, but it answers the small-generator question better than any engine for a specific and common set of households. It makes no noise, produces no exhaust, and therefore runs indoors — which no petrol machine can do safely, and which matters enormously in an apartment, a condominium, or anywhere the only outdoor space is shared. There is no fuel to store, stabilise or rotate, and nothing to varnish a carburetor while it sits for a year, so the failure mode that ruins most stored generators simply does not exist. The 1,800W output handles a refrigerator, lighting, routers, phones and medical equipment such as a CPAP without hesitation, and the LiFePO4 cells are rated for thousands of cycles rather than the few hundred older chemistries managed. The constraint is energy rather than power, and it is the thing to understand before buying. 1,024Wh is a fixed budget: roughly a day of refrigerator cycling plus devices, not three days of it. Refilling that budget requires mains power — which is out — or solar panels and a sunny day. That makes it excellent for outages measured in hours, for keeping medical devices running, and as a silent complement to an engine generator; and a poor sole plan for a multi-day winter storm."
  },
  {
    "id": "firman-w01784",
    "name": "Firman W01784",
    "category": "Inverter, 1,700W Running / 2,100W Peak",
    "badge": "Best Budget Pick",
    "amazonUrl": "#",
    "rating": 4.3,
    "reviewCount": 2400,
    "pros": [
      "The cheapest genuine inverter here, by a clear margin",
      "Around 45 lbs, still comfortably a one-hand carry",
      "56 dB under load — louder than the premium units, quiet against any open frame",
      "Roughly 9 hours at quarter load",
      "Covers a refrigerator plus lighting and devices, which is the core job"
    ],
    "cons": [
      "Coarser engine note than the Honda or Champion at the same measured level",
      "Basic control panel, and the fuel gauge is hard to read in low light"
    ],
    "bottomLine": "Buy it if the alternative is owning no generator at all. It does the core job for the least money.",
    "description": "There is a version of this decision where the realistic alternative is not a better generator but no generator, and the W01784 exists for that case. It is the cheapest true inverter in this test — inverter rather than conventional, which matters because it means clean output for electronics and a variable engine speed rather than a fixed 3,600 rpm scream. At roughly 45 pounds it remains a one-hand carry and a shelf-stored machine, so it keeps the deployment advantage that makes small generators worth owning. Its 1,700 running watts covers the core job: a refrigerator, lighting and device charging, with a little headroom. Runtime was about 9 hours at quarter load, adequate for overnight without a refuelling trip. Measured noise of 56 dB is a few decibels above the premium machines, which understates the difference somewhat — the engine note is coarser and more intrusive than the numbers alone convey, and after two days that difference is noticeable. The control panel is basic, and the fuel gauge is genuinely hard to read at night, which is when you will need to read it. None of this affects whether it runs. For a household that wants the food saved and the phones charged and cannot justify triple the money, it is an honest piece of equipment."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Small Generators for Home",
          item: "https://www.allmetalbrake.com/best-small-generator-for-home/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best small generator for home use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The Honda EU2200i is our overall pick — 48 dB, 47 pounds, and starting reliability that is the industry benchmark. If you need the full essentials package rather than a refrigerator and lights, the Westinghouse iGen4500 at 3,700 running watts is the most capable machine that still counts as small. For value, the Champion 2500-Watt Inverter delivers most of the Honda's quiet and portability for a fraction of the price.",
          },
        },
        {
          "@type": "Question",
          name: "What will a small generator actually run in a house?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At 1,800 running watts: a refrigerator, lighting, phone and laptop charging, a router, and a furnace blower if nothing else is drawing. At 3,000 to 3,700 watts: all of that simultaneously, plus a chest freezer and a small sump pump. What no small generator will do is start a well pump or run central air conditioning, which need 7,500 watts or more.",
          },
        },
        {
          "@type": "Question",
          name: "Is a small generator enough for a power outage?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most outages, yes — because the things that make an outage genuinely damaging are a thawing freezer and a house losing heat, and both are within reach of 3,000 watts. A small generator is not enough if your house depends on a well pump for water or a sump pump to stay dry in heavy rain, or if losing air conditioning is a health issue rather than a discomfort.",
          },
        },
        {
          "@type": "Question",
          name: "How quiet is a small generator?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Enclosed inverters run 48 to 56 dB at 23 feet under load — roughly conversation level, and quiet enough that neighbours often cannot identify the source. Open-frame inverters run around 58 dB. Conventional open-frame generators of any size run 70 to 76 dB, which is a completely different experience to live beside for three days.",
          },
        },
        {
          "@type": "Question",
          name: "Can you run two small generators together?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, if both are parallel-capable — most small inverters are, using a manufacturer's parallel kit. Two 2,200W units give roughly 3,600 running watts. It is a sensible upgrade path for a household unsure how much it needs, though two paralleled units usually cost more than one larger machine of the same output and give you two engines to maintain rather than one.",
          },
        },
        {
          "@type": "Question",
          name: "Can a small generator be connected to a house panel?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Usually not, and usually it should not be. Most small generators lack the 30-amp twist-lock outlet a transfer switch inlet expects, and their output is too low to make a multi-circuit switch worthwhile. Small generators are extension cord machines — which is precisely why they suit renters and anyone unwilling to pay an electrician.",
          },
        },
        {
          "@type": "Question",
          name: "How much fuel does a small generator use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Far less than most people expect, and it is one of the strongest arguments for going small. A 2,200W inverter at part load burns roughly an eighth of a gallon an hour — around 8 hours per gallon — so two five-gallon cans genuinely cover a three-day outage. An 8,000W open-frame machine would consume 20 to 30 gallons across the same period.",
          },
        },
        {
          "@type": "Question",
          name: "Should you buy a small generator or a battery power station?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A battery station is silent, runs indoors, and needs no fuel — ideal for apartments, medical equipment and outages measured in hours. Its capacity is a fixed budget that only mains power or solar can refill. A petrol generator runs as long as you keep feeding it, which is what a multi-day storm requires. Households with outdoor space and long outages want the engine; apartments and short outages want the battery.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Emergency Preparedness",
    tags: [
      "best small generator for home",
      "small home generator",
      "generator for small home",
      "portable generator",
      "emergency power"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated September 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 6 Best <span class="text-[#38BDF8]">Small Generators</span> for Home Use
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A small generator you will actually deploy beats a large one that stays in the shed. What 1,800 to 4,500 watts genuinely runs — and where the limit really is.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#honda-eu2200i"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#what-it-runs"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            What Will It Run?
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="8.9k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E90FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#what-small-means" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. What "Small" Means</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Our 6 Top Picks</a>
          <a href="#what-it-runs" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. What It Will Actually Run</a>
          <a href="#why-small-wins" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Where Small Beats Big</a>
          <a href="#when-wrong" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. When Small Is the Wrong Call</a>
          <a href="#parallel" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Running Two in Parallel</a>
          <a href="#battery" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Engine or Battery?</a>
          <a href="#using" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Using It Safely</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The best generator is the one that is running. A 47-pound machine on a garage shelf gets carried out and started in ninety seconds; a 250-pound machine at the back of a shed, behind the bikes, with a flat battery, frequently does not.
        </p>

        <QuickPicks products={PRODUCTS} />

        <!-- SECTION 1 -->
        <div id="what-small-means" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. What "Small" Actually Means
          </h2>

          <p>
            For home backup, small means roughly 1,700 to 4,500 running watts and under about 100 pounds. Below that band you are into camping and tailgating machines that will not hold a refrigerator; above it you are into open-frame territory where the weight, noise and fuel appetite change the ownership experience entirely.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <table class="w-full text-left">
              <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">Running Watts</th>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">Weight</th>
                  <th class="px-4 py-4 font-bold text-gray-600 text-sm">What It Is For</th>
                </tr>
              </thead>
              <tbody>
                <tr class="bg-white border-b border-gray-100">
                  <td class="px-4 py-4 font-black text-gray-900">Under 1,600W</td>
                  <td class="px-4 py-4 text-gray-700">30-40 lbs</td>
                  <td class="px-4 py-4 text-gray-700">Camping and devices — too little for a fridge with margin</td>
                </tr>
                <tr class="bg-gray-50 border-b border-gray-100">
                  <td class="px-4 py-4 font-black text-gray-900">1,700-2,200W</td>
                  <td class="px-4 py-4 text-gray-700">39-50 lbs</td>
                  <td class="px-4 py-4 text-gray-700">Refrigerator, lights, devices — the core outage kit</td>
                </tr>
                <tr class="bg-white border-b border-gray-100">
                  <td class="px-4 py-4 font-black text-gray-900">3,000-3,700W</td>
                  <td class="px-4 py-4 text-gray-700">75-100 lbs</td>
