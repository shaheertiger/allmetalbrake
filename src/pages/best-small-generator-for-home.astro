  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Small Home Generators",
          item: "https://www.allmetalbrake.com/best-small-generator-for-home/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Can a 2,000-watt generator run a refrigerator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. A modern refrigerator runs on roughly 100 to 200 watts and needs about 1,000 to 2,000 watts for a moment to start its compressor, which a 2,000-watt class inverter handles. You can usually add lights, the internet and phone charging. Adding a freezer or microwave at the same time pushes it too far, so stagger those loads."
          }
        },
        {
          "@type": "Question",
          "name": "How many watts does a small house need in an outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For essentials in a home with gas heat, refrigerator, freezer, furnace blower, lights and internet, roughly 2,500 to 4,000 running watts is usually enough. Add a sump pump and you want the upper end of that range. A 240-volt well pump, central air or electric heat require a larger generator. Check appliance labels for real numbers."
          }
        },
        {
          "@type": "Question",
          "name": "Are small inverter generators safe for computers and TVs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Inverter generators produce clean output with low harmonic distortion, which suits laptops, TVs, routers and modern furnace control boards. Conventional open-frame generators can produce rougher power. Even with an inverter, a quality surge protector is sensible, and switching sensitive electronics off before starting or stopping the generator is a good habit."
          }
        },
        {
          "@type": "Question",
          "name": "How quiet are small generators really?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Quiet inverters in the 2,000-watt class are commonly rated in the low to high 50s dBA at about 23 feet at light load, about the level of normal conversation. Large open-frame portables are often in the 70s. Load, surface, distance and reflecting walls all change what neighbors hear, so place it in the open on grass rather than between houses."
          }
        },
        {
          "@type": "Question",
          "name": "Is it worth paralleling two small generators?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can be. Two identical parallel-capable inverters give roughly double the output while keeping each unit easy to carry, and you can run just one in light outages. It costs more than one larger generator and doubles maintenance. If you know you need over 3,500 watts every time, a single larger inverter is simpler."
          }
        },
        {
          "@type": "Question",
          "name": "Can I connect a small generator to my electrical panel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only through a transfer switch or a listed panel interlock with an outdoor inlet, installed by a licensed electrician under a permit. Never plug into a wall outlet, which backfeeds the grid and endangers line workers. Many 120-volt small generators need the electrician to plan how they feed the panel, so share your model before the install."
          }
        },
        {
          "@type": "Question",
          "name": "Small gas generator or battery station: which comes first?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If your outages are short, you live in an apartment or someone uses a CPAP, start with a battery station; it runs silently indoors. If outages last more than a day, a small gas inverter supplies far more total energy for the money. Many households combine both, running the generator outdoors in short bursts to recharge the battery."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
