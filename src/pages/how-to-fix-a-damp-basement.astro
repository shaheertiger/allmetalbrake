---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/how-to-fix-a-damp-basement.html?raw';

const title = "How to Fix a Damp Basement: Step-by-Step DIY Guide";
const description = "Tell condensation from seepage with a free foil test, then fix a damp basement in order: gutters, grading, cracks, dehumidifying, insulation and sump pumps.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
