---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/how-to-stain-a-deck.html?raw';

const title = "How to Stain a Deck: Step-by-Step DIY Guide";
const description = "Stain a deck that lasts: the water-drop test, cleaning and brightening, sanding mill glaze, rails before boards, lap-free technique and cure before furniture.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
