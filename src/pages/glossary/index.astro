---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { SITE } from '../../data/site';
import { glossary } from '../../data/glossary';
import { breadcrumbs, graph } from '../../lib/schema';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Glossary', url: '/glossary/' }];
const terms = [...glossary].sort((a, b) => a.term.localeCompare(b.term));
const letter = (t: string) => (/^[a-z]/i.test(t) ? t[0].toUpperCase() : '#');
const groups = [...new Set(terms.map((t) => letter(t.term)))].map((l) => ({ l, terms: terms.filter((t) => letter(t.term) === l) }));
const schema = graph(breadcrumbs(crumbs), { '@type': 'DefinedTermSet', name: `${SITE.name} Backup Power Glossary`, url: `${SITE.url}/glossary/`, hasDefinedTerm: terms.map((t) => ({ '@type': 'DefinedTerm', name: t.term, description: t.short, url: `${SITE.url}/glossary/${t.slug}/` })) });
---
<Base title={`Backup Power Glossary: ${glossary.length} Terms in Plain English`} description={`${glossary.length} backup power terms in plain English: running vs starting watts, THD, LiFePO4, watt-hours, pass-through, transfer switches, interlocks and NEMA plugs.`} schema={schema}>
  <div class="wrap hub">
    <Crumbs items={crumbs} />
    <h1 class="hub-title">Backup Power Glossary</h1>
    <p class="hub-dek">The spec-sheet terms that actually change what you should buy, each with a worked example.</p>
    {groups.map((g) => (
      <section class="az">
        <h2>{g.l}</h2>
        <ul class="term-list">{g.terms.map((t) => <li><a href={`/glossary/${t.slug}/`}><strong>{t.term}</strong></a> <span>{t.short}</span></li>)}</ul>
      </section>
    ))}
  </div>
</Base>
