---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { SITE } from '../../data/site';
import { HUBS, NICHE } from '../../data/niche';
import { TERMS, termPath } from '../../lib/data';
const groups = [...new Set(TERMS.map((t) => (/^[a-z]/i.test(t.term) ? t.term[0].toUpperCase() : '#')))].map((l) => ({ l, terms: TERMS.filter((t) => (/^[a-z]/i.test(t.term) ? t.term[0].toUpperCase() : '#') === l) }));
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Glossary', href: '/glossary/' }];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: `${SITE.name} ${NICHE.title} Glossary`,
  url: `${SITE.url}/glossary/`,
  hasDefinedTerm: TERMS.map((t) => ({ '@type': 'DefinedTerm', name: t.term, url: `${SITE.url}${termPath(t)}` })),
};
---
<Base title={`${NICHE.title} Glossary: ${TERMS.length} Terms Explained in Plain English`} description={HUBS.glossary.description(TERMS.length)} jsonLd={jsonLd}>
  <div class="wrap hub">
    <Crumbs items={crumbs} />
    <h1 class="hub-title">{NICHE.title} Glossary</h1>
    <p class="hub-dek">{HUBS.glossary.dek}</p>
    {groups.map((g) => (
      <section class="az">
        <h2>{g.l}</h2>
        <ul class="term-list">{g.terms.map((t) => <li><a href={termPath(t)}><strong>{t.term}</strong></a> <span>{t.short}</span></li>)}</ul>
      </section>
    ))}
  </div>
</Base>
