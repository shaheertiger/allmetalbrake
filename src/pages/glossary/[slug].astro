---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { SITE } from '../../data/site';
import { glossary, type Term } from '../../data/glossary';
import { md } from '../../lib/md';
import { formatDate } from '../../lib/data';
import { breadcrumbs, graph } from '../../lib/schema';
export function getStaticPaths() { return glossary.map((t) => ({ params: { slug: t.slug }, props: { t } })); }
const { t } = Astro.props as { t: Term };
const path = `/glossary/${t.slug}/`;
const updated = '2026-11-19';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Glossary', url: '/glossary/' }, { name: t.term, url: path }];
const others = glossary.filter((x) => x.slug !== t.slug);
const short = t.term.replace(/ \(.*\)$/, '');
const schema = graph(
  { '@type': 'DefinedTerm', name: t.term, description: t.short, url: `${SITE.url}${path}`, inDefinedTermSet: { '@type': 'DefinedTermSet', name: `${SITE.name} Backup Power Glossary`, url: `${SITE.url}/glossary/` } },
  breadcrumbs(crumbs),
);
---
<Base title={`What Is ${short}? Backup Power Glossary`} description={t.short.slice(0, 158)} schema={schema}>
  <article class="article">
    <header class="col a-head">
      <Crumbs items={crumbs} />
      <div class="kicker">Backup Power Glossary</div>
      <h1 class="a-title">What Is {short}?</h1>
      <p class="dek">{t.short}</p>
      <div class="byline">By <a href="/about/">{SITE.author}</a> · Updated <time datetime={updated}>{formatDate(updated)}</time></div>
    </header>
    <div class="col body">
      <Fragment set:html={md(t.body)} />
      {t.related.length > 0 && (
        <>
          <h2 id="related">Related</h2>
          <ul class="link-list">{t.related.map((r) => <li><a href={r.url}>{r.title}</a></li>)}</ul>
        </>
      )}
      <h2 id="more">More Terms</h2>
      <p class="term-cloud">{others.map((o) => <a href={`/glossary/${o.slug}/`}>{o.term}</a>)}</p>
    </div>
  </article>
</Base>
