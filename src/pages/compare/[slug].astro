---
// Head-to-head pages: /compare/<a>-vs-<b>/, in the enthusiastreview.com comparison skeleton:
// cards → Short Answer → answer-first difference H2s → specs side by side → where they differ →
// how they score → buy A if / buy B if → FAQ → related.
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Score from '../../components/Score.astro';
import BuyButton from '../../components/BuyButton.astro';
import ProductImage from '../../components/ProductImage.astro';
import FaqList from '../../components/FaqList.astro';
import { SITE, SCORE_NAME } from '../../data/site';
import { categoryOf } from '../../data/categories';
import { compares } from '../../data/compares';
import { amazonUrl, amazonImage, AFFILIATE_REL } from '../../lib/amazon';
import { md } from '../../lib/md';
import { articleSchema, breadcrumbs, faqPage, graph, itemList } from '../../lib/schema';
import { productMap, productUrl, compareSlug, articlesForProduct, articleUrl, shortName, lc, formatDate } from '../../lib/data';
import type { Product } from '../../lib/types';

export function getStaticPaths() {
  return compares
    .filter(([a, b]) => productMap.has(a) && productMap.has(b))
    .map(([a, b]) => {
      const [x, y] = [productMap.get(a)!, productMap.get(b)!].sort((m, n) => m.slug.localeCompare(n.slug));
      return { params: { slug: compareSlug(a, b) }, props: { a: x, b: y } };
    });
}
const { a, b } = Astro.props as { a: Product; b: Product };
const path = `/compare/${compareSlug(a.slug, b.slug)}/`;
const cat = categoryOf(a.category);
const updated = '2026-11-19';
const [sa, sb] = [shortName(a.name), shortName(b.name)];
const winner = a.score === b.score ? null : a.score > b.score ? a : b;
const loser = winner ? (winner === a ? b : a) : null;
const cheaper = !a.priceTier || !b.priceTier || a.priceTier === b.priceTier ? null : a.priceTier < b.priceTier ? a : b;
const keys = [...new Set([...Object.keys(a.specs), ...Object.keys(b.specs)])];
const shared = keys.filter((k) => a.specs[k] && b.specs[k]);
const differs = shared.filter((k) => a.specs[k] !== b.specs[k]);
const sn = (p: Product) => (p === a ? sa : sb);
const quick = winner
  ? `The **${winner.name}** scores higher (${winner.score} vs ${loser!.score}/100)${cheaper && cheaper !== winner ? `, but the **${cheaper.name}** costs less (${cheaper.priceBand} vs ${(cheaper === a ? b : a).priceBand})` : cheaper === winner ? ` and also costs less (${winner.priceBand})` : ''}. Pick the ${sa} if you want ${lc(a.bestFor)}; pick the ${sb} for ${lc(b.bestFor)}.`
  : `They tie on our ${SCORE_NAME} (${a.score}/100). Choose the ${sa} for ${lc(a.bestFor)}, or the ${sb} for ${lc(b.bestFor)}.`;
// Answer-first difference H2s: the headline spec gaps, each stated as an answer.
const diffs = [
  ...(cheaper ? [{ h: `Price: the ${sn(cheaper)} usually costs less`, text: `${sa}: ${a.priceBand}. ${sb}: ${b.priceBand}. Prices move often with sales and storm season, so check the live listing.` }] : []),
  ...(winner ? [{ h: `${SCORE_NAME}: the ${sn(winner)} scores ${winner.score - loser!.score} point${winner.score - loser!.score === 1 ? '' : 's'} higher`, text: `${sa}: ${a.score}/100. ${sb}: ${b.score}/100. ${winner.summary}` }] : []),
  ...differs.slice(0, 3).map((k) => ({ h: `${k}: ${sa} ${a.specs[k]} vs ${sb} ${b.specs[k]}`, text: `The ${sa} lists ${a.specs[k]} for ${k.toLowerCase()}; the ${sb} lists ${b.specs[k]}. Both figures are from the manufacturers' spec sheets.` })),
].filter((d) => d.h.length <= 110);
const description = `${a.name} vs ${b.name} compared side by side: ${shared.slice(0, 3).map((k) => k.toLowerCase()).join(', ')}, price and our verdict. ${winner ? `${shortName(winner.name)} scores higher.` : 'They tie on score.'}`;
const desc = description.length <= 158 ? description : `${description.slice(0, description.lastIndexOf(' ', 155))}…`;
const h = `${sa} vs ${sb}`;
const title = h.length <= 34 ? `${h}: Specs, Scores & Which to Buy` : h.length <= 50 ? `${h}: Which to Buy?` : h.length <= 62 ? `${h} Compared` : h;
const faqs = [
  { q: `Which is better, the ${sa} or the ${sb}?`, a: quick },
  { q: `What is the main difference between the ${sa} and ${sb}?`, a: differs.length ? differs.slice(0, 3).map((k) => `**${k}:** ${sa} ${a.specs[k]} vs ${sb} ${b.specs[k]}.`).join(' ') : 'On paper they are very close; the real difference is current price and who each suits.' },
  { q: `Which is cheaper, the ${sa} or the ${sb}?`, a: cheaper ? `The ${sn(cheaper)} usually sells for less (${cheaper.priceBand} vs ${(cheaper === a ? b : a).priceBand}). Prices move often, so check the current price before you buy.` : 'Prices on both move often with sales and stock, so we do not quote them. Check both current prices, and compare on running watts, capacity and features first.' },
  { q: `Who should skip the ${sa}?`, a: `Skip the ${sa} if ${lc(a.skipIf)}.` },
  { q: `Who should skip the ${sb}?`, a: `Skip the ${sb} if ${lc(b.skipIf)}.` },
];
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Comparisons', url: '/compare/' }, { name: h, url: path }];
const img = amazonImage(a, 500) ?? amazonImage(b, 500) ?? undefined;
const kw = [...new Set([`${sa} vs ${sb}`, `${sb} vs ${sa}`, `${a.name} vs ${b.name}`].map((k) => k.toLowerCase()))];
const schema = graph(
  articleSchema({ title, metaDescription: desc, published: updated, updated, hub: a.category, keywords: kw }, path, img),
  itemList([a, b].map((p) => ({ name: p.name, url: productUrl(p), product: p }))),
  breadcrumbs(crumbs),
  faqPage(faqs),
);
const guides = [...new Map([...articlesForProduct(a.slug), ...articlesForProduct(b.slug)].map((x) => [x.slug, x])).values()].slice(0, 6);
const more = compares.filter(([x, y]) => [x, y].some((s) => s === a.slug || s === b.slug) && compareSlug(x, y) !== compareSlug(a.slug, b.slug)).filter(([x, y]) => productMap.has(x) && productMap.has(y)).slice(0, 6);
const scoreLabels = [...new Set([...(a.scores ?? []).map((s) => s.label), ...(b.scores ?? []).map((s) => s.label)])];
const buyIf = (p: Product) => [p.bestFor, ...p.pros.slice(0, 3)];
---
<Base title={title} description={desc} type="article" schema={schema} published={updated} updated={updated} section={cat.label} ogImage={img}>
  <article class="article">
    <header class="col a-head">
      <Crumbs items={crumbs} />
      <div class="kicker">{cat.label} · Head to head</div>
      <h1 class="a-title">{a.name} vs {b.name}</h1>
      <div class="byline">By <a href="/about/">{SITE.author}</a> · Updated <time datetime={updated}>{formatDate(updated)}</time> · Specs from the manufacturers; we have not bench-tested either. <a href="/affiliate-disclosure/">Disclosure</a></div>
    </header>

    <div class="col">
      <div class="vs-cards">
        {[a, b].map((p) => (
          <div class="vs-card">
            <ProductImage p={p} size={140} buy eager />
            <a class="vs-name" href={productUrl(p)}>{p.name}</a>
            <Score value={p.score} size="lg" />
            <span class="vs-price">{p.priceBand}</span>
            <BuyButton p={p} label="Check Price" small />
          </div>
        ))}
      </div>
    </div>

    <div class="col body">
      <h2 id="short-answer">{h}: The Short Answer</h2>
      <div class="answer-box" set:html={md(quick)} />

      {diffs.map((d, i) => (
        <>
          <h2 id={`diff-${i + 1}`}>{d.h}</h2>
          <p>{d.text}</p>
        </>
      ))}

      <h2 id="specs">Specs Side by Side</h2>
      <div class="table-wrap">
        <table class="spec-table vs">
          <thead><tr><th>Spec</th><th><a href={productUrl(a)}>{sa}</a></th><th><a href={productUrl(b)}>{sb}</a></th></tr></thead>
          <tbody>
            {keys.map((k) => <tr><th scope="row">{k}</th><td>{a.specs[k] ?? '—'}</td><td>{b.specs[k] ?? '—'}</td></tr>)}
            <tr><th scope="row">Price band</th><td>{a.priceBand}</td><td>{b.priceBand}</td></tr>
            <tr><th scope="row">{SCORE_NAME}</th><td>{a.score}/100</td><td>{b.score}/100</td></tr>
          </tbody>
        </table>
      </div>

      {differs.length > 0 && (
        <>
          <h2 id="differences">Where They Differ</h2>
          {differs.map((k) => (
            <>
              <h3>{k}</h3>
              <p>The {sa} has {a.specs[k]}; the {sb} has {b.specs[k]}.</p>
            </>
          ))}
        </>
      )}

      {scoreLabels.length > 0 && (
        <>
          <h2 id="scores">How They Score</h2>
          <div class="table-wrap">
            <table class="spec-table vs">
              <thead><tr><th>{SCORE_NAME} part</th><th>{sa}</th><th>{sb}</th></tr></thead>
              <tbody>
                {scoreLabels.map((k) => <tr><th scope="row">{k}</th><td>{a.scores?.find((s) => s.label === k)?.value ?? '—'}</td><td>{b.scores?.find((s) => s.label === k)?.value ?? '—'}</td></tr>)}
                <tr><th scope="row">Overall</th><td><strong>{a.score}</strong></td><td><strong>{b.score}</strong></td></tr>
              </tbody>
            </table>
          </div>
        </>
      )}

      <h2 id="buy-a">Buy the {sa} If…</h2>
      <ul>{buyIf(a).map((t) => <li>{t}</li>)}</ul>
      <p><BuyButton p={a} label={`Check the ${sa} on Amazon`} /></p>

      <h2 id="buy-b">Buy the {sb} If…</h2>
      <ul>{buyIf(b).map((t) => <li>{t}</li>)}</ul>
      <p><BuyButton p={b} label={`Check the ${sb} on Amazon`} /></p>

      <h2 id="faq">{h} FAQ</h2>
      <FaqList faqs={faqs} />

      <h2 id="related">Related</h2>
      <ul class="link-list">
        <li><a href={productUrl(a)}>{a.name}: full specs and score</a></li>
        <li><a href={productUrl(b)}>{b.name}: full specs and score</a></li>
        {guides.map((g) => <li><a href={articleUrl(g)}>{g.h1}</a></li>)}
        {more.map(([x, y]) => <li><a href={`/compare/${compareSlug(x, y)}/`}>{shortName(productMap.get(x)!.name)} vs {shortName(productMap.get(y)!.name)}</a></li>)}
      </ul>
    </div>

    <div class="sticky-buy sb-mobile sb-pair" aria-label="Check prices on Amazon">
      <a class="buy buy-sm" href={amazonUrl(a)} rel={AFFILIATE_REL} target="_blank">{sa}</a>
      <a class="buy buy-sm" href={amazonUrl(b)} rel={AFFILIATE_REL} target="_blank">{sb}</a>
      <button class="sb-close" type="button" aria-label="Dismiss" onclick="this.parentElement.hidden=true">×</button>
    </div>
  </article>
</Base>
