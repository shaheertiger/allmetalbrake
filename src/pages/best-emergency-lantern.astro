const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "7 Best Emergency Lanterns in 2026: Outage Lights That Last";
const description =
  "Seven emergency lanterns and lights for power outages, with lumens vs. runtime explained, rechargeable vs. AA and D cells, and how to store them so they work.";

