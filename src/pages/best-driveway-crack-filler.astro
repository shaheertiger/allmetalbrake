---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "How to Seal a Driveway",
    "url": "/how-to-seal-a-driveway/"
  },
  {
    "title": "How to Remove Moss From an Asphalt Driveway",
    "url": "/how-to-remove-moss-from-asphalt-driveway/"
  },
  {
    "title": "What Temperature to Seal a Driveway",
    "url": "/what-temperature-to-seal-driveway/"
  },
  {
    "title": "Best Driveway Paint",
    "url": "/best-driveway-paint-reviews/"
  },
  {
    "title": "How Much Does It Cost to Seal a Driveway",
    "url": "/how-much-does-it-cost-to-seal-a-driveway/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 6 Best Driveway Crack Fillers, Matched to Crack Width";
const description =
  "Six driveway crack fillers for asphalt and concrete, ranked by job, plus how to size a crack, which chemistry fits it, how much to buy and how to apply it.";

const PRODUCTS = [
  {
    "id": "crack-stix-permanent",
    "name": "Crack-Stix Permanent Blacktop Crack Filler",
    "category": "Heat-applied rope filler for asphalt",
    "badge": "Best Overall for Asphalt",
    "amazonUrl": "",
    "pros": [
      "Rubberized rope melts into a flexible seal similar to pro hot-pour",
      "Pre-sized ropes for common crack widths",
      "No mixing, no pouring, no mess in the bucket",
      "Stays flexible through freeze-thaw seasons per owner reports",
      "Can be driven on soon after it cools"
    ],
    "cons": [
      "Requires a propane torch and fire-safe handling",
      "Slower per foot than pouring a liquid",
      "Not for concrete"
    ],
    "bottomLine": "The closest thing to a contractor's hot-pour crack seal that a homeowner can do with a torch, and the most durable choice for typical asphalt cracks.",
    "description": "Crack-Stix is a rubberized asphalt rope that you press into a clean crack and melt in place with a handheld propane torch. As it melts it flows into the crack walls and bonds, giving a seal that behaves much like the hot-pour material paving contractors run from a kettle. That matters because asphalt cracks open and close with temperature, and a filler that stays flexible keeps sealing through that movement. The product comes in different rope sizes for different crack widths, so check the package range against your measurements before buying. Owners commonly report that it holds through several winters where squeeze-bottle fillers have shrunk or pulled away. The tradeoff is the process: you need a torch, steady hands and attention to fire safety near dry grass, vehicles and fuel cans. It also takes longer per foot than pouring a liquid. For a driveway with a moderate number of quarter- to half-inch cracks, it is the best long-term result available to most DIYers."
  },
  {
    "id": "sikaflex-self-leveling-sealant",
    "name": "Sikaflex Self-Leveling Sealant",
    "category": "Polyurethane self-leveling sealant for concrete",
    "badge": "Best for Concrete Driveways",
    "amazonUrl": "",
    "pros": [
      "One-part polyurethane that flows level in horizontal cracks and joints",
      "Designed for joints that move with temperature",
      "Standard caulk-gun cartridge",
      "Gray color blends with most concrete",
      "Strong adhesion to clean, dry concrete per the data sheet"
    ],
    "cons": [
      "Needs backer rod in deeper cracks to avoid waste",
      "Slow full cure compared with acrylic fillers",
      "Too runny for sloped surfaces"
    ],
    "bottomLine": "The default pick for concrete driveway cracks and control joints that open and close through the seasons.",
    "description": "Sikaflex Self-Leveling Sealant is a one-part polyurethane made for horizontal concrete joints and cracks, which describes most of what goes wrong on a concrete driveway. You run a bead from a standard caulk gun and it flows out into a smooth, level line on its own, so there is no tooling unless you want a neater edge. Polyurethane stays elastic after curing, which is important at control joints and at the seam where a driveway meets a garage slab or sidewalk, both of which move as temperatures swing. The data sheet calls for clean, sound, dry concrete and recommends backer rod in deeper joints so the sealant sits at the right depth and bonds only to the two sides. It is self-leveling, so it will run downhill on a sloped drive; on steep sections, a non-sag polyurethane works better. Full cure takes several days, and it is not designed to fill wide, shallow spalls. For straight cracks and joints, it is the most dependable concrete choice here."
  },
  {
    "id": "quikrete-advanced-polymer-self-leveling",
    "name": "Quikrete Advanced Polymer Self-Leveling Sealant",
    "category": "Self-leveling polymer sealant for concrete",
    "badge": "Best Budget Concrete Filler",
    "amazonUrl": "",
    "pros": [
      "Widely stocked at home centers",
      "Self-levels in horizontal cracks",
      "Flexible once cured",
      "Gray finish suits most driveways",
      "Typically priced below premium polyurethanes"
    ],
    "cons": [
      "Slopes and vertical faces need a non-sag product",
      "Deep cracks still need backer rod or sand"
    ],
    "bottomLine": "A solid, easy-to-find self-leveling filler for routine concrete cracks when you do not need a contractor-grade polyurethane.",
    "description": "Quikrete's Advanced Polymer Self-Leveling Sealant fills the same role as the Sikaflex pick at a friendlier price and with easier availability, since it sits on the shelf at most big-box stores. It comes in a standard cartridge, flows into horizontal cracks on its own and cures to a flexible gray line that blends with ordinary broom-finished concrete. It is a good match for the typical concrete driveway problem of several hairline-to-quarter-inch cracks and a few joints that have lost their old caulk. As with any self-leveling sealant, it needs a clean, dry crack, and anything deeper than about half an inch should get backer rod or sand first so the sealant forms a shallow, flexible bead rather than a deep plug. It will not stay put on a slope or a vertical edge. Owners commonly describe it as easy to use for first-time DIYers, and for routine maintenance on a level concrete drive, it does the job without paying extra for a premium brand."
  },
  {
    "id": "latex-ite-trowel-patch",
    "name": "Latex-ite Trowel Patch",
    "category": "Ready-to-use trowel-grade asphalt patch",
    "badge": "Best for Wide Asphalt Cracks",
    "amazonUrl": "",
    "pros": [
      "Thick, trowel-grade consistency stays where you put it",
      "Ready to use from the tub",
      "Handles wider cracks and shallow low spots",
      "Black finish blends after sealing",
      "Water cleanup while wet"
    ],
    "cons": [
      "Slower to cure in thick applications",
      "Less flexible than hot rope filler",
      "Not for concrete"
    ],
    "bottomLine": "The right tool for cracks too wide for rope or pourable fillers and for shallow depressions along asphalt edges.",
    "description": "Wide asphalt cracks are a problem for pourable fillers, which simply sink out of sight, and rope fillers top out at certain widths. Latex-ite Trowel Patch handles that gap. It is a thick, ready-to-use asphalt patching compound you push into wider cracks and shallow depressions with a putty knife or trowel, then smooth flush with the surrounding pavement. Its heavy body means it stays put on edges and slight slopes where liquids would run. The label covers cleaning and drying requirements, layer thickness and cure time, and following those matters: thick applications cure slowly, especially in cool weather, and should be built up in layers for deep spots. It is not as flexible as a hot-applied rope, so it is best for wide cracks that are relatively stable rather than active cracks that open and close a lot. After curing, it can be sealed over with most asphalt driveway sealers. For a mix of wide cracks and edge damage on blacktop, it is the practical choice."
  },
  {
    "id": "sashco-slab-crack-repair",
    "name": "Sashco Slab Concrete Crack Repair",
    "category": "Textured flexible concrete crack sealant",
    "badge": "Best Concrete-Look Finish",
    "amazonUrl": "",
    "pros": [
      "Textured finish mimics the look of concrete",
      "Very flexible once cured",
      "Non-sag, works on slopes and edges",
      "Water cleanup while wet",
      "Good for visible cracks near entries"
    ],
    "cons": [
      "Cartridge size limits large jobs",
      "Color match is close, not exact",
      "Costs more per ounce than basic fillers"
    ],
    "bottomLine": "The pick for visible concrete cracks where appearance matters as much as the seal.",
    "description": "Most concrete crack fillers leave a smooth, shiny line that looks like caulk. Sashco Slab is designed to avoid that. It cures with a textured, sanded finish meant to blend with the surface of concrete, which makes it a favorite for front walks, the apron at the top of a driveway, and other cracks you look at every day. It is formulated to stay highly flexible, which helps it follow cracks that open and close with temperature, and it is non-sag, so it works on slopes, steps and the sides of cracks where self-leveling sealants would run. Cleanup is with water while it is wet. The color is a concrete gray that blends well with most slabs but will not match every one exactly, and as with any filler, it looks best when the crack is cleaned out first. It costs more per ounce than basic fillers, so it is best for visible areas rather than long runs of joints in the middle of a large driveway."
  },
  {
    "id": "quikrete-vinyl-concrete-patcher",
    "name": "Quikrete Vinyl Concrete Patcher",
    "category": "Polymer-modified cement patching compound",
    "badge": "Best for Chips and Spalls",
    "amazonUrl": "",
    "pros": [
      "Repairs chipped edges and shallow spalls",
      "Can be feathered thin at the edges",
      "Mix only what you need from the bag",
      "Cures hard and paintable",
      "Inexpensive for the area covered"
    ],
    "cons": [
      "Rigid; not for cracks that move",
      "Requires mixing and timing",
      "Not for asphalt"
    ],
    "bottomLine": "Use it to rebuild chipped and flaking concrete, then use a flexible sealant for the cracks themselves.",
    "description": "Not every concrete driveway problem is a crack. Chipped edges where a snowplow caught the slab, shallow spalls where the surface has flaked, and wide, non-moving gouges need a patching compound rather than a sealant. Quikrete Vinyl Concrete Patcher is a polymer-modified cement product you mix with water and trowel into damaged areas. The polymer helps it bond to existing concrete and allows it to be feathered thin at the edges, which is useful for blending repairs into the surrounding slab. It cures hard, like concrete, which is exactly what you want for a chipped edge and exactly what you do not want for a crack that opens and closes. Use it for repairs that are about restoring lost material, and use a flexible sealant such as the Sikaflex or Quikrete self-leveling picks for active cracks and joints. Mixing requires some timing, since you need to work it before it starts to set, so mix small batches. For the money, it rebuilds a lot of chipped concrete."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Driveway Crack Filler",
          item: "https://www.allmetalbrake.com/best-driveway-crack-filler/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Should cracks be filled before sealing a driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Sealer is too thin to bridge anything much wider than a hairline, and coating over open cracks leaves a path for water into the base. Clean and fill cracks first, let the filler cure for the time listed on the label, often a day or more, and then apply sealer over the whole surface."
          }
        },
        {
          "@type": "Question",
          "name": "How long does driveway crack filler last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It varies by type and conditions. Hot-applied rope fillers are often reported to last several years. Pourable emulsion fillers tend to need touch-ups every year or two as they shrink. Polyurethane sealants in concrete can last many years if applied correctly with backer rod. Annual inspection and touch-ups keep everything sealed."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use asphalt crack filler on concrete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is not recommended. Asphalt emulsion fillers bond poorly to concrete and leave a black line. Use a polyurethane or polymer sealant designed for concrete instead. Where an asphalt driveway meets a concrete apron or garage slab, use a flexible sealant rated for both surfaces at the seam."
          }
        },
        {
          "@type": "Question",
          "name": "What is backer rod and do I need it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Backer rod is closed-cell foam cord sold in rolls by diameter. Push it into cracks deeper than about half an inch so it sits a quarter to half inch below the surface. It saves sealant, keeps the bead shallow so it flexes better and stops the sealant bonding to the bottom of the crack."
          }
        },
        {
          "@type": "Question",
          "name": "Why do my driveway cracks keep coming back?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The filler may not have bonded because the crack was dirty or damp, it may be rigid in a crack that moves, or the crack may be a symptom of base problems, poor drainage or tree roots. Clean thoroughly, use a flexible product, and investigate drainage or structural issues if the same cracks keep widening."
          }
        },
        {
          "@type": "Question",
          "name": "Is rope crack filler better than pourable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For asphalt, rope filler melted with a torch generally gives a more durable, flexible seal, similar to professional hot-pour. Pourable fillers are faster and easier but tend to shrink and need more frequent touch-ups. For a few small cracks, pourable is fine; for a driveway you plan to keep for years, rope is the better investment."
          }
        },
        {
          "@type": "Question",
          "name": "When is the best time to fill driveway cracks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mild spring or fall days are ideal. Cracks are wider in cooler weather, so filling then puts the filler in compression during summer rather than stretching it in winter. Follow the product's minimum temperature, and make sure the crack is dry with no rain forecast for at least the first day."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Driveway & Asphalt",
    tags: [
      "best driveway crack filler",
      "asphalt crack filler",
      "concrete driveway crack sealant",
      "blacktop crack repair",
      "self-leveling crack sealant",
      "rope crack filler"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Driveway Crack Fillers</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          The right filler depends on two things: what the driveway is made of and how wide the crack is. Get those right and almost any of these will hold for years.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#crack-stix-permanent"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="7.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#crack-width" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Size the Crack First</a>
          <a href="#asphalt-vs-concrete" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Asphalt vs. Concrete</a>
          <a href="#filler-types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Filler Types</a>
          <a href="#asphalt-how-to" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Filling Asphalt Cracks</a>
          <a href="#concrete-how-to" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Filling Concrete Cracks</a>
          <a href="#how-much" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. How Much to Buy</a>
          <a href="#timing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Weather and Timing</a>
          <a href="#bigger-problem" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. When It Is Not Just a Crack</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Cracks are where driveways start to fail. Water gets through them into the base, freezes, expands and pushes the crack wider, and a few winters later the hairline you ignored is a pothole. Filling cracks is cheap, quick and does more for a driveway's lifespan than any coat of sealer. The catch is that crack fillers are not interchangeable: an asphalt rope filler is useless on concrete, a rigid patch fails in a crack that moves, and a pourable filler sinks out of sight in anything wider than about half an inch. These six picks cover the common jobs, and the guide below shows how to match one to your cracks.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 6 Best Driveway Crack Fillers, Ranked
          </h2>

          <p>
            We ranked these on what the manufacturers state on labels and data sheets, including the crack widths each is rated for, cure and traffic times, and flexibility, along with recurring patterns in owner feedback. We did not lab-test them. Each pick wins a specific job, so read the badge before the rank number.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} index={index} />
          ))}
        </div>

        <div id="crack-width" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Measure the Crack Before You Buy Anything
          </h2>

          <p>
            Crack width is the single number that decides which filler will work. Use a tape measure or a set of coins as a quick gauge: a dime is roughly 1/20 of an inch thick, and a quarter-inch is about the width of a pencil eraser. Walk the driveway and note the widest point of each crack, along with whether it is a single line or part of a web of connected cracks.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Crack width</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Asphalt driveway</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Concrete driveway</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Under 1/8 inch</td>
                    <td class="px-4 py-4 text-gray-700">Usually handled by sealer; fill if spreading</td>
                    <td class="px-4 py-4 text-gray-700">Penetrating sealer or thin self-leveling sealant</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">1/8 to 1/2 inch</td>
                    <td class="px-4 py-4 text-gray-700">Rope filler or pourable filler</td>
                    <td class="px-4 py-4 text-gray-700">Self-leveling polyurethane or polymer sealant</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">1/2 to 1 inch</td>
                    <td class="px-4 py-4 text-gray-700">Rope filler sized for width, or trowel patch</td>
                    <td class="px-4 py-4 text-gray-700">Backer rod plus self-leveling sealant</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Over 1 inch</td>
                    <td class="px-4 py-4 text-gray-700">Trowel patch or cold patch in layers</td>
                    <td class="px-4 py-4 text-gray-700">Patching compound; consult a pro if slabs have shifted</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Web of connected cracks</td>
                    <td class="px-4 py-4 text-gray-700">Base problem; get a paving quote</td>
                    <td class="px-4 py-4 text-gray-700">Check for heaving or settling</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Depth matters as much as width. Push a screwdriver into the crack. If it goes in more than about half an inch, you will need a backer rod, a closed-cell foam cord sold in rolls, or clean sand to fill the bottom before applying sealant. Filling a deep crack entirely with sealant wastes product and creates a thick plug that does not flex as well as a shallow bead.
          </p>

          <p>
            Also note whether the two sides of a crack are level with each other. In concrete, a crack where one side has dropped or lifted is a sign of settling or heaving, and filling it will not fix the trip hazard. In asphalt, a crack with soft, crumbling edges is often a sign of base failure. Those cases are covered at the end of this guide.
          </p>
        </div>

        <div id="asphalt-vs-concrete" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Asphalt and Concrete Need Different Chemistry
          </h2>

          <p>
            Asphalt is a flexible pavement. It bends a little under load and expands and contracts with temperature, and its cracks open in winter and close in summer. Asphalt crack fillers are typically rubberized asphalt emulsions or hot-applied rubberized asphalt, designed to bond to the binder in the pavement and stay elastic through that movement. They cure black so they blend with the surface and accept sealer over the top.
          </p>

          <p>
            Concrete is rigid. It cracks because it shrinks as it cures, because the ground below shifts, or because of freeze-thaw damage. The cracks that matter most usually sit at control joints or where slabs meet. Concrete fillers are typically polyurethane, hybrid polymer or acrylic sealants that bond to cement and stay flexible, plus cement-based patching compounds for spalls and chips that need rebuilding rather than sealing.
          </p>

          <p>
            Using the wrong type is one of the most common mistakes. An asphalt emulsion filler will not bond well to concrete, and its black color stands out. A rigid cement patch in an asphalt crack will pop out as the pavement flexes. Buy for the surface you have, and if you have both, like an asphalt driveway meeting a concrete garage apron, use the right product on each side and a flexible sealant along the seam.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE RULE</p>
            <p class="text-xl font-bold text-white mb-3">Match the filler to the pavement, then to the width.</p>
            <p class="text-gray-300 leading-relaxed m-0">Asphalt wants rubberized asphalt fillers that stay black and flexible. Concrete wants polyurethane or polymer sealants for cracks and cement-based patchers for chips. Get the surface right first, then choose by crack size.</p>
          </div>
        </div>

        <div id="filler-types" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. The Five Main Types of Crack Filler
          </h2>

          <p>
            <strong>Rope or rod fillers</strong> such as Crack-Stix are pre-formed strips of rubberized asphalt that you press into the crack and melt with a torch. They give the most durable DIY seal on asphalt and are the closest homeowner equivalent to professional hot-pour. They take more time per foot and require careful torch use.
          </p>

          <p>
            <strong>Pourable or squeeze-bottle asphalt fillers</strong> are liquid rubberized emulsions in jugs or bottles with a nozzle. They are the fastest to apply and work well in cracks from about an eighth to half an inch wide. They tend to shrink as they cure and may need a second pass, and they generally do not last as long as hot-applied rope. <strong>Trowel-grade asphalt patches</strong> like Latex-ite Trowel Patch are thick pastes for wider cracks and shallow depressions.
          </p>

          <p>
            <strong>Self-leveling sealants</strong> in caulk cartridges, such as Sikaflex Self-Leveling and Quikrete Advanced Polymer, are the standard for concrete cracks and joints on level surfaces. They flow into a smooth bead and cure flexible. <strong>Non-sag sealants</strong> like Sashco Slab hold their shape on slopes, steps and vertical faces.
          </p>

          <p>
            <strong>Cement-based patching compounds</strong> like Quikrete Vinyl Concrete Patcher rebuild missing concrete at chipped edges and spalls. They are rigid and should not be used for active cracks. For damaged blacktop with wider holes, cold patch asphalt products fill potholes, though that is a different job from crack sealing.
          </p>
        </div>

        <div id="asphalt-how-to" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. How to Fill Asphalt Driveway Cracks
          </h2>

          <p>
            <strong>1. Clean the crack.</strong> Pull out weeds, moss and loose material with a crack weeder or screwdriver, then blow the crack clean with a leaf blower or compressed air. A wire brush helps loosen debris along the edges. Fillers will not bond to dirt, so this step decides how long the repair lasts. If moss is a recurring problem, our guide on <a href="/how-to-remove-moss-from-asphalt-driveway/">removing moss from asphalt</a> covers clearing it first.
          </p>

          <p>
            <strong>2. Make sure it is dry.</strong> Most fillers need a dry crack, and moisture trapped below the surface can prevent bonding. Wait at least a day after rain, longer in shade. <strong>3. Fill the depth.</strong> For cracks deeper than about half an inch, add backer rod or clean sand to within roughly half an inch of the surface.
          </p>

          <p>
            <strong>4. Apply the filler.</strong> For rope, press it into the crack, then move the torch slowly along it until it melts and flows, keeping the flame moving so you do not scorch the surrounding asphalt. For pourable fillers, run the nozzle along the crack and fill slightly below the surface, then add a second pass if it shrinks. For trowel patch, press it in firmly and smooth it flush.
          </p>

          <p>
            <strong>5. Let it cure before sealing.</strong> Follow the label's cure time; many recommend waiting at least a day or more before sealing over the top. Fill cracks a few days before your sealing job so everything is firm. Our guide on <a href="/how-to-seal-a-driveway/">how to seal a driveway</a> covers the next step, and our <a href="/best-asphalt-driveway-sealer-reviews/">asphalt driveway sealer rankings</a> help pick the topcoat.
          </p>

          <p>
            Torch safety deserves its own note. Keep a fire extinguisher or a charged garden hose within reach, move vehicles and fuel cans well away, avoid working near dry grass or mulch on windy days, and follow the torch manufacturer's directions. Never use a torch on a crack that has fresh solvent-based product or fuel spills nearby.
          </p>
        </div>

        <div id="concrete-how-to" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. How to Fill Concrete Driveway Cracks
          </h2>

          <p>
            Concrete cracks follow a similar process with a few differences. Clean out the crack thoroughly, removing old caulk, weeds and loose concrete. A wire brush and shop vacuum work well. For narrow cracks that have rough edges, some manufacturers recommend widening them slightly with a grinder or chisel to give the sealant clean, solid walls to grip.
          </p>

          <p>
            Let the concrete dry fully, then insert backer rod in deeper cracks and joints. Backer rod should be slightly wider than the crack so it fits snugly, and it should sit about a quarter to half an inch below the surface. The rod sets the depth of the sealant and prevents it from bonding to the bottom of the crack, which lets the sealant stretch more freely as the crack moves.
          </p>

          <p>
            Apply a self-leveling sealant on level surfaces and a non-sag product on slopes. Fill to just below the surface; self-leveling sealants will settle into a smooth bead on their own. Tape off the edges if you want a crisp line. Keep traffic off for the time the label lists, and keep the area dry until the sealant has skinned over.
          </p>

          <p>
            For chipped edges and spalled areas, use a patching compound instead. Remove loose material, dampen the area if the product label calls for it, and trowel the patch in, feathering the edges. If you plan to seal the whole slab afterward, our guides to the <a href="/best-concrete-driveway-sealer-reviews/">best concrete driveway sealers</a> and <a href="/how-to-seal-a-concrete-driveway/">how to seal a concrete driveway</a> cover the process.
          </p>
        </div>

        <div id="how-much" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            7. How Much Filler to Buy
          </h2>

          <p>
            Most people underestimate how much product a crack eats. A 10.1-ounce caulk cartridge holds roughly 18 cubic inches of material. A crack a quarter-inch wide and a quarter-inch deep, which is the typical depth after backer rod, uses about one-sixteenth of a square inch of sealant per inch of length, so a cartridge covers roughly 24 linear feet. A half-inch by half-inch crack uses four times as much, so the same cartridge covers only about 6 feet.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">Approximate Cartridge Coverage, 10.1 oz</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">~24 ft</p>
                <p class="text-gray-400 text-xs mt-1">1/4 x 1/4 inch crack</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">~12 ft</p>
                <p class="text-gray-400 text-xs mt-1">1/4 x 1/2 inch crack</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">~6 ft</p>
                <p class="text-gray-400 text-xs mt-1">1/2 x 1/2 inch crack</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">~18 cu in</p>
                <p class="text-gray-400 text-xs mt-1">Volume per cartridge</p>
              </div>
            </div>
          </div>

          <p>
            Those numbers explain why backer rod is worth using: without it, a deep crack can swallow a whole cartridge in a few feet. For asphalt rope fillers and pourable jugs, check the package for the manufacturer's coverage estimate in linear feet at a given width, then add 20 to 30 percent for waste, irregular crack widths and a second pass.
          </p>

          <p>
            At the time of writing, cartridge sealants typically run from a few dollars to around $15 each, rope fillers and pourable jugs land roughly in the $15 to $40 range depending on size, and trowel patch tubs sit in a similar range. A typical two-car driveway with moderate cracking can often be handled for well under $100 in filler, which is a fraction of the cost of the damage it prevents. For the sealing side of the budget, see our page on <a href="/how-much-does-it-cost-to-seal-a-driveway/">what it costs to seal a driveway</a>.
          </p>

          <p>
            Buy one more container than your estimate. Running out halfway through a crack means a seam in the repair, and most fillers keep reasonably well sealed in a cool, dry place for use on next year's cracks.
          </p>
        </div>

        <div id="timing" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            8. Weather and Timing for Crack Repairs
          </h2>

          <p>
            Most liquid and cartridge fillers list a minimum application temperature, commonly around 40 to 50°F, and a dry forecast for at least the first day. Check your specific product, since the requirements vary. Hot-applied rope fillers need a dry crack more than warm air, but working in mild weather is easier and safer than on a windy, dry day.
          </p>

          <p>
            There is a good argument for filling cracks in the cooler months of spring or fall. Asphalt and concrete both shrink in cold weather, so cracks are at their widest. Filling them then means the filler is compressed rather than stretched in summer, which is easier on the bond. Filling in the heat of summer, when cracks are at their narrowest, can leave the filler stretched thin in winter.
          </p>

          <p>
            If you are sealing the whole driveway, fill cracks a few days to a week before applying sealer, following the filler's cure time. Our guides on <a href="/what-temperature-to-seal-driveway/">what temperature to seal a driveway</a> and <a href="/how-often-should-you-seal-your-driveway/">how often to seal</a> help line up both jobs.
          </p>

          <p>
            Crack filling is also worth doing on its own every year, even in years you do not seal. Walk the driveway each fall, fill anything new, and you will stop most cracks before winter has a chance to widen them.
          </p>
        </div>

        <div id="bigger-problem" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            9. When a Crack Is a Sign of Something Bigger
          </h2>

          <p>
            <strong>Alligator cracking</strong>, a pattern of interconnected cracks that looks like reptile skin, usually means the base under the asphalt has failed or is saturated. Filling the individual cracks will not hold for long. The usual fix is to cut out the damaged area and patch it with new asphalt, which is a job for a paving contractor in most cases.
          </p>

          <p>
            <strong>Edge cracking and crumbling</strong> along the sides of an asphalt driveway often comes from a lack of support at the edges, where the soil has washed away or vehicles drive off the edge. Filling helps, but building up soil or adding edging to support the pavement edge addresses the cause.
          </p>

          <p>
            In concrete, <strong>cracks with vertical displacement</strong>, where one side is higher than the other, signal settling or heaving below. Filling seals out water but does not fix the trip hazard. Slab lifting or replacement may be needed. <strong>Cracks that keep widening</strong> year after year can also point to drainage problems or tree roots underneath.
          </p>

          <p>
            If more than about a quarter of a driveway shows these kinds of failures, get quotes on patching or resurfacing before spending on fillers and sealer. Our page on the <a href="/sealing-asphalt-driveway-pros-and-cons/">pros and cons of sealing asphalt</a> discusses when maintenance is worth it and when it is just delaying the inevitable.
          </p>
        </div>

        <!-- Common Mistakes -->
        <div id="mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            10. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Filling a dirty or damp crack</h3>
              <p class="text-gray-700 text-sm m-0">
                Fillers bond to clean, dry pavement, not to dust, moss or moisture. Skipping the cleanout is the most common reason repairs pop out within a season. Pull weeds, brush the edges, blow the crack clean, and wait at least a day after rain before filling.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Pouring sealant into a deep crack with no backer</h3>
              <p class="text-gray-700 text-sm m-0">
                A deep crack can swallow an entire cartridge in a few feet, and a thick plug of sealant flexes poorly. Use foam backer rod or clean sand to bring the bottom up to within about half an inch of the surface, then apply a shallow, even bead.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Using a rigid patch in a moving crack</h3>
              <p class="text-gray-700 text-sm m-0">
                Cement-based patching compounds are great for chipped edges but crack again when used in joints or cracks that open and close with temperature. Use a flexible polyurethane or polymer sealant for active cracks and save patching compound for spalls and missing material.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Using asphalt filler on concrete</h3>
              <p class="text-gray-700 text-sm m-0">
                Asphalt emulsion fillers do not bond well to concrete and leave a black line that stands out. Use a concrete sealant on concrete and an asphalt filler on asphalt, and a flexible sealant at the seam where the two surfaces meet.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Sealing over uncured filler</h3>
              <p class="text-gray-700 text-sm m-0">
                Applying sealer before crack filler has cured can trap moisture, cause soft spots and lead to cracking or depressions in the topcoat. Check the filler's cure time and fill cracks a few days to a week before your sealing job.
              </p>
            </div>
          </div>
        </div>

        <PlanTheJob />

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            11. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Should cracks be filled before sealing a driveway?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes. Sealer is too thin to bridge anything much wider than a hairline, and coating over open cracks leaves a path for water into the base. Clean and fill cracks first, let the filler cure for the time listed on the label, often a day or more, and then apply sealer over the whole surface.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How long does driveway crack filler last?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It varies by type and conditions. Hot-applied rope fillers are often reported to last several years. Pourable emulsion fillers tend to need touch-ups every year or two as they shrink. Polyurethane sealants in concrete can last many years if applied correctly with backer rod. Annual inspection and touch-ups keep everything sealed.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can I use asphalt crack filler on concrete?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It is not recommended. Asphalt emulsion fillers bond poorly to concrete and leave a black line. Use a polyurethane or polymer sealant designed for concrete instead. Where an asphalt driveway meets a concrete apron or garage slab, use a flexible sealant rated for both surfaces at the seam.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What is backer rod and do I need it?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Backer rod is closed-cell foam cord sold in rolls by diameter. Push it into cracks deeper than about half an inch so it sits a quarter to half inch below the surface. It saves sealant, keeps the bead shallow so it flexes better and stops the sealant bonding to the bottom of the crack.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Why do my driveway cracks keep coming back?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                The filler may not have bonded because the crack was dirty or damp, it may be rigid in a crack that moves, or the crack may be a symptom of base problems, poor drainage or tree roots. Clean thoroughly, use a flexible product, and investigate drainage or structural issues if the same cracks keep widening.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is rope crack filler better than pourable?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                For asphalt, rope filler melted with a torch generally gives a more durable, flexible seal, similar to professional hot-pour. Pourable fillers are faster and easier but tend to shrink and need more frequent touch-ups. For a few small cracks, pourable is fine; for a driveway you plan to keep for years, rope is the better investment.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">When is the best time to fill driveway cracks?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Mild spring or fall days are ideal. Cracks are wider in cooler weather, so filling then puts the filler in compression during summer rather than stretching it in winter. Follow the product's minimum temperature, and make sure the crack is dry with no rain forecast for at least the first day.
              </p>
            </div>

          </div>
        </div>

