const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Electric Pressure Washer Picks",
          item: "https://www.allmetalbrake.com/best-electric-pressure-washer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which electric pressure washer should most people buy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For regular washing of cars, decks and siding, the Ryobi RY142300 brushless is the best all-round choice, with a quieter, longer-lived motor and standard fittings. For gentle, controlled work on paint, the Karcher K5 Premium is better. On a tight budget for light chores, the Sun Joe SPX3000 or Westinghouse ePX3100 do the job well."
          }
        },
        {
          "@type": "Question",
          "name": "Can an electric pressure washer clean a driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can, but slowly. Household outlets cap electric flow under about 2 GPM, so a full two-car driveway takes a long time and tends to stripe when cleaned with a wand. A surface cleaner sized for electric machines helps a lot on smaller areas. For large driveways cleaned every year, a gas machine or a rental is far more efficient."
          }
        },
        {
          "@type": "Question",
          "name": "Is a brushless or induction motor worth paying more for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you wash regularly, yes. Both run cooler and quieter than the universal motors in budget machines and are generally expected to last longer, since there are no carbon brushes to wear. For occasional short jobs, such as washing a car a few times a year, a budget universal-motor machine is usually adequate and will last for years."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use an extension cord with an electric pressure washer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many manuals advise against it or allow only short, heavy-gauge cords, often 12 or 14 gauge. Long or thin cords cause voltage drop, which makes the motor overheat and can trip the GFCI. The better solution is to place the machine near the outlet and use a longer garden hose or high-pressure hose to reach the work."
          }
        },
        {
          "@type": "Question",
          "name": "How much pressure is safe on car paint?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most car care guidance suggests staying around 1,200 to 1,900 PSI with a 40-degree tip held 18 to 24 inches from the paint. Pressure at the paint drops quickly with distance, so distance and tip angle matter as much as the rating. Avoid narrow tips entirely, and be careful around chips, trim, emblems and seals."
          }
        },
        {
          "@type": "Question",
          "name": "Are cordless pressure washers any good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Small battery spray guns are handy for rinsing bikes, boots and wheels but are not real pressure washers. Full-size battery machines like EGO's are capable and useful where there is no outlet, such as at a dock or campsite. They are expensive unless you already own the batteries, so for most homes a corded electric is better value."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my electric pressure washer keep turning on and off?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Short cycling usually means the pump is not getting steady water or air is trapped in the system. Open the spigot fully, straighten the supply hose, clean the inlet screen and nozzle, and run water through before starting the motor. If it persists, a worn unloader or a small leak in the gun or hose can cause the same symptom."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
