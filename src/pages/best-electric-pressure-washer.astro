---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Pressure Washers",
    "url": "/best-pressure-washer/"
  },
  {
    "title": "Best Shop Vacs",
    "url": "/best-shop-vac/"
  },
  {
    "title": "Best Benchtop Planers",
    "url": "/best-benchtop-planer/"
  },
  {
    "title": "Best Surface Cleaners for Pressure Washers",
    "url": "/best-surface-cleaner-for-pressure-washer/"
  },
  {
    "title": "Best Driveway Cleaners",
    "url": "/best-driveway-cleaner/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 6 Best Electric Pressure Washers: Plug-In and Cordless";
const description =
  "Six plug-in and battery pressure washers ranked for cars, decks, siding and patios, plus what a household outlet can power and how to avoid pump damage.";

const PRODUCTS = [
  {
    "badge": "Top Electric Overall",
    "category": "Brushless Plug-In, 1.2 GPM at 2300 PSI",
    "name": "Ryobi RY142300 2300 PSI Brushless",
    "description": "The RY142300 earns the top spot because it fixes the two things that usually go wrong with plug-in machines: noise and motor wear. Ryobi rates it at 2,300 PSI and 1.2 GPM, driven by a brushless motor rather than the brushed universal motor common on cheaper units. Brushless motors have no carbon brushes to wear out and generally run cooler, which matters on a machine you might run for an hour washing a deck. The upright frame has wheels and a handle, with on-board storage for the hose, cord and tips, so it rolls out of a closet and back in without a tangle. It uses standard quick-connect tips, so aftermarket surface cleaners, foam cannons and extension wands fit. Owners commonly mention how much quieter it is than older electrics. It is a strong choice for a household that washes cars, decks, siding and patios through the season.",
    "pros": [
      "Brushless motor with no brushes to wear out",
      "Quieter than typical universal-motor electrics",
      "Standard quick-connect fittings for accessories",
      "Upright frame with on-board hose and cord storage"
    ],
    "cons": [
      "1.2 GPM is slow on large concrete",
      "Costs more than budget plug-ins",
      "Pump still needs winter protection"
    ],
    "bottomLine": "The plug-in most households should buy for regular car, deck and siding work.",
    "amazonUrl": "",
    "id": "ryobi-ry142300-electric"
  },
  {
    "badge": "Gentlest on Paint",
    "category": "Water-Cooled Plug-In, 1.4 GPM, Pressure Set at the Gun",
    "name": "Karcher K5 Premium Smart Control",
    "description": "The K5 Premium Smart Control is the electric for people who spend more time washing cars and painted surfaces than concrete. Karcher rates it around 2,000 PSI and 1.4 GPM from a water-cooled induction motor, which runs cool and relatively quietly. The trigger gun has pressure settings and a small display, so you can drop pressure for paint, trim and glass and raise it for stone without walking back to switch tips. A companion app suggests settings by surface. The tall frame includes a hose reel and accessory storage. Karcher machines tend to use some proprietary connections, so third-party accessories may need adapters, and the price is high for its pressure rating. That said, 1.4 GPM is good flow for a plug-in, so rinsing soap off a car or siding goes quickly. If gentle, precise control matters more to you than raw power, this is the one.",
    "pros": [
      "Adjust pressure at the gun without changing tips",
      "Good flow for a plug-in machine",
      "Water-cooled induction motor",
      "Hose reel and tidy upright storage"
    ],
    "cons": [
      "Some fittings need adapters for third-party gear",
      "Expensive for a 2,000 PSI rating",
      "Heavy for an electric"
    ],
    "bottomLine": "The best electric for car detailing and painted siding where control beats power.",
    "amazonUrl": "",
    "id": "karcher-k5-electric"
  },
  {
    "badge": "Most Pressure on a Plug",
    "category": "Induction Plug-In, 1.1 GPM, 3000 PSI Rating",
    "name": "Greenworks Pro GPW3000 3000 PSI",
    "description": "Greenworks advertises 3,000 PSI on a standard household circuit, close to the ceiling for plug-in machines. It reaches that number by trading flow, rated at about 1.1 GPM, so the cleaning units land only modestly above a good 2,000 PSI electric. The extra pressure is useful on tight, stubborn spots: algae in brick joints, tire marks on a garage apron, old grime in the corners of a patio. An induction motor and a steel-reinforced frame give it a sturdier feel than entry-level electrics, and it carries its tips, cord and hose on board. On wood decks and vinyl siding you will rarely use its full pressure, and you will want a wide tip and some distance to avoid damage. Choose it if you want the strongest point pressure without moving to gas, and do not expect it to clean a large driveway faster than its flow allows.",
    "pros": [
      "One of the highest pressure ratings for a plug-in",
      "Induction motor for longer life",
      "Sturdy frame with on-board storage",
      "Handles stubborn spot stains well"
    ],
    "cons": [
      "Low flow limits overall cleaning speed",
      "Too much pressure for softwood without care",
      "Heavier than compact models"
    ],
    "bottomLine": "Best for tough spot cleaning on masonry, not a gas replacement for big slabs.",
    "amazonUrl": "",
    "id": "greenworks-gpw3000-electric"
  },
  {
    "badge": "Budget Pick",
    "category": "Plug-In with Two Soap Tanks, 1.76 GPM Max",
    "name": "Sun Joe SPX3000 2030 PSI",
    "description": "The SPX3000 is the inexpensive electric that a huge number of households already own, and for light work it earns that popularity. Sun Joe lists maximum ratings of 2,030 PSI and 1.76 GPM; as with most budget machines, those are peak figures that are not reached together, so real performance is lower. It runs on a universal motor, which is louder and wears faster than induction or brushless designs. What it does well is convenience at a low price: two detergent tanks with a selector dial, five quick-connect tips, an automatic shut-off that stops the pump when you release the trigger, and a light body you can carry up deck steps. It suits cars, bikes, lawn furniture, grills and small patios. Owners who try to strip whole decks or clean big driveways with it every year tend to wear it out, so match it to light duty.",
    "pros": [
      "Very low price for its capability",
      "Two detergent tanks with a selector dial",
      "Five quick-connect tips included",
      "Light and easy to carry"
    ],
    "cons": [
      "Universal motor is loud and wears sooner",
      "Peak specs overstate working performance",
      "Short hose and plastic construction"
    ],
    "bottomLine": "A good cheap machine for cars and furniture if you keep its jobs light.",
    "amazonUrl": "",
    "id": "sun-joe-spx3000-electric"
  },
  {
    "badge": "Compact Value",
    "category": "Plug-In, 1.76 GPM Max, Anti-Tip Frame",
    "name": "Westinghouse ePX3100 2050 PSI",
    "description": "The ePX3100 competes directly with the Sun Joe on price and adds a few thoughtful touches. Westinghouse lists maximum ratings of 2,050 PSI and 1.76 GPM, again peak figures rather than simultaneous ones. The frame is designed with a wide, low stance to resist tipping when the hose pulls on it, a common irritation with tall, light electrics. It includes an on-board detergent bottle, quick-connect tips and storage for the gun, cord and hose. It is a sensible pick for car washing, patio furniture, siding touch-ups and small decks, and its compact footprint suits apartments, townhouses and small garages. Like other machines in this price class, it is not built for heavy, frequent concrete work, and owners who need that should look at gas. As a tidy, inexpensive machine for occasional chores, it is a fair alternative if you find it priced below the Sun Joe.",
    "pros": [
      "Wide, stable stance resists tipping",
      "Compact enough for small storage spaces",
      "On-board detergent bottle and tip storage",
      "Low price"
    ],
    "cons": [
      "Peak ratings, not working ratings",
      "Light-duty pump and motor",
      "Short hose limits reach"
    ],
    "bottomLine": "A stable, compact budget electric for occasional light jobs.",
    "amazonUrl": "",
    "id": "westinghouse-epx3100"
  },
  {
    "badge": "Battery Pick",
    "category": "56V Battery Platform, 3200 PSI Peak",
