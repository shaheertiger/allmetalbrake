---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import SocialProof from "../components/SocialProof.astro";
import TrustBadge from "../components/TrustBadge.astro";
import { pageDates } from "../data/dates";
import TopPick from "../components/TopPick.astro";



const moreInCategory = [
    { title: "How to Get Oil Out of Concrete", url: "/how-to-get-oil-out-of-concrete/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-04-05", modified: "2026-04-05" });
const title = "How to Remove Oil Stains from a Driveway: 7 Methods";
const description =
  "Fresh or old oil stains on concrete or asphalt driveways — we tested 7 removal methods so you don't waste a weekend on the wrong one. Honest results, no fluff.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "How-To Guides",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How to Remove Oil Stains from a Driveway",
          item: "https://www.allmetalbrake.com/how-to-remove-oil-stains-from-driveway/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Does WD-40 remove oil stains from concrete?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Counterintuitively, WD-40 can help with some fresh oil stains — its penetrating chemistry can help lift oil from surface pores when used as a pre-treatment before scrubbing. However, it introduces more petroleum compound to the concrete, so it must be thoroughly cleaned afterward with degreaser. It is not recommended as a primary treatment — use a dedicated degreaser instead.",
          },
        },
        {
          "@type": "Question",
          name: "Will bleach remove oil stains from a driveway?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Bleach is an oxidizer and disinfectant, not a degreaser. It has essentially zero effect on oil and petroleum stains. Using bleach on oil stains wastes effort and can temporarily lighten the surrounding concrete, making the dark stain appear worse by comparison. Do not use bleach for oil stain removal.",
          },
        },
        {
          "@type": "Question",
          name: "Can oil stains permanently damage a concrete driveway?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Cosmetically, yes — old oil stains may be permanently visible even after thorough cleaning. Structurally, oil can weaken the concrete surface layer over time, particularly when combined with freeze-thaw cycles. However, for standard residential driveways, cosmetic staining is the primary concern rather than structural failure.",
          },
        },
        {
          "@type": "Question",
          name: "What's the best way to prevent oil stains on a driveway?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The most effective prevention is a quality concrete or asphalt sealer. A sealed driveway has dramatically reduced porosity — oil sits on top of the sealer rather than soaking in, giving you time to clean it up before penetration occurs. Reapply sealer according to the manufacturer's recommendations (typically every 2–5 years). Placing a drip mat under regularly parked vehicles also protects the driveway surface.",
          },
        },
        {
          "@type": "Question",
          name: "How do I remove gasoline stains from a driveway?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Gasoline stains on concrete respond similarly to oil stains — absorb immediately with cat litter or baking soda, then treat with commercial degreaser. Gasoline evaporates quickly, so surface residue is often minimal. The main concern is the petroleum content soaking into the concrete. For asphalt driveways, act faster with gasoline than with oil — gasoline is a more aggressive solvent on asphalt's petroleum binder.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "Home Fix Reviews" },
    },
    {
      "@type": "HowTo",
      name: title,
      description: description,
      author: {
        "@type": "Person",
        name: "Alex Rivers",
      },
      datePublished: dates.published,
      publisher: {
        "@type": "Organization",
        name: "Home Fix Reviews",
      },
      step: [
        {
          "@type": "HowToStep",
          name: "Absorb fresh oil immediately",
          text: "Apply an absorbent material (cat litter, baking soda, or sawdust) immediately to fresh spills to prevent penetration.",
        },
        {
          "@type": "HowToStep",
          name: "Apply a degreaser",
          text: "Apply a concrete degreaser or dish soap to the stained area and scrub with a stiff brush.",
        },
        {
          "@type": "HowToStep",
          name: "Rinse thoroughly",
          text: "Rinse the treated area with a garden hose or pressure washer on medium pressure.",
        },
        {
          "@type": "HowToStep",
          name: "Repeat for old stains",
          text: "Old stains may require multiple treatments or a poultice application.",
        },
      ]
    },
  ],
};
