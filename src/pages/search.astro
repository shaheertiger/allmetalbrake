---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/search.html?raw';

const title = "Search — Home Fix Reviews";
const description = "Search Home Fix Reviews for hands-on product reviews, buying guides, and how-to articles on home improvement.";
---

<BaseLayout title={title} description={description} articleCss={false} noindex={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
