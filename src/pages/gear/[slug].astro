---
// One page per product: /gear/<slug>/. Ranks for "<model> review" and "<model> specs" searches.
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Score from '../../components/Score.astro';
import BuyButton from '../../components/BuyButton.astro';
import CatIcon from '../../components/CatIcon.astro';
import ProductImage from '../../components/ProductImage.astro';
import FaqList from '../../components/FaqList.astro';
import { SITE, SCORE_NAME } from '../../data/site';
import { categoryOf } from '../../data/categories';
import { compares } from '../../data/compares';
import { amazonUrl, amazonImage, AFFILIATE_REL } from '../../lib/amazon';
import { md } from '../../lib/md';
import { breadcrumbs, faqPage, graph, productSchema } from '../../lib/schema';
import { productUpdated, products, productsByCategory, productsByBrand, articlesForProduct, productUrl, brandUrl, articleUrl, compareSlug, shortName, rankOf, lc, formatDate } from '../../lib/data';
import type { Product, FAQ } from '../../lib/types';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const path = productUrl(p);
const cat = categoryOf(p.category);
const sn = shortName(p.name);
const { rank, of } = rankOf(p);
const updated = productUpdated(p);
const featured = articlesForProduct(p.slug);
const myCompares = compares.filter(([a, b]) => a === p.slug || b === p.slug).map(([a, b]) => ({ slug: compareSlug(a, b), other: products.find((x) => x.slug === (a === p.slug ? b : a)) })).filter((c): c is { slug: string; other: Product } => Boolean(c.other));
// Alternatives, the sister-site way: "Cheaper options" first (same category, lower price tier, best
// score first); for the cheapest products, fall back to higher-scoring ones, then anything else we track.
const others = productsByCategory(p.category).filter((x) => x.slug !== p.slug);
const cheaper = others.filter((x) => (x.priceTier ?? 0) < (p.priceTier ?? 0) && (x.priceTier ?? 0) > 0).sort((a, b) => b.score - a.score).slice(0, 3);
const higher = others.filter((x) => x.score > p.score).slice(-3).reverse();
const [altHead, alts] = cheaper.length ? ['Cheaper options', cheaper] : higher.length ? ['Higher-scoring options', higher] : [`Other ${cat.plural} we track`, others.slice(0, 3)];
const sameBrand = productsByBrand(p.brand).filter((x) => x.slug !== p.slug).slice(0, 4);
const worth: FAQ = {
  q: `Is the ${p.name} worth it?`,
  a: `${p.summary} It scores ${p.score}/100 on our ${SCORE_NAME}, ranking #${rank} of the ${of} ${cat.plural} we track. It is best for ${lc(p.bestFor)}; skip it if ${lc(p.skipIf)}.`,
};
const faqs = [...(p.faqs ?? []), worth];
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'All Gear', url: '/gear/' },
  { name: cat.label, url: `/gear/#${cat.key}` },
  { name: p.name, url: path },
];
// Title: "<Model> Review: Specs, Score & Verdict (88/100)" when it fits in 65.
const options = [`${p.name} Review: Specs, Score & Verdict`, `${sn} Review: Specs, Score & Verdict`, `${sn} Review: Specs & Score`, `${sn} Review & Specs`];
const base = options.find((t) => t.length >= 45 && t.length <= 62) ?? options.find((t) => t.length <= 62) ?? sn;
const title = `${base} (${p.score}/100)`.length <= 65 ? `${base} (${p.score}/100)` : base;
// Description: "<Model> at a glance: <spec> <value>, ... <summary>", cut at a word like a SERP snippet.
const lead = `${sn} at a glance: `;
const specBits: string[] = [];
for (const [k, v] of Object.entries(p.specs)) {
  const next = [...specBits, `${k.charAt(0).toLowerCase() + k.slice(1)} ${v.replace(/\s*\([^)]*\)/g, '').replace(/;.*$/, '').trim()}`];
  if ((lead + next.join(', ')).length > 100 || next.length > 3) break;
  specBits.splice(0, specBits.length, ...next);
}
const rawDesc = specBits.length ? `${lead}${specBits.join(', ')}. ${p.summary}` : p.summary;
const description = rawDesc.length <= 158 ? rawDesc : `${rawDesc.slice(0, rawDesc.lastIndexOf(' ', 157)).replace(/[\s,;:–—-]+$/, '')}…`;
const img = amazonImage(p, 500) ?? undefined;
const schema = graph(productSchema(p), breadcrumbs(crumbs), faqPage(faqs));
const keys = (p.keySpecs?.length ? p.keySpecs : Object.keys(p.specs)).filter((k) => p.specs[k]).slice(0, 4);
---
<Base title={title} description={description} type="article" schema={schema} ogImage={img} preloadImage={amazonImage(p, 440) ?? undefined} section={cat.label} published={updated} updated={updated}>
  <article class="article gear">
    <header class="col a-head">
      <Crumbs items={crumbs} />
      <div class="kicker"><a href={brandUrl(p.brand)}>{p.brand}</a> · <a href={`/gear/#${cat.key}`}>{cat.label}</a></div>
      <h1 class="a-title">{p.name}</h1>
      <div class="gear-meta">
        <Score value={p.score} size="lg" />
        <span>By <a href="/about/">{SITE.author}</a> · #{rank} of {of} {cat.plural} · {p.priceBand}{p.released && <> · Released {p.released}</>} · Updated <time datetime={updated}>{formatDate(updated)}</time></span>
      </div>
    </header>

    <div class="col">
      <section class="quick-card">
        {p.imageId ? (
          <div class="qc-hero">
            <figure class="qc-photo">
              <ProductImage p={p} size={220} buy eager />
              <figcaption>Amazon listing photo: {p.name}</figcaption>
            </figure>
            <div>
              <h2 class="mini">Quick answer</h2>
              <p>{p.summary}</p>
            </div>
          </div>
        ) : (
          <div class="qc-top">
            <CatIcon cat={p.category} size={72} />
            <div>
              <h2 class="mini">Quick answer</h2>
              <p>{p.summary}</p>
            </div>
          </div>
        )}
        <dl class="qc-fit">
          <div><dt>Best for</dt><dd>{p.bestFor}</dd></div>
          <div><dt>Skip it if</dt><dd>{p.skipIf}</dd></div>
        </dl>
        <dl class="keyspecs">{keys.map((k) => <div><dt>{k}</dt><dd>{p.specs[k]}</dd></div>)}</dl>
        <div class="pick-cta"><BuyButton p={p} /><a class="more" href="#specs">All {sn} specs ↓</a></div>
      </section>
    </div>

    <div class="col body">
      <h2 id="specs">{p.name} Specs</h2>
      <div class="table-wrap">
        <table class="spec-table kv">
          <tbody>{Object.entries(p.specs).map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}<tr><th scope="row">Price band</th><td>{p.priceBand} (relative to its category; check the live price)</td></tr></tbody>
        </table>
      </div>
      <p class="fine">Specs from {p.brand}'s published spec sheet, manual and product listings. The {sn} has not been bench-tested by us: its score comes from the spec sheet, safety features, certifications and owner reports. <a href="/how-we-test/">How we score</a>.</p>

      <h2 id="score">{SCORE_NAME}: {p.score}/100</h2>
      <p>The {SCORE_NAME} weighs the spec sheet against the price band, safety features and what owners report over time.</p>
      {p.scores?.length && (
        <div class="bars">
          {p.scores.map((s) => (
            <div class="bar"><span class="bar-k">{s.label}</span><span class="bar-track"><span class="bar-fill" style={`width:${s.value}%`} /></span><span class="bar-v">{s.value}</span></div>
          ))}
        </div>
      )}

      <h2 id="verdict">Our Verdict</h2>
      <Fragment set:html={md(p.verdict)} />
      <div class="proscons">
        <div class="pros"><h3>Pros</h3><ul>{p.pros.map((t) => <li>{t}</li>)}</ul></div>
        <div class="cons"><h3>Cons</h3><ul>{p.cons.map((t) => <li>{t}</li>)}</ul></div>
      </div>

      {alts.length > 0 && (
        <>
          <h2 id="alternatives">Alternatives to the {p.name}</h2>
          <h3>{altHead}</h3>
          <div class="alt-cards">
            {alts.map((x) => <a class="alt-card" href={productUrl(x)}><ProductImage p={x} size={64} /><span><strong>{x.name}</strong><small><Score value={x.score} /> · {x.priceBand}</small></span></a>)}
          </div>
        </>
      )}
      {sameBrand.length > 0 && (
        <>
          {alts.length === 0 && <h2 id="alternatives">Alternatives to the {p.name}</h2>}
          <h3>More from {p.brand}</h3>
          <div class="alt-cards">{sameBrand.map((x) => <a class="alt-card" href={productUrl(x)}><ProductImage p={x} size={64} /><span><strong>{x.name}</strong><small><Score value={x.score} /> · {x.priceBand}</small></span></a>)}</div>
        </>
      )}

      {myCompares.length > 0 && (
        <>
          <h2 id="compare">Compare the {sn}</h2>
          <ul class="link-list">{myCompares.map((c) => <li><a href={`/compare/${c.slug}/`}>{sn} vs {shortName(c.other.name)}</a></li>)}</ul>
        </>
      )}

      <h2 id="faq">{p.name} FAQ</h2>
      <FaqList faqs={faqs} />

      {featured.length > 0 && (
        <>
          <h2 id="featured">Featured In</h2>
          <ul class="link-list">{featured.map((a) => <li><a href={articleUrl(a)}>{a.h1}</a> <span class="tag">{a.picks!.find((x) => x.product === p.slug)!.award}</span></li>)}</ul>
        </>
      )}
    </div>

    <div class="sticky-buy" aria-label="Price">
      <ProductImage p={p} size={40} />
      <span class="sb-text"><span class="sb-k">{SCORE_NAME} {p.score}/100 · {p.priceBand}</span><strong>{p.name}</strong></span>
      <a class="buy buy-sm" href={amazonUrl(p)} rel={AFFILIATE_REL} target="_blank">Check Price</a>
      <button class="sb-close" type="button" aria-label="Dismiss" onclick="this.parentElement.hidden=true">×</button>
    </div>
  </article>
</Base>
