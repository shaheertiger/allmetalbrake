---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductImage from '../../components/ProductImage.astro';
import AmazonButton from '../../components/AmazonButton.astro';
import Score from '../../components/Score.astro';
import ProsCons from '../../components/ProsCons.astro';
import FAQ from '../../components/FAQ.astro';
import StickyBuyBar from '../../components/StickyBuyBar.astro';
import { products, productsByCategory, productsByBrand, articlesForProduct, productUrl, brandUrl, articleUrl, compareSlug, shortName } from '../../lib/data';
import { compares } from '../../data/compares';
import { CATEGORY_LABELS, SITE } from '../../data/site';
import { md } from '../../lib/md';
import { breadcrumbs, faqPage, graph, productSchema } from '../../lib/schema';
import { amazonImage, amazonUrl } from '../../lib/amazon';
import type { Product, FAQ as F } from '../../lib/types';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}
const { product: p } = Astro.props as { product: Product };
const catLabel = CATEGORY_LABELS[p.category] ?? p.category;
const peers = productsByCategory(p.category).filter((x) => x.slug !== p.slug);
const cheaper = peers.filter((x) => x.priceTier < p.priceTier).sort((a, b) => b.score - a.score).slice(0, 3);
const better = peers.filter((x) => x.score > p.score).sort((a, b) => a.priceTier - b.priceTier).slice(0, 3);
const sameBrand = productsByBrand(p.brand).filter((x) => x.slug !== p.slug).slice(0, 4);
const inArticles = articlesForProduct(p.slug);
const rank = productsByCategory(p.category).findIndex((x) => x.slug === p.slug) + 1;
const total = productsByCategory(p.category).length;
const myCompares = compares.filter(([a, b]) => a === p.slug || b === p.slug).map(([a, b]) => ({ slug: compareSlug(a, b), other: products.find((x) => x.slug === (a === p.slug ? b : a))! })).filter((c) => c.other);

const autoFaqs: F[] = [
  { q: `Is the ${p.name} worth it?`, a: `${p.summary} It scores **${p.score}/100** on our AMB Score, ranking #${rank} of the ${total} ${catLabel.toLowerCase()} we track. It is best for ${p.bestFor.charAt(0).toLowerCase() + p.bestFor.slice(1)}; skip it if ${p.skipIf.charAt(0).toLowerCase() + p.skipIf.slice(1)}.` },
  ...(cheaper[0] ? [{ q: `What is a cheaper alternative to the ${p.name}?`, a: `The [${cheaper[0].name}](${productUrl(cheaper[0])}) (${cheaper[0].priceBand}) scores ${cheaper[0].score}/100. ${cheaper[0].summary}` }] : []),
];
const faqs = [...(p.faqs ?? []), ...autoFaqs];
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'All Gear', url: '/gear/' },
  { name: catLabel, url: `/gear/#${p.category}` },
  { name: p.name, url: productUrl(p) },
];
const sn = shortName(p.name);
const title = [`${p.name} Review: Specs, Score & Verdict (${p.score}/100)`, `${p.name} Review: Specs, Score & Verdict`, `${sn} Review: Specs, Score & Verdict`, `${sn} Review: Specs & Score`, `${sn} Review & Specs`].find((t) => t.length <= 65) ?? sn;
const description = `${p.name} at a glance: ${Object.entries(p.specs).slice(0, 3).map(([k, v]) => `${k.toLowerCase()} ${v}`).join(', ')}. ${p.summary}`.slice(0, 158);
const schema = graph(breadcrumbs(crumbs), productSchema(p), faqPage(faqs));
---
<Base title={title} description={description} type="article" schema={schema} preloadImage={amazonImage(p, 400) ?? undefined}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs items={crumbs} />
    <div class="mt-5 grid md:grid-cols-[260px_1fr] gap-6 items-start">
      <div class="flex justify-center md:block"><ProductImage product={p} size={500} class="w-60 h-60 rounded-2xl border border-slate-200 p-2" eager /></div>
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-brand-600"><a href={brandUrl(p.brand)} class="no-underline">{p.brand}</a> · {catLabel}</p>
        <h1 class="mt-1 text-3xl sm:text-4xl font-extrabold tracking-tight text-ink leading-tight">{p.name}</h1>
        <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-slate-600">
          <Score score={p.score} size="lg" />
          <span>#{rank} of {total} {catLabel.toLowerCase()}</span>
          <span aria-hidden="true">·</span>
          <span>{p.priceBand}</span>
          {p.released && <><span aria-hidden="true">·</span><span>Released {p.released}</span></>}
        </div>
        <div class="mt-4 rounded-xl bg-brand-50 border border-brand-100 p-4">
          <p class="text-xs font-bold uppercase tracking-wider text-brand-700">Quick answer</p>
          <p class="mt-1 text-[1rem] text-slate-800">{p.summary}</p>
        </div>
        <div class="mt-4 grid sm:grid-cols-2 gap-3 text-sm">
          <div class="rounded-lg border border-slate-200 p-3"><span class="block text-xs text-slate-500">Best for</span><span class="font-semibold">{p.bestFor}</span></div>
          <div class="rounded-lg border border-slate-200 p-3"><span class="block text-xs text-slate-500">Skip it if</span><span class="font-semibold">{p.skipIf}</span></div>
        </div>
        <div class="mt-5" id="main-buy"><AmazonButton product={p} class="w-full sm:w-auto" /></div>
      </div>
    </div>

    <div class="max-w-3xl">
      <div class="prose mt-10">
        <h2 id="specs">{p.name} Specs</h2>
      </div>
      <div class="not-prose mt-4 overflow-hidden rounded-xl border border-slate-200">
        <table class="w-full text-sm">
          <tbody class="divide-y divide-slate-100">
            {Object.entries(p.specs).map(([k, v]) => <tr><th class="w-2/5 bg-slate-50 px-4 py-2.5 text-left font-medium text-slate-600">{k}</th><td class="px-4 py-2.5 text-ink">{v}</td></tr>)}
          </tbody>
        </table>
      </div>

      <div class="prose"><h2 id="score">AMB Score: {p.score}/100</h2>
        <p>The AMB Score is our editorial ranking, built from the spec sheet, safety features and what owners report over time. <a href="/how-we-test/">See how we score</a>.</p>
      </div>
      {p.scores && (
        <div class="not-prose mt-4 space-y-3">
          {p.scores.map((s) => (
            <div>
              <div class="flex justify-between text-sm"><span class="text-slate-700">{s.label}</span><span class="font-bold">{s.value}</span></div>
              <div class="mt-1 h-2 rounded-full bg-slate-100"><div class="h-2 rounded-full bg-brand-600" style={`width:${s.value}%`}></div></div>
            </div>
          ))}
        </div>
      )}

      <div class="prose"><h2 id="verdict">Our Verdict</h2><Fragment set:html={md(p.verdict)} /></div>
      <ProsCons pros={p.pros} cons={p.cons} />

      {(cheaper.length > 0 || better.length > 0 || sameBrand.length > 0) && (
        <div class="prose"><h2 id="alternatives">Alternatives to the {p.name}</h2></div>
        <div class="not-prose mt-4 space-y-6">
          {[{ t: 'Cheaper options', l: cheaper }, { t: 'Higher-scoring options', l: better }, { t: `More from ${p.brand}`, l: sameBrand }].filter((g) => g.l.length).map((g) => (
            <div>
              <h3 class="font-bold text-ink">{g.t}</h3>
              <ul class="mt-2 grid sm:grid-cols-3 gap-3">
                {g.l.map((x) => (
                  <li><a href={productUrl(x)} class="flex items-center gap-3 rounded-xl border border-slate-200 p-3 hover:border-brand-500 no-underline h-full">
                    <ProductImage product={x} size={160} class="w-12 h-12 shrink-0 rounded-lg" />
                    <span class="min-w-0"><span class="block text-sm font-semibold text-ink leading-snug">{x.name}</span><span class="text-xs text-slate-500">{x.score}/100 · {x.priceBand}</span></span>
                  </a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}

      {myCompares.length > 0 && (
        <div class="prose"><h2 id="compare">Compare the {p.name}</h2>
          <ul>{myCompares.map((c) => <li><a href={`/compare/${c.slug}/`}>{p.name} vs {c.other.name}</a></li>)}</ul>
        </div>
      )}

      <div class="prose"><h2 id="faq">{p.name} FAQ</h2></div>
      <FAQ faqs={faqs} />

      {inArticles.length > 0 && (
        <div class="prose"><h2 id="featured">Featured In</h2>
          <ul>{inArticles.map((a) => <li><a href={articleUrl(a)}>{a.h1}</a> ({a.picks!.find((x) => x.product === p.slug)!.award})</li>)}</ul>
        </div>
      )}
    </div>
  </div>
  <StickyBuyBar items={[{ slug: p.slug, name: p.name, label: `AMB Score ${p.score}/100`, url: amazonUrl(p), image: amazonImage(p, 160) }]} trigger="#main-buy" mode="single" />
</Base>
