---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Electric Pressure Washer",
    "url": "/best-electric-pressure-washer/"
  },
  {
    "title": "Best Driveway Cleaner",
    "url": "/best-driveway-cleaner/"
  },
  {
    "title": "Best Oil Stain Remover for Concrete",
    "url": "/best-oil-stain-remover-for-concrete/"
  },
  {
    "title": "Driveway Oil Stains on Asphalt and Concrete",
    "url": "/how-to-remove-oil-stains-from-driveway/"
  },
  {
    "title": "How to Seal a Concrete Driveway",
    "url": "/how-to-seal-a-concrete-driveway/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "Pressure Washer Surface Cleaners: The 7 Best Attachments by PSI";
const description =
  "Surface cleaner attachments matched to your pressure washer's PSI, flow and connector, plus sizing, technique and fixes for streaks on driveways and patios.";

const PRODUCTS = [
  {
    "id": "simpson-cleaning-surface-cleaner",
    "name": "Simpson 80165 15-Inch Surface Cleaner",
    "category": "15-inch, gas pressure washers",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "Sized for the most common homeowner gas machines",
      "Standard 1/4-inch quick-connect plug",
      "Steel deck with replaceable nozzles",
      "Handle and wheels make driveway passes easy"
    ],
    "cons": [
      "Too large for most electric units",
      "Steel deck is heavier than plastic designs",
      "Needs swivel maintenance over time"
    ],
    "bottomLine": "The default pick for a homeowner with a typical gas pressure washer and a concrete driveway.",
    "description": "Simpson's 15-inch surface cleaner is built for the gas pressure washers most homeowners own, the class running roughly 2,800 to 3,600 PSI at around 2.3 to 2.8 GPM. It uses a standard quarter-inch quick-connect plug, so it fits most gas wands with the common coupler, not just Simpson machines. The steel deck holds a spinning bar with two nozzles that are replaceable, which matters because worn nozzles are the most common cause of uneven cleaning as an attachment ages. At 15 inches, a typical two-car driveway goes much faster than with a wand while still being small enough to maneuver along sidewalks and steps. Owners commonly praise how evenly it cleans concrete and how much spray it keeps off the siding and the car. The trade-offs are weight and maintenance: a steel deck is heavier than plastic, and the swivel needs occasional lubrication. Confirm the current pressure rating against your machine. Expect roughly $70 to $120 at the time of writing."
  },
  {
    "id": "ryobi-universal-surface-cleaner",
    "name": "Ryobi 15-Inch Surface Cleaner",
    "category": "15-inch, gas and higher-output washers",
    "badge": "Best Value",
    "amazonUrl": "",
    "pros": [
      "Widely available at Home Depot",
      "Quarter-inch quick connect fits most gas wands",
      "Caster wheels make it easy to push",
      "Priced below many steel-deck competitors"
    ],
    "cons": [
      "Lighter construction than premium decks",
      "Not suited to small electric machines",
      "Spin can slow at the low end of its pressure range"
    ],
    "bottomLine": "A good-value 15-inch attachment for mainstream gas machines.",
    "description": "Ryobi's 15-inch surface cleaner targets the same gas pressure washer class as the Simpson, and its wide availability at Home Depot makes it an easy pickup. It connects with a standard quarter-inch quick-connect plug, so it fits most gas wands regardless of brand. Caster wheels let it glide rather than drag, which owners commonly appreciate on long driveway runs. Construction is lighter than steel-deck competitors, and that keeps the price down; for homeowner use a few times a year, it is usually plenty. Where it struggles is at the bottom of its rated pressure range, where spin slows and cleaning becomes less even, so pair it with a machine near the middle of the range on the listing. It is not the right choice for a small electric washer. Check the current pressure and flow ratings before buying, as Ryobi's accessory listings are updated over time. Expect roughly $60 to $100 at the time of writing, which makes it one of the cheaper ways into a 15-inch cleaner."
  },
  {
    "id": "karcher-t-racer-t400",
    "name": "T-Racer Surface Cleaner by Karcher, for K-Series Washers",
    "category": "Electric, Karcher K-series",
    "badge": "Best for Electric Washers",
    "amazonUrl": "",
    "pros": [
      "Designed for Karcher electric pressure washers",
      "Light enough to use on walls and steps",
      "Splash guard keeps spray contained",
      "Matches the lower flow of electric machines"
    ],
    "cons": [
      "Fits Karcher's own connection, not universal",
      "Smaller cleaning path than gas attachments",
      "Not built for heavy commercial use"
    ],
    "bottomLine": "The cleanest way to get surface-cleaner results from a Karcher electric washer.",
    "description": "Karcher's T-Racer line is designed specifically for the company's K-series electric pressure washers, which run lower pressure and much lower flow than gas machines. That matching matters: a 15-inch gas-class cleaner on a 1.3 GPM electric spins slowly and cleans poorly, while the T-Racer's smaller deck and nozzle arrangement are sized to what the K-series pumps deliver. The result is even cleaning on patios, walkways and moderate driveways without stripes. Its lighter weight and handle design also let it work on vertical surfaces such as walls and garage doors, which heavier gas attachments cannot do comfortably. The obvious limitation is compatibility: it uses Karcher's own connection system, so it is only a sensible buy if you own a compatible Karcher. The cleaning path is narrower than a 15-inch deck, so large driveways take longer. Check which K-series models the current listing names, because Karcher updates its model names. Expect roughly $60 to $110 at the time of writing."
  },
  {
    "id": "sun-joe-spx-pca10",
    "name": "Sun Joe SPX-PCA10 10-Inch Pressure Washer Patio Cleaner",
    "category": "Electric, Sun Joe SPX series",
    "badge": "Best Budget Electric",
    "amazonUrl": "",
    "pros": [
      "Inexpensive add-on for Sun Joe electric washers",
      "Light and easy to handle",
      "Contains overspray on patios and walkways",
      "Sized for low-flow electric pumps"
    ],
    "cons": [
      "10-inch path is slow on full driveways",
      "Compatibility limited to specific Sun Joe models",
      "Light construction"
    ],
    "bottomLine": "A low-cost way to stop striping patios with a Sun Joe electric.",
    "description": "The Sun Joe SPX-PCA10 is a 10-inch patio cleaner built for the brand's popular SPX electric pressure washers. Electric machines in this class deliver modest flow, and a small deck with a matching nozzle setup is what lets them spin a cleaner at a useful speed. For patios, walkways, pool decks and small driveways, it removes the stripes and splash that come with a narrow wand tip, and owners commonly note how much drier they and the house walls stay. It is light, which makes it easy to steer but also means it is not built for heavy, frequent use. On a full two-car driveway, the 10-inch path means many passes; a gas machine with a 15-inch cleaner is a better tool for big jobs. Compatibility is limited to the Sun Joe models listed by the manufacturer, so check your model number before buying. Expect roughly $30 to $50 at the time of writing, which is cheap enough that most Sun Joe owners will find it worth adding."
  },
  {
    "id": "generac-surface-cleaner",
    "name": "Generac 15-Inch Pressure Washer Surface Cleaner",
    "category": "15-inch, gas pressure washers",
    "badge": "Best for Generac Owners",
    "amazonUrl": "",
    "pros": [
      "Designed alongside Generac's gas washers",
      "Quarter-inch quick connect for broad compatibility",
      "Durable deck for regular homeowner use",
      "Even cleaning on driveways and patios"
    ],
    "cons": [
      "Not for low-flow electrics",
      "Heavier than plastic-deck models",
      "Availability varies by retailer"
    ],
    "bottomLine": "A solid 15-inch option, especially for Generac pressure washer owners.",
    "description": "Generac's 15-inch surface cleaner is built for the brand's residential gas pressure washers and uses a standard quarter-inch quick-connect plug, so it also fits many other gas wands. It covers the same homeowner gas class as the Simpson and Ryobi, roughly 2,700 to 3,300 PSI at mainstream flows, and it delivers the same core benefit: a consistent standoff height and spinning nozzles that clean concrete evenly without the stripes a wand leaves. Owners commonly describe it as sturdy and straightforward to use on driveways and patios. Its main appeal is for people who already own a Generac machine and want an accessory the manufacturer designed for that pressure and flow. For other brands, compare its ratings with the Simpson and Ryobi and choose based on price and availability. It is not suited to low-flow electric pressure washers. Check the current listing for the rated pressure range and nozzle sizes. Expect roughly $70 to $120 at the time of writing, depending on retailer."
  },
  {
    "id": "briggs-stratton-surface-cleaner",
    "name": "Briggs and Stratton 15-Inch Surface Cleaner",
    "category": "15-inch, gas pressure washers",
    "badge": "Solid Alternative",
    "amazonUrl": "",
    "pros": [
      "Quarter-inch quick-connect plug",
      "Matched to mainstream homeowner gas machines",
      "Simple, low-maintenance design",
      "Often bundled or discounted with Briggs machines"
    ],
    "cons": [
      "Fewer replacement parts available than Simpson",
      "Not suited to electric washers",
      "Plastic components on some versions"
    ],
    "bottomLine": "A reasonable 15-inch choice when it is priced below the Simpson.",
    "description": "Briggs and Stratton sells a 15-inch surface cleaner for its residential gas pressure washers, with a quarter-inch quick-connect plug that fits most gas wands. Functionally, it does what the other 15-inch attachments here do: a spinning bar under a round deck holds the nozzles at a fixed height, so a driveway gets even cleaning in far less time than a wand requires. It suits the mainstream homeowner gas class, and owners commonly report good results on concrete driveways and patios. It earns its place as an alternative rather than a top pick because replacement nozzles and swivel parts can be harder to find than for Simpson, which matters over years of use. If you find it bundled with a Briggs machine or discounted below the Simpson and Generac, it is a sensible buy. Check the rated pressure range on the current listing against your machine before ordering. Expect roughly $60 to $110 at the time of writing."
  },
  {
    "id": "mi-t-m-surface-cleaner",
    "name": "Commercial 21-Inch Surface Cleaner by Mi-T-M",
    "category": "Large, high-flow commercial units",
    "badge": "Best for Large Areas",
    "amazonUrl": "",
    "pros": [
      "Large deck covers big areas quickly",
      "Commercial-grade construction",
      "Built for frequent, heavy use",
      "Good for long driveways and parking pads"
    ],
    "cons": [
      "Needs a high-flow machine, typically 3.5 GPM or more",
      "Expensive for occasional homeowner use",
      "Heavy and awkward on small patios"
    ],
    "bottomLine": "Worth it only if you own a high-flow machine and clean large areas often.",
    "description": "Mi-T-M builds commercial pressure washers and accessories, and its larger surface cleaners are designed for the high-flow machines used by contractors and property managers. A 21-inch deck covers ground fast, but it needs a lot of water to spin properly; manufacturers of this class commonly specify machines in the range of about 3.5 to 4 GPM or more. On a typical homeowner gas unit at 2.5 GPM, a deck this size spins slowly and leaves swirl marks, which is the most common mistake people make when they buy bigger thinking it will be faster. If you do own a high-flow machine and have a long driveway, a parking pad, a large pool deck, or you clean for others, a commercial cleaner like this is durable and efficient. For everyone else, a 15-inch homeowner attachment is the better tool. Check flow, pressure and connector requirements on the current listing carefully. Expect roughly $250 to $500 or more depending on configuration at the time of writing."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Surface Cleaner Attachments",
          item: "https://www.allmetalbrake.com/best-surface-cleaner-for-pressure-washer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which diameter fits a typical gas washer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homeowner gas machines running roughly 2,700 to 3,600 PSI at around 2.3 to 2.8 GPM, a 15-inch cleaner is the standard match. Larger decks need more flow to spin properly. For small electrics, choose a 10 to 11 inch attachment designed for your brand. Always check the attachment's listed pressure and flow range."
          }
        },
        {
          "@type": "Question",
          "name": "Will a gas surface cleaner work on an electric pressure washer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not well. Gas-class attachments need more flow than electrics supply, so they spin slowly and leave swirl marks. Most electric pressure washers also use proprietary fittings. Choose an attachment designed for your brand and model, such as the Karcher T-Racer for K-series or the Sun Joe SPX-PCA10 for SPX models."
          }
        },
        {
          "@type": "Question",
          "name": "Is a surface cleaner hard on concrete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On sound concrete at homeowner pressures, damage is uncommon, and a surface cleaner is gentler than a narrow wand tip because pressure is spread evenly. Old, weak or poorly finished concrete can lose surface sand if you linger. Keep moving, stay within the attachment's rated pressure, and avoid turbo nozzles on fragile surfaces."
          }
        },
        {
          "@type": "Question",
          "name": "Do I still need a cleaner or detergent?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For lightly dirty concrete, plain water with a surface cleaner often looks good. For oil, mildew, algae, rust or heavy grime, apply a driveway cleaner or degreaser first and let it dwell. The surface cleaner then lifts and rinses the loosened dirt. Chemistry and the attachment work best together."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my surface cleaner leave circles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Circles or swirl marks almost always mean the bar is spinning too slowly for your walking speed. Slow down, check that the nozzles are clear, confirm the swivel turns freely, and verify your machine's flow matches the attachment. Stopping with the trigger held also leaves bright circles."
          }
        },
        {
          "@type": "Question",
          "name": "Is asphalt safe to clean with a surface cleaner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, with care. Use the lower end of the pressure range, keep the deck moving, and avoid repeated passes over one spot, especially on older blacktop with loose aggregate. A surface cleaner is generally gentler on asphalt than a narrow wand tip, but soft or damaged asphalt may be better cleaned with a hose and brush."
          }
        },
        {
          "@type": "Question",
          "name": "How often should I replace surface cleaner nozzles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on use, water quality and pressure, so there is no fixed interval. Replace them when you notice weaker cleaning, uneven lanes or slower rotation that clearing the nozzles does not fix. Homeowners using the attachment a few times a year may go several seasons; frequent users should check them each season."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Driveway Cleaning & Stains",
    tags: [
      "best surface cleaner for pressure washer",
      "pressure washer surface cleaner attachment",
      "driveway surface cleaner",
      "15 inch surface cleaner",
      "electric pressure washer patio cleaner",
      "surface cleaner streaks"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Surface Cleaners</span> for Your Pressure Washer
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A surface cleaner turns driveway washing from a striped, two-hour wand job into an even, fast pass. The catch is fit: it has to match your machine's pressure, flow and connector.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#simpson-cleaning-surface-cleaner"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="12.1k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#how-it-works" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. How They Work</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Sizing by PSI and GPM</a>
          <a href="#fitment" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Connectors and Fit</a>
          <a href="#design" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Design Details</a>
          <a href="#technique" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Technique</a>
          <a href="#streaks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Fixing Streaks</a>
          <a href="#surfaces" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Which Surfaces</a>
          <a href="#maintenance" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Maintenance</a>
          <a href="#worth-it" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Is It Worth It</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A surface cleaner is a round deck with a spinning bar underneath that holds two or more nozzles. Instead of one narrow stripe of water, it sweeps a full circle a foot or more across, at a fixed height, so every square inch gets the same treatment. That is what eliminates the zebra stripes a hand wand leaves on concrete. The wrong attachment, though, spins too slowly on a small electric machine or chokes a large gas unit. The picks below are grouped by the machines they suit, followed by the sizing, technique and maintenance details that decide how well any of them works.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Seven Surface Cleaner Attachments, Ranked by Fit
          </h2>

          <p>
            We ranked these on manufacturer specifications such as diameter, pressure and flow ratings and connector type, on how well each matches common pressure washer classes, and on recurring themes in owner feedback. We did not run our own test plots. Prices are approximate ranges at the time of writing; always confirm ratings on the current listing.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
