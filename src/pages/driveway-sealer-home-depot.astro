                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Penetrating (concrete)</td>
                    <td class="px-4 py-4 text-gray-700">Silane or siloxane repellent</td>
                    <td class="px-4 py-4 text-gray-700">Concrete in salt and freeze-thaw areas</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Wet look (concrete)</td>
