                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical day (~4 sun hrs)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Great day (~5 sun hrs)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">100W</td>
