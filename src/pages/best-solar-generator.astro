                    <td class="px-4 py-4 text-gray-700">~960-1,200Wh</td>
                    <td class="px-4 py-4 text-gray-700">~1,200-1,500Wh</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">800W</td>
