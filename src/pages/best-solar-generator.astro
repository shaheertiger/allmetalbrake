---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Portable Power Station for Home Backup",
    "url": "/best-portable-power-station-for-home-backup/"
  },
  {
    "title": "Best Portable Power Station for Camping",
    "url": "/best-portable-power-station-for-camping/"
  },
  {
    "title": "Best Portable Chargers for Power Outages",
    "url": "/best-portable-chargers-for-power-outages/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "The Best Solar Generators: Power Stations Matched to Their Panels";
const description =
  "Seven solar generators paired with the panel wattage that refills them, with sun-hour math, MPPT input limits, series vs parallel wiring and cold-weather Voc.";

const PRODUCTS = [
  {
    "id": "ecoflow-delta-3-plus",
    "name": "EcoFlow Delta 3 Plus Portable Power Station",
    "category": "1kWh LFP, 1,800W, Expandable",
    "badge": "Best Overall Solar Generator",
    "amazonUrl": "",
    "pros": [
      "Room for a realistic 300-400W of panels",
      "1,800W output covers fridge starts and kitchen loads",
      "Expandable, so solar and storage can grow together",
      "Fast wall charging as a cloudy-day fallback"
    ],
    "cons": [
      "About 28 pounds, heavier than the Jackery 1000 v2",
      "120V only",
      "Some solar settings live in the app"
    ],
    "bottomLine": "The best-balanced battery-to-panel pairing for most households, with room to grow both sides.",
    "description": "The Delta 3 Plus is the easiest solar generator to get right. EcoFlow rates its battery at 1,024Wh of LFP, small enough that a modest panel set can genuinely refill it in a day: by the harvest math in this guide, 400W of portable panels on a clear summer day should deliver somewhere around 1.0-1.5kWh, which is a full battery with some left over to run loads while it charges. Drop to 300W and you still put back most of a day's fridge-and-internet use. That balance is why it leads this list. The 1,800W inverter is rated to start a refrigerator compressor, the battery covers an evening and overnight, and the panels pay it back the next day. Because the platform is expandable, you can add an extra battery later and grow the array alongside it rather than replacing the whole system. Pair it with EcoFlow's own folding panels for a tidy setup, or any compatible panel set within its published input range."
  },
  {
    "id": "jackery-explorer-1000-v2",
    "name": "Jackery Explorer 1000 v2 Portable Power Station",
    "category": "1kWh LFP, 1,500W, Lightest 1kWh",
    "badge": "Best Jackery Solar Generator",
    "amazonUrl": "",
    "pros": [
      "Light at about 24 pounds for 1,070Wh",
      "3,000W surge for motor start-ups",
      "Widely bundled with SolarSaga folding panels",
      "Simple controls with little to configure"
    ],
    "cons": [
      "Not expandable",
      "1,500W continuous is below the 1,800W rivals",
      "Single-panel bundles are undersized for daily refills"
    ],
    "bottomLine": "The lightest 1kWh solar generator here; buy it with two panels if you plan to cycle it daily.",
    "description": "If you search for a Jackery solar generator, this is the box you are most likely to land on, usually bundled with one or two of Jackery's SolarSaga folding panels. Jackery lists the Explorer 1000 v2 at 1,070Wh of LFP, 1,500W continuous with a 3,000W surge, and about 24 pounds, with a no-nonsense interface that suits campers and first-time buyers. The thing to watch is the bundle size. A single 200W panel puts back roughly 500-700Wh on a good day, which is about half this battery. That is fine for weekend camping, where you arrive full and only need to top up, but for outage use where you drain it nightly, two panels are the better pairing. Because the unit is not expandable, the solar side is the only part of the system you can grow, which is one more reason not to skimp on it."
  },
  {
    "id": "ecoflow-delta-pro-3",
    "name": "EcoFlow Delta Pro 3 Portable Power Station",
    "category": "4kWh LFP, 4,000W, 120/240V",
    "badge": "Best for Home Backup",
    "amazonUrl": "",
    "pros": [
      "4,096Wh base, expandable to whole-home scale",
      "120V and 240V output from one unit",
      "Two separate solar inputs for larger arrays",
      "Ties into EcoFlow transfer-switch hardware"
    ],
    "cons": [
      "About 114 pounds; it lives on its wheels",
      "Needs a big array to justify its battery",
      "Panel and house connections need planning and an electrician"
    ],
    "bottomLine": "The best solar generator for home backup, provided you give it a real array to drink from.",
    "description": "The Delta Pro 3 is a solar generator for people who mean generator. EcoFlow rates it at 4,096Wh of LFP with a 4,000W inverter and native 120/240V, enough on paper to run a fridge, freezer, furnace blower, lights and electronics together, and its two solar inputs let it accept a far larger array than any carry-size unit. That is the point: with 1,500W or more of rigid panels on a ground mount, a sunny day can put back most of what the house used overnight. Without that array, it is mostly an expensive battery. Folding panels in the 400W range barely dent a 4kWh pack, so plan the solar as part of the purchase, not as an afterthought. Connected through a transfer switch or EcoFlow's smart panel by a licensed electrician, it becomes a quiet, fuel-free backup that recharges itself."
  },
  {
    "id": "anker-solix-f3800",
    "name": "Anker SOLIX F3800 Portable Power Station",
    "category": "3.8kWh LFP, 6,000W, 120/240V",
    "badge": "Best for Heavy Loads",
    "amazonUrl": "",
    "pros": [
      "6,000W output with native 120/240V",
      "Two solar inputs for a large array",
      "Expandable with add-on batteries",
      "Handles 240V well pumps and big motor loads"
    ],
    "cons": [
      "Heaviest pick at about 132 pounds",
      "Overkill without 240V or heavy loads",
      "Big output drains the battery fast on cloudy days"
    ],
    "bottomLine": "The solar generator for well pumps and 240V loads; plan the array as carefully as the battery.",
    "description": "The SOLIX F3800 is the pick when the constraint is output rather than storage. Anker rates its inverter at 6,000W with native 120/240V, enough to start loads that would trip smaller units: a 240V deep-well pump, a fridge and window air conditioner together, or a short burst of emergency EV charging. Its 3,840Wh LFP battery is slightly smaller than the Delta Pro 3's, and like the EcoFlow it accepts a large array across two solar inputs and expands with add-on batteries. High output cuts both ways with solar. A system that can deliver 6,000W can also empty its battery in well under an hour, and no realistic home array refills it that fast. Pair it with as much panel as its inputs and your yard allow, keep the heavy loads short and scheduled for sunny hours, and it becomes a strong solar-plus-storage backbone for homes that rely on 240V equipment."
  },
  {
    "id": "jackery-explorer-2000-v2",
    "name": "Jackery Explorer 2000 v2 Portable Power Station",
    "category": "2kWh LFP, 2,200W, One-Person Lift",
    "badge": "Best Mid-Size",
    "amazonUrl": "",
    "pros": [
      "2,042Wh in a roughly 40-pound case",
      "2,200W output for most 120V appliances",
      "Still a one-person lift into a car or RV",
      "Pairs naturally with two or three folding panels"
    ],
    "cons": [
      "120V only",
      "Not expandable",
      "Needs more panel than many bundles include"
    ],
    "bottomLine": "The right size for long outages and RV trips when you want to lift it yourself and feed it with folding panels.",
    "description": "The Explorer 2000 v2 sits in the gap between carry-size and wheeled systems. Jackery lists a 2,042Wh LFP battery and a 2,200W inverter, which by the runtime math covers a fridge for about a day, or a fridge, CPAP, router and lights through a long night, and handles a microwave or a sump pump start. At about 40 pounds it still goes into an RV or car trunk without a ramp. On the solar side, think in pairs and threes. Two 200W folding panels give you around 1.0-1.4kWh on a clear day, which replaces roughly half to two-thirds of the battery; three panels get you close to a full refill in summer. That makes it a strong match for RV trips and for outages in sunny regions. Check the station's input limit before adding a third panel, because exceeding it simply wastes the extra glass."
  },
  {
    "id": "bluetti-elite-100-v2",
    "name": "Bluetti Elite 100 V2 Portable Power Station",
    "category": "1kWh LFP, 1,800W, Compact",
    "badge": "Best Compact Value",
    "amazonUrl": "",
    "pros": [
      "1,800W from a compact, roughly 25-pound case",
      "1,024Wh LFP matches the Delta 3 Plus on paper",
      "Accepts common third-party panels",
      "Often priced below the big two"
    ],
    "cons": [
      "Not expandable",
      "Smaller ecosystem of matched panels and accessories",
      "App is functional rather than polished"
    ],
    "bottomLine": "A capable 1kWh solar generator at a lower price, best paired with your own choice of panels.",
    "description": "The Elite 100 V2 is a good example of why buying station and panels separately can make sense. Bluetti rates it at 1,024Wh of LFP and 1,800W, matching the Delta 3 Plus for capacity and output in a lighter case, and it is frequently discounted. Bluetti's own panel range is smaller than EcoFlow's or Jackery's, but a pair of compatible 200W panels from another brand, wired within the station's published voltage range, gives it the same daily refill as any 1kWh system on this list. The trade-off is that the battery is fixed. If you later want more storage, you are buying a second unit, not an add-on pack. For a household that wants one capable 1kWh solar generator and is comfortable checking panel specs, that is an easy compromise."
  },
  {
    "id": "ecoflow-river-3-plus",
    "name": "EcoFlow River 3 Plus Portable Power Station",
    "category": "286Wh LFP, 600W, 10 lb",
    "badge": "Best Portable Solar Generator",
    "amazonUrl": "",
    "pros": [
      "About 10 pounds, with a panel that folds to briefcase size",
      "One 100-200W panel refills it in a day",
      "600W output for coolers, lights and small tools",
      "Optional extra battery for longer trips"
    ],
    "cons": [
      "286Wh is not fridge-backup territory",
      "Modest solar input limits panel upgrades",
      "No kettles, heaters or microwaves"
    ],
    "bottomLine": "The best portable solar generator for camping: small enough that one panel truly keeps it full.",
    "description": "The River 3 Plus is the purest example of a portable solar generator: a 10-pound LFP station and a single folding panel you can carry together from the car to a campsite. EcoFlow rates the battery at 286Wh, which is small, but that is exactly why solar works so well with it. A 100W panel puts back roughly 250-350Wh on a clear day, which is about a full refill; a 200W panel does it by early afternoon with margin for cloud. Its 600W inverter runs a 12V or AC cooler, lights, a CPAP without the heated humidifier, and every phone and camera in the group. Snap on EcoFlow's extra battery for a longer trip and step up to the larger panel."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Solar Generators",
          item: "https://www.allmetalbrake.com/best-solar-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is a solar generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A solar generator is a portable power station paired with solar panels. The station contains a lithium battery, an inverter that produces household AC power, and an MPPT charge controller that turns panel output into stored energy. Nothing is burned, so it is silent and safe indoors while the panels sit outside. The term is mostly marketing; what makes one good is how well battery size, input limits and panel wattage are matched."
          }
        },
        {
          "@type": "Question",
          "name": "How many solar panels do I need for a solar generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Divide the battery capacity in watt-hours by about three to get the panel wattage that refills it on a typical sunny day, or by 2.5 for margin. A 286Wh camping unit needs about 100W, a 1kWh station about 350-400W, a 2kWh station about 700-800W, and a 4kWh system about 1,300-1,650W. Use less if you only drain part of the battery, and always stay inside the station's input limits."
          }
        },
        {
          "@type": "Question",
          "name": "How long does it take to charge a solar generator with solar panels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on panel wattage, weather and battery size. Portable panels deliver roughly 60-75 percent of their rating in good sun, and a clear day offers about four to five peak sun hours. A 200W panel puts back about 500-700Wh a day, enough to refill a 286Wh unit by midday or half of a 1kWh station. With 400W, a 1kWh station refills in one sunny day."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use any solar panel with my power station?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually, if three things fit. The panel's open-circuit voltage, or the total for a series string, must stay below the station's maximum input voltage with cold-weather headroom. The current, or the total for panels in parallel, must not exceed the input rating. And you need the right connector or adapter. Wattage above the input limit will not harm the station but will be clipped at midday."
          }
        },
        {
          "@type": "Question",
          "name": "Should I wire my panels in series or parallel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Series adds voltage, parallel adds current, and total wattage is the same. Series is usually better when it fits the voltage window, because it reaches the controller's start threshold earlier and loses less power over long cables. Parallel is safer when series would exceed the maximum voltage, and it copes better with partial shade. Large stations with two inputs often work best with one series string on each."
          }
        },
        {
          "@type": "Question",
          "name": "Can a solar generator power a house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A large one can power a house's essential circuits, and with enough panels it can keep doing so through a long outage. Systems such as the EcoFlow Delta Pro 3 and Anker SOLIX F3800 store roughly 4kWh and are rated for 4,000-6,000W at 120/240V. Fed by 1,500-2,000W of rigid panels through a transfer switch, they can run a fridge, freezer, furnace blower, lights and internet. Central air and electric heat are beyond them."
          }
        },
        {
          "@type": "Question",
          "name": "Is a solar generator better than a gas generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Each wins in different situations. A solar generator is silent, produces no exhaust, runs indoors, needs no fuel storage and costs almost nothing to run once bought, which suits apartments, medical devices, camping and short outages. A gas generator delivers more power for longer at a lower upfront cost and keeps going through a week of storms. Many prepared households use both, with the gas unit refilling the battery during cloud."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "best solar generator",
      "solar generator for home",
      "solar panels for power station",
      "mppt input limits",
      "series vs parallel solar panels",
      "solar generator sizing"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Solar Generators</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A solar generator is only as good as the sun it can catch. Seven power stations paired with the right amount of panel, plus the math that decides whether the battery is full by dinner.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#ecoflow-delta-3-plus"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare the Pairings
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#pairings" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Pairings at a Glance</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The Seven Picks</a>
          <a href="#sun-hours" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Sun-Hours Math</a>
          <a href="#refill" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Solar to Refill Each Size</a>
          <a href="#input-limits" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. MPPT Input Limits</a>
          <a href="#wiring" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Series, Parallel and Voc</a>
          <a href="#panels" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Panel Type and Placement</a>
          <a href="#bundles" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Bundle or Separate?</a>
          <a href="#home-backup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Home-Backup Sizing</a>
          <a href="#choosing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Which Pairing to Buy</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A solar generator is a battery and a set of panels, and most buyers spend all their attention on the battery. The panels decide whether it is full again tomorrow.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="pairings" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Pairings at a Glance
          </h2>

          <p>
            Most solar generator shopping goes wrong in the same place: people compare batteries and treat the panels as an accessory. But a solar generator is a two-part system. The power station stores energy and turns it into household current; the panels decide how much of that energy comes back each day. A 4kWh battery fed by a single 200W folding panel is, for practical purposes, a 4kWh battery you can only refill from the wall. A 1kWh battery with 400W of well-aimed panels can be emptied every evening and be full again by mid-afternoon, day after day, for as long as the weather holds.
          </p>

          <p>
            So this guide works the other way round from our main <a href="/best-portable-power-station/">portable power station rankings</a>. It starts with the charge side: how many watts a panel actually delivers, how many sun hours you can count on, what the station's charge controller will accept, and how to wire panels so they stay inside its voltage window on a frosty morning. Then it pairs seven widely sold stations from EcoFlow, Jackery, Anker SOLIX and Bluetti with the amount of solar each one needs to be useful, from a 10-pound camping kit to a wheeled home-backup system feeding off a ground-mounted array.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE SHORT ANSWER</p>
            <p class="text-xl font-bold text-white mb-3">Roughly one watt of panel for every three watt-hours you want back each day.</p>
            <p class="text-gray-300 leading-relaxed m-0">Never exceed the station's solar input voltage or wattage. For most households that means a 1kWh LFP station with 300-400W of panels; for camping, a 286Wh unit with a single 100-200W panel; for real home backup, a 4kWh station with 1,200-2,000W of rigid panels on a ground mount.</p>
          </div>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Power station</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Battery</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">AC output</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Suggested solar</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Sunny-day refill</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">EcoFlow Delta 3 Plus</td>
                    <td class="px-4 py-4 text-gray-700">1,024Wh (expandable)</td>
