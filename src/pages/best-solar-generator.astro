---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/best-solar-generator.html?raw';

const title = "7 Best Solar Generators of 2026: Power Station + Panel Pairings";
const description = "The best solar generators pair the right power station with the right panels. EcoFlow, Jackery, Anker SOLIX and Bluetti compared, with sun-hour math, wiring and home-backup sizing.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
