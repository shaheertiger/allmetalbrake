                    <td class="px-4 py-4 text-gray-700">350-430W</td>
                    <td class="px-4 py-4 text-gray-700">175-215W</td>
                    <td class="px-4 py-4 text-gray-700">Delta 3 Plus, Explorer 1000 v2, Elite 100 V2</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">~2,000Wh</td>
                    <td class="px-4 py-4 text-gray-700">680-820W</td>
                    <td class="px-4 py-4 text-gray-700">340-410W</td>
                    <td class="px-4 py-4 text-gray-700">Explorer 2000 v2</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
