                    <td class="px-4 py-4 text-gray-700">Common</td>
                    <td class="px-4 py-4 text-gray-700">Rare when installed correctly</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Installation difficulty</td>
                    <td class="px-4 py-4 text-gray-700">Very easy</td>
                    <td class="px-4 py-4 text-gray-700">Moderate, weather dependent</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Haze risk</td>
                    <td class="px-4 py-4 text-gray-700">None</td>
                    <td class="px-4 py-4 text-gray-700">Yes, if done poorly</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Upkeep</td>
                    <td class="px-4 py-4 text-gray-700">Top up every year or two</td>
                    <td class="px-4 py-4 text-gray-700">Refresh every 3-10 years</td>
                  </tr>
