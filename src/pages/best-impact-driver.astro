const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Impact Driver",
          item: "https://www.allmetalbrake.com/best-impact-driver/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best impact driver for the money?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homeowners, the Ryobi PBLID02 offers the best value. It has a brushless motor, four modes including an Assist mode for self-tapping screws, and a rated 2,200 in-lbs of torque, on the ONE+ platform with hundreds of affordable tools. If you are on a pro platform already, the best value is always the driver that fits your existing batteries."
          }
        },
        {
          "@type": "Question",
          "name": "Is an impact driver better than a drill?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is better at driving long screws, structural fasteners and lag bolts, and it is easier on your wrist. A drill is better at drilling accurate holes, running large bits, and driving small screws to a repeatable depth thanks to its clutch. If you can only buy one, buy a drill; if you build anything, own both."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use an impact driver as a drill?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For small pilot holes with hex-shank drill bits, yes, and it works well. For clean, accurate holes, large spade bits, hole saws or masonry, no. The hammering action makes it less precise, and it cannot hold round-shank bits. Use a drill/driver for real drilling and keep the impact driver for fastening."
          }
        },
        {
          "@type": "Question",
          "name": "How much torque do I need in an impact driver?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every 18V or 20V driver on this list has enough for deck screws, structural screws and moderate lag bolts. Because each brand rates torque differently, do not shop by headline torque across brands. Look at speed modes, size and platform instead. A 12V driver is enough for cabinets, electrical work and most household projects."
          }
        },
        {
          "@type": "Question",
          "name": "Is Milwaukee or DeWalt better for impact drivers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both make excellent impact drivers. Milwaukee's 2953-20 has four drive modes and a short head; DeWalt offers the full-power DCF845 and the very short Atomic DCF850. The bigger decision is the battery platform, which our Milwaukee vs DeWalt guide covers in detail. Buy the driver that matches your drill's batteries."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need special bits for an impact driver?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Use bits labeled impact-rated, which are designed to survive repeated rotational blows. Standard bits are harder and more brittle and can crack or shatter. You also need hex-shank bits, because the impact driver's 1/4-inch hex collet cannot hold round-shank bits. Torx and square-drive bits grip better than Phillips."
          }
        },
        {
          "@type": "Question",
          "name": "Is a brushless impact driver worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Brushless motors run cooler, get more work from each battery charge and generally last longer than brushed motors, and they are standard on every current mid-range and pro impact driver. All seven picks here are brushless. A brushed driver is only worth considering at the very cheapest end, for occasional light use."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Hand Tools",
    tags: [
      "best impact driver",
      "impact driver",
      "cordless impact driver",
      "impact driver vs drill",
      "brushless impact driver",
      "best 12v impact driver"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The Best Impact Drivers
        </h1>
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          Seven brushless impact drivers from Milwaukee, DeWalt, Makita, Ryobi and Bosch, each matched to a job and a battery platform, with the specs the makers publish.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">11 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
