  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 7 Best Cinder Block Sealers: Penetrating vs. Coating Picks";
const description =
  "Seven sealers for concrete block walls, split into invisible penetrating repellents and paint-like waterproof coatings, with prep, coverage and reapply timing.";

const PRODUCTS = [
  {
    "id": "ghostshield-siloxa-tek-8500",
    "name": "Ghostshield Siloxa-Tek 8500",
    "category": "Silane-Siloxane Penetrating Repellent",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "Silane-siloxane blend suited to porous block and mortar",
      "Leaves no film and no change in appearance on most block",
      "Breathable, so moisture vapor can still escape",
      "Helps reduce efflorescence, spalling and freeze-thaw damage",
      "Usable on concrete, brick and pavers as well"
    ],
    "cons": [
      "Not intended to stop water under pressure from the soil side",
      "Can make later painting difficult",
      "Needs bare, clean, absorbent masonry"
