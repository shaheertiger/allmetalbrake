---
import Layout from '../layouts/Layout.astro';
import { NAV_GROUPS, groupId } from '../data/nav';

const allCategories = [
  {
    name: 'Driveway & Concrete Sealers',
    id: 'sealers',
    guides: [
      { title: 'Best Asphalt Driveway Sealer', description: 'Latex-ite Airport Grade is the best asphalt driveway sealer for most drives; 6 pails ranked by solids, filler and weather, with coats lasting 2 to 3 years.', badge: 'Top Pick', url: '/best-asphalt-driveway-sealer-reviews/' },
      { title: 'Best Concrete Driveway Sealer', description: 'Ghostshield Siloxa-Tek 8500 tops 6 concrete driveway sealers judged on road salt, tires and freeze-thaw; penetrating types are rated for 5 to 10 years.', badge: 'Top Pick', url: '/best-concrete-driveway-sealer-reviews/' },
      { title: 'Best Garage Floor Epoxy', description: 'Rust-Oleum EpoxyShield leads 6 garage floor epoxy kits; a water-based kit lasts about 3 to 5 years with daily parking, and 100% solids can last a decade.', badge: 'Top Pick', url: '/best-garage-floor-epoxy/' },
      { title: 'Best Garage Floor Mats', description: 'The AutoFloorGuard AFG7918 is the best garage floor mat for snowy climates; 7 picks covering containment mats, roll-out vinyl and 30x59-inch oil pads.', badge: 'Buyer\'s Guide', url: '/best-garage-floor-mats/' },
      { title: 'Best Garage Floor Tiles', description: 'Swisstrax Ribtrax Pro tops 6 garage floor tiles; tiling a 400 to 500 sq ft two-car garage runs about $900 to $3,000 in materials, laid in a day.', badge: 'Top Pick', url: '/best-garage-floor-tiles/' },
      { title: 'How to Get Oil Out of Concrete', description: 'Old oil sits a quarter inch or more into a slab, so scrubbing fails; 3 methods work: a poultice to pull it up, enzymes to digest it, or heat to loosen it.', badge: 'How-To', url: '/how-to-get-oil-out-of-concrete/' },
      { title: 'How Much Does It Cost to Seal a Driveway? (2026 Price Guide)', description: 'Sealing an asphalt driveway costs about $0.10 to $0.30 per sq ft DIY and $0.20 to $0.50 hired; an 800 sq ft two-car drive runs $100 to $250 in materials.', badge: 'How-To', url: '/how-much-does-it-cost-to-seal-a-driveway/' },
      { title: 'How to Remove Oil Stains from a Driveway: 7 Methods That Actually Work', description: 'Fresh driveway oil usually lifts in one evening: clay litter overnight, then 30 minutes of cleaning. Use dish soap on asphalt and a degreaser on concrete.', badge: 'How-To', url: '/how-to-remove-oil-stains-from-driveway/' },
      { title: 'When to Seal a New Asphalt Driveway', description: 'Wait about 6 to 12 months, or one full warm season, before sealing new asphalt; sealing sooner traps oils that keep the surface soft and prone to peeling.', badge: 'Guide', url: '/when-should-you-seal-a-new-asphalt-driveway/' },
      { title: 'Best Concrete Floor Paint', description: 'BEHR Premium 1-Part Epoxy is the best concrete floor paint for most slabs; 6 one-part picks sorted by room, good for 3 to 5 years when the prep is done right.', badge: 'Top Pick', url: '/best-concrete-floor-paint/' },
      { title: 'Epoxy Garage Floor Cost: How Much Should You Actually Pay?', description: 'Epoxying a two-car garage costs about $300 to $650 with a DIY water-based kit, $800 to $1,800 for a high-solids DIY system and $1,800 to $4,500 hired.', badge: 'Cost Guide', url: '/epoxy-garage-floor-cost/' },
    ],
  },
  {
    name: 'Paver & Masonry Sealers',
    id: 'pavers',
    guides: [
      { title: 'Best Basement Wall Sealer', description: 'DRYLOK Extreme is the best basement wall sealer for most damp block or concrete walls; 7 picks sorted by damp walls, seeping cracks and real water pressure.', badge: 'Review', url: '/best-basement-wall-sealer/' },
    ],
  },
  {
    name: 'Stone & Wood Sealers',
    id: 'stone-wood',
    guides: [
      { title: 'Best Deck Stains', description: 'Armstrong Clark semi-transparent is the top deck stain here; 7 picks sorted by wood species, sun exposure, old finish and how often you want to recoat.', badge: 'Review', url: '/best-deck-stain-reviews/' },
    ],
  },
  {
    name: 'Basement Waterproofing',
    id: 'basement-waterproofing',
    guides: [
      { title: 'Best Mold Removers', description: 'RMR-141 is the best mold remover for killing growth on most surfaces; 6 picks sorted by kill, stain removal and prevention, often with 10-minute contact.', badge: 'Buyer\'s Guide', url: '/best-mold-remover/' },
      { title: 'Best Basement Dehumidifiers', description: 'The Frigidaire 50-Pint FFAD5033W1 is the best dehumidifier for basements up to about 1,500 sq ft; 7 picks by real capacity, drainage and cold-room defrost.', badge: 'Top Pick', url: '/best-dehumidifier-for-basement/' },
      { title: 'Best Basement Wall Sealer', description: 'DRYLOK Extreme is the best basement wall sealer for most damp block or concrete walls; 7 picks sorted by damp walls, seeping cracks and real water pressure.', badge: 'Review', url: '/best-basement-wall-sealer/' },
      { title: 'Best 50-Pint Dehumidifiers', description: 'The Frigidaire 50-Pint with Wi-Fi is the best 50 pint dehumidifier for most basements; 5 picks by drainage, pump and alerts, plus the 2019 rating change.', badge: 'Buyer\'s Guide', url: '/best-50-pint-dehumidifier/' },
      { title: 'RMR-141 Review', description: 'RMR-141 kills mold as an EPA-registered fungicide with 0.14% quats, but only if the surface stays wet for 10 minutes; it won\'t remove stains or fix damp.', badge: 'Review', url: '/rmr-141-review/' },
      { title: 'Crawl Space Mold Removal', description: 'Crawl space mold under about 10 sq ft is a DIY job per EPA guidance; pros charge roughly $1,000 to $6,000. Fix the moisture, scrub, treat joists, keep it dry.', badge: 'How-To', url: '/crawl-space-mold-removal/' },
      { title: 'Does Bleach Kill Mold?', description: 'Bleach kills mold on tile, glass and tubs, but on wood and drywall it mostly whitens the stain. For mold over about 10 sq ft, EPA guidance points to a pro.', badge: 'Explainer', url: '/does-bleach-kill-mold/' },
      { title: 'Does Vinegar Kill Mold?', description: 'Only partly: in a 2015 study, vinegar at about 4% acetic acid slowed one common mold but had no effect on another, and no vinegar carries an EPA kill claim.', badge: 'Explainer', url: '/does-vinegar-kill-mold/' },
    ],
  },
  {
    name: 'Polymeric Sand & Pavers',
    id: 'polymeric-sand',
    guides: [
    ],
  },
  {
    name: 'Lawn & Yard Care',
    id: 'lawn',
    guides: [
      { title: 'Best Zero Turn Mowers', description: 'The Toro TITAN MAX 60-inch tops 6 zero-turn mowers for 3+ acres; the Ariens IKON XD 52 and Husqvarna Z254F suit most 1 to 3 acre properties for less money.', badge: 'Top Pick', url: '/best-zero-turn-mower/' },
      { title: 'Best Compact Tractors', description: 'The Kubota BX23S leads 6 compact tractors; sub-compacts with a loader run about $18,000 to $30,000, compacts $25,000 to $45,000. Sized for 2 to 20 acres.', badge: 'Buyer\'s Guide', url: '/best-compact-tractor/' },
      { title: 'Best Self-Propelled Lawn Mowers', description: 'The Toro Recycler 22-inch Personal Pace is the best self propelled lawn mower for most yards; 6 picks by front, rear or all-wheel drive, gas or battery.', badge: 'Top Pick', url: '/best-self-propelled-lawn-mower/' },
      { title: 'Best Gutter Guards', description: 'The Raptor stainless steel micro-mesh is the best gutter guard for most homes; 6 picks by debris, and only fine micro-mesh reliably keeps pine needles out.', badge: 'Top Pick', url: '/best-gutter-guards/' },
    ],
  },
  {
    name: 'Tools & Equipment',
    id: 'tools',
    guides: [
      { title: 'Best Shop Vacs', description: 'The Ridgid HD1400 is the best shop vac for most garages, with a 14-gallon tank and 2-1/2-inch hose. 7 picks for sawdust, drywall dust, debris and water.', badge: 'Top Pick', url: '/best-shop-vac/' },
      { title: 'Best Stud Finders', description: 'The Franklin ProSensor 710+ is the most reliable pick for drywall, and a magnet wins on plaster. 7 stud finders by wall type, plus 16-inch spacing tips.', badge: 'Top Pick', url: '/best-stud-finder/' },
      { title: 'Best Portable Power Stations', description: 'The EcoFlow DELTA 2 LFP tops 7 portable power stations; a 1,000Wh unit runs a typical fridge about 6 to 14 hours, and LiFePO4 is rated for 3,000+ cycles.', badge: 'Top Pick', url: '/best-portable-power-station/' },
      { title: 'Best Solar Generators', description: 'The EcoFlow Delta 3 Plus tops 7 solar generators; plan on about 1 watt of panel per 3 watt-hours of battery to refill a station on a typical sunny day.', badge: 'Buyer\'s Guide', url: '/best-solar-generator/' },
      { title: 'Best Power Stations for Home Backup', description: 'The EcoFlow Delta Pro 3 leads 6 power stations for home backup; a 4kWh-class unit on a transfer switch runs a fridge, sump pump and lights for roughly a day.', badge: 'Buyer\'s Guide', url: '/best-portable-power-station-for-home-backup/' },
      { title: 'Best Power Stations for Camping', description: 'The EcoFlow River 3 Plus is the best portable power station for camping in a tent, at about 300Wh; 6 picks scale to 1kWh for coolers and 2kWh for RV rigs.', badge: 'Buyer\'s Guide', url: '/best-portable-power-station-for-camping/' },
      { title: 'EcoFlow vs. Jackery', description: 'EcoFlow wins for home backup with add-on batteries and 1,800 W on the Delta 3 Plus; Jackery\'s Explorer 1000 v2 packs 1,070 Wh into about 24 lb for camping.', badge: 'Comparison', url: '/ecoflow-vs-jackery/' },
      { title: 'Best Portable Chargers for Outages', description: 'The Anker 737 PowerCore 24K is the best portable charger for most outages, good for 3 to 4 phone charges; 6 picks from power banks to 1 kWh power stations.', badge: 'Buyer\'s Guide', url: '/best-portable-chargers-for-power-outages/' },
      { title: 'The Best EcoFlow Power Stations', description: 'The EcoFlow Delta 3 Plus is the best EcoFlow for most people: 1,024Wh and 1,800W in about 28 pounds, with add-on batteries. 6 models matched to the job.', badge: 'Buyer\'s Guide', url: '/best-ecoflow-power-station/' },
      { title: 'The Best Jackery Power Stations', description: 'The Jackery Explorer 1000 v2 suits most people: 1,070Wh, 1,500W and a 3,000W surge in about 24 pounds. 6 Explorer v2 and Plus models ranked by use.', badge: 'Buyer\'s Guide', url: '/best-jackery-power-station/' },
      { title: 'The Best Anker Power Station', description: 'The Anker SOLIX C1000 is the best Anker power station for most people: 1,056Wh and 1,800W, expandable to about 2kWh. All 7 SOLIX models sorted by job.', badge: 'Buyer\'s Guide', url: '/best-anker-solix-power-station/' },
      { title: 'EcoFlow vs Bluetti', description: 'EcoFlow wins on charging speed, UPS and home integration; Bluetti on watt-hours per dollar. At 2kWh the 2,048Wh AC200L is the value pick. 4 classes compared.', badge: 'Comparison', url: '/ecoflow-vs-bluetti/' },
      { title: 'Home Battery Backup', description: 'The Tesla Powerwall 3, rated 11.5kW, leads 7 home battery backup systems; most homes need 10 to 30kWh of storage, from installed walls or expandable stations.', badge: 'Buyer\'s Guide', url: '/best-home-battery-backup/' },
      { title: 'The Best UPS Battery Backups for Computers, Routers and Home Offices', description: 'The CyberPower CP1500PFCLCD leads 6 UPS battery backups; a gaming PC drawing 500 watts needs a 1500VA unit rated 900 to 1,000 watts, and runtime is minutes.', badge: 'Buyer\'s Guide', url: '/best-ups-battery-backup/' },
      { title: 'The Best Power Inverters', description: 'The Renogy 1000W pure sine is the top inverter for vans and campers; 6 picks from a 300W socket plug-in to a 3,000W work-truck unit, with wiring rules.', badge: 'Buyer\'s Guide', url: '/best-power-inverter/' },
      { title: 'The Best Lithium RV Batteries', description: 'The Battle Born 100Ah leads 6 lithium RV batteries, from budget 100Ah LiFePO4 drop-ins to a 270Ah full-timer unit, with BMS, cold and charging rules.', badge: 'Buyer\'s Guide', url: '/best-lithium-rv-battery/' },
      { title: 'Battery Backup for CPAP', description: 'The EcoFlow River 3 Plus is the best CPAP battery backup for most; a 288Wh station on DC runs a 25-watt CPAP about 10 hours. 7 picks, plus FAA battery rules.', badge: 'Buyer\'s Guide', url: '/best-battery-backup-for-cpap/' },
      { title: 'The Best Solar Power Banks', description: 'The BigBlue 28W folding panel leads 7 solar power bank picks; a built-in cell makes only a watt or two, so filling a 10,000mAh bank from the sun takes days.', badge: 'Buyer\'s Guide', url: '/best-solar-power-bank/' },
      { title: 'Best Hand Crank Radios', description: 'The Midland ER310 is the best hand crank radio for most homes, with auto NOAA alerts, up to 45 hours rated runtime and a six-AA backup. 6 picks in all.', badge: 'Buyer\'s Guide', url: '/best-hand-crank-radio/' },
      { title: 'The Best Portable Solar Panels', description: 'The EcoFlow 220W Bifacial is the top portable solar panel pick; 7 panels compared on connectors and Voc, and most deliver 60 to 80% of rated watts at midday.', badge: 'Buyer\'s Guide', url: '/best-portable-solar-panel/' },
      { title: 'Best 12V Fridge for Camping', description: 'The Dometic CFX3 45 is the best 12V fridge for camping for most trips; 7 picks from a 20-liter cab cooler to a 75-liter dual-zone, with watt-hour math.', badge: 'Buyer\'s Guide', url: '/best-12v-fridge-for-camping/' },
      { title: 'Best Portable Air Conditioner for Camping', description: 'The EcoFlow Wave 3 leads 6 camping air conditioners; a 1kWh battery runs a 5,000 to 6,000 BTU unit for about 2 hours of strong cooling, so size it right.', badge: 'Buyer\'s Guide', url: '/best-portable-air-conditioner-for-camping/' },
      { title: 'The Best Battery Powered Fans', description: 'The Ryobi ONE+ 18V WhisperSeries is the best battery powered fan if you own Ryobi packs; 7 picks by battery type, and an 18V 4Ah pack holds about 72 Wh.', badge: 'Buyer\'s Guide', url: '/best-battery-powered-fan/' },
      { title: 'The Best Emergency Lanterns', description: 'The Goal Zero Lighthouse 600 is the best main outage lantern, and 200 to 300 lumens lights a living room. 7 picks, from rechargeable lanterns to a headlamp.', badge: 'Buyer\'s Guide', url: '/best-emergency-lantern/' },
      { title: 'The Best RV Generators', description: 'The Honda EU3000iS leads 7 RV generators; plan on about 3,000 running watts to start a 13,500 BTU rooftop AC without a soft starter. Picks for 30 and 50 amp.', badge: 'Buyer\'s Guide', url: '/best-rv-generator/' },
      { title: 'The Best Generators for Camping', description: 'The Honda EU2200i leads 7 camping picks; a 1,000-watt inverter runs phones, lights and a 12V fridge, while kettles and hot plates need 2,000 to 2,500 watts.', badge: 'Buyer\'s Guide', url: '/best-generator-for-camping/' },
      { title: 'Best Generator for Well Pump', description: 'The Westinghouse WGen7500DF tops 7 well pump generators; a 1/2 to 1 HP, 240V submersible pump needs a 7,500 to 10,000-watt unit with a 120/240V outlet.', badge: 'Buyer\'s Guide', url: '/best-generator-for-well-pump/' },
      { title: 'The Best Indoor Heaters for Power Outages', description: 'The Mr. Heater Portable Buddy is the indoor heater for power outage use most homes need; a 1-lb cylinder lasts 2 to 5 hours; 7 picks start with a CO alarm.', badge: 'Buyer\'s Guide', url: '/best-indoor-heater-for-power-outage/' },
      { title: 'Milwaukee vs DeWalt: Which Tool Brand Is Actually Better?', description: 'Milwaukee covers most M18 and M12 tools for 5 years versus DeWalt\'s 3 plus a free service year; Milwaukee suits the trades, DeWalt carpentry and bundle deals.', badge: 'Comparison', url: '/milwaukee-vs-dewalt/' },
      { title: 'Best Cordless Drills', description: 'The Milwaukee M18 FUEL 2903-20 is the best cordless drill overall, and the lighter DeWalt DCD800 suits most homes; 7 picks across 12V, 18V and 20V.', badge: 'Buyer\'s Guide', url: '/best-cordless-drill/' },
      { title: 'Best Impact Drivers', description: 'The Milwaukee M18 FUEL 2953-20 is the best impact driver overall; the Ryobi PBLID02, rated 2,200 in-lbs, is the value pick. 7 brushless drivers by platform.', badge: 'Buyer\'s Guide', url: '/best-impact-driver/' },
      { title: 'The Best Battery Packs With an AC Outlet', description: 'The Anker SOLIX C300X is the pick for most people: 288Wh of LiFePO4 and a 300W pure sine outlet. 6 packs sized by what 300 to 600 watts of AC really runs.', badge: 'Buyer\'s Guide', url: '/best-battery-pack-with-ac-outlet/' },
      { title: 'The Best Portable EV Chargers', description: 'The Tesla Mobile Connector is the best portable EV charger for Tesla owners, and the Lectron 32A suits J1772 cars; at 32 amps you get about 7.7 kW. 5 picks.', badge: 'Buyer\'s Guide', url: '/best-portable-ev-charger/' },
      { title: 'The Best Miter Saw Stands', description: 'The DEWALT DWX723 leads 7 miter saw stands; full-size stands support stock out to about 16 feet in total. Picks span folding, rolling and compact designs.', badge: 'Buyer\'s Guide', url: '/best-miter-saw-stand/' },
      { title: 'The Best Jobsite Table Saws', description: 'The DEWALT DWE7491RS is the best jobsite table saw for most buyers, with a 32-1/2 inch rip and rack-and-pinion fence; 7 picks, including SawStop for safety.', badge: 'Buyer\'s Guide', url: '/best-jobsite-table-saw/' },
    ],
  },
  {
    name: 'Home Appliances',
    id: 'appliances',
    guides: [
      { title: 'Best Water Filtration Systems for Home', description: 'The SpringWell CF1 is the best whole-house water filter for most city homes, paired with under-sink RO for drinking; 6 systems from whole-house to countertop.', badge: 'Top Pick', url: '/best-water-filtration-system-for-home/' },
      { title: 'Best Under Sink Water Filters', description: 'The Aquasana Claryum 3-Stage is the best under sink water filter for most homes, certified to NSF/ANSI 42, 53 and 401 for lead and PFOA/PFOS; 6 picks.', badge: 'Buyer\'s Guide', url: '/best-under-sink-water-filter/' },
      { title: 'Best Reverse Osmosis Systems', description: 'The Waterdrop G3P800 is the best reverse osmosis system for most kitchens: 800 GPD, a 3:1 pure-to-drain ratio and NSF/ANSI 58. 6 picks by style and waste.', badge: 'Buyer\'s Guide', url: '/best-reverse-osmosis-system/' },
      { title: 'Best Shower Head Filters', description: 'The Sprite HO2-WH is the pick for most people: certified to NSF/ANSI 177 for chlorine, 2.5 gpm, and it keeps your shower head. 6 filters, no softening myths.', badge: 'Buyer\'s Guide', url: '/best-shower-head-filter/' },
      { title: 'Best Water Filter Pitchers', description: 'The Brita Large 10-Cup with Elite filter tops 6 pitchers; it is certified to NSF/ANSI 53 for lead, which Brita\'s standard and Stream filters are not.', badge: 'Top Pick', url: '/best-water-filter-pitcher/' },
      { title: 'Best Gas Water Heaters', description: 'The A.O. Smith Signature 100 is the top gas water heater pick; 6 tanks from 40 to 75 gallons, and a family of 4 needs a 75 to 90 gallon first-hour rating.', badge: 'Top Pick', url: '/best-gas-water-heater/' },
      { title: 'The Best Chest Freezers', description: 'The GE 7.0 cu ft Garage Ready is the top chest freezer pick; 6 models from 3.5 to 7 cu ft, and a full freezer stays safe about 48 hours without power.', badge: 'Buyer\'s Guide', url: '/best-chest-freezer/' },
      { title: 'The Best Small Window Air Conditioners for Bedrooms and Narrow Windows', description: 'The Midea U-Shaped 8,000 BTU inverter is the quietest of 6 picks; Energy Star suggests 5,000 BTU for 100 to 150 sq ft. Slider windows get their own pick.', badge: 'Buyer\'s Guide', url: '/best-small-window-air-conditioner/' },
      { title: 'The Best Portable Washers', description: 'The BLACK+DECKER BPWM16W leads 6 portable washers; a 1.6 cu ft fully automatic model suits 1 or 2 people and runs itself once hooked to the sink faucet.', badge: 'Buyer\'s Guide', url: '/best-portable-washer/' },
      { title: 'The Best Portable Dryers', description: 'The Magic Chef MCSDRY15W tops 5 portable dryers; a 2.6 cu ft 120V compact plugs into a standard outlet, though many manuals call for a dedicated 20A circuit.', badge: 'Buyer\'s Guide', url: '/best-portable-dryer/' },
    ],
  },
  {
    name: 'Home Improvement',
    id: 'home',
    guides: [
      { title: 'Best Exterior Caulk', description: 'DAP Dynaflex 230 is the best exterior caulk for most painted homes; 7 picks sorted by movement rating, adhesion and paintability on siding, trim and brick.', badge: 'Top Pick', url: '/best-exterior-caulk/' },
      { title: 'Best Vinyl Plank Flooring', description: 'COREtec Plus Premium leads 7 vinyl plank lines; a rigid core with a 12 to 20 mil wear layer and attached pad is the sweet spot for most rooms in most homes.', badge: 'Top Pick', url: '/best-vinyl-plank-flooring/' },
      { title: 'Dryer Cords for 3-Prong and 4-Prong Outlets', description: 'The Certified Appliance Accessories 4-wire 30 amp cord is the best dryer cord for NEMA 14-30 outlets; 6 picks for 3- and 4-prong, and why to skip adapters.', badge: 'Buyer\'s Guide', url: '/best-dryer-cord/' },
      { title: 'The Best Home Energy Monitors', description: 'The Emporia Vue 3 tops 6 home energy monitors, reading up to 16 circuits directly; Sense, a meter gateway and smart plugs cover other needs. 3 types compared.', badge: 'Buyer\'s Guide', url: '/best-home-energy-monitor/' },
      { title: 'The Best Battery Powered Water Pumps for Draining, Transfer and RV Water', description: 'The Milwaukee M18 2771-20 leads 6 battery and 12V water pumps; RV fresh-water systems usually need about 3 GPM at 45 to 55 psi, which is a different pump.', badge: 'Buyer\'s Guide', url: '/best-battery-powered-water-pump/' },
    ],
  },
  {
    name: 'Generators & Backup Power',
    id: 'generators',
    guides: [
      { title: 'Best Home Generator for Power Outages', description: 'The Generac Guardian 22kW leads 7 outage generators; essentials alone need about 3,500 to 5,000 running watts, and a sump or well pump pushes that higher.', badge: '#1 Guide', url: '/best-home-generator-for-power-outages/' },
      { title: 'Best Dual Fuel Generators', description: 'The Westinghouse WGen9500DF leads 6 dual fuel generators, losing about a tenth of its power on propane and lasting about 7 hours on a 20 lb tank at half load.', badge: 'Buyer\'s Guide', url: '/best-dual-fuel-generator/' },
      { title: 'Best Inverter Generators', description: 'The Honda EU2200i is the best inverter generator for most, rated 48 to 57 dBA at about 47 lb; the Westinghouse iGen4500 gives 3,700 running watts. 7 picks.', badge: 'Buyer\'s Guide', url: '/best-inverter-generator/' },
      { title: 'Best Gas Generators', description: 'The Generac GP8000E leads 6 gas generators; an 8,000-watt open frame at half load burns roughly 14 to 19 gallons a day, so each pick comes with a fuel plan.', badge: 'Buyer\'s Guide', url: '/best-gas-generator/' },
      { title: 'Best Small Generators for Home', description: 'The Honda EU2200i is the best small generator for home outages; 6 picks, and 2,500 to 4,000 running watts covers a fridge, freezer, lights and furnace blower.', badge: 'Buyer\'s Guide', url: '/best-small-generator-for-home/' },
      { title: 'Generator Transfer Switch Guide', description: 'The Reliance 31406CRK 30-amp kit is the generator transfer switch most homes need for an L14-30 generator; 6 Reliance parts, furnace switch to inlet box.', badge: 'Buyer\'s Guide', url: '/best-generator-transfer-switch/' },
      { title: 'The Best Fuel Transfer Pumps for Generators, Equipment and Boats', description: 'For refueling a generator from 5-gallon cans, the TERA PUMP TRFA01 battery pump is the pick; 5 pumps sorted by approved fuel, power source and job.', badge: 'Buyer\'s Guide', url: '/best-fuel-transfer-pump/' },
      { title: 'The Best RV Power Adapters', description: 'Camco PowerGrip dogbones are the best RV power adapters for most 30-amp rigs, used behind an EMS such as the EMS-PT30X; 6 picks for 30- and 50-amp hookups.', badge: 'Buyer\'s Guide', url: '/best-rv-power-adapter/' },
    ],
  },
  {
    name: 'Gift Guides',
    id: 'gifts',
    guides: [
    ],
  },
  {
    name: 'Outdoor Living, Pool & Spa',
    id: 'outdoor-living',
    guides: [
    ],
  },
  {
    name: 'Fitness & Outdoor Gear',
    id: 'fitness',
    guides: [
    ],
  },
  {
    name: 'Men\'s Grooming',
    id: 'grooming',
    guides: [
    ],
  },
];

// Regroup the guide cards under the site's navigation categories.
const cards = new Map(allCategories.flatMap((c) => c.guides).map((g) => [g.url, g]));
const categories = NAV_GROUPS.map((group) => ({
  name: group.label,
  id: groupId(group.label),
  guides: group.links.map((l) => cards.get(l.url) ?? { title: l.title, description: l.blurb, badge: 'Guide', url: l.url }),
}));
const allGuides = categories.flatMap(c => c.guides);

const bestOfSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://www.allmetalbrake.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Best Lists',
          item: 'https://www.allmetalbrake.com/best-of/',
        },
      ],
    },
    {
      '@type': 'CollectionPage',
      name: 'Best Guides of 2026 | All Metal Brake',
      description: "Buying guides for driveways, concrete, decks, basements, backup power, lawn equipment and tools, built from spec sheets, labels and owner reports.",
      url: 'https://www.allmetalbrake.com/best-of/',
    },
    {
      '@type': 'ItemList',
      name: 'Best Guides of 2026 | All Metal Brake',
      description: "Buying guides for driveways, concrete, decks, basements, backup power, lawn equipment and tools, built from spec sheets, labels and owner reports.",
      itemListElement: allGuides.map((guide, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        item: {
          '@type': 'Article',
          name: guide.title,
          description: guide.description,
          url: `https://www.allmetalbrake.com${guide.url}`,
        },
      })),
    },
  ],
};
---
<Layout
  title="Best Guides of 2026"
  description="Every All Metal Brake buying guide by category: driveway and concrete sealers, decks, basements, generators, mowers and tools. No sponsored picks."
  jsonLd={bestOfSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <header class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-yellow-50 text-yellow-700 text-sm font-black uppercase tracking-widest border border-yellow-200 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"></circle><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path></svg>
        Updated for 2026
      </div>
      <h1 class="text-4xl lg:text-7xl font-black text-[#333333] mb-6 tracking-tight">
        All <span class="text-[#1E90FF]">Buying</span> Guides
      </h1>
      <p class="text-xl text-gray-500 max-w-2xl mx-auto mb-8">
        {allGuides.length} in-depth guides covering driveways and concrete, garage floors, basements and water, backup power, and yard and tools. Sourced specs, honest verdicts, zero sponsored picks.
      </p>

      <!-- Quick Navigation -->
      <div class="flex flex-wrap justify-center gap-2 mb-8">
        {categories.map(cat => (
          <a href={`#${cat.id}`} class="px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-bold text-gray-700 hover:bg-[#1E90FF] hover:text-white hover:border-[#1E90FF] transition-colors no-underline">
            {cat.name}
          </a>
        ))}
      </div>

      <!-- Testing Methodology -->
      <div class="max-w-3xl mx-auto bg-gray-50 border border-gray-200 rounded-2xl p-6 text-left">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 bg-[#1E90FF]/10 rounded-xl flex items-center justify-center shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E90FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>
          </div>
          <div>
            <p class="font-bold text-gray-900 text-sm mb-1">How We Pick</p>
            <p class="text-gray-600 text-sm leading-relaxed">
              Picks are chosen from manufacturer data sheets, labels, manuals and warranty terms, checked against long-run owner reports. Most products are not physically tested by us, and each guide says exactly what it relied on. No paid placements.
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- Categorized Guides -->
    {categories.map(category => (
      <section id={category.id} class="mb-16">
        <h2 class="text-2xl lg:text-3xl font-black text-[#333333] mb-8 pb-4 border-b-2 border-gray-200">
          {category.name}
          <span class="text-base font-normal text-gray-400 ml-3">{category.guides.length} guides</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {category.guides.map(guide => (
            <a
              href={guide.url}
              class="block bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-xl hover:border-[#1E90FF]/30 transition-all group no-underline"
            >
              <div class="flex items-center gap-2 mb-3">
                <span class="bg-[#FF4500]/10 text-[#FF4500] px-2.5 py-0.5 rounded-full text-xs font-black uppercase">
                  {guide.badge}
                </span>
              </div>
              <h3 class="text-lg font-black text-gray-900 group-hover:text-[#1E90FF] transition-colors mb-2">
                {guide.title}
              </h3>
              <p class="text-gray-500 text-sm mb-4 leading-relaxed">{guide.description}</p>
              <div class="flex items-center gap-1 text-[#1E90FF] text-sm font-bold">
                Read Guide
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- ========== WHY TRUST OUR PICKS ========== -->
    <section class="mt-8 mb-8">
      <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl overflow-hidden">
        <div class="p-10 lg:p-14">
          <h2 class="text-3xl font-black text-white mb-6">Why Trust Our Guides?</h2>
          <p class="text-gray-400 leading-relaxed mb-6">
            We evaluate every product using a rigorous scoring system across five dimensions:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">1</span>
              <p class="font-bold text-white text-sm">Performance (30%)</p>
              <p class="text-gray-400 text-xs">Real-world effectiveness, durability, and consistency over time.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">2</span>
              <p class="font-bold text-white text-sm">Build Quality (20%)</p>
              <p class="text-gray-400 text-xs">Materials, construction, and long-term durability.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">3</span>
              <p class="font-bold text-white text-sm">Value for Money (20%)</p>
              <p class="text-gray-400 text-xs">Price relative to performance at every price point.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">4</span>
              <p class="font-bold text-white text-sm">Ease of Use (20%)</p>
              <p class="text-gray-400 text-xs">Application difficulty, ergonomics, and learning curve.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">5</span>
              <p class="font-bold text-white text-sm">Community (10%)</p>
              <p class="text-gray-400 text-xs">Reddit, forums, and verified reviews to validate findings.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
