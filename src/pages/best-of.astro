---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import RelatedCards from '../components/RelatedCards.astro';
import { articles, hubLabel } from '../lib/data';
import { breadcrumbs, graph, itemList } from '../lib/schema';
const roundups = articles.filter((a) => a.kind === 'roundup');
const order = ['generator', 'inverter', 'dual-fuel', 'camping-rv', 'power-station', 'home-battery', 'solar', 'transfer-switch', 'surge', 'ups', 'cpap', 'power-inverter', 'power-bank', 'lantern', 'radio', 'fan', 'heater', 'fuel-pump'];
const groups = order.map((h) => ({ hub: h, items: roundups.filter((a) => a.hub === h) })).filter((g) => g.items.length);
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Best Lists', url: '/best-of/' }];
---
<Base title="Best Backup Power Gear (2026): Every Best-Of List in One Place" description={`All ${roundups.length} of our backup power best lists: generators, power stations, home batteries, transfer switches and outage gear, each matched to the loads you run.`} schema={graph(breadcrumbs(crumbs), itemList(roundups.map((a) => ({ name: a.h1, url: `/${a.slug}/` }))))}>
  <PageHeader h1="Every Backup Power Best List" crumbs={crumbs} eyebrow="Best Lists" intro="Each list is built for one buying question, with picks by load, fuel and budget. Start with the generator or power station, then the connection, then the outage extras." />
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    {groups.map((g) => (<section class="mt-10"><h2 class="text-xl font-extrabold text-ink">{hubLabel(g.hub)}</h2><RelatedCards articles={g.items} /></section>))}
  </div>
</Base>
