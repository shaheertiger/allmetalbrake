---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import CatIcon from '../components/CatIcon.astro';
import ProductImage from '../components/ProductImage.astro';
import { CATEGORIES } from '../data/categories';
import { articles, productMap, articleUrl, shortName } from '../lib/data';
import { breadcrumbs, graph, itemList } from '../lib/schema';
const roundups = articles.filter((a) => a.kind === 'roundup');
const reviews = articles.filter((a) => a.kind === 'review');
const guides = articles.filter((a) => a.kind === 'guide');
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Best Lists', url: '/best-of/' }];
const schema = graph(breadcrumbs(crumbs), { '@type': 'CollectionPage', name: 'Best backup power lists', url: 'https://www.allmetalbrake.com/best-of/' }, itemList(articles.map((a) => ({ name: a.h1, url: articleUrl(a) }))));
---
<Base title="Best Backup Power Gear (2026): Every Best-Of List in One Place" description={`All ${roundups.length} of our backup power best lists: generators, power stations, home batteries, transfer switches and outage gear, each matched to the loads you run.`} schema={schema}>
  <div class="wrap hub">
    <Crumbs items={crumbs} />
    <h1 class="hub-title">Backup Power: Every Best List</h1>
    <p class="hub-dek">Each list is built for one buying question, with picks by load, fuel and budget. Start with the generator or power station, then the connection, then the outage extras.</p>
    <nav class="chips" aria-label="Categories">{CATEGORIES.filter((c) => roundups.some((a) => a.hub === c.key)).map((c) => <a href={`#${c.key}`}>{c.label}</a>)}</nav>
    {CATEGORIES.map((c) => {
      const list = roundups.filter((a) => a.hub === c.key);
      return list.length > 0 && (
        <section id={c.key}>
          <h2 class="section-title"><CatIcon cat={c.key} size={34} /> {c.label}</h2>
          <div class="grid grid-3">
            {list.map((a) => {
              const top = a.picks?.[0] ? productMap.get(a.picks[0].product) : undefined;
              return <a class="card" href={articleUrl(a)}>{top && <ProductImage p={top} size={88} />}<span class="card-k">{c.label}</span><h3>{a.h1}</h3><span class="card-sub">{a.picks?.length} picks{top && ` · Top: ${shortName(top.name)}`}</span></a>;
            })}
          </div>
        </section>
      );
    })}
    {reviews.length > 0 && (
      <section id="brand-reviews">
        <h2 class="section-title">Brand Reviews</h2>
        <div class="grid grid-3">{reviews.map((a) => <a class="card" href={articleUrl(a)}><span class="card-k">Brand Review</span><h3>{a.h1}</h3><span class="card-sub">{a.picks?.length} models ranked</span></a>)}</div>
      </section>
    )}
    {guides.length > 0 && (
      <section id="guides">
        <h2 class="section-title">Costs, Lifespans and Explainers</h2>
        <div class="grid grid-3">{guides.map((a) => <a class="card" href={articleUrl(a)}><span class="card-k">Guide</span><h3>{a.h1}</h3><span class="card-sub">{a.metaDescription}</span></a>)}</div>
      </section>
    )}
  </div>
</Base>
