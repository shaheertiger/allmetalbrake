---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Concrete Floor Paint",
    "url": "/best-concrete-floor-paint/"
  },
  {
    "title": "Best Paint Sprayer",
    "url": "/best-paint-sprayer/"
  },
  {
    "title": "Best Basement Floor Paint",
    "url": "/best-basement-floor-paint/"
  },
  {
    "title": "Best Deck Paint",
    "url": "/best-deck-paint/"
  },
  {
    "title": "Best Exterior Caulk",
    "url": "/best-exterior-caulk/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 7 Best Porch Paints for Wood and Concrete Floors";
const description =
  "Seven porch floor enamels ranked for wood boards and concrete slabs, with sheen, traction, color heat and repaint advice so a porch floor stays sharp for years.";

const PRODUCTS = [
  {
    "category": "Premium acrylic floor enamel",
    "name": "Benjamin Moore Floor & Patio Latex Enamel",
    "badge": "Best Overall",
    "id": "benjamin-moore-floor-patio",
    "amazonUrl": "",
    "pros": [
      "Rated for wood and concrete floors, inside and out",
      "Full Benjamin Moore color range, including historic porch shades",
      "Low-luster and satin options hide wear well",
      "Good mildew resistance in the dried film",
      "Dealer staff can advise on primers for bare wood"
    ],
    "cons": [
      "Premium price per gallon",
      "Not as hard as epoxy-modified products on concrete"
    ],
    "bottomLine": "The best balance of looks, durability and color choice for most painted porches, wood or concrete.",
    "description": "Benjamin Moore's Floor and Patio enamel takes the top spot because it handles the two porch surfaces most homes have, wood boards and concrete slabs, with one product and one color system. It is a water-based acrylic latex floor enamel that stays flexible enough to move with wood as it swells and shrinks with the seasons, while resisting scuffing from shoes and furniture. Being able to tint it to any Benjamin Moore color matters on a porch, where the floor should coordinate with trim, shutters and the front door, and the brand's historic palette includes the traditional porch grays and greens many older homes call for. The low-luster and satin sheens look appropriate on a period porch and hide footprints better than gloss. Benjamin Moore lists a mildew-resistant film, which helps on shaded porches. Owner feedback is generally strong on color retention and wear. The trade-off is price, and on bare wood it still needs the right primer underneath."
  },
  {
    "category": "Acrylic porch and floor enamel",
    "name": "Sherwin-Williams Porch & Floor Enamel",
    "badge": "Best for High Traffic",
    "id": "sherwin-williams-porch-floor",
    "amazonUrl": "",
    "pros": [
      "Water-based enamel made specifically for porch and floor use",
      "Satin and gloss options",
      "Rated for wood and concrete, interior and exterior",
      "Tints to Sherwin-Williams' full color system",
      "Frequent store sales cut the price considerably"
    ],
    "cons": [
      "Full price is high compared with big-box brands",
      "Sold primarily through Sherwin-Williams stores"
    ],
    "bottomLine": "A tough, widely respected porch enamel, best bought during one of Sherwin-Williams' regular sales.",
    "description": "Sherwin-Williams' Porch and Floor Enamel is a water-based floor enamel built for the kind of foot traffic a busy front porch, back stoop or mudroom gets. It is rated for both wood and concrete, interior and exterior, and is available in satin and gloss, with gloss being the harder-wearing and easier to clean of the two, though more slippery when wet. Because it tints to the full Sherwin-Williams color system, matching existing trim or a historic scheme is straightforward. Contractors use it widely, and Sherwin-Williams stores can advise on primers for bare wood, chalky old paint or new concrete. The main drawback is cost: at full retail it sits near the top of the range, but Sherwin-Williams runs regular sales that bring it down considerably, so timing the purchase is worth it. Owner feedback tends to praise its durability on high-traffic porches, with the usual caution that it needs sound, clean wood or properly etched concrete underneath."
  },
  {
    "category": "Acrylic floor enamel, low luster",
    "name": "BEHR Premium Low-Lustre Porch & Patio Floor Paint",
    "badge": "Best Value",
    "id": "behr-porch-patio-low-luster",
    "amazonUrl": "",
    "pros": [
      "Widely available at Home Depot with in-store tinting",
      "Low-luster sheen hides scuffs and footprints",
      "Rated for wood and concrete floors, interior and exterior",
      "Good price for a name-brand floor enamel",
      "Easy water cleanup"
    ],
    "cons": [
      "Low-luster finish is slightly harder to wipe clean than satin or gloss",
      "Like all latex enamels, it softens under rubber-backed mats"
    ],
    "bottomLine": "The best value for most porch floors, with good coverage, broad color options and easy availability.",
    "description": "BEHR's Low-Lustre Porch and Patio Floor Paint is the porch enamel most people can pick up the same day, tinted to almost any color at a Home Depot paint counter. It is a water-based acrylic floor paint rated for wood and concrete, inside and out, and the low-luster finish is a sensible choice for porches because it hides footprints, scuffs and pollen better than shinier finishes while looking more refined than flat paint. The price is usually well below premium brands, which matters on a big wraparound porch where you may need five or more gallons. BEHR also sells a matching anti-slip additive and porch primers, keeping the whole system in one store. The low-luster sheen is slightly harder to wipe clean than satin, and like every latex floor enamel it can soften under rubber-backed doormats. Owner feedback is generally positive on value and appearance, especially when the surface was properly cleaned, sanded and primed first."
  },
  {
    "category": "Acrylic floor and patio coating",
    "name": "INSL-X Tough Shield Floor & Patio Coating",
    "badge": "Best for Concrete Porches",
    "id": "inslx-tough-shield",
    "amazonUrl": "",
    "pros": [
      "Water-based acrylic designed for concrete and wood floors",
      "Hard, abrasion-resistant film for a latex product",
      "Low odor and quick recoat",
      "Benjamin Moore-family quality at a lower price",
      "Good adhesion to properly prepared masonry"
    ],
    "cons": [
      "Smaller retail presence than big-box brands",
      "Color selection depends on dealer tinting"
    ],
    "bottomLine": "A hard-wearing, reasonably priced choice for concrete porch slabs, steps and patios.",
    "description": "INSL-X is the specialty-coatings brand in the Benjamin Moore family, and Tough Shield is its floor and patio coating for concrete and wood. The formula is a water-based acrylic meant to build a hard, abrasion-resistant film, which makes it particularly well suited to concrete porch slabs, steps and patios that see shoes, planters, grills and furniture dragged across them. It recoats fairly quickly and has low odor, so a small porch can get two coats in a day in good weather. Pricing usually falls below Benjamin Moore's own floor enamel, which makes it a value option for people who want dealer-grade quality. Availability is the catch: it is sold mostly through paint dealers and some hardware stores rather than big boxes, and color depends on the dealer's tinting system. As with any coating on concrete, etching smooth slabs and confirming the slab is dry are the steps that decide how long it lasts."
  },
  {
    "category": "Latex porch and patio floor paint",
    "name": "KILZ Porch & Patio Latex Floor Paint",
    "badge": "Best Budget",
    "id": "kilz-porch-patio-latex",
    "amazonUrl": "",
    "pros": [
      "Low price per gallon",
      "Rated for wood and concrete porches, patios and floors",
      "Low-luster finish that hides minor flaws",
      "Water cleanup and low odor"
    ],
    "cons": [
      "Thinner film may need an extra coat on bare or porous surfaces",
      "Shorter expected service life in heavy traffic"
    ],
    "bottomLine": "A reasonable choice for a budget refresh on a lightly used porch, especially over sound existing paint.",
    "description": "KILZ Porch and Patio Latex Floor Paint is the lowest-cost pick on this list, and for many porches that is a fair trade. It is a water-based acrylic latex floor paint rated for wood and concrete, interior and exterior, with a low-luster finish that hides minor surface flaws. For a back porch with modest foot traffic, or a refresh coat over existing paint that is still well bonded, it does the job at a price that makes a five-gallon project much easier to justify. The trade-offs show up in heavier use. Owners commonly report needing an extra coat on bare wood or porous concrete, and it tends to need refreshing sooner than premium enamels on busy front porches and steps. As always with porch paint, pair it with the right primer on bare wood, and avoid applying it in direct afternoon sun. Used on the right porch, it is a respectable budget choice."
  },
  {
    "category": "Acrylic floor enamel",
    "name": "Valspar Porch, Floor & Patio Latex Enamel",
    "badge": "Best Color Selection at Lowe's",
    "id": "valspar-porch-floor-patio",
    "amazonUrl": "",
    "pros": [
      "Tints to Valspar's large color range at Lowe's",
      "Rated for wood and concrete, inside and out",
      "Low odor and soap-and-water cleanup",
      "Smooth leveling with fewer roller marks",
      "Compatible with anti-slip additives"
    ],
    "cons": [
      "Softer than epoxy-modified or premium enamels in heavy traffic",
      "Finish options vary by store"
    ],
    "bottomLine": "A dependable, attractive porch enamel for Lowe's shoppers who want a wide color choice.",
    "description": "Valspar's Porch, Floor and Patio enamel is the Lowe's counterpart to BEHR's porch paint at Home Depot: a water-based acrylic latex enamel rated for wood and concrete, indoors and out, tinted to Valspar's large color range. That breadth of color is its main draw for porch projects, where many people want something other than gray, such as a historic green, a warm taupe or a deep blue-gray. It levels well, which helps hide roller marks on smooth concrete and minimizes brush marks on boards, and it accepts anti-slip additives for steps. As a latex enamel it stays flexible enough for wood porches through seasonal swelling and shrinking. It is softer than the premium enamels in very heavy traffic, so it is best suited to porches with moderate use or ones where you are happy to roll a maintenance coat every few years. Owner reviews tend to focus on good color and easy application when prep is done properly."
  },
  {
    "category": "Latex porch and floor paint",
    "name": "Glidden Porch & Floor Paint",
    "badge": "Easiest Application",
    "id": "glidden-porch-floor",
    "amazonUrl": "",
    "pros": [
      "Thin, easy-flowing formula that is forgiving for beginners",
      "Low price",
      "Rated for wood and concrete porch floors",
      "Low odor and water cleanup"
    ],
    "cons": [
      "Limited color range compared with tintable premium lines",
      "Thinner film means more coats on bare surfaces"
    ],
    "bottomLine": "A simple, low-cost porch paint for first-time painters and smaller jobs.",
    "description": "Glidden's Porch and Floor paint is a straightforward, inexpensive porch floor paint that is easy to apply. The formula flows and levels readily, which makes it forgiving for first-timers who might otherwise leave lap marks or heavy roller lines on a porch floor. It is rated for wood and concrete porch floors and cleans up with water. The trade-off for that easy flow is a thinner film, which usually means an extra coat over bare wood or porous concrete and a shorter interval before the next refresh compared with premium enamels. The color range is also narrower, so if you want a specific historic shade you may be better off with a fully tintable brand. Where it makes sense is on a small porch, a back stoop, or a quick refresh over sound existing paint, where a lower budget and easy application matter more than maximum durability. Owner feedback generally reflects that: good value, easy to use, best on moderate-traffic surfaces."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Porch Paint",
          item: "https://www.allmetalbrake.com/best-porch-paint/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which paint belongs on a porch floor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pick a porch and floor enamel rated for your surface, wood or concrete. Water-based acrylic enamels are the most common choice today because they stay flexible on wood, resist fading and clean up easily. Low-luster or satin sheens hide wear and are less slippery than gloss. Avoid ordinary wall or siding paint, which is too soft for foot traffic."
          }
        },
        {
          "@type": "Question",
          "name": "Does a wood porch need primer before painting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Prime any bare wood, including sanded spots, new boards and patched areas, with an exterior primer suited to the wood and porch use. Sound, previously painted surfaces usually need only cleaning and sanding. Priming bare wood improves adhesion and helps block tannin bleed in species like cedar and redwood. Follow the paint manufacturer's primer recommendations."
          }
        },
        {
          "@type": "Question",
          "name": "How long should porch paint dry before walking on it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most porch enamels are ready for light foot traffic in about 24 hours, but full cure takes longer, often a week or more depending on temperature and humidity. Wait several days before returning furniture and longer before placing rugs or mats, especially rubber-backed ones. Cool or damp weather extends these times."
          }
        },
        {
          "@type": "Question",
          "name": "Should I use oil-based or latex paint on a porch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most porches today are best served by water-based acrylic latex enamel. It stays flexible on wood, resists cracking and fading, cleans up with water and has low odor. Oil-based enamels dry harder but become brittle and are less common due to VOC limits. If your porch already has oil paint, prepare it properly before switching to latex."
          }
        },
        {
          "@type": "Question",
          "name": "How do I make a painted porch less slippery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mix an anti-slip additive into the final coat, broadcast fine grit into the wet paint, or use a textured coating on steps and landings. Choose low-luster or satin rather than gloss. Stir additive-filled paint often during application so the grit stays evenly distributed. Focus extra traction on steps, ramps and entry areas."
          }
        },
        {
          "@type": "Question",
          "name": "Can I paint a concrete porch with porch paint?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Many porch and floor enamels are rated for both wood and concrete. Test for sealers and moisture, clean and degrease, and etch smooth concrete before painting. New concrete should cure at least 28 days. Use the primer or first-coat method the label recommends, and add traction to steps and areas that get wet."
          }
        },
        {
          "@type": "Question",
          "name": "How often does a porch need repainting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A quality porch enamel on a well-prepared surface commonly lasts about three to five years, depending on traffic, sun and weather. Steps and high-traffic areas wear sooner. Rolling a maintenance coat when traffic lanes look thin, before the paint wears through, extends the life of the finish and saves a full strip-and-repaint later."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Paint & Floor Coatings",
    tags: [
      "best porch paint",
      "porch floor paint",
      "porch and patio paint",
      "painting a wood porch",
      "porch floor enamel",
      "haint blue porch ceiling"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Porch Paints</span> for Floors That Take a Beating
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Boards that swell and shrink, slabs that sit in the rain, steps that get slick. Here is the paint for each, and the prep that keeps it on.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#benjamin-moore-floor-patio"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.1k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#porch-zones" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Porch Zones</a>
          <a href="#wood-or-concrete" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Wood vs Concrete</a>
          <a href="#color-sheen" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Color, Sheen and Heat</a>
          <a href="#traction" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Traction</a>
          <a href="#prep" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Prep by Surface</a>
          <a href="#painting" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Painting the Floor</a>
          <a href="#ceiling" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. The Porch Ceiling</a>
          <a href="#upkeep" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Upkeep and Cost</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A porch floor lives a harder life than almost any other painted surface on a house. It is walked on like a floor, rained on like a roof, baked in the afternoon sun and, in much of the country, frozen for months. Porch and floor enamels are made for that combination, and the gap between a good one applied well and wall paint applied in a hurry is the difference between a floor that looks fresh for five years and one that peels by next summer.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Best Porch Paints, Ranked
          </h2>

          <p>
            These rankings draw on what each manufacturer publishes: resin type, surfaces the product is rated for, sheen options, recoat and cure times, and warranty language, along with repeated patterns in owner feedback about wear, fading and peeling. We did not run our own exposure or wear tests on them. Where a point comes from a label or owner reports, we say so.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-gray-500 text-sm font-bold">{product.rating}</span>
                    <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} ratings on Amazon)</span>
