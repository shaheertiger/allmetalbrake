---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/epoxy-garage-floor-peeling.html?raw';

const title = "Why Is My Epoxy Garage Floor Peeling? Causes and Fixes";
const description = "Peeling epoxy almost always means a weak bond. Read the failure pattern — tyre tracks, edges, blisters or sheets — to find the cause and the fix that holds.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
