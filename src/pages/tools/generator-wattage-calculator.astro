---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import FAQ from '../../components/FAQ.astro';
import { breadcrumbs, faqPage, graph } from '../../lib/schema';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Tools', url: '/guides/' }, { name: 'Generator Wattage Calculator', url: '/tools/generator-wattage-calculator/' }];
// Typical running / starting watts, as published in generator makers' wattage charts.
// Appliance labels vary: the label (or a plug-in watt meter) always wins.
const loads: [string, number, number, boolean][] = [
  ['Refrigerator / freezer', 700, 2200, false],
  ['Chest freezer', 500, 1500, false],
  ['Sump pump (1/3 HP)', 800, 1300, false],
  ['Sump pump (1/2 HP)', 1050, 2150, false],
  ['Well pump (1/2 HP, 240V)', 1000, 2100, true],
  ['Well pump (1 HP, 240V)', 2000, 4000, true],
  ['Furnace blower (1/2 HP, gas furnace)', 800, 2350, false],
  ['Window AC (10,000 BTU)', 1200, 1800, false],
  ['Central AC (3 ton, 240V)', 3800, 9000, true],
  ['Electric water heater (240V)', 4000, 0, true],
  ['Microwave (1,000 W)', 1000, 0, false],
  ['Coffee maker', 1000, 0, false],
  ['Electric space heater', 1500, 0, false],
  ['Washing machine', 1150, 2250, false],
  ['Electric dryer (240V)', 5400, 6750, true],
  ['Television', 150, 0, false],
  ['Internet modem + router', 30, 0, false],
  ['Laptop', 60, 0, false],
  ['CPAP machine', 60, 0, false],
  ['LED lights (10 bulbs)', 100, 0, false],
  ['Phone chargers (4)', 40, 0, false],
];
const faqs = [
  { q: 'What size generator do I need to run a house?', a: 'Add the running watts of everything you need on at once, then add the single largest starting surge. Essentials (fridge, freezer, sump pump, furnace blower, lights, internet) usually land around 3,500 to 5,000 running watts. Add central AC or a well pump and most homes need 7,500 to 10,000 running watts or a standby generator.' },
  { q: 'Do I add up all the starting watts?', a: 'No. Motors rarely start at the same instant, so add only the largest single starting surge on top of total running watts. Start the biggest motor first, then switch on the rest one at a time.' },
  { q: 'Why does the calculator add a 20% margin?', a: 'Running a generator at 100% of its rating for hours is hard on the engine and leaves no room for a surge you forgot. Keeping your planned load at about 80% of running watts is a common rule of thumb.' },
  { q: 'Can a 120V generator run a 240V well pump?', a: 'Only a generator with a 240V outlet (such as an L14-30 or 14-50) connected through a transfer switch or interlock can run a 240V pump. Most small inverter generators are 120V only.' },
];
const schema = graph(breadcrumbs(crumbs), { '@type': 'SoftwareApplication', name: 'Generator Wattage Calculator', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } }, faqPage(faqs));
---
<Base title="Generator Wattage Calculator: What Size Generator Do I Need?" description="Add up running and starting watts for the appliances you need in an outage and get the generator size to buy, with a 20% margin and a 240V check." schema={schema}>
  <PageHeader h1="Generator Wattage Calculator" crumbs={crumbs} eyebrow="Tools" intro="Tick what you need to run at the same time. The calculator adds running watts, the single biggest starting surge and a safety margin, and tells you the generator size to shop for." />
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
    <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-sm">
      <table class="w-full text-sm">
        <thead class="bg-slate-50"><tr><th class="text-left px-3 py-2.5">Run it?</th><th class="text-left px-3 py-2.5">Appliance</th><th class="text-left px-3 py-2.5">Running W</th><th class="text-left px-3 py-2.5">Starting W</th></tr></thead>
        <tbody id="loads" class="divide-y divide-slate-100">
          {loads.map(([name, run, start, v240], i) => (
            <tr>
              <td class="px-3 py-2"><input type="checkbox" class="pick h-5 w-5" data-i={i} checked={i < 2 || name.startsWith('Furnace') || name.startsWith('Internet') || name.startsWith('LED') || name.startsWith('Sump pump (1/2')} aria-label={`Include ${name}`} /></td>
              <td class="px-3 py-2">{name}{v240 && <span class="ml-1 text-xs font-semibold text-amber-700">240V</span>}</td>
              <td class="px-3 py-2"><input type="number" min="0" step="10" value={run} class="run w-24 rounded border border-slate-300 px-2 py-1" data-v240={v240 ? '1' : ''} /></td>
              <td class="px-3 py-2"><input type="number" min="0" step="10" value={start} class="start w-24 rounded border border-slate-300 px-2 py-1" /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="mt-5 rounded-2xl bg-slate-50 border border-slate-200 p-5" aria-live="polite">
      <p class="text-sm text-slate-600">Total running watts: <strong id="tRun" class="text-ink"></strong> · Largest extra starting surge: <strong id="tSurge" class="text-ink"></strong></p>
      <p class="mt-2 text-lg font-bold text-ink">Shop for at least <span id="needRun"></span> running watts and <span id="needStart"></span> starting watts.</p>
      <p id="advice" class="mt-2 text-sm text-slate-700"></p>
    </div>
    <div class="prose mt-10">
      <h2>How the Calculator Works</h2>
      <p>Required running watts = the sum of the running watts you ticked × 1.2 (a 20% margin so the engine isn't at full load for hours). Required starting watts = total running watts + the largest single <em>extra</em> starting surge (starting minus running watts) among the motors you ticked. Starting surges are not added together, because you start motors one at a time.</p>
      <p>The appliance figures are typical values from generator makers' wattage charts. Your appliance's nameplate, or a plug-in watt meter, is more accurate: edit any number in the table.</p>
      <h2>Related Guides</h2>
      <ul>
        <li><a href="/best-home-generator-for-power-outages/">Best home generators for power outages</a> and <a href="/best-generator-for-well-pump/">generators for well pumps</a></li>
        <li><a href="/best-generator-transfer-switch/">Generator transfer switches</a> (needed for 240V circuits)</li>
        <li><a href="/tools/power-station-runtime-calculator/">Power station runtime calculator</a></li>
        <li>Glossary: <a href="/glossary/running-watts/">running watts</a>, <a href="/glossary/starting-watts/">starting watts</a></li>
      </ul>
      <h2>FAQ</h2>
    </div>
    <FAQ faqs={faqs} />
  </div>
  <script is:inline>
    (function () {
      const rows = [...document.querySelectorAll('#loads tr')];
      const $ = (id) => document.getElementById(id);
      const fmt = (n) => Math.round(n).toLocaleString('en-US') + ' W';
      function render() {
        let run = 0, surge = 0, v240 = false;
        rows.forEach((r) => {
          if (!r.querySelector('.pick').checked) return;
          const ru = +r.querySelector('.run').value || 0, st = +r.querySelector('.start').value || 0;
          run += ru; surge = Math.max(surge, st > ru ? st - ru : 0);
          if (r.querySelector('.run').dataset.v240) v240 = true;
        });
        $('tRun').textContent = fmt(run); $('tSurge').textContent = fmt(surge);
        const needRun = Math.ceil(run * 1.2 / 100) * 100, needStart = Math.ceil((run + surge) / 100) * 100;
        $('needRun').textContent = fmt(needRun); $('needStart').textContent = fmt(needStart);
        let a = needRun <= 2000 ? 'A 2,000 to 2,500 W inverter generator or a large power station covers this.' : needRun <= 4500 ? 'A 3,500 to 5,000 W inverter or portable generator fits this load.' : needRun <= 10000 ? 'You need a large portable generator (7,500 to 12,000 W) connected through a transfer switch, or a standby unit.' : 'This is standby generator territory: talk to a licensed installer about a whole-house unit.';
        if (v240) a += ' You ticked a 240V load: it needs a generator with a 240V outlet (L14-30 or 14-50) and a transfer switch or interlock.';
        $('advice').textContent = a;
      }
      document.getElementById('loads').addEventListener('input', render);
      render();
    })();
  </script>
</Base>
