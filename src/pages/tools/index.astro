---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { breadcrumbs, graph, itemList } from '../../lib/schema';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Tools', url: '/tools/' }];
const tools = [
  { href: '/tools/generator-wattage-calculator/', name: 'Generator Wattage Calculator', text: 'Tick the appliances you need in an outage and get the running and starting watts to shop for, with a 240V check.' },
  { href: '/tools/power-station-runtime-calculator/', name: 'Power Station Runtime Calculator', text: 'How many hours a power station or home battery runs your loads, with inverter losses and solar included.' },
];
---
<Base title="Free Backup Power Tools: Wattage and Runtime Calculators" description="Two free backup power calculators: work out what size generator you need in running and starting watts, and how long a power station will run your loads." schema={graph(breadcrumbs(crumbs), itemList(tools.map((t) => ({ name: t.name, url: t.href }))))}>
  <div class="wrap hub">
    <Crumbs items={crumbs} />
    <h1 class="hub-title">Backup Power Tools</h1>
    <p class="hub-dek">Quick calculators for the two questions every outage plan raises.</p>
    <div class="grid grid-2">{tools.map((t) => <a class="card" href={t.href}><span class="card-k">Calculator</span><h3>{t.name}</h3><span class="card-sub">{t.text}</span></a>)}</div>
  </div>
</Base>
