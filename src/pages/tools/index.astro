---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { HUBS, TOOLS as tools } from '../../data/niche';
---
<Base title={HUBS.tools.title} description={HUBS.tools.description}>
  <div class="wrap hub">
    <Crumbs items={[{ name: 'Home', href: '/' }, { name: 'Tools', href: '/tools/' }]} />
    <h1 class="hub-title">{HUBS.tools.h1}</h1>
    <p class="hub-dek">{HUBS.tools.dek}</p>
    <div class="grid grid-2">{tools.map((t) => <a class="card" href={t.href}><span class="card-k">Calculator</span><h3>{t.name}</h3><span class="card-sub">{t.text}</span></a>)}</div>
  </div>
</Base>
