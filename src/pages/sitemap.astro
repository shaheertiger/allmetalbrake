---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { CATEGORIES } from '../data/categories';
import { articles, products, brands, brandUrl, productUrl, articleUrl, hubLabel, productMap, productsByCategory, compareSlug, shortName } from '../lib/data';
import { compares } from '../data/compares';
import { glossary } from '../data/glossary';
import { FOOTER_COMPANY } from '../data/nav';
import { breadcrumbs, graph } from '../lib/schema';

const crumbs = [{ name: 'Home', url: '/' }, { name: 'Sitemap', url: '/sitemap/' }];
const roundups = articles.filter((a) => a.kind === 'roundup');
const hubOrder = [...new Set(roundups.map((a) => a.hub))];
const reviews = articles.filter((a) => a.kind === 'review');
const guides = articles.filter((a) => a.kind === 'guide');
const cats = CATEGORIES.filter((c) => productsByCategory(c.key).length);
const pairs = compares.filter(([a, b]) => productMap.has(a) && productMap.has(b));
const tools = [
  { title: 'Generator Wattage Calculator', url: '/tools/generator-wattage-calculator/' },
  { title: 'Power Station Runtime Calculator', url: '/tools/power-station-runtime-calculator/' },
];
---
<Base title="Sitemap: Every Page on All Metal Brake" description={`Every page on All Metal Brake: ${roundups.length} best lists, ${reviews.length} brand reviews, ${guides.length} guides, ${products.length} product pages, ${pairs.length} comparisons, tools and glossary.`} schema={graph(breadcrumbs(crumbs))}>
  <div class="wrap hub">
    <Crumbs items={crumbs} />
    <h1 class="hub-title">Sitemap</h1>
    <p class="hub-dek">Every page on the site, grouped by type. Search engines can use the <a href="/sitemap.xml">XML sitemap</a>.</p>

    <h2 class="section-title"><a href="/best-of/" style="color:inherit;text-decoration:none">Best Lists</a></h2>
    <div class="sitemap-cols">
      {hubOrder.map((h) => (
        <div class="sm-group"><p class="mini">{hubLabel(h)}</p><ul class="link-list">{roundups.filter((a) => a.hub === h).map((a) => <li><a href={articleUrl(a)}>{a.h1}</a></li>)}</ul></div>
      ))}
    </div>

    <h2 class="section-title">Brand Reviews, Guides and Tools</h2>
    <ul class="link-list">
      {reviews.map((a) => <li><a href={articleUrl(a)}>{a.h1}</a> <span class="tag">Brand Review</span></li>)}
      {guides.map((a) => <li><a href={articleUrl(a)}>{a.h1}</a> <span class="tag">Guide</span></li>)}
      {tools.map((t) => <li><a href={t.url}>{t.title}</a> <span class="tag">Tool</span></li>)}
    </ul>

    <h2 class="section-title"><a href="/gear/" style="color:inherit;text-decoration:none">All {products.length} Products</a></h2>
    <div class="sitemap-cols">
      {cats.map((c) => (
        <div class="sm-group"><p class="mini">{c.label}</p><ul class="link-list">{productsByCategory(c.key).map((p) => <li><a href={productUrl(p)}>{p.name}</a></li>)}</ul></div>
      ))}
    </div>

    <h2 class="section-title"><a href="/compare/" style="color:inherit;text-decoration:none">Comparisons</a></h2>
    <ul class="vs-list">{pairs.map(([a, b]) => <li><a href={`/compare/${compareSlug(a, b)}/`}>{shortName(productMap.get(a)!.name)} vs {shortName(productMap.get(b)!.name)}</a></li>)}</ul>

    <h2 class="section-title"><a href="/brands/" style="color:inherit;text-decoration:none">Brands</a></h2>
    <p class="term-cloud">{brands.map((b) => <a href={brandUrl(b)}>{b}</a>)}</p>

    <h2 class="section-title"><a href="/glossary/" style="color:inherit;text-decoration:none">Glossary</a></h2>
    <p class="term-cloud">{glossary.map((g) => <a href={`/glossary/${g.slug}/`}>{g.term}</a>)}</p>

    <h2 class="section-title">Company</h2>
    <p class="term-cloud">{FOOTER_COMPANY.map((l) => <a href={l.url}>{l.title}</a>)}</p>
  </div>
</Base>
