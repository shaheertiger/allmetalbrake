---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { articles, products, brands, brandUrl, productUrl, articleUrl, hubLabel, productMap, compareSlug } from '../lib/data';
import { compares } from '../data/compares';
import { glossary } from '../data/glossary';
import { CATEGORY_LABELS } from '../data/site';
import { FOOTER_COMPANY } from '../data/nav';
import { breadcrumbs, graph } from '../lib/schema';

const crumbs = [{ name: 'Home', url: '/' }, { name: 'Sitemap', url: '/sitemap/' }];
const roundups = articles.filter((a) => a.kind === 'roundup');
const hubOrder = [...new Set(roundups.map((a) => a.hub))];
const reviews = articles.filter((a) => a.kind === 'review');
const guides = articles.filter((a) => a.kind === 'guide');
const cats = Object.keys(CATEGORY_LABELS).filter((c) => products.some((p) => p.category === c));
const pairs = compares.filter(([a, b]) => productMap.has(a) && productMap.has(b));
const tools = [
  { title: 'Generator Wattage Calculator', url: '/tools/generator-wattage-calculator/' },
  { title: 'Power Station Runtime Calculator', url: '/tools/power-station-runtime-calculator/' },
];
---
<Base title="Sitemap: Every Page on All Metal Brake" description={`Every page on All Metal Brake: ${roundups.length} best lists, ${reviews.length} brand reviews, ${guides.length} guides, ${products.length} product pages, ${pairs.length} comparisons, tools and glossary.`} schema={graph(breadcrumbs(crumbs))}>
  <PageHeader h1="Sitemap" crumbs={crumbs} intro={`Every page on the site, grouped by type. Search engines can use the <a href="/sitemap-index.xml" class="underline">XML sitemap</a>.`} />
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 space-y-12 text-[15px]">
    <section>
      <h2 class="text-xl font-extrabold text-ink"><a href="/best-of/" class="no-underline hover:text-brand-600">Best Lists</a></h2>
      <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {hubOrder.map((h) => (
          <div><h3 class="font-bold text-slate-700">{hubLabel(h)}</h3>
            <ul class="mt-2 space-y-1.5">{roundups.filter((a) => a.hub === h).map((a) => <li><a href={articleUrl(a)} class="text-brand-600 hover:underline">{a.h1}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </section>
    <section class="grid sm:grid-cols-2 gap-8">
      <div><h2 class="text-xl font-extrabold text-ink"><a href="/reviews/" class="no-underline hover:text-brand-600">Brand Reviews</a></h2>
        <ul class="mt-3 space-y-1.5">{reviews.map((a) => <li><a href={articleUrl(a)} class="text-brand-600 hover:underline">{a.h1}</a></li>)}</ul></div>
      <div><h2 class="text-xl font-extrabold text-ink"><a href="/guides/" class="no-underline hover:text-brand-600">Guides &amp; Tools</a></h2>
        <ul class="mt-3 space-y-1.5">{[...guides.map((a) => ({ title: a.h1, url: articleUrl(a) })), ...tools].map((l) => <li><a href={l.url} class="text-brand-600 hover:underline">{l.title}</a></li>)}</ul></div>
    </section>
    <section>
      <h2 class="text-xl font-extrabold text-ink"><a href="/gear/" class="no-underline hover:text-brand-600">All {products.length} Products</a></h2>
      <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {cats.map((c) => (
          <div><h3 class="font-bold text-slate-700">{CATEGORY_LABELS[c]}</h3>
            <ul class="mt-2 space-y-1">{products.filter((p) => p.category === c).map((p) => <li><a href={productUrl(p)} class="text-brand-600 hover:underline">{p.name}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </section>
    <section>
      <h2 class="text-xl font-extrabold text-ink"><a href="/compare/" class="no-underline hover:text-brand-600">Comparisons</a></h2>
      <ul class="mt-3 grid sm:grid-cols-2 gap-x-6 gap-y-1">{pairs.map(([a, b]) => <li><a href={`/compare/${compareSlug(a, b)}/`} class="text-brand-600 hover:underline">{productMap.get(a)!.name} vs {productMap.get(b)!.name}</a></li>)}</ul>
    </section>
    <section class="grid sm:grid-cols-2 gap-8">
      <div><h2 class="text-xl font-extrabold text-ink"><a href="/brands/" class="no-underline hover:text-brand-600">Brands</a></h2>
        <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1">{brands.map((b) => <li><a href={brandUrl(b)} class="text-brand-600 hover:underline">{b}</a></li>)}</ul></div>
      <div><h2 class="text-xl font-extrabold text-ink"><a href="/glossary/" class="no-underline hover:text-brand-600">Glossary</a></h2>
        <ul class="mt-3 space-y-1">{glossary.map((g) => <li><a href={`/glossary/${g.slug}/`} class="text-brand-600 hover:underline">{g.term}</a></li>)}</ul></div>
    </section>
    <section><h2 class="text-xl font-extrabold text-ink">Company</h2>
      <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-1">{FOOTER_COMPANY.map((l) => <li><a href={l.url} class="text-brand-600 hover:underline">{l.title}</a></li>)}</ul>
    </section>
  </div>
</Base>
