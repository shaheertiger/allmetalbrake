                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">How it works</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Changes look?</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best use</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Avoid on</th>
                  </tr>
                </thead>
