---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/deck-paint-vs-deck-stain.html?raw';

const title = "Deck Paint vs Deck Stain: Which Should You Use?";
const description = "Paint films and peels on deck floors; stain soaks in and wears evenly. Lifespan, upkeep, slip, cost, switching, and why many decks should use both.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
