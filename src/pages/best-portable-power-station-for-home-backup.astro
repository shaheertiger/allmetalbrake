---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Solar Generators",
    "url": "/best-solar-generator/"
  },
  {
    "title": "Best Portable Power Stations for Camping",
    "url": "/best-portable-power-station-for-camping/"
  },
  {
    "title": "Best Portable Chargers for Power Outages",
    "url": "/best-portable-chargers-for-power-outages/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "6 Best Portable Power Stations for Home Backup in 2026";
const description =
  "Six battery generators for home backup, from 1kWh bridges to 240V systems, with critical-load worked examples, transfer switch options and multi-day plans.";

const PRODUCTS = [
  {
    "id": "ecoflow-delta-pro-3",
    "name": "EcoFlow Delta Pro 3 Portable Power Station",
    "category": "4kWh LFP, 4,000W, 120/240V, Expandable",
    "badge": "Best Overall for Home Backup",
    "amazonUrl": "",
    "pros": [
      "4,096Wh of LFP storage covers a day of essentials",
      "120V and 240V output from one unit",
      "Expandable with add-on batteries for multi-day outages",
      "Designed to work with EcoFlow's smart panel or a transfer switch"
    ],
    "cons": [
      "About 114 pounds, so it lives on its wheels",
      "The full system with panel and solar is a large investment",
      "Panel connection needs a licensed electrician"
    ],
    "bottomLine": "The best-rounded battery backup for houses that want selected circuits covered silently, with room to scale.",
    "description": "If you want one battery generator to sit in the garage and quietly take over a set of house circuits when the lights go out, the Delta Pro 3 is the most complete answer. EcoFlow rates its LFP battery at 4,096Wh, the size where backup planning stops being a juggling act: by the runtime rule (Wh x 0.85 / W) it supplies an average 135W essentials load of fridge, sump pump, internet, CPAP, lights and charging for roughly 25 hours, and a fridge on its own for more than two days. The 4,000W inverter is specified to carry a refrigerator, a gas furnace blower and a sump pump at the same time, and the 240V output brings many well pumps and other split-phase circuits within reach. What makes it a backup system rather than a big battery is the path into the house: feed it through a transfer switch, an interlock and inlet, or EcoFlow's smart home panel, and the chosen circuits run from the battery with no cords across the floor. Add EcoFlow's extra batteries as outages get longer and pair it with solar so a sunny day puts energy back. The downsides are mass and money: it is a wheeled unit, and once you add panel hardware, installation and solar you are spending a meaningful fraction of a standby generator."
  },
  {
    "id": "anker-solix-f3800",
    "name": "Anker SOLIX F3800 Portable Power Station",
    "category": "3.8kWh LFP, 6,000W, 120/240V, Expandable",
    "badge": "Best for 240V Well Pumps",
    "amazonUrl": "",
    "pros": [
      "6,000W output, the most headroom on this list",
      "Native 120/240V for well pumps and split-phase loads",
      "Expandable with Anker's add-on batteries",
      "Ties into Anker's home panel or a standard transfer switch"
    ],
    "cons": [
      "The heaviest pick at roughly 132 pounds",
      "Slightly less storage than the Delta Pro 3",
      "More output than a 120V-only household will use"
    ],
    "bottomLine": "The pick when the critical load is a big motor, especially a 240V well pump.",
    "description": "Storage decides how long a battery lasts; output decides whether the hardest load on your list will start at all. For rural houses on a well, that hardest load is usually a 240V submersible pump whose starting surge can be several times its running draw, arriving at the same moment the fridge compressor might also kick on. Anker rates the SOLIX F3800 at 6,000W with native 120/240V output, the most margin for exactly that problem among these picks, which is why it leads for well-pump homes even though its 3,840Wh battery is a little smaller than EcoFlow's. Planning-wise it behaves like the Delta Pro 3: a wheeled unit that stays in the garage or utility room, connected to the house through Anker's panel or a transfer switch, expandable with add-on batteries and rechargeable from solar or a generator. Confirm your pump's voltage, horsepower and starting current with your well installer before you buy, and ask about a soft-start kit, because reducing the surge makes any battery's job easier."
  },
  {
    "id": "jackery-explorer-2000-v2",
    "name": "Jackery Explorer 2000 v2 Portable Power Station",
    "category": "2kWh LFP, 2,200W, 120V, Plug-In",
    "badge": "Best Plug-In Overnight Backup",
    "amazonUrl": "",
    "pros": [
      "2,042Wh carries a fridge, CPAP and internet overnight",
      "2,200W output starts most 120V appliances",
      "About 40 pounds, so one person can move it between rooms",
      "No installation needed for plug-in use"
    ],
    "cons": [
      "120V only, so no well pumps or 240V circuits",
      "Not expandable with add-on batteries",
      "Hardwired loads still need a transfer switch or inlet"
    ],
    "bottomLine": "The best no-installation backup for overnight outages with a fridge and medical device.",
    "description": "Many households do not need a panel-connected system at all. If your outages are typically a stormy night rather than a week, and your critical loads all plug into ordinary outlets, a 2kWh unit you can carry from the kitchen to the bedroom is the most practical backup there is. Jackery lists the Explorer 2000 v2 at 2,042Wh and 2,200W. By the runtime rule, that capacity supplies a fridge, router, CPAP and lights averaging about 105W for roughly 16 hours, a full night and most of the next day, and the inverter has enough headroom for a fridge start-up with everything else running, or a quick microwave meal. The limits are clear and worth respecting: it is 120V only, it cannot be expanded, and anything hardwired, such as a furnace blower or many sump pumps, still needs a proper inlet and transfer switch to reach it. If you suspect you will want 240V or more storage later, the Delta Pro 3 or F3800 is the better long-term buy. If not, this is the sweet spot of simplicity and runtime."
  },
  {
    "id": "ecoflow-delta-3-plus",
    "name": "EcoFlow Delta 3 Plus Portable Power Station",
    "category": "1kWh LFP, 1,800W, 120V, Expandable",
    "badge": "Best Expandable Starter",
    "amazonUrl": "",
    "pros": [
      "Starts at 1,024Wh and grows with add-on batteries",
      "1,800W output handles a fridge start and a sump pump",
      "Fast UPS-style switchover for routers and computers",
      "About 28 pounds, so it doubles as a camping unit"
    ],
    "cons": [
      "120V only",
      "1kWh alone lasts under a day with a fridge",
      "Heavier than the Jackery 1000 v2"
    ],
    "bottomLine": "A capable 1kWh bridge today with a path to multi-kilowatt-hour backup tomorrow.",
    "description": "The Delta 3 Plus is the right buy for someone who wants to start small and build toward real backup. EcoFlow rates it at 1,024Wh and 1,800W. On its own, that battery covers a fridge for roughly 13 hours or an essentials set for about eight, which bridges the majority of outages, since most last hours rather than days. The inverter is enough to start a refrigerator compressor and handle a typical 1/3 HP sump pump, though not both starting at once with a lot else running. The reason to choose it over a fixed 1kWh unit is the upgrade path: add one of EcoFlow's extra batteries and capacity roughly doubles without buying a second inverter, and in the meantime it serves as a camping unit and a desk UPS. If you already know you need 240V, skip straight to the Delta Pro 3; if you are not sure yet, this is a sensible first step."
  },
  {
    "id": "jackery-explorer-1000-v2",
    "name": "Jackery Explorer 1000 v2 Portable Power Station",
    "category": "1kWh LFP, 1,500W, 3,000W Surge",
    "badge": "Best Value",
    "amazonUrl": "",
    "pros": [
      "1,070Wh of LFP storage in about 24 pounds",
      "3,000W surge rating helps with compressor starts",
      "Simple to use: plug in and go",
      "Frequently discounted"
    ],
    "cons": [
      "1,500W continuous limits what runs at once",
      "Not expandable",
      "Short-outage bridge, not whole-home backup"
    ],
    "bottomLine": "The lowest-cost way to keep a fridge and internet alive through a short outage.",
    "description": "For apartments, condos and anyone whose outage plan is to keep the fridge cold and the Wi-Fi on until the power comes back, the Explorer 1000 v2 delivers the essentials at the lowest cost among these picks. Jackery lists it at 1,070Wh, 1,500W continuous and 3,000W surge. By the runtime rule it runs a fridge for about 14 hours, or the router alone for well over a day, and the surge rating gives a fridge compressor plenty of room to start. It is not a house system: at 1,500W continuous it cannot run a sump pump and a microwave together, it has no 240V option, and when you outgrow it you buy a second unit rather than an add-on battery. But as a light, simple bridge that also goes camping, it is hard to beat for the money."
  },
  {
    "id": "bluetti-elite-100-v2",
    "name": "Bluetti Elite 100 V2 Portable Power Station",
    "category": "1kWh LFP, 1,800W, Compact",
    "badge": "Best Compact",
    "amazonUrl": "",
    "pros": [
      "1,800W from a compact, roughly 25-pound case",
      "1,024Wh of LFP storage",
      "UPS-style switchover suits a bedside CPAP or home office",
      "Often priced below the EcoFlow and Jackery equivalents"
    ],
    "cons": [
      "Not expandable",
      "Smaller ecosystem of panels and accessories",
      "120V only"
    ],
    "bottomLine": "A compact, well-priced 1kWh unit for dedicated bedside or office backup.",
    "description": "Some backup jobs are about one room. A CPAP by the bed, a home-office desk that cannot drop a video call, a chest freezer in the basement: these need a reliable 1kWh unit that is easy to tuck away and switches over without a hiccup. The Elite 100 V2 fits that role. Bluetti rates it at 1,024Wh and 1,800W, matching the Delta 3 Plus on paper in a slightly lighter case, and it is frequently cheaper. What you give up is growth: there is no add-on battery path and a thinner accessory catalog, so treat it as a dedicated single-purpose backup rather than the seed of a whole-house system. Many households end up with exactly that pairing, a big wheeled unit on the essential circuits and a compact one at the bedside."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Power Stations for Home Backup",
          item: "https://www.allmetalbrake.com/best-portable-power-station-for-home-backup/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Can a portable power station back up my house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can back up the parts that matter most. A 4kWh class unit such as the EcoFlow Delta Pro 3 or Anker SOLIX F3800, connected through a transfer switch, interlock or smart panel, can run a fridge, freezer, furnace blower, sump pump, internet, lights and medical devices for roughly a day, longer with solar or add-on batteries. It will not sensibly run central air, electric heat or an electric range."
          }
        },
        {
          "@type": "Question",
          "name": "How big a battery do I need for home backup?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Add up the daily energy of everything on your critical-load list, then divide by 0.85 for losses. A fridge, internet, CPAP and lights typically need about 2,500Wh a day, so roughly 3,000Wh of battery. A sump pump in a storm pushes that toward 4,000Wh, and a furnace blower in cold weather toward 7,000Wh. As a rule of thumb, 1kWh is an hours-long bridge, 2kWh covers a night and 4kWh covers about a day."
          }
        },
        {
          "@type": "Question",
          "name": "Is a battery generator better than a gas generator for home backup?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Each wins in different situations. A battery generator is silent, produces no carbon monoxide, needs almost no maintenance and recharges from solar, which suits short outages, medical devices and apartments. A gas generator stores far more energy in a can of fuel, so it is better for long outages and heavy loads. For multi-day outages the strongest setup is both: a generator recharges the battery in the afternoon, and the battery runs the house overnight."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a transfer switch for a power station?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not for plug-in appliances: a fridge, CPAP, router or lamp can plug straight into the station or into a heavy-duty extension cord. You do need a transfer switch, a panel interlock with an inlet, or the maker's smart panel for hardwired loads such as a furnace blower, well pump or lighting circuits. Never backfeed through a wall outlet, and have a licensed electrician install the connection, with a permit where required."
          }
        },
        {
          "@type": "Question",
          "name": "Can a power station run a 240V well pump?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only a unit with native 240V split-phase output and enough surge capacity to start the motor. Among these picks, the Anker SOLIX F3800 at 6,000W and the EcoFlow Delta Pro 3 at 4,000W both offer 120/240V. The deciding number is the pump's starting current, which can be several times its running draw. Get it from the nameplate or your well installer, consider a soft-start kit, and wire the pump circuit into your transfer switch."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a power station as a UPS for a CPAP machine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, in most cases. Many current stations have a UPS or pass-through mode that switches to battery within about 10 to 30 milliseconds by the manufacturers' figures, which is fast enough for most CPAP machines; check your device manual if unsure. Without the heated humidifier a CPAP uses about 30 to 60W, so a 1kWh unit lasts two or three nights, and a DC adapter from the CPAP maker stretches that further."
          }
        },
        {
          "@type": "Question",
          "name": "Can I keep a power station in my garage for winter backup?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is better kept indoors in a heated space. LFP batteries should not be charged below about 32 degrees F, and most units block charging in the cold, so a station stored in a freezing garage may refuse to recharge just when you need it. If your transfer-switch inlet is in the garage, store the unit inside and wheel it out when an outage starts. For storage, keep it at 50 to 80 percent and top it up every few months."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "portable power station for home backup",
      "battery backup for house",
      "power station transfer switch",
      "240v power station well pump",
      "critical load list",
      "multi-day outage plan"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The Best Portable Power Stations for Home Backup
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          Start with the list of things that must keep running when the grid goes down, then pick the battery that can carry them. Six battery generators, from 1kWh grab-and-go units to 4kWh, 240V systems that wire into your panel.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">12 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>Our Picks</span></a>
              <a href="#critical-loads" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>Your Critical-Load List</span></a>
              <a href="#worked-examples" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Worked Examples</span></a>
              <a href="#connecting" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Connecting to the House</span></a>
              <a href="#medical" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>UPS and Medical Devices</span></a>
              <a href="#well-pumps" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>240V Well Pumps</span></a>
              <a href="#multi-day" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Multi-Day Outages</span></a>
              <a href="#winter" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>Winter and Cold Charging</span></a>
              <a href="#vs-standby" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>Vs. a Standby Generator</span></a>
              <a href="#choosing" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Which One to Buy</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">12.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most people shop for home backup the wrong way round. They pick a battery generator by its headline capacity, carry it home, and only during the first real outage discover that the furnace blower is hardwired, the well pump needs 240 volts, and the sump pump's starting surge trips the inverter the moment the fridge kicks on. The fix is to plan backwards: write down what must keep running, work out when and how hard each load pulls, decide how the battery will reach those loads, and only then choose the box.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Best Power Stations for Home Backup
          </h2>

          <p>
            This guide is built around that plan: how to write a critical-load list, three worked examples for common households, the safe ways to connect a power station to house circuits, how UPS switchover protects a CPAP, what 240V well pumps really demand, and how to stretch a battery through an outage that lasts days. The six picks below lean toward the 2 to 4kWh-plus, expandable and 240V units that can genuinely carry a house, and every one is described from its manufacturer's published specifications, not from hands-on testing. Firmware, bundles and accessories change often, so check the capacity, output and charging figures on the listing you buy from. For the broader category, including small camping units, start with our main <a href="/best-portable-power-station/">portable power station guide</a>.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} index={index} ratingLabel="ratings" />
          ))}
        </div>

        <div id="critical-loads" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Step One: Your Critical-Load List
          </h2>

          <p>
            A critical-load list is a short inventory of everything that must keep working during an outage, with three facts for each item: its running watts, its starting watts if it has a motor, and how many hours a day it actually draws power. Walk through the house with a notepad and be strict. Must means safety, health, property protection or food, not convenience. The list takes half an hour and it is the single most useful thing you can do before spending money on any backup at all.
          </p>

          <p>
            Most lists fall into four tiers. Tier one is life and health: CPAP or BiPAP machines, oxygen concentrators, refrigerated medication, and in cold climates the heat source. Tier two is property protection: the sump pump in a wet basement, the well pump if you have no city water, and heat to stop pipes freezing. Tier three is food: the refrigerator and any freezer. Tier four is communication and comfort: internet, phones, a few lights, a fan. Size your backup for tiers one to three first, then see what is left for tier four.
          </p>

