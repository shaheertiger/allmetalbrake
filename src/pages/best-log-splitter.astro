---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Chainsaw Picks",
    "url": "/best-chainsaw/"
  },
  {
    "title": "Hookaroon Picks",
    "url": "/best-hookaroon-reviews/"
  },
  {
    "title": "Weed Eater Picks",
    "url": "/best-weed-eater/"
  },
  {
    "title": "Best Compact Tractors",
    "url": "/best-compact-tractor/"
  },
  {
    "title": "Best Gas Generators",
    "url": "/best-gas-generator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 7 Best Log Splitters: Sized to Your Wood Pile";
const description =
  "Seven gas, electric and manual log splitters matched to how much wood you burn, with plain guidance on tonnage, cycle time, safe operation and renting.";

const PRODUCTS = [
  {
    "badge": "Best Overall",
    "category": "Gas, 27 Ton, Vertical and Horizontal",
    "name": "Champion Power Equipment 27-Ton",
    "description": "Champion's 27-ton splitter is a full-size towable gas machine that covers almost every homeowner firewood job. It splits horizontally at waist height for ordinary rounds and tips to vertical so you can roll heavy, knotty rounds onto the foot plate instead of lifting them, which saves backs and time. Champion lists a quick cycle time for its class, an auto-return valve that lets the ram retract without holding the lever, and a Champion-built engine with a two-stage pump. Log cradles on the beam hold split pieces so they do not fall to the ground between strokes. It is towable behind a vehicle at modest speeds, and Champion's support and parts availability are good. It is overkill for a fire pit owner and heavier to move around a small yard than an electric unit, but for someone splitting several cords a year, it hits the best balance of speed, capability and price on this list.",
    "pros": [
      "27 tons with vertical and horizontal operation",
      "Quick listed cycle time and auto-return valve",
      "Log cradles keep splits off the ground",
      "Towable with good parts support"
    ],
    "cons": [
      "Too much machine for occasional fire pit wood",
      "Heavy and loud compared with electric",
      "Requires engine maintenance and storage care"
    ],
    "bottomLine": "The best all-around gas splitter for owners who burn several cords a year.",
    "amazonUrl": "",
    "id": "champion-27-ton"
  },
  {
    "badge": "Best Build Quality",
    "category": "Gas, 27 Ton, Vertical and Horizontal",
    "name": "Cub Cadet LS 27 CCHP",
    "description": "Cub Cadet's LS 27 is a 27-ton towable gas splitter with a reputation for solid construction and dealer support. It converts between horizontal and vertical operation and uses a two-stage hydraulic pump with auto-return. Owners commonly cite the frame, beam and hitch as more robust than budget competitors, and Cub Cadet's dealer network is a plus for buyers who want local service. It generally costs more than comparable Champion or YARDMAX models, so you are paying for the build and support rather than more splitting force. For owners who expect to split for many years and value dealer service, the premium is reasonable. As with all towable gas splitters, check the towing speed limit on the label and confirm whether your state requires lights or registration for road use. Owners who split many cords a year tend to appreciate the sturdier components most, since wear shows up first on hitches, beams and hydraulic fittings of lighter-built machines.",
    "pros": [
      "Robust frame, beam and hitch",
      "Vertical and horizontal operation",
      "Two-stage pump with auto-return",
      "Dealer network for service"
    ],
    "cons": [
      "Priced above similar-tonnage rivals",
      "Heavy to move by hand",
      "Engine and hydraulic maintenance required"
    ],
    "bottomLine": "A durable, dealer-supported splitter for owners who plan to keep it for years.",
    "amazonUrl": "",
    "id": "cub-cadet-ls27"
  },
  {
    "badge": "Best Budget Gas",
    "category": "Gas, 25 Ton, Full Beam",
    "name": "YARDMAX YU2566 25-Ton Full Beam",
    "description": "The YARDMAX YU2566 is a 25-ton gas splitter that brings full-beam construction and vertical and horizontal operation to a lower price than most name-brand competitors. A full beam lets you split on both directions of the ram travel in some setups and generally adds rigidity. It uses a two-stage pump and an auto-return valve, and it tows behind a vehicle. For owners splitting a few cords a year who want gas speed without paying top dollar, it is a strong value. Expect the fit and finish to be a step below Cub Cadet, and plan on checking hydraulic fittings and hardware after the first few hours, which is good practice on any new splitter. Parts and service are available but less widespread than for the biggest brands. It is a good fit for owners who want vertical capability and decent speed but cannot justify the cost of a premium dealer-sold machine.",
    "pros": [
      "25 tons at a budget-friendly price",
      "Full-beam construction",
      "Vertical and horizontal operation",
      "Two-stage pump with auto-return"
    ],
    "cons": [
      "Fit and finish below premium brands",
      "Smaller service network",
      "Heavy and loud like any gas splitter"
    ],
    "bottomLine": "The value pick for gas splitting a few cords a year.",
    "amazonUrl": "",
    "id": "yardmax-yu2566"
  },
  {
    "badge": "Best Value Mid-Size",
    "category": "Gas, 22 Ton, Vertical and Horizontal",
    "name": "Powerhorse 22-Ton Horizontal/Vertical",
    "description": "Powerhorse is Northern Tool's house brand, and its 22-ton splitter offers vertical and horizontal operation, a two-stage pump and auto-return at a price that undercuts many 25 to 27-ton machines. For most seasoned firewood such as oak, maple and ash in typical round sizes, 22 tons is enough, so the lower tonnage costs little in real-world capability. It is a sensible machine for someone who splits two or three cords a year and wants vertical capability for big rounds without paying for extra tonnage they will rarely use. Northern Tool's store network and parts availability help with support. Very large, twisted or green elm and gum rounds will be slower going, and those are the cases where higher-tonnage machines earn their premium. Check fittings and hardware after the first few hours of use, which is sensible on any new hydraulic splitter, and keep the hydraulic fluid at the level the manual specifies.",
    "pros": [
      "Vertical and horizontal at a lower price",
      "22 tons handles most seasoned firewood",
      "Two-stage pump with auto-return",
      "Store network for parts"
    ],
    "cons": [
      "Slower on large, stringy or knotty rounds",
      "Heavy to move without towing",
      "Gas engine maintenance"
    ],
    "bottomLine": "Enough splitter for most homeowners at a fair price.",
    "amazonUrl": "",
    "id": "powerhorse-22-ton"
  },
  {
    "badge": "Best Electric",
    "category": "Electric, 7 Ton, Horizontal",
    "name": "Boss Industrial ES7T20 Electric",
    "description": "Boss Industrial's ES7T20 is a 7-ton electric splitter that plugs into a standard household outlet and handles logs up to about 20 inches long, according to the manufacturer. Electric splitters are quiet, produce no exhaust, and need no engine maintenance, so you can run one in a garage with the door open or close to the house without bothering the neighbors. The ES7T20 is aimed at people splitting a modest amount of seasoned wood for a fireplace or fire pit. Seven tons is plenty for straight-grained seasoned rounds of moderate diameter but will stall on large, knotty or green wood. It operates horizontally, so you must lift each round onto the beam. Use a heavy-gauge extension cord sized per the manual, or plug directly into a GFCI-protected outlet. Never try to force a round that will not split by cycling the ram repeatedly; take it out, rotate it, or set it aside for a larger machine.",
    "pros": [
      "Quiet, no fumes, no engine maintenance",
      "Plugs into a household outlet",
      "Compact enough to store in a garage",
      "Good for seasoned, moderate rounds"
    ],
    "cons": [
      "Stalls on large, knotty or green wood",
      "Horizontal only, so you lift each round",
      "Slower than gas splitters"
    ],
    "bottomLine": "A quiet, low-maintenance choice for fireplace and fire pit volumes.",
    "amazonUrl": "",
    "id": "boss-industrial-es7t20"
  },
  {
    "badge": "Best Budget Electric",
    "category": "Electric, 6.5 Ton, Horizontal",
    "name": "WEN 56207 6.5-Ton Electric",
    "description": "WEN's 56207 is an inexpensive 6.5-ton electric splitter for owners who burn a little wood and do not want to swing a maul. It runs on household current, sits on a stand or workbench at a comfortable height, and is light enough to roll around the garage. It suits seasoned, straight-grained rounds of modest diameter, such as fire pit wood or kindling-size splits from larger pieces. Like all small electric splitters, it can stall on knots, crotches and green hardwood, and you should not try to force it by repeatedly cycling the ram into a round that will not split. The price is its strength; the trade-off is speed and capacity. Owners who go through under a cord per winter may never need more. Stick to straight-grained, seasoned rounds of modest diameter and you will get the best results from it.",
    "pros": [
      "Low price for an electric splitter",
      "Light and easy to store",
      "Quiet, no fuel or engine",
      "Fine for seasoned fire pit wood"
    ],
    "cons": [
      "Low tonnage stalls on knots and green wood",
      "Horizontal only",
      "Slow for larger volumes"
    ],
    "bottomLine": "A budget electric splitter for small, seasoned wood.",
    "amazonUrl": "",
    "id": "wen-56207"
  },
  {
    "badge": "Best Manual",
    "category": "Manual Hydraulic, 10 Ton",
    "name": "Sun Joe LJ10M Logger Joe 10-Ton Hydraulic",
    "description": "The Sun Joe LJ10M is a manual hydraulic splitter: you pump the handles and a hydraulic ram pushes the log into a wedge. There is no engine, no motor and no cord, so it works anywhere and makes almost no noise. Sun Joe lists 10 tons of force, which on paper beats small electric units, but the trade-off is effort and speed; each split takes many pump strokes. It is best for someone who splits small amounts of seasoned wood occasionally, for a cabin without power, or for anyone who wants a safer alternative to a maul for kindling and fire pit wood. It is not practical for cords of wood. Keep hands clear of the ram and wedge at all times, even though it moves slowly. Set it on firm, level ground before use so it cannot tip while you pump.",
    "pros": [
      "No fuel, cord or battery needed",
      "Very quiet operation",
      "Inexpensive",
      "Useful for cabins and occasional use"
    ],
    "cons": [
      "Slow, effortful pumping per split",
      "Not practical for large volumes",
      "Limited log length and diameter"
    ],
    "bottomLine": "A low-cost, power-free option for small amounts of wood.",
    "amazonUrl": "",
    "id": "sun-joe-lj10m"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Log Splitter Picks",
          item: "https://www.allmetalbrake.com/best-log-splitter/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How many tons of splitting force do I actually need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For seasoned, straight-grained firewood of moderate diameter, a 4 to 7-ton electric splitter is enough. For most homeowner firewood, including larger and knottier rounds, a 20 to 27-ton gas splitter is the practical range. Very large, green or stringy wood such as elm benefits from the higher end. Beyond that, speed and features matter more than extra tons."
          }
        },
        {
          "@type": "Question",
          "name": "Is an electric splitter good enough?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For fireplace and fire pit volumes of seasoned wood, yes. Electric splitters are quiet, clean and low-maintenance, and they can be used near the house. They are slower than gas, usually horizontal only, and can stall on large, knotty or green wood. If you split more than a cord or two a year, or your wood is big, a gas splitter is a better fit."
          }
        },
        {
          "@type": "Question",
          "name": "Should I rent a splitter instead of buying?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Renting makes sense if you split once a year and handle a cord or two. Have the wood cut and staged before you pick up the machine to make the most of the rental period. If you split every year or several cords at a time, buying usually pays for itself within a few seasons, especially if you share a machine with neighbors."
          }
        },
        {
          "@type": "Question",
          "name": "What cycle time should I look for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many gas splitters list cycle times somewhere in the 10 to 20-second range; faster is better for big piles. Small electric splitters are generally slower. A two-stage pump and auto-return valve improve speed noticeably. Use cycle times to compare machines within a class, since test conditions vary between brands. Auto-return helps too."
          }
        },
        {
          "@type": "Question",
          "name": "Is vertical splitting worth paying extra for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you split large, heavy rounds, yes. Vertical operation lets you roll a round onto the foot plate instead of lifting it onto a waist-high beam, which saves your back and makes very heavy pieces manageable. If you only split moderate pieces that are easy to lift, horizontal-only is fine."
          }
        },
        {
          "@type": "Question",
          "name": "How long should firewood season after splitting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most hardwoods need at least six months and often a year or more to dry, stacked off the ground in a sunny, breezy spot with the top covered and the sides open. The EPA's Burn Wise program recommends a moisture content of 20 percent or less for clean burning, and a moisture meter is an inexpensive way to check."
          }
        },
        {
          "@type": "Question",
          "name": "Can two people run a log splitter together?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Manufacturers warn against it. When one person loads and another runs the control, the operator cannot reliably see where the loader's hands are, and crushing injuries result. The safe practice is one operator who both positions the log and runs the control, with any helpers stacking splits well clear of the machine."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Yard & Outdoor Tools",
    tags: [
      "best log splitter",
      "gas log splitter",
      "electric log splitter",
      "log splitter tonnage",
      "hydraulic wood splitter",
      "firewood splitting"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Log Splitters</span> for Every Size of Woodpile
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Half a cord of backyard fire pit wood and eight cords for the woodstove call for very different machines. Here is how to pick the splitter that fits your pile, and how to run it without getting hurt.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#champion-27-ton"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="8.7k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#how-much-wood" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Start With Your Volume</a>
          <a href="#tonnage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Tonnage Explained</a>
          <a href="#cycle-time" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Cycle Time</a>
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Gas, Electric and Manual</a>
          <a href="#features" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Features Worth Paying For</a>
          <a href="#safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Operating Safely</a>
          <a href="#splitting-tips" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Splitting and Seasoning</a>
          <a href="#maintenance" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Maintenance</a>
          <a href="#rent-or-buy" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Rent, Buy and Cost</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          People shopping for a log splitter tend to fixate on tonnage, and it is the wrong place to start. Most firewood splits easily within the range of a mid-size machine. What actually decides how pleasant your splitting weekend is comes down to how fast the ram cycles, whether you can split heavy rounds without lifting them, and whether the machine matches how many cords you burn.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Best Log Splitters, Ranked
          </h2>

          <p>
            These picks are based on manufacturer specifications for splitting force, listed cycle time, maximum log length, engine or motor, orientation options and warranty, along with build details such as beam construction and patterns in owner feedback. Each machine is matched to a realistic annual firewood volume. We did not run splitting trials, so no figure here is a measurement of ours.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-gray-500 text-sm font-bold">{product.rating}</span>
                    <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} ratings on Amazon)</span>
                  </div>
                  )}

                  <p class="text-gray-700 leading-relaxed mb-6">{product.description}</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 rounded-xl p-4">
                      <p class="text-xs font-black uppercase tracking-widest text-green-700 mb-3">Pros</p>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="flex items-start gap-2 text-sm text-green-800">
