---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Chainsaw Picks",
    "url": "/best-chainsaw/"
  },
  {
    "title": "Hookaroon Picks",
    "url": "/best-hookaroon-reviews/"
  },
  {
    "title": "Weed Eater Picks",
    "url": "/best-weed-eater/"
  },
  {
    "title": "Best Compact Tractors",
    "url": "/best-compact-tractor/"
  },
  {
    "title": "Best Gas Generators",
    "url": "/best-gas-generator/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "7 Best Log Splitters (2026): Sized by Cords Split per Year";
const description =
  "The Champion 27-Ton leads 7 log splitters; a 20 to 27-ton gas machine fits most homeowner firewood, and a 4 to 7-ton electric covers seasoned fire pit wood.";

const PRODUCTS = [
  {
    "badge": "Best Overall",
    "category": "Gas, 27 Ton, Vertical and Horizontal",
    "name": "Champion Power Equipment 27-Ton",
    "description": "Champion's 27-ton splitter is a full-size towable gas machine that covers almost every homeowner firewood job. It splits horizontally at waist height for ordinary rounds and tips to vertical so you can roll heavy, knotty rounds onto the foot plate instead of lifting them, which saves backs and time. Champion lists a quick cycle time for its class, an auto-return valve that lets the ram retract without holding the lever, and a Champion-built engine with a two-stage pump. Log cradles on the beam hold split pieces so they do not fall to the ground between strokes. It is towable behind a vehicle at modest speeds, and Champion's support and parts availability are good. It is overkill for a fire pit owner and heavier to move around a small yard than an electric unit, but for someone splitting several cords a year, it hits the best balance of speed, capability and price on this list.",
    "pros": [
      "27 tons with vertical and horizontal operation",
      "Quick listed cycle time and auto-return valve",
      "Log cradles keep splits off the ground",
      "Towable with good parts support"
    ],
    "cons": [
      "Too much machine for occasional fire pit wood",
      "Heavy and loud compared with electric",
      "Requires engine maintenance and storage care"
    ],
    "bottomLine": "The best all-around gas splitter for owners who burn several cords a year.",
    "amazonUrl": "",
    "id": "champion-27-ton"
  },
  {
    "badge": "Best Build Quality",
    "category": "Gas, 27 Ton, Vertical and Horizontal",
    "name": "Cub Cadet LS 27 CCHP",
    "description": "Cub Cadet's LS 27 is a 27-ton towable gas splitter with a reputation for solid construction and dealer support. It converts between horizontal and vertical operation and uses a two-stage hydraulic pump with auto-return. Owners commonly cite the frame, beam and hitch as more robust than budget competitors, and Cub Cadet's dealer network is a plus for buyers who want local service. It generally costs more than comparable Champion or YARDMAX models, so you are paying for the build and support rather than more splitting force. For owners who expect to split for many years and value dealer service, the premium is reasonable. As with all towable gas splitters, check the towing speed limit on the label and confirm whether your state requires lights or registration for road use. Owners who split many cords a year tend to appreciate the sturdier components most, since wear shows up first on hitches, beams and hydraulic fittings of lighter-built machines.",
    "pros": [
      "Robust frame, beam and hitch",
      "Vertical and horizontal operation",
      "Two-stage pump with auto-return",
      "Dealer network for service"
    ],
    "cons": [
      "Priced above similar-tonnage rivals",
      "Heavy to move by hand",
      "Engine and hydraulic maintenance required"
    ],
    "bottomLine": "A durable, dealer-supported splitter for owners who plan to keep it for years.",
    "amazonUrl": "",
    "id": "cub-cadet-ls27"
  },
  {
    "badge": "Best Budget Gas",
    "category": "Gas, 25 Ton, Full Beam",
    "name": "YARDMAX YU2566 25-Ton Full Beam",
    "description": "The YARDMAX YU2566 is a 25-ton gas splitter that brings full-beam construction and vertical and horizontal operation to a lower price than most name-brand competitors. A full beam lets you split on both directions of the ram travel in some setups and generally adds rigidity. It uses a two-stage pump and an auto-return valve, and it tows behind a vehicle. For owners splitting a few cords a year who want gas speed without paying top dollar, it is a strong value. Expect the fit and finish to be a step below Cub Cadet, and plan on checking hydraulic fittings and hardware after the first few hours, which is good practice on any new splitter. Parts and service are available but less widespread than for the biggest brands. It is a good fit for owners who want vertical capability and decent speed but cannot justify the cost of a premium dealer-sold machine.",
    "pros": [
      "25 tons at a budget-friendly price",
      "Full-beam construction",
      "Vertical and horizontal operation",
      "Two-stage pump with auto-return"
    ],
    "cons": [
      "Fit and finish below premium brands",
      "Smaller service network",
      "Heavy and loud like any gas splitter"
    ],
    "bottomLine": "The value pick for gas splitting a few cords a year.",
    "amazonUrl": "",
    "id": "yardmax-yu2566"
  },
  {
    "badge": "Best Value Mid-Size",
    "category": "Gas, 22 Ton, Vertical and Horizontal",
    "name": "Powerhorse 22-Ton Horizontal/Vertical",
    "description": "Powerhorse is Northern Tool's house brand, and its 22-ton splitter offers vertical and horizontal operation, a two-stage pump and auto-return at a price that undercuts many 25 to 27-ton machines. For most seasoned firewood such as oak, maple and ash in typical round sizes, 22 tons is enough, so the lower tonnage costs little in real-world capability. It is a sensible machine for someone who splits two or three cords a year and wants vertical capability for big rounds without paying for extra tonnage they will rarely use. Northern Tool's store network and parts availability help with support. Very large, twisted or green elm and gum rounds will be slower going, and those are the cases where higher-tonnage machines earn their premium. Check fittings and hardware after the first few hours of use, which is sensible on any new hydraulic splitter, and keep the hydraulic fluid at the level the manual specifies.",
    "pros": [
      "Vertical and horizontal at a lower price",
      "22 tons handles most seasoned firewood",
      "Two-stage pump with auto-return",
      "Store network for parts"
    ],
    "cons": [
      "Slower on large, stringy or knotty rounds",
      "Heavy to move without towing",
      "Gas engine maintenance"
    ],
    "bottomLine": "Enough splitter for most homeowners at a fair price.",
    "amazonUrl": "",
    "id": "powerhorse-22-ton"
  },
  {
    "badge": "Best Electric",
    "category": "Electric, 7 Ton, Horizontal",
    "name": "Boss Industrial ES7T20 Electric",
    "description": "Boss Industrial's ES7T20 is a 7-ton electric splitter that plugs into a standard household outlet and handles logs up to about 20 inches long, according to the manufacturer. Electric splitters are quiet, produce no exhaust, and need no engine maintenance, so you can run one in a garage with the door open or close to the house without bothering the neighbors. The ES7T20 is aimed at people splitting a modest amount of seasoned wood for a fireplace or fire pit. Seven tons is plenty for straight-grained seasoned rounds of moderate diameter but will stall on large, knotty or green wood. It operates horizontally, so you must lift each round onto the beam. Use a heavy-gauge extension cord sized per the manual, or plug directly into a GFCI-protected outlet. Never try to force a round that will not split by cycling the ram repeatedly; take it out, rotate it, or set it aside for a larger machine.",
    "pros": [
      "Quiet, no fumes, no engine maintenance",
      "Plugs into a household outlet",
      "Compact enough to store in a garage",
      "Good for seasoned, moderate rounds"
    ],
    "cons": [
      "Stalls on large, knotty or green wood",
      "Horizontal only, so you lift each round",
      "Slower than gas splitters"
    ],
    "bottomLine": "A quiet, low-maintenance choice for fireplace and fire pit volumes.",
    "amazonUrl": "",
    "id": "boss-industrial-es7t20"
  },
  {
    "badge": "Best Budget Electric",
    "category": "Electric, 6.5 Ton, Horizontal",
    "name": "WEN 56207 6.5-Ton Electric",
    "description": "WEN's 56207 is an inexpensive 6.5-ton electric splitter for owners who burn a little wood and do not want to swing a maul. It runs on household current, sits on a stand or workbench at a comfortable height, and is light enough to roll around the garage. It suits seasoned, straight-grained rounds of modest diameter, such as fire pit wood or kindling-size splits from larger pieces. Like all small electric splitters, it can stall on knots, crotches and green hardwood, and you should not try to force it by repeatedly cycling the ram into a round that will not split. The price is its strength; the trade-off is speed and capacity. Owners who go through under a cord per winter may never need more. Stick to straight-grained, seasoned rounds of modest diameter and you will get the best results from it.",
    "pros": [
      "Low price for an electric splitter",
      "Light and easy to store",
      "Quiet, no fuel or engine",
      "Fine for seasoned fire pit wood"
    ],
    "cons": [
      "Low tonnage stalls on knots and green wood",
      "Horizontal only",
      "Slow for larger volumes"
    ],
    "bottomLine": "A budget electric splitter for small, seasoned wood.",
    "amazonUrl": "",
    "id": "wen-56207"
  },
  {
    "badge": "Best Manual",
    "category": "Manual Hydraulic, 10 Ton",
    "name": "Sun Joe LJ10M Logger Joe 10-Ton Hydraulic",
    "description": "The Sun Joe LJ10M is a manual hydraulic splitter: you pump the handles and a hydraulic ram pushes the log into a wedge. There is no engine, no motor and no cord, so it works anywhere and makes almost no noise. Sun Joe lists 10 tons of force, which on paper beats small electric units, but the trade-off is effort and speed; each split takes many pump strokes. It is best for someone who splits small amounts of seasoned wood occasionally, for a cabin without power, or for anyone who wants a safer alternative to a maul for kindling and fire pit wood. It is not practical for cords of wood. Keep hands clear of the ram and wedge at all times, even though it moves slowly. Set it on firm, level ground before use so it cannot tip while you pump.",
    "pros": [
      "No fuel, cord or battery needed",
      "Very quiet operation",
      "Inexpensive",
      "Useful for cabins and occasional use"
    ],
    "cons": [
      "Slow, effortful pumping per split",
      "Not practical for large volumes",
      "Limited log length and diameter"
    ],
    "bottomLine": "A low-cost, power-free option for small amounts of wood.",
    "amazonUrl": "",
    "id": "sun-joe-lj10m"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Log Splitter Picks",
          item: "https://www.allmetalbrake.com/best-log-splitter/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How many tons of splitting force do I actually need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For seasoned, straight-grained firewood of moderate diameter, a 4 to 7-ton electric splitter does the job. For most homeowner firewood, bigger and knottier rounds included, a 20 to 27-ton gas splitter is the practical range. Very large, green or stringy wood such as elm favors the upper end. Past that point, speed and features count for more than extra tons."
          }
        },
        {
          "@type": "Question",
          "name": "Is an electric splitter good enough?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, for fireplace and fire pit volumes of seasoned wood. Electric splitters are quiet, clean and need little maintenance, and you can use them near the house. They cycle slower than gas, usually work horizontally only, and can stall on large, knotty or green wood. If you split more than a cord or two a year, or your rounds are big, gas is the better fit."
          }
        },
        {
          "@type": "Question",
          "name": "Should I rent a splitter instead of buying?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rent if you split once a year and handle a cord or two. Have the wood cut and staged before you collect the machine so you get the most from the rental period. If you split every year, or several cords at a time, buying usually pays for itself within a few seasons, especially if you share the machine with neighbors."
          }
        },
        {
          "@type": "Question",
          "name": "What cycle time should I look for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many gas splitters list cycle times somewhere in the 10 to 20-second range, and quicker is better for big piles. Small electric splitters are generally slower. A two-stage pump and an auto-return valve both make a noticeable difference to speed. Because brands measure under different conditions, use cycle times to compare machines within one class rather than across brands."
          }
        },
        {
          "@type": "Question",
          "name": "Is vertical splitting worth paying extra for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if you split large, heavy rounds. Vertical operation lets you roll a round onto the foot plate instead of lifting it onto a waist-high beam, which protects your back and makes very heavy pieces manageable. If your wood is all moderate pieces that are easy to lift, a horizontal-only machine is perfectly fine for the job."
          }
        },
        {
          "@type": "Question",
          "name": "How long should firewood season after splitting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most hardwoods need at least six months, and often a year or more, stacked off the ground in a sunny, breezy spot with the top covered and the sides open. The EPA's Burn Wise program recommends a moisture content of 20 percent or less for clean burning, and an inexpensive moisture meter tells you when the wood has reached it."
          }
        },
        {
          "@type": "Question",
          "name": "Can two people run a log splitter together?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Manufacturers warn against it. When one person loads and another works the control, the operator cannot reliably see where the loader's hands are, and crushing injuries follow. The safe setup is a single operator who both positions the log and runs the control, with any helpers stacking splits well clear of the machine while it runs."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Yard & Outdoor Tools",
    tags: [
      "best log splitter",
      "gas log splitter",
      "electric log splitter",
      "log splitter tonnage",
      "hydraulic wood splitter",
      "firewood splitting"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The Best Log Splitter
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          For most homeowners burning several cords a year, a 20 to 27-ton gas splitter such as the Champion 27-Ton is the right machine, while a 4 to 7-ton electric covers seasoned fire pit wood. How many cords you split, how big and knotty the rounds are, and whether you can lift them change the pick. Below: seven picks, sizing, tonnage, cycle time, safety and costs.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          Based on manufacturer specs for tonnage, cycle time, log length and warranty, plus build and owner feedback. Not hands-on tested. No paid placements. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">13 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#short-answer" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>The Short Answer</span></a>
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>The 7 Best Log Splitters</span></a>
              <a href="#how-much-wood" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>What Size You Need</span></a>
              <a href="#tonnage" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>How Many Tons</span></a>
              <a href="#cycle-time" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>Good Cycle Time</span></a>
              <a href="#types" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Gas, Electric or Manual</span></a>
              <a href="#features" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Features Worth Paying For</span></a>
              <a href="#safety" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>Using One Safely</span></a>
              <a href="#splitting-tips" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>Splitting and Seasoning</span></a>
              <a href="#maintenance" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Maintenance</span></a>
              <a href="#rent-or-buy" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>Rent or Buy, and Cost</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">12.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">13.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Tonnage is the number log splitter shoppers stare at, and it is the wrong one to start with. Most firewood splits comfortably within the reach of a mid-size machine. What really shapes a long day at the woodpile is how quickly the ram cycles, whether you can split heavy rounds without hoisting them, and whether the machine suits the number of cords you actually burn.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Best Log Splitter: The Short Answer
          </h2>

          <p>
            The Champion 27-Ton is the best log splitter for most people who burn several cords a year: 27 tons, vertical and horizontal operation, a two-stage pump and an auto-return valve, per Champion's listing. Buyers who want heavier construction and dealer service should look at the Cub Cadet LS 27. Anyone splitting modest amounts of seasoned wood near the house is better served by a quiet electric such as the Boss Industrial ES7T20. The table sums up all seven.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Splitter</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Tonnage</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Power and orientation</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Speed notes</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href="#champion-27-ton">Champion 27-Ton</a></td>
                    <td class="px-4 py-4 text-gray-700">Best overall, several cords a year</td>
                    <td class="px-4 py-4 text-gray-700">27 tons</td>
                    <td class="px-4 py-4 text-gray-700">Gas, vertical and horizontal</td>
                    <td class="px-4 py-4 text-gray-700">Quick listed cycle, two-stage pump, auto-return</td>
                  </tr>
