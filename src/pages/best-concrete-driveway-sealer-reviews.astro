                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Factor</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Penetrating silane-siloxane</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Acrylic or urethane film</th>
                  </tr>
                </thead>
