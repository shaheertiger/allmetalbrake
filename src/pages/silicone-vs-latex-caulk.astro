---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/silicone-vs-latex-caulk.html?raw';

const title = "Silicone vs Latex Caulk: Which Should You Use?";
const description = "Silicone seals wet glass and tile but can't be painted; latex paints and grips wood. Where each works, the in-between options, and a job-by-job decision table.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
