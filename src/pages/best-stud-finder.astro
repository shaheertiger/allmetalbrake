const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 7 Best Stud Finders: Sensor Arrays, Scanners and Magnets";
const description =
  "Seven stud finders ranked by wall type and job, from multi-sensor arrays to radar imagers and a cheap magnet, plus how to confirm a stud before you drill.";

