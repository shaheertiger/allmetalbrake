---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Electric Pressure Washers",
    "url": "/best-electric-pressure-washer/"
  },
  {
    "title": "Best Shop Vacs",
    "url": "/best-shop-vac/"
  },
  {
    "title": "Best Benchtop Planers",
    "url": "/best-benchtop-planer/"
  },
  {
    "title": "Best Surface Cleaners for Pressure Washers",
    "url": "/best-surface-cleaner-for-pressure-washer/"
  },
  {
    "title": "How to Remove Oil Stains From a Driveway",
    "url": "/how-to-remove-oil-stains-from-driveway/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "7 Best Pressure Washers in 2026: Gas and Electric by Job";
const description =
  "Seven gas and electric pressure washers matched to real jobs, from washing a car to stripping a driveway, with clear guidance on PSI, GPM, pumps and budget.";

const PRODUCTS = [
  {
    "badge": "Top Pick Overall",
    "category": "Honda GC190 Gas Engine, 2.4 GPM at 3100 PSI",
    "name": "Simpson MegaShot MS60763",
    "description": "The MegaShot MS60763 is the gas machine most homeowners should look at first. Simpson rates it at 3,100 PSI and 2.4 GPM, which works out to roughly 7,400 cleaning units, enough to clear a two-car concrete driveway in a reasonable morning with a surface cleaner attached. Power comes from a Honda GC190 engine, a residential overhead-cam design with a long reputation for starting easily and a dealer network that sells parts almost everywhere. The welded steel frame and 10-inch pneumatic wheels make it easier to roll across gravel or lawn than plastic-wheeled units. It ships with quick-connect tips covering the standard spray angles plus a soap nozzle. The pump is an axial cam design, which is normal at this price but means it is built for weekend use rather than daily contract work. For a house, driveway, deck and fence on a typical suburban lot, this is the balance point between power, reliability and price.",
    "pros": [
      "Honda GC190 engine with wide parts and service support",
      "About 7,400 cleaning units handles concrete efficiently",
      "Steel frame and pneumatic wheels roll well on rough ground",
      "Quick-connect nozzles included for every common job"
    ],
    "cons": [
      "Axial cam pump is not built for daily professional use",
      "Loud and needs fuel, oil and winter prep like any gas engine",
      "Too strong for casual car washing without care"
    ],
    "bottomLine": "The default gas pick for homeowners who clean concrete, siding and decks every year.",
    "amazonUrl": "",
    "id": "simpson-megashot-ms60763"
  },
  {
    "badge": "Top Electric",
    "category": "Brushless Plug-In, 1.2 GPM at 2300 PSI",
    "name": "Ryobi RY142300 2300 PSI Brushless",
    "description": "Ryobi's RY142300 is the electric unit that gives up the least to gas in everyday use. It is rated at 2,300 PSI and 1.2 GPM from a brushless motor, which Ryobi positions as longer-lived and quieter than the brushed universal motors used in most budget plug-ins. It stands upright on a compact frame with wheels, stores its hose and cord on board, and takes standard quick-connect nozzles, so third-party surface cleaners and wands fit without adapters. At about 2,760 cleaning units it handles cars, vinyl siding, outdoor furniture, patios and wood decks comfortably. Concrete is possible but slow, and a small surface cleaner helps a lot there. The draw for most buyers is practical: no fuel, no oil, no pull cord, and you can run it on a weekday evening without the neighbors noticing much. If your job list is mostly the house and the car, this is the machine to start with.",
    "pros": [
      "Brushless motor is quieter and built for longer life",
      "Upright frame with on-board hose and cord storage",
      "Standard quick-connect fittings accept common accessories",
      "No fuel, oil or winter engine care"
    ],
    "cons": [
      "1.2 GPM makes large concrete areas slow",
      "Needs a GFCI outlet within cord reach",
      "Still needs pump protection before a freeze"
    ],
    "bottomLine": "The plug-in to buy if your list is cars, siding, decks and patios rather than acres of concrete.",
    "amazonUrl": "",
    "id": "ryobi-ry142300-brushless"
  },
  {
    "badge": "Gas Value Pick",
    "category": "Generac OHV Gas Engine, 2.7 GPM at 3200 PSI",
    "name": "Generac SpeedWash 3200 PSI",
    "description": "Generac's SpeedWash 3200 is built around one idea: stop swapping nozzles. Its PowerDial spray gun rotates between spray patterns and a soap setting at the handle, so changing from a wide rinse to a narrower cleaning stream takes a twist instead of a walk back to the machine. Generac rates it at 3,200 PSI and 2.7 GPM, about 8,600 cleaning units, which is more flow than many gas units at a similar price and translates directly into faster rinsing. The kit typically includes quick-connect attachments such as a surface cleaner, a rotating brush and a foam cannon, so it can be a complete setup out of the box. It uses Generac's own overhead-valve engine rather than a Honda, which matters mainly for long-term parts sourcing. If you want strong flow and a convenient gun for a reasonable price, it is a smart buy.",
    "pros": [
      "2.7 GPM rinses faster than most consumer gas units",
      "PowerDial gun changes spray pattern at the handle",
      "Bundle commonly includes several useful attachments",
      "Strong cleaning units for the money"
    ],
    "cons": [
      "Generac engine has a smaller service network than Honda",
      "Axial cam pump limits it to homeowner duty",
      "Heavier than an electric to move and store"
    ],
    "bottomLine": "The most flow and convenience per dollar for homeowners who clean big surfaces.",
    "amazonUrl": "",
    "id": "generac-speedwash-3200"
  },
  {
    "badge": "Budget Pick",
    "category": "Plug-In with Two Soap Tanks, 1.76 GPM Max",
    "name": "Sun Joe SPX3000 2030 PSI",
    "description": "The SPX3000 has been one of the most widely sold pressure washers for years because it does light work for very little money. Sun Joe lists maximum figures of 2,030 PSI and 1.76 GPM; like most budget electrics, those peaks are not delivered at the same moment, so treat it as a light-duty machine. It uses a universal motor, which is louder and wears faster than an induction or brushless design, and it has two on-board detergent tanks with a selector switch, which is handy for switching between a car soap and a patio cleaner. Five quick-connect tips come with it, and an automatic shut-off stops the pump when you release the trigger. It is well suited to cars, bikes, grills, lawn furniture and small patios. It is not a good choice for anyone planning to strip a deck or clean a long driveway several times a year.",
    "pros": [
      "Very low price for a capable light-duty machine",
      "Two detergent tanks with a selector switch",
      "Five quick-connect tips included",
      "Light enough to carry up steps"
    ],
    "cons": [
      "Universal motor is loud and has a shorter service life",
      "Peak ratings overstate real cleaning speed",
      "Plastic build and short included hose"
    ],
    "bottomLine": "A sensible first pressure washer for cars and patios, not for heavy annual concrete work.",
    "amazonUrl": "",
    "id": "sun-joe-spx3000"
  },
  {
    "badge": "Heavy-Duty Pick",
    "category": "Honda GX Engine with Triplex Plunger Pump",
    "name": "Simpson PowerShot PS60869",
    "description": "The PowerShot line is where a homeowner pressure washer turns into a light commercial tool. The PS60869 pairs a Honda GX-series engine, the commercial-grade family with a cast-iron cylinder sleeve, with a triplex plunger pump. A triplex pump uses three ceramic plungers and can be serviced and rebuilt, so it is designed to run for many hundreds of hours instead of being replaced when it wears. Simpson rates this machine in the 4,000-PSI-plus class with high flow, which puts it well above the MegaShot in cleaning units. That much energy is overkill for a car and dangerous on soft wood if you are careless, but it is exactly right for someone who cleans large concrete pads, farm equipment, a long fence line or several properties. Expect to pay roughly double a residential gas unit. If you would use it weekly, the pump alone justifies the price.",
    "pros": [
      "Serviceable triplex plunger pump built for long hours",
      "Commercial Honda GX engine",
      "Very high cleaning units for big concrete jobs",
      "Heavy steel frame with large wheels"
    ],
    "cons": [
      "Roughly double the cost of a residential gas unit",
      "Heavy and loud, hard to store in a small garage",
      "Easy to damage wood and siding without care"
    ],
    "bottomLine": "Only worth it if you clean large areas often enough to need a pump that can be rebuilt.",
    "amazonUrl": "",
    "id": "simpson-powershot-ps60869"
  },
  {
    "badge": "Gentlest on Paint",
    "category": "Water-Cooled Plug-In, 1.4 GPM, Gun Pressure Control",
    "name": "Karcher K5 Premium Smart Control",
    "description": "Karcher's K5 Premium Smart Control is the electric pick for people who care about the finish on what they are cleaning. Karcher rates it around 2,000 PSI and 1.4 GPM from a water-cooled induction motor, a design that runs cooler and quieter than budget universal motors. Its signature feature is the trigger gun with a small display and pressure settings, so you can step the pressure down for paint and glass and back up for patio stones without switching tips. The Smart Control app pairs with the gun to suggest settings for different surfaces. The hose reel and tall upright frame make it tidy to store. The main drawback is that Karcher uses its own connection system on parts of the setup, so some third-party accessories need adapters. For car detailing, painted siding and outdoor furniture, it is the most controllable machine on this list.",
    "pros": [
      "Pressure adjustable at the gun with a readout",
      "Water-cooled induction motor runs quieter",
      "Built-in hose reel and tidy upright storage",
      "Excellent control for paint and glass"
    ],
    "cons": [
      "Some fittings are proprietary and need adapters",
      "Pricey for a 2,000 PSI machine",
      "Slow on large concrete areas"
    ],
    "bottomLine": "Buy it for controlled, gentle cleaning of cars, siding and furniture rather than raw power.",
    "amazonUrl": "",
    "id": "karcher-k5-premium"
  },
  {
    "badge": "Most Pressure on a Plug",
    "category": "Induction Plug-In, 1.1 GPM, 3000 PSI Rating",
    "name": "Greenworks Pro GPW3000 3000 PSI Electric",
    "description": "Greenworks advertises this as a 3,000 PSI electric, which is about as high as plug-in pressure washers go on a standard household circuit. The catch is flow: at roughly 1.1 GPM, its cleaning units land near 3,300, only a little above a good 2,000 PSI machine. Where the extra pressure helps is on stuck-on grime in small spots, such as tire marks, mildew in brick joints and the corners of a garage slab. It uses an induction motor and a sturdier frame than entry-level electrics, with on-board storage for tips, hose and cord. For siding, decks and patios it performs much like other mid-range electrics, and for concrete it still benefits from a surface cleaner. Buy it if you want the strongest point pressure you can get without a gas engine, and understand that pressure alone does not make a machine clean faster.",
    "pros": [
      "Among the highest PSI ratings on a household circuit",
      "Induction motor for longer life than universal designs",
      "Sturdier frame and storage than budget electrics",
      "Good for stubborn small-area stains"
    ],
    "cons": [
      "Low flow keeps overall cleaning speed modest",
      "High pressure needs care on wood and siding",
      "Heavier than compact electrics"
    ],
    "bottomLine": "A strong electric for tough spot cleaning, but not a substitute for a gas unit on big concrete.",
    "amazonUrl": "",
    "id": "greenworks-pro-3000-electric"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Pressure Washer Picks",
          item: "https://www.allmetalbrake.com/best-pressure-washer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which pressure washer should most homeowners buy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a typical suburban home with a driveway, siding and a deck, the Simpson MegaShot MS60763 balances flow, engine reliability and price well. If your jobs are mostly cars, patios and siding, the Ryobi RY142300 brushless electric is easier to live with. Decide on your three most frequent jobs first, then choose the power source that suits them."
          }
        },
        {
          "@type": "Question",
          "name": "Does flow or pressure matter more?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Flow, measured in GPM, is the one that predicts how fast you finish. PSI breaks dirt loose; flow carries it away. Multiply the two to get cleaning units, which is the most useful single figure for comparing machines. For delicate surfaces, moderate PSI with decent flow is the safest choice. For big concrete, prioritize GPM within your budget."
          }
        },
        {
          "@type": "Question",
          "name": "How much PSI do I need for a concrete driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most broom-finished driveways clean well somewhere between 2,500 and 3,500 PSI, ideally with at least 2.3 GPM and a rotating surface cleaner. A smaller electric can clean concrete, but it takes much longer and is prone to striping. Pretreat oil and rust stains with the right cleaner, because extra pressure does little to lift them on its own."
          }
        },
        {
          "@type": "Question",
          "name": "Can a pressure washer damage my house or deck?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, easily. Too narrow a tip or holding the wand too close can splinter softwood, etch concrete, strip paint, force water behind siding and break window seals. Start with a wide tip at a distance, test in a hidden spot, and increase force only as needed. On older homes, painted surfaces or anything you are unsure about, low pressure and a cleaner are safer."
          }
        },
        {
          "@type": "Question",
          "name": "Are electric pressure washers good enough?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For cars, outdoor furniture, decks, siding and modest patios, a good electric is more than enough and much easier to own. Where they fall short is large concrete areas, because household circuits limit flow to under about 2 GPM. Pair an electric with a small surface cleaner and it will handle a walkway and a single-car pad comfortably."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a home pressure washer last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends mainly on the pump and how it is stored. Consumer axial cam pumps are typically rated in the low hundreds of hours, which can mean many years of occasional use if the machine is never frozen or run dry. Triplex pumps are commonly rated much higher and can be rebuilt. Winterizing and using pump saver extend life significantly."
          }
        },
        {
          "@type": "Question",
          "name": "Should I rent or buy a pressure washer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you have one heavy job a year, renting a commercial gas unit for a day is usually cheaper and avoids storage and maintenance. Buying pays off once you have several substantial jobs each season or want to clean cars and furniture whenever you like. Many homeowners own an electric for routine work and rent gas for the yearly driveway."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Cleaning & Shop Tools",
    tags: [
      "best pressure washer",
      "gas pressure washer",
      "pressure washer buying guide",
      "psi vs gpm",
      "cleaning units",
      "pressure washer for driveway"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The 7 Best Pressure Washers, Gas and Electric, Matched to the Job
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          The right machine depends on what you clean and how often. These picks run from a quiet plug-in for cars and patio furniture up to a triplex-pump gas unit for anyone who strips decks and driveways every spring.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">11 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>Top Picks</span></a>
              <a href="#cleaning-units" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>Pressure Times Flow</span></a>
              <a href="#gas-or-electric" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Gas or Electric</span></a>
              <a href="#job-matching" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Matching the Machine to the Job</span></a>
              <a href="#pumps-engines" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>Pumps and Engines</span></a>
              <a href="#nozzles-accessories" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Nozzles and Add-Ons</span></a>
              <a href="#running-it" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Running It Safely</span></a>
              <a href="#storage-winter" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>Storage and Winter</span></a>
              <a href="#cost" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>What It Costs</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most people buy too much pressure washer or too little, and both mistakes cost money. A homeowner who washes a car, a grill and a patio set twice a year does not need a 3,000 PSI gas engine sitting in the shed with stale fuel in it. Someone with a long concrete driveway, a two-story house and a fence line will burn an entire Saturday with a small electric unit and still see stripes. The number that tells you which camp you are in is not PSI on its own; it is pressure multiplied by flow. This guide ranks seven machines on that basis and then explains how to pick, set up, run and store whichever one you buy.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Best Pressure Washers, Ranked
          </h2>

          <p>
            Picks are based on manufacturer ratings for pressure, flow, engine or motor type and pump design, along with warranty terms, parts availability and recurring patterns in owner feedback. We weighted each machine by how well it fits a realistic household job list and budget. No hands-on testing is claimed, and no brand paid for placement.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} index={index} />
          ))}
        </div>

        <div id="cleaning-units" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Pressure Times Flow: The Number That Predicts Speed
          </h2>

          <p>
            Every box leads with PSI because it is the biggest number, but PSI only describes how hard the water hits. GPM, gallons per minute, describes how much water is doing the work and how fast it carries loosened dirt away. A narrow stream at high pressure will cut a clean line in grime, then leave you waiting while the slurry sits there. More flow sweeps it off. That is why a 2,700 PSI gas machine at 2.5 GPM finishes a driveway far faster than a 3,000 PSI electric at 1.1 GPM.
          </p>

          <p>
            The industry shorthand for combining the two is cleaning units: multiply PSI by GPM. A typical budget electric lands between about 2,500 and 3,500. A good residential gas unit lands between 7,000 and 9,000. A commercial triplex machine can top 14,000. Cleaning units are not a lab standard, and they ignore nozzle design and how well a machine holds pressure under load, but as a first filter for comparing two machines in a store aisle, nothing works better.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">Typical Cleaning Units by Class</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">2,500-3,500</p>
                <p class="text-gray-400 text-xs mt-1">Budget electric</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">2,800-3,500</p>
                <p class="text-gray-400 text-xs mt-1">Premium electric</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">7,000-9,000</p>
                <p class="text-gray-400 text-xs mt-1">Residential gas</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">12,000+</p>
                <p class="text-gray-400 text-xs mt-1">Triplex gas</p>
              </div>
            </div>
          </div>

          <p>
            Watch for the word max. Many electric units, and some gas units, publish the highest pressure the pump can produce in a spike and the highest flow it can deliver with no restriction. Those two peaks do not happen together. Brands that publish rated or working figures certified under the CETA or PWMA standard give you numbers you can trust more. When a spec sheet says max PSI and max GPM, assume real working performance is noticeably lower and compare cleaning units with that discount in mind.
          </p>

          <p>
            The practical rule: if your main job is a large flat surface, shop on GPM first and pressure second. If your main job is vertical surfaces, painted finishes or vehicles, more pressure is rarely useful and often harmful, and a mid-range electric with good flow for its class is the better tool. Most homeowners land in the second group more than they expect, which is why the <a href="/best-electric-pressure-washer/">best electric pressure washers</a> cover a larger share of real chore lists than the spec race suggests.
          </p>
        </div>

        <div id="gas-or-electric" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Gas or Electric: Choosing the Power Source
          </h2>

          <p>
            Gas buys you flow, freedom from cords and the ability to clean a long driveway in one session. It costs you noise, weight, fuel storage, oil changes and winter prep, and it brings carbon monoxide into the picture. A residential gas unit typically weighs 55 to 80 pounds and is loud enough that hearing protection is a good idea. If you clean concrete, a large deck or a whole house every year, the speed difference repays that hassle quickly.
          </p>

          <p>
            Electric buys you convenience. You plug it in, connect the hose, and you are washing in a minute. Noise is closer to a loud vacuum, there are no fumes, and storage is a matter of draining the pump and rolling it into a corner. The trade-off is the household circuit: a 15-amp outlet limits a plug-in to roughly 1,800 watts, which caps flow at around 1.1 to 1.8 GPM no matter what the pressure rating says. That ceiling is physics, not a brand failing.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
