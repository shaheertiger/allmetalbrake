---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Basement Floor Paint",
    "url": "/best-basement-floor-paint/"
  },
  {
    "title": "Best Porch Paint",
    "url": "/best-porch-paint/"
  },
  {
    "title": "Best Paint Sprayer",
    "url": "/best-paint-sprayer/"
  },
  {
    "title": "Best Garage Floor Epoxy",
    "url": "/best-garage-floor-epoxy/"
  },
  {
    "title": "Best Concrete Floor Paint",
    "url": "/best-concrete-floor-paint/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 6 Best Concrete Floor Coatings: Epoxy to Polyaspartic";
const description =
  "Two-part epoxy, polyaspartic, hybrid and penetrating systems ranked by chemistry, with the grinding, moisture and cure rules that decide how long they last.";

const PRODUCTS = [
  {
    "category": "Two-component epoxy kit",
    "name": "Rust-Oleum EpoxyShield Professional Floor Coating Kit",
    "badge": "Best Overall",
    "id": "rust-oleum-epoxyshield-pro",
    "amazonUrl": "",
    "pros": [
      "Complete kit with resin, hardener and decorative chips",
      "Thicker, harder film than Rust-Oleum's standard garage kit",
      "Sold at mainstream retailers with clear instructions",
      "Good resistance to oil, salt and hot tires once cured",
      "Widely documented by DIY owners, so troubleshooting help is easy to find"
    ],
    "cons": [
      "Limited pot life once mixed means working fast",
      "Longer wait before vehicle traffic than polyaspartic systems",
      "Aromatic epoxy can amber in direct sunlight"
    ],
    "bottomLine": "The most practical true two-part epoxy for a DIY garage or shop floor, with the support and availability of a major brand.",
    "description": "Rust-Oleum's Professional kit is the step up from the brand's entry-level EpoxyShield garage kit, and it is the system we would point most first-time coaters toward. It is a genuine two-part epoxy: you mix resin and hardener, which starts a reaction that produces a harder, thicker and more chemical-resistant film than any one-part paint. The kit bundles the components and decorative chips, so you are not hunting down compatible pieces. The main demand it places on you is time management. Once mixed, the material has a limited pot life, so you need the floor fully prepped, edges cut in, and a helper ready before the lids come off. Rust-Oleum's instructions call for a clean, profiled, dry slab and a multi-day wait before vehicles. Owners who follow those steps tend to report a durable, good-looking floor; failures in owner reports usually trace to a sealed slab, skipped etching or grinding, or moisture coming up through the concrete."
  },
  {
    "category": "Polyaspartic coating system",
    "name": "Leggari Polyaspartic Floor Coating Kit",
    "badge": "Best Durability",
    "id": "leggari-polyaspartic",
    "amazonUrl": "",
    "pros": [
      "Polyaspartic chemistry is UV-stable and resists yellowing",
      "Fast cure means a much shorter return-to-service window",
      "Excellent abrasion and chemical resistance",
      "Works in a wider temperature range than most epoxies",
      "Strong instructional support from the manufacturer"
    ],
    "cons": [
      "Very short working time demands planning and speed",
      "Costs considerably more than DIY epoxy kits",
      "Strong odor during application; ventilation required"
    ],
    "bottomLine": "The closest a DIYer can get to a professional polyaspartic flake floor, if you can work fast and budget for it.",
    "description": "Leggari sells polyaspartic floor kits direct to homeowners, along with an unusually detailed library of instructional videos. Polyaspartic is the chemistry most professional garage coating companies now use, because it cures quickly, does not yellow in sunlight the way aromatic epoxies can, and holds up well to abrasion, hot tires and common garage chemicals. The trade-off is working time. Polyaspartics react fast, so you mix small batches and roll them out quickly, with no room for a lunch break mid-floor. Leggari's process relies on proper grinding rather than acid etching, which means renting a diamond grinder and a dust-collecting vacuum, and the brand is clear about that. The result, done right, is a floor that is ready for traffic far sooner than an epoxy and keeps its color near open garage doors. It is not cheap and it is not forgiving. For a confident DIYer who preps properly, it is the most durable system on this list."
  },
  {
    "category": "Hybrid polyurea-epoxy coating",
    "name": "Rust-Oleum RockSolid Polycuramine Garage Floor Coating",
    "badge": "Best Fast Turnaround",
    "id": "rust-oleum-rocksolid-polycuramine",
    "amazonUrl": "",
    "pros": [
      "Hybrid chemistry cures faster than standard epoxy kits",
      "Single-coat system with decorative chips included",
      "Rust-Oleum markets it for strong hot tire and chemical resistance",
      "Available at major retailers",
      "Shorter wait before parking than typical epoxy"
    ],
    "cons": [
      "Short pot life once mixed",
      "Prep requirements are strict; it is unforgiving of sealed or damp slabs",
      "Pricier per square foot than standard epoxy kits"
    ],
    "bottomLine": "A strong mid-point between DIY epoxy and polyaspartic, for people who want their garage back quickly.",
    "description": "RockSolid uses what Rust-Oleum calls polycuramine, a hybrid chemistry that borrows from both polyurea and epoxy. In practical terms it behaves like a faster, tougher epoxy: it reacts quickly, builds a hard film in a single coat, and is marketed for strong resistance to hot tires, salt and automotive fluids. Its biggest selling point for homeowners is turnaround. Rust-Oleum lists a shorter return-to-service window than a typical epoxy kit, which matters if the garage is also where the car lives. The flip side of fast curing is a short pot life, so mixing in manageable batches and working with a helper is the norm. Like every film coating, it fails when it goes over a sealer, an unprofiled slab or a damp floor, and several negative owner reports describe exactly those situations. Over a clean, ground or etched, dry floor, it is a well-regarded system with the convenience of a big-box purchase."
  },
  {
    "category": "100% solids epoxy system",
    "name": "ArmorPoxy 100% Solids Epoxy Floor Kit",
    "badge": "Best for Heavy-Use Shops",
    "id": "armorpoxy-100-solids",
    "amazonUrl": "",
    "pros": [
      "100% solids means no solvent or water to evaporate, so the full film stays",
      "Builds a thick, heavy-duty layer in fewer coats",
      "Kits include primer and topcoat options for a full system",
      "Suited to workshops and heavy-use floors",
      "Direct manufacturer support"
    ],
    "cons": [
      "Heavier material is harder to spread evenly for beginners",
      "Aromatic epoxy may amber under UV exposure",
      "Higher cost than retail epoxy kits"
    ],
    "bottomLine": "For shops and heavy-use garages where film thickness and impact resistance matter more than speed.",
    "description": "ArmorPoxy sells high-solids epoxy systems directly, aimed at workshops, garages and light commercial floors. The key specification is 100% solids, meaning the product contains no water or solvent that evaporates. What you roll on is essentially what stays, which lets it build a thick film in fewer coats than water-based kits that lose much of their volume as they dry. Thickness matters for impact resistance from dropped tools and for hiding minor surface flaws. The material is heavier and more viscous than retail kits, so it takes practice to spread at an even thickness, and squeegee-and-backroll techniques are common. Like most epoxies, it can amber in direct sunlight, so many installers top it with a UV-stable urethane or polyaspartic clear coat on floors near open doors. ArmorPoxy's kits include primer and topcoat options to build a complete system. It costs more than a big-box kit and asks more of the installer, but rewards both with a seriously durable floor."
  },
  {
    "category": "One-part textured coating",
    "name": "BEHR Premium Granite Grip Decorative Concrete Coating",
    "badge": "Best One-Part Alternative",
    "id": "behr-premium-1part",
    "amazonUrl": "",
    "pros": [
      "No mixing, no pot life, no race against the clock",
      "Textured finish gives good wet traction",
      "Hides surface imperfections and patched areas",
      "Low odor and water cleanup",
      "Good fit for patios, walks and pool surrounds"
    ],
    "cons": [
      "One-part chemistry is not built for vehicle traffic",
      "Texture holds dirt and is harder to sweep"
    ],
    "bottomLine": "The coating to choose for foot-traffic concrete where slip resistance and forgiveness matter more than garage-grade toughness.",
    "description": "Not every concrete floor needs a two-part system, and Granite Grip is the pick for the ones that do not. It is a one-part, water-based textured coating that produces a speckled, stone-like finish with real grip underfoot when wet. That makes it a sensible choice for patios, pool surrounds, walkways and basement entries, where a smooth epoxy can become slippery. Because it is one-part, there is no mixing ratio and no pot life, so you can work at your own pace, stop for lunch and pick up where you left off. The texture also disguises patched areas and minor surface wear that a shiny film would put on display. Garages are where it falls short. Like other one-part products, it is not designed for the stresses of hot tires and parked vehicles, and owners who try it in a garage report more problems than those who keep it outdoors. Used on foot-traffic concrete, it is a good value."
  },
  {
    "category": "Penetrating silane-siloxane sealer",
    "name": "Ghostshield Siloxa-Tek 8500 Penetrating Concrete Sealer",
    "badge": "Best No-Film Option",
    "id": "ghostshield-siloxa-tek",
    "amazonUrl": "",
    "pros": [
      "Penetrates into the concrete rather than forming a surface film",
      "Cannot peel, flake or delaminate",
      "Helps repel water, salt and freeze-thaw damage",
      "Leaves the natural look of bare concrete",
      "Simple spray or roll application"
    ],
    "cons": [
      "Adds no color, gloss or decorative finish",
      "Does not stop oil from staining as well as a film coating does"
    ],
    "bottomLine": "The right answer for anyone who wants protected concrete with no coating to maintain, peel or reapply.",
    "description": "Siloxa-Tek 8500 is here because the best floor coating for some slabs is no coating at all. It is a penetrating silane-siloxane water repellent, which means it soaks into the concrete and reacts inside the pores rather than building a film on top. Nothing sits on the surface to peel, chip or lift under hot tires, and it does not change how the slab looks beyond a slight darkening in some cases. Its job is keeping water, road salt and freeze-thaw damage out of the concrete, which is the main cause of scaling and spalling on garage floors, driveways and walks in cold climates. What it does not do is make a floor easier to clean or more decorative, and oil can still mark the surface, though it tends to sit on top longer before soaking in. Ghostshield publishes detailed technical data on its products. For a slab you want protected but not coated, it is a smart buy."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Concrete Floor Coatings",
          item: "https://www.allmetalbrake.com/best-concrete-floor-coating/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which concrete floor coating is the most durable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In residential garages, polyaspartic and high-solids epoxy systems topped with a polyaspartic or urethane clear coat are the most durable options. Polyaspartic has the edge in UV stability and fast cure, while thick epoxy offers excellent impact resistance. Durability depends heavily on prep, especially diamond grinding and moisture testing, so a properly installed epoxy can outlast a poorly installed polyaspartic."
          }
        },
        {
          "@type": "Question",
          "name": "Polyaspartic or epoxy: which is better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Polyaspartic cures faster, resists UV yellowing and generally holds up better to abrasion and hot tires, which is why professional installers prefer it. Epoxy is cheaper, easier for DIYers to apply and builds thick films for impact resistance. Many professional floors use both: an epoxy base coat for build and bonding, and a polyaspartic topcoat for UV and wear resistance."
          }
        },
        {
          "@type": "Question",
          "name": "Does concrete have to be ground before it is coated?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For polyaspartic and high-solids epoxy, manufacturers generally specify diamond grinding to create a consistent profile and remove contaminants. Some water-based epoxy kits allow acid etching on porous, unsealed slabs. If the floor has an existing sealer, old coating or is very smooth and dense, grinding is the reliable way to prepare it, regardless of product."
          }
        },
        {
          "@type": "Question",
          "name": "What lifespan should I expect from a floor coating?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A water-based DIY epoxy kit often lasts about three to six years in a residential garage, while professionally installed polyaspartic or thick epoxy floors with a clear topcoat commonly last ten years or more. The range depends on prep, moisture, traffic, sunlight and maintenance. Recoating the topcoat as it wears can extend life considerably."
          }
        },
        {
          "@type": "Question",
          "name": "Can I coat a basement floor with epoxy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can, but only if the slab passes moisture testing. Basement slabs often move moisture vapor upward, which can cause epoxy to blister and peel. Test with a plastic sheet or calcium chloride kit first. If moisture is high, use a moisture-mitigating primer system, a breathable floor paint, or a penetrating sealer instead of a standard epoxy coating."
          }
        },
        {
          "@type": "Question",
          "name": "What causes hot tire pickup?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hot tires soften and bond to the surface of a floor coating when parked, then lift it as they roll away. It is most common with one-part paints, thin coatings and coatings that have not fully cured. Thick two-part coatings over well-prepared concrete resist it, as does waiting the full vehicle cure time before parking on a new floor."
          }
        },
        {
          "@type": "Question",
          "name": "Should I coat my garage floor or just seal it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Coat it if you want a decorative, easy-to-clean surface that hides stains and brightens the space. Seal it with a penetrating sealer if you want protection from water, salt and freeze-thaw with no film to peel or maintain. In cold climates with heavy road salt, a penetrating sealer is a low-risk choice; for a showroom finish, choose a coating."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Paint & Floor Coatings",
    tags: [
      "best concrete floor coating",
      "polyaspartic floor coating",
      "two part epoxy floor",
      "garage floor coating system",
      "concrete coating chemistry",
      "flake floor coating"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 6 Best <span class="text-[#38BDF8]">Concrete Floor Coatings</span>, by Chemistry
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          When one-part paint is not enough: two-part epoxy, polyaspartic and hybrid systems, plus the penetrating option for people who want no film at all.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#rust-oleum-epoxyshield-pro"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="8.9k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#chemistries" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Coating Chemistries</a>
          <a href="#choose" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Match It to the Space</a>
          <a href="#profile" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Grinding vs Etching</a>
          <a href="#moisture" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Moisture Rules</a>
          <a href="#install-day" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Install Day</a>
          <a href="#failures" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Why Coatings Fail</a>
          <a href="#cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. DIY vs Pro Cost</a>
          <a href="#care" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Care and Recoating</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A real floor coating is a chemical reaction you start on purpose and then race to finish. That is what makes two-part epoxy and polyaspartic floors so much tougher than paint, and it is also why they go wrong so expensively. The product you buy matters less than three decisions you make before mixing: which chemistry suits the space, how the slab is profiled, and whether moisture is coming up through it. This guide ranks six systems and walks through each of those decisions.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 6 Best Concrete Floor Coatings, Ranked
          </h2>

          <p>
            We ranked these systems on manufacturer data sheets and kit contents, published cure and recoat windows, warranty terms, the chemistry each one uses, and consistent themes in owner feedback. We have not run our own wear or adhesion tests on them. Where a claim comes from a label or a manufacturer, we say so.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-gray-500 text-sm font-bold">{product.rating}</span>
                    <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} ratings on Amazon)</span>
                  </div>
                  )}

                  <p class="text-gray-700 leading-relaxed mb-6">{product.description}</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 rounded-xl p-4">
                      <p class="text-xs font-black uppercase tracking-widest text-green-700 mb-3">Pros</p>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="flex items-start gap-2 text-sm text-green-800">
