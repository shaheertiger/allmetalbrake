---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/efflorescence-on-basement-walls.html?raw';

const title = "What Is Efflorescence on Basement Walls? Causes and Fixes";
const description = "The white crust on basement walls is salt left by water moving through masonry. How to tell it from mold, remove it safely, and stop it coming back.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
