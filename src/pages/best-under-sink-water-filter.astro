---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Water Filtration Systems for Home",
    "url": "/best-water-filtration-system-for-home/"
  },
  {
    "title": "Best Shower Head Filters",
    "url": "/best-shower-head-filter/"
  },
  {
    "title": "Best Water Filter Pitchers",
    "url": "/best-water-filter-pitcher/"
  },
  {
    "title": "Best Drain Snakes",
    "url": "/best-drain-snake/"
  },
  {
    "title": "Best Gas Water Heaters",
    "url": "/best-gas-water-heater/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-10", modified: "2026-11-10" });
const title = "Best Under Sink Water Filter in 2026: 6 Picks, Certifications Checked";
const description =
  "The best under sink water filters for 2026, ranked by what each is actually certified to remove: NSF/ANSI 42, 53, 401 and 58 explained, plus cartridge costs.";

const PRODUCTS = [
  {
    "id": "aquasana-claryum-3-stage",
    "name": "Aquasana Claryum 3-Stage Under Sink Water Filter System",
    "category": "3-stage carbon filter with dedicated faucet, NSF/ANSI 42, 53 and 401",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "specs": [
      [
        "Certifications",
        "NSF/ANSI 42, 53 (incl. P473) and 401, tested by WQA"
      ],
      [
        "Contaminants",
        "Up to 78, per Aquasana"
      ],
      [
        "Filter Capacity",
        "600 gallons or 6 months"
      ],
      [
        "Rated Service Flow",
        "0.5 gpm"
      ],
      [
        "Replacement Set",
        "AQ-C3-R"
      ]
    ],
    "pros": [
      "Broadest certification list here among carbon filters: 42, 53 and 401",
      "Certified for lead and PFOA/PFOS, the two contaminants most buyers worry about",
      "Keeps minerals in the water, unlike reverse osmosis",
      "No wastewater, no tank and no electricity",
      "Dedicated faucet leaves your main tap untouched"
    ],
    "cons": [
      "600-gallon cartridges are the shortest-lived here, so plan on two sets a year",
      "0.5 gpm is slow to fill a large pot",
      "Does not reduce dissolved salts, nitrates or hardness"
    ],
    "bottomLine": "The under sink filter to buy if you want certified lead and PFAS reduction without the cost and wastewater of reverse osmosis.",
    "description": "The Claryum 3-Stage is the best all-round under sink water filter because its certification matches what most people are actually trying to fix. Aquasana says the system is tested and certified by the WQA to NSF/ANSI 42, 53 and 401, and that the Standard 53 listing includes protocol P473, the PFOA/PFOS reduction claim. Aquasana says its current Claryum line meets the tighter Standard 53 PFAS limit, and it lists up to 78 contaminants reduced. That covers lead, chlorine, many pesticides and several pharmaceuticals in one plain carbon system. It feeds its own faucet, so you keep full flow at the main tap for dishes. The trade-off is life and speed: the cartridge set is rated for 600 gallons or six months, and the rated service flow is 0.5 gpm, which means about two minutes to fill a stockpot. For a household that drinks and cooks with tap water and wants the certification paperwork to back the claim, nothing else here balances coverage, cost and simplicity as well."
  },
  {
    "id": "ao-smith-ao-us-200",
    "name": "A.O. Smith AO-US-200 2-Stage Under Sink Water Filter",
    "category": "2-stage carbon filter with dedicated faucet, NSF/ANSI 42, 53 and 401",
    "badge": "Best Budget Certified",
    "amazonUrl": "#",
    "specs": [
      [
        "Certifications",
        "NSF/ANSI 42, 53 and 401, tested by WQA"
      ],
      [
        "Filter Capacity",
        "500 gallons or 6 months"
      ],
      [
        "Flow Rate",
        "0.5 gpm"
      ],
      [
        "Operating Limits",
        "20-80 psi, 40-90°F, cold water only"
      ],
      [
        "Replacement",
        "AO-US-200-R"
      ]
    ],
    "pros": [
      "Same three NSF/ANSI standards as our top pick, usually for less",
      "A.O. Smith lists lead, mercury, asbestos, pesticides and chlorine among the reductions",
      "Simple two-cartridge layout, one replacement part number",
      "Dedicated faucet included"
    ],
    "cons": [
      "500-gallon rating is the lowest here",
      "Slow 0.5 gpm flow",
      "Contaminant count differs between maker (78) and some retailer copy (77)"
    ],
    "bottomLine": "The cheapest way into full NSF/ANSI 42, 53 and 401 certification, as long as you accept changing cartridges twice a year.",
    "description": "A.O. Smith owns Aquasana, and the AO-US-200 is the budget expression of the same idea: a compact two-stage carbon system that feeds its own faucet and carries real health-effect certification. A.O. Smith says the complete system was tested and certified by the WQA to NSF/ANSI 42, 53 and 401, and the replacement cartridge listing marks lead reduction and the P473 PFOA/PFOS protocol as met. The data sheet rates it at 500 gallons or six months, 0.5 gpm, 20 to 80 psi, and 40 to 90°F, and it states plainly that the unit is for cold water only. That last point applies to every carbon filter on this page, but A.O. Smith is one of the few makers that spells it out. The compromises are the short cartridge life and the slow flow, which is the same speed as the Claryum. Pick this one if certification is the priority and the budget is tight; pick the Claryum if you want the extra stage and slightly longer filter life."
  },
  {
    "id": "waterdrop-10ua",
    "name": "Waterdrop 10UA Under Sink Water Filter System",
    "category": "Single-cartridge direct-connect filter, NSF/ANSI 42 and 372",
    "badge": "Best Value for Taste",
    "amazonUrl": "#",
    "specs": [
      [
        "Certifications",
        "NSF/ANSI 42 (chlorine taste and odor), NSF/ANSI 372 (lead-free materials), via IAPMO"
      ],
      [
        "Filter Life",
        "Up to 12 months (gallon rating varies by listing)"
      ],
      [
        "Flow Rate",
        "0.75 gpm"
      ],
      [
        "Filtration",
        "0.5 micron, per Waterdrop"
      ],
      [
        "Replacement",
        "WD-RF10"
      ]
    ],
    "pros": [
      "Longest filter life here at up to a year per cartridge",
      "Connects to the existing cold line, so no extra faucet hole",
      "Low running cost per year",
      "Quick twist-off cartridge change"
    ],
    "cons": [
      "Certified only for chlorine taste and odor, not lead or PFAS",
      "Standard 372 covers the materials, not contaminant removal",
      "No reduction of dissolved solids"
    ],
    "bottomLine": "The right buy if your water is safe but tastes of chlorine, and the wrong one if you are worried about lead or PFAS.",
    "description": "The Waterdrop 10UA is the most popular style of under counter water filter on Amazon: a single slim cartridge that splices into the cold line and feeds your existing faucet. It is cheap to run because one WD-RF10 cartridge is rated for up to 12 months. What it is certified for is narrower than the listing implies. The IAPMO certifications on record are NSF/ANSI 42 for chlorine taste and odor and NSF/ANSI 372, which confirms the wetted parts are lead-free materials. Standard 372 is not a lead-removal claim. Waterdrop markets reductions of lead, PFAS and heavy metals, but we found no certification covering those claims for this model, so treat them as unverified. Waterdrop lists a 0.75 gpm flow, and its 0.5 micron rating is a marketing figure rather than a certified reduction. If your utility's water report is clean and the complaint is a swimming-pool taste, this is excellent value. If you have an older home with lead service lines, buy one of the two certified picks above it."
  },
  {
    "id": "frizzlife-sk99-new",
    "name": "Frizzlife SK99-NEW 3-Stage Direct-Connect Under Sink Water Filter",
    "category": "3-stage direct-connect carbon filter, up to 2.0 gpm",
    "badge": "Best High Flow",
    "amazonUrl": "#",
    "specs": [
      [
        "Flow Rate",
        "Up to 2.0 gpm at 60 psi, per Frizzlife"
      ],
      [
        "Stages",
        "3"
      ],
      [
        "Filtration",
        "0.5 micron compound carbon block"
      ],
      [
        "Connection",
        "Direct-connect to existing faucet"
      ],
      [
        "Filter Change",
        "First stage every 3-6 months, per Frizzlife"
      ]
    ],
    "pros": [
      "Fastest rated flow on this list, close to an unfiltered faucet",
      "Feeds your main faucet, so no extra hole in the counter",
      "Targets chlorine and chloramine",
      "Three stages in a compact bracket"
    ],
    "cons": [
      "Frizzlife's own page does not show the NSF listing that retailers cite",
      "No published gallon rating for the cartridges",
      "Not reverse osmosis, so dissolved solids pass through"
    ],
    "bottomLine": "The pick for a busy kitchen that runs all its water through the filter and cannot stand a trickle.",
    "description": "Most under sink carbon filters give you 0.5 to 0.75 gpm, which is fine at a dedicated drinking faucet and frustrating at a main tap. The Frizzlife SK99-NEW is rated by its maker at up to 2.0 gpm at 60 psi, which is why it suits a direct-connect setup where every pot, kettle and glass comes from the filtered faucet. Frizzlife describes it as a three-stage 0.5 micron system built around a compound activated carbon block aimed at chlorine and chloramine, and it is clear that this is not reverse osmosis. Retailer listings describe the SK99-NEW as certified to NSF/ANSI 42 and 53, but we could not find that certification shown on Frizzlife's own product page, so look it up on the certifier's database before you rely on it for lead. Frizzlife also gives a time-based change interval for the first stage of every three to six months rather than a gallon rating. Buy it for flow and convenience; buy the Claryum for documented health claims."
  },
  {
    "id": "ispring-rcc7ak",
    "name": "iSpring RCC7AK 6-Stage Reverse Osmosis System with Alkaline Remineralization",
    "category": "75 GPD tank-style RO with alkaline stage, NSF/ANSI 58",
    "badge": "Best Reverse Osmosis",
    "amazonUrl": "#",
    "specs": [
      [
        "Certification",
        "NSF/ANSI 58 (per listing)"
      ],
      [
        "Rated Output",
        "75 gallons per day"
      ],
      [
        "Stages",
        "6, including alkaline remineralization"
      ],
      [
        "Storage",
        "Pressurized tank"
      ],
      [
        "Filter Changes",
        "Pre-filters roughly every 6-12 months"
      ]
    ],
    "pros": [
      "Reverse osmosis reduces dissolved solids, nitrates and fluoride that carbon cannot",
      "Alkaline stage adds minerals back for taste",
      "Standard-size filters are easy to source",
      "Long-running design with a large owner base"
    ],
    "cons": [
      "Sends water to the drain while it produces",
      "Tank and five-plus housings take most of the cabinet",
      "Slower to install than a carbon filter"
    ],
    "bottomLine": "The classic tank-style RO system for anyone whose water report shows high TDS, nitrates or arsenic.",
    "description": "Reverse osmosis is the only point-of-use technology on this page that meaningfully reduces dissolved salts, nitrates, fluoride and arsenic, and the iSpring RCC7AK is the long-standing value pick in that category. It adds an alkaline remineralization stage to iSpring's five-stage RCC7 design, so the water comes out with a little calcium and magnesium rather than tasting flat. Listings describe it as certified to NSF/ANSI 58, the reverse osmosis standard, and rate it at 75 gallons per day. It stores filtered water in a pressurized tank, which means a fast pour at the faucet once the tank is full and a slow refill after heavy use. The costs are space and water: RO sends a share of the incoming water to the drain, and the tank plus housings fill most of a standard sink base. If your utility report or a lab test shows a problem carbon cannot address, this is the sensible first RO system. If you only want better taste or lead reduction, a carbon filter is simpler. Our <a href=\"/best-water-filtration-system-for-home/\">home water filtration guide</a> covers RO in more depth."
  },
  {
    "id": "waterdrop-g3p800",
    "name": "Waterdrop G3P800 Tankless Reverse Osmosis System",
    "category": "800 GPD tankless RO with UV light, 3:1 pure-to-drain",
    "badge": "Best Tankless RO",
    "amazonUrl": "#",
    "specs": [
      [
        "Certifications",
        "NSF/ANSI 58, 42, 53 and 372 via IAPMO, per Waterdrop"
      ],
      [
        "Rated Output",
        "800 gallons per day"
      ],
      [
        "Pure-to-Drain Ratio",
        "3:1"
      ],
      [
        "Filter Life",
        "6 / 12 / 24 months (pre, carbon, membrane), per Waterdrop"
      ],
      [
        "Extras",
        "UV light, smart faucet display"
      ]
    ],
    "pros": [
      "No tank, so it frees most of the cabinet",
      "800 GPD output means little waiting at the faucet",
      "3:1 ratio wastes far less water than older RO designs",
      "Twist-off cartridges, no wrenches needed"
    ],
    "cons": [
      "Needs a power outlet under the sink",
      "Costs more up front than tank-style RO",
      "Electronics add a failure point the iSpring does not have"
    ],
    "bottomLine": "The RO system to buy if cabinet space and wastewater bother you more than the higher price.",
    "description": "The Waterdrop G3P800 is what reverse osmosis looks like when the tank goes away. A booster pump pushes water through the membrane on demand, and Waterdrop rates the system at 800 gallons per day with a 3:1 pure-to-drain ratio, which is a large improvement on the wastewater of older tank systems. Waterdrop's listing says IAPMO certified it to NSF/ANSI 58 for TDS reduction, plus 42, 53 and 372. A UV light and a faucet that shows filter life and TDS are included. The filters twist off: Waterdrop lists a pre-filter every six months, a carbon block every 12 months and the RO membrane every 24 months. Real-world flow is lower than the daily rating suggests; independent reviews report a little over half a gallon per minute, which is still quick for an RO faucet. The catch is that it needs an outlet under the sink and costs more than the iSpring. It also appears in our <a href=\"/best-water-filtration-system-for-home/\">whole-home filtration roundup</a> as the best tankless option."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Under Sink Water Filter",
          item: "https://www.allmetalbrake.com/best-under-sink-water-filter/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best under sink water filter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homes, the Aquasana Claryum 3-Stage. It is certified by the WQA to NSF/ANSI 42, 53 and 401, which covers chlorine taste, lead, PFOA/PFOS and many other contaminants, and it needs no tank, drain or power. If your water report shows high dissolved solids or nitrates, choose a reverse osmosis system instead."
          }
        },
        {
          "@type": "Question",
          "name": "Are under sink water filters worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if you drink and cook with tap water. An under sink filter treats far more water than a pitcher at a lower cost per gallon, keeps filtered water on tap without refilling, and the certified models reduce health contaminants such as lead. They are not worth it if your water is already clean and you dislike the taste only slightly."
          }
        },
        {
          "@type": "Question",
          "name": "Does an under sink water filter remove lead?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if it is certified to NSF/ANSI 53 for lead. The Claryum 3-Stage and A.O. Smith AO-US-200 both carry that certification. Many cheaper filters advertise lead reduction while holding only NSF/ANSI 42 for taste and 372 for lead-free materials, which do not cover lead removal. Check the performance data sheet."
          }
        },
        {
          "@type": "Question",
          "name": "How often should I change an under sink water filter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At the rated capacity or time limit, whichever comes first. That is six months for the Claryum and AO-US-200, up to 12 months for the Waterdrop 10UA, and staggered intervals of six to 24 months for RO stages. Heavy sediment or very high chlorine can shorten that, so change sooner if the flow drops."
          }
        },
        {
          "@type": "Question",
          "name": "Is reverse osmosis better than a carbon under sink filter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It removes more, but it is not automatically better. RO reduces dissolved solids, nitrates, arsenic and fluoride that carbon cannot, but it wastes water, takes more space and strips minerals. On treated city water with a clean report, a certified carbon filter usually does everything needed at a lower running cost."
          }
        },
        {
          "@type": "Question",
          "name": "Can I install an under sink water filter myself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Carbon filters typically take about an hour with an adjustable wrench and a drill for the bracket. You fit a tee to the cold supply, mount the filter and run push-fit tubing. A dedicated faucet needs a spare hole in the sink or counter. RO adds a drain saddle connection and, for tankless units, an outlet."
          }
        },
        {
          "@type": "Question",
          "name": "Does an under sink filter reduce water pressure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At the filtered faucet, yes. Most certified carbon filters are rated around 0.5 gpm, and direct-connect units such as the Waterdrop 10UA at 0.75 gpm, which is slower than an unfiltered tap. High-flow designs like the Frizzlife SK99-NEW are rated up to 2.0 gpm. The rest of the house is not affected because only one line is filtered."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Water, Plumbing & Electrical",
    tags: [
      "best under sink water filter",
      "under sink water filter",
      "under counter water filter",
      "under sink water filter system",
      "direct connect under sink water filter",
      "nsf 53 under sink filter"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          Best Under Sink Water Filter
        </h1>
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          Six under sink water filters ranked by the thing that matters most: what each one is independently certified to remove, not what the box says it removes.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/shaheer-ali-khan/" class="font-bold text-gray-900 no-underline hover:underline">Shaheer Ali Khan</a></p>
            <p class="text-xs text-gray-500 m-0">Consumer Product Testing &amp; Materials Performance Specialist &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">11 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#short-answer" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>The Short Answer</span></a>
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>The 6 Best Under Sink Water Filters</span></a>
              <a href="#certifications" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>What NSF/ANSI 42, 53, 401 and 58 Mean</span></a>
              <a href="#comparison" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Side-by-Side Comparison</span></a>
              <a href="#carbon-vs-ro" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>Carbon Filter or Reverse Osmosis?</span></a>
              <a href="#buying-guide" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Buying Guide: Specs That Matter</span></a>
              <a href="#installation" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Installation Under the Sink</span></a>
