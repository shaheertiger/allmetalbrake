];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "7 Best Laminate Flooring Picks in 2026: Scratch and Spill Ready";
const description =
  "Seven laminate lines compared on abrasion rating, core, edge sealing and spill warranty, plus underlayment, install and when laminate beats vinyl plank.";

