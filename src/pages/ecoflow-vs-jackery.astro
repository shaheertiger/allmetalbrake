---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import TopPick from "../components/TopPick.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Solar Generators",
    "url": "/best-solar-generator/"
  },
  {
    "title": "Best Power Stations for Home Backup",
    "url": "/best-portable-power-station-for-home-backup/"
  },
  {
    "title": "Best Portable Chargers for Power Outages",
    "url": "/best-portable-chargers-for-power-outages/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "EcoFlow vs Jackery: Which Power Station Brand Should You Buy?";
const description =
  "EcoFlow vs Jackery compared size class by size class: output, weight, expansion, charging, apps and warranty, with a clear pick for camping and home backup.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "EcoFlow vs Jackery",
          item: "https://www.allmetalbrake.com/ecoflow-vs-jackery/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is EcoFlow or Jackery better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Neither is better across the board. EcoFlow generally offers more output at each size class, add-on batteries, smart home panels and a deeper app, which makes it stronger for home backup and growing needs. Jackery generally offers lighter units for the capacity, simpler controls and the best single-box 2 kWh option, which suits camping and RV use. Both use LFP batteries on current models and offer roughly five years of warranty coverage."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a Jackery solar generator and a Jackery power station?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only the bundle. A Jackery solar generator is an Explorer power station sold together with one or more SolarSaga folding panels and the cables to connect them; the station inside is identical to the one sold alone. An EcoFlow solar generator works the same way. Bundles can be good value when discounted, but you can also buy the station alone and add panels later, including third-party panels within its input limits."
          }
        },
        {
          "@type": "Question",
          "name": "Which is better for camping, EcoFlow or Jackery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most campers Jackery has the edge at 1 kWh and above because its units are lighter: the Explorer 1000 v2 stores 1,070 Wh at about 24 pounds against about 28 pounds for the Delta 3 Plus, and the Explorer 2000 v2 puts 2 kWh in one 40-pound box. At the small end, EcoFlow's River 3 Plus wins with a 600 W inverter and a snap-on extra battery."
          }
        },
        {
          "@type": "Question",
          "name": "Which is better for home backup during power outages?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "EcoFlow is the stronger home-backup platform. The Delta 3 Plus offers 1,800 W, enough for a microwave alongside a fridge, and accepts add-on batteries. The Delta Pro 3 combines 4,096 Wh, 4,000 W and native 120/240 V with a smart home panel and high solar input. Jackery's large Explorer Plus systems also expand, but the ecosystem is narrower. Hardwired circuits need an electrician-installed transfer switch or interlock."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use Jackery solar panels with an EcoFlow power station?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually yes, with the right adapter. A panel simply supplies DC power, so what matters is that its voltage and current, alone or wired with others, fall within the station's published solar input range and that the connectors match. Series wiring raises voltage, and cold sunny mornings raise it further, so leave a margin. Add-on batteries and smart panels, by contrast, are brand-specific and never cross over."
          }
        },
        {
          "@type": "Question",
          "name": "How long will an EcoFlow or Jackery power station run a refrigerator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use runtime equals watt-hours times 0.85, divided by the average load. A modern fridge uses about 1 to 2 kWh a day, roughly 40 to 85 watts on average. On that basis a Delta 3 Plus or Explorer 1000 v2 runs a typical fridge for about 10 to 20 hours, a 2 kWh unit for roughly a day, and the Delta Pro 3 for about two days."
          }
        },
        {
          "@type": "Question",
          "name": "Are EcoFlow and Jackery power stations expandable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most EcoFlow stations are. The River 3 Plus takes a snap-on extra battery, the Delta 3 Plus pairs with extra batteries to reach about 2 kWh and beyond, and the Delta Pro 3 scales into the tens of kilowatt-hours. Jackery's popular Explorer v2 models are fixed-capacity, so the upgrade path is a larger or second unit, although its large Explorer Plus home-backup models do support expansion batteries."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "ecoflow vs jackery",
      "ecoflow or jackery",
      "jackery vs ecoflow",
      "delta 3 plus vs explorer 1000 v2",
      "portable power station brands"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Power Station Picks",
    link: "/best-portable-power-station/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Brand Comparison</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          EcoFlow vs Jackery: Platform or Appliance?
        </h1>
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          The two biggest names in portable power compared size class by size class, from 300 Wh camping boxes to 240 V home systems, with a straight verdict for camping, outages and whole-home backup.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">11 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#quick-verdict" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>The Short Answer</span></a>
              <a href="#brands" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>Brands and Models</span></a>
              <a href="#small-class" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Small Class (~300 Wh)</span></a>
              <a href="#one-kwh" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>1 kWh Class</span></a>
              <a href="#two-kwh" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>2 kWh Class</span></a>
              <a href="#whole-home" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Whole-Home Class</span></a>
              <a href="#ecosystems" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Ecosystems and Charging</span></a>
              <a href="#weight" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>Weight, Apps, Warranty</span></a>
              <a href="#verdict" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>Alternatives and Verdict</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          EcoFlow sells a platform you can grow; Jackery sells an appliance you can carry. At every size class that one difference decides more than any spec sheet, and once you know which you need, the choice takes about a minute.
        </p>

        <TopPick />

        <div id="quick-verdict" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Short Answer: Platform vs. Appliance
          </h2>

          <p>
            If you have searched for a "Jackery solar generator" or an "EcoFlow power station," you have probably noticed that the two brands chase each other model for model. Each sells a small camping box around 300 Wh, a 1 kWh all-rounder, a 2 kWh step-up and a big wheeled unit aimed at home backup. Each uses lithium iron phosphate (LFP) cells on its current models, charges from the wall in about an hour at the 1 kWh size, and bundles its own folding solar panels. On the surface, it looks like a coin toss.
          </p>

          <p>
            It is not quite one. The two companies have made different bets, and those bets show up in the details that decide what living with the box is like. EcoFlow builds platforms: most of its stations accept add-on batteries, talk to a smart home panel, and expose a lot of settings through an app. Jackery builds appliances: its popular Explorer v2 models are lighter for their capacity, simpler to run, and fixed in size. Neither approach is better in the abstract. Which one suits you depends on whether you expect your needs to grow, how far you plan to carry the thing, and how much you want to fiddle with it.
          </p>

          <p>
            This comparison works through the lineups one size class at a time, then looks at the things spec sheets bury: ecosystems, charging behavior, weight per watt-hour, apps and warranty. Everything here is drawn from the manufacturers' published specifications rather than hands-on testing, and model details change often, so confirm the figures on the listing you buy from. If you are still deciding how big a battery you need at all, start with our <a href="/best-portable-power-station/">portable power station buying guide</a> and come back here once you know your size class.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE SHORT ANSWER</p>
            <p class="text-xl font-bold text-white mb-3">EcoFlow if you want room to grow. Jackery if you want the lightest, simplest box.</p>
            <p class="text-gray-300 leading-relaxed m-0">EcoFlow wins on add-on batteries, 240 V home backup, a smart panel and the most output per size class. Jackery wins on weight and simplicity at a given capacity. At 1 kWh, the Delta 3 Plus wins on output and expandability; the Explorer 1000 v2 wins on weight. For home backup, the Delta Pro 3 is the more complete system.</p>
          </div>

          <p>
            The table below shows how the head-to-head shakes out across the categories most buyers care about. A "win" means the brand's current lineup is stronger on that point for most people, not that the other brand is weak. Notice that the wins split fairly evenly; the useful question is which of these rows actually matters for the way you will use the station, and the rest of this guide is organized to help you answer exactly that.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Category</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">EcoFlow</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Jackery</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Edge</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Output at 1 kWh</td>
                    <td class="px-4 py-4 text-gray-700">1,800 W (Delta 3 Plus)</td>
                    <td class="px-4 py-4 text-gray-700">1,500 W, 3,000 W surge (Explorer 1000 v2)</td>
                    <td class="px-4 py-4 text-gray-700">EcoFlow</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Weight at 1 kWh</td>
                    <td class="px-4 py-4 text-gray-700">~28 lb</td>
                    <td class="px-4 py-4 text-gray-700">~24 lb</td>
                    <td class="px-4 py-4 text-gray-700">Jackery</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Expandability</td>
                    <td class="px-4 py-4 text-gray-700">Most models accept add-on batteries</td>
                    <td class="px-4 py-4 text-gray-700">Popular v2 models are fixed size</td>
                    <td class="px-4 py-4 text-gray-700">EcoFlow</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">2 kWh in one box</td>
                    <td class="px-4 py-4 text-gray-700">Reached by adding a battery</td>
                    <td class="px-4 py-4 text-gray-700">Explorer 2000 v2, ~40 lb</td>
                    <td class="px-4 py-4 text-gray-700">Jackery</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Whole-home backup</td>
                    <td class="px-4 py-4 text-gray-700">Delta Pro 3, 4,096 Wh, 120/240 V</td>
                    <td class="px-4 py-4 text-gray-700">Larger Explorer Plus systems</td>
                    <td class="px-4 py-4 text-gray-700">EcoFlow</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Ease of use</td>
                    <td class="px-4 py-4 text-gray-700">Many settings, app-centric</td>
                    <td class="px-4 py-4 text-gray-700">Fewer settings, simpler</td>
                    <td class="px-4 py-4 text-gray-700">Jackery</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Battery chemistry</td>
                    <td class="px-4 py-4 text-gray-700">LFP</td>
                    <td class="px-4 py-4 text-gray-700">LFP</td>
                    <td class="px-4 py-4 text-gray-700">Tie</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Warranty (current models)</td>
                    <td class="px-4 py-4 text-gray-700">Roughly five years</td>
                    <td class="px-4 py-4 text-gray-700">Roughly five years</td>
                    <td class="px-4 py-4 text-gray-700">Tie</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Throughout this guide, runtime estimates use one simple rule: runtime in hours is roughly the capacity in watt-hours times 0.85, divided by the average load in watts. The 0.85 factor accounts for inverter losses and the small reserve every station holds back. It is not exact for every model, but it is close enough to compare the two brands fairly, and it is the same arithmetic you should run on your own load list before you buy anything.
          </p>
        </div>

        <div id="brands" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Two Brands and the Four Models Worth Comparing
          </h2>

          <p>
            Jackery popularized the portable power station in the U.S. and still owns the phrase "Jackery solar generator" in a lot of people's heads. Its Explorer line has always prioritized portability and simplicity: a handle on top, a clear display, a sensible set of outlets, and few decisions to make. The current v2 generation moved the popular sizes to LFP cells, added much faster wall charging and introduced app control, but the products are still built around the idea that a power station should be a self-contained appliance you buy at the size you need.
          </p>

          <p>
            EcoFlow came to market later and made charging speed its calling card, then built outward into a full energy ecosystem. Its River line covers small portable units, the Delta line covers the 1 kWh to 4 kWh range, and the Delta Pro models are designed to sit at the center of a home backup system with extra batteries, smart panels, alternator chargers and rigid solar panels. The products are typically a little heavier and more feature-dense, with more configuration options exposed through the EcoFlow app.
          </p>

          <p>
            Both brands sell the same models under different bundle names. An "EcoFlow solar generator" or "Jackery solar generator" is simply one of these stations sold with the brand's folding panels and cables; there is no separate machine inside. Our <a href="/best-solar-generator/">solar generator guide</a> covers when a bundle is good value and when buying the panels separately works out cheaper.
          </p>

          <p>
            Out of each lineup, two models matter most for this comparison: the 1 kWh all-rounder that most people should look at first, and the bigger unit each brand would point you to for longer outages. The four are summarized below from the manufacturers' published specifications, and each gets a fuller treatment in the size-class sections that follow.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Model</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Role</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Capacity</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">AC output</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Weight</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">EcoFlow Delta 3 Plus</td>
                    <td class="px-4 py-4 text-gray-700">Best EcoFlow overall</td>
                    <td class="px-4 py-4 text-gray-700">1,024 Wh LFP, expandable</td>
                    <td class="px-4 py-4 text-gray-700">1,800 W</td>
                    <td class="px-4 py-4 text-gray-700">~28 lb</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Jackery Explorer 1000 v2</td>
                    <td class="px-4 py-4 text-gray-700">Best Jackery overall</td>
                    <td class="px-4 py-4 text-gray-700">1,070 Wh LFP</td>
                    <td class="px-4 py-4 text-gray-700">1,500 W (3,000 W surge)</td>
                    <td class="px-4 py-4 text-gray-700">~24 lb</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">EcoFlow Delta Pro 3</td>
                    <td class="px-4 py-4 text-gray-700">Best EcoFlow for home backup</td>
                    <td class="px-4 py-4 text-gray-700">4,096 Wh LFP, expandable</td>
                    <td class="px-4 py-4 text-gray-700">4,000 W, 120/240 V</td>
                    <td class="px-4 py-4 text-gray-700">~114 lb</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Jackery Explorer 2000 v2</td>
                    <td class="px-4 py-4 text-gray-700">Best Jackery for longer outages</td>
                    <td class="px-4 py-4 text-gray-700">2,042 Wh LFP</td>
                    <td class="px-4 py-4 text-gray-700">2,200 W</td>
                    <td class="px-4 py-4 text-gray-700">~40 lb</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The pattern is visible even in four rows. The EcoFlow models carry the word "expandable" and the higher output figures; the Jackery models carry the lower weights. That trade repeats at every size, so if you already know which side of it you care about, you can probably skip to the verdict table at the end. If you do not, the size-class sections below show where the trade bites and where it does not.
          </p>
        </div>

        <div id="small-class" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Small Class: About 300 Wh
