const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Deck Stain Drying Time",
          item: "https://www.allmetalbrake.com/deck-stain-drying-time/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How long should I keep off the deck after staining?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most water-based stains, wait at least 4 to 24 hours before light foot traffic. For oil-based stains, wait 24 to 48 hours. Wear socks or clean soft-soled shoes at first, keep pets off a little longer and wait two or three days before moving furniture back. Always follow the times printed on your product label."
          }
        },
        {
          "@type": "Question",
          "name": "How many dry hours does stain need before rain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most water-based stains need around 4 to 12 hours without rain, and many oil-based stains need 24 to 48 hours. Cool or humid conditions extend that. Plan for at least a full day of dry weather after staining, check the hourly forecast including overnight, and turn off sprinklers that reach the deck."
          }
        },
        {
          "@type": "Question",
          "name": "When can I put furniture back on a stained deck?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wait about 24 to 48 hours for water-based stains and 48 to 72 hours for oil-based stains before replacing furniture. Use felt pads or soft feet, lift rather than drag, and wait about a week before putting down rugs, mats or heavy planters, which can trap moisture against stain that is still curing."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my stained deck still feel sticky?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Excess stain is the usual cause. Heavy coats, a second coat on saturated wood, damp boards, dense hardwood or cool, humid weather all leave stain sitting on the surface. Give it a few warm, dry days first. If it is still tacky, wipe oil-based stain with mineral spirits; ask the manufacturer about water-based stain."
          }
        },
        {
          "@type": "Question",
          "name": "Does humidity really slow deck stain drying?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Water-based stain dries by evaporation, which slows sharply in humid air. Oil-based stain cures by reacting with oxygen and is also slower in damp, still conditions. On very humid days, expect drying times to stretch well beyond the label, and avoid staining late in the day when dew is likely."
          }
        },
        {
          "@type": "Question",
          "name": "Can I stain my deck in direct sun to make it dry faster?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is not recommended. Hot boards make stain flash-dry on the surface before it can soak in, which causes lap marks, uneven color and a weaker finish. Stain in the morning or late afternoon with the boards in shade, and let warm air rather than direct sun do the drying."
          }
        },
        {
          "@type": "Question",
          "name": "How long does deck stain take to fully cure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Full cure usually takes about three to seven days for water-based stains and one to two weeks for oil-based stains, sometimes longer in cool weather. Solid acrylic stains can take a few weeks to reach full hardness. Treat the deck gently until then: no rugs, no heavy planters and no dragging furniture."
          }
        }
      ],
    },
