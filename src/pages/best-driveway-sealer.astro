---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Asphalt Driveway Sealers, Ranked",
    "url": "/best-asphalt-driveway-sealer-reviews/"
  },
  {
    "title": "Blacktop Driveway Sealer for Aging Asphalt",
    "url": "/blacktop-driveway-sealer/"
  },
  {
    "title": "Best Asphalt Sealer by Chemistry",
    "url": "/best-asphalt-sealer/"
  },
  {
    "title": "How to Seal a Driveway",
    "url": "/how-to-seal-a-driveway/"
  },
  {
    "title": "Best Concrete Sealer",
    "url": "/best-concrete-sealer/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "Best Driveway Sealer for Asphalt or Concrete: Pick by Surface";
const description =
  "Asphalt and concrete driveways need completely different sealers. Six picks sorted by surface, with how to tell which one you have and what each costs.";

const PRODUCTS = [
  {
    "id": "foundation-armor-sx5000",
    "name": "Foundation Armor SX5000 WB Penetrating Sealer",
    "category": "Concrete: Water-Based Silane-Siloxane",
    "badge": "Best for Concrete Driveways",
    "amazonUrl": "",
    "pros": [
      "Penetrates into concrete and leaves no visible film or shine",
      "Water-based, low odor, easy for a first-time DIYer",
      "Reduces water and salt absorption, the main driver of winter scaling",
      "No slippery surface, because nothing sits on top",
      "Applies with a pump sprayer in a single wet pass"
    ],
    "cons": [
      "Does not change color or add gloss, so the driveway looks the same",
      "Will not hide stains or worn finishes"
    ],
    "bottomLine": "The default pick for a plain gray concrete driveway in any climate with winter salt.",
    "description": "Foundation Armor SX5000 WB is a water-based silane-siloxane water repellent, which is the category most concrete contractors recommend for exterior driveways. Instead of forming a coating on top, the small silane molecules soak into the pores and react to make them water-repellent, while the siloxane portion helps at the surface. The result is concrete that looks unchanged but sheds water and slows the absorption of dissolved deicing salt, which is what drives the surface flaking called scaling. Because there is no film, there is nothing to peel, nothing to wear off under tires, and no slippery surface on a rainy day. Coverage depends heavily on how porous the slab is, and the label recommends testing absorption on a small patch first. Owners commonly report that water beads on the surface for several years after application and that the sprayer application is easy. If you want gloss or a darker color, this is the wrong product. If you want the slab to survive winters, it is the right one."
  },
  {
    "id": "ghostshield-siloxa-tek-8500",
    "name": "Ghostshield Siloxa-Tek 8500",
    "category": "Concrete: Penetrating Water Repellent",
    "badge": "Best for Harsh Winters",
    "amazonUrl": "",
    "pros": [
      "Penetrating silane-siloxane formula aimed at freeze-thaw and salt exposure",
      "Invisible finish with no film to peel or wear",
      "Also suitable for brick, pavers and other masonry",
      "Water-based and low odor"
    ],
    "cons": [
      "Priced above most penetrating sealers",
      "Like any penetrating product, adds no color or gloss"
    ],
    "bottomLine": "Worth the premium if your driveway sees heavy road salt and hard freezes every winter.",
    "description": "Ghostshield positions Siloxa-Tek 8500 as a heavier-duty penetrating sealer for concrete exposed to severe winters, and it shows up frequently in owner discussions about protecting driveways, garage aprons and sidewalks from salt damage. It is a water-based silane-siloxane blend that sinks into the slab and leaves the surface looking unchanged, so the comparison with SX5000 is about formulation strength and price rather than appearance. The practical difference for most homeowners is that Ghostshield markets this product specifically for freeze-thaw and deicer exposure and backs that positioning with detailed application guidance on its data sheet. Owners commonly report good water beading and appreciate that the same product works on adjacent brick or paver walkways. It costs more per gallon than many alternatives. In a mild climate with little salt, that premium is hard to justify. In the northern states, where scaling and spalling destroy driveway surfaces within a decade, it is a reasonable investment."
  },
  {
    "id": "foundation-armor-ar350",
    "name": "Foundation Armor AR350 Wet Look Sealer",
    "category": "Concrete: Solvent-Based Acrylic",
    "badge": "Best Wet-Look Finish",
    "amazonUrl": "",
    "pros": [
      "Darkens and enriches color with a wet-look sheen",
      "Popular for exposed aggregate, stamped and colored concrete",
      "Solvent-based formula penetrates and bonds better than many water-based acrylics",
      "Can be recoated easily when the gloss fades"
    ],
    "cons": [
      "Slippery when wet unless you mix in an anti-slip additive",
      "Solvent fumes, and solvent acrylics face VOC limits in some states",
      "Needs recoating more often than penetrating sealers"
    ],
    "bottomLine": "The pick when you want the driveway to look richer, not just last longer.",
    "description": "AR350 is a solvent-based acrylic sealer that forms a thin film on the surface and gives concrete a wet, darker, slightly glossy look. That makes it a favorite for decorative concrete such as exposed aggregate, stamped patterns and stained slabs, where the whole point is to make color and texture stand out. Acrylic films also block stains reasonably well while they are intact. The tradeoffs are maintenance and traction. Acrylics wear under tires, especially at turning points, and most owners need to recoat every two to three years to keep the look even. A glossy driveway is also slippery in rain and snow, and adding a grit additive to the final coat is strongly recommended for any sloped surface. Owners commonly report that a thin coat looks better and lasts longer than a thick one, which can turn milky if moisture is trapped. Check your state's VOC rules before ordering, because solvent-based acrylics are restricted in some areas."
  },
  {
    "id": "latex-ite-airport-grade",
    "name": "Latex-ite Airport Grade Driveway Filler-Sealer",
    "category": "Asphalt: Polymer-Modified Emulsion",
    "badge": "Best for Asphalt Driveways",
    "amazonUrl": "",
    "pros": [
      "Filled, polymer-modified emulsion that covers moderate wear",
      "Water cleanup and low odor",
      "Stocked widely, which makes batch-matching easy",
      "Even black finish that hides patches"
    ],
    "cons": [
      "Heavy filler needs thorough mixing",
      "Thirsty on very porous surfaces"
    ],
    "bottomLine": "The best all-round choice for a typical asphalt driveway.",
    "description": "For asphalt, our overall recommendation is the same here as in our main ranked list. Latex-ite Airport Grade is a water-based asphalt emulsion with polymer and mineral filler, so it has enough body to close up the open texture of a driveway that has started to fade, while remaining easy to squeegee for someone doing it for the first time. The label asks for the familiar 50-degree-and-rising window and dry weather, and it cleans up with water before it cures. Owners commonly report good color retention through the first year and decent resistance to tire scuffing after a full cure. It is not a product for concrete under any circumstances. It is also not a fix for asphalt with structural cracking or sunken areas, which need repair first. On a sound asphalt driveway, though, it is the pail most likely to give a good result without fuss. For the full asphalt-only comparison, including premium and budget alternatives, see our ranked asphalt list linked below."
  },
  {
    "id": "blackjack-drive-maxx-1000",
    "name": "Black Jack Drive-Maxx 1000",
    "category": "Asphalt: Premium Emulsion",
    "badge": "Best Asphalt Finish",
    "amazonUrl": "",
    "pros": [
      "Flagship of a major home-center brand with a very dark, uniform finish",
      "Filler and polymer for a tougher film",
      "Water-based and straightforward to apply",
      "Easy to find in most regions"
    ],
    "cons": [
      "Top-of-range price",
      "The finish advantage shrinks on rough, oxidized asphalt"
    ],
    "bottomLine": "Choose it when the asphalt is smooth and the look from the street matters most.",
    "description": "Drive-Maxx 1000 is the top tier of Black Jack's driveway line and the pail many owners reach for when appearance is the priority. It is a water-based asphalt emulsion with filler and polymer, and it dries to one of the deepest, most uniform blacks among retail sealers. On a smooth driveway in good condition, that finish is the main reason to pay the premium. On a rough, gray surface, the advantage narrows, because any filled sealer will soak in and need a second coat to look even, and a mid-priced filled product does that job for less. Owners commonly praise how easily it spreads and how it looks for the first season, and the most frequent complaint is price. As with every asphalt product, the years on the label describe the product tier rather than a guaranteed interval between coats. Use it on asphalt only, follow the temperature and cure guidance, and it will deliver the best-looking result you can get from a pail."
  },
  {
    "id": "henry-blacktop-sealer",
    "name": "Henry Asphalt Driveway Filler & Sealer",
    "category": "Asphalt: Budget Filled Emulsion",
    "badge": "Best Budget Asphalt",
    "amazonUrl": "",
    "pros": [
      "Low cost per pail for large driveways",
      "Filler handles hairline cracks",
      "Water-based and easy to clean up",
      "Good maintenance coat for recently sealed surfaces"
    ],
    "cons": [
      "Thinner film, shorter interval before recoating",
      "Often needs two coats to look even on porous asphalt"
    ],
    "bottomLine": "A sensible budget choice for asphalt in decent shape.",
    "description": "Henry's driveway filler and sealer is the budget asphalt option we would actually recommend. It is a water-based emulsion with modest filler content, and it spreads quickly with a squeegee. On a driveway that was sealed within the last few years and still has a tight surface, one or two coats restore the color and water resistance at a low cost per square foot, which matters on long driveways where premium pails add up quickly. On badly oxidized asphalt it is less convincing: the surface absorbs much of the first coat, and getting an even black usually takes a second. Price the full job before assuming the budget pail is cheaper overall. Owners commonly describe it as a good value maintenance product that fades sooner than flagship tiers, which fits its price. It is strictly for asphalt. Anyone with a concrete driveway should be looking at the penetrating sealers at the top of this list instead."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Driveway Sealer",
          item: "https://www.allmetalbrake.com/best-driveway-sealer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Can one sealer be used on both asphalt and concrete driveways?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Asphalt sealers are black emulsions that coat the surface, and concrete sealers are clear products that either penetrate the pores or form a clear film. Neither works on the other material. Asphalt sealer peels off concrete and stains it, and concrete penetrating sealers have nothing to react with in asphalt. Buy the product made for your surface."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best sealer for a plain concrete driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A water-based or solvent-based silane-siloxane penetrating sealer, such as Foundation Armor SX5000 or Ghostshield Siloxa-Tek 8500. These soak in, leave no visible film, are not slippery, and reduce water and salt absorption, which is the main cause of winter surface damage. Choose an acrylic only if you want a darker, glossier look and accept more frequent recoating."
          }
        },
        {
          "@type": "Question",
          "name": "Is a wet-look sealer bad for a driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not bad, but it comes with tradeoffs. Wet-look acrylics make concrete slippery when wet, wear under tires and usually need recoating every two to three years. They are the right choice for stamped, colored or exposed-aggregate driveways where appearance is the point. On sloped driveways, mix an anti-slip additive into the final coat to keep traction in rain and snow."
          }
        },
        {
          "@type": "Question",
          "name": "Should I seal a brand new driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, but not immediately. New concrete typically needs about 28 days to cure before most sealers. New asphalt needs considerably longer, usually six months to a year, so its oils can cure out and the surface can harden. Sealing either one too early leads to poor bonding. Ask your installer for their specific guidance."
          }
        },
        {
          "@type": "Question",
          "name": "How do I know when my driveway needs sealing again?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use the water test on a dry day. If water beads or runs off, the existing protection is still working. If it darkens the surface and soaks in within a minute or two, it is time to reseal. On asphalt, graying and exposed stones are also clear signs. On acrylic-sealed concrete, dull, uneven gloss in tire paths means a recoat is due."
          }
        },
        {
          "@type": "Question",
          "name": "Does sealing a concrete driveway prevent cracks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not structural cracks. Those come from settlement, tree roots, heavy loads or poor base preparation. What sealing does prevent is surface scaling and spalling from water and salt, along with staining. It also slows the widening of small cracks by keeping water out. For cracks already present, fill them with a concrete crack filler before sealing."
          }
        },
        {
          "@type": "Question",
          "name": "Are coal tar driveway sealers still legal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on where you live. Washington and Minnesota restrict coal tar sealers statewide, and many cities and counties elsewhere ban their sale or use. Even where they remain legal, they carry stronger odor, skin and eye irritation risk during application, and environmental concerns tied to runoff. For a home driveway, an asphalt emulsion is the practical choice."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Driveway & Asphalt",
    tags: [
      "best driveway sealer",
      "concrete driveway sealer",
      "asphalt vs concrete sealer",
      "penetrating sealer",
      "wet look sealer",
      "driveway sealer by surface"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Driveway Sealer</span> for Your Surface
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Asphalt and concrete fail in different ways and need different chemistry. Here is how to match the sealer to the slab, and the six products worth buying.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#foundation-armor-sx5000"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.3k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top 6 by Surface</a>
          <a href="#identify-surface" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Identify Your Surface</a>
          <a href="#why-different" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Why They Differ</a>
          <a href="#concrete-types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Concrete Sealer Types</a>
          <a href="#asphalt-types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Asphalt Sealer Options</a>
          <a href="#climate" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Climate & Deicers</a>
          <a href="#special-surfaces" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Pavers & Decorative</a>
          <a href="#application" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Application by Surface</a>
          <a href="#schedule" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Reseal Schedule</a>
          <a href="#cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Cost by Surface</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The single most common driveway sealing mistake is buying the wrong category of product. Asphalt sealer on concrete looks like a tar spill and peels. A concrete penetrating sealer on asphalt does nothing at all. Before you compare brands, figure out what your driveway is made of and what is actually damaging it, because that decides the product family. The brand comes second.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 6 Best Driveway Sealers, by Surface
          </h2>

          <p>
            The list is split by surface: three for concrete and three for asphalt. Picks are based on the formula each manufacturer publishes, label coverage and cure requirements, retail availability, and recurring themes in owner feedback. We did not run test panels of our own, so there are no made-up durability scores here, only what the labels and data sheets state and how owners report the products behaving.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-gray-500 text-sm font-bold">{product.rating}</span>
                    <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} ratings on Amazon)</span>
                  </div>
                  )}

                  <p class="text-gray-700 leading-relaxed mb-6">{product.description}</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 rounded-xl p-4">
                      <p class="text-xs font-black uppercase tracking-widest text-green-700 mb-3">Pros</p>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="flex items-start gap-2 text-sm text-green-800">
                            <svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            {pro}
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-red-50 rounded-xl p-4">
                      <p class="text-xs font-black uppercase tracking-widest text-red-700 mb-3">Cons</p>
                      <ul class="space-y-2">
