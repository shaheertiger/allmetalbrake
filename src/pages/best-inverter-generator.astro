---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Home Generators for Power Outages",
    "url": "/best-home-generator-for-power-outages/"
  },
  {
    "title": "Best Dual Fuel Generators",
    "url": "/best-dual-fuel-generator/"
  },
  {
    "title": "Best Small Generators for Home",
    "url": "/best-small-generator-for-home/"
  },
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-10", modified: "2026-11-10" });
const title = "7 Best Inverter Generators in 2026: Quiet, Clean Power Ranked";
const description =
  "Seven inverter generators ranked on maker specs: running watts, real dBA ratings, run time, weight, parallel kits and CO shutoff, from Honda and Yamaha to WEN.";

const PRODUCTS = [
  {
    "id": "honda-eu2200i",
    "name": "Honda EU2200i Super Quiet Inverter Generator",
    "category": "1,800W running / 2,200W starting, 47 lb, CO-MINDER",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "specs": [
      [
        "Running / Starting Watts",
        "1,800 / 2,200"
      ],
      [
        "Noise",
        "48 dBA (1/4 load) to 57 dBA (rated load)"
      ],
      [
        "Run Time",
        "3.2 hr rated load / 8.1 hr 1/4 load (0.95 gal)"
      ],
      [
        "Dry Weight",
        "47.4 lb"
      ],
      [
        "Parallel",
        "Yes, with a second unit and parallel cables"
      ],
      [
        "CO Safety",
        "CO-MINDER automatic shutoff"
      ]
    ],
    "pros": [
      "Honda GXR120 engine with a long reliability record",
      "Quietest rating here at quarter load, 48 dBA",
      "About 47 lb, a true one-person carry",
      "CO-MINDER shuts the engine down if carbon monoxide builds",
      "Parallels with a second unit for more output"
    ],
    "cons": [
      "1,800 running watts covers essentials only",
      "0.95-gallon tank needs frequent refills at higher loads",
      "Costs more than rivals with similar ratings"
    ],
    "bottomLine": "The inverter generator to buy if you want it to start every time for years and run quietly next to a neighbor's window.",
    "description": "The EU2200i is the inverter generator every other brand gets compared to, and it earns the top spot for unglamorous reasons: it starts, it keeps starting, and Honda dealers who can service it are everywhere. Honda rates it at 1,800 running and 2,200 starting watts from its GXR120 engine, enough for a refrigerator plus lights, internet, phone charging and a TV, or a gas furnace blower with a few lights. Noise is rated at 48 dBA at quarter load and 57 dBA at rated load, among the quietest figures in the class. Honda lists run time at about 3.2 hours at full rated load and 8.1 hours at quarter load on a 0.95-gallon tank, so plan fuel around that. At 47.4 lb dry, one adult can carry it to the truck or up basement steps. CO-MINDER monitors carbon monoxide and shuts the engine down if it builds up, a backup to proper placement. Two units can be paralleled for more output. The catch is price: you pay a clear premium over Champion and WEN units with similar numbers."
  },
  {
    "id": "westinghouse-igen4500",
    "name": "Westinghouse iGen4500 Remote Start Inverter Generator",
    "category": "3,700W running / 4,500W peak, remote start, 3.4 gal",
    "badge": "Best for Home Backup",
    "amazonUrl": "#",
    "specs": [
      [
        "Running / Peak Watts",
        "3,700 / 4,500"
      ],
      [
        "Noise",
        "As low as 52 dBA"
      ],
      [
        "Run Time",
        "18 hr at 25% / 15 hr at 50% load (3.4 gal)"
      ],
      [
        "Starting",
        "Electric, remote key fob, recoil"
      ],
      [
        "Outlets",
        "120V only"
      ],
      [
        "Display",
        "LED data center: output, fuel, run time remaining"
      ]
    ],
    "pros": [
      "Most running watts among the enclosed inverters here",
      "Up to 18 hours at quarter load on a 3.4-gallon tank",
      "Remote key-fob start",
      "Rated as low as 52 dBA",
      "Can start a window air conditioner alongside essentials"
    ],
    "cons": [
      "Close to 100 lb, so it rolls rather than carries",
      "120V only; no 240V well pump",
      "CO sensing comes on the iGen4500c version, not the base model"
    ],
    "bottomLine": "The inverter to buy when a 2,200-watt unit is too small for your outage load list.",
    "description": "The iGen4500 fills the gap most home-backup buyers fall into: too much load for a suitcase inverter, but no wish to listen to an open-frame engine all night. Westinghouse rates it at 3,700 running and 4,500 peak watts, which covers a refrigerator, a freezer, a gas furnace blower, a sump pump, lights and electronics together if you stagger motor starts. Because it is an inverter, the engine throttles down at light load, which is why Westinghouse lists up to 18 hours at quarter load and 15 hours at half load on its 3.4-gallon tank, the longest run time on this list. Noise is rated as low as 52 dBA. Electric start with a remote key fob is a real comfort in a February storm, and the LED data center shows load, fuel level and remaining run time. The limits are its weight, close to 100 lb on wheels and a telescoping handle, and its 120V-only panel, which rules out a 240V well pump. If you want carbon monoxide shutoff, buy the iGen4500c variant, which adds CO sensing."
  },
  {
    "id": "champion-2500-inverter",
    "name": "Champion 2500-Watt Ultralight Portable Inverter Generator with CO Shield",
    "category": "1,850W running / 2,500W starting, about 39 lb",
    "badge": "Best Value",
    "amazonUrl": "#",
    "specs": [
      [
        "Running / Starting Watts",
        "1,850 / 2,500"
      ],
      [
        "Weight",
        "About 39-40 lb"
      ],
      [
        "Engine",
        "79cc Champion"
      ],
      [
        "Parallel",
        "Yes, with another Champion inverter"
      ],
      [
        "CO Safety",
        "CO Shield automatic shutoff"
      ]
    ],
    "pros": [
      "Lightest generator on this list, under 40 lb",
      "2,500 starting watts beats the Honda for compressor starts",
      "CO Shield carbon monoxide shutoff",
      "Parallel ready",
      "Costs far less than the Honda or Yamaha"
    ],
    "cons": [
      "Small tank limits overnight run time at higher loads",
      "Champion's engine reputation is good but not Honda-level"
    ],
    "bottomLine": "The best value small inverter for buyers who care more about weight and price than the badge.",
    "description": "Champion's ultralight 2500-watt inverter delivers most of what the Honda does for much less money. Champion rates it at 1,850 running and 2,500 starting watts, so its surge headroom is slightly better than the EU2200i for refrigerator and small pump starts. Retail listings put it at roughly 39 to 40 lb, the lightest on this list and the easiest to carry up stairs or into a truck bed, and it runs on a 79cc engine. The CO Shield system shuts the engine off if carbon monoxide accumulates around it, and it is parallel ready with another Champion inverter for more output. What you give up is the long track record of Honda and Yamaha engines and the depth of their dealer networks, though Champion's own support has a good reputation. The small tank also means overnight runs work best at light loads, like a refrigerator and a modem. Owners commonly describe it as easy to start and pleasantly quiet, with the usual small-engine caveat that monthly runs and stabilized fuel keep it that way. For a first inverter on a budget, it is the default answer."
  },
  {
    "id": "generac-gp3500io",
    "name": "Generac GP3500iO Open Frame Inverter Generator",
    "category": "3,000W running / 3,500W starting, open frame, 74.3 lb",
    "badge": "Most Watts per Dollar",
    "amazonUrl": "#",
    "specs": [
      [
        "Running / Starting Watts",
        "3,000 / 3,500"
      ],
      [
        "Run Time",
        "8 hr at 50% / 11 hr at 25% load (2.37 gal)"
      ],
      [
        "Weight",
        "74.3 lb"
      ],
      [
        "Dimensions",
        "19.3 x 16.9 x 16.4 in"
      ],
      [
        "Parallel",
        "Yes, with Generac parallel kit (sold separately)"
      ]
    ],
    "pros": [
      "3,000 running watts at a mid-range price",
      "PowerRUSH helps start motor loads like sump pumps",
      "Inverter-clean power for electronics",
      "Economy mode cuts fuel use and noise at light load",
      "Parallel capable"
    ],
    "cons": [
      "Open frame lets out more engine noise than enclosed inverters",
      "Bulkier than suitcase units; two hands to carry"
    ],
    "bottomLine": "A practical middle step when 2,000 watts is not enough and a 4,500-watt inverter is more than you want to spend.",
    "description": "The GP3500iO splits the difference between suitcase inverters and full-size portables. Generac rates it at 3,000 running and 3,500 starting watts, and its PowerRUSH feature is designed to help start motor loads such as a sump pump or a window air conditioner that a 2,200-watt unit might struggle with. That makes it a reasonable choice for a refrigerator, a freezer, a sump pump and lights together if you stagger the start-ups. Generac lists 8 hours at half load and 11 hours at quarter load on a 2.37-gallon tank, and Economy mode throttles the engine down to save fuel and cut noise at light loads. Output is inverter-clean, so laptops, TVs and furnace control boards are safe on it. The open frame keeps the cost and the 74.3 lb weight down compared with an enclosed design, but it lets more engine noise out, so it is not the one to run beside a neighbor's bedroom. It is parallel capable with Generac's kit, sold separately. Generac does not publish a decibel figure for this model in its spec sheet, so if quiet is your top priority, look at an enclosed inverter instead."
  },
  {
    "id": "wen-56380i",
    "name": "WEN 56380i Super Quiet 3800-Watt Portable Inverter Generator with Electric Start",
    "category": "3,400W running / 3,800W surge, electric start",
    "badge": "Best Budget Electric Start",
    "amazonUrl": "#",
    "specs": [
      [
        "Running / Surge Watts",
        "3,400 / 3,800"
      ],
      [
        "Noise",
        "57 dBA at 1/4 load"
      ],
      [
        "Run Time",
        "Up to 8.5 hr at 50% load"
      ],
      [
        "Engine",
        "212cc 4-stroke OHV"
      ],
      [
        "Weight",
        "99.2 lb"
      ],
      [
        "Parallel",
        "Yes, with WEN 56421 parallel kit"
      ]
    ],
    "pros": [
      "3,400 running watts for much less than name-brand rivals",
      "Electric start with recoil backup",
      "Rated 57 dBA at quarter load",
      "Fuel shutoff lets you run the carburetor dry for storage",
      "Parallel capable with WEN's kit"
    ],
    "cons": [
      "No CO shutoff listed in WEN's specs",
      "99.2 lb, close to the iGen4500 without its output",
      "Thinner service network than Honda, Generac or Champion"
    ],
    "bottomLine": "The budget way to get mid-size inverter output with a push-button start.",
    "description": "WEN has built a large following by selling inverter generators with mid-size output at prices well below the big names, and the 56380i is its sweet spot. WEN rates it at 3,400 running and 3,800 surge watts from a 212cc OHV engine, which covers a refrigerator, a freezer, lights, internet and a furnace blower with some staggering. WEN lists noise at 57 dBA at quarter load and run time of up to 8.5 hours at half load. Electric start with a recoil backup is unusual at this price, and the fuel shutoff valve lets you run the carburetor dry before storage, which is the single best habit for a generator that sits most of the year. It is compatible with WEN's 56421 parallel kit. The trade-offs are real. WEN's published specs do not list a carbon monoxide shutoff, so placement and indoor CO alarms carry all the safety weight. At 99.2 lb it is as heavy as the Westinghouse iGen4500 with less output, and WEN's service network is thinner than Honda's or Generac's. For a buyer who wants push-button convenience and 3,000-plus watts on a budget, it is a sensible pick."
  },
  {
    "id": "honda-eu3200i",
    "name": "Honda EU3200i Inverter Generator with CO-MINDER",
    "category": "2,600W running / 3,200W max, 59 lb, CO-MINDER",
    "badge": "Best Premium Step-Up",
    "amazonUrl": "#",
    "specs": [
      [
        "Running / Max Watts",
        "2,600 / 3,200"
      ],
      [
        "Noise",
        "54 dBA (1/4 load) to 58 dBA (rated load)"
      ],
      [
        "Run Time",
        "3.3 hr rated / 8.6 hr 1/4 load (1.2 gal)"
      ],
      [
        "Dry Weight",
        "About 59 lb"
      ],
      [
        "Parallel",
        "Yes, two units up to 6,400W with optional kit"
      ],
      [
        "CO Safety",
        "CO-MINDER automatic shutoff"
      ]
    ],
    "pros": [
      "About 44% more running output than the EU2200i",
      "Still light enough to carry, at about 59 lb",
      "CO-MINDER carbon monoxide shutoff",
      "Honda GX130 engine",
      "Parallels to 6,400 watts"
    ],
    "cons": [
      "Premium price for 2,600 running watts",
      "Recoil start only",
      "1.2-gallon tank still needs refills on long runs"
    ],
    "bottomLine": "The Honda to buy if the EU2200i is just short of what your refrigerator, freezer and furnace need together.",
    "description": "The EU3200i is Honda's answer to buyers who love the EU2200i but keep bumping into its 1,800-watt ceiling. Retail spec listings rate it at 3,200 maximum and 2,600 running watts from a Honda GX130 engine, roughly 44 percent more continuous output than the EU2200i in a package that still weighs only about 59 lb dry. That extra margin is what lets a refrigerator, a chest freezer and a gas furnace blower run together without tripping the overload light every time two compressors start at once. Noise is listed at 54 dBA at quarter load and 58 dBA at rated load, very close to the smaller Honda. Run time is about 3.3 hours at rated load and 8.6 hours at quarter load on a 1.2-gallon tank. CO-MINDER shuts the generator down if carbon monoxide builds to unsafe levels around it. Two units can be paralleled for up to 6,400 watts with Honda's kit. The downsides are price and the recoil-only start. If you can live with 1,800 watts, the EU2200i is better value; if you cannot, this is the quiet, carryable step up."
  },
  {
    "id": "yamaha-ef2200is",
    "name": "Yamaha EF2200iS Inverter Generator",
    "category": "1,800W rated / 2,200W max, fuel gauge, 1.24 gal",
    "badge": "Best Honda Alternative",
    "amazonUrl": "#",
    "specs": [
      [
        "Rated / Max Watts",
        "1,800 / 2,200"
      ],
      [
        "Noise",
        "57 dBA (1/4 load) to 65 dBA (rated load), at 7 m"
      ],
      [
        "Run Time",
        "Up to 10.5 hr at 1/4 load"
      ],
      [
        "Fuel Tank",
        "1.24 gal with fuel gauge"
      ],
      [
        "Dry Weight",
        "55.2 lb"
      ],
      [
        "Parallel",
        "Yes, Twin Tech with a second EF2200iS"
      ]
    ],
    "pros": [
      "Longer quarter-load run time than the Honda EU2200i",
      "Built-in fuel gauge",
      "Parallel capable with Yamaha's Twin Tech cable",
      "Economy control throttles down at light load",
      "Yamaha dealer network for service"
    ],
    "cons": [
      "Priced close to the Honda",
      "About 8 lb heavier than the EU2200i",
      "Louder at rated load than the Honda's published figure"
    ],
    "bottomLine": "The premium alternative to the Honda for buyers who value run time per tank and a fuel gauge.",
    "description": "Yamaha's EF2200iS is the closest thing the Honda EU2200i has to a direct rival, and on a couple of points it wins. Yamaha rates it at 2,200 maximum and 1,800 rated watts, the same as the Honda, but its 1.24-gallon tank gives up to 10.5 hours at quarter load, a meaningful edge for overnight refrigerator duty. It also has a fuel gauge, which sounds trivial until you are checking a tank by flashlight in the rain. Yamaha lists noise at 57 dBA at quarter load and 65 dBA at rated load, measured at 7 meters, so it is a little louder than the Honda when working hard. Dry weight is 55.2 lb, about 8 lb more than the EU2200i, still a one-person carry. Two units can be paralleled with Yamaha's Twin Tech cable for 30 amps of rated output. Some recent listings describe a version with a CO sensor, so check the listing if carbon monoxide shutoff matters to you, and it should. Price lands close to the Honda; choose the Yamaha if run time and the gauge matter more to you than Honda's larger service network."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Inverter Generator",
          item: "https://www.allmetalbrake.com/best-inverter-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best inverter generator for home use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For essentials, the Honda EU2200i is our top pick for reliability, low noise and its CO-MINDER shutoff. For a fuller outage load, the Westinghouse iGen4500 offers 3,700 running watts and long run time. On a budget, the Champion 2500-Watt Ultralight or the WEN 56380i give good value for the money."
          }
        },
        {
          "@type": "Question",
          "name": "Is an inverter generator better than a regular generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For quiet, fuel economy at light load and clean power for electronics, yes. A regular open-frame generator gives more watts per dollar and often 240V outlets for a transfer switch or well pump. Many households are best served by an inverter for everyday outages, or a dual fuel open frame when they need big output."
          }
        },
        {
          "@type": "Question",
          "name": "How quiet is an inverter generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Makers rate the quietest models in the high 40s to high 50s dBA at light load. Honda lists the EU2200i at 48 to 57 dBA from quarter to rated load, Westinghouse rates the iGen4500 from 52 dBA, and WEN lists the 56380i at 57 dBA at quarter load. Open-frame generators are commonly rated around 74 dBA."
          }
        },
        {
          "@type": "Question",
          "name": "Can an inverter generator run a refrigerator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. A typical modern refrigerator runs well within the 1,800 running watts of a Honda EU2200i or Yamaha EF2200iS, and their starting surge covers the compressor start. Add a freezer, sump pump or furnace blower at the same time and a 3,000-watt-plus inverter like the GP3500iO or iGen4500 is the safer choice."
          }
        },
        {
          "@type": "Question",
          "name": "Can I connect an inverter generator to my house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sometimes, with limits. The models here are 120V only, so they cannot power 240V circuits like a well pump. Where a generator has a 120V 30-amp outlet, an electrician may be able to set up a compatible transfer switch or inlet. Never backfeed through a dryer outlet; it can kill utility workers."
          }
        },
        {
          "@type": "Question",
          "name": "How long will an inverter generator run on a tank of gas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends heavily on load. Westinghouse lists up to 18 hours at quarter load for the iGen4500 on 3.4 gallons. Yamaha lists 10.5 hours at quarter load for the EF2200iS, and Honda lists 8.1 hours at quarter load but 3.2 hours at full rated load for the EU2200i."
          }
        },
        {
          "@type": "Question",
          "name": "Is it worth paralleling two inverter generators?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can be. Two matched units give roughly double the output while each stays light enough to carry, and you keep a backup if one fails. The trade-offs are higher total cost, two engines to maintain and output that is still 120V only. For a single fixed home setup, one larger inverter is often simpler."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "best inverter generator",
      "inverter generator",
      "portable inverter generator",
      "inverter generator for home",
      "inverter vs conventional generator",
      "generator decibel rating"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The Best Inverter Generators, Ranked
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          Seven quiet, fuel-efficient generators compared on what the makers actually publish: running watts, decibels, run time, weight and safety features.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">11 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
