const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 7 Best Cordless Leaf Blowers: Picked by Yard Size";
const description =
  "Seven battery leaf blowers compared on airflow, runtime, noise and platform, with plain advice on CFM vs MPH, wet leaves, batteries and local noise rules.";

