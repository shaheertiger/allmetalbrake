const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Cordless Blower Picks",
          item: "https://www.allmetalbrake.com/best-cordless-leaf-blower/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Can a battery blower really replace a gas one?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homeowners with up to about half an acre, yes. Top handheld battery blowers now list airflow comparable to many gas handhelds, start instantly and run much quieter. The limitation is runtime at high output. Owners of large wooded properties may still prefer a gas or battery backpack blower, or a second and third battery for handheld use."
          }
        },
        {
          "@type": "Question",
          "name": "How many minutes will a battery blower run?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on battery capacity and speed. At the lowest setting, a large battery can run a long time, but at full output many high-airflow blowers run only around ten to fifteen minutes, and turbo shortens that further. Use the lowest speed that moves your debris and keep a spare battery for big cleanups."
          }
        },
        {
          "@type": "Question",
          "name": "Will a cordless blower move wet leaves?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "High-output models with strong air speed can lift wet leaves, especially with a narrow nozzle aimed low under the leading edge. It is still the hardest job for any blower and drains batteries quickly. Waiting for a dry afternoon, using a rake for matted spots, or mulching with a mower are often faster for heavily soaked leaves."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need more than one battery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For small yards, one battery is usually enough. For quarter to half-acre lots with several trees, one large battery handles routine cleanups and a second makes fall weekends far easier. For bigger properties, plan on two large batteries from the start, or consider a backpack battery or backpack blower. A spare also lets one charge while the other runs."
          }
        },
        {
          "@type": "Question",
          "name": "What CFM do I need for my yard?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As a rough guide, 300 to 450 CFM suits decks, patios and small lots, 450 to 600 CFM handles most suburban yards, and 600 CFM or more is worth it for larger lots and heavy leaf drops. Comparing ratings across brands is imperfect because test methods vary, so treat them as broad classes rather than exact rankings."
          }
        },
        {
          "@type": "Question",
          "name": "Are battery blowers quieter than gas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Generally yes. Many battery handhelds publish noise ratings in the 50s to 60s dBA measured at 50 feet, quieter than typical gas models. That is easier on neighbors, but a high-output blower on turbo can still be loud at your ear, so hearing protection is wise for long sessions. Lower settings are quieter still."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy a backpack blower instead?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A backpack blower makes sense for properties over about an acre, heavy tree cover, or anyone who clears leaves for long sessions. Backpacks move the weight onto your shoulders and can carry larger batteries or fuel tanks. For most suburban yards a good handheld battery blower with a spare battery is lighter, cheaper and easier to store."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
