---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Home Generators for Power Outages",
    "url": "/best-home-generator-for-power-outages/"
  },
  {
    "title": "Small Generators for Home Use",
    "url": "/best-small-generator-for-home/"
  },
  {
    "title": "Portable Power Stations Ranked",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "What a Generac Standby Costs",
    "url": "/generac-generator-cost/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 6 Best Gas Generators: Gasoline Power Sized for a House";
const description =
  "Six gasoline generators ranked for home backup, from 2,200W inverters to 9,500W open frames, with fuel burn math, gas storage rules and safe house connection.";

const PRODUCTS = [
  {
    "id": "generac-gp8000e",
    "name": "Generac GP8000E Electric-Start Portable",
    "category": "Open Frame, 8,000W Running / 10,000W Starting",
    "badge": "Top Gasoline Pick",
    "amazonUrl": "",
    "pros": [
      "8,000 running watts covers a 240V well pump plus essentials",
      "Electric start with pull-cord backup",
      "COsense carbon monoxide shutoff",
      "120/240V locking outlet for a transfer switch",
      "Wide dealer and parts network"
    ],
    "cons": [
      "Fixed-speed engine burns fuel steadily even at light load",
      "Loud by inverter standards"
    ],
    "bottomLine": "The gasoline portable we would buy first for a house with a well, a sump or a long outage history.",
    "description": "The GP8000E hits the size most houses actually need from a gasoline portable. Generac rates it at 8,000 running and 10,000 starting watts, enough to start a 240V well pump while a refrigerator, freezer, furnace blower and lights keep running, provided you are connected through a transfer switch or interlock. The electric start uses an onboard battery, with a recoil cord as backup, and COsense shuts the engine down if carbon monoxide builds up around it. The steel cradle and never-flat tires suit a unit that lives in a shed and gets dragged across a wet yard. Its fuel tank holds roughly 8 gallons, and Generac lists a long run time at half load, but it is a conventional fixed-speed design, so do not expect inverter-like economy at light loads. Owners commonly praise its starting reliability when maintained and mention the noise. Expect roughly $1,000 to $1,300 at the time of writing."
  },
  {
    "id": "westinghouse-wgen9500-gas",
    "name": "Westinghouse WGen9500 Remote-Start",
    "category": "Open Frame, 9,500W Running / 12,500W Starting",
    "badge": "Most Watts for the Money",
    "amazonUrl": "",
    "pros": [
      "9,500 running watts for the price of many 8,000W units",
      "Key-fob remote start",
      "Both 30A and 50A 120/240V outlets",
      "6.6-gallon tank with fuel gauge",
      "Westinghouse's long warranty and US support"
    ],
    "cons": [
      "Heavy, well over 200 pounds",
      "Thirsty at high load"
    ],
    "bottomLine": "The value pick when you want room for a window air conditioner or bigger well pump on top of essentials.",
    "description": "The WGen9500 gives you a lot of gasoline generator for the money. Westinghouse rates it at 9,500 running and 12,500 starting watts, a step above the 8,000-watt class that gives room for a window air conditioner or a larger well pump alongside the usual essentials. Remote start from a key fob is genuinely useful in bad weather, and the outlet panel carries both a 30-amp and a 50-amp 120/240V locking outlet, so it can feed either common size of transfer switch or inlet. The 6.6-gallon tank includes a fuel gauge, and Westinghouse lists a long run time at moderate load. It is heavy enough that you will rely on the wheels and handle, and at high loads it burns gasoline quickly. Newer production includes a carbon monoxide sensor; confirm the version you buy has it. Expect roughly $1,100 to $1,500 at the time of writing."
  },
  {
    "id": "westinghouse-igen4500",
    "name": "Westinghouse iGen4500 Gasoline Inverter",
    "category": "Inverter, 3,700W Running / 4,500W Starting",
    "badge": "Quietest Mid-Size Gas Unit",
    "amazonUrl": "",
    "pros": [
      "Inverter efficiency stretches gasoline at light loads",
      "Much quieter than open-frame units",
      "Electric and remote start",
      "Clean power for electronics",
      "Display shows remaining run time"
    ],
    "cons": [
      "120V only",
      "Cannot match open-frame output for whole-house essentials"
    ],
    "bottomLine": "The best gas pick when fuel supply and noise matter more than raw wattage.",
    "description": "If gasoline is hard to come by in your outages, the iGen4500 is the smartest gas generator on this list. As an inverter, it slows its engine when demand drops, so a refrigerator, freezer, furnace blower and lights at a few hundred to 2,000 watts burn far less fuel than the same loads on an open-frame machine. Westinghouse rates it at 3,700 running and 4,500 starting watts on a 3.4-gallon tank, and lists long run times at light load. It is also much quieter, which helps with neighbors and sleep. Electric and remote start, a fuel and run-time display, and clean output for electronics round it out. The limits: 120V only, so no 240V well pump, and not enough output for central air. For a house with gas heat and a basement, it covers the essentials using a fraction of the gasoline. Expect roughly $1,000 to $1,300 at the time of writing."
  },
  {
    "id": "firman-p08004",
    "name": "Firman P08004 Gas Portable",
    "category": "Open Frame, 8,000W Running / 10,000W Starting",
    "badge": "Budget Big-Output Pick",
    "amazonUrl": "",
    "pros": [
      "8,000 running watts at a lower price than most name brands",
      "120/240V output for a transfer switch",
      "Sturdy steel frame and wheel kit",
      "Simple controls"
    ],
    "cons": [
      "Smaller service network than Generac or Westinghouse",
      "Loud, conventional engine",
      "Fewer convenience features"
    ],
    "bottomLine": "A solid way to get 8,000 running watts when budget matters more than features.",
    "description": "Firman's P08004 is a no-frills route into the 8,000-watt class. It is rated at 8,000 running and 10,000 starting watts on gasoline, the same headline output as the GP8000E, with 120/240V output for a transfer switch or interlock connection. That covers a well pump or sump pump plus refrigerator, freezer, furnace blower and lights in a typical house. The frame and wheels are built for rough use, and the controls are straightforward. What you trade for the lower price is mostly in the support column: Firman's service network is thinner than Generac's or Westinghouse's, and the feature list is shorter. Owners commonly report it starts and runs well when fed fresh, stabilized fuel and exercised. Check the specific listing for carbon monoxide shutoff and start type, as features vary by version. Expect roughly $800 to $1,100 at the time of writing."
  },
  {
    "id": "honda-eu2200i",
    "name": "Honda EU2200i Gasoline Inverter",
    "category": "Inverter, 1,800W Running / 2,200W Starting",
    "badge": "Best Small Gas Generator",
    "amazonUrl": "",
    "pros": [
      "Exceptionally reliable Honda engine",
      "Runs up to about 8 hours at quarter load on under a gallon",
      "Quiet enough for close neighbors",
      "CO-MINDER shutoff",
      "Light enough to carry"
    ],
    "cons": [
      "Only enough for essentials",
      "Expensive for its output"
    ],
    "bottomLine": "The gas generator to buy if your outage needs are a fridge, lights and internet and you want it to start every time.",
    "description": "Not every gas generator buyer needs 8,000 watts. If your outage needs are a refrigerator, lights, internet and phones, or a gas furnace blower, the EU2200i does it on a remarkably small amount of fuel. Honda rates it at 1,800 running and 2,200 starting watts, with listed run time of about 3.2 hours at full rated load and about 8.1 hours at a quarter load on its 0.95-gallon tank. A few gallons of stabilized gasoline covers a lot of outage at that rate. It weighs about 47 pounds, runs quietly, and its CO-MINDER system stops the engine if carbon monoxide accumulates nearby. It can be paralleled with a second unit if you need more later. You pay a premium over similar-spec rivals, mostly for the engine's reputation and Honda's dealer network. Expect roughly $1,100 to $1,300 at the time of writing."
  },
  {
    "id": "duromax-xp12000e-gas",
    "name": "DuroMax XP12000E Gasoline Portable",
    "category": "Open Frame, 9,500W Running / 12,000W Starting",
    "badge": "Largest Gas-Only Output",
    "amazonUrl": "",
    "pros": [
      "9,500 running watts from a 457cc engine",
      "50-amp 120/240V outlet",
      "Large fuel tank",
      "Electric start",
      "Copper alternator windings"
    ],
    "cons": [
      "Very heavy",
      "Fuel burn at high load is substantial",
      "Loud"
    ],
    "bottomLine": "For houses that need near-standby output from a portable and can keep it fed.",
    "description": "The XP12000E is the gasoline-only version of DuroMax's big portable, rated at 9,500 running and 12,000 starting watts. That is enough to run a modest central air conditioner in some cases, especially with a soft-start kit, or a large slice of a house with gas heat and a gas water heater. A 50-amp 120/240V outlet suits a larger transfer switch or panel interlock. The engine is a 457cc unit with electric start, and the alternator uses copper windings. All that output comes with weight, well over 200 pounds, noise, and fuel burn that can reach many gallons a day at heavy load. If you are considering one, do the fuel math first, and compare the total cost against a small standby generator on natural gas; for some homes, the standby wins once fuel and labor are counted. Expect roughly $1,100 to $1,500 at the time of writing."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Gasoline Generators",
          item: "https://www.allmetalbrake.com/best-gas-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How many gallons of gas does a generator use in a day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on size and load. A 2,200-watt inverter at light load might use 2 to 4 gallons over 24 hours, a 4,500-watt inverter perhaps 6 to 10, and an 8,000-watt open frame at half load roughly 14 to 19. Running in cycles, a couple of hours on and a few off, can cut those figures by half or more."
          }
        },
        {
          "@type": "Question",
          "name": "How long can gasoline sit in a generator before it goes bad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Untreated gasoline can start causing starting problems in small engines within a month or two, especially ethanol blends. With a fuel stabilizer added when the fuel is fresh, labels commonly claim one to two years. In practice, rotate stored fuel every few months, run the generator monthly, and follow the manual on storage."
          }
        },
        {
          "@type": "Question",
          "name": "Can I run a gas generator all night?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if it is placed safely outdoors, at least 20 feet from the house with exhaust pointed away, has enough fuel, and battery CO alarms are working inside. Never refuel while it runs. Many owners shut it off overnight once the fridge and freezer are cold, or switch to a battery station for overnight loads, saving fuel and keeping neighbors happy."
          }
        },
        {
          "@type": "Question",
          "name": "Is gasoline or dual fuel better for home backup?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dual fuel is usually the better choice for outage backup because propane stores indefinitely and gives you a second fuel when gasoline is scarce. You lose roughly 10 percent of output on propane. Gasoline-only units are simpler and sometimes cheaper. If you will reliably rotate stabilized gasoline, either works; if not, dual fuel is more forgiving."
          }
        },
        {
          "@type": "Question",
          "name": "What size gas generator runs a whole house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Truly whole-house coverage including central air, an electric water heater or electric cooking usually needs 15,000 to 25,000 watts or more, which is standby territory. Large portables of 9,500 to 12,000 running watts can cover most of a house with gas heat through a transfer switch, especially if you manage loads. Essentials-only households need far less."
          }
        },
        {
          "@type": "Question",
          "name": "How much gasoline can I legally store at home?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Limits are set by local fire codes and vary. Many residential codes cap gasoline in a garage or shed at around 25 gallons in approved containers, and some places are stricter or prohibit storage in attached garages. Check with your local fire department, keep fuel out of the living space, away from ignition sources, and in approved, sealed cans."
          }
        },
        {
          "@type": "Question",
          "name": "Do gas generators need a transfer switch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not if you only run extension cords from the generator to individual appliances. To power hardwired loads like a furnace, well pump or panel circuits, you need a manual transfer switch or listed interlock kit with an inlet, installed by a licensed electrician with a permit. Plugging into a wall or dryer outlet instead is dangerous and illegal."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "best gas generator",
      "gasoline generator",
      "portable gas generator",
      "generator fuel consumption",
      "storing gasoline for generator",
      "electric start generator"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The Best Gas Generators for Home Backup
        </h1>
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          Gasoline is the cheapest way to buy a lot of portable watts and the hardest fuel to keep fresh. These six machines are worth the trade, and this is how to feed them.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">13 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>The Six Picks</span></a>
              <a href="#terminology" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>Gasoline or Natural Gas?</span></a>
              <a href="#house-sizing" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Sizing for Your House</span></a>
              <a href="#fuel-burn" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Fuel Burn Math</span></a>
              <a href="#storing-gas" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>Storing Gasoline</span></a>
              <a href="#fuel-comparison" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Gasoline vs Propane vs NG</span></a>
              <a href="#frame-vs-inverter" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Open Frame or Inverter</span></a>
              <a href="#features" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>Features Worth Paying For</span></a>
              <a href="#house-connection" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>Connecting to the Panel</span></a>
              <a href="#co-rules" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Carbon Monoxide Rules</span></a>
              <a href="#startable" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>Keeping It Startable</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">12.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">13.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A gasoline generator gives you the most outage power per dollar of any option, and asks for discipline in return: a realistic fuel plan, stabilized storage, a monthly run, a proper transfer switch, and a parking spot well away from the house. Get those right and a gas portable is the best value backup most homes can buy.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Six Gasoline Generators, Ranked
          </h2>

          <p>
            Rankings are based on manufacturer specifications (running and starting watts, tank capacity and listed run time, outlet panel), carbon monoxide shutoff features, EPA and CARB certification, warranty terms, parts and service availability, and patterns that show up repeatedly in owner feedback. We did not run our own test program on these units. Each pick is ranked for the household it suits best.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} index={index} />
          ))}
        </div>

        <div id="terminology" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Gas Generator: Gasoline or Natural Gas?
          </h2>

          <p>
            In generator shopping, gas usually means gasoline: a portable machine with its own tank that you fill from a can. But natural gas generators exist too, almost all of them permanently installed standby units plumbed to the house's gas line. The two are different purchases with different prices, installation and safety considerations.
          </p>

          <p>
            This guide covers gasoline portables. They cost a fraction of standby units, need no installation beyond a transfer switch or interlock, and can be moved to wherever you need power. In exchange, you handle fuel, starting, connection and placement yourself every outage.
          </p>

          <p>
            If you want a machine that starts on its own and runs for days on a utility gas line, our <a href="/generac-generator-cost/">Generac cost guide</a> covers what natural gas standby systems actually cost installed, and our <a href="/best-home-generator-for-power-outages/">home generator rankings</a> compare standby, gasoline, dual fuel and battery options side by side.
          </p>

          <p>
            There is also a middle ground: dual fuel and tri-fuel portables that run on gasoline or propane, and in tri-fuel cases natural gas through a quick-connect. Those trade a little output on the gaseous fuels for much easier long-term fuel storage, and they are worth a look if the fuel problems below worry you.
          </p>
        </div>

        <div id="house-sizing" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Sizing a Gasoline Generator for Your House
          </h2>

          <p>
            Start with a list of what must run, not what would be nice. For most homes that means refrigerator, freezer, lights, internet, a gas furnace blower in winter, a sump pump if you have a basement, and a well pump if you are not on city water. Look up each appliance's running watts on its data plate, add them, then add the largest single starting surge on top.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">House situation</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical running watts needed</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Gas generator class</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">City water, gas heat, no basement</td>
                    <td class="px-4 py-4 text-gray-700">2,000-3,500W</td>
                    <td class="px-4 py-4 text-gray-700">2,200-4,500W inverter</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">City water, gas heat, basement sump</td>
                    <td class="px-4 py-4 text-gray-700">3,500-5,500W</td>
                    <td class="px-4 py-4 text-gray-700">4,500W inverter to 8,000W open frame</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Private well, gas heat, sump</td>
                    <td class="px-4 py-4 text-gray-700">5,500-7,500W including pump start</td>
                    <td class="px-4 py-4 text-gray-700">8,000-9,500W open frame with 240V</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Essentials plus window AC or two</td>
                    <td class="px-4 py-4 text-gray-700">7,000-9,000W</td>
                    <td class="px-4 py-4 text-gray-700">9,500W open frame</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Central AC and most of the house</td>
                    <td class="px-4 py-4 text-gray-700">12,000W and up</td>
                    <td class="px-4 py-4 text-gray-700">Standby, or a very large portable with soft start</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            A 240-volt well pump is the dividing line. It needs a generator with a 120/240V outlet, typically an L14-30 or 14-50, connected through a transfer switch or interlock, and its starting surge can be two to three times its running draw. That puts most well houses in the 8,000-watt class or above.
          </p>

          <p>
            Leave headroom. A generator running at 90 percent of its rating for days runs hot, loud and thirsty, and voltage sags stress motors. Aim to use about 75 to 80 percent of the running rating at most. If your list lands at 6,000 watts, an 8,000-watt unit is right; a 6,500-watt unit is not.
          </p>

          <p>
            Bigger is not automatically better, though. A 9,500-watt generator powering 2,000 watts of load burns nearly as much fuel per hour as at half load. If your essentials are modest, a mid-size inverter or a smaller open frame will run far longer on the same can of gas. For homes where 4,500 watts is plenty, see our <a href="/best-small-generator-for-home/">small generator picks</a>.
          </p>
        </div>

        <div id="fuel-burn" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Fuel Burn Math: How Many Gallons an Outage Takes
          </h2>

          <p>
            Fuel is where gas generator plans fall apart. Manufacturers list run time at 25 or 50 percent load, which is reasonable, but owners routinely underestimate how many hours they will run and overestimate how easily they will buy fuel in a regional outage. Gas stations need electricity to pump, and the ones that have it get long lines.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">Typical Gasoline Consumption</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">0.1-0.3 gal/hr</p>
                <p class="text-gray-400 text-xs mt-1">2,200W inverter, light load</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">0.3-0.5 gal/hr</p>
                <p class="text-gray-400 text-xs mt-1">4,500W inverter, moderate load</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">0.6-0.8 gal/hr</p>
                <p class="text-gray-400 text-xs mt-1">8,000W open frame, half load</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">0.8-1.2 gal/hr</p>
                <p class="text-gray-400 text-xs mt-1">9,500W+ open frame, heavy load</p>
              </div>
            </div>
          </div>

          <p>
            Those are typical ranges, not specifications; check your model's manual. At about 0.7 gallons an hour, an 8,000-watt open frame running around the clock uses roughly 17 gallons a day. Three days is over 50 gallons, which is more gasoline than most people can store safely or legally at home.
          </p>

          <p>
            The fix is to run in cycles. A refrigerator and freezer stay cold for hours once chilled, a sump pit can be pumped down and left for a while in most storms, and a house with gas heat cools slowly. Running the generator two hours on, three or four hours off can cut fuel use by half or more. Many owners pair this with a <a href="/best-portable-power-station/">battery power station</a> that carries the router, phones and a few lights during the off periods.
          </p>

          <p>
            Do the arithmetic before you buy. Multiply realistic hours of running per day by the gallons per hour at your expected load, then by the number of days your typical long outage lasts. If that number is uncomfortably large, choose an inverter, choose dual fuel, or plan to cycle.
          </p>
        </div>

        <div id="storing-gas" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. Storing Gasoline Without Ruining It or Your Garage
          </h2>

          <p>
            Pump gasoline is not a long-term storage fuel. Its lighter compounds evaporate, it oxidizes into gums and varnish, and the ethanol in most blends absorbs moisture from the air. Untreated, it can begin causing starting problems in small engines within a month or two, and over several months it can leave deposits that need a carburetor cleaning to fix.
          </p>

          <p>
            Add a fuel stabilizer every time you fill a storage can, not just before the generator goes away for winter. Stabilizer labels commonly claim protection for one to two years, but rotation is still the better habit: use stored gasoline in your car every few months and refill with fresh, stabilized fuel. Ethanol-free gasoline, where available, stores better and is kinder to small engines.
          </p>

          <p>
            Use approved, tightly sealed containers, ideally the ones with spill-proof spouts, and keep them out of the living space: a detached shed or garage, away from water heaters, furnaces, dryers and anything else with a flame or spark. Keep them out of direct sun. Local fire codes often limit how much gasoline you can keep at home, commonly around 25 gallons in a residential garage, so check yours before you stockpile.
          </p>

          <p>
            Store containers on a shelf or floor away from where kids play, labeled with the date filled. When you refuel the generator, shut the engine off and let it cool for several minutes first. Spilled gasoline on a hot muffler or exhaust is one of the most common ways generators start fires.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">STORAGE RULE OF THUMB</p>
            <p class="text-xl font-bold text-white mb-3">Stabilize every can, rotate every season.</p>
            <p class="text-gray-300 leading-relaxed m-0">Treat stored gasoline like milk with a long date: fine for a while, worse every month. Add stabilizer at the pump, mark the date, burn it in your car within a few months, and refill. Your generator will start, and you will never pour out a can of varnish.</p>
          </div>
        </div>

        <div id="fuel-comparison" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            6. Gasoline vs Propane vs Natural Gas
          </h2>

          <p>
            Each fuel has a clear strength. Gasoline delivers the most power per gallon and is easy to buy in normal times. Propane stores for years without degrading and is sold in standard cylinders almost everywhere. Natural gas never needs storing at all, but it only works with a fixed connection, usually on a standby unit.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Fuel</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Shelf life</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Output vs gasoline</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Main drawback</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Gasoline</td>
                    <td class="px-4 py-4 text-gray-700">Months, longer with stabilizer</td>
                    <td class="px-4 py-4 text-gray-700">Full rated output</td>
                    <td class="px-4 py-4 text-gray-700">Goes stale; hard to buy in outages</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Propane</td>
                    <td class="px-4 py-4 text-gray-700">Indefinite in a sound tank</td>
                    <td class="px-4 py-4 text-gray-700">Roughly 10 percent less</td>
                    <td class="px-4 py-4 text-gray-700">More fuel volume per hour; cylinders can struggle in deep cold</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Natural gas</td>
                    <td class="px-4 py-4 text-gray-700">No storage needed</td>
                    <td class="px-4 py-4 text-gray-700">Often 10 to 20 percent less</td>
                    <td class="px-4 py-4 text-gray-700">Requires a gas line and fixed installation</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            For a gasoline-only portable owner, propane is the most useful backup to think about. A dual fuel generator lets you run on stabilized gasoline first, then switch to a stack of 20-pound cylinders when the gas cans run dry. Propane also eliminates the stale-fuel carburetor problem, since the carburetor does not hold liquid fuel when running on it.
          </p>

          <p>
            Gasoline still makes sense for many people: its energy density is the highest of the three, you can rotate it through your car, and gasoline-only units are often a bit cheaper and simpler. Just treat fuel planning as part of the purchase.
          </p>
        </div>

        <div id="frame-vs-inverter" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            7. Open Frame or Inverter: Which Gas Generator Type?
          </h2>

          <p>
            Open-frame generators run at a fixed engine speed to produce 60-hertz power directly. They are cheaper per watt and come in big sizes with 240V outlets, which is why they dominate the 8,000-watt and up class. They are also louder, and they burn fuel at a fairly steady rate whatever the load.
          </p>

          <p>
            Inverter generators vary engine speed with demand and electronically produce clean 60-hertz power. They are quieter, much more efficient at light loads, and safer for electronics. Most are 120V only and top out around 4,500 watts, though a few larger inverter models exist at higher prices.
          </p>

          <p>
            For a household where the generator mostly runs a refrigerator, furnace blower and lights, an inverter can use half the gasoline of an open frame over an outage. For a house with a well pump, a larger sump pump or a window air conditioner, the open frame's 240V output and surge capacity are what you need.
          </p>

          <p>
            A practical compromise for some homes is to own a mid-size inverter for most outages and borrow or rent more capacity for the rare extreme event, or to pair an open frame with a battery station so the engine only runs part of the day. Either approach reduces the fuel you need to store.
          </p>
        </div>

        <div id="features" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            8. Features Worth Paying Extra For
          </h2>

          <p>
            <strong>Automatic CO shutoff</strong> is the first feature to insist on. It costs little extra, it is now common across major brands, and it directly addresses the way generators kill people. Look for ANSI/PGMA G300 or UL 2201 on the packaging or spec sheet.
          </p>

          <p>
            <strong>Electric start</strong> matters more than it seems on a showroom floor. Pulling a recoil cord on a 450cc engine in freezing rain is hard work, and for older owners it can be the difference between using the generator and not. Remote start fobs are a nice extra, but they do not change placement rules: the generator still sits 20 feet or more from the house. Keep the pull cord as a backup and keep the starting battery charged.
          </p>

          <p>
            <strong>A 120/240V outlet that matches your inlet</strong> is essential for houses with a well pump or a transfer switch. An <strong>hour meter</strong> makes oil-change intervals easy to track, and a <strong>fuel gauge</strong> saves you opening a hot tank to check the level. Never-flat tires and a folding handle are worth having on anything over about 150 pounds.
          </p>

          <p>
            Check emissions certification too. In California and some other states, only CARB-compliant small engines can be sold, and most national brands now ship CARB versions. EPA certification is standard. Finally, compare warranties; three years of residential coverage is common among the major brands, and a local service dealer is worth more than an extra year on paper.
          </p>
        </div>

        <div id="house-connection" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            9. Connecting a Gas Generator to Your Electrical Panel
          </h2>

          <p>
            Large gasoline portables earn their keep when they can power hardwired loads: the furnace, the well pump, a sump pump on its own circuit. The only safe and legal ways to do that are a <strong>manual transfer switch</strong> or a listed <strong>panel interlock kit</strong>, each fed through an outdoor power inlet, installed by a licensed electrician with a permit.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">BACKFEED WARNING</p>
            <p class="text-xl font-bold text-white mb-3">No dryer-outlet tricks, ever.</p>
            <p class="text-gray-300 leading-relaxed m-0">Connecting a generator to a dryer or wall receptacle with a double-male cord pushes power back through your panel onto the utility lines. Transformers step it up to thousands of volts, endangering line workers and neighbors. It bypasses protection in your home and can destroy the generator when utility power returns. It violates the National Electrical Code and is illegal in most jurisdictions.</p>
          </div>

          <p>
            Match the inlet to the generator's largest outlet. Most 7,000 to 9,500 watt portables have an L14-30 30-amp 120/240V locking outlet, and many larger units add a 14-50 50-amp outlet. A 30-amp connection delivers up to about 7,200 watts; if your generator can do more and your load list needs it, a 50-amp inlet makes use of the extra capacity.
          </p>

          <p>
            A manual transfer switch, typically covering six to ten selected circuits, commonly costs $800 to $1,800 installed with the inlet and permit. An interlock kit is often less, roughly $500 to $1,200 installed, and lets you choose any circuit, but you have to manage the load yourself to avoid overloading the generator. Both are far cheaper than a fire or an injury.
          </p>

          <p>
            Use a properly rated generator cord between the unit and the inlet, as short as practical given the 20-foot-plus placement rule, and route it so it is not a trip hazard. Some newer generators have GFCI protection that can trip when connected to a house panel because of how neutral and ground are bonded; your electrician can address this correctly. A <a href="/best-circuit-breaker-finder/">circuit breaker finder</a> speeds up labeling which circuits to include.
          </p>
        </div>

        <div id="co-rules" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            10. Carbon Monoxide: Placement Rules That Save Lives
          </h2>

          <p>
            Gasoline generators produce large amounts of carbon monoxide, an odorless, colorless gas that kills people every storm season, often people who were asleep. Most of those deaths involve generators run in garages, basements or right next to the house.
          </p>

          <p>
            Run the generator only outdoors, at least 20 feet from the house, with the exhaust pointing away from doors, windows, vents and your neighbors' homes. Never in a garage, even with the door open, never in a basement, crawlspace, carport or shed, and never on a porch under a roof next to the house. Open doors and fans do not make an enclosed space safe.
          </p>

          <p>
            Install CO alarms that work without grid power, battery-only or with battery backup, on every level and near bedrooms. Test them before storm season. Buy a generator with an automatic CO shutoff, sold under names like COsense, CO-MINDER and CO Shield and certified to ANSI/PGMA G300 or UL 2201; these shut the engine off when CO builds up around it. Treat that feature as a safety net, not as permission to move the generator closer.
          </p>

          <p>
            In rain or snow, use a generator tent or ventilated cover designed for running operation, or a freestanding canopy in the open. If anyone develops a headache, dizziness, nausea or confusion, or a CO alarm sounds, get everyone outside to fresh air right away and call 911.
          </p>
        </div>

        <div id="startable" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            11. Keeping a Gas Generator Ready to Start
          </h2>

          <p>
            Most gas generators that fail during an outage fail at the pull cord or key switch, not under load. The causes are almost always stale fuel, a dead starting battery or old oil. A simple routine fixes all three.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Run it monthly with a real load</h3>

          <p>
            Start the generator once a month and run it for 15 to 30 minutes with a load plugged in, such as a space heater or a shop light. That circulates fresh fuel through the carburetor, charges the starting battery on models that charge it, and reveals problems while you can still fix them calmly.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Choose a storage approach and stick to it</h3>

          <p>
            Either keep the tank full of stabilized fuel, which limits air space and condensation, or shut the fuel valve and run the carburetor dry before storage. Manufacturers differ on which they prefer, so follow your manual. Do not leave untreated gasoline sitting in the carburetor for months.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">Change oil on schedule and keep the battery charged</h3>

          <p>
            New engines need an early first oil change, often after a few hours of break-in, then regular changes by run hours. During a long outage, check the oil every day; a multi-day run can reach the service interval quickly. For electric-start units, keep the battery on a maintainer if the generator does not charge it between uses, and replace it every few years.
          </p>
        </div>

        <!-- Common Mistakes -->
        <div id="mistakes" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            12. Common Mistakes to Avoid
          </h2>

          <div class="space-y-6 my-8">
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Assuming you can buy fuel during the outage</h3>
              <p class="text-gray-700 text-sm m-0">
                Regional outages close gas stations or create long lines at the few that can pump. Owners who plan to buy fuel as they go often run dry on day two. Store enough stabilized gasoline for your realistic first two or three days, rotate it, and cycle the generator to stretch every gallon.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Buying the biggest generator on the shelf</h3>
              <p class="text-gray-700 text-sm m-0">
                A 12,000-watt generator powering a fridge and lights burns gasoline almost as fast as at half load and is far harder to move and store. Size to your real load list plus about 20 to 25 percent headroom. For modest loads, a mid-size inverter covers the same needs on much less fuel.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Refueling a hot engine</h3>
              <p class="text-gray-700 text-sm m-0">
                Pouring gasoline into a running or just-stopped generator risks spilling it onto a hot muffler, which can ignite. Turn the engine off, let it cool for several minutes, refuel carefully with a spill-proof spout, wipe up any spill, and restart. Keep a fire extinguisher rated for flammable liquids nearby.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Storing it with fresh fuel that goes stale</h3>
              <p class="text-gray-700 text-sm m-0">
                Fresh gasoline today is stale gasoline in a few months. A generator left with untreated fuel through the off-season often will not start in the first storm. Add stabilizer to every can at the pump, run the unit monthly under load, and follow the manual for long-term storage.
              </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
              <h3 class="text-lg font-bold text-red-900 mt-0 mb-2">Backfeeding through a dryer outlet</h3>
              <p class="text-gray-700 text-sm m-0">
                Some owners connect a generator to a dryer receptacle with a homemade double-male cord to reach the panel. That sends power onto the utility lines and can kill line workers, start fires and destroy the generator when power returns. Have an electrician install a transfer switch or interlock with an inlet instead.
              </p>
            </div>
          </div>
        </div>

        <PlanTheJob />

        <!-- FAQ -->
        <div id="faq" class="scroll-mt-24 mt-16">
          <h2 class="text-3xl font-black text-gray-900 mb-6">
            13. Frequently Asked Questions
          </h2>

          <div class="space-y-6">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How many gallons of gas does a generator use in a day?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                It depends on size and load. A 2,200-watt inverter at light load might use 2 to 4 gallons over 24 hours, a 4,500-watt inverter perhaps 6 to 10, and an 8,000-watt open frame at half load roughly 14 to 19. Running in cycles, a couple of hours on and a few off, can cut those figures by half or more.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How long can gasoline sit in a generator before it goes bad?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Untreated gasoline can start causing starting problems in small engines within a month or two, especially ethanol blends. With a fuel stabilizer added when the fuel is fresh, labels commonly claim one to two years. In practice, rotate stored fuel every few months, run the generator monthly, and follow the manual on storage.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Can I run a gas generator all night?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Yes, if it is placed safely outdoors, at least 20 feet from the house with exhaust pointed away, has enough fuel, and battery CO alarms are working inside. Never refuel while it runs. Many owners shut it off overnight once the fridge and freezer are cold, or switch to a battery station for overnight loads, saving fuel and keeping neighbors happy.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Is gasoline or dual fuel better for home backup?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Dual fuel is usually the better choice for outage backup because propane stores indefinitely and gives you a second fuel when gasoline is scarce. You lose roughly 10 percent of output on propane. Gasoline-only units are simpler and sometimes cheaper. If you will reliably rotate stabilized gasoline, either works; if not, dual fuel is more forgiving.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">What size gas generator runs a whole house?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Truly whole-house coverage including central air, an electric water heater or electric cooking usually needs 15,000 to 25,000 watts or more, which is standby territory. Large portables of 9,500 to 12,000 running watts can cover most of a house with gas heat through a transfer switch, especially if you manage loads. Essentials-only households need far less.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">How much gasoline can I legally store at home?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Limits are set by local fire codes and vary. Many residential codes cap gasoline in a garage or shed at around 25 gallons in approved containers, and some places are stricter or prohibit storage in attached garages. Check with your local fire department, keep fuel out of the living space, away from ignition sources, and in approved, sealed cans.
              </p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Do gas generators need a transfer switch?</h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                Not if you only run extension cords from the generator to individual appliances. To power hardwired loads like a furnace, well pump or panel circuits, you need a manual transfer switch or listed interlock kit with an inlet, installed by a licensed electrician with a permit. Plugging into a wall or dryer outlet instead is dangerous and illegal.
              </p>
            </div>

          </div>
        </div>

        <!-- Related Guides -->
        <div class="mt-16">
