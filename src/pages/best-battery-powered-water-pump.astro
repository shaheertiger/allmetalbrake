                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Model</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Type</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Power</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Self-priming</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Drinking water</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Milwaukee M18 Transfer Pump 2771-20</td>
                    <td class="px-4 py-4 text-gray-700">Cordless transfer</td>
                    <td class="px-4 py-4 text-gray-700">M18 tool battery</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">No, utility use</td>
                    <td class="px-4 py-4 text-gray-700">Heavy, frequent draining</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">DEWALT 20V MAX Transfer Pump DCE040</td>
                    <td class="px-4 py-4 text-gray-700">Cordless transfer</td>
                    <td class="px-4 py-4 text-gray-700">20V MAX tool battery</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">No, utility use</td>
