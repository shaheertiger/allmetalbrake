const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Battery Powered Water Pump",
          item: "https://www.allmetalbrake.com/best-battery-powered-water-pump/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best battery powered water pump for draining a water heater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A cordless transfer pump on a battery platform you already own. The Milwaukee M18 2771-20, DEWALT DCE040 and Ryobi P750 all connect to a water heater drain valve with a garden hose. Turn the heater off first, let the water cool, use a high-capacity battery, and refill the tank completely before restoring power or gas."
          }
        },
        {
          "@type": "Question",
          "name": "Can a battery operated water pump be used for drinking water?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if it is built and sold for potable use. RV diaphragm pumps like the Shurflo 4008 and SEAFLO 21-Series are designed for fresh-water systems. Cordless transfer pumps and bilge pumps are utility pumps and should not be used for drinking water. Use a drinking-water safe hose too, and keep it separate from drain hoses."
          }
        },
        {
          "@type": "Question",
          "name": "What size 12 volt DC water pump does an RV need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most RVs use a pump around 3 GPM with a pressure rating in the 45 to 55 psi range, such as the Shurflo 4008-101-E65 or the common SEAFLO 21-Series version. Match the replacement to the original pump's flow and pressure where possible, since RV plumbing and fixtures are designed around those typical figures."
          }
        },
        {
          "@type": "Question",
          "name": "How high can a cordless transfer pump lift water?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Less than most buyers expect. Every pump has a practical suction limit, and atmospheric pressure caps suction lift at about 33 feet at sea level, with small pumps managing far less. Flow falls steadily as lift and hose length increase. Keep the pump close to the water surface and let it push rather than pull."
          }
        },
        {
          "@type": "Question",
          "name": "Is a battery powered pump enough for a flooded basement?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a few inches of clean water, a cordless transfer pump or a 12V submersible can help, especially during an outage. For real flooding it is a stopgap. A permanently installed sump pump with a battery backup is the proper fix. Stay out of standing water near outlets or equipment until the power is off."
          }
        },
        {
          "@type": "Question",
          "name": "Can I run a 12V water pump from a portable power station?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if the station has a 12V DC output rated for the pump's current draw. Check the pump's amp rating against the output's limit and use a fused connection. Diaphragm pumps only run while water flows, so their energy use is modest, which makes a power station a practical camp or emergency option."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my RV water pump keep cycling on and off?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "When all taps are closed, a pump that keeps cycling is usually seeing pressure loss from a leak, a dripping faucet or toilet valve, or a worn check valve inside the pump. Check for drips and wet spots first. A clogged inlet strainer can also cause rough running. An accumulator tank reduces cycling during small draws."
