---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/how-long-does-driveway-crack-filler-take-to-dry.html?raw';

const title = "How Long Does Driveway Crack Filler Take to Dry?";
const description = "Fast rubberized fillers can be sealed over in about 1 hour above 65°F; torch rope fillers in 20 minutes; standard fillers need up to 24 hours. Times by filler type.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
