                    <td class="px-4 py-4 text-gray-700">Mostly pro-installed</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Foam insert</td>
                    <td class="px-4 py-4 text-gray-700">Partly</td>
                    <td class="px-4 py-4 text-gray-700">Collects it</td>
                    <td class="px-4 py-4 text-gray-700">Very easy</td>
                    <td class="px-4 py-4 text-gray-700">About $1.50 to $3</td>
