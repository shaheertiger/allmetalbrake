---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Caulking Exterior Windows, Step by Step",
    "url": "/how-to-caulk-exterior-windows/"
  },
  {
    "title": "How Long Does Caulk Take to Dry",
    "url": "/how-long-does-caulk-take-to-dry/"
  },
  {
    "title": "Best Wood Filler",
    "url": "/best-wood-filler/"
  },
  {
    "title": "Best Gutter Guards",
    "url": "/best-gutter-guards/"
  },
  {
    "title": "Best Exterior Wood Sealer",
    "url": "/best-exterior-wood-sealer/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 7 Best Exterior Caulks: Matched to the Joint and Surface";
const description =
  "Seven exterior caulks ranked by movement rating, adhesion and paintability, plus how to pick the right chemistry for siding, trim, brick and windows.";

const PRODUCTS = [
  {
    "id": "dap-dynaflex-230",
    "badge": "Best Overall",
    "category": "Elastomeric Latex Sealant",
    "name": "DAP Dynaflex 230 Premium Elastomeric Sealant",
    "amazonUrl": "",
    "description": "Dynaflex 230 sits in the sweet spot most homeowners need: it handles like an ordinary latex caulk, cleans up with water, and paints well, yet it is formulated as an elastomeric sealant that tolerates far more joint movement than a cheap painter's caulk. That combination is why it shows up on so many contractor trucks for trim-to-siding joints, window and door perimeters and corner boards. DAP markets it with a lifetime durability claim and lists adhesion to the common exterior substrates, including vinyl, aluminum, wood, brick and fiber cement. It is a gun-grade product, so it lays down cleanly from a standard 10.1 oz cartridge in a dripless gun. The tradeoffs are the usual latex ones: it should not sit under standing water, and like any water-based sealant it loses some volume as it cures, so deep gaps need backer rod rather than a fat bead. For a house that is getting painted anyway, this is the default to beat.",
    "pros": [
      "Water cleanup and easy tooling",
      "Paintable with latex or oil paint after a short wait",
      "Stays flexible through freeze-thaw seasons",
      "Bonds to wood, vinyl, aluminum, brick and fiber cement",
      "Sold in many factory colors"
    ],
    "cons": [
      "Not meant for continuous water immersion",
      "Shrinks slightly on deep fills, so use backer rod"
    ],
    "bottomLine": "The one tube that handles most siding, trim and window perimeter joints on a typical house without asking you to change your process."
  },
  {
    "id": "sashco-big-stretch",
    "badge": "Best for Joints That Keep Cracking",
    "category": "Water-Based Elastomeric",
    "name": "Sashco Big Stretch Elastomeric Sealant",
    "amazonUrl": "",
    "description": "Sashco built Big Stretch around one job: staying attached to joints that move a lot. The company markets it on its ability to stretch several times its own width, and owners commonly report it surviving gaps between dissimilar materials, such as wood trim against brick, that tore regular acrylic apart within a season. It is water-based, low odor and paintable, so it fits into a normal repaint schedule. The texture is the catch. It is gummy coming out of the tube and tends to string off the nozzle, so expect a slower, messier session than with Dynaflex, and keep a damp rag and a tooling stick handy. It also shrinks noticeably as it cures in wide joints, which is another reason to fill depth with backer rod. If your trouble spots are a south-facing wall, a log home, or butt joints on long wood boards, the extra hassle buys real durability.",
    "pros": [
      "Exceptional stretch for joints that open and close daily",
      "Paintable and low odor",
      "Good on log homes, siding ends and old wood",
      "Water cleanup",
      "Holds up in hot sun and cold snaps"
    ],
    "cons": [
      "Stringy and sticky to tool",
      "Visible shrinkage on wide, deep joints"
    ],
    "bottomLine": "When a joint keeps cracking open no matter what you put in it, Big Stretch is the tube to try next."
  },
  {
    "id": "osi-quad-advanced",
    "badge": "Best for Trim and Siding",
    "category": "Polymer Sealant",
    "name": "OSI Quad Advanced Formula Window, Door & Siding Sealant",
    "amazonUrl": "",
    "description": "OSI Quad has been a siding-installer standard for years because it bites into substrates that latex caulks struggle with, especially vinyl and coated metal. The Advanced Formula is the current version of that line, positioned for window, door and siding perimeters and sold in a long list of colors meant to match popular siding shades, which matters if you never plan to paint. It is a solvent-style polymer product rather than a water-based one, so tooling is stickier and cleanup takes the solvent the label names rather than a wet rag. In exchange you get a sealant that is less fussy about slightly damp joints and cool mornings than latex, and that keeps its grip on vinyl as the panels slide back and forth with temperature. Read the label for the exact temperature window and cure guidance on the tube you buy, since OSI has updated the formula over time.",
    "pros": [
      "Strong grip on vinyl, fiber cement, aluminum and wood",
      "Paintable",
      "Tolerates damp surfaces better than latex",
      "Long track record with siding installers",
      "Wide color selection matched to siding"
    ],
    "cons": [
      "Harder to tool and clean up than latex",
      "Costs more per tube than everyday caulk"
    ],
    "bottomLine": "Pick it for siding and trim where adhesion to plastics and composites matters more than easy cleanup."
  },
  {
    "id": "ge-advanced-silicone-2-window-door",
    "badge": "Best Pure Silicone",
    "category": "Pure Silicone",
    "name": "GE Advanced Silicone 2 Window & Door Sealant",
    "amazonUrl": "",
    "description": "Pure silicone is still the most weather-proof sealant a homeowner can buy, and GE's Advanced Silicone 2 Window and Door line is the version most hardware stores keep in stock. GE markets it as shrink and crack proof and ready for rain exposure within a short window after application, which is genuinely useful when you are racing weather. It excels on nonporous surfaces: glass to frame, aluminum and vinyl window flanges, metal flashing, and gutter-adjacent trim. The limitations are hard rules, not preferences. Paint will not stick to it, so any joint you plan to paint needs a different product. It also bonds less reliably to raw wood and masonry than a polymer or elastomeric sealant. And once silicone has been used in a joint, its residue resists everything else, so removal before the next recaulk takes real effort. Use it where its strengths count and nowhere else.",
    "pros": [
      "Fully waterproof once cured",
      "Excellent UV and weather resistance",
      "Rain-ready quickly per the label",
      "Stays flexible for many years",
      "Good on glass, metal and nonporous surfaces"
    ],
    "cons": [
      "Cannot be painted",
      "Poor choice on porous wood and masonry",
      "Old silicone residue is hard to remove before recaulking"
    ],
    "bottomLine": "The right answer for glass, metal and anywhere water hits hard, provided the joint will never be painted."
  },
  {
    "id": "geocel-2300",
    "badge": "Best for Metal and Masonry",
    "category": "Solvent-Based Tripolymer Sealant",
    "name": "Geocel 2300 Construction Tripolymer Sealant",
    "amazonUrl": "",
    "description": "Geocel 2300 is the tube contractors reach for when the surface is not ideal. Its tripolymer, solvent-based formula is sold for metal roofing, flashing, masonry and siding joints, and it is known for grabbing onto surfaces that are a little damp, a little chalky or a little oily where a water-based caulk would peel. That makes it a strong fit for brick-to-trim joints, chimney flashing edges, metal outbuildings and seams near gutters. It stays rubbery after cure and accepts paint, though many people leave it in one of its stock colors. The application experience is the price of admission: it smells strongly of solvent, strings off the nozzle and grabs gloves, so plan to work slowly and keep mineral spirits nearby. It is overkill for interior-style trim work and paint touch-ups, but for the stubborn joint that has failed twice already it is worth the extra mess.",
    "pros": [
      "Bonds to damp and slightly dirty surfaces",
      "Very strong on metal, masonry and roofing details",
      "Paintable after cure",
      "Handles large joint movement",
      "Works in cool weather"
    ],
    "cons": [
      "Strong solvent odor",
      "Messy, stringy application",
      "Mineral spirits cleanup"
    ],
    "bottomLine": "A pro-grade problem solver for metal, masonry and roof-edge joints where ordinary caulk will not stay stuck."
  },
  {
    "id": "loctite-polyseamseal",
    "badge": "Best Budget Pick",
    "category": "Acrylic Adhesive Caulk",
    "name": "Loctite Polyseamseal All Purpose Adhesive Caulk",
    "amazonUrl": "",
    "description": "Polyseamseal is a long-running acrylic product that sits between a plain painter's caulk and a premium elastomeric sealant. It has more grip than the cheapest latex tubes, which helps on small gaps where two materials meet, and it cleans up with water and accepts paint like any acrylic. That makes it a reasonable buy for a large number of small, stable joints: nail-hole runs along trim, gaps between window casing and stucco that do not move much, and fixture penetrations. Where it falls short is movement. It is not formulated to stretch the way Dynaflex, Big Stretch or the polymer sealants do, so on long butt joints, wide corner boards or anything on a sunny wall that cycles hard it will crack sooner. Use it to stretch a budget on the easy joints and spend the savings on a premium tube for the hard ones.",
    "pros": [
      "Low price per tube",
      "Easy water cleanup",
      "Paintable",
      "Adhesive strength helps on small gaps between dissimilar materials"
    ],
    "cons": [
      "Less movement capacity than true elastomeric sealants",
      "Not the choice for large or high-stress joints"
    ],
    "bottomLine": "A sensible low-cost tube for small, low-movement gaps you will paint, not for siding butt joints."
  },
  {
    "id": "dap-alex-plus",
    "badge": "Best for Painted Trim Touch-Ups",
    "category": "Siliconized Latex Caulk",
    "name": "DAP Alex Plus Acrylic Latex Caulk Plus Silicone",
    "amazonUrl": "",
    "description": "Alex Plus is the caulk most people already own, and it earns a place on this list with a narrow brief. It is cheap, tools to a smooth, paint-ready finish with a wet finger, and it is fine for cosmetic gaps on painted exterior trim: the hairline between a casing and its backband, nail holes on fascia, or a short miter that never moves. DAP labels it for interior and exterior use and the silicone additive improves flexibility and adhesion over a plain acrylic. What it cannot do is serve as the primary weather seal on a joint that works. Owners who use it on siding butt joints, long horizontal trim runs or a south wall commonly see cracking within a season or two, and that is the product behaving as designed, not a bad batch. Keep a tube for prep and touch-ups, and reach for an elastomeric sealant for everything that actually keeps water out.",
    "pros": [
      "Inexpensive and stocked everywhere",
      "Very easy to tool smooth",
      "Paints quickly",
      "Fine for narrow, stable gaps"
    ],
    "cons": [
      "Limited movement capacity outdoors",
      "Cracks early on sunny walls and long joints",
      "Not a primary weather seal"
    ],
    "bottomLine": "Good for cosmetic gaps on painted trim, not a substitute for a real exterior sealant on joints that move."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Exterior Caulk",
          item: "https://www.allmetalbrake.com/best-exterior-caulk/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which caulk should most homeowners buy for outdoor joints?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most painted homes, an elastomeric latex sealant such as DAP Dynaflex 230 is the best all-around choice. It cleans up with water, accepts paint, bonds to the common siding and trim materials and handles far more joint movement than ordinary acrylic caulk. Switch to a polymer for vinyl and masonry, or silicone for glass and metal that will never be painted."
          }
        },
        {
          "@type": "Question",
          "name": "Is silicone or latex better for exterior joints?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on whether the joint will be painted. Silicone is more waterproof and UV-stable, but paint will not stick to it and it grips porous wood and masonry poorly. Elastomeric latex is paintable, easy to work with and flexible enough for most siding and trim. For painted wood, choose latex. For glass, aluminum and unpainted metal, choose silicone."
          }
        },
        {
          "@type": "Question",
          "name": "What service life can I expect from an outdoor sealant?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plain acrylic caulk on a sunny wall can fail within a few years. A quality elastomeric latex protected by paint commonly lasts much longer, and many silicone and polymer sealants carry multi-decade durability claims on the label. Those claims assume proper joint design, backer rod where needed and a bead laid on clean, bare surfaces, so preparation matters as much as the product."
          }
        },
        {
          "@type": "Question",
          "name": "Can I caulk exterior joints in cold weather?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most water-based caulks list a minimum application temperature around 40 degrees Fahrenheit for both air and surface, and they must stay above freezing while they skin over. Some polymer and solvent-based sealants are labeled for colder conditions. Check the tube, measure the surface temperature on shaded walls, and avoid caulking when frost or dew is likely before the bead skins."
          }
        },
        {
          "@type": "Question",
          "name": "What caulk works on vinyl siding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Vinyl moves a lot with temperature and has a slick surface, so a polymer sealant such as OSI Quad is the usual choice. It grips vinyl well, stays flexible and comes in colors matched to common siding shades. Do not caulk the overlaps where vinyl panels lock together; they are designed to slide and to drain, and sealing them causes buckling."
          }
        },
        {
          "@type": "Question",
          "name": "Should I use caulk on brick?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use a polymer or tripolymer sealant, not acrylic, where brick meets wood trim, windows or doors. Products such as Geocel 2300 grip porous, slightly damp masonry well and handle the movement between dissimilar materials. Wire-brush loose material from the edges first. Never seal brick weep holes, and repair cracked mortar joints with mortar rather than caulk."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need backer rod for every joint?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Joints a quarter inch wide or narrower and shallow joints usually need no rod. Any joint deeper than about half its width should get closed-cell foam backer rod so the sealant ends up about half as deep as it is wide. Where rod will not fit, bond-breaker tape at the bottom of the joint prevents three-sided adhesion."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Caulk & Exterior Repair",
    tags: [
      "best exterior caulk",
      "exterior sealant",
      "elastomeric caulk",
      "silicone caulk outdoors",
      "siding caulk",
      "window caulk"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Exterior Caulks</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          The right tube depends on what the joint is doing: how much it moves, what it touches, and whether it gets painted. Here is how to match all three.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#dap-dynaflex-230"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Shaheer Ali Khan</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Consumer Product Testing &amp; Materials Performance Specialist</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#chemistry" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The Five Chemistries</a>
          <a href="#label" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Reading the Label</a>
          <a href="#surface" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Match the Surface</a>
          <a href="#climate" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Climate and Temperature</a>
          <a href="#joint-design" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Joint Size and Backer Rod</a>
          <a href="#application" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Laying a Bead That Lasts</a>
          <a href="#cure-paint" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Curing and Painting</a>
          <a href="#cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Cost and Coverage</a>
          <a href="#maintenance" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. When to Recaulk</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most exterior caulk failures are not product failures. They are the wrong chemistry in the wrong joint: a stiff painter's caulk across a siding butt joint that grows and shrinks every season, or straight silicone on trim that was always going to be painted. Pick the sealant by the joint's movement and surface first, and brand second.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Best Exterior Caulks, Ranked
          </h2>

          <p>
            These picks are ranked on what the manufacturers publish and stand behind: ASTM movement class, rated substrates, application temperature range, paintability and warranty, cross-checked against the patterns that show up repeatedly in owner feedback. No lab rig, no invented scores; where a spec is not published, we say so or leave it out.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} index={index} />
          ))}
        </div>

        <div id="chemistry" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Five Chemistries, and Where Each One Belongs
          </h2>

          <p>
            Every exterior caulk on the shelf belongs to one of a handful of chemical families, and the family tells you more than the brand does. The words on the front of the tube are marketing; the chemistry in the fine print decides whether the bead can stretch, whether paint will stick to it, and what it will grab onto. Learn the five families below and you can walk into any store and pick the right product in a minute.
          </p>

          <p>
            <strong>Acrylic latex</strong> is the cheapest and easiest. It cleans up with water, tools smooth, and paints within an hour or two. Its weakness is movement: most plain latex caulks are rated for low single-digit percentages of joint movement, which is fine for interior trim and poor for siding. <strong>Elastomeric latex</strong>, such as Dynaflex 230 and Big Stretch, keeps the water cleanup but stretches several times further, which is why it is the default for painted exterior joints.
          </p>

          <p>
            <strong>Silicone</strong> is the most waterproof and UV-stable family and also the least cooperative: it cannot be painted and it bonds poorly to porous wood and masonry. <strong>Polymer and hybrid sealants</strong> (polyurethane, MS polymer, the OSI Quad line, tripolymers like Geocel 2300) combine strong adhesion with paintability and good movement. They are harder to clean up and cost more, but they are the professional choice on vinyl, fiber cement, metal and masonry.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Chemistry</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical movement</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Paintable</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cleanup</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best use</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Acrylic latex</td>
                    <td class="px-4 py-4 text-gray-700">Low</td>
                    <td class="px-4 py-4 text-gray-700">Yes, fast</td>
                    <td class="px-4 py-4 text-gray-700">Water</td>
                    <td class="px-4 py-4 text-gray-700">Stable painted trim gaps</td>
                  </tr>
