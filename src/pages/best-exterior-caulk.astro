---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Caulking Exterior Windows, Step by Step",
    "url": "/how-to-caulk-exterior-windows/"
  },
  {
    "title": "How Long Does Caulk Take to Dry",
    "url": "/how-long-does-caulk-take-to-dry/"
  },
  {
    "title": "Best Wood Filler",
    "url": "/best-wood-filler/"
  },
  {
    "title": "Best Gutter Guards",
    "url": "/best-gutter-guards/"
  },
  {
    "title": "Best Exterior Wood Sealer",
    "url": "/best-exterior-wood-sealer/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "7 Best Exterior Caulks (2026): Matched to Joint and Surface";
const description =
  "DAP Dynaflex 230 is the best exterior caulk for most painted homes; 7 picks sorted by movement rating, adhesion and paintability on siding, trim and brick.";

const PRODUCTS = [
  {
    "id": "dap-dynaflex-230",
    "badge": "Best Overall",
    "category": "Elastomeric Latex Sealant",
    "name": "DAP Dynaflex 230 Premium Elastomeric Sealant",
    "amazonUrl": "",
    "description": "Dynaflex 230 sits in the sweet spot most homeowners need: it handles like an ordinary latex caulk, cleans up with water, and paints well, yet it is formulated as an elastomeric sealant that tolerates far more joint movement than a cheap painter's caulk. That combination is why it shows up on so many contractor trucks for trim-to-siding joints, window and door perimeters and corner boards. DAP markets it with a lifetime durability claim and lists adhesion to the common exterior substrates, including vinyl, aluminum, wood, brick and fiber cement. It is a gun-grade product, so it lays down cleanly from a standard 10.1 oz cartridge in a dripless gun. The tradeoffs are the usual latex ones: it should not sit under standing water, and like any water-based sealant it loses some volume as it cures, so deep gaps need backer rod rather than a fat bead. For a house that is getting painted anyway, this is the default to beat.",
    "pros": [
      "Water cleanup and easy tooling",
      "Paintable with latex or oil paint after a short wait",
      "Stays flexible through freeze-thaw seasons",
      "Bonds to wood, vinyl, aluminum, brick and fiber cement",
      "Sold in many factory colors"
    ],
    "cons": [
      "Not meant for continuous water immersion",
      "Shrinks slightly on deep fills, so use backer rod"
    ],
    "bottomLine": "The one tube that handles most siding, trim and window perimeter joints on a typical house without asking you to change your process."
  },
  {
    "id": "sashco-big-stretch",
    "badge": "Best for Joints That Keep Cracking",
    "category": "Water-Based Elastomeric",
    "name": "Sashco Big Stretch Elastomeric Sealant",
    "amazonUrl": "",
    "description": "Sashco built Big Stretch around one job: staying attached to joints that move a lot. The company markets it on its ability to stretch several times its own width, and owners commonly report it surviving gaps between dissimilar materials, such as wood trim against brick, that tore regular acrylic apart within a season. It is water-based, low odor and paintable, so it fits into a normal repaint schedule. The texture is the catch. It is gummy coming out of the tube and tends to string off the nozzle, so expect a slower, messier session than with Dynaflex, and keep a damp rag and a tooling stick handy. It also shrinks noticeably as it cures in wide joints, which is another reason to fill depth with backer rod. If your trouble spots are a south-facing wall, a log home, or butt joints on long wood boards, the extra hassle buys real durability.",
    "pros": [
      "Exceptional stretch for joints that open and close daily",
      "Paintable and low odor",
      "Good on log homes, siding ends and old wood",
      "Water cleanup",
      "Holds up in hot sun and cold snaps"
    ],
    "cons": [
      "Stringy and sticky to tool",
      "Visible shrinkage on wide, deep joints"
    ],
    "bottomLine": "When a joint keeps cracking open no matter what you put in it, Big Stretch is the tube to try next."
  },
  {
    "id": "osi-quad-advanced",
    "badge": "Best for Trim and Siding",
    "category": "Polymer Sealant",
    "name": "OSI Quad Advanced Formula Window, Door & Siding Sealant",
    "amazonUrl": "",
    "description": "OSI Quad has been a siding-installer standard for years because it bites into substrates that latex caulks struggle with, especially vinyl and coated metal. The Advanced Formula is the current version of that line, positioned for window, door and siding perimeters and sold in a long list of colors meant to match popular siding shades, which matters if you never plan to paint. It is a solvent-style polymer product rather than a water-based one, so tooling is stickier and cleanup takes the solvent the label names rather than a wet rag. In exchange you get a sealant that is less fussy about slightly damp joints and cool mornings than latex, and that keeps its grip on vinyl as the panels slide back and forth with temperature. Read the label for the exact temperature window and cure guidance on the tube you buy, since OSI has updated the formula over time.",
    "pros": [
      "Strong grip on vinyl, fiber cement, aluminum and wood",
      "Paintable",
      "Tolerates damp surfaces better than latex",
      "Long track record with siding installers",
      "Wide color selection matched to siding"
    ],
    "cons": [
      "Harder to tool and clean up than latex",
      "Costs more per tube than everyday caulk"
    ],
    "bottomLine": "Pick it for siding and trim where adhesion to plastics and composites matters more than easy cleanup."
  },
  {
    "id": "ge-advanced-silicone-2-window-door",
    "badge": "Best Pure Silicone",
    "category": "Pure Silicone",
    "name": "GE Advanced Silicone 2 Window & Door Sealant",
    "amazonUrl": "",
    "description": "Pure silicone is still the most weather-proof sealant a homeowner can buy, and GE's Advanced Silicone 2 Window and Door line is the version most hardware stores keep in stock. GE markets it as shrink and crack proof and ready for rain exposure within a short window after application, which is genuinely useful when you are racing weather. It excels on nonporous surfaces: glass to frame, aluminum and vinyl window flanges, metal flashing, and gutter-adjacent trim. The limitations are hard rules, not preferences. Paint will not stick to it, so any joint you plan to paint needs a different product. It also bonds less reliably to raw wood and masonry than a polymer or elastomeric sealant. And once silicone has been used in a joint, its residue resists everything else, so removal before the next recaulk takes real effort. Use it where its strengths count and nowhere else.",
    "pros": [
      "Fully waterproof once cured",
      "Excellent UV and weather resistance",
      "Rain-ready quickly per the label",
      "Stays flexible for many years",
      "Good on glass, metal and nonporous surfaces"
    ],
    "cons": [
      "Cannot be painted",
      "Poor choice on porous wood and masonry",
      "Old silicone residue is hard to remove before recaulking"
    ],
    "bottomLine": "The right answer for glass, metal and anywhere water hits hard, provided the joint will never be painted."
  },
  {
    "id": "geocel-2300",
    "badge": "Best for Metal and Masonry",
    "category": "Solvent-Based Tripolymer Sealant",
    "name": "Geocel 2300 Construction Tripolymer Sealant",
    "amazonUrl": "",
    "description": "Geocel 2300 is the tube contractors reach for when the surface is not ideal. Its tripolymer, solvent-based formula is sold for metal roofing, flashing, masonry and siding joints, and it is known for grabbing onto surfaces that are a little damp, a little chalky or a little oily where a water-based caulk would peel. That makes it a strong fit for brick-to-trim joints, chimney flashing edges, metal outbuildings and seams near gutters. It stays rubbery after cure and accepts paint, though many people leave it in one of its stock colors. The application experience is the price of admission: it smells strongly of solvent, strings off the nozzle and grabs gloves, so plan to work slowly and keep mineral spirits nearby. It is overkill for interior-style trim work and paint touch-ups, but for the stubborn joint that has failed twice already it is worth the extra mess.",
    "pros": [
      "Bonds to damp and slightly dirty surfaces",
      "Very strong on metal, masonry and roofing details",
      "Paintable after cure",
      "Handles large joint movement",
      "Works in cool weather"
    ],
    "cons": [
      "Strong solvent odor",
      "Messy, stringy application",
      "Mineral spirits cleanup"
    ],
    "bottomLine": "A pro-grade problem solver for metal, masonry and roof-edge joints where ordinary caulk will not stay stuck."
  },
  {
    "id": "loctite-polyseamseal",
    "badge": "Best Budget Pick",
    "category": "Acrylic Adhesive Caulk",
    "name": "Loctite Polyseamseal All Purpose Adhesive Caulk",
    "amazonUrl": "",
    "description": "Polyseamseal is a long-running acrylic product that sits between a plain painter's caulk and a premium elastomeric sealant. It has more grip than the cheapest latex tubes, which helps on small gaps where two materials meet, and it cleans up with water and accepts paint like any acrylic. That makes it a reasonable buy for a large number of small, stable joints: nail-hole runs along trim, gaps between window casing and stucco that do not move much, and fixture penetrations. Where it falls short is movement. It is not formulated to stretch the way Dynaflex, Big Stretch or the polymer sealants do, so on long butt joints, wide corner boards or anything on a sunny wall that cycles hard it will crack sooner. Use it to stretch a budget on the easy joints and spend the savings on a premium tube for the hard ones.",
    "pros": [
      "Low price per tube",
      "Easy water cleanup",
      "Paintable",
      "Adhesive strength helps on small gaps between dissimilar materials"
    ],
    "cons": [
      "Less movement capacity than true elastomeric sealants",
      "Not the choice for large or high-stress joints"
    ],
    "bottomLine": "A sensible low-cost tube for small, low-movement gaps you will paint, not for siding butt joints."
  },
  {
    "id": "dap-alex-plus",
    "badge": "Best for Painted Trim Touch-Ups",
    "category": "Siliconized Latex Caulk",
    "name": "DAP Alex Plus Acrylic Latex Caulk Plus Silicone",
    "amazonUrl": "",
    "description": "Alex Plus is the caulk most people already own, and it earns a place on this list with a narrow brief. It is cheap, tools to a smooth, paint-ready finish with a wet finger, and it is fine for cosmetic gaps on painted exterior trim: the hairline between a casing and its backband, nail holes on fascia, or a short miter that never moves. DAP labels it for interior and exterior use and the silicone additive improves flexibility and adhesion over a plain acrylic. What it cannot do is serve as the primary weather seal on a joint that works. Owners who use it on siding butt joints, long horizontal trim runs or a south wall commonly see cracking within a season or two, and that is the product behaving as designed, not a bad batch. Keep a tube for prep and touch-ups, and reach for an elastomeric sealant for everything that actually keeps water out.",
    "pros": [
      "Inexpensive and stocked everywhere",
      "Very easy to tool smooth",
      "Paints quickly",
      "Fine for narrow, stable gaps"
    ],
    "cons": [
      "Limited movement capacity outdoors",
      "Cracks early on sunny walls and long joints",
      "Not a primary weather seal"
    ],
    "bottomLine": "Good for cosmetic gaps on painted trim, not a substitute for a real exterior sealant on joints that move."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Exterior Caulk",
          item: "https://www.allmetalbrake.com/best-exterior-caulk/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which caulk should most homeowners buy for outdoor joints?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On most painted houses, an elastomeric latex sealant such as DAP Dynaflex 230 is the best all-around choice. It cleans up with water, takes paint, grips the usual siding and trim materials and handles far more joint movement than ordinary acrylic caulk. Move to a polymer for vinyl and masonry, or to silicone for glass and metal that will never be painted."
          }
        },
        {
          "@type": "Question",
          "name": "Is silicone or latex better for exterior joints?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "That turns on whether the joint will be painted. Silicone is more waterproof and more UV-stable, but paint will not bond to it and it holds poorly on porous wood and masonry. Elastomeric latex takes paint, is easy to work and flexes enough for most siding and trim. Choose latex for painted wood, and silicone for glass, aluminum and unpainted metal."
          }
        },
        {
          "@type": "Question",
          "name": "What service life can I expect from an outdoor sealant?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plain acrylic caulk on a sunny wall can fail inside a few years. A quality elastomeric latex protected by paint commonly lasts much longer, and many silicone and polymer sealants carry multi-decade durability claims on the label. Those claims assume sound joint design, backer rod where it is needed and a bead laid on clean, bare surfaces, so prep matters as much as the tube you pick."
          }
        },
        {
          "@type": "Question",
          "name": "Can I caulk exterior joints in cold weather?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most water-based caulks list a minimum application temperature of about 40 degrees Fahrenheit, for the surface as well as the air, and they need to stay above freezing until they skin over. Some polymer and solvent-based sealants are labeled for colder conditions. Read the tube, check the surface temperature on shaded walls, and hold off when frost or dew may arrive before the bead skins."
          }
        },
        {
          "@type": "Question",
          "name": "What caulk works on vinyl siding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Vinyl moves a lot with temperature and has a slick face, so a polymer sealant such as OSI Quad is the usual choice. It holds vinyl well, stays flexible and comes in colors matched to common siding shades. Leave the overlaps where vinyl panels lock together uncaulked; they are built to slide and to drain, and sealing them makes the siding buckle."
          }
        },
        {
          "@type": "Question",
          "name": "Should I use caulk on brick?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Where brick meets wood trim, windows or doors, use a polymer or tripolymer sealant rather than acrylic. Products such as Geocel 2300 hold porous, slightly damp masonry well and cope with the movement between unlike materials. Wire-brush loose material off the edges first. Never seal brick weep holes, and repair cracked mortar joints with mortar, not caulk."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need backer rod for every joint?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Joints a quarter inch wide or narrower, and shallow joints, usually need no rod. Any joint deeper than about half its width should get closed-cell foam backer rod so the sealant ends up roughly half as deep as it is wide. Where rod will not fit, bond-breaker tape along the bottom of the joint prevents three-sided adhesion."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Caulk & Exterior Repair",
    tags: [
      "best exterior caulk",
      "exterior sealant",
      "elastomeric caulk",
      "silicone caulk outdoors",
      "siding caulk",
      "window caulk"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The 7 Best Exterior Caulks in 2026
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          DAP Dynaflex 230 is the best exterior caulk for most painted houses. What changes the pick is the joint itself: how far it moves, which materials it bridges and whether paint will ever cover it. Below are seven picks with the chemistry, movement and paintability of each, plus joint sizing, cold-weather limits, cure and paint timing, and how many tubes to buy.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/shaheer-ali-khan/" class="font-bold text-gray-900 no-underline hover:underline">Shaheer Ali Khan</a></p>
            <p class="text-xs text-gray-500 m-0">Materials &amp; Product Performance Specialist &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          Based on manufacturer-published ASTM movement class, rated substrates, temperature range and warranty, plus owner feedback. Not hands-on tested. No paid placements. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">13 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>Best Caulk for Each Joint</span></a>
              <a href="#short-answer" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>The Short Answer</span></a>
              <a href="#chemistry" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Best Type for Outdoors</span></a>
              <a href="#label" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Reading the Label</span></a>
              <a href="#surface" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>Wood, Vinyl, Brick, Metal</span></a>
              <a href="#climate" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>How Cold Is Too Cold</span></a>
              <a href="#joint-design" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Depth and Backer Rod</span></a>
              <a href="#application" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>How to Caulk So It Lasts</span></a>
              <a href="#cure-paint" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>Rain and Paint Times</span></a>
              <a href="#cost" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Tubes and Cost</span></a>
              <a href="#maintenance" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>Lifespan and Recaulking</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">12.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">13.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          When an outdoor bead fails, the tube is rarely to blame. Far more often the chemistry was wrong for the joint: a stiff painter's caulk stretched across a siding butt joint that swells and shrinks every season, or straight silicone run along trim that was always going to get painted. Choose by what the joint does and what it touches first, and by brand last.
        </p>

        <QuickPicks products={PRODUCTS} />

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Best Exterior Caulks in 2026, Ranked
          </h2>

          <p>
            Start with Dynaflex 230 for general painted work, then move down the list as the joint gets harder, the surface gets slicker or the paint plan disappears. The seven tubes are ordered by how many joints on a typical house each one handles well, so the lower picks are specialists rather than weaker products.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">How we chose these picks</h3>

          <p>
            We ranked the tubes on what their makers publish and stand behind: ASTM movement class, rated substrates, application temperature range, paintability and warranty. Those claims were then cross-checked against the problems that come up again and again in owner feedback. Nothing here went through a lab rig and no scores were made up; where a maker does not publish a spec, we say so or leave it out.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} index={index} />
          ))}
        </div>

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Best Exterior Caulk: The Short Answer
          </h2>

