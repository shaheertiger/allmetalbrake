---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/epoxy-vs-polyaspartic-garage-floor.html?raw';

const title = "Epoxy vs Polyaspartic Garage Floor: Which Should You Use?";
const description = "Epoxy builds and bonds; polyaspartic resists UV, scuffs and hot tires and cures in a day. Cost, pot life, cure times and when the hybrid system wins.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
