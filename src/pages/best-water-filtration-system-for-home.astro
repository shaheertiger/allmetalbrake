const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Water Filtration Systems for Home",
          item: "https://www.allmetalbrake.com/best-water-filtration-system-for-home/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best whole house water filtration system for home use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most homeowners on municipal water, the SpringWell CF1 offers the best balance of filtration performance, flow rate, and low maintenance. It uses a three-stage sediment and carbon design that handles chlorine, chloramine, and sediment while maintaining strong water pressure. Well-water households should look at a system with UV purification, like the SpringWell WS4, since municipal disinfection is not present in well water.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need a whole-house filter if I already have a water softener?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, they solve different problems. A water softener removes calcium and magnesium minerals that cause hardness, scale buildup, and soap scum, but it does not remove chlorine, sediment, lead, or other contaminants. A whole-house water filtration system handles filtration while a softener handles hardness. Many homes with hard water and contamination concerns run both in sequence. See our best water softener system guide for hardness-specific recommendations.",
          },
        },
        {
          "@type": "Question",
          name: "How much does it cost to install a whole-house water filtration system?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Budget carbon systems start around $300 to $500 for the unit alone, while premium tank-style systems with backwashing run $1,000 to $1,800. Professional installation typically adds $150 to $600 depending on your plumbing layout, drain access, and whether a bypass valve and pressure regulator need to be added. Under-sink and countertop systems are far cheaper, generally $150 to $400 total including any installation.",
          },
        },
        {
          "@type": "Question",
          name: "Will a whole-house water filter reduce my water pressure?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "It can, if the system's flow rate (measured in GPM) is undersized for your household's peak demand. A system rated for 6 GPM will noticeably choke water pressure in a home where two showers and a washing machine commonly run at once. Match the system's rated GPM to your home's fixture count and peak simultaneous usage, and favor systems rated 10 GPM or higher for larger households.",
          },
        },
        {
          "@type": "Question",
          name: "Is reverse osmosis necessary for a whole-house system, or should I just get an under-sink unit?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "True whole-house reverse osmosis is rare and expensive because RO membranes are inherently slow, making high-flow-rate whole-house RO systems large and costly. For nearly all homes, an under-sink reverse osmosis system treating drinking and cooking water is the practical choice, paired with a separate whole-house sediment and carbon filter for the rest of the house.",
          },
        },
        {
          "@type": "Question",
          name: "How do I know what contaminants are actually in my water before buying a filter?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Municipal water customers can request their utility's annual Consumer Confidence Report, which lists tested contaminant levels. Well water owners should get an independent lab water test at least once a year, checking for bacteria, nitrates, iron, manganese, arsenic, and pH at minimum. Buying a filtration system before testing your water is the most common mistake homeowners make in this category.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "Home Fix Reviews" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
      review: {
        "@type": "Review",
        reviewBody: product.bottomLine,
        author: authorSchema(Astro.url.pathname),
        publisher: { "@type": "Organization", name: "Home Fix Reviews" },
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Improvement",
    tags: [
      "water filtration system",
      "whole house water filter",
      "home water filtration system",
      "under sink water filter",
      "reverse osmosis system",
      "well water filter",
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
      ></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated August 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Water Filtration Systems</span> for Home in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          We tested whole-house sediment and carbon systems, well-water UV setups, under-sink reverse osmosis units, and countertop options for renters. Here's what actually removes what's in your water — and what's a waste of money.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#springwell-cf1"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#whats-in-water"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Test Your Water First
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Shaheer Ali Khan</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Consumer Product Testing &amp; Materials Performance Specialist</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
