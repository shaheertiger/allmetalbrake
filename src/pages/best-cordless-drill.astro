        "Max Torque (Makita rating)",
        "1,250 in-lbs"
      ],
      [
        "Speed",
        "0-550 / 0-2,100 RPM"
      ],
      [
        "Blows per Minute",
        "0-8,250 / 0-31,500 BPM"
      ],
      [
        "Chuck",
