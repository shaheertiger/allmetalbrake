const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Cordless Drill",
          item: "https://www.allmetalbrake.com/best-cordless-drill/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best cordless drill for home use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homeowners, a compact brushless 18V or 20V drill/driver is the best choice. The DeWalt DCD800 is our pick for home use because it is light, compact and on a huge platform. If budget matters more, the Ryobi PBLDD01 gives you a brushless motor and Ryobi's wide ONE+ range for less money, and it handles typical home projects easily."
          }
        },
        {
          "@type": "Question",
          "name": "Is Milwaukee or DeWalt better for a cordless drill?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both make excellent drills, and the difference between their flagship drill/drivers is smaller than the difference between their battery platforms. Milwaukee has the deeper compact M12 line; DeWalt has broad availability and many kit bundles. Our Milwaukee vs DeWalt guide compares batteries, warranty and tool range so you can choose the platform before the drill."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a hammer drill or a regular drill?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You only need a hammer drill if you drill into brick, block, mortar or concrete. For wood, metal, drywall and plastic, a regular drill/driver is lighter and works just as well. A hammer drill can do both, so it is a good single drill if you anchor into masonry a few times a year, but it is heavier."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 12V drill strong enough?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For furniture, cabinets, electrical work, hanging fixtures and most household repairs, yes. A good 12V drill like the Milwaukee M12 FUEL 3403-20 is rated at 400 in-lbs and keeps a 1/2-inch chuck. It is slower with large spade bits and hole saws and its small batteries drain faster, so choose 18V or 20V if you build decks or bore large holes."
          }
        },
        {
          "@type": "Question",
          "name": "What does UWO mean on a DeWalt drill?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "UWO stands for Unit Watts Out, a power rating DeWalt uses instead of a torque figure on many of its drills. It combines speed and torque into one number and is useful for comparing DeWalt drills with each other. It cannot be compared directly with the in-lbs torque figures that Milwaukee, Makita, Ryobi and Bosch publish."
          }
        },
        {
          "@type": "Question",
          "name": "How much torque do I need in a cordless drill?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Less than the marketing suggests. Driving screws and drilling holes up to about 1 inch in wood needs only a modest amount, which every drill on this list provides. Torque matters for large hole saws, self-feed bits and auger bits. Because brands rate torque differently, compare figures only within one brand, and buy a full-size 18V drill if you regularly use large bits."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy a drill and impact driver combo kit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually yes, if you plan to do any building, decking or furniture assembly. Combo kits on one platform often cost only a little more than the drill kit alone and include two batteries and a charger. The impact driver handles long screws and lag bolts that would strain a drill, while the drill stays set up for holes."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Hand Tools",
    tags: [
      "best cordless drill",
      "cordless drill",
      "best drill driver",
      "cordless power drill",
      "best hammer drill",
      "brushless drill"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The Best Cordless Drills
        </h1>
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          Seven drill/drivers from Milwaukee, DeWalt, Makita, Ryobi and Bosch, each matched to a job and a battery platform, with the specs the makers actually publish.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

