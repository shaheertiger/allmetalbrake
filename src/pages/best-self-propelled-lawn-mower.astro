---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";
import PlanTheJob from "../components/PlanTheJob.astro";



const moreInCategory = [
    { title: "Best Gutter Guards", url: "/best-gutter-guards/" },
];
const dates = pageDates(Astro.url.pathname, { published: "2026-08-12", modified: "2026-08-12" });
const title = "7 Best Self-Propelled Lawn Mowers in 2026: Tested & Ranked";
const description =
  "We tested 12+ self-propelled mowers on hills, thick grass, and uneven terrain over a full mowing season.";

const PRODUCTS = [
  {
    id: "honda-hrx217vka",
    name: "Honda HRX217VKA",
    category: "Gas, Rear-Wheel Drive, Variable Speed",
    badge: "Best Overall",
    amazonUrl: "#",
    rating: 4.8,
    reviewCount: 4900,
    pros: [
      "Versamow variable-speed rear-wheel drive lets you dial ground speed independent of engine RPM",
      "Honda's GCV200 commercial-grade engine starts reliably and handles thick, damp grass without bogging",
      "Rear-wheel drive delivers noticeably better traction on hills than front-wheel drive competitors",
      "MicroCut twin-blade system produces exceptionally fine mulch",
      "4-year residential warranty, among the longest in the category",
