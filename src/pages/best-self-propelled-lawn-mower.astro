---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Zero-Turn Mowers",
    "url": "/best-zero-turn-mower/"
  },
  {
    "title": "Best Riding Lawn Mowers",
    "url": "/best-riding-lawn-mower/"
  },
  {
    "title": "Best Gas Lawn Mowers",
    "url": "/best-gas-lawn-mowers/"
  },
  {
    "title": "Best Lawn Mowers for Small Yards",
    "url": "/best-lawn-mower-for-small-yard/"
  },
  {
    "title": "Best Compact Tractors",
    "url": "/best-compact-tractor/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "6 Best Self Propelled Lawn Mowers (2026): Picked by Drive Type";
const description =
  "The Toro Recycler 22-inch Personal Pace is the best self propelled lawn mower for most yards; 6 picks by front, rear or all-wheel drive, gas or battery.";

const PRODUCTS = [
  {
    "id": "toro-recycler-smartstow",
    "name": "Toro Recycler 22-Inch Personal Pace SmartStow",
    "category": "Gas | FWD | Personal Pace",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "Personal Pace drive matches your walking speed without a dial",
      "22-inch deck covers a little more ground per pass than 21-inch rivals",
      "Folds and stands upright on its end for garage storage",
      "Toro dealer and big-box parts network is wide",
      "Vortex-style recycling deck mulches well in normal growth"
    ],
    "cons": [
      "Front-wheel drive loses grip going uphill with a full bag",
      "Steel deck needs to be kept clean and dry to resist rust"
    ],
    "bottomLine": "The easiest self-propelled gas mower to live with on a flat-to-gently-rolling lot up to about half an acre.",
    "description": "The reason this Toro leads the list is its Personal Pace drive. There is no lever and no separate speed dial; the mower reads how firmly you push on the handle, easing off when you slow at a flowerbed edge and picking up on a long straight stretch. Owners commonly call it the least fussy drive in its class. The 22-inch steel deck is a touch wider than the usual 21 inches, which saves a few passes on a typical suburban lot, and the recycling deck is shaped to hold clippings up long enough to chop them fine. SmartStow lets the mower stand on its rear for storage without draining fuel or oil, which frees real floor space in a one-car garage. The catch is front-wheel drive: on a steep bank, especially with the rear bag loaded, the front wheels lose weight and slip. On flat or mildly rolling ground that never comes up, and the price usually lands in the middle of the gas market."
  },
  {
    "id": "ego-power-lm2135sp-self-propelled",
    "name": "EGO Power+ LM2135SP 21-Inch Select Cut",
    "category": "56V Battery | RWD | Dial Speed",
    "badge": "Top Battery Pick",
    "amazonUrl": "",
    "pros": [
      "Rear-wheel drive keeps traction on slopes and with a full bag",
      "Select Cut stacked blades give a clean cut and fine mulch",
      "No oil, gas, spark plug or carburetor to maintain",
      "Batteries swap across EGO's 56V tool line",
      "Folds compactly and starts with a button"
    ],
    "cons": [
      "Runtime drops quickly in tall, wet grass",
      "Spare batteries are expensive"
    ],
    "bottomLine": "The battery mower that comes closest to replacing a good gas self-propelled on a sloped quarter-acre lot.",
    "description": "The LM2135SP combines EGO's 56-volt platform with rear-wheel drive, the right layout for anyone who mows uphill. As you climb, and as the bag fills, weight moves backward onto the rear drive wheels, so they keep biting where front-drive mowers begin to spin. Select Cut stacks two blades on one spindle, and the lower blade can be swapped for a mulching or high-lift version to suit the season. Owners commonly report a clean result in thick spring grass when they slow down and raise the deck a notch. Runtime is the compromise. EGO rates the kit battery for a typical suburban lot, but the real figure drops in long, damp growth because the motor works harder under load, so plan on a second battery if your lawn is over a third of an acre. Otherwise ownership is simple: no winterizing, no fuel stabilizer and no pull cord. The steel-framed polymer deck will not rust, and with the optional bracket the mower folds flat to hang on a wall."
  },
  {
    "id": "toro-timemaster-30",
    "name": "Toro TimeMaster 30-Inch Personal Pace",
    "category": "Gas | RWD | 30-Inch Deck",
    "badge": "Best for Large Yards",
    "amazonUrl": "",
    "pros": [
      "30-inch deck cuts roughly 40 percent more per pass than a 21-inch",
      "Rear-wheel drive with Personal Pace speed control",
      "Dual-blade system for cleaner cut across the wide deck",
      "Commercial-style build for a residential walk-behind",
      "Fits through gates a riding mower cannot"
    ],
    "cons": [
      "Heavy and harder to turn in tight beds",
      "Costs about as much as an entry lawn tractor"
    ],
    "bottomLine": "The walk-behind to buy when your yard is too big for a 21-inch deck but you do not want a rider.",
    "description": "The TimeMaster fills a real gap. Plenty of properties sit between half an acre and three quarters, where a 21-inch mower means an hour and a half of walking yet a lawn tractor feels like too much machine or simply will not fit through the side gate. Its 30-inch deck covers noticeably more ground on each pass, and Toro puts two blades under it so the cut stays even across the full width. Drive is rear-wheel, with the same Personal Pace handle as the smaller Recycler, which matters on a mower this heavy because you want the drive, not your arms, doing the work on slopes. The handle folds for storage. The drawbacks are physical: it is a big, heavy machine that takes muscle to swing around trees and through narrow beds, and it costs roughly what a basic riding mower does. On a wide-open, flat lot a rider may be the better value; where there are gates, terraces or tight corners, this is the more practical choice."
  },
  {
    "id": "craftsman-m275",
    "name": "Craftsman M275 21-Inch Self-Propelled",
    "category": "Gas | FWD | Single Speed",
    "badge": "Top Budget Gas",
    "amazonUrl": "",
    "pros": [
      "Among the lowest-priced gas self-propelled mowers from a major brand",
      "3-in-1 deck bags, mulches or side-discharges",
      "Simple single-speed front-wheel drive is easy to service",
      "Parts and blades widely stocked at big-box stores"
    ],
    "cons": [
      "Single drive speed may feel too fast or too slow",
      "Front-wheel drive struggles on steeper banks",
      "Lighter-gauge components than premium models"
    ],
    "bottomLine": "A sensible entry gas self-propelled for flat yards when the budget will not stretch to Toro.",
    "description": "The M275 is the classic starter self-propelled: a 21-inch steel deck, a mainstream small engine, front-wheel drive and a 3-in-1 setup for bagging, mulching or side discharge. It makes no attempt to be clever. The drive has a single speed, which suits a steady walker on level ground but can feel like it is towing you along if you prefer a slower pace. Front-wheel drive works well on lots with plenty of turns, since you can tip the front wheels up and pivot, but it is the wrong layout for a steep front bank. In exchange you get a price that usually sits well under the premium brands and a mower any small-engine shop can repair. Owners commonly report reliable starts when the fuel is kept fresh and the air filter is changed every season. With basic care, treat it as a five-to-eight-year mower, and at that it is fair value."
  },
  {
    "id": "ryobi-40v-hp-brushless-ry401170",
    "name": "Ryobi 40V HP Brushless 21-Inch Self-Propelled",
    "category": "40V Battery | FWD | Dial Speed",
    "badge": "Top Value Battery",
    "amazonUrl": "",
    "pros": [
      "Brushless motor and variable-speed drive at a mid-range price",
      "Batteries shared with Ryobi's large 40V outdoor line",
      "Dual battery ports on many kits extend runtime",
      "Push-button start and no engine maintenance",
      "Widely available at Home Depot for returns and service"
    ],
    "cons": [
      "Front-wheel drive is weaker on slopes than rear-drive rivals",
      "Plastic deck components feel less robust than premium battery mowers"
    ],
    "bottomLine": "The most sensible battery self-propelled for a flat lot, especially if you already own Ryobi 40V tools.",
    "description": "Ryobi's HP brushless line is the budget-minded way into battery self-propelled mowing. A 21-inch deck, a brushless motor and a variable-speed drive cover the essentials, and because the same 40V batteries run Ryobi's trimmers, blowers and hedge cutters, plenty of buyers already have a spare on the shelf. That shared battery is worth real money, since a second high-capacity battery from any brand costs a meaningful share of the mower's price. Drive is front-wheel, so the usual warning about slopes and a heavy bag applies. On flat suburban lots up to roughly a quarter acre, owners commonly report finishing on one charge in normal growth. The build is lighter than EGO's or Toro's battery models, and some owners notice flex in the handle, but the mower folds and stores easily, and buying through a big-box store makes warranty claims simpler. If your yard is level and you want to move away from gas without paying top dollar, start here."
  },
  {
    "id": "troy-bilt-tb230",
    "name": "Troy-Bilt TB230 21-Inch Self-Propelled",
    "category": "Gas | FWD | Big Rear Wheels",
    "badge": "Best Simple Gas Mower",
    "amazonUrl": "",
    "pros": [
      "Straightforward front-wheel drive with few parts to fail",
      "High rear wheels roll easily over bumpy turf",
      "3-in-1 deck with mulch plug and side chute",
      "Low purchase price for a self-propelled",
      "Easy to find blades, belts and filters"
    ],
    "cons": [
      "Single speed drive",
      "Not suited to steep slopes"
    ],
    "bottomLine": "A no-frills self-propelled that does the basics well on flat or gently sloped ground.",
    "description": "The TB230 makes the list by being plain. It has single-speed front-wheel drive, a 21-inch steel deck and larger rear wheels that help it ride over lumpy lawns without scalping the high spots. With no speed dial to wear out and no complicated handle linkage, it appeals to anyone who plans to keep a mower for a long time and handle their own maintenance. Like the Craftsman, it is a front-drive machine, so it turns well around tight beds and loses grip on steep banks. Owners commonly describe it as a dependable starter once they learn to keep the drive cable adjusted and the underside of the deck scraped clean. It costs about the same as the M275, so choosing between the two often comes down to which store is nearer and which has the better price that week. Either one is a reasonable mower for a flat lot up to a third of an acre."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Self-Propelled Mower Picks",
          item: "https://www.allmetalbrake.com/best-self-propelled-lawn-mower/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which self-propelled mower is best for most households?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Toro Recycler 22-inch Personal Pace is the safest all-round choice for a flat-to-rolling suburban yard, because its speed-sensing drive needs no fiddling and its deck mulches well. If you would rather leave gas behind, the EGO LM2135SP is the stronger battery option, particularly on slopes, where its rear-wheel drive and 56-volt battery system hold their grip."
          }
        },
        {
          "@type": "Question",
          "name": "Is rear-wheel drive better than front-wheel drive on a mower?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On slopes and when bagging, yes. Climbing a hill and filling the bag both shift weight onto the rear wheels, so rear drive gains grip just as front drive loses it. Front-wheel drive turns more easily, because you can lift the drive wheels and pivot. Flat lots full of obstacles suit front drive; any noticeable slope calls for rear drive."
          }
        },
        {
          "@type": "Question",
          "name": "Can a battery self-propelled mower handle half an acre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some can, though usually only with a large battery or a second pack. Runtimes on the box assume ideal conditions, and dense or damp grass cuts them short. For half an acre of actual lawn, buy a kit with two batteries or a model with dual battery ports. Under a quarter acre, one good battery normally finishes with room to spare."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a self-propelled lawn mower last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "With regular maintenance, a gas self-propelled mower from a mainstream brand commonly lasts eight to ten years, and premium models with aluminum decks often run longer. Expect to replace the drive belt and cable every few seasons as normal wear. Battery mowers have fewer wear parts, but the battery slowly loses capacity and may need replacing after several years."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my self-propelled mower struggle going uphill?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually the cause is a stretched drive cable, a worn or glazed belt, grass packed around the wheel gears, or a front-wheel-drive layout losing grip as weight moves backward. Adjust the cable first, then clean out the wheels and inspect the belt. If the mower is front-drive and the bank is steep, the drive layout itself may be the limit."
          }
        },
        {
          "@type": "Question",
          "name": "Is a self-propelled mower worth it for a small lawn?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Often not. On a small, flat lawn, a light push mower or a compact battery mower costs less, stores more easily and has fewer parts to fail. Self-propulsion pays its way when the yard has slopes, when you bag clippings regularly, or when each mow lasts long enough that pushing starts to wear you out."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 30-inch walk-behind mower better than a riding mower?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "That depends on access and terrain. A 30-inch walk-behind fits through standard gates, copes with terraces and steep banks that are unsafe for riders, and needs less storage space. A riding mower is quicker and less tiring on large, open, mostly level lawns. Once a property passes three quarters of an acre of open grass, a rider is usually the better value."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Lawn Mowers & Tractors",
    tags: [
      "best self propelled lawn mower",
      "self-propelled mower",
      "rear-wheel drive mower",
      "battery self-propelled mower",
      "gas walk-behind mower",
      "lawn mower buying guide"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          Best Self Propelled Lawn Mower
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          The Toro Recycler 22-Inch Personal Pace is the best self-propelled mower for most flat-to-rolling yards up to about half an acre, and the EGO LM2135SP is the pick if you want battery power. Slopes, bagging and how much grass you really mow change that answer more than engine size does. This guide covers six picks, drive types, gas versus battery, yard size and budget.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          Based on manufacturer drive, deck and engine specs, warranties, dealer and parts availability, and owner feedback. Not hands-on tested. No paid placements. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">13 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#short-answer" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>The Short Answer</span></a>
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>The 6 Best Mowers</span></a>
              <a href="#drive-wheels" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Front, Rear or AWD?</span></a>
              <a href="#speed-control" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Which Speed Control?</span></a>
              <a href="#gas-or-battery" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>Gas or Battery?</span></a>
              <a href="#yard-size" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>What Size for Your Yard?</span></a>
              <a href="#deck-and-cut" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Which Deck Cuts Best?</span></a>
              <a href="#storage-weight" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>Weight and Storage</span></a>
              <a href="#maintenance" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>Mower Not Pulling?</span></a>
              <a href="#clippings" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Bag, Mulch or Discharge?</span></a>
              <a href="#cost" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>How Much to Spend?</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">12.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">13.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Shopping for a self-propelled mower is mostly shopping for a drive system. Engine size and deck width get the attention, but whether you finish the lawn worn out or still fresh comes down to three things: which wheels are powered, how the speed is set, and whether the mower holds traction on a slope once the grass bag starts to fill. Get those right and almost any reputable 21-inch deck will give you a good cut.
        </p>

        <QuickPicks products={PRODUCTS} />

        <!-- Short Answer -->
        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Best Self-Propelled Lawn Mower: The Short Answer
          </h2>

          <p>
            For most yards, buy the Toro Recycler 22-Inch Personal Pace: its drive follows your walking speed, and its recycling deck mulches well on flat-to-gently-rolling lots up to about half an acre. If your lawn slopes or you want to drop gas, the rear-drive EGO LM2135SP is the stronger choice. Lawns between half and three quarters of an acre suit the 30-inch Toro TimeMaster, while the Craftsman M275, Troy-Bilt TB230 and Ryobi 40V HP cover flat lots on a tighter budget.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Mower</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best For</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Drive</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Deck</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Power</th>
                  </tr>
                </thead>
                <tbody>
