---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Zero-Turn Mowers",
    "url": "/best-zero-turn-mower/"
  },
  {
    "title": "Best Riding Lawn Mowers",
    "url": "/best-riding-lawn-mower/"
  },
  {
    "title": "Best Gas Lawn Mowers",
    "url": "/best-gas-lawn-mowers/"
  },
  {
    "title": "Best Lawn Mowers for Small Yards",
    "url": "/best-lawn-mower-for-small-yard/"
  },
  {
    "title": "Best Compact Tractors",
    "url": "/best-compact-tractor/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 6 Best Self-Propelled Mowers: Matched to Your Yard";
const description =
  "Six self-propelled mowers ranked by yard size, slope and fuel type, plus how drive wheels, speed controls and battery runtime decide which one actually fits.";

const PRODUCTS = [
  {
    "id": "toro-recycler-smartstow",
    "name": "Toro Recycler 22-Inch Personal Pace SmartStow",
    "category": "Gas | FWD | Personal Pace",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "Personal Pace drive matches your walking speed without a dial",
      "22-inch deck covers a little more ground per pass than 21-inch rivals",
      "Folds and stands upright on its end for garage storage",
      "Toro dealer and big-box parts network is wide",
      "Vortex-style recycling deck mulches well in normal growth"
    ],
    "cons": [
      "Front-wheel drive loses grip going uphill with a full bag",
      "Steel deck needs to be kept clean and dry to resist rust"
    ],
    "bottomLine": "The easiest self-propelled gas mower to live with on a flat-to-gently-rolling lot up to about half an acre.",
    "description": "Toro's Personal Pace system is the reason this mower sits at the top. Instead of a lever and a separate speed dial, the drive responds to how hard you push on the handle, so it slows when you slow at a flowerbed edge and speeds up on a long straight run. Owners commonly describe it as the least fiddly drive in the class. The 22-inch steel deck is slightly wider than the usual 21 inches, which trims a few passes on a typical suburban lot, and the recycling deck is shaped to keep clippings in suspension long enough to chop them fine. The SmartStow feature lets you stand it on its rear without draining fuel or oil, which frees up real floor space in a one-car garage. The weakness is front-wheel drive: on a steep bank, especially with the rear bag loaded, the front wheels unload and slip. On flat or mildly rolling ground that never matters, and the price usually sits in the middle of the gas market."
  },
  {
    "id": "ego-power-lm2135sp-self-propelled",
    "name": "EGO Power+ LM2135SP 21-Inch Select Cut",
    "category": "56V Battery | RWD | Dial Speed",
    "badge": "Top Battery Pick",
    "amazonUrl": "",
    "pros": [
      "Rear-wheel drive keeps traction on slopes and with a full bag",
      "Select Cut stacked blades give a clean cut and fine mulch",
      "No oil, gas, spark plug or carburetor to maintain",
      "Batteries swap across EGO's 56V tool line",
      "Folds compactly and starts with a button"
    ],
    "cons": [
      "Runtime drops quickly in tall, wet grass",
      "Spare batteries are expensive"
    ],
    "bottomLine": "The battery mower that comes closest to replacing a good gas self-propelled on a sloped quarter-acre lot.",
    "description": "The LM2135SP pairs EGO's 56-volt platform with rear-wheel drive, which is the right layout for anyone mowing uphill. Because weight shifts backward as you climb and as the bag fills, rear drive wheels keep biting where front-drive machines start to spin. The Select Cut system stacks two blades on one spindle, and you can swap the lower blade for a mulching or high-lift version depending on season. Owners commonly report clean results in thick spring grass as long as they slow down and raise the deck a notch. Runtime is the trade-off: EGO rates the kit battery for a typical suburban lot, but the real number falls in long, damp growth because the motor draws harder under load. If your lawn is over a third of an acre, budget for a second battery. Beyond that, the ownership pitch is simple: no winterizing, no fuel stabilizer, no pull cord. The steel-framed polymer deck will not rust, and the mower folds flat to hang on a wall if you buy the bracket."
  },
  {
    "id": "toro-timemaster-30",
    "name": "Toro TimeMaster 30-Inch Personal Pace",
    "category": "Gas | RWD | 30-Inch Deck",
    "badge": "Best for Large Yards",
    "amazonUrl": "",
    "pros": [
      "30-inch deck cuts roughly 40 percent more per pass than a 21-inch",
      "Rear-wheel drive with Personal Pace speed control",
      "Dual-blade system for cleaner cut across the wide deck",
      "Commercial-style build for a residential walk-behind",
      "Fits through gates a riding mower cannot"
    ],
    "cons": [
      "Heavy and harder to turn in tight beds",
      "Costs about as much as an entry lawn tractor"
    ],
    "bottomLine": "The walk-behind to buy when your yard is too big for a 21-inch deck but you do not want a rider.",
    "description": "The TimeMaster occupies a useful gap. Plenty of properties fall between half an acre and three quarters, where a 21-inch mower means an hour and a half of walking but a lawn tractor feels like overkill or simply will not fit through a side gate. A 30-inch deck covers noticeably more ground on every pass, and Toro runs two blades under it so the cut stays even across the full width. It uses rear-wheel drive with the same Personal Pace handle as the smaller Recycler, which matters because a mower this size is heavy and you want the drive doing the work on slopes. The handle also folds for storage. Downsides are physical: it is a large, heavy machine that takes muscle to swing around trees and through narrow beds, and it costs roughly what a basic riding mower does. If your lot is wide open and flat, a rider may be the better value. If it has gates, terraces or tight corners, this is the more practical answer."
  },
  {
    "id": "craftsman-m275",
    "name": "Craftsman M275 21-Inch Self-Propelled",
    "category": "Gas | FWD | Single Speed",
    "badge": "Top Budget Gas",
    "amazonUrl": "",
    "pros": [
      "Among the lowest-priced gas self-propelled mowers from a major brand",
      "3-in-1 deck bags, mulches or side-discharges",
      "Simple single-speed front-wheel drive is easy to service",
      "Parts and blades widely stocked at big-box stores"
    ],
    "cons": [
      "Single drive speed may feel too fast or too slow",
      "Front-wheel drive struggles on steeper banks",
      "Lighter-gauge components than premium models"
    ],
    "bottomLine": "A sensible entry gas self-propelled for flat yards when the budget will not stretch to Toro.",
    "description": "The M275 is what most people picture when they think of a starter self-propelled mower: a 21-inch steel deck, a mainstream small engine, front-wheel drive and a 3-in-1 setup that lets you bag, mulch or discharge out the side. It does not try to be clever. The drive runs at a single speed, which suits a steady walker on level ground but can feel like it is pulling you along if you prefer a slower pace. Front-wheel drive is the right choice for lots with lots of turns because you can tip the front wheels up and pivot easily, but it is the wrong choice for a steep front bank. What you get in return is a price that usually sits well below the premium brands and a mower that any small-engine shop can work on. Owners commonly report that it starts reliably when fuel is kept fresh and the air filter is changed each season. Treat it as a five-to-eight-year mower with basic care and it is fair value."
  },
  {
    "id": "ryobi-40v-hp-brushless-ry401170",
    "name": "Ryobi 40V HP Brushless 21-Inch Self-Propelled",
    "category": "40V Battery | FWD | Dial Speed",
    "badge": "Top Value Battery",
    "amazonUrl": "",
    "pros": [
      "Brushless motor and variable-speed drive at a mid-range price",
      "Batteries shared with Ryobi's large 40V outdoor line",
      "Dual battery ports on many kits extend runtime",
      "Push-button start and no engine maintenance",
      "Widely available at Home Depot for returns and service"
    ],
    "cons": [
      "Front-wheel drive is weaker on slopes than rear-drive rivals",
      "Plastic deck components feel less robust than premium battery mowers"
    ],
    "bottomLine": "The most sensible battery self-propelled for a flat lot, especially if you already own Ryobi 40V tools.",
    "description": "Ryobi's HP brushless line is the budget-conscious route into battery self-propelled mowing. The 21-inch deck, brushless motor and variable-speed drive cover the basics well, and because Ryobi's 40V batteries also power its trimmers, blowers and hedge cutters, many buyers already have a spare on the shelf. That shared-battery advantage is real money: a second high-capacity battery from any brand costs a meaningful share of the mower's price. The drive is front-wheel, so the usual caveat applies on slopes or when the bag gets heavy. On flat suburban lots up to roughly a quarter acre, owners commonly report finishing on one charge with normal growth. The build is lighter than EGO or Toro's battery models, and some owners mention flex in the handle, but the mower is easy to fold and store, and buying through a big-box store simplifies warranty claims. If your yard is level and you want to leave gas behind without paying top dollar, this is the one to look at first."
  },
  {
    "id": "troy-bilt-tb230",
    "name": "Troy-Bilt TB230 21-Inch Self-Propelled",
    "category": "Gas | FWD | Big Rear Wheels",
    "badge": "Best Simple Gas Mower",
    "amazonUrl": "",
    "pros": [
      "Straightforward front-wheel drive with few parts to fail",
      "High rear wheels roll easily over bumpy turf",
      "3-in-1 deck with mulch plug and side chute",
      "Low purchase price for a self-propelled",
      "Easy to find blades, belts and filters"
    ],
    "cons": [
      "Single speed drive",
      "Not suited to steep slopes"
    ],
    "bottomLine": "A no-frills self-propelled that does the basics well on flat or gently sloped ground.",
    "description": "The TB230 earns its place because it is plain. It uses a single-speed front-wheel drive, a 21-inch steel deck and larger rear wheels that help it roll over lumpy lawns without scalping the high spots. There is no speed dial to wear out and no complicated handle linkage, which is appealing if you plan to keep the mower a long time and do your own maintenance. Like the Craftsman, it is a front-drive machine, so it handles turns and tight beds well and loses grip on steep banks. Owners commonly report it as a reliable starter once they learn to keep the drive cable adjusted and the underside of the deck scraped clean. It costs about the same as the M275, so choosing between them often comes down to which store is closer and which has the better price that week. Either is a reasonable mower for a flat lot up to a third of an acre."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Self-Propelled Mower Picks",
          item: "https://www.allmetalbrake.com/best-self-propelled-lawn-mower/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which self-propelled mower suits most households?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a typical flat-to-rolling suburban yard, the Toro Recycler 22-inch Personal Pace is the easiest all-round recommendation because its speed-sensing drive is simple to use and its deck mulches well. If you want to leave gas behind, the EGO LM2135SP is the stronger battery choice, especially on slopes, thanks to rear-wheel drive and a capable 56-volt battery system."
          }
        },
        {
          "@type": "Question",
          "name": "Is rear-wheel drive better than front-wheel drive?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rear-wheel drive is better on slopes and when bagging, because weight shifts onto the rear wheels as you climb and as the bag fills, improving grip. Front-wheel drive is easier to turn because you can lift the drive wheels and pivot. On flat lots with lots of obstacles, front drive is fine; on any noticeable slope, choose rear drive."
          }
        },
        {
          "@type": "Question",
          "name": "Can a battery self-propelled mower handle half an acre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some can, but usually only with a large battery or a second pack. Box runtimes assume ideal conditions, and dense or damp grass shortens them. For half an acre of actual grass, either buy a kit with two batteries or choose a model with dual battery ports. Below a quarter acre, a single good battery typically finishes the job comfortably."
          }
        },
        {
          "@type": "Question",
          "name": "How long should a self-propelled mower last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A well-maintained gas self-propelled mower from a mainstream brand commonly lasts eight to ten years, and premium models with aluminum decks often go longer. The drive belt and cable are normal wear parts that may need replacing every few seasons. Battery mowers have fewer wear parts, though the battery itself will gradually lose capacity and may need replacing after several years."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my self-propelled mower feel weak going uphill?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The usual causes are a stretched drive cable, a worn or glazed belt, grass packed around the wheel gears, or simply front-wheel drive losing traction as weight shifts backward. Start by adjusting the cable, then clean the wheels and check the belt. If the mower is front-wheel drive and the slope is steep, the layout itself may be the limit."
          }
        },
        {
          "@type": "Question",
          "name": "Is self-propulsion worth it on a small lawn?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not always. On a small, flat lawn, a lightweight push mower or a compact battery mower is easier to store, cheaper and has fewer parts to fail. Self-propulsion earns its keep when the yard has slopes, when you bag clippings regularly, or when the mowing takes long enough that pushing becomes tiring."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 30-inch walk-behind better than a riding mower?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on access and terrain. A 30-inch walk-behind fits through standard gates, handles terraces and steep banks that are unsafe for riders, and takes less storage space. A riding mower is faster and less tiring on large, open, mostly level lawns. If the property is over three quarters of an acre of open grass, a rider is usually the better value."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Lawn Mowers & Tractors",
    tags: [
      "best self propelled lawn mower",
      "self-propelled mower",
      "rear-wheel drive mower",
      "battery self-propelled mower",
      "gas walk-behind mower",
      "lawn mower buying guide"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 6 Best <span class="text-[#38BDF8]">Self-Propelled Lawn Mowers</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A self-propelled mower is only worth the money if the drive system suits your ground. Here is which one to buy for flat lots, slopes, big yards and tight budgets.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#toro-recycler-smartstow"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="11.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#drive-wheels" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Which Wheels Get Power</a>
          <a href="#speed-control" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Speed Controls</a>
          <a href="#gas-or-battery" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Gas or Battery</a>
          <a href="#yard-size" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Matching Yard Size</a>
          <a href="#deck-and-cut" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Deck and Cut Quality</a>
          <a href="#storage-weight" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Storage and Weight</a>
          <a href="#maintenance" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Keeping the Drive Working</a>
          <a href="#clippings" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Clippings</a>
          <a href="#cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. What to Spend</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most people shopping for a self-propelled mower are really shopping for a drive system. Deck width and engine size matter, but the thing that decides whether you finish the lawn tired or fresh is which wheels get the power, how the speed is set, and whether the mower can keep traction when the grass bag fills up on a slope. Pick that part right and nearly any reputable 21-inch deck will cut well.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 6 Best Self-Propelled Mowers, Ranked
          </h2>

          <p>
            These picks are built from manufacturer specifications (drive type, deck size, engine or battery rating, warranty), dealer and parts availability, and recurring patterns in owner feedback. Nothing here is based on hands-on lab testing; where a claim comes from a spec sheet or owner reports, the text says so.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} index={index} />
          ))}
        </div>

        <div id="drive-wheels" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Front, Rear or All-Wheel Drive: The Decision That Matters Most
          </h2>

          <p>
            Every self-propelled mower sends engine or motor power to a set of wheels through a belt or a small transmission. Which set gets that power changes how the mower behaves more than any other spec on the box. Before you compare engines, batteries or deck shapes, decide which drive layout suits your ground, then shop only within that group.
          </p>

          <p>
            <strong>Front-wheel drive</strong> is the cheapest and most common layout. Because the drive wheels are up front, you can press down on the handle, lift them off the grass and pivot on the rear wheels. That makes front-drive mowers easy to steer around trees, beds and swing sets. The weakness is weight transfer. When you push uphill, or when the rear grass bag fills, weight moves off the front wheels and they start to slip. On a flat lot that never shows up. On a sloped front yard it shows up every week.
          </p>

          <p>
            <strong>Rear-wheel drive</strong> puts power where the weight sits. As you climb a slope and as the bag gets heavier, the rear wheels gain traction instead of losing it. That is why rear drive is the default recommendation for hills and for anyone who bags clippings. The cost is a bit more effort on turns, since you cannot lift the drive wheels to pivot. Most owners adapt within a couple of mows by turning on the rear wheels and backing up slightly.
          </p>

          <p>
            <strong>All-wheel drive</strong> is rarer and pricier. It helps on very uneven, steep or damp ground where even a rear-drive mower occasionally spins. For a typical suburban yard it is more machine than you need. If your property has a genuine hillside or you mow wet bottomland, it can be worth the premium; otherwise spend the money on a better rear-drive mower.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Drive layout</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best ground</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Weak spot</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical price tier</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Front-wheel</td>
                    <td class="px-4 py-4 text-gray-700">Flat lots with many turns</td>
                    <td class="px-4 py-4 text-gray-700">Uphill with a full bag</td>
                    <td class="px-4 py-4 text-gray-700">Lowest</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Rear-wheel</td>
                    <td class="px-4 py-4 text-gray-700">Slopes, bagging, thick grass</td>
                    <td class="px-4 py-4 text-gray-700">Slightly harder pivots</td>
                    <td class="px-4 py-4 text-gray-700">Middle</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">All-wheel</td>
                    <td class="px-4 py-4 text-gray-700">Steep or uneven terrain</td>
