  },
  {
    id: "troy-bilt-tb230",
    name: "Troy-Bilt TB230",
    category: "Gas, Front-Wheel Drive",
    badge: "Best for Large Flat Yards",
    amazonUrl: "#",
    rating: 4.5,
    reviewCount: 9600,
    pros: [
      "163cc engine with a wide 21-inch deck covers ground quickly on flat terrain",
      "Dual-lever height adjustment is fast and simple to use",
      "Reliable starting and strong value for the power delivered",
      "3-in-1 mulching, bagging, and side-discharge capability",
      "Widely available with accessible replacement parts",
    ],
    cons: [
      "Front-wheel drive is the weakest link on anything beyond a gentle slope",
      "Noticeably louder than any battery option on this list",
    ],
    bottomLine:
      "A dependable, no-surprises gas mower for a flat half-acre-plus lawn where covering ground quickly matters more than hill-climbing ability.",
