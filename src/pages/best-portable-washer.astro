  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Portable Washer",
          item: "https://www.allmetalbrake.com/best-portable-washer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best portable washer for an apartment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most apartments with a standard faucet, a 1.6 cu ft fully automatic washer like the BLACK+DECKER BPWM16W or Magic Chef MCSTCW16W1 is the best fit. It is big enough for one or two people, runs itself once hooked to the sink and rolls into a closet afterwards. If you are short on space, the 0.9 cu ft BPWM09W does the same job with smaller loads."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a portable washer with any sink faucet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not always. Fully automatic portables connect with a quick-connect adapter that replaces the faucet aerator, and the included adapters fit common aerator threads. Pull-out and pull-down sprayer faucets often do not work. Check your aerator thread before buying. If it will not fit, use a bathroom or utility sink, add a supply tee with permission, or buy a twin tub you fill by hose."
          }
        },
        {
          "@type": "Question",
          "name": "Is a twin tub washer better than a fully automatic one?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on how you live. A twin tub is cheaper, lighter, fills from any hose or bucket and usually spins clothes drier, but you move clothes between tubs and run each stage by hand. A fully automatic washer costs more and needs a compatible faucet, but you can start it and walk away. Most apartment dwellers prefer automatic; RVers often prefer twin tubs."
          }
        },
        {
          "@type": "Question",
          "name": "Is there a portable washer and dryer for an apartment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, though most people do better with a separate portable washer and a compact 120V dryer than with an all-in-one. All-in-one combos are larger, heavier and usually installed more permanently. A pair like a 1.6 cu ft portable washer and a compact dryer, or a washer plus a drying rack, is cheaper and easier to move. Check the dryer's venting requirements before you buy."
          }
        },
        {
          "@type": "Question",
          "name": "Can a portable washer run on a power station or generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually. A small washer without a heater is a light load, but its motor surges on start and spin, so check the watt rating on the label and leave headroom on the station's continuous and surge ratings. A generator works too, but only outdoors, well away from doors and windows, because of carbon monoxide. Never plug a generator into a wall outlet."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need my landlord's permission for a portable washer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Often, yes. Many leases restrict or prohibit washing machines because of water damage risk, even portable ones. Read the lease, ask in writing and keep the reply. Landlords are often more comfortable with a sink-connected portable than a permanent hookup. Also check that your renter's insurance covers accidental water damage to your unit and the units around it."
          }
        },
        {
          "@type": "Question",
          "name": "How much water does a portable washer use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It varies by model, water level and cycle, so check the manual for the specific machine. Small automatics use noticeably less water per load than full-size top-loaders, and twin tubs can use less still because you control the fill and can reuse rinse water. In an RV, watch your fresh-water tank level, because wash and rinse together can use more than you expect."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
