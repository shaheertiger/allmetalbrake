];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "The Best Portable Washers: Twin Tub vs Automatic for Small Spaces";
const description =
  "Portable washing machines for apartments, RVs and small spaces, compared on capacity, sink faucet hookups, drain height, twin tub vs automatic and power needs.";

const PRODUCTS = [
