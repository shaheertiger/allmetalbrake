const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How to Seal a Driveway",
          item: "https://www.allmetalbrake.com/how-to-seal-a-driveway/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How long does it take to seal a driveway yourself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a typical two-car driveway of about 600 to 900 square feet, plan on most of two days. The first day goes to trimming edges, cleaning, treating oil spots, and filling cracks. The second day covers both coats of sealer, which takes a few hours each including the wait between them. Then add 24 to 48 hours before driving on it, depending on weather and the product label."
          }
        },
        {
          "@type": "Question",
          "name": "Should I use a squeegee or a brush to apply sealer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A squeegee is the better tool for most driveways because it spreads sealer quickly in a thin, even film and pushes it into the texture. A brush is useful for cutting in edges and for very rough, porous surfaces where you want to work material into the pores. Many combination tools have a squeegee on one side and a brush on the other, which covers both jobs."
          }
        },
        {
          "@type": "Question",
          "name": "Can I seal my driveway in the fall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, as long as temperatures stay above the label minimum, usually 50°F, during application and for the first day or two afterward. Early fall is often a good window because days are dry and not scorching. Late fall is riskier because nights get cold and dew lingers, which slows curing. Our guide to the best time to seal a driveway covers seasonal timing in detail."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to pressure wash before sealing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not necessarily. A garden hose with a jet nozzle, a stiff brush, and a degreaser for oil spots cleans most driveways well enough. A pressure washer is faster and helps on heavily soiled surfaces, but use a wide fan tip and keep it moving to avoid stripping binder from older asphalt. Whichever method you use, the surface must dry completely before you coat it."
          }
        },
        {
          "@type": "Question",
          "name": "How many coats of driveway sealer should I apply?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Two thin coats is the standard recommendation on most asphalt sealer labels. The first coat soaks into the surface and fills texture; the second evens out the color and builds the protective film. A driveway that was sealed recently and is still in good shape can sometimes get by with a single maintenance coat, but a first-time or neglected driveway needs two."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if it rains right after I seal the driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If rain falls within the first few hours, it can wash uncured sealer off the surface, leave streaks, or turn the finish cloudy. Once the coating has had several hours of dry, warm weather, light rain usually does little harm. If a storm does damage the finish, let everything dry, sweep up any loose material, and recoat the affected areas on the next dry day."
          }
        },
        {
          "@type": "Question",
          "name": "Is it cheaper to seal a driveway myself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually, yes. Materials for a typical driveway often come to roughly $100 to $300 including sealer, crack filler, and a squeegee, while contractors commonly charge several hundred dollars for the same space. The trade-off is time and effort. For very large or badly cracked driveways, a contractor with spray equipment and hot crack sealant can be worth the extra cost."
          }
        }
      ],
    },
