const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Latex-ite Driveway Sealer Review",
          item: "https://www.allmetalbrake.com/latex-ite-driveway-sealer-review/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Latex-ite Airport Grade a coal tar sealer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Check the safety data sheet for the exact pail you are buying, because formulas and regional versions can differ and the label is the only reliable source. Several states and many towns restrict refined coal tar sealers, so retailers in those areas should only stock compliant products. If the SDS lists asphalt emulsion as the binder, it is the lower-toxicity type most homeowners should prefer."
          }
        },
        {
          "@type": "Question",
          "name": "How long does Latex-ite last on a driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Owner reports most commonly put a well-applied two-coat job at about two to three years before it needs a refresh, with longer service in full sun and light traffic. Tire tracks, turning areas and shaded sections wear first. Poor prep, cool weather or a single thick coat shortens that sharply. Plan on resealing on a two to three year cycle rather than hoping for five."
          }
        },
        {
          "@type": "Question",
          "name": "Can I put Latex-ite over an old sealer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if the old coat is sound and well bonded. Scrape and sweep away any flaking material, clean the surface thoroughly, and let it dry. Applying over an old coat that is peeling simply adds weight to a failing layer. If the old sealer was a different chemistry, such as a solvent-based product, test a small area first to make sure the new coat bonds."
          }
        },
        {
          "@type": "Question",
          "name": "How many pails of Latex-ite do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Measure length times width of the paved area and divide by the coverage on the pail label, typically somewhere around 250 to 350 square feet per pail per coat for filler sealers. Use the low end of the range for rough or porous asphalt. Double the number for two coats, then add one spare pail you can return unopened if you do not need it."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if it rains after I apply Latex-ite?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rain within the first few hours can wash uncured sealer off the surface, leaving gray streaks and a mess in the gutter. Rain after the surface has skinned over usually causes only minor spotting. Let it dry completely, sweep off any loose residue, and touch up or recoat affected areas. Our article on rain after driveway sealing explains how to judge the damage."
          }
        },
        {
          "@type": "Question",
          "name": "Does Latex-ite work on concrete driveways?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Asphalt emulsion sealers are made to bond with and protect asphalt, and on concrete they leave a black coating that peels and looks out of place. Concrete needs a penetrating silane or siloxane repellent or an acrylic concrete sealer instead. Use the product designed for the surface you actually have."
          }
        },
        {
          "@type": "Question",
          "name": "How long before I can drive on a Latex-ite coat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Foot traffic is usually fine after several hours in warm, sunny weather, but vehicle traffic generally needs at least 24 to 48 hours, and longer in cool, humid or shaded conditions. Turning your wheels while parked on a fresh coat is the fastest way to scuff it. Block the driveway entrance with tape or a sawhorse so nobody pulls in early."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
  ],
};
