---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import CatIcon from '../components/CatIcon.astro';
import { articles, articleUrl, topicOf } from '../lib/data';
import { glossary } from '../data/glossary';
import { breadcrumbs, graph, itemList } from '../lib/schema';
const items = articles.filter((a) => a.kind === 'guide');
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Guides', url: '/guides/' }];
const tools = [
  { href: '/tools/generator-wattage-calculator/', name: 'Generator Wattage Calculator', text: 'Running and starting watts for your outage loads.' },
  { href: '/tools/power-station-runtime-calculator/', name: 'Power Station Runtime Calculator', text: 'How long a battery runs your fridge, CPAP or router.' },
];
---
<Base title="Backup Power Guides: Costs, Lifespans and Comparisons" description="Plain-English backup power guides: whole house generator cost, how long generators last, the best time to buy, and EcoFlow vs Jackery vs Bluetti, with numbers." schema={graph(breadcrumbs(crumbs), itemList(items.map((a) => ({ name: a.h1, url: articleUrl(a) }))))}>
  <div class="wrap hub">
    <Crumbs items={crumbs} />
    <h1 class="hub-title">Backup Power Guides</h1>
    <p class="hub-dek">What it costs, how long it lasts, when to buy and which brand fits. Start here before you price a generator or power station.</p>
    <div class="grid grid-3">{items.map((a) => <a class="card" href={articleUrl(a)}><CatIcon cat={topicOf(a) ?? 'guides'} size={44} /><span class="card-k">Guide</span><h3>{a.h1}</h3><span class="card-sub">{a.metaDescription}</span></a>)}</div>
    <h2 class="section-title">Calculators</h2>
    <div class="grid grid-2">{tools.map((t) => <a class="card" href={t.href}><span class="card-k">Calculator</span><h3>{t.name}</h3><span class="card-sub">{t.text}</span></a>)}</div>
    <h2 class="section-title">Glossary</h2>
    <p class="term-cloud">{glossary.map((g) => <a href={`/glossary/${g.slug}/`}>{g.term}</a>)}</p>
  </div>
</Base>
