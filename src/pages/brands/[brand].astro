---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { SITE } from '../../data/site';
import { amazonLink } from '../../data/affiliate';
import { BRANDS, guidesForBrand, productsOfBrand, getGuide, comparesFor, mustProduct, brandPath, productPath, guidePath, comparePath, priceBand, avgScore, categoryOf, type Brand } from '../../lib/data';

export function getStaticPaths() {
  return BRANDS.map((b) => ({ params: { brand: b.key }, props: { b } }));
}
const { b } = Astro.props as { b: Brand };
const list = productsOfBrand(b.key);
const review = b.review ? getGuide(b.review) : undefined;
const compares = [...new Map(list.flatMap((p) => comparesFor(p.id)).map((c) => [comparePath(c), c])).values()];
const guides = guidesForBrand(b.key).filter((g) => g !== review);
const cats = [...new Set(list.map((p) => categoryOf(p.category).plural))];
const path = brandPath(b);
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Brands', href: '/brands/' }, { name: b.name, href: path }];
const title = [`${b.name} Review: ${list.length} ${b.name} Products Rated (2026)`, `${b.name}: ${list.length} Products Rated by ${SITE.score}`].find((t) => t.length <= 62) ?? `${b.name} Products Rated`;
const best = list[0];
const desc = `${best.name} is the best-scoring ${b.name} product we track at ${best.score.overall}/100. See all ${list.length} ${b.name} ${cats.join(' and ')} with specs, scores and prices.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Brand', name: b.name, url: `${SITE.url}${path}`, description: b.blurb },
    { '@type': 'ItemList', name: `${b.name} products`, itemListElement: list.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name, url: `${SITE.url}${productPath(p)}` })) },
    { '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: `${SITE.url}${c.href}` })) },
  ],
};
---
<Base title={title} description={desc.length > 158 ? desc.slice(0, desc.lastIndexOf(' ', 155)) + '.' : desc} jsonLd={jsonLd}>
  <div class="col hub">
    <Crumbs items={crumbs} />
    <h1 class="hub-title">{b.name}</h1>
    <p class="hub-dek">{b.blurb}</p>
    <p class="fine">{[b.founded && `Founded ${b.founded}`, b.hq && `Headquarters: ${b.hq}`, `${list.length} products tracked`, `average ${SITE.score} ${avgScore(list)}`].filter(Boolean).join(' · ')}</p>
    {review && <p class="answer-box">Read our full brand review: <a href={guidePath(review)}>{review.h1}</a>.</p>}
    <h2 class="section-title">Every {b.name} Product We Track</h2>
    <div class="table-wrap">
      <table class="tracked">
        <thead><tr><th>Product</th><th>Category</th><th>Score</th><th>Price</th><th></th></tr></thead>
        <tbody>{list.map((p) => <tr><td><a href={productPath(p)}>{p.name}</a></td><td>{categoryOf(p.category).label}</td><td>{p.score.overall}</td><td class="nowrap">{priceBand(p)}</td><td><a href={amazonLink(p)} rel="sponsored nofollow noopener" target="_blank">Price</a></td></tr>)}</tbody>
      </table>
    </div>
    {compares.length > 0 && (
      <>
        <h2 class="section-title">{b.name} Comparisons</h2>
        <ul class="link-list">{compares.map((c) => <li><a href={comparePath(c)}>{mustProduct(c.a).short} vs {mustProduct(c.b).short}</a></li>)}</ul>
      </>
    )}
    {guides.length > 0 && (
      <>
        <h2 class="section-title">Guides With {b.name} Picks</h2>
        <ul class="link-list">{guides.map((g) => <li><a href={guidePath(g)}>{g.h1}</a></li>)}</ul>
      </>
    )}
  </div>
</Base>
