---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { SITE, SCORE_NAME } from '../../data/site';
import { categoryOf } from '../../data/categories';
import { compares } from '../../data/compares';
import { amazonUrl, AFFILIATE_REL } from '../../lib/amazon';
import { brands, productsByBrand, brandSlug, productUrl, articles, articleUrl, productMap, compareSlug, shortName } from '../../lib/data';
import { breadcrumbs, graph, itemList } from '../../lib/schema';
export function getStaticPaths() { return brands.map((b) => ({ params: { brand: brandSlug(b) }, props: { brand: b } })); }
const { brand } = Astro.props as { brand: string };
const list = productsByBrand(brand);
const best = list[0];
const ids = new Set(list.map((p) => p.slug));
const review = articles.find((a) => a.brand === brand);
const featuredIn = articles.filter((a) => a.picks?.some((pk) => ids.has(pk.product)) && a.slug !== review?.slug);
const brandCompares = compares.filter(([a, b]) => (ids.has(a) || ids.has(b)) && productMap.has(a) && productMap.has(b));
const cats = [...new Set(list.map((p) => categoryOf(p.category).plural))];
const avg = Math.round(list.reduce((s, p) => s + p.score, 0) / list.length);
const path = `/brands/${brandSlug(brand)}/`;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Brands', url: '/brands/' }, { name: brand, url: path }];
const title = [`${brand} Review: ${list.length} ${brand} Products Rated (2026)`, `${brand}: ${list.length} Products Rated by ${SCORE_NAME}`, `${brand} Backup Power Products: ${list.length} Models Rated`].find((t) => t.length <= 62) ?? `${brand} Products Rated`;
const desc = `${best.name} is the best-scoring ${brand} product we track at ${best.score}/100. See all ${list.length} ${brand} ${cats.join(' and ')} with specs, scores and prices.`;
const schema = graph(
  { '@type': 'Brand', name: brand, url: `${SITE.url}${path}` },
  itemList(list.map((p) => ({ name: p.name, url: productUrl(p), product: p })), `${brand} products`),
  breadcrumbs(crumbs),
);
---
<Base title={title} description={desc.length > 158 ? desc.slice(0, desc.lastIndexOf(' ', 155)) + '.' : desc} schema={schema}>
  <div class="col hub">
    <Crumbs items={crumbs} />
    <h1 class="hub-title">{brand}</h1>
    <p class="hub-dek">Every {brand} product we track, with its spec sheet, {SCORE_NAME} and price band. Our highest-rated {brand} model is the <a href={productUrl(best)}>{best.name}</a>.</p>
    <p class="fine">{list.length} product{list.length === 1 ? '' : 's'} tracked · average {SCORE_NAME} {avg} · {[...new Set(list.map((p) => categoryOf(p.category).label))].join(', ')}</p>
    {review && <p class="answer-box">Read our full brand review: <a href={articleUrl(review)}>{review.h1}</a>.</p>}
    <h2 class="section-title">Every {brand} Product We Track</h2>
    <div class="table-wrap">
      <table class="tracked">
        <thead><tr><th>Product</th><th>Category</th><th>Score</th><th>Price</th><th></th></tr></thead>
        <tbody>{list.map((p) => <tr><td><a href={productUrl(p)}>{p.name}</a></td><td>{categoryOf(p.category).label}</td><td>{p.score}</td><td class="nowrap">{p.priceBand}</td><td><a href={amazonUrl(p)} rel={AFFILIATE_REL} target="_blank">Price</a></td></tr>)}</tbody>
      </table>
    </div>
    {featuredIn.length > 0 && (
      <>
        <h2 class="section-title">{brand} in Our Best Lists</h2>
        <ul class="link-list">{featuredIn.map((a) => <li><a href={articleUrl(a)}>{a.h1}</a></li>)}</ul>
      </>
    )}
    {brandCompares.length > 0 && (
      <>
        <h2 class="section-title">{brand} Comparisons</h2>
        <ul class="link-list">{brandCompares.map(([a, b]) => <li><a href={`/compare/${compareSlug(a, b)}/`}>{shortName(productMap.get(a)!.name)} vs {shortName(productMap.get(b)!.name)}</a></li>)}</ul>
      </>
    )}
  </div>
</Base>
