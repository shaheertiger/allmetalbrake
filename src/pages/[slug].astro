---
// Root-level pages: best lists and brand reviews (/best-inverter-generator/, /best-ecoflow-power-station/)
// and guides (/generac-generator-cost/). Source: src/content/articles/*.json.
import GuidePage from '../components/GuidePage.astro';
import ArticlePage from '../components/ArticlePage.astro';
import { articles } from '../lib/data';
import type { Article } from '../lib/types';

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props as { a: Article };
---
{a.kind === 'guide' ? <ArticlePage a={a} /> : <GuidePage a={a} />}
