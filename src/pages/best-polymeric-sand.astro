const title = "The 6 Best Polymeric Sands: Pavers, Flagstone and Wide Joints";
const description =
  "Six polymeric sands matched to joint width and surface, from tight concrete paver gaps to 3-inch flagstone joints, plus coverage, haze fixes and cost.";

const PRODUCTS = [
  {
    "badge": "Best Overall",
    "name": "Alliance Gator Maxx G2 Polymeric Sand",
    "category": "Paver Joint Sand",
    "id": "gator-maxx-g2",
    "amazonUrl": "",
