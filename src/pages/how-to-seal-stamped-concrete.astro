                    <td class="px-4 py-4 text-gray-700">Wet look to satin; color revived</td>
                    <td class="px-4 py-4 text-gray-700">Unchanged, natural</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Release color protected</td>
                    <td class="px-4 py-4 text-gray-700">Yes, under the film</td>
                    <td class="px-4 py-4 text-gray-700">No, left exposed to wear</td>
                  </tr>
