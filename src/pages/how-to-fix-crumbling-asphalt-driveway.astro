---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/how-to-fix-crumbling-asphalt-driveway.html?raw';

const title = "How to Fix a Crumbling Asphalt Driveway — Diagnose Before You Repair | Home Fix Reviews";
const description = "Most crumbling driveways are ravelled surfaces on sound bases and cost $150 and a weekend to fix. Some have failed bases and cannot be fixed from the top. How to tell the difference, and the right repair for each.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
