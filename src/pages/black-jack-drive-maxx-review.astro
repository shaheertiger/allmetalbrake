---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/black-jack-drive-maxx-review.html?raw';

const title = "Black Jack Drive-Maxx Review: 500 vs 700 vs 1000";
const description = "Drive-Maxx 500, 700 and 1000 are rated 5, 7 and 10 years. All need two coats at about 350 sq ft per coat; only the 1000 applies down to 45°F. What each tier adds.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
