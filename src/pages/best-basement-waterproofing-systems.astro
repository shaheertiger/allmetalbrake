];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "Basement Waterproofing Systems: Pumps, Drains and Coatings Ranked";
const description =
  "Interior drains, exterior membranes, sump pumps, battery backups and crack kits: which system parts a wet basement needs and what each costs to install.";

const PRODUCTS = [
