const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Basement Waterproofing Systems",
          item: "https://www.allmetalbrake.com/best-basement-waterproofing-systems/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which basement waterproofing system works best?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There is no single best system; the right one matches where water enters. For water along the floor joint, an interior perimeter drain with a cast-iron sump pump and battery backup is the most common reliable fix. For a damp wall, a coating may be enough. For saturated soil or structural repairs, exterior excavation with a membrane is the most complete option."
          }
        },
        {
          "@type": "Question",
          "name": "How much should basement waterproofing cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Typical ranges at the time of writing are a few hundred dollars for crack injection or DIY coatings, $5,000 to $15,000 for an interior perimeter drain with a sump pump, and $15,000 to $30,000 or more for full exterior excavation and membrane. Get at least three itemized quotes, since pricing varies widely by region and access."
          }
        },
        {
          "@type": "Question",
          "name": "Is a sump pump necessary for waterproofing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if your system collects water that needs to go somewhere. Interior perimeter drains and most exterior footing drains on flat lots need a sump pump. Houses on sloped lots may drain footing water to daylight by gravity. A wall coating or crack injection alone does not require a pump, because it reduces water entry rather than collecting it."
          }
        },
        {
          "@type": "Question",
          "name": "How long do sump pumps last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A quality primary sump pump typically lasts seven to ten years, sometimes longer with light use and shorter in homes where it runs constantly. Backup batteries generally last three to five years. Test both several times a year and replace the primary proactively near the end of its expected life rather than waiting for it to fail during a storm."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between waterproofing and damp-proofing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Damp-proofing is a thin coating, often asphalt-based, that slows moisture vapor through a foundation and is what many houses received when built. Waterproofing is a thicker, flexible membrane designed to resist water under pressure, typically paired with drainage board and a footing drain. Damp-proofing is not designed to keep out liquid water from saturated soil."
          }
        },
        {
          "@type": "Question",
          "name": "Can I install a basement waterproofing system myself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Parts of one, yes. Replacing a sump pump, adding a battery backup, injecting a crack and coating walls are reasonable DIY projects. Cutting a slab and installing a full interior drain is possible for a determined owner with rented tools, but it is heavy, dusty work. Exterior excavation to the footing is unsafe without shoring and should be left to professionals."
          }
        },
        {
          "@type": "Question",
          "name": "Does homeowners insurance cover basement waterproofing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard policies generally do not pay for waterproofing upgrades or damage from groundwater seepage, which is treated as maintenance. Sump pump failure or backup coverage is often available as an add-on endorsement. Read your policy and ask your agent, especially if you are finishing the basement, since a single pump failure can damage flooring, drywall and stored belongings."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
