---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Solar Generators",
    "url": "/best-solar-generator/"
  },
  {
    "title": "EcoFlow vs. Jackery",
    "url": "/ecoflow-vs-jackery/"
  },
  {
    "title": "Best Power Stations for Home Backup",
    "url": "/best-portable-power-station-for-home-backup/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "Best Portable Power Station for Camping: 6 Picks Sized by Trip";
const description =
  "Six camping power stations, from 9-pound power banks to 2kWh RV units, with a campsite load budget, car and solar recharge math and three worked trip plans.";

const PRODUCTS = [
  {
    "id": "ecoflow-river-3-plus",
    "name": "EcoFlow River 3 Plus Portable Power Station",
    "category": "286Wh LFP, 600W, Expandable, ~10 lb",
    "badge": "Best Overall for Camping",
    "amazonUrl": "",
    "pros": [
      "About 10 pounds, easy to carry from the car to the tent",
      "600W inverter covers small appliances and chargers",
      "Snap-on extra battery available for longer trips",
      "LFP cells tolerate years of trip-after-trip cycling"
    ],
    "cons": [
      "286Wh will not carry a 12V cooler for days without solar",
      "No kettles, hair dryers or heaters on a 600W inverter",
      "Modest solar input caps how fast it refills"
    ],
    "bottomLine": "The right first camping power station: light enough to carry, big enough for devices, lights and a CPAP, and expandable when trips get longer.",
    "description": "The River 3 Plus is the size most tent campers actually need. EcoFlow rates it at 286Wh of LFP storage, which recharges a group's phones several times over, runs LED string lights for many evenings, tops up camera and headlamp batteries, and can power a CPAP through a night or more when it runs from the DC output without the heated humidifier. EcoFlow lists it at around 10 pounds, so it goes wherever a daypack goes, which matters at walk-in sites where the parking lot is a few hundred yards from the tent pad. Its 600W inverter is generous for the capacity: enough for a small blender, a projector, a laptop charger and a drone battery charger at once. What it cannot do is sustain a 12V cooler for a long weekend on its own. Pair it with a 100 to 200W folding panel or EcoFlow's add-on battery, or use it for a cooler only when you can refill it from the car each day. Treat it as the hub for devices and light, and it is hard to fault."
  },
  {
    "id": "jackery-explorer-1000-v2",
    "name": "Jackery Explorer 1000 v2 Portable Power Station",
    "category": "1,070Wh LFP, 1,500W, ~24 lb",
    "badge": "Best for Car Camping",
    "amazonUrl": "",
    "pros": [
      "1,070Wh in about 24 pounds, light for a 1kWh unit",
      "Enough capacity for a 12V cooler for two to three days on its own",
      "3,000W surge rating copes with compressor start-ups",
      "Simple controls that are easy to use in the dark"
    ],
    "cons": [
      "Not expandable with add-on batteries",
      "1,500W continuous rules out the hungriest kettles",
      "Some charging modes are set through the app"
    ],
    "bottomLine": "The lightest practical way to bring a full kilowatt-hour to a drive-in campsite, cooler and all.",
    "description": "Car campers who drive to a site and stay put for three or four nights hit the limits of a 300Wh unit quickly, usually because of the cooler. The Explorer 1000 v2 is the most comfortable step up. Jackery lists 1,070Wh of LFP capacity, roughly three to four times as much as the small units, yet at about 24 pounds it is one of the lightest 1kWh boxes on the market and a single-hand carry from the trunk to the picnic table. By the usual runtime math that capacity runs a typical 12V compressor cooler for two or three days without any recharging, while also covering lights, phones and a laptop. Jackery rates the inverter at 1,500W continuous and 3,000W surge, which handles a small induction plate on low, a coffee maker or a blender. The trade-off is that the capacity is fixed: if you later want more, you add a panel or a second unit rather than an extension battery."
  },
  {
    "id": "ecoflow-delta-3-plus",
    "name": "EcoFlow Delta 3 Plus Portable Power Station",
    "category": "1,024Wh LFP, 1,800W, Expandable, ~28 lb",
    "badge": "Best for Overlanding",
    "amazonUrl": "",
    "pros": [
      "Expandable with add-on batteries for longer expeditions",
      "1,800W inverter handles camp cooking appliances",
      "Multiple charging paths: wall, car, solar, alternator accessories",
      "Doubles as home outage backup between trips"
    ],
    "cons": [
      "About 28 pounds, heavier than the Jackery at similar capacity",
      "Lower watt-hours per pound than other 1kWh picks",
      "Several settings live in the app"
    ],
    "bottomLine": "The pick for vehicle-based trips where capacity and charging options need to scale with the itinerary.",
    "description": "Overlanding rewards a system that can grow. On a week-long trip with a fridge running around the clock in the back of a truck, you live and die by your recharging plan, and the Delta 3 Plus fits into the widest one. EcoFlow rates it at 1,024Wh with an 1,800W inverter, and it accepts EcoFlow's extra batteries, so you can begin with one box for weekends and add capacity before the long trip. It charges from solar, from the 12V socket while you drive, and from EcoFlow's dedicated alternator charging accessories when you want much faster refills on the move. The 1,800W inverter matters more than it sounds in camp: a compact coffee maker, an electric griddle on a moderate setting or a power tool for a quick repair all fit. The cost is weight. At around 28 pounds it gives up some energy per pound to the Jackery, which is irrelevant when it is strapped into a truck bed and noticeable when you carry it to a riverside site. Between trips it is a capable home outage unit."
  },
  {
    "id": "anker-solix-c300x",
    "name": "Anker SOLIX C300X Portable Power Station",
    "category": "288Wh LFP, 300W, USB-C Focused, ~9 lb",
    "badge": "Best Budget",
    "amazonUrl": "",
    "pros": [
      "Lightest pick at about 9 pounds",
      "Strong USB-C output charges laptops and cameras directly",
      "LFP chemistry at a price close to a large power bank",
      "Small enough to live in a car or gear bin year-round"
    ],
    "cons": [
      "300W AC limit rules out most appliances",
      "Not meant for running a cooler for days",
      "Not expandable"
    ],
    "bottomLine": "The budget power bank for camping: devices, lights and laptops, not appliances.",
    "description": "Plenty of campers do not need a portable generator for camping at all; they need a big, rugged power bank. The SOLIX C300X fills that role. Anker lists 288Wh of LFP storage, nearly identical to the River 3 Plus, but the unit is built around USB-C rather than the AC inverter, so phones, tablets, headlamps, camera chargers and most laptops charge directly over DC at high efficiency. For a family of four, that is several days of devices and lights. The 300W AC outlets will handle a laptop brick, a small fan or a string of lights, but not a blender, a kettle or a hair dryer, and running a cooler from it is a one-night proposition without solar. If your trips are about keeping phones, cameras and lamps alive, it is the cheapest sensible LFP unit here."
  },
  {
    "id": "bluetti-elite-100-v2",
    "name": "Bluetti Elite 100 V2 Portable Power Station",
    "category": "1,024Wh LFP, 1,800W, Compact, ~25 lb",
    "badge": "Best Compact 1kWh",
    "amazonUrl": "",
    "pros": [
      "1,024Wh and 1,800W in about 25 pounds",
      "Compact footprint for packed trunks and van shelves",
      "LFP cells with a long cycle rating",
      "Frequently priced below the EcoFlow and Jackery equivalents"
    ],
    "cons": [
      "Not expandable",
      "Fewer camping accessories than EcoFlow or Jackery",
      "App is functional rather than polished"
    ],
    "bottomLine": "A compact, capable kilowatt-hour for campers who care more about trunk space and price than accessories.",
    "description": "The Elite 100 V2 is the value play in the 1kWh class. On paper it matches the Delta 3 Plus, with Bluetti listing 1,024Wh of LFP storage and an 1,800W inverter, but in a lighter, more compact case closer to the Jackery's weight. For campers who pack a hatchback to the roof, a smaller box is not a trivial advantage. The compromises are in the ecosystem rather than the hardware: no add-on batteries, fewer bundled panels and car accessories, and an app that works without delighting. Any standard folding panel within its input limits will charge it, and the 12V socket runs a cooler just as well as the big brands' do. When it is discounted below the EcoFlow and Jackery, it is the sensible buy."
  },
  {
    "id": "jackery-explorer-2000-v2",
    "name": "Jackery Explorer 2000 v2 Portable Power Station",
    "category": "2,042Wh LFP, 2,200W, ~40 lb",
    "badge": "Best for RV and Van Life",
    "amazonUrl": "",
    "pros": [
      "2,042Wh covers a day or more of RV loads without hookups",
      "Highest energy per pound here at about 51Wh per pound",
      "2,200W runs a coffee maker or microwave in short bursts",
      "Still a one-person lift at about 40 pounds"
    ],
    "cons": [
      "Too heavy to carry far from the vehicle",
      "Will not run rooftop air conditioning for long",
      "Not expandable"
    ],
    "bottomLine": "The quiet, no-fuel power source for RV and van trips where a 1kWh unit runs dry by breakfast.",
    "description": "Once the campsite has a roof and wheels, loads grow: a CPAP every night, a roof vent fan, a TV or laptop in the evening, a coffee maker in the morning, a small microwave now and then. The Explorer 2000 v2 is built for that. Jackery lists 2,042Wh of LFP capacity, enough for a typical boondocking day for a couple, and a 2,200W inverter that runs most countertop appliances one at a time. On the published figures it packs more energy per pound than any other pick here, which matters in a van where every pound counts against payload. It is not a replacement for an RV generator if you want air conditioning, because rooftop units are too hungry for any 2kWh battery to sustain, and at about 40 pounds it stays near the vehicle rather than going down to the lake. Pair it with 400W or more of solar and it can keep pace with moderate RV loads on sunny days."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Power Stations for Camping",
          item: "https://www.allmetalbrake.com/best-portable-power-station-for-camping/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What size portable power station do I need for camping?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Size it from a daily load budget. Add up what each device uses per day in watt-hours, multiply by the days without recharging, and subtract what driving and solar can return. Phones, lights and cameras alone need 100 to 200Wh a day, which a 300Wh unit covers for a weekend. A 12V cooler raises that to roughly 400 to 800Wh a day, pointing to a 1kWh unit. RV trips with a CPAP, fans and a coffee maker suit a 2kWh unit with solar."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a power station run a 12V camping cooler?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 12V compressor cooler draws roughly 40 to 60W while running but cycles on and off, so daily use is typically 300 to 700Wh depending on size, heat, sun and lid openings. From the 12V socket, a 286 to 288Wh unit lasts between half a day and a day, a 1kWh unit roughly two to three days, and a 2kWh unit four days or more. Shade, pre-chilling and a full load all stretch runtime."
          }
        },
        {
          "@type": "Question",
          "name": "Can I run a CPAP from a power station while camping?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, and it is one of the most common reasons campers buy one. A CPAP without its heated humidifier typically draws 30 to 60W, or about 250 to 500Wh over an eight-hour night. The maker's 12V DC cord avoids inverter losses. A 300Wh class unit usually covers one night, a 1kWh unit several. The heated humidifier can multiply use several times over, so test the full setup at home first."
          }
        },
        {
          "@type": "Question",
          "name": "Is a power station better than a portable generator for camping?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most campers, yes. A battery is silent, produces no exhaust, can be used inside a tent or RV, needs no fuel and is allowed in loops that ban generators or restrict them to set hours. A gas inverter generator still wins for rooftop RV air conditioning or weeks off-grid without reliable sun. Many RV owners combine the two, running the generator in permitted hours to recharge the battery."
          }
        },
        {
          "@type": "Question",
          "name": "Can I charge a power station from my car while driving?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Every unit in this guide accepts charging from a vehicle's 12V accessory socket. Most sockets are fused at 10 to 15 amps, so charging is limited to roughly 100 to 120W, or about 100Wh per hour of driving. That refills a 300Wh unit in around three hours; a 1kWh unit needs about ten. Dedicated alternator chargers deliver several hundred watts while the engine runs."
          }
        },
        {
          "@type": "Question",
          "name": "How much solar do I need for camping?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A portable panel produces roughly 60 to 75 percent of its rating in good midday sun, and a clear day offers four to five peak sun hours. A 100W panel returns about 250 to 350Wh a day, 200W about 500 to 700Wh, and 400W around 1,000 to 1,400Wh. Use 100W for devices, 200W to sustain a cooler, and 400W or more for overland fridges or RV use. Keep a buffer for shade and cloud."
          }
        },
        {
          "@type": "Question",
          "name": "Can a camping power station charge an e-bike?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually, if the e-bike charger's wattage is within the station's AC output. Many e-bike packs hold roughly 400 to 750Wh, and charging through the inverter and the bike's brick loses energy at both steps. A 300Wh unit adds only a partial charge, and a 1kWh unit can fill one mid-size pack but leaves little for the cooler. For regular e-bike charging, use a 2kWh unit with solar or a campground hookup."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "portable power station for camping",
      "camping power station",
      "power station for 12v cooler",
      "cpap power station camping",
      "solar charging while camping",
      "rv boondocking battery"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Sized by Trip
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best Power Stations for <span class="text-[#38BDF8]">Camping</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Most campers buy twice the battery they need and half the charging. Build a daily load budget, run what you can on DC, plan the refill, and the right size becomes obvious. Six models, from a 9-pound power bank to a 2kWh RV unit.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#ecoflow-river-3-plus"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Sizing to the Campsite</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The Six Picks</a>
          <a href="#load-budget" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Campsite Load Budget</a>
          <a href="#dc-vs-ac" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. DC vs. AC</a>
          <a href="#recharging" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Recharging on the Road</a>
          <a href="#campground-rules" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Quiet Hours and Bans</a>
          <a href="#weather" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Cold Nights and Hot Cars</a>
          <a href="#trip-examples" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Worked Trip Examples</a>
          <a href="#rv-van" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. RV and Van Use</a>
          <a href="#choosing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Which One to Pack</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          At a campsite there is no grid coming back. The battery you leave the driveway with, plus whatever the car and the sun can put back, is all the electricity you get, so the right power station is the one sized to your daily load and your recharging plan, not the biggest one in the catalog.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="sizing" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Size to the Campsite, Not the Catalog
          </h2>

          <p>
            A power station for camping is a different purchase from one for the house. At home the question is how long you can keep a refrigerator alive until the grid comes back. At a campsite there is no grid coming back. The battery you leave the driveway with, plus whatever you can put back from the car and the sun, is all the electricity you will have until you get home. That makes camping energy a budgeting exercise: what you spend each day has to be matched by what you carry or what you can earn.
          </p>

          <p>
            The good news is that campsite loads are small. A 12V compressor cooler, LED lights, phones, a headlamp, a camera and a speaker rarely add up to more than a few hundred watt-hours a day. The bad news is that the few big items people bring, such as a CPAP with a heated humidifier, an electric kettle, an e-bike charger or a drone fleet, can each wipe out a small battery in one go. If you are also shopping for outage backup, our <a href="/best-portable-power-station/">main portable power station guide</a> covers the full range, including the large wheeled home units that make no sense at a campsite.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE SHORT ANSWER</p>
            <p class="text-xl font-bold text-white mb-3">Roughly 300Wh for tents, 1kWh for coolers, 2kWh for rigs.</p>
            <p class="text-gray-300 leading-relaxed m-0">For tent camping and day trips, a roughly 300Wh LFP unit such as the EcoFlow River 3 Plus covers lights, phones, cameras and a CPAP on DC, and with a 100 to 200W panel it can keep a small 12V cooler going too. For car camping with a cooler for several days, or overlanding, step up to a 1kWh class unit. For RVs and vans, a 2kWh unit runs a CPAP, fans, a TV and a coffee maker without a generator.</p>
          </div>

          <p>
            The table below adds a column you will not see on most spec sheets: watt-hours per pound. When every item has to be carried from the car to the site, or fitted into a van alongside water and food, energy per pound matters as much as capacity. All figures are the manufacturers' published capacity and approximate listed weight, rounded.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Power station</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Capacity</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">AC output</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Weight</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Wh per lb</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best trip</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">EcoFlow River 3 Plus</td>
                    <td class="px-4 py-4 text-gray-700">286Wh (expandable)</td>
                    <td class="px-4 py-4 text-gray-700">600W</td>
                    <td class="px-4 py-4 text-gray-700">~10 lb</td>
                    <td class="px-4 py-4 text-gray-700">~29</td>
                    <td class="px-4 py-4 text-gray-700">Tent weekends, day trips</td>
                  </tr>
