const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Tekton Tools Review",
          item: "https://www.allmetalbrake.com/tekton-tools-review/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Tekton a good brand for a beginner mechanic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Tekton's complete socket and wrench sets, readable markings and simple warranty make it an excellent starting point. A three-eighths drive set, combination wrenches and a click torque wrench cover most beginner jobs, from oil changes to brake work. The quality is high enough that you will not need to replace these tools as your skills grow."
          }
        },
        {
          "@type": "Question",
          "name": "Does Tekton need a receipt for warranty claims?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For hand tools, Tekton generally does not require a receipt or registration. Contact customer service with the broken tool and they will arrange a replacement. Precision instruments such as torque wrenches and some other products have different terms. Check Tekton's current warranty policy for the specific item before making a claim."
          }
        },
        {
          "@type": "Question",
          "name": "Where are Tekton tools manufactured?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most Tekton tools are made in Taiwan and China, which is common for mid-priced hand tools. Taiwanese factories in particular produce tools for many well-known brands. Product listings usually state country of origin. If buying American-made tools is a priority, check each listing rather than assuming based on the brand."
          }
        },
        {
          "@type": "Question",
          "name": "How do Tekton sockets compare with Snap-on?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Snap-on sockets often have thinner walls, finer finishes and on-site warranty service, and they cost several times as much. Tekton sockets fit well, use 6-point designs that resist rounding, and hold up to regular use. For home mechanics, Tekton delivers most of the function. For daily professional use, some prefer premium brands for specific tools."
          }
        },
        {
          "@type": "Question",
          "name": "Is a Tekton torque wrench accurate enough for wheels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Tekton's click torque wrenches are rated at about plus or minus 4 percent clockwise and include a calibration certificate. That is accurate enough for lug nuts, brakes and suspension. Store the wrench at its lowest setting, handle it carefully, and have it checked every year or two to keep it reliable."
          }
        },
        {
          "@type": "Question",
          "name": "Can I buy Tekton tools in a store?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tekton sells mainly online through its own website and Amazon. That keeps prices lower but means you cannot usually see the tools in person before buying. Read the listing details for sizes, drive and contents, and rely on the warranty if something arrives damaged or breaks later."
          }
        },
        {
          "@type": "Question",
          "name": "Is GearWrench better than Tekton?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the tool. GearWrench is generally stronger in ratchets and ratcheting wrenches, and it has a broader specialty range sold in stores. Tekton often wins on complete sets, organizers and warranty simplicity. Many mechanics combine the two, using GearWrench ratchets with Tekton sockets and wrenches for the best overall value."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
  ],
};
---

