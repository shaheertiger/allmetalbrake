---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/disadvantages-of-epoxy-flooring.html?raw';

const title = "Disadvantages of Epoxy Flooring: 13 Drawbacks to Know";
const description = "Epoxy peels on poor prep, yellows in sun, gets slick when wet and is hard to remove. 13 real drawbacks, why each happens, and how to avoid them.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
