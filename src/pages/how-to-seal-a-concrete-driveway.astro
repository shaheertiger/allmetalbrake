const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How to Seal a Concrete Driveway",
          item: "https://www.allmetalbrake.com/how-to-seal-a-concrete-driveway/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How long does it take to seal a concrete driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plan for about two to three days start to finish. Cleaning and repair take most of a day, the slab needs 24 to 48 hours to dry, and application takes two to three hours for a typical two-car driveway. Then allow about a day before driving on penetrating sealers and two to three for film sealers."
          }
        },
        {
          "@type": "Question",
          "name": "Should I use a sprayer or a roller?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For penetrating sealers, a pump sprayer is the best tool, with a roller or broom on hand to spread puddles. For film sealers, either a sprayer with back-rolling or a roller alone works; the roller helps keep coats thin and even. Solvent products need a sprayer with solvent-rated seals."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need two coats of sealer on a driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most penetrating sealers call for two passes, often applied wet-on-wet, to saturate the surface properly. Film sealers usually need two thin coats on bare concrete. When resealing a sound film, one thin coat may be enough. Always follow the specific product's directions."
          }
        },
        {
          "@type": "Question",
          "name": "Can I seal my driveway in the fall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, early fall is often ideal, provided temperatures stay within the label range day and night and the slab can dry completely. Sealing before the first deicer use gives the driveway protection for winter. Avoid late fall when nights drop near freezing or dew lingers on the surface."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if it rains after sealing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Light rain after a penetrating sealer has soaked in for several hours usually does little harm, though heavy rain soon after application can reduce effectiveness. Film sealers can cloud or wash out if rained on before curing. Do a water test after drying and touch up any weak areas."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to fill cracks before sealing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fill control joints and cracks wider than about an eighth of an inch with a flexible polyurethane sealant before sealing. Open joints let water into the base, which leads to heaving and settling. Hairline cracks can be left; penetrating sealers soak into them and reduce water entry."
          }
        },
        {
          "@type": "Question",
          "name": "How often should I reseal a concrete driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Penetrating sealers commonly last five to ten years, with heavily salted, high-traffic driveways at the low end. Film sealers usually need recoating every two to four years. Use a water test each fall rather than a fixed schedule, and spot-treat high-wear areas when they start absorbing water."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
  ],
};
