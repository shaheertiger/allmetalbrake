---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Self-Propelled Mowers for Sloped Lawns",
    "url": "/best-self-propelled-lawn-mower/"
  },
  {
    "title": "Gas Mowers for Thick Grass",
    "url": "/best-gas-lawn-mowers/"
  },
  {
    "title": "String Trimmers for Edging",
    "url": "/best-weed-eater/"
  },
  {
    "title": "Cordless Leaf Blowers",
    "url": "/best-cordless-leaf-blower/"
  },
  {
    "title": "Riding Mowers for Bigger Properties",
    "url": "/best-riding-lawn-mower/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 6 Best Mowers for Small Yards: Light, Quiet, Easy to Store";
const description =
  "Six mowers for lawns under a quarter acre: battery, corded, reel and robot, ranked by how they handle tight spaces, storage, slopes and your schedule.";

const PRODUCTS = [
  {
    "id": "greenworks-40v-16-25322",
    "name": "Greenworks 40V 16-Inch Cordless Mower (25322)",
    "category": "40V Battery | 16-in. Push | Lightweight",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "Light enough to carry up steps or lift onto a shelf",
      "16-inch deck turns easily in tight spaces",
      "Push-button start and no engine upkeep",
      "Batteries work across Greenworks 40V tools",
      "Low price for a cordless mower"
    ],
    "cons": [
      "Narrow deck means more passes",
      "Not suited to thick or overgrown grass"
    ],
    "bottomLine": "The simplest, most practical mower for a small, regularly mowed lawn.",
    "description": "The Greenworks 25322 is built for exactly the kind of lawn this guide is about. Its 16-inch deck is narrow by full-size standards, but on a small lawn with beds, paths and fences that is an advantage: it turns easily, fits through narrow side yards and does not leave you wrestling a heavy machine around corners. It is light enough to carry up a few steps or hang on a wall, and it starts with a button. Owners commonly report finishing a small lawn on one charge with regular mowing. The trade-offs are what you would expect. A narrow deck means more passes, and the motor is not designed for tall, thick or wet grass, so it suits owners who mow weekly. If your lawn is small and you keep up with it, this is the most sensible mower to buy. If the grass often gets long, consider the EGO instead."
  },
  {
    "id": "ego-power-lm2135sp",
    "name": "EGO Power+ LM2135SP 21-Inch Self-Propelled",
    "category": "56V Battery | RWD | Folding",
    "badge": "Best for Sloped Small Yards",
    "amazonUrl": "",
    "pros": [
      "Rear-wheel drive handles slopes and terraces",
      "Strong motor copes with thicker grass",
      "Folds flat for vertical storage",
      "Batteries shared across EGO's 56V line",
      "Quiet, no engine maintenance"
    ],
    "cons": [
      "More mower than a flat small lawn needs",
      "Higher price than compact battery mowers"
    ],
    "bottomLine": "The battery mower to choose if your small yard has slopes or thick grass.",
    "description": "The LM2135SP is a full-size battery mower, and on a flat 2,000-square-foot lawn it is more machine than you need. It earns a spot here because many small yards are not flat. Townhouse lots with terraced front yards, steep side strips and banked backyards are common, and pushing a mower up those slopes every week is tiring. Rear-wheel drive keeps traction where front-drive mowers slip, and the 56-volt motor handles thicker grass and occasional overgrowth better than compact mowers. It folds flat and can stand upright for storage, which helps in tight garages. Owners commonly praise its cut quality and quiet operation. The downside is price: it costs significantly more than the Greenworks, and the battery kit adds to that. If your small lawn is flat and mowed weekly, save the money. If it slopes or grows thick, this is worth it."
  },
  {
    "id": "fiskars-staysharp-max",
    "name": "Fiskars StaySharp Max 18-Inch Reel Mower",
    "category": "Push Reel | 18-in. | No Power",
    "badge": "Best Reel Mower",
    "amazonUrl": "",
    "pros": [
      "No fuel, battery or cord",
      "Scissor-like cut is gentle on grass",
      "Nearly silent operation",
      "Low maintenance",
      "Designed to push more easily than older reel mowers"
    ],
    "cons": [
      "Struggles with tall grass, twigs and weeds",
      "Requires regular mowing to work well"
    ],
    "bottomLine": "A quiet, zero-fuel option for small, flat lawns mowed often.",
    "description": "Reel mowers cut grass with a spinning cylinder of blades against a fixed bed knife, like scissors, which gives a clean cut that is gentle on the grass. The StaySharp Max is designed to push more easily than traditional reel mowers, with a cutting system that does not rub as it turns, and a wide 18-inch cutting path. With no motor, there is nothing to charge, fuel or tune, and it is almost silent. Owners commonly enjoy it for small, flat lawns of fine grasses mowed every few days. The limitations are real. Reel mowers struggle with tall grass, thick weeds and twigs, which can jam the reel. Coarse grasses and lawns with lots of debris are frustrating. Skip a week and you may need a second mower to catch up. If you mow often and have a small, smooth lawn, it is a satisfying, low-cost choice."
  },
  {
    "id": "sun-joe-mj401e",
    "name": "Sun Joe MJ401E 14-Inch Corded Mower",
    "category": "Corded Electric | 14-in. | Budget",
    "badge": "Best Corded Electric",
    "amazonUrl": "",
    "pros": [
      "Very low price",
      "Unlimited runtime while plugged in",
      "Light and easy to store",
      "No batteries to replace",
      "Simple push-button start"
    ],
    "cons": [
      "Cord limits range and needs managing",
      "Narrow deck and modest power"
    ],
    "bottomLine": "The cheapest reliable way to mow a tiny lawn near an outdoor outlet.",
    "description": "The MJ401E is about as simple as a powered mower gets. Plug it into an outdoor extension cord, press the button and mow. There is no battery to wear out and no fuel to store, and runtime is unlimited as long as you are plugged in. The 14-inch deck is narrow and the motor is modest, so it suits very small lawns: front yards, courtyard lawns and strips between a house and fence. It is light and folds for storage. The cord is the trade-off. You need an outdoor-rated extension cord of the right gauge and length, and you have to manage it so you do not run over it. Owners commonly suggest mowing in a pattern that works away from the outlet. If your lawn is tiny and close to an outlet, it is hard to beat on price."
  },
  {
    "id": "black-decker-bemw213",
    "name": "Black+Decker BEMW213 20-Inch Corded Mower",
    "category": "Corded Electric | 20-in. | Wider Deck",
    "badge": "Best Budget Pick",
    "amazonUrl": "",
    "pros": [
      "20-inch deck covers more ground than compact corded mowers",
      "Low price",
      "Unlimited runtime while plugged in",
      "Mulch and bag options",
      "No battery to replace"
    ],
    "cons": [
      "Cord management on larger lawns",
      "Heavier than compact mowers"
    ],
    "bottomLine": "A wider corded mower for small lawns that are a bit too big for a 14-inch deck.",
    "description": "The BEMW213 brings a wider 20-inch deck to the corded category, which means fewer passes on lawns approaching a quarter acre. It is still inexpensive, runs as long as it is plugged in and needs no battery replacements or engine maintenance. It offers bagging and mulching, and owners commonly describe it as a dependable, straightforward mower. The main limitation is the cord. On a larger lawn, you may need a long, heavy-gauge extension cord, and managing it around trees and beds takes practice. The mower is also heavier than compact options like the Sun Joe. If your small lawn is close to an outlet and you want a wider deck for a low price, this is a solid choice. If cord management bothers you, a battery mower is the better path."
  },
  {
    "id": "worx-landroid-wr147",
    "name": "Worx Landroid WR147 Robotic Mower",
    "category": "Robotic | Boundary Wire | App Control",
    "badge": "Best Robot Mower",
    "amazonUrl": "",
    "pros": [
      "Mows automatically on a schedule",
      "Frequent small cuts keep the lawn tidy",
      "Quiet enough to run while you are home",
      "App control and scheduling",
      "Returns to its base to charge"
    ],
    "cons": [
      "Requires boundary wire installation",
      "Slopes, narrow passages and obstacles may need extra setup"
    ],
    "bottomLine": "For owners who would rather never mow again and are willing to spend an afternoon on setup.",
    "description": "The Landroid is a robotic mower that cuts small amounts of grass often, which keeps the lawn looking consistently tidy and leaves fine clippings that disappear. It runs on a schedule you set in an app, returns to its charging station on its own, and is quiet enough to run while you are home. Setup is the big commitment. Like most robot mowers in this price range, it needs a boundary wire pegged or buried around the edge of the lawn and around beds, and narrow passages, steep slopes and complex layouts may need extra work. Check the area rating on the box against your lawn size. Owners commonly report that once installed, it works with little intervention, though you will still need a trimmer for edges. If you value time over the cost and setup, a robot mower is the most hands-off option for a small yard."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Small-Yard Mower Picks",
          item: "https://www.allmetalbrake.com/best-lawn-mower-for-small-yard/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which mower suits most small lawns?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most small lawns mowed regularly, a compact battery mower like the Greenworks 40V 16-inch is the most practical choice: light, quiet, easy to store and maintenance-free. If your small yard has slopes or thick grass, the EGO LM2135SP's rear-wheel drive and stronger motor are worth the extra cost. Either will fold for compact storage."
          }
        },
        {
          "@type": "Question",
          "name": "What cutting width works for a small lawn?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For lawns under about 1,500 square feet, a 13- to 16-inch deck is plenty. For 1,500 to 5,000 square feet, 16 to 19 inches balances coverage and maneuverability. Above about 5,000 square feet, a 19- to 21-inch deck saves time. Narrow strips and many obstacles favor narrower decks. Measure before you buy."
          }
        },
        {
          "@type": "Question",
          "name": "Does a reel mower make sense for my yard?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A reel mower makes sense for a small, smooth lawn of fine grasses that you mow every few days. It is quiet, needs no fuel or charging and gives a clean cut. It struggles with tall grass, weeds and twigs and is a poor fit if your schedule is irregular. Keep a trimmer for catching up after a missed week."
          }
        },
        {
          "@type": "Question",
          "name": "Should I get a robot mower for a small lawn?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A robot mower can be a good fit if you want to stop mowing and are willing to install a boundary wire. Check the area and slope ratings against your lawn, and expect to still use a trimmer for edges. For lawns with complex layouts, setup can be more involved. Many owners hire installation help for the first setup."
          }
        },
        {
          "@type": "Question",
          "name": "Does gas ever make sense on a compact lawn?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rarely. Gas mowers are heavier, louder and need fuel and oil maintenance. They make sense on small lawns only if the grass is very thick, often overgrown or the yard is large enough to strain battery runtime. For most small yards, battery or corded mowers are easier to own. Fuel storage is another hassle in small homes."
          }
        },
        {
          "@type": "Question",
          "name": "How often should a small lawn be mowed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mow often enough that you remove no more than about a third of the grass height at a time. During peak growth in spring, that may mean every five to seven days or more often. In summer heat or drought, growth slows and you can mow less frequently, with a higher cutting height."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a battery last on a small lawn?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A single battery from a reputable brand usually handles a small lawn with regular mowing. Runtime depends on battery capacity, grass height and moisture. If your lawn is near the upper end of small or the grass is often long, consider a larger battery or a spare. Rapid chargers also help on bigger lawns."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Lawn Mowers & Tractors",
    tags: [
      "best lawn mower for small yard",
      "small lawn mower",
      "cordless mower small yard",
      "reel mower",
      "corded electric mower",
      "robot mower small lawn"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 6 Best <span class="text-[#38BDF8]">Mowers for Small Yards</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A small lawn does not need a big machine. The right mower here is the one you can lift, store and start in ten seconds, and that leaves the grass looking good.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#greenworks-40v-16-25322"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="12.3k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#how-small" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. What Counts as Small</a>
          <a href="#power" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Power Source</a>
          <a href="#battery-platforms" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Batteries and Runtime</a>
          <a href="#deck" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Deck Width</a>
          <a href="#weight-storage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Weight and Storage</a>
          <a href="#slopes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Slopes and Terrain</a>
          <a href="#reel" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Reel Mowers</a>
          <a href="#corded" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Corded Mowers</a>
          <a href="#robots" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Robot Mowers</a>
          <a href="#noise-neighbors" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Noise and Neighbors</a>
          <a href="#mowing-well" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. Mowing a Small Lawn Well</a>
          <a href="#upkeep" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">13. Upkeep</a>
          <a href="#which-owner" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">14. Type by Owner</a>
          <a href="#cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">15. What to Spend</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">16. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">17. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most small-yard owners buy too much mower. A 21-inch self-propelled gas machine will cut a 2,000-square-foot lawn, but it is heavy, loud, needs fuel and oil, and takes up a corner of the garage for the ten minutes a week it is used. For lawns under about a quarter acre, the better questions are where the mower will live, whether you have an outlet nearby, how often you mow and whether the ground slopes. Answer those and the choice usually makes itself.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 6 Best Small-Yard Mowers, Ranked
          </h2>

          <p>
            These picks rely on manufacturer specifications (deck width, power source, weight where published, warranty), storage design and recurring patterns in owner reviews. We have not put these mowers through our own trials; where something comes from a spec sheet or owner feedback, the description says so.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-gray-500 text-sm font-bold">{product.rating}</span>
                    <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} ratings on Amazon)</span>
                  </div>
                  )}

                  <p class="text-gray-700 leading-relaxed mb-6">{product.description}</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 rounded-xl p-4">
                      <p class="text-xs font-black uppercase tracking-widest text-green-700 mb-3">Pros</p>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="flex items-start gap-2 text-sm text-green-800">
