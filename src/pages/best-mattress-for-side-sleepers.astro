const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Mattress for Side Sleepers",
          item: "https://www.allmetalbrake.com/best-mattress-for-side-sleepers/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best mattress for side sleepers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most side sleepers, a medium hybrid with a thick comfort layer and zoned support works best. Our top pick is the Helix Midnight Luxe, which Helix designed around side sleepers. Lighter side sleepers may prefer something softer, such as the Purple Restore Soft, while heavier side sleepers should look at a sturdier hybrid like the Brooklyn Signature."
          }
        },
        {
          "@type": "Question",
          "name": "Should side sleepers get a soft or firm mattress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most side sleepers do best on a soft to medium mattress, not a firm one. The shoulder and hip need to sink in so the spine stays straight. Body weight shifts the answer: under about 130 pounds, go soft to medium-soft; between 130 and 230, medium; above 230, medium to medium-firm with coil support."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best mattress for side sleepers with hip pain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Look for a soft or medium mattress with a thick, pressure-relieving top layer and enough support underneath to keep the pelvis level. The Purple Restore Soft and Helix Midnight Luxe both fit. A pillow between the knees also helps keep the hips stacked. Persistent hip pain should be checked by a doctor or physical therapist."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best mattress for side sleepers with back pain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A medium mattress with zoned or firmer lumbar support suits side sleepers with back pain, because it cushions the shoulder while keeping the waist from sagging. The Helix Midnight Luxe uses firmer coils under the lower back. If pain is persistent, runs down a leg or comes with numbness, see a doctor or physical therapist."
          }
        },
        {
          "@type": "Question",
          "name": "Is memory foam or hybrid better for side sleepers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both work. Memory foam gives the deepest contouring and suits lighter side sleepers who like a hugging feel and do not move much. Hybrids add coil support and bounce, so they suit heavier side sleepers, combination sleepers and hot sleepers better. Hybrids generally cost more, which is why most budget picks are foam."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my shoulder hurt when I sleep on my side?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Often the mattress is too firm, so the shoulder cannot sink and takes too much of your weight. A pillow that is too low can add to the strain. A softer mattress or topper and a higher pillow may help. Shoulder pain that lasts, or comes with weakness, should be assessed by a doctor or physical therapist."
          }
        },
        {
          "@type": "Question",
          "name": "Can a mattress topper make a firm mattress better for side sleeping?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if the mattress is otherwise in good shape. A 2- to 3-inch memory foam or latex topper adds the cushioning a side sleeper's shoulder and hip need, at a fraction of the cost of a new bed. A topper will not fix a mattress that sags or has a body impression, though."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Sleep & Mattresses",
    tags: [
      "best mattress for side sleepers",
      "best mattress for side sleepers with hip pain",
      "best mattress for side sleepers with back pain",
      "mattress for shoulder pain",
      "best firmness for side sleepers",
      "hybrid vs memory foam for side sleepers"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The 7 Best Mattresses for Side Sleepers
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          A medium-feel hybrid with a thick pressure-relieving comfort layer over zoned coils wins for most side sleepers, because it lets the shoulder and hip sink in while firmer support holds the waist up and keeps the spine level. Here are the seven worth a look, matched to body weight, hip pain and back pain.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
