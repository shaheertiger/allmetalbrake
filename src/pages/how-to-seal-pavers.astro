---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/how-to-seal-pavers.html?raw';

const title = "How to Seal Pavers: Step-by-Step DIY Guide";
const description = "When new pavers can be sealed, how to clean and re-sand first, the weather window, spraying and back-rolling thin coats, and fixes for haze and peeling.";
