                                <th class="py-3 px-4 text-left font-bold text-gray-900">Total 20-year cost</th>
                                <th class="py-3 px-4 text-left font-bold text-gray-900">Cost per year</th>
                            </tr>
                        </thead>
                        <tbody class="text-gray-700 divide-y divide-gray-200">
