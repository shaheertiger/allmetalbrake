                            </tr>
                            <tr>
                                <td class="py-3 px-4 font-semibold">Coal Tar Emulsion</td>
                                <td class="py-3 px-4">$140–$220</td>
                                <td class="py-3 px-4">4–6</td>
                                <td class="py-3 px-4">$560–$1,320</td>
                                <td class="py-3 px-4">$28–$66</td>
                            </tr>
                            <tr class="bg-gray-50">
                                <td class="py-3 px-4 font-semibold">Acrylic Polymer Sealer</td>
