                                <td class="py-3 px-4 font-semibold">Basic Asphalt Emulsion</td>
                                <td class="py-3 px-4">$80–$120</td>
                                <td class="py-3 px-4">7–10</td>
                                <td class="py-3 px-4">$560–$1,200</td>
