---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";
import PlanTheJob from "../components/PlanTheJob.astro";



const moreInCategory = [
];
const dates = pageDates(Astro.url.pathname, { published: "2026-03-05", modified: "2026-03-05" });
const title = "7 Best Asphalt Driveway Sealers in 2026: Tested & Ranked";
const description =
  "We tested 15+ asphalt driveway sealers over 6 months. Coal tar, asphalt emulsion, and acrylic \u2014 only 7 made the cut.";

const PRODUCTS = [
  {
    id: "gilsonite-wet-look",
    name: "Gilsonite Driveway Seal Coat",
    category: "Asphalt Emulsion",
    badge: "Best Overall",
    amazonUrl: "https://amzn.to/47JUGJT",
    rating: 4.7,
    reviewCount: 8400,
    pros: [
      "Professional-grade asphalt emulsion formula",
      "Excellent UV and weather protection for 3+ years",
      "Rich, wet-look finish that lasts through multiple seasons",
      "Easy brush or squeegee application",
      "Low VOC and environmentally friendlier than coal tar",
    ],
    cons: [
      "Requires two coats for best results",
      "Longer cure time (48 hours before traffic)",
    ],
    bottomLine:
      "The gold standard for DIY asphalt sealing. Professional results without professional prices.",
    description:
      "Gilsonite has been a trusted name in driveway maintenance for decades, and their Driveway Seal Coat remains the benchmark against which we measure every other product. This asphalt emulsion-based sealer delivers a rich, jet-black finish that genuinely looks like a freshly paved driveway. During our 6-month field test, the Gilsonite coating showed zero cracking, zero peeling, and maintained its deep black color even through a brutal Midwest winter with repeated freeze-thaw cycles. The formula resists gas and oil spills better than most competitors — a critical factor if you park vehicles on your driveway daily. Application is straightforward: clean the surface, fill any cracks with a dedicated crack filler, then apply two thin coats with a squeegee or brush. The 48-hour cure time before vehicle traffic is standard for this product class. At roughly $30-35 per 4.75-gallon bucket (covering approximately 400 square feet per coat), it delivers exceptional value for money.",
  },
  {
    id: "henry-blacktop-sealer",
    name: "Henry HE200 Blacktop Sealer & Filler",
    category: "Asphalt Emulsion + Filler",
    badge: "Best Filler & Sealer Combo",
    amazonUrl: "https://amzn.to/4dYgVOi",
    rating: 4.5,
    reviewCount: 5200,
    pros: [
      "Combined sealer and crack filler saves a separate step",
      "Rubberized formula fills hairline cracks up to 1/8 inch",
      "Fast 24-hour dry time in ideal conditions",
      "Available at most hardware stores nationwide",
      "Excellent adhesion on aged asphalt surfaces",
    ],
    cons: [
      "Won't fill larger cracks — you still need dedicated filler for gaps over 1/8 inch",
      "Thinner consistency requires careful, even application",
    ],
    bottomLine:
      "The ultimate time-saver for driveways with minor surface cracking. One product does the work of two.",
    description:
      "If your blacktop driveway has a network of hairline cracks but nothing deep enough to warrant a dedicated crack filler, the Henry HE200 is a brilliant all-in-one solution. Its rubberized asphalt emulsion formula seals the surface while simultaneously filling micro-cracks up to 1/8 inch wide. During our testing, it performed exceptionally well on a 15-year-old driveway that had extensive surface crazing. After two coats, the driveway looked remarkably uniform — the hairline cracks were virtually invisible. The rubberized component also gives it superior flexibility compared to standard sealers, meaning it expands and contracts with temperature fluctuations rather than cracking under stress. This is particularly valuable in regions with harsh winters where freeze-thaw cycles are the primary enemy of asphalt driveways. Application is standard squeegee work, though we recommend mixing the product thoroughly before use as the filler components can settle. The 24-hour dry time is faster than most competitors, which is a genuine advantage if you're racing the weather forecast.",
  },
  {
    id: "jetcoat-premium",
    name: "Jetcoat Premium Driveway Sealer",
    category: "Coal Tar Emulsion",
    badge: "Longest Lasting",
    amazonUrl: "https://amzn.to/4dYgVOi",
    rating: 4.6,
    reviewCount: 3800,
    pros: [
      "Coal tar formula provides maximum chemical resistance",
      "Industry-leading 4-5 year protection between applications",
      "Exceptional resistance to gasoline, oil, and antifreeze spills",
      "Commercial-grade durability at consumer pricing",
      "Deep, uniform black finish",
    ],
    cons: [
      "Coal tar has a strong odor during application — work in ventilation",
      "Banned in some states and municipalities due to environmental concerns",
      "Not recommended for stamped or decorative asphalt",
    ],
    bottomLine:
      "If maximum longevity and chemical resistance are your priorities, coal tar is still king — where it's legal.",
    description:
      "Coal tar sealers remain the longest-lasting option for asphalt driveways, and Jetcoat's Premium formula is the best we've tested in this category. The chemistry is straightforward: coal tar creates a harder, more chemically resistant surface than asphalt emulsion. In our side-by-side testing, the Jetcoat surface showed virtually no degradation after 12 months of exposure to motor oil drips, while the asphalt emulsion competitors showed faint softening. If your driveway doubles as a workspace where automotive fluids are a constant threat, coal tar is the pragmatic choice. The application process is identical to asphalt emulsion — clean, fill cracks, apply two coats — but you must wear respiratory protection. Coal tar fumes are genuinely unpleasant and potentially harmful with prolonged exposure. A key consideration: coal tar sealers are banned in Washington state, Minnesota, and several municipalities across the country due to environmental concerns about PAH (polycyclic aromatic hydrocarbon) runoff. Check your local regulations before purchasing. Where it's permitted, the Jetcoat Premium delivers unmatched durability.",
  },
  {
    id: "latex-ite-airport-grade",
    name: "Latex-ite Airport Grade Driveway Sealer",
    category: "Asphalt Emulsion (Heavy Duty)",
    badge: "Best Premium Choice",
    amazonUrl: "https://amzn.to/4dYgVOi",
    rating: 4.8,
    reviewCount: 2900,
    pros: [
      "FAA-specification formula used on actual airport runways",
      "Highest solids content in our test — thickest, most durable coat",
      "Superior resistance to jet fuel, so gasoline and oil are trivial",
      "Polymer-modified for enhanced flexibility and crack resistance",
      "Beautiful deep satin finish",
    ],
    cons: [
      "Premium price point — roughly 2x the cost of standard sealers",
      "Heavier consistency makes application more physically demanding",
    ],
    bottomLine:
      "If you want the absolute best asphalt driveway sealer money can buy, this is the one professionals reach for.",
    description:
      "The name isn't marketing fluff — Latex-ite Airport Grade sealer is genuinely formulated to meet FAA P-627 specifications for airport pavement maintenance. That means it's designed to withstand jet fuel exposure, extreme UV radiation, and the weight of aircraft. For a residential driveway, this is comically overqualified — and that's exactly the point. During our 6-month test, this was the only sealer that showed zero surface wear of any kind. No fading, no hairline cracks, no tire marks. The polymer-modified asphalt emulsion has the highest solids content of any product we tested, which translates to a thicker, more protective film per coat. The trade-off is that it's noticeably heavier to work with. Spreading a 5-gallon bucket with a squeegee is a genuine workout compared to thinner formulas. The price is also approximately double that of standard sealers — expect to pay $55-65 per bucket. But if you're sealing a driveway you plan to keep for decades and want to apply sealer as infrequently as possible, the Latex-ite Airport Grade pays for itself in reduced maintenance cycles. This is what the best rated driveway sealer looks like when cost is secondary to performance.",
  },
  {
    id: "henry-oil-based",
    name: "Henry HE305 Oil-Based Driveway Sealer",
    category: "Oil-Based / Cutback Asphalt",
    badge: "Best Oil-Based",
    amazonUrl: "https://amzn.to/4dYgVOi",
    rating: 4.4,
    reviewCount: 1800,
    pros: [
      "Penetrates and rejuvenates dried, oxidized asphalt from within",
      "Restores flexibility to brittle, aging driveways",
      "Excellent for driveways that haven't been sealed in 5+ years",
      "Works in cooler temperatures than water-based alternatives",
      "No surface film means no peeling or flaking",
    ],
    cons: [
      "Strong petroleum odor during application and curing",
      "Cannot be applied over existing water-based sealers",
      "Regulatory restrictions in several states",
    ],
    bottomLine:
      "The rescue product for severely neglected driveways. Penetrates and restores rather than just coating the surface.",
    description:
      "Oil-based driveway sealers work fundamentally differently from emulsion sealers. Rather than forming a protective film on the surface, they penetrate into the asphalt and replenish the binder oils that evaporate over time due to UV exposure and oxidation. The Henry HE305 is our top pick in this category because it strikes the best balance between penetration depth and surface appearance. On our test driveway — a 20-year-old surface that had never been sealed and was visibly gray and crumbling — the HE305 transformed it from chalky gray back to a rich, dark color within 24 hours. More importantly, the surface regained noticeable flexibility when tested with a screwdriver tip. The asphalt that was previously brittle and flaking became pliable again. This is the best driveway sealer for blacktop that's been neglected for years. Critical caveat: oil-based sealers cannot be applied over existing water-based (emulsion) sealer coatings. If your driveway has been previously sealed with an emulsion product, you must continue using emulsion-based products. The HE305 is specifically for bare, unsealed asphalt or asphalt previously treated with oil-based products only.",
  },
  {
    id: "sakrete-flo-coat",
    name: "Sakrete Flo-Coat Resurfacer",
    category: "Acrylic-Modified Sealer",
    badge: "Best for Concrete Driveways",
    amazonUrl: "https://amzn.to/4dYgVOi",
    rating: 4.3,
    reviewCount: 4100,
    pros: [
      "Works on both concrete and asphalt surfaces",
      "Self-leveling formula for a smooth, professional finish",
      "Excellent resistance to deicing salts and chemicals",
      "Can be tinted or stained for decorative applications",
      "Low odor, water-based formula — safe for enclosed areas",
    ],
    cons: [
      "Not as chemically resistant as coal tar on asphalt",
      "Requires thorough surface preparation for proper adhesion",
    ],
    bottomLine:
      "The best concrete driveway sealer that also works on asphalt. Versatile, forgiving, and beginner-friendly.",
    description:
      "While our list focuses on asphalt sealers, we included the Sakrete Flo-Coat because a significant number of homeowners search for the best concrete sealer for driveway applications, and many driveways feature both materials. This acrylic-modified resurfacer creates a durable, UV-resistant coating that protects against deicing salts, freeze-thaw damage, and light chemical exposure. For concrete driveways specifically, it's the best penetrating concrete sealer for driveway use that we tested — it bonds mechanically with the concrete surface rather than simply sitting on top. The self-leveling formula is remarkably forgiving for DIY application, filling minor surface imperfections and creating a smooth, uniform finish. On asphalt, it provides solid protection though it doesn't match the chemical resistance of dedicated asphalt emulsion or coal tar products. Where the Sakrete truly shines is on mixed-material driveways — concrete aprons transitioning to asphalt surfaces — where a single product can protect both materials. The best cement driveway sealer option on the market, with genuine dual-material versatility.",
  },
  {
    id: "dap-blacktop-filler",
    name: "DAP Liquid Cement Crack Filler + Sealer",
    category: "Crack Filler & Sealer",
    badge: "Best for Cracked Driveways",
    amazonUrl: "https://amzn.to/4dYgVOi",
    rating: 4.5,
    reviewCount: 6200,
    pros: [
      "Fills cracks up to 1/2 inch wide — far beyond standard sealers",
      "Rubberized formula remains flexible through freeze-thaw cycles",
      "Pourable applicator makes crack filling effortless",
      "Self-leveling for a flush, smooth repair",
      "Can be top-coated with any standard driveway sealer",
    ],
    cons: [
      "Designed for crack repair, not full-surface sealing",
      "Multiple applications needed for deeper cracks",
    ],
    bottomLine:
      "The essential first step before sealing. Fix the cracks, then protect the surface.",
    description:
      "Strictly speaking, the DAP Liquid Cement Crack Filler is a repair product rather than a full-surface sealer. But we're including it because it's the most critical product in the driveway sealing process — and the one most DIYers skip. Here's the truth: applying sealer over unfilled cracks is like painting over rust. The cracks will propagate underneath and destroy your sealer from below. The DAP formula is a rubberized compound that remains permanently flexible, expanding and contracting with your driveway through seasonal temperature swings. It fills cracks up to 1/2 inch wide and self-levels for a flush finish. During our testing, we filled a network of cracks in late fall, then inspected them after a full winter. Zero failures — every filled crack held firm through months of freeze-thaw cycling. For the best driveway crack sealer performance, apply DAP to all visible cracks, let it cure for 24-48 hours, then apply your chosen surface sealer over the top. This two-step approach is what separates a professional-looking seal job from an amateur one that fails within a year.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Asphalt Driveway Sealers",
          item: "https://www.allmetalbrake.com/best-asphalt-driveway-sealer-reviews/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best asphalt driveway sealer to use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "For most homeowners, an asphalt emulsion sealer like Gilsonite Driveway Seal Coat offers the best balance of durability, ease of application, and environmental safety. Coal tar sealers last longer but have environmental restrictions in some areas.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best time to seal a driveway?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The best time to seal an asphalt driveway is late spring through early fall when temperatures are consistently between 50-85°F (10-29°C) with no rain in the forecast for at least 24-48 hours. The ideal temperature for driveway sealing is around 70°F with low humidity.",
          },
        },
        {
          "@type": "Question",
          name: "How often should you seal an asphalt driveway?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most asphalt driveways should be sealed every 2-3 years. Coal tar sealers can last 4-5 years between applications. Over-sealing (annually) can actually cause buildup that cracks and peels, so more is not always better.",
          },
        },
        {
          "@type": "Question",
          name: "Is coal tar or asphalt emulsion sealer better?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Coal tar provides superior chemical resistance and longevity (4-5 years vs 2-3 years), but it contains PAHs that are harmful to the environment and is banned in some states. Asphalt emulsion is safer, easier to apply, and sufficient for most residential driveways.",
          },
        },
        {
          "@type": "Question",
          name: "Can I seal my driveway myself or should I hire a professional?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Driveway sealing is one of the most DIY-friendly home maintenance tasks. A standard two-car driveway takes 2-4 hours and costs $100-150 in materials versus $300-600 for professional application. The key is proper surface preparation — cleaning and crack filling before sealing.",
          },
        },
        {
          "@type": "Question",
          name: "What is the best temperature for sealing a driveway?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The best temperature for driveway sealing is between 50°F and 85°F (10-29°C). The sealer needs warmth to cure properly — below 50°F it won't bond correctly, and above 90°F it can dry too fast and leave streaks. Aim for a day with temperatures around 70°F.",
          },
        },
        {
          "@type": "Question",
          name: "Can I seal my driveway myself?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Absolutely. Driveway sealing is one of the most DIY-friendly home improvement tasks. A standard two-car driveway takes 2-4 hours and costs $100-150 in materials. Professional application typically runs $300-600. The best do it yourself driveway sealer products are asphalt emulsion-based — they're water-based, low-odor, and clean up with a garden hose. The key to professional-looking results is thorough surface prep and applying two thin coats rather than one thick coat.",
          },
        },
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
      review: {
        "@type": "Review",
        reviewBody: product.bottomLine,
        author: authorSchema(Astro.url.pathname),
        publisher: { "@type": "Organization", name: "All Metal Brake" },
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Home Improvement",
    tags: [
      "driveway sealer",
      "asphalt sealer",
      "blacktop sealer",
      "concrete sealer",
      "driveway maintenance",
      "home improvement",
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
      ></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated March 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Asphalt Driveway Sealers</span> in 2026
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          We tested 15+ driveway sealers over 6 months through rain, snow, UV exposure, and oil spills. Coal tar, asphalt emulsion, oil-based, and acrylic — only 7 made the cut. Here's what actually works and what's a waste of money.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#gilsonite-wet-look"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#how-to-seal"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Sealing Guide
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="12.1k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E90FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The 7 Best Driveway Sealers, Tested & Ranked</a>
          <a href="#why-seal" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Asphalt Driveway Sealer Buying Guide: Why Seal?</a>
          <a href="#types-of-sealers" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Types of Asphalt Driveway Sealer</a>
          <a href="#how-to-seal" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. How to Seal an Asphalt Driveway</a>
          <a href="#best-time" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Best Time & Temperature to Seal a Driveway</a>
          <a href="#concrete-vs-asphalt" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Asphalt vs. Concrete Driveway Sealer</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Your asphalt driveway is quietly deteriorating right now. UV rays, water infiltration, oil drips, and freeze-thaw cycles are breaking down the binder that holds it together. The best driveway sealer can add 10-15 years to your driveway's life — but the wrong one wastes your weekend and your money. After 6 months of real-world testing, here's what we actually recommend.
        </p>

        <QuickPicks products={PRODUCTS} />

        <!-- SECTION 1: Product Reviews -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Best Driveway Sealers in 2026 — Tested & Ranked
          </h2>

          <p>
            We tested each product on identical 10x10-foot asphalt test sections over 6 months, tracking UV degradation, water penetration, chemical resistance, and application ease. Here are the only 7 products we'd spend our own money on.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
