];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 6 Best Asphalt Driveway Sealers, Ranked and Reviewed";
const description =
  "Six asphalt driveway sealers ranked by formula, label coverage and real-world fit, plus how many pails you need and when a pro sealcoat beats a DIY job.";

const PRODUCTS = [
  {
