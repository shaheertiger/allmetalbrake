              <a href="#application" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Application</span></a>
              <a href="#timing" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>Weather & Timing</span></a>
              <a href="#diy-vs-pro" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>DIY vs Pro</span></a>
