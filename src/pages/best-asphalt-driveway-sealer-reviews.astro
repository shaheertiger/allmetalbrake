const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Asphalt Driveway Sealers",
          item: "https://www.allmetalbrake.com/best-asphalt-driveway-sealer-reviews/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which asphalt driveway sealer should most homeowners buy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a typical driveway that has started to fade, a polymer-modified, filled asphalt emulsion such as Latex-ite Airport Grade is the safest choice. It has enough body to cover moderate wear, cleans up with water, and is widely stocked so you can buy matching pails. If the driveway is smooth and you care most about the finish, Black Jack Drive-Maxx 1000 is the premium alternative."
          }
        },
        {
          "@type": "Question",
          "name": "Is coal tar sealer better than asphalt emulsion?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Coal tar resists gasoline and oil better, which matters on commercial lots with heavy drips. For a home driveway that advantage is small, and coal tar carries real drawbacks: strong odor, skin and eye irritation during application, and high levels of compounds that research has linked to contaminated dust and runoff. Several states and many cities ban it. A good asphalt emulsion is the better home choice."
          }
        },
        {
          "@type": "Question",
          "name": "How long does an asphalt driveway sealer last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Expect two to three years on most residential driveways, regardless of the number printed on the pail. Heavy traffic, full sun, snowplows and a thin first coat shorten that. Shade, light traffic and two well-applied coats lengthen it. The water test is the best guide: when water soaks in rather than beading, the surface is ready for a new coat."
          }
        },
        {
          "@type": "Question",
          "name": "Can I apply sealer over cracks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hairline cracks are fine under a filled sealer, which bridges them. Anything wider than about an eighth of an inch should be cleaned out and filled with a dedicated crack filler first, then allowed to cure. Sealer alone over an open crack simply sinks in and leaves a channel for water, and the crack will be visible again within weeks."
          }
        },
        {
          "@type": "Question",
          "name": "How many pails of sealer do I need for a two-car driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Measure the area, divide by the coverage on the label, and double it for two coats. A 600-square-foot driveway with a product rated at 300 square feet per pail needs about four pails, plus one spare for a porous surface. Old, gray asphalt can absorb noticeably more than the label figure on the first coat, so round up rather than down."
          }
        },
        {
          "@type": "Question",
          "name": "Should I use a squeegee or a brush?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A squeegee is faster and leaves a smoother finish, which suits filled sealers on a reasonably smooth driveway. A stiff brush works sealer into rough, open texture better. On older asphalt, many people brush the first coat to push material into the surface and squeegee the second coat for an even appearance. Use a brush for edges either way."
          }
        },
        {
          "@type": "Question",
          "name": "How soon can I drive on a newly sealed driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most labels call for 24 to 48 hours before vehicle traffic, and longer in cool or humid weather. Walking on it is usually fine after a few hours once it is dry to the touch. For the first week or so, avoid turning the steering wheel while the car is stopped, because that twists the tires against the soft surface and leaves scuff marks."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
