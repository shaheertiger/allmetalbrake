---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/how-to-get-rid-of-mold-in-basement.html?raw';

const title = "How to Get Rid of Mold in a Basement: Step-by-Step Guide";
const description = "Remove basement mold safely: EPA's 10 sq ft DIY limit, the right respirator, why bleach isn't the default, what to throw out, and how to stop mold returning.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
