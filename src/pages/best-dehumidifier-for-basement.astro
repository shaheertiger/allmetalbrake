                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Up to 1,000 sq ft</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">1,000-1,500 sq ft</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">1,500-2,500 sq ft</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Musty in summer only</td>
