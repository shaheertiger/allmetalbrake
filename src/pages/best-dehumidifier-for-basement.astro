---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Air Purifiers for Mold",
    "url": "/best-air-purifier-for-mold/"
  },
  {
    "title": "Best Mold Removers",
    "url": "/best-mold-remover/"
  },
  {
    "title": "Best Whole House Fans",
    "url": "/best-whole-house-fan/"
  },
  {
    "title": "Best Heat Pump Water Heaters",
    "url": "/best-heat-pump-water-heater/"
  },
  {
    "title": "How to Waterproof a Basement",
    "url": "/how-to-waterproof-a-basement/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 7 Best Basement Dehumidifiers: Sized for Damp, Cool Rooms";
const description =
  "Seven basement dehumidifiers ranked by real capacity, drainage, and cold-room performance, plus how to size one, where to put it, and what it costs to run.";

const PRODUCTS = [
  {
    "name": "Frigidaire 50-Pint Dehumidifier (FFAD5033W1)",
    "badge": "Best Overall",
    "category": "Portable Compressor, 50 Pint",
    "amazonUrl": "",
    "id": "frigidaire-ffad5033w1",
    "pros": [
      "Energy Star certified, so running cost stays reasonable on long duty cycles",
      "Continuous-drain port accepts a standard garden hose",
      "Simple controls with a humidity readout and auto-restart after outages",
      "Washable filter with a reminder light",
      "Widely stocked, so replacement parts and service are easy to find"
    ],
    "cons": [
      "Gravity drain only; the hose must run downhill to a floor drain",
      "Bucket fills in well under a day in a genuinely wet basement"
    ],
    "bottomLine": "A dependable, efficient 50-pint machine for the typical finished or semi-finished basement that has a floor drain nearby.",
    "description": "The Frigidaire 50-pint earns the top spot because it does the ordinary basement job without drama. It is Energy Star certified, it restarts on its own after a power cut with your settings intact, and it has a hose port on the back so you can skip the bucket entirely if a floor drain sits lower than the unit. Most basements between roughly 1,000 and 1,500 square feet with moderate dampness are well within its range. The controls are plain: a target humidity, fan speed, and a continuous mode for very wet days. That simplicity is a strength in a room you visit twice a week. Owner feedback is broadly positive about how quickly it pulls a musty space down into the 40s, with the usual complaints centered on bucket size and fan noise on high. The limitation is drainage. There is no pump, so if your only drain is a laundry sink or a sump pit across the room, look at the GE pump model instead. For a basement with a floor drain, this is the one to buy."
  },
  {
    "name": "Aprilaire E080 Pro",
    "badge": "Best for Whole Basements",
    "category": "Fixed Whole-Basement Unit, About 80 Pints",
    "amazonUrl": "",
    "id": "aprilaire-e080-pro",
    "pros": [
      "Rated for large spaces, roughly 2,000-plus square feet per the maker",
      "Designed to operate in cooler basement air than portable units",
      "Can be ducted to pull air from several rooms",
      "Long warranty compared with portable units",
      "Remote-mounted controls let you place the unit out of sight"
    ],
    "cons": [
      "Costs several times what a portable 50-pint unit does",
      "Professional installation is recommended for ducted setups"
    ],
    "bottomLine": "The step up when a portable unit keeps running and losing, or when the basement is large, open, and persistently damp.",
    "description": "Aprilaire builds the E080 as a fixed, whole-space dehumidifier rather than a rolling appliance, and that difference shows up in the details. It is rated around 80 pints per day, it is designed to keep working in the cooler air that makes portable units ice up, and it can be ducted so one machine draws from a utility room, a finished rec room, and a storage area at once. Condensate leaves through a drain line instead of a bucket, so there is nothing to empty. The trade-off is cost. Expect to pay roughly $1,300 to $1,800 for the unit at the time of writing, plus installation if you duct it. That is hard to justify for a small or only mildly damp basement, and a portable will do the job there. It becomes the sensible buy when you have already burned through a portable unit or two, when the space is large and open, or when the basement is finished and you want the machine hidden in a mechanical room. Owners commonly report it runs far less often than the portable it replaced."
  },
  {
    "name": "Midea Cube 50-Pint Dehumidifier",
    "badge": "Best Bucket Design",
    "category": "Portable Compressor, Stacking Design",
    "amazonUrl": "",
    "id": "midea-cube-50-pint",
    "pros": [
      "Bucket sits below the unit and holds far more water than a typical pull-out bucket",
      "Compact footprint that fits under stairs or in a corner",
      "App control and humidity alerts on Wi-Fi models",
      "Energy Star certified",
      "Pump version available for upward drainage"
    ],
    "cons": [
      "Stacked design is tall when assembled",
      "App setup draws mixed owner feedback"
    ],
    "bottomLine": "The best choice when you must use the bucket, because its oversized tank stretches the time between trips downstairs.",
    "description": "The Midea Cube solves the most annoying part of owning a basement dehumidifier: the bucket. Instead of a small drawer tucked inside the cabinet, the Cube sits on top of a large tank, so it can run far longer before it shuts off and waits for you. When you are done for the season, the tank nests inside for storage and the whole thing takes up surprisingly little floor space. That makes it a strong pick for a basement without a nearby floor drain, where a hose is not an option and a pump model would be overkill. The Wi-Fi versions send a notification when the tank is full or humidity climbs, which is genuinely useful for a room you might not check every day. Midea also sells a version with a built-in pump if you want to drain into a laundry sink. Owners like the capacity and the footprint; the most common complaints concern the app pairing process. It is Energy Star certified, and its humidity control holds a set point well once it has brought the space down."
  },
  {
    "name": "GE 50-Pint Dehumidifier with Pump (APER50LZ)",
    "badge": "Best with Pump",
    "category": "Portable Compressor with Pump",
    "amazonUrl": "",
    "id": "ge-aper50lz-pump",
    "pros": [
      "Built-in pump pushes water up and across the room to a sink or window",
      "Energy Star certified",
      "Smart models offer app control and alerts",
      "Bucket remains usable if you prefer not to run the pump line",
      "Auto-restart after power loss"
    ],
    "cons": [
      "Pumps add a failure point and a little noise",
      "Pump line should be checked periodically for kinks and slime"
    ],
    "bottomLine": "Buy this when the nearest drain is a laundry sink, a sump pit, or anywhere above the unit.",
    "description": "A built-in pump changes where a dehumidifier can live. Gravity hoses need to run downhill, which rules out a lot of basements whose only drain is a laundry tub, a sump pit with a lid, or a window well. The GE APER50LZ carries a pump that lifts condensate through a thin tube to wherever it needs to go, so the machine can sit in the dampest corner instead of the most convenient one. It is a 50-pint Energy Star model, which covers most basements up to roughly 1,500 square feet, and smart versions add alerts and remote control. Owners are generally pleased with how much attention it saves, since a dehumidifier that never shuts off for a full bucket keeps humidity steady instead of letting it rebound. The pump is an extra part that can fail, so register the warranty and keep the line clean; a bit of slime in the tube is the usual cause of pump-error codes. If you have a floor drain right there, save money and buy a gravity model."
  },
  {
    "name": "hOmeLabs Energy Star Dehumidifier, 50 Pint",
    "badge": "Best Value",
    "category": "Portable Compressor, Budget",
    "amazonUrl": "",
    "id": "homelabs-50-pint",
    "pros": [
      "Usually priced well below the big appliance brands",
      "Energy Star certified",
      "Continuous-drain hose port",
      "Simple timer and humidity controls",
      "Light enough to move between rooms"
    ],
    "cons": [
      "No pump on the standard model",
      "Durability reports are more mixed over several seasons"
    ],
    "bottomLine": "A sensible way to fix a damp basement on a tight budget, as long as you keep the receipt and register the warranty.",
    "description": "The hOmeLabs 50-pint has been one of the most popular budget dehumidifiers for years because it covers the basics at a price that often undercuts the big names by a meaningful margin. It is Energy Star certified, it has a hose port for continuous drainage, and its controls are straightforward: set a humidity target, pick a fan speed, and walk away. For a basement in the 800 to 1,200 square foot range that gets damp in summer, it does what you need. The case for paying more elsewhere is longevity. Owner feedback on budget dehumidifiers in general tends to include more reports of units that stop collecting water after a season or two, which usually points to refrigerant or compressor problems. That does not make it a bad buy; it makes the warranty important, so register it on day one. If your basement is very wet, very large, or regularly below 60 degrees, step up to one of the higher-ranked machines. If it is a typical summer-damp space, this is a lot of dehumidifier for the money."
  },
  {
    "name": "Santa Fe Compact70",
    "badge": "Best for Crawlspaces",
    "category": "Crawlspace and Basement, Fixed",
    "amazonUrl": "",
    "id": "santa-fe-compact70",
    "pros": [
      "Low, compact cabinet built for tight spaces and crawlspaces",
      "Designed for cooler air than portable units",
      "Rated around 70 pints per day",
      "Drains through a line, with an optional condensate pump",
      "Built by a dedicated dehumidifier maker"
    ],
    "cons": [
      "Priced well above portable units",
      "No bucket, so it needs a drain plan from the start"
    ],
    "bottomLine": "The pick for a crawlspace or a low, cool basement where a tall portable unit would struggle or not fit.",
    "description": "Santa Fe, part of Therma-Stor, builds dehumidifiers specifically for basements and crawlspaces, and the Compact70 is its answer for spaces where a normal portable will not fit or will not cope. The cabinet is low and narrow enough to slide into a crawlspace or under basement stairs, and it is engineered to keep removing water in the cooler temperatures typical of below-grade spaces. Santa Fe rates it around 70 pints per day. There is no bucket. Condensate drains through a line, and an optional pump handles setups where gravity will not work. Expect to pay roughly $1,100 to $1,500 at the time of writing, which puts it in whole-home territory. That is the main reason it sits below the Aprilaire, which covers more area at a similar price. It earns a place here because crawlspace encapsulation contractors so often specify it, and because owners of very cold, low basements commonly report that it keeps running where consumer units freeze up. For an open, average basement, a portable is still the better value."
  },
  {
    "name": "EcoSeb DD122EA-Simple",
    "badge": "Best for Cold Basements",
    "category": "Compact Desiccant Unit",
    "amazonUrl": "",
    "id": "ecoseb-desiccant",
    "pros": [
      "Desiccant design keeps working in cold air where compressors struggle",
      "Very light and quiet compared with compressor units",
      "Releases slightly warmed air, which helps in a chilly room",
      "No refrigerant to leak",
      "Good for small storage rooms and unheated spaces"
    ],
    "cons": [
      "Much lower capacity than a 50-pint compressor unit",
      "Uses more electricity per pint removed in warm conditions"
    ],
    "bottomLine": "A specialist for small, cold basements and storage rooms, not a replacement for a compressor unit in a big damp space.",
    "description": "Compressor dehumidifiers depend on a cold coil, and when the room itself is in the 50s, that coil frosts and the machine spends much of its time defrosting instead of drying. Desiccant units sidestep the problem by passing air over a moisture-absorbing wheel, then using a heater to drive the water off. The EcoSeb DD122EA-Simple is one of the best-known compact desiccant models, and it keeps working in much colder air than any compressor unit here. It is light, quiet, and puts out slightly warmed air, which owners of chilly basements tend to appreciate. The catch is capacity. Its daily extraction is a fraction of a 50-pint compressor model, so it suits a small storage room, a cold cellar, or a workshop rather than a full damp basement. It also uses more electricity per pint than a compressor unit when the room is warm, so it is not the right choice for summer humidity in a heated space. Buy it for a cold, smallish room. For anything else, a compressor model does more for less power."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Dehumidifier for Basement",
          item: "https://www.allmetalbrake.com/best-dehumidifier-for-basement/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What size dehumidifier does a basement need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most basements up to about 1,500 square feet with ordinary summer dampness, a 50-pint unit on the current DOE test is the right size. Smaller, only mildly musty spaces can use a 35-pint unit. Very large or persistently wet basements, especially those with damp walls, are better served by an 80-pint-class whole-basement machine. When in doubt, size up rather than down."
          }
        },
        {
          "@type": "Question",
          "name": "What humidity should a basement dehumidifier be set to?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Set it to 50 percent to start and check the reading with a separate hygrometer. If the musty smell is gone and there is no condensation on pipes or windows, leave it there. Drop to 45 percent if you still see moisture. Going below 40 percent wastes electricity without adding meaningful protection against mold, which struggles to grow below about 50 percent."
          }
        },
        {
          "@type": "Question",
          "name": "Should a basement dehumidifier run all the time?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It should run whenever humidity is above the set point, which in a damp basement can mean nearly continuously for the first week or two. After the space dries out, a correctly sized unit should cycle on and off. If it never stops after a couple of weeks, the unit is undersized, the room is too cold for it, or water is still getting in."
          }
        },
        {
          "@type": "Question",
          "name": "Will a dehumidifier still work in a cold basement?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard compressor units lose much of their capacity below about 60 to 65 degrees because the coil frosts. Desiccant units keep working in much colder air, and whole-basement compressor units designed for below-grade spaces handle the 50s far better than portables. If your basement stays cool year-round, choose one of those types instead of a typical big-box portable."
          }
        },
        {
          "@type": "Question",
          "name": "When is a built-in pump worth paying for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "When the drain is higher than the dehumidifier or too far away for a downhill hose. A floor drain or sump pit next to the unit works fine with a gravity hose. A laundry sink, a window, or a drain across the room usually needs a pump, either built into the unit or as an external condensate pump."
          }
        },
        {
          "@type": "Question",
          "name": "Will a dehumidifier get rid of basement mold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It will help stop new growth by keeping humidity below the level most molds need, but it will not kill mold that is already there or remove stains. Clean visible growth with an appropriate product, discard heavily contaminated porous materials, and then use the dehumidifier to keep the space dry. Get professional help for patches larger than about 10 square feet."
          }
        },
        {
          "@type": "Question",
          "name": "How much does it cost to run a basement dehumidifier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A typical Energy Star 50-pint portable uses roughly 400 to 600 watts while running. Cycling normally in a dried-out basement, that often works out to around $15 to $40 a month in summer at average U.S. electricity rates. Running nonstop costs more, which is why fixing air leaks and water sources pays off quickly."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Air, Mold & Water Heaters",
    tags: [
      "best dehumidifier for basement",
      "basement dehumidifier",
      "dehumidifier with pump",
      "whole home dehumidifier",
      "desiccant dehumidifier",
      "basement humidity"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Basement Dehumidifiers</span>, Ranked
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A basement is colder, damper, and further from a sink than any other room in the house. These are the machines built to cope with that, and the sizing rules that keep them from running all summer for nothing.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#frigidaire-ffad5033w1"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Shaheer Ali Khan</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Consumer Product Testing &amp; Materials Performance Specialist</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="14.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#why-basements-are-different" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Why Basements Differ</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Sizing</a>
          <a href="#compressor-vs-desiccant" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Types Compared</a>
          <a href="#drainage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Drainage</a>
          <a href="#placement" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Placement & Settings</a>
          <a href="#running-cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Running Cost</a>
          <a href="#mold-and-air" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Mold & Air Quality</a>
          <a href="#maintenance" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Maintenance</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most basement dehumidifiers fail for one of three reasons: they are too small for the space, they are too cold to work efficiently, or nobody empties the bucket. Pick a machine that handles all three, set it to 50 percent, give it a drain, and a musty basement usually turns into usable square footage within a couple of weeks.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Best Basement Dehumidifiers, Ranked
          </h2>

          <p>
            These rankings are built from manufacturer specifications, Energy Star listings, warranty terms, and recurring patterns in owner feedback, not from hands-on lab testing. Capacity figures are quoted on the current DOE/AHAM 2019 test basis wherever the maker publishes it, because that is the only way to compare models fairly.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
