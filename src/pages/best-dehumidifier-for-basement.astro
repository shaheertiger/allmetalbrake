                    <td class="px-4 py-4 text-gray-700">50 pints</td>
                    <td class="px-4 py-4 text-gray-700">50 pints</td>
                    <td class="px-4 py-4 text-gray-700">Whole-basement unit</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Wet after storms</td>
                    <td class="px-4 py-4 text-gray-700">Fix drainage first, then 50 pints</td>
