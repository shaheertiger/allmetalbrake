---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Lawn & Yard Care",
    tags: [
      "best zero turn mower",
      "zero turn mower",
      "residential zero turn",
      "commercial zero turn mower",
      "lawn mower reviews",
      "lawn care"
    ],
  }}
  jsonLd={schema}
>
