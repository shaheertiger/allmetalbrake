const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "Generator Transfer Switch: 6 Best in 2026, Manual to Interlock";
const description =
  "Generator transfer switch picks for portables: manual switch kits, a furnace-only switch, inlet boxes and cords, plus interlock vs automatic and 30A vs 50A.";

const PRODUCTS = [
  {
