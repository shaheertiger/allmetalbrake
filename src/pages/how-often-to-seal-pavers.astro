---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/how-often-to-seal-pavers.html?raw';

const title = "How Often Should You Seal Pavers? (2026 Guide)";
const description = "Most paver sealers need renewing every 3–5 years; wet-look acrylics sooner, penetrating sealers longer. Signs it's due, and why sealing too often backfires.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
