const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Rust-Oleum EpoxyShield Review",
          item: "https://www.allmetalbrake.com/rust-oleum-epoxyshield-review/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How many kits does a two-car garage take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The standard kit is labeled for about 250 square feet, so a typical two-car garage of 400 to 500 square feet needs two kits. Buy a third as a spare, because freshly ground concrete absorbs more than the label assumes. Measure your floor and check the coverage on the kit you buy."
          }
        },
        {
          "@type": "Question",
          "name": "Why does EpoxyShield sometimes peel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most peeling traces back to preparation: oil left in the slab, a smooth or sealed surface, coating over old paint, or moisture coming through the concrete. Parking too soon makes it worse. Grinding, degreasing, testing for moisture and waiting the full cure time prevent most failures. Coating outside the label's temperature range is another factor."
          }
        },
        {
          "@type": "Question",
          "name": "Can I put a second coat of EpoxyShield on?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, within the recoat window on the label, or after sanding if that window has passed. A second coat adds thickness and durability. Many owners prefer to apply a clear topcoat instead, which adds wear resistance and UV protection while locking in the color chips. Clean the surface thoroughly before either one."
          }
        },
        {
          "@type": "Question",
          "name": "Is EpoxyShield better than RockSolid?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not better, but different. EpoxyShield is cheaper and easier to apply, with a long working time. RockSolid Polycuramine is tougher and allows parking sooner but has a short working time. For daily parking and fast turnaround, RockSolid is often the better choice; for a relaxed first project, EpoxyShield. Both depend on good prep."
          }
        },
        {
          "@type": "Question",
          "name": "How long does EpoxyShield last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Owner reports suggest several years on a well-prepared slab with moderate traffic, often three to five before a refresh, longer with a topcoat. Heavy workshop use shortens that. Poor preparation can lead to peeling within months. Its life depends far more on prep and traffic than on the product alone."
          }
        },
        {
          "@type": "Question",
          "name": "Is EpoxyShield slippery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Like any glossy coating, it can be slick when wet. The included flakes add a little texture. For better traction, add an anti-slip additive to a clear topcoat. That is especially worthwhile in snowy or rainy climates where cars bring water into the garage. Mats near the door also help in winter, and a satin topcoat is a little less slick than high gloss."
          }
        },
        {
          "@type": "Question",
          "name": "Can I apply EpoxyShield on a new concrete slab?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only after the concrete has cured, typically at least 28 days, and after removing any curing compound, usually by grinding. Check the label for the specific waiting time. Coating too early traps moisture and can cause blistering and poor adhesion. Do a moisture test as well, because a young slab can still be releasing water vapor well after it feels hard and dry to the touch."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
  ],
};
