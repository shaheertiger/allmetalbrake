const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Blacktop Driveway Sealer",
          item: "https://www.allmetalbrake.com/blacktop-driveway-sealer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is blacktop sealer different from asphalt sealer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Blacktop is simply another name for asphalt pavement, more common in some regions. Products labeled blacktop sealer and asphalt driveway sealer are the same category: usually a water-based asphalt emulsion, sometimes with filler, sand or polymer added. What matters is the formula and how much filler it carries, not which of the two names is on the pail."
          }
        },
        {
          "@type": "Question",
          "name": "Can sealer make a gray driveway black again?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, on the surface. Sealer restores the black color by adding a fresh layer of asphalt-based material over the oxidized binder. On very porous blacktop, the first coat may look uneven or slightly brown as it soaks in, so plan for two coats. The color fades again over a few years as the sealer itself oxidizes."
          }
        },
        {
          "@type": "Question",
          "name": "How much sealer does an old driveway need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "More than the label suggests. Porous, oxidized blacktop can absorb noticeably more sealer on the first coat. A practical plan is to assume about two-thirds of the stated coverage for the first coat and the full figure for the second, then add a spare pail. Unopened pails can be returned or stored above freezing for the next job."
          }
        },
        {
          "@type": "Question",
          "name": "Should I brush or squeegee sealer on old blacktop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both. A stiff brush works the first coat into open, rough texture and fills the gaps between stones. A squeegee gives the second coat a smoother, more even finish. Many combination tools have a brush on one side and a squeegee on the other, which makes switching easy. Use a separate brush for edges and corners."
          }
        },
        {
          "@type": "Question",
          "name": "Can I seal blacktop that has loose stones?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if the base is sound. Loose stones and grit are signs of raveling, which a filled sealer can slow down. Sweep away everything loose first, avoid aggressive pressure washing, and brush the first coat in to bind the remaining fines. If stones keep popping out in large areas or the surface feels soft, get a repair quote first."
          }
        },
        {
          "@type": "Question",
          "name": "Is it worth sealing a driveway I plan to replace?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Often, yes. Sealing slows raveling and keeps water out of cracks, which can extend the driveway's life by a few years and push back the cost of replacement. It also improves appearance if you are selling the house. It is not worth it if large areas already show alligator cracking or potholes, because the money is better put toward the replacement."
          }
        },
        {
          "@type": "Question",
          "name": "What temperature do I need for sealing blacktop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most water-based sealers call for air and surface temperatures of at least 50 degrees Fahrenheit and rising, with nights that stay above that through the cure. Some ask for 55. Very hot pavement can flash-dry sealer before it bonds, so mist the surface or work in cooler parts of the day. Our temperature guide covers regional timing in detail."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
  ],
};
