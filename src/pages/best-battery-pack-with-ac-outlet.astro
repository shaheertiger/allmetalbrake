                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Chemistry</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Anker SOLIX C300X</td>
                    <td class="px-4 py-4 text-gray-700">288Wh</td>
                    <td class="px-4 py-4 text-gray-700">300W</td>
                    <td class="px-4 py-4 text-gray-700">600W surge</td>
                    <td class="px-4 py-4 text-gray-700">LiFePO4</td>
