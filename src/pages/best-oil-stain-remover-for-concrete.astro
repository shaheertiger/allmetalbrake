const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Concrete Oil Stain Removers",
          item: "https://www.allmetalbrake.com/best-oil-stain-remover-for-concrete/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which oil stain remover works best on concrete overall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the stain's age. For fresh spills, an absorbent like Oil-Dri followed by a degreaser like Oil Eater works best. For weeks-old stains, a poultice such as Pour-N-Restore. For old, faded stains, an enzyme product such as Terminator-HSD. Buying by stain age matters more than picking one brand."
          }
        },
        {
          "@type": "Question",
          "name": "Do enzyme oil removers really work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They do on the right stain and with patience. Microbial cleaners break hydrocarbons down in place, so they reach oil that degreasers cannot. Owners commonly report gradual fading over one to two weeks. They work poorly in cold weather, on surfaces treated with bleach or acid, and on puddles that were not absorbed first."
          }
        },
        {
          "@type": "Question",
          "name": "Can I mix two oil stain removers together?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Do not mix products in a bucket. Use them in sequence instead: absorbent, then degreaser, then a poultice or enzyme cleaner if needed. Rinse thoroughly between chemical products, especially before an enzyme treatment, because leftover degreaser residue can interfere with the microbes. Never combine any cleaner with bleach."
          }
        },
        {
          "@type": "Question",
          "name": "Is TSP good for oil stains on concrete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Trisodium phosphate is a strong alkaline cleaner that degreases concrete effectively and is often used before painting. It works similarly to the alkaline degreasers above. It is caustic, so wear gloves and eye protection, and phosphates are restricted in some areas. Rinse well and keep it out of storm drains and plant beds."
          }
        },
        {
          "@type": "Question",
          "name": "How many applications does a stain usually need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fresh spills usually need one round of absorbent and degreaser. Stains a few weeks old often need two or three degreaser or poultice rounds. Old garage floor stains may need three to five poultice applications or a week or two of enzyme treatment. Judge each round only after the concrete is fully dry."
          }
        },
        {
          "@type": "Question",
          "name": "Will a pressure washer alone remove oil?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cold water pressure washing rarely removes oil stains by itself, because water does not dissolve oil. It is excellent as a rinse after a degreaser or poultice, flushing emulsified oil out of the surface texture. Hot water units are much more effective on oil, which is why commercial cleaners use them."
          }
        },
        {
          "@type": "Question",
          "name": "Is sealing worth it once the oil stains are gone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, once the concrete is completely clean and dry. Check by sprinkling water: it should soak in evenly. A penetrating silane or siloxane sealer slows future oil absorption, giving you time to blot spills. Sealing over residual oil leads to poor adhesion, so finish the stain work first."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
