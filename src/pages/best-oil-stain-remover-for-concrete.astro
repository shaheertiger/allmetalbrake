    "url": "/best-pressure-washer/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "Best Oil Stain Removers for Concrete: 7 Picks by Stain Age";
const description =
  "Degreasers, enzyme cleaners, poultices and absorbents for concrete oil stains, matched to stain age, so you buy the one that fits the spot on your floor.";

