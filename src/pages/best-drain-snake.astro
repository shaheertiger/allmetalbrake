---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Water Filtration Systems for Home",
    "url": "/best-water-filtration-system-for-home/"
  },
  {
    "title": "Best Water Filter Pitchers",
    "url": "/best-water-filter-pitcher/"
  },
  {
    "title": "Best Whole House Surge Protectors",
    "url": "/best-whole-house-surge-protector/"
  },
  {
    "title": "Best Circuit Breaker Finders",
    "url": "/best-circuit-breaker-finder/"
  },
  {
    "title": "Best Shop Vacs",
    "url": "/best-shop-vac/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 6 Best Drain Snakes: From Hair Clogs to Main Lines";
const description =
  "Six drain snakes matched to the clog, from tub hair to toilets, kitchen lines and main sewers, with cable sizing, safe technique and when to call a plumber.";

const PRODUCTS = [
  {
    "id": "ridgid-power-spin",
    "name": "RIDGID PowerSpin+ 25 ft Drain Cleaner",
    "category": "Hand or Drill Powered, 1/4 in Cable, Autofeed",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "Runs by hand or with a cordless drill",
      "Autofeed handle advances cable without touching it",
      "Enclosed drum keeps dirty cable contained",
      "25 ft of 1/4 in cable covers sinks, tubs and branch lines",
      "Inexpensive for a RIDGID tool"
    ],
    "cons": [
      "Plastic drum is less durable than metal",
      "Not suited to kitchen lines with heavy grease or main lines"
    ],
    "bottomLine": "The one snake most households should own for sinks, tubs and branch drains.",
    "description": "RIDGID's PowerSpin+ is a compact drum snake with 25 feet of quarter-inch cable inside an enclosed plastic housing. You can turn it by hand, or chuck a cordless drill into the back for powered spinning, which takes the effort out of long runs. Its autofeed handle advances and retracts cable with a squeeze, so your hands stay off the dirty cable, which owners commonly cite as the feature they value most. The quarter-inch cable bends easily through sink and tub traps, and the bulb head grabs hair well. The enclosed drum contains drips and makes storage tidy. Limits are clear: the plastic housing is not built for heavy daily use, and the thin cable is not meant for kitchen lines packed with grease or for main sewers. For the slow bathroom sink, the clogged tub and occasional branch line issues, it is the best-balanced tool at its price, typically roughly $30 to $50 at the time of writing."
  },
  {
    "id": "ridgid-k-6p",
    "name": "RIDGID K-6P 6 ft Closet Auger",
    "category": "Closet Auger, Bowl Guard, Hand Crank",
    "badge": "Best for Toilets",
    "amazonUrl": "",
    "pros": [
      "6 ft cable reaches through the toilet and into the closet bend",
      "Vinyl guard protects porcelain from scratches",
      "Sturdy build from a professional plumbing brand",
      "Simple hand crank, nothing to charge"
    ],
    "cons": [
      "Only for toilets",
      "Cable can be stiff in tight bowls"
    ],
    "bottomLine": "The right tool for toilet clogs that plunging cannot clear.",
    "description": "RIDGID's K-6P is a closet auger built for one job: clearing a toilet without scratching it. The cable runs inside a curved tube, and a vinyl guard on the bend protects the porcelain where the tube rests in the bowl. Its six-foot cable reaches through the toilet's internal trap and into the closet bend below, deeper than many three-foot augers. You insert the tube, crank the cable down until you hit resistance, and keep cranking and pushing to break up or snag the clog, then pull back while cranking. Owners commonly report it clears wipes, toys and paper wads that plungers cannot. It is a professional-grade tool that holds up to repeated use. It does nothing for sinks or main lines, and the stiffer cable can feel awkward in some compact bowls. Price is typically roughly $45 to $70 at the time of writing. If you live in a house where toilets clog more than once a year, buy it before you need it."
  },
  {
    "id": "ryobi-drain-auger",
    "name": "RYOBI ONE+ 18V Drain Auger",
    "category": "Cordless, 25 ft x 1/4 in Cable, Autofeed",
    "badge": "Best Cordless",
    "amazonUrl": "",
    "pros": [
      "Cordless convenience on the RYOBI 18V platform",
      "Autofeed trigger advances and retracts cable",
      "25 ft of 1/4 in cable for sinks, tubs and branch drains",
      "Less effort than turning a hand drum"
    ],
    "cons": [
      "Battery and charger sold separately in bare-tool form",
      "Bulkier than a hand snake under sinks"
    ],
    "bottomLine": "Worth it if you already own RYOBI batteries or clear drains often.",
    "description": "RYOBI's ONE+ drain auger uses the brand's 18-volt batteries to spin 25 feet of quarter-inch cable, with a variable-speed trigger and an autofeed control that advances and retracts the cable without hand feeding. For anyone who clears drains several times a year, that saves real effort, especially on longer runs into a branch drain. The drum keeps cable contained, and the tool is shaped to hold with one hand while the other steadies the cable at the drain opening. Bare tool prices typically run roughly $90 to $140 at the time of writing, and you need a battery and charger, so it makes most sense for existing RYOBI owners. The body is bulkier than a hand drum, which can be awkward in tight vanities. Like any quarter-inch auger, it suits sinks, tubs and two-inch branch lines, not main sewers. Owners commonly praise how quickly it clears hair clogs that resisted plunging."
  },
  {
    "id": "drainx-pro-25",
    "name": "DrainX Pro 25 ft Steel Drum Auger",
    "category": "Hand Crank, Metal Drum, 1/4 in Cable",
    "badge": "Best Value",
    "amazonUrl": "",
    "pros": [
      "Steel drum is tougher than plastic housings",
      "25 ft of 1/4 in cable",
      "Comes with gloves for handling the cable",
      "Low price for a metal drum snake"
    ],
    "cons": [
      "Manual cranking only",
      "Cable can kink if forced"
    ],
    "bottomLine": "A durable, low-cost manual snake for sinks, tubs and branch drains.",
    "description": "DrainX's Pro drum auger is a straightforward manual snake: 25 feet of quarter-inch steel cable inside a steel drum with a crank handle and a thumbscrew lock. The steel drum stands up to drops and storage better than the plastic housings on many budget snakes, and the kit typically includes work gloves. Use is classic: feed the cable, lock it, crank and push. Without autofeed or drill power, it takes more hand effort than the RIDGID PowerSpin+, but it is simpler and has fewer parts to break. It suits bathroom sinks, tubs and two-inch branch drains, and owners commonly report it handles hair clogs and modest kitchen buildup well. The usual caveat applies: forcing the cable through a tight bend can kink it. Price is typically roughly $25 to $45 at the time of writing, which makes it an easy tool to keep in the garage for the next clog."
  },
  {
    "id": "cobra-zip-it",
    "name": "Zip-It Barbed Drain Strip by Cobra",
    "category": "Barbed Plastic Strip, Single Use",
    "badge": "Best for Hair",
    "amazonUrl": "",
    "pros": [
      "Extremely cheap",
      "Pulls hair clogs out instead of pushing them deeper",
      "Fits past many pop-up stoppers",
      "No mess from a long metal cable"
    ],
    "cons": [
      "Reaches only about 20 inches",
      "Hard to clean, effectively disposable"
    ],
    "bottomLine": "The first thing to try on a slow bathroom sink or tub, before any metal snake.",
    "description": "The Zip-It is a thin plastic strip with backward-facing barbs along both edges. You slide it into the drain, twist it, and pull it out, and the barbs bring hair clogs with them. It is a crude tool that costs a few dollars, and it solves a large share of bathroom clogs because those clogs usually sit right below the stopper or in the trap, within its roughly 20-inch reach. Unlike a metal snake, it pulls the clog out rather than pushing part of it deeper. It fits past many pop-up stoppers, though removing the stopper first works better. Limitations are obvious: it does not reach far, it cannot handle grease or solid objects, and it is unpleasant to clean, so most people treat it as disposable. Buy a multipack and keep one in each bathroom. If it fails twice, move up to a drum snake."
  },
  {
    "id": "vevor-electric-drain-auger",
    "name": "VEVOR 50 ft Electric Drain Cleaning Machine",
    "category": "Corded Drum Machine, Foot Switch, Cutter Set",
    "badge": "Best Budget Machine",
    "amazonUrl": "",
    "pros": [
      "Low price for an electric drum machine",
      "50 ft cable reaches most main lines from a cleanout",
      "Includes cutters for roots and grease",
      "Foot switch keeps hands free for the cable"
    ],
    "cons": [
      "Build quality below professional machines",
      "Heavy and needs careful handling",
      "Check cable diameter by listing, as versions vary"
    ],
    "bottomLine": "A budget machine for owners with recurring main line clogs who prefer owning to renting.",
    "description": "VEVOR sells several electric drain cleaning machines, and the common 50-foot drum version brings main line capability for a fraction of the price of professional brands. It pairs a motor-driven drum with a foot switch, so both hands can guide the cable, and typically includes a set of cutters for roots, grease and general clogs. Cable diameter differs by listing, so match it to your pipe: a heavier half-inch cable for three- to four-inch mains, a three-eighths cable for smaller lines. Owners commonly report it handles root intrusions from a basement cleanout that defeated hand tools. The trade-offs are durability and finish, which sit below RIDGID or General Wire machines, and the inherent risk of any drum machine. Wear the supplied gloves, use a GFCI outlet, and never let the cable spin freely outside the pipe. Prices are typically roughly $250 to $450 at the time of writing. If you need it once, rent a professional machine instead."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Drain Snake Picks",
          item: "https://www.allmetalbrake.com/best-drain-snake/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which drain snake should a homeowner buy first?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Start with a pack of plastic barbed strips for hair clogs and a 25-foot quarter-inch drum snake such as the RIDGID PowerSpin+ for sinks, tubs and branch lines. Add a closet auger if toilets clog. Those three tools clear most household clogs for well under $100 in total. Rent a machine for main lines."
          }
        },
        {
          "@type": "Question",
          "name": "Is a regular snake safe in a toilet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not a good idea. A bare metal cable can scratch the porcelain permanently, and it tends to coil in the bowl rather than feed through the trap. A closet auger runs its cable inside a guarded tube made for toilets. Try a flange plunger first, then the auger if plunging fails."
          }
        },
        {
          "@type": "Question",
          "name": "What cable length do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For sinks, tubs and showers, 15 to 25 feet is plenty, since most clogs are within a few feet of the drain. Twenty-five feet reaches most branch lines. Main lines from a cleanout to the street often need 50 to 100 feet and a thicker cable on a powered machine."
          }
        },
        {
          "@type": "Question",
          "name": "Why does the drain clog again after snaking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually the snake bored a hole through the clog rather than removing it, which happens with grease or with a cable too thin for the pipe. Recurrence can also mean roots, pipe damage, poor slope, or a venting problem. If it returns within weeks, try a cutter head or larger cable, and if it persists, have the line camera inspected."
          }
        },
        {
          "@type": "Question",
          "name": "Will a snake damage PVC pipes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Used with reasonable force, a correctly sized hand snake is safe in PVC. Damage comes from forcing a cable that is too thick through tight fittings or running a powered auger hard against a bend. If the cable stops dead, back off instead of pushing harder. Old, corroded metal pipes deserve extra care."
          }
        },
        {
          "@type": "Question",
          "name": "Is chemical drain cleaner better than a snake?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Chemical openers often fail on hair clogs, can harm older pipes, and make any later mechanical work dangerous because of splash-back. A snake physically removes the clog. Enzyme cleaners are gentler for maintenance but are slow and will not clear a full blockage. A $5 plastic barbed strip often clears a hair clog that chemicals cannot."
          }
        },
        {
          "@type": "Question",
          "name": "Should I rent or buy an electric drain machine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rent if the main line clogs once. Rental machines are professional grade and typically cost roughly $50 to $90 a day. Buy a budget machine only if roots or grease clog your main line every year or more. If clogs keep recurring, pay for a camera inspection first. Ask the rental shop for a quick demonstration first."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Water, Plumbing & Electrical",
    tags: [
      "best drain snake",
      "drain auger",
      "toilet auger",
      "electric drain snake",
      "how to snake a drain",
      "clogged main line"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 6 Best <span class="text-[#38BDF8]">Drain Snakes</span> for Every Clog
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          The right snake depends on where the clog is and how wide the pipe is. These six cover a hair-clogged sink, a stubborn toilet, a greasy kitchen line and a backed-up main, ranked by how well each fits the job.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#ridgid-power-spin"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.7k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#find-the-clog" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Locate the Clog First</a>
          <a href="#cable-sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Cable Diameter and Length</a>
          <a href="#snake-types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Types of Drain Snakes</a>
          <a href="#how-to-snake" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. How to Snake a Drain</a>
          <a href="#toilets" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Toilet Clogs</a>
          <a href="#main-lines" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Main Lines and When to Call a Pro</a>
          <a href="#pipe-safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Protecting Your Pipes</a>
          <a href="#cost-vs-plumber" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Snake Cost vs Plumber Cost</a>
          <a href="#prevention" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Care and Prevention</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most people buy a drain snake in the middle of an emergency and pick the one with the longest cable. That is backwards. A bathroom sink needs a thin, flexible cable and maybe 15 feet of reach. A toilet needs a short closet auger with a guard that protects the porcelain. A main sewer line needs a heavy machine, and in many cases a plumber. Choose by location and pipe diameter, and a $20 to $60 tool clears most household clogs.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 6 Best Drain Snakes, Ranked
          </h2>

          <p>
            Picks are ranked on cable diameter and length relative to the pipes they serve, drive method, build quality, safety features and patterns in owner feedback about kinking, mess and staying power. No hands-on trial was done for this list; specifications come from manufacturer listings and manuals.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-gray-500 text-sm font-bold">{product.rating}</span>
                    <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} ratings on Amazon)</span>
                  </div>
                  )}

                  <p class="text-gray-700 leading-relaxed mb-6">{product.description}</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 rounded-xl p-4">
                      <p class="text-xs font-black uppercase tracking-widest text-green-700 mb-3">Pros</p>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="flex items-start gap-2 text-sm text-green-800">
                            <svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            {pro}
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-red-50 rounded-xl p-4">
                      <p class="text-xs font-black uppercase tracking-widest text-red-700 mb-3">Cons</p>
                      <ul class="space-y-2">
                        {product.cons.map((con) => (
