              </div>
              <div>
                <p class="text-3xl font-black text-white">1/2 in+</p>
                <p class="text-gray-400 text-xs mt-1">3 to 4 in main lines</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">25 ft</p>
