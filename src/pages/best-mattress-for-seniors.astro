---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Top Rated Mattresses",
    "url": "/best-mattress/"
  },
  {
    "title": "Best Mattress for Side Sleepers",
    "url": "/best-mattress-for-side-sleepers/"
  },
  {
    "title": "Best Mattress Toppers",
    "url": "/best-mattress-topper/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-13", modified: "2026-11-13" });
const title = "6 Best Mattresses for Seniors in 2026: Firm Edges, Right Height";
const description =
  "The best mattress for seniors pairs firm edges, a 12 to 14 inch profile and responsive foam. Six picks for sore joints, adjustable bases and easy exits.";

const PRODUCTS = [
  {
    "id": "helix-midnight-luxe",
    "name": "Helix Midnight Luxe",
    "category": "Hybrid, medium, zoned, tall profile",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "specs": [
      [
        "Type",
        "Hybrid, pocketed coils"
      ],
      [
        "Height",
        "13.5 in (maker); 14 in on Amazon queen listing"
      ],
      [
        "Firmness",
        "Medium, 6/10 (maker)"
      ],
      [
        "Coils",
        "Up to 1,000, reinforced perimeter"
      ],
      [
        "Trial",
        "365 nights (direct)"
      ],
      [
        "Warranty",
        "Limited lifetime"
      ]
    ],
    "pros": [
      "Reinforced perimeter coils give a firm place to sit",
      "Tall 13.5 inch profile raises the bed",
      "Zoned lumbar support under the lower back",
      "Medium feel suits side and back sleepers",
      "Helix lists its adjustable bases as compatible"
    ],
    "cons": [
      "Queen weighs 115 lb by Helix's figure",
      "Premium price even on sale",
      "Trial on Amazon purchases may differ from Helix direct"
    ],
    "bottomLine": "The Helix Midnight Luxe is the best mattress for most seniors because it pairs reinforced edges and a tall 13.5 inch profile with a medium, zoned surface that cushions joints without trapping you.",
    "description": "The Midnight Luxe is the premium version of Helix's best-known model, and it ticks more senior boxes than anything else we looked at. Helix lists it at 13.5 inches tall, so it raises the sitting height of most beds. Inside are up to 1,000 individually wrapped coils with reinforced coil support along the full perimeter, which is what keeps the edge from folding when you sit to dress. Helix adds zoned lumbar support and rates the feel medium, 6 out of 10. The comfort stack is gel memory foam over a responsive foam, so you get cushioning at the shoulder without the deep, slow sink of an all-foam bed. Helix says the foams are CertiPUR-US certified and the mattress is GREENGUARD Gold certified and fiberglass-free. An optional GlacioTex cover is sold for hot sleepers. Helix lists its own adjustable bases as compatible. On Helix's site at the time of writing, a queen ran roughly $1,875 to $2,500 depending on the sale. The trade-offs are the 115 pound queen weight and the price. Helix direct offers a 365-night trial and a limited lifetime warranty; Amazon listings vary on trial length, so check before ordering."
  },
  {
    "id": "leesa-sapira-chill-hybrid",
    "name": "Leesa Sapira Chill Hybrid 14\" Mattress",
    "category": "Hybrid, three firmness options, 14 in tall",
    "badge": "Best Tall Bed",
    "amazonUrl": "#",
    "specs": [
      [
        "Type",
        "Hybrid, zoned springs"
      ],
      [
        "Height",
        "14 in"
      ],
      [
        "Firmness",
        "Plush, Medium-Firm or Firm (maker)"
      ],
      [
        "Edges",
        "Reinforced coils along the sides (maker)"
      ],
      [
        "Trial",
        "365 nights direct; 100-120 on Amazon listings"
      ],
      [
        "Warranty",
        "Limited lifetime (maker)"
      ]
    ],
    "pros": [
      "Tallest pick at 14 inches",
      "Reinforced side coils for sitting and standing",
      "Three firmness levels to match sleep position",
      "Zoned lumbar springs",
      "Responsive and transition foams limit the stuck feeling"
    ],
    "cons": [
      "Leesa does not state adjustable base compatibility",
      "Amazon listings show a shorter trial than Leesa direct",
      "Queen weighs 103 lb"
    ],
    "bottomLine": "The tallest pick, with reinforced edges and three firmness levels, for seniors whose current bed sits too low.",
    "description": "The Sapira Chill is the pick when height is the problem. Leesa lists it at 14 inches, the tallest mattress here, and that alone can turn a struggle to stand into an easy push. Leesa says it has reinforced coils along the sides, and the coil unit is an 8 inch layer of zoned lumbar springs. Above them are a 2 inch quilted foam, 1.5 inches of Leesa's GreenFlex BioFoam, a 1 inch responsive foam and a 1 inch transition foam. That responsive layer matters: it helps the bed push back when you turn over. It comes in Plush, Medium-Firm and Firm, which lets you match the feel to how you sleep and how much you weigh. Leesa lists the queen at 103 pounds. Leesa direct offers a 365-night trial and a limited lifetime warranty, but the Amazon listings we found mention 100 or 120 nights, so the seller matters. Leesa's page does not state adjustable base compatibility, and one independent reviewer rated it only average on an adjustable base. If you sleep upright on a base most nights, the Helix or Purple is the safer choice. Leesa's site showed prices from about $1,199 at the time of writing, with the queen higher."
  },
  {
    "id": "brooklyn-bedding-signature-hybrid",
    "name": "Brooklyn Bedding Signature Hybrid",
    "category": "Hybrid, Soft, Medium or Firm",
    "badge": "Best Value",
    "amazonUrl": "#",
    "specs": [
      [
        "Type",
        "Hybrid, 8 in encased coils"
      ],
      [
        "Height",
        "13.25 in; 14 in with pillow top (maker)"
      ],
      [
        "Firmness",
        "Soft, Medium or Firm (maker)"
      ],
      [
        "Coils",
        "Up to 760 (maker)"
      ],
      [
        "Trial",
        "365 nights (direct)"
      ],
      [
        "Warranty",
        "Limited lifetime (direct)"
      ]
    ],
    "pros": [
      "Three firmness choices at a lower price than most hybrids",
      "Tall 13.25 inch profile",
      "Responsive foam in the comfort stack",
      "Encased coil core supports the edge",
      "Frequent discounts off the list price"
    ],
    "cons": [
      "Some independent reviewers question long-term durability",
      "Amazon listings do not state the warranty term",
      "Requires slats no more than 5 inches apart"
    ],
    "bottomLine": "The value pick: a tall hybrid in three firmness levels for well under the price of the Helix.",
    "description": "Brooklyn Bedding's Signature Hybrid is the budget-conscious way to get most of what seniors need. Brooklyn lists it at 13.25 inches, or 14 inches with the optional Cloud Pillow Top, so it raises the bed like the premium picks. It comes in Soft, Medium and Firm, which matters: lighter side sleepers can go Soft, back sleepers Medium, and heavier sleepers Firm. The core is an 8 inch Ascension X coil unit with up to 760 encased coils, and the comfort stack includes gel swirl memory foam, a responsive foam and a transition foam. Brooklyn describes its edge support as excellent, though it does not publish a reinforced-perimeter spec the way Helix and Leesa do. The brand's list price for a queen was about $1,465 at the time of writing, but it runs frequent sitewide discounts, and it usually sells well below that. The honest caveat is durability. Some independent reviewers have questioned how well it holds up over years. Brooklyn direct backs it with a 365-night trial and a limited lifetime warranty, which softens that risk, but the Amazon listings we found do not state a warranty term. Brooklyn asks for solid support or slats no more than 5 inches apart."
  },
  {
    "id": "purple-restore-hybrid",
    "name": "Purple Restore Hybrid Mattress",
    "category": "Gel grid hybrid, responsive surface",
    "badge": "Easiest to Move On",
    "amazonUrl": "#",
    "specs": [
      [
        "Type",
        "Hybrid, 2 in GelFlex Grid over coils"
      ],
      [
        "Height",
        "11.5 in"
      ],
      [
        "Firmness",
        "Medium (maker); Soft and Firm versions on Amazon"
      ],
      [
        "Edges",
        "Edge support foam, edge-to-edge coils"
      ],
      [
        "Trial",
        "100 nights, 21-night minimum"
      ],
      [
        "Warranty",
        "10 years"
      ]
    ],
    "pros": [
      "Gel grid springs back, so turning over takes little effort",
      "Purple adds edge support foam for getting in and out",
      "Open grid sleeps cooler than dense foam",
      "Works on adjustable bases tested to 750 lb",
      "Cushions pressure points without a slow sink"
    ],
    "cons": [
      "Expensive",
      "11.5 inches is lower than the Helix or Leesa",
      "Queen weighs 114 lb, and returns deduct transport costs"
    ],
    "bottomLine": "The easiest surface here to move and turn on, with real edge support, for seniors who feel stuck on memory foam.",
    "description": "Purple's Restore Hybrid is the answer for anyone who feels trapped on memory foam. Its top layer is a 2 inch GelFlex Grid, a stretchy gel lattice that collapses under pressure points like the hip and shoulder but springs back the moment you move. Owners commonly describe it as easy to shift and turn on, which is exactly what you want at night with stiff joints. Underneath is an 8 inch responsive coil system that runs edge to edge, and Purple adds edge support foam that it says makes getting in and out easier. Purple says the grid draws heat away, and owners commonly describe it as one of the cooler surfaces. Purple's site describes the Restore as medium; Amazon sells Soft and Firm versions, so check which one you are ordering. Purple says it works on an adjustable base tested to at least 750 pounds. At 11.5 inches it is shorter than the Helix and Leesa, so check your bed height. Purple lists the queen at 114 pounds. At the time of writing a queen ran roughly $2,100 to $2,300. The 100-night trial asks for 21 nights first and deducts transportation charges from refunds; the warranty is 10 years."
  },
  {
    "id": "nectar-classic-hybrid-12",
    "name": "Nectar Classic Hybrid 12\" Mattress",
    "category": "Hybrid, medium-firm, memory foam top",
    "badge": "Longest Trial",
    "amazonUrl": "#",
    "specs": [
      [
        "Type",
        "Hybrid, memory foam over pocketed coils"
      ],
      [
        "Height",
        "12 in"
      ],
      [
        "Firmness",
        "Medium-firm (maker)"
      ],
      [
        "Coils",
        "792 in queen (Amazon listing)"
      ],
      [
        "Trial",
        "365 nights"
      ],
      [
        "Warranty",
        "Forever (limited)"
      ]
    ],
    "pros": [
      "365-night trial and forever warranty listed on Amazon",
      "Medium-firm support suits back sleepers",
      "Coils add bounce under a thin memory foam layer",
      "800 lb weight limit listed for queen",
      "Sold on Amazon bundled with an adjustable base"
    ],
    "cons": [
      "Memory foam top is slower to respond than the Purple or Leesa",
      "No reinforced edge claim from Nectar",
      "Independent reviewers rate it firmer than medium"
    ],
    "bottomLine": "A supportive, medium-firm hybrid with the longest trial and warranty on the list, for back sleepers who want a safety net.",
    "description": "The Nectar Classic Hybrid is the low-risk choice. Its Amazon listings advertise a 365-night trial and a forever warranty, the longest terms on this list, which gives you a full year of seasons to judge it. Nectar calls it medium-firm, and independent reviewers commonly rate it around 6.5 to 7 on a 10-point scale, so it suits back sleepers and combination sleepers who want support more than plushness. It is 12 inches tall, with memory foam layers over pocketed coils; the Amazon queen listing shows 792 coils and an 800 pound weight limit. The memory foam top layer is thinner than an all-foam bed's, so it does not hold you in place the way the TEMPUR-Cloud can, but it is still slower to respond than the Purple grid or Leesa's responsive foam. Nectar does not make a specific reinforced-edge claim for this model, which is the main reason it sits below the top three. Nectar sells it on Amazon bundled with its adjustable base, which tells you it is designed to flex. We did not verify a current standalone price, so check today's listing."
  },
  {
    "id": "tempur-pedic-tempur-cloud-10",
    "name": "Tempur-Pedic TEMPUR-Cloud 10\" Mattress, Medium",
    "category": "All-foam memory foam, medium",
    "badge": "Deepest Cushioning",
    "amazonUrl": "#",
    "specs": [
      [
        "Type",
        "All-foam, TEMPUR memory foam"
      ],
      [
        "Height",
        "10 in"
      ],
      [
        "Firmness",
        "Medium (maker)"
      ],
      [
        "Layers",
        "Two TEMPUR layers over a polyfoam base (reviewers)"
      ],
      [
        "Trial",
        "90 nights on direct orders, $175 return fee"
      ],
      [
        "Warranty",
        "10 years"
      ]
    ],
    "pros": [
      "Deep, hugging pressure relief for sore hips and shoulders",
      "Absorbs motion well for couples",
      "Ships in a box",
      "Proven TEMPUR material",
      "Flexes easily on adjustable bases"
    ],
    "cons": [
      "Slow memory foam makes turning over and getting up harder",
      "All-foam edge compresses when you sit",
      "Trial applies only to direct purchases"
    ],
    "bottomLine": "The softest, deepest pressure relief on the list, for mobile seniors who love memory foam; skip it if moving in bed is already hard.",
    "description": "The TEMPUR-Cloud is here because some people with arthritic joints simply prefer the deep cradle of memory foam, and Tempur-Pedic's material is the benchmark. It is a 10 inch all-foam bed; reviewers describe two 1.5 inch layers of TEMPUR material over a 7 inch polyfoam base. Tempur-Pedic calls the feel medium, and independent reviewers place it between about 5 and 6.5 out of 10. The cushioning at the shoulder and hip is the reason to buy it. The reasons to skip it are just as clear. Slow memory foam holds your shape after you move, so turning over and sitting up take more effort, and owners with limited mobility commonly report feeling stuck. With no coils, the edge compresses when you sit. At 10 inches it is also the lowest profile here, and dense memory foam is the most likely to feel warm. Tempur-Pedic's 90-night trial applies only to orders placed directly with Tempur-Pedic and carries a $175 return fee, so an Amazon purchase may not include it. The warranty is 10 years. Buy it for a mobile sleeper who already loves memory foam, not for anyone who struggles to get out of bed."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Mattress for Seniors",
          item: "https://www.allmetalbrake.com/best-mattress-for-seniors/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What type of mattress is best for seniors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most seniors, a medium to medium-firm hybrid is the best type. The coils give a firm edge for sitting and standing and a bit of bounce for turning over, while the foam layers cushion shoulders and hips. All-foam memory foam beds offer deep pressure relief but are harder to move on and usually have soft edges."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best mattress height for elderly people?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aim for a total sitting height where your feet rest flat on the floor and your knees sit at about a right angle when you sit on the edge. Measure a chair you stand from easily and match it. Mattress thickness is one lever; the frame and foundation are the others, and they are often easier to change."
          }
        },
        {
          "@type": "Question",
          "name": "Is a firm or soft mattress better for arthritis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Neither extreme. A very firm mattress presses hard on arthritic hips and shoulders, while a very soft one lets the hips sink and makes moving harder. Most people with arthritis do best on medium to medium-firm. Side sleepers usually want a touch softer, back sleepers a touch firmer. Persistent pain warrants a doctor or physical therapist."
          }
        },
        {
          "@type": "Question",
          "name": "Is memory foam bad for seniors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not bad, but often not ideal. Memory foam relieves pressure well, which helps sore joints, but thick slow-response foam holds you in place and can make turning over and getting up harder. A thin memory foam layer on top of coils, as in many hybrids, keeps most of the cushioning without the stuck feeling."
          }
        },
        {
          "@type": "Question",
          "name": "Can you put any mattress on an adjustable bed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Foam and pocketed-coil hybrids usually flex well, but older connected innerspring mattresses often do not, and very thick mattresses can resist the hinge. Check that the maker lists adjustable base compatibility and any weight rating for the base. Purple, for instance, says the Restore needs a base tested to at least 750 pounds."
          }
        },
        {
          "@type": "Question",
          "name": "How often should seniors replace a mattress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A commonly cited lifespan is seven to ten years, but replace yours sooner if it has visible sagging, if you wake stiffer than you went to bed, or if getting out of bed has become harder. Changes in your body matter too: a bed that suited you at 55 may be too firm or too low at 75."
          }
        },
        {
          "@type": "Question",
          "name": "What size mattress is best for an elderly couple?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A queen is the minimum for two adults, and a king gives each sleeper more room to move without disturbing the other. Couples with different firmness needs can use a split king, two twin XL mattresses side by side, which also lets each person use their own side of a split adjustable base."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Sleep & Mattresses",
    tags: [
      "best mattress for seniors",
      "mattress for elderly",
      "mattress for arthritis",
      "mattress edge support",
      "mattress for adjustable bed",
      "mattress height for seniors"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The 6 Best Mattresses for Seniors
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          A medium to medium-firm hybrid with reinforced edges and a responsive top layer is the right mattress for most seniors, because it is easy to sit on, easy to roll over on and still soft enough for sore hips and shoulders. Here are six worth buying and the specs that decide it.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">12 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#short-answer" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>The Short Answer</span></a>
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>The Six Picks</span></a>
              <a href="#comparison" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Comparison Table</span></a>
              <a href="#edge-support" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Edge Support</span></a>
              <a href="#height" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>Mattress and Bed Height</span></a>
              <a href="#movement" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Responsive vs Sinking Foam</span></a>
              <a href="#joint-pain" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Joint Pain and Arthritis</span></a>
              <a href="#adjustable-base" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>Adjustable Bases</span></a>
