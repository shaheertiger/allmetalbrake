---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Deck Stains",
    "url": "/best-deck-stain-reviews/"
  },
  {
    "title": "Best Deck Sealant",
    "url": "/best-deck-sealant/"
  },
  {
    "title": "Best Fence Stain",
    "url": "/best-fence-stain/"
  },
  {
    "title": "Best Redwood Sealer",
    "url": "/best-redwood-sealer/"
  },
  {
    "title": "Best Deck Stain for Cedar",
    "url": "/best-deck-stain-for-cedar/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "Exterior Wood Sealers for Siding, Furniture and Logs: 7 Picks";
const description =
  "Seven exterior wood sealers matched to the job: siding, trim, outdoor furniture, log walls, docks and fences, with life expectancy by exposure and wood type.";

const PRODUCTS = [
  {
    "id": "penofin-blue-label",
    "badge": "Best Overall",
    "category": "Oil-based penetrating finish",
    "name": "Penofin Blue Label Penetrating Oil Finish",
    "amazonUrl": "",
    "bottomLine": "The most versatile exterior wood sealer here, suited to siding, fences and hardwood alike.",
    "pros": [
      "Deep-penetrating oil finish with no film to peel",
      "Works on siding, decks, fences and many hardwoods",
      "Available in clear and many transparent tones",
      "Recoats with cleaning only",
      "Popular with contractors for cedar and redwood siding"
    ],
    "cons": [
      "Oil-based, with mineral spirits cleanup",
      "Clear version gives limited UV protection",
      "Not available in every formula in low-VOC areas"
    ],
    "description": "Penofin has been a contractor favorite for decades, particularly on cedar and redwood siding, and the Blue Label penetrating oil is its broad-use flagship. It is an oil-based finish built around Brazilian rosewood oil, according to the company, and it soaks into the wood rather than sitting on top. That means it does not peel; when it wears, the wood looks dry and the next coat goes on after a cleaning. It comes in a clear and a range of transparent tones, and the toned versions add the UV protection a clear lacks. Its versatility is the main reason it ranks first. The same finish works on siding, fences, trim and many hardwoods, so one product can cover most of the wood around a house. Penofin also sells a dedicated formula for dense hardwoods if you are finishing ipe. Expect to apply thin coats, wipe excess on dense wood and handle oily rags carefully. Prices were roughly 45 to 70 dollars per gallon at the time of writing."
  },
  {
    "id": "twp-1500",
    "badge": "Best for Fences and Siding",
    "category": "Oil-based preservative stain",
    "name": "TWP 1500 Series Wood Preservative",
    "amazonUrl": "",
    "bottomLine": "A durable penetrating preservative for large softwood projects like fences, siding and outbuildings.",
    "pros": [
      "Penetrating formula marketed as a wood preservative",
      "Resists mildew per the label",
      "Good on rough-sawn and weathered softwoods",
      "Wide range of natural tones",
      "Recoats without stripping"
    ],
    "cons": [
      "Restricted in some low-VOC states",
      "Often ordered online",
      "Longer cure time than water-based options"
    ],
    "description": "TWP 1500 Series is one of the most recommended products for large softwood jobs such as fences, rough-sawn siding and barns. It is an oil-based penetrating finish that the company positions as a wood preservative rather than a cosmetic stain, with mildew resistance on the label. Because it soaks in, it handles rough and weathered wood well, filling the texture instead of sitting in it, and it fades gradually rather than peeling. The tones range from very light cedar and redwood colors to deeper browns, and the toned versions last noticeably longer in sun than a clear would. Owners frequently mention that it is easy to spray on fences and simple to refresh every few years. The tradeoffs are availability and dry time. VOC rules restrict which TWP formulas reach some states, it is not stocked in every home center, and it needs warm, dry days to cure. Prices ran roughly 45 to 60 dollars per gallon at the time of writing, with five-gallon pails cheaper per gallon."
  },
  {
    "id": "cabot-australian-timber-oil",
    "badge": "Best for Dense Hardwoods",
    "category": "Oil-based translucent finish",
    "name": "Cabot Australian Timber Oil",
    "amazonUrl": "",
    "bottomLine": "The go-to finish when you want hardwood decking, furniture or trim to keep a warm, rich color.",
    "pros": [
      "Formulated for dense woods like ipe, mahogany and teak",
      "Rich, warm translucent color",
      "Widely available at major retailers",
      "Penetrates rather than building film",
      "Also works on softwoods"
    ],
    "cons": [
      "Oil-based, with longer dry times",
      "Darker tones can look orange on some woods",
      "Needs careful wiping on very dense woods"
    ],
    "description": "Cabot Australian Timber Oil is one of the few widely sold finishes designed with dense hardwoods in mind. It is a translucent, oil-based product that the company says penetrates tight-grained species such as ipe, mahogany and teak while still working on cedar and other softwoods. The result is a warm, rich color that enhances grain instead of hiding it. That makes it the natural choice for hardwood decking, outdoor furniture and trim where a standard sealer might sit on the surface and turn sticky. Owners like its color depth and availability, since it is stocked by major retailers. The main cautions are application and color. Apply thin coats and wipe off anything not absorbed within the label's wait time, especially on very dense woods. Test the tone first; on pale woods, some shades read more orange than expected. It is oil-based, so plan for longer dry times and solvent cleanup. Prices were roughly 45 to 65 dollars per gallon at the time of writing."
  },
  {
    "id": "totalboat-danish-teak-sealer",
    "badge": "Best for Outdoor Furniture",
    "category": "Teak and hardwood sealer",
    "name": "TotalBoat Danish Teak Sealer",
    "amazonUrl": "",
    "bottomLine": "The right finish for teak chairs, benches and tables you want to keep golden rather than silver.",
    "pros": [
      "Made for teak and dense marine hardwoods",
      "Penetrates rather than building a varnish-like film",
      "Enhances warm teak color",
      "Sold in small sizes suited to furniture",
      "Easy wipe-on application"
    ],
    "cons": [
      "Too expensive per gallon for large decks",
      "Needs recoating each season or so outdoors",
      "Excess must be wiped off carefully"
    ],
    "description": "TotalBoat Danish Teak Sealer comes from the marine world, where teak trim and decks take constant sun and water. It is a penetrating sealer formulated for teak and other dense hardwoods, meant to soak into tight grain and enrich the color without forming a varnish-like film. That makes it a good match for outdoor furniture, which is mostly teak, shorea, acacia or eucalyptus and is often too dense for ordinary deck sealers. Sold in quart and larger sizes, it is economical for a set of chairs and a table but not for a full deck. Application is simple: clean the piece, let it dry, wipe on a thin coat, wait and wipe off the excess, then add a second coat as the label directs. Like all teak finishes, it is maintenance-heavy compared with leaving the wood to weather; expect to refresh it every season or two outdoors. Owners commonly praise how evenly it colors weathered teak after cleaning. Prices were roughly 25 to 40 dollars per quart at the time of writing."
  },
  {
    "id": "sashco-transformation-log-siding",
    "badge": "Best for Log Homes",
    "category": "Log and siding stain",
    "name": "Sashco Transformation Log & Siding Stain",
    "amazonUrl": "",
    "bottomLine": "The specialist choice for log walls and rough timbers, where the finish must work with chinking and constant movement.",
    "pros": [
      "Designed specifically for log homes and rough siding",
      "Semi-transparent finish shows the wood texture",
      "Pairs with Sashco's log-home sealants and chinking",
      "Made for the movement and checking of logs",
      "Range of natural tones"
    ],
    "cons": [
      "Mostly sold through log-home suppliers and online",
      "More expensive than general stains",
      "Best used as part of the full Sashco system"
    ],
    "description": "Sashco is best known in the log-home world for its sealants and chinking, and Transformation Log & Siding Stain is the finish designed to go with them. It is a semi-transparent stain made for logs, timbers and rough-sawn siding, which move, check and expose far more end grain than ordinary boards. The advantage of buying a finish from the same company as your joint sealant is compatibility: the products are designed to be used together, so adhesion at the joints is less of a guessing game. Owners and log-home contractors generally describe it as easy to spray and back-brush into rough texture, and the tones are designed to look natural on large wall areas. It is more expensive than general-purpose stains and is easiest to buy from log-home suppliers or online. For a standard frame house with smooth siding, a general penetrating oil is simpler and cheaper; for a log home or heavy-timber structure, this is the type of product to use. Prices were roughly 55 to 75 dollars per gallon at the time of writing."
  },
  {
    "id": "seal-once-marine",
    "badge": "Best for Docks",
    "category": "Water-based penetrating sealer",
    "name": "Seal-Once Marine Premium Wood Sealer",
    "amazonUrl": "",
    "bottomLine": "The sealer to choose for docks, boardwalks and wood beside pools or ponds.",
    "pros": [
      "Water-based penetrating polymer formula",
      "Marketed for docks, piers and boathouses",
      "Low odor with soap-and-water cleanup",
      "Clear and tinted versions",
      "No thick film to peel on damp wood"
    ],
    "cons": [
      "Harder to find locally",
      "Clear version offers limited UV defense",
      "Higher price than basic repellents"
    ],
    "description": "Seal-Once Marine is a water-based penetrating sealer marketed for docks, piers, boathouses and other wood that sits close to water. It soaks in rather than building a film, which matters on wood that is damp much of the time, because a film over constantly wet boards tends to lift. Its lower solvent content compared with traditional oil finishes is another reason waterfront owners choose it. Clear and tinted versions are available, and the tinted ones add UV protection that the clear lacks. Owners generally describe it as easy to roll on, quick to dry and simple to clean up. The main drawbacks are availability and price: it is more often bought online or from marine suppliers than at a home center, and it costs more than basic repellents. For dry siding or fences far from water, other picks here are better values. For dock boards and pool surrounds, apply by roller, keep drips out of the water and recoat as the water test dictates. Prices were roughly 45 to 65 dollars per gallon at the time of writing."
  },
  {
    "id": "thompsons-waterseal-advanced",
    "badge": "Best Budget",
    "category": "Clear water repellent",
    "name": "Thompson's WaterSeal Advanced Natural Wood Protector",
    "amazonUrl": "",
    "bottomLine": "A cheap, easy water repellent for utility wood where color retention is not the goal.",
    "pros": [
      "Inexpensive and stocked almost everywhere",
      "Quick, easy application",
      "Strong initial water beading",
      "Fine for sheds, playsets and utility fences",
      "Simple to reapply each year"
    ],
    "cons": [
      "Little UV protection, so wood still grays",
      "Short life on horizontal surfaces",
      "Overapplication leaves a tacky surface"
    ],
    "description": "Thompson's WaterSeal Advanced Natural Wood Protector is the budget benchmark for exterior wood. It is easy to find, inexpensive and simple to apply with a pump sprayer or roller, and it makes water bead immediately. For sheds, playsets, utility fences, raised garden bed frames and other wood where you mainly want to slow water absorption, it does the job at a low cost. What it does not do is stop graying. With no pigment and little UV defense, wood finished with it still weathers in color, and on horizontal surfaces the water repellency typically fades within a year or so. That makes it a poor match for cedar siding or hardwood furniture you want to keep warm in tone, and a perfectly reasonable one for a garden shed. The most common complaint is a tacky surface, which almost always comes from applying a second coat while the first is still repelling water. Prices ran roughly 20 to 35 dollars per gallon at the time of writing."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Exterior Wood Sealers",
          item: "https://www.allmetalbrake.com/best-exterior-wood-sealer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which sealer suits most outdoor wood?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There is no single best sealer for every outdoor surface. For most siding, fences and decks, a toned penetrating oil such as Penofin Blue Label or TWP 1500 offers the best balance of protection and easy upkeep. Dense hardwood furniture needs a teak or hardwood sealer, log homes need a log-specific system, and wood near water benefits from a water-based penetrating product."
          }
        },
        {
          "@type": "Question",
          "name": "How many years does an exterior sealer protect wood?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On vertical siding and fences, a quality toned penetrating finish often lasts three to five years or more, depending on sun and climate. On horizontal decking, the same product may last only one to three years. Clear finishes and teak oils wear faster. Use the water drop test on sunny and shaded areas to decide when to recoat."
          }
        },
        {
          "@type": "Question",
          "name": "Should I seal or stain exterior wood?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you want the natural color and accept frequent upkeep, a clear sealer works. If you want longer protection from sun and fewer recoats, a semi-transparent stain is the better choice because pigment blocks UV. Many products sit between the two as toned sealers. Solid stain or paint makes sense mainly on weathered, mismatched or previously coated wood."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use the same sealer on furniture and my deck?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sometimes, but it is rarely ideal. Most deck sealers are formulated for softwoods and foot traffic, while outdoor furniture is usually dense hardwood that needs a thin finish made for tight grain. A versatile penetrating oil can work on both if the label lists hardwoods. Otherwise, buy a small container of teak sealer for the furniture."
          }
        },
        {
          "@type": "Question",
          "name": "Does exterior wood need sealing every year?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not always. Furniture finished with teak oil may need it every season, and clear finishes on decks often need yearly attention. Toned penetrating oils on fences and siding can go several years between coats. The water drop test is the best guide: recoat when water soaks in quickly rather than on a fixed calendar."
          }
        },
        {
          "@type": "Question",
          "name": "Is water-based or oil-based better for exterior wood?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oil-based penetrating finishes typically soak deeper into dense or weathered wood and fade gradually. Water-based finishes dry faster, have less odor, clean up with soap and water and meet strict VOC rules. For docks and areas near water or plants, many owners prefer water-based products. Check the label for your species and climate before deciding."
          }
        },
        {
          "@type": "Question",
          "name": "What should I seal log ends with?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Log ends are end grain and absorb far more water than log faces, so they need extra attention. Apply additional coats of your log-home finish, and consider a product designed for end grain. Covering exposed ends with caps or flashing helps further. Ends that extend past the roofline weather fastest and should be inspected every year."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Deck & Wood Finishes",
    tags: [
      "best exterior wood sealer",
      "outdoor wood sealer",
      "wood siding sealer",
      "outdoor furniture finish",
      "log home sealer",
      "penetrating oil finish"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Exterior Wood Sealers</span>, Sorted by Project
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Siding, a teak bench, a log wall and a boat dock all count as exterior wood, and they do not want the same finish. These seven sealers are matched to the project and the species rather than ranked on one scale.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#penofin-blue-label"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="9.1k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#finish-types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Finish Types Explained</a>
          <a href="#prep-by-surface" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Prep by Surface</a>
          <a href="#siding-trim" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Siding and Trim</a>
          <a href="#fences-structures" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Fences and Structures</a>
          <a href="#furniture" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Outdoor Furniture</a>
          <a href="#logs-timbers" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Logs and Timbers</a>
          <a href="#docks-wet" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Docks and Wet Zones</a>
          <a href="#exposure" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Life by Exposure</a>
          <a href="#application" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Applying on Vertical Wood</a>
          <a href="#upkeep" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Maintenance and Safety</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">13. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A deck takes the hardest beating of any wood on a property, so most sealer advice is written for decks. The rest of the outdoor wood is a different problem. Siding and trim face the sun at an angle and shed water quickly, so finishes last far longer there. Outdoor furniture is dense, handled constantly and often made from oily tropical species. Log walls move, check and wick water through huge end grain. Dock boards sit inches above water every day of the year. The sealer that suits one of those can fail on another. This guide starts from the project, names the finish type each one needs, and then points to a specific product that fits.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Best Exterior Wood Sealers, by Project
          </h2>

          <p>
            Each product is matched to the project it is designed for, based on manufacturer data sheets and labels, stated coverage and recoat intervals, VOC availability and recurring patterns in owner reports. We did not run our own exposure trials. Where two products could fit, we chose the one with the clearer label guidance for that use.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
