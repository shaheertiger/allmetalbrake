  {
    "title": "Best Battery Backup for CPAP",
    "url": "/best-battery-backup-for-cpap/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "The Best Indoor Heaters for Power Outages: Safe Emergency Heat";
const description =
  "Indoor-rated propane heaters, low-watt electric heat for power stations and the CO alarm you need first, with runtime math and the safety rules that matter.";

const PRODUCTS = [
  {
    "id": "mr-heater-portable-buddy",
    "name": "Mr. Heater Portable Buddy Propane Heater",
    "category": "4,000/9,000 BTU, Indoor-Safe, ODS + Tip-Over",
    "badge": "Best Overall Indoor Heater",
    "amazonUrl": "",
    "pros": [
      "Sold by Mr. Heater as indoor-safe, with an oxygen depletion sensor and tip-over shutoff",
      "Two settings, so you can run low through the night and high to warm a cold room",
      "Rated to heat a space of roughly 225 square feet, the size of a typical bedroom",
      "Runs on a 1-lb propane cylinder with no electricity at all",
      "Piezo ignition and a fold-down handle make it easy to place and light"
    ],
    "cons": [
      "A 1-lb cylinder lasts only a few hours on high, so stock plenty",
      "Needs a fresh-air opening per the manual, which costs some heat",
      "The front grille gets hot enough to burn skin and scorch fabric"
    ],
    "bottomLine": "The default indoor emergency heater for most homes: enough heat for one closed-off room, simple to run, and built around the right safety devices.",
    "description": "The Portable Buddy, model MH9BX, is the heater most people mean when they talk about indoor propane. Mr. Heater rates it at 4,000 or 9,000 BTU per hour and markets it as indoor-safe, which in practice means it has an oxygen depletion sensor that shuts the burner off if oxygen in the room drops, and a tip-over switch that kills the flame if it is knocked over. Those two features are why it is on this list and a patio heater is not. It runs from a single 1-lb propane cylinder. By the fuel math, a 1-lb cylinder holds a little over 21,000 BTU, so expect roughly two to two and a half hours on high and around five on low. That makes the low setting the one you will actually live on. Use it in a room you have closed off, crack a window or door to the size the manual requires, keep it at least the stated distance from bedding and curtains, and never run it without a working CO alarm in the same room."
  },
  {
    "id": "mr-heater-big-buddy",
    "name": "Mr. Heater Big Buddy Propane Heater",
    "category": "4,000/9,000/18,000 BTU, Indoor-Safe, Two Cylinders",
    "badge": "Best for Larger Rooms",
    "amazonUrl": "",
    "pros": [
      "Three settings up to 18,000 BTU for a living room or open family area",
      "Indoor-safe rating with oxygen depletion sensor and tip-over shutoff",
      "Holds two 1-lb cylinders, roughly doubling runtime between swaps",
      "Optional battery-powered fan helps move heat across a bigger room"
    ],
    "cons": [
      "High setting burns fuel fast and needs more ventilation",
      "Bulkier and heavier than the Portable Buddy",
      "Overkill for a single bedroom"
    ],
    "bottomLine": "The pick when your warm room is a living room rather than a bedroom, or when the whole family is camping in one space.",
    "description": "The Big Buddy, model MH18B, is the Portable Buddy scaled up. Mr. Heater lists three settings, 4,000, 9,000 and 18,000 BTU, and the same oxygen depletion sensor and tip-over shutoff, with room for two 1-lb cylinders on board. It is rated for spaces up to roughly 450 square feet, which covers a living room or a den where a family can gather with mattresses on the floor. The high setting is for bringing a cold room up to temperature, not for all night. At 18,000 BTU an hour, two 1-lb cylinders last only a little over two hours by the fuel math, and the manual asks for a larger fresh-air opening at higher output. Settle on low or medium once the room is warm. The fan is a genuine help in a larger room and runs on D batteries, so it still works when the grid is down. If your plan is one bedroom, the smaller Portable Buddy is easier and cheaper to feed."
  },
  {
    "id": "mr-heater-little-buddy",
    "name": "Mr. Heater Little Buddy Propane Heater",
    "category": "3,800 BTU, Indoor-Safe, Compact",
    "badge": "Best for Small Rooms",
    "amazonUrl": "",
    "pros": [
      "Compact and light; screws straight onto a 1-lb cylinder",
      "Oxygen depletion sensor and tip-over shutoff like its bigger siblings",
      "Low 3,800 BTU output stretches a cylinder through more of the night",
      "Right-sized for a bathroom, small bedroom or tent"
    ],
    "cons": [
      "Single heat setting with no high option",
      "Cylinder sits underneath, so it is tall and must be on a stable, level surface",
      "Too small to warm anything larger than a small room"
    ],
    "bottomLine": "A sensible small-room heater and a good second unit, but too little output to be the only heat in most houses.",
    "description": "The Little Buddy, model MH4B, is the smallest indoor-rated heater in the Buddy line. Mr. Heater lists it at 3,800 BTU an hour for spaces up to about 95 square feet, with the same oxygen depletion sensor and tip-over protection. The cylinder screws into the base, so the whole unit is about the size of a large coffee can on a stand. Low output is the point. At 3,800 BTU an hour, a 1-lb cylinder runs for roughly five to six hours by the fuel math, which gets a small bedroom through much of the night with one swap. It is also a good choice for a bathroom where you need just enough warmth to wash, or as a second unit alongside a Portable Buddy. It will not keep up with a large room in real cold, and it has no high setting to recover a room that has already dropped into the 40s. Check the manual for altitude limits, because oxygen depletion sensors are sensitive to thin air."
  },
  {
    "id": "first-alert-co400",
    "name": "First Alert CO400 Battery-Powered Carbon Monoxide Alarm",
    "category": "Battery CO Alarm, Works Without Grid Power",
    "badge": "Must-Have First Purchase",
    "amazonUrl": "",
    "pros": [
      "Battery-powered, so it keeps working when the power is out",
      "Electrochemical sensor sounds a loud alarm at dangerous CO levels",
      "Small enough to put in the exact room where the heater runs",
      "Inexpensive enough to buy one for every sleeping area"
    ],
    "cons": [
      "No digital readout, so you cannot see low, rising levels",
      "Alarms and batteries have a limited service life; replace on schedule"
    ],
    "bottomLine": "Buy this before you buy a heater. Any fuel-burning heat source in a living space needs a working battery CO alarm beside it.",
    "description": "A hardwired CO alarm without battery backup goes silent the moment the power goes out, which is exactly when people bring fuel-burning equipment inside. The First Alert CO400 runs on batteries, so it does not care whether the grid is up. It uses an electrochemical sensor and sounds a loud alarm when carbon monoxide reaches a dangerous concentration over time, as UL 2034 alarms are designed to. It is the cheapest piece of insurance on this page and the one that matters most. Put one in the room where the heater runs, one in or near every sleeping area, and one on each level of the house. Test it before the season starts and again before every outage you can see coming. Kidde and other brands make equivalent battery-powered alarms, and some include a digital display that shows lower levels before the alarm threshold, which is useful if you can find one. What matters is that it runs on batteries and that it is in the room."
  },
  {
    "id": "sunbeam-heated-throw",
    "name": "Sunbeam Microplush Heated Throw Blanket",
    "category": "Low-Watt Electric, Power Station Friendly",
    "badge": "Best Electric Option",
    "amazonUrl": "",
    "pros": [
      "Draws a small fraction of what a space heater draws",
      "Heats the person rather than the room, which is far more efficient",
      "A mid-size power station can run one through a night",
      "Useful every winter, not just during outages"
    ],
    "cons": [
      "Needs a power station, generator or other source of AC power",
      "Does nothing for pipes or room temperature",
      "Auto shutoff timers may need resetting through the night"
    ],
    "bottomLine": "The best use of stored battery power for warmth: a heated throw on a power station keeps a person comfortable for hours on the energy a space heater burns in minutes.",
    "description": "If you own a power station, the most effective thing you can do with it in the cold is heat people, not air. A heated throw like Sunbeam's Microplush model puts warmth directly against your body under a blanket that also traps it, and heated throws and blankets of this type typically draw well under 100 watts, often far less on low settings. Check the label on the one you buy. The difference is enormous. A 1,500-watt space heater empties a 1kWh power station in well under an hour, while a heated throw drawing around 50 watts runs for most of a night on the same battery. Pair it with a sleeping bag or a stack of comforters and you have a bed that stays warm even as the room drops into the 50s. Sunbeam throws include an auto shutoff for safety, which is a good thing but means someone may wake to restart it. Use it on top of you, not folded or tucked under a mattress, and follow the manufacturer's instructions."
  },
  {
    "id": "coleman-north-rim-sleeping-bag",
    "name": "Coleman North Rim 0 Degree Mummy Sleeping Bag",
    "category": "Cold-Rated Sleeping Bag, No Fuel or Power",
    "badge": "Best Zero-Energy Heat",
    "amazonUrl": "",
    "pros": [
      "Needs no fuel, no electricity and no ventilation",
      "Mummy hood traps heat around your head and shoulders",
      "Cold-weather rating far beyond what an indoor room will reach",
      "Doubles as camping gear the rest of the year"
    ],
    "cons": [
      "Mummy shape feels confining to some sleepers",
      "Synthetic fill is bulky to store",
      "Temperature ratings are best-case; layer if you sleep cold"
    ],
    "bottomLine": "The cheapest, safest way to sleep warm in a cold house. Every household planning for winter outages should own one cold-rated bag per person.",
    "description": "A good sleeping bag is the most underrated piece of emergency heat equipment. It burns nothing, draws nothing, and turns your own body heat into the heat source. The Coleman North Rim is a widely sold synthetic mummy bag with a 0-degree Fahrenheit rating, which is far colder than the inside of a house will get in all but the longest outages. Treat that rating as a survival limit rather than a comfort guarantee; most people are comfortable well above a bag's rated low. Indoors, that margin is exactly what you want. A family sleeping in cold-rated bags in one closed-off room can ride out a night in the 40s with no heater at all, and a small propane heater only needs to take the edge off in the evening. Put a foam pad or a mattress under the bag, because the ground or floor pulls heat out faster than air does. If a mummy bag is too confining, a rectangular bag with a lower rating plus a wool blanket works too."
  },
  {
    "id": "lasko-754200-ceramic-heater",
    "name": "Lasko 754200 Ceramic Space Heater",
    "category": "1,500W Ceramic, Low Setting, Tip-Over Safety",
    "badge": "Best for Generator Owners",
    "amazonUrl": "",
    "pros": [
      "Electric, so no combustion and no carbon monoxide",
      "Low setting reduces draw below the 1,500W maximum",
      "Tip-over and overheat protection",
      "Small and inexpensive, with a long track record"
    ],
    "cons": [
      "Even on low, it drains a portable power station in hours or less",
      "Really only practical on a generator or large home battery",
      "Heats one small space and nothing else"
    ],
    "bottomLine": "Worth owning only if you have a generator or a large home battery. On a typical portable power station, it is the fastest way to waste stored energy.",
    "description": "This is on the list partly as a warning. The Lasko 754200 is a widely sold small ceramic heater with a high setting of 1,500 watts, a lower setting, tip-over protection and an overheat cutoff. It is a perfectly good electric heater. It is just a poor match for most battery backup. At 1,500 watts, a 1kWh power station lasts roughly 35 to 40 minutes once inverter losses are counted, and the low setting buys only a little more time. Where it makes sense is with a generator running outside, a whole-home battery system, or a large portable station you can recharge with solar or a generator. Electric resistance heat produces no combustion gases, which is a real advantage in a closed room, and a ceramic heater with tip-over protection is safer than any open flame. Plug it directly into the station or a heavy-duty cord rated for the load, keep three feet of clearance from anything that can burn, and do not run it unattended."
  }
];

const schema = {
