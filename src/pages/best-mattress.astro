---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Mattresses for Side Sleepers",
    "url": "/best-mattress-for-side-sleepers/"
  },
  {
    "title": "Best Mattress Toppers",
    "url": "/best-mattress-topper/"
  },
  {
    "title": "Best Mattresses for Seniors",
    "url": "/best-mattress-for-seniors/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-13", modified: "2026-11-13" });
const title = "Top Rated Mattresses: 7 Best Mattresses in 2026 by Sleeper";
const description =
  "Top rated mattresses for 2026, ranked by sleep position and budget: seven foam and hybrid picks, the firmness that suits you, and what trials really cover.";

const PRODUCTS = [
  {
    "id": "nectar-12-hybrid-medium-firm",
    "name": "Nectar 12” Hybrid Mattress, Medium Firm",
    "category": "Hybrid, medium-firm",
    "badge": "Best Overall",
    "amazonUrl": "#",
    "specs": [
      [
        "Type",
        "Memory foam over innerspring coils"
      ],
      [
        "Height",
        "12 in"
      ],
      [
        "Feel",
        "Medium firm (Nectar)"
      ],
      [
        "Trial",
        "1 year (per listing)"
      ],
      [
        "Cover",
        "Cooling top layer"
      ]
    ],
    "pros": [
      "Medium-firm feel suits back, side and combination sleepers",
      "Coils add airflow and edge support over all-foam",
      "Year-long home trial on the Amazon listing",
      "Memory foam comfort layer for pressure relief",
      "Widely available in every standard size"
    ],
    "cons": [
      "Memory foam top still sleeps warmer than latex",
      "Heavy to move once unboxed"
    ],
    "bottomLine": "The safest single recommendation for most sleepers: a medium-firm hybrid with a year to decide whether it suits you.",
    "description": "Nectar built its name on an all-foam bed, and the 12-inch hybrid adds a layer of coils beneath the memory foam, which is the change most sleepers benefit from. The coils give the bed more bounce, firmer edges and better airflow than the foam version, while the memory foam comfort layer still contours to shoulders and hips. Nectar rates it medium firm, which lands in the range that suits back sleepers and most side and combination sleepers. The Amazon listing carries a one-year trial, which is among the longest anywhere and gives you a full change of seasons to judge it. Owners commonly praise the value and the pressure relief and most often mention that it takes a few weeks to soften to its final feel. If you sleep very hot, a latex hybrid will be cooler; for everyone else, this is the bed to start with."
  },
  {
    "id": "helix-midnight-luxe",
    "name": "Helix Midnight Luxe Mattress",
    "category": "Hybrid, medium, zoned",
    "badge": "Best for Side and Combination Sleepers",
    "amazonUrl": "#",
    "specs": [
      [
        "Type",
        "Hybrid with pocketed coils"
      ],
      [
        "Feel",
        "Medium (Helix)"
      ],
      [
        "Support",
        "Zoned lumbar support (Helix)"
      ],
      [
        "Cover",
        "Pillow top; GlacioTex cooling option"
      ],
      [
        "Best for",
        "Side and combination sleepers"
      ]
    ],
    "pros": [
      "Medium feel cushions shoulders and hips",
      "Zoned support firms up under the lower back",
      "Pillow top adds plushness without losing bounce",
      "Cooling cover available on some listings",
      "Responsive enough to change position easily"
    ],
    "cons": [
      "Costs more than most picks here",
      "Too soft for most stomach sleepers"
    ],
    "bottomLine": "A plush, zoned hybrid that suits side and combination sleepers who want pressure relief without sinking in.",
    "description": "Helix designs its line around sleep position, and the Midnight Luxe is the model it aims at side and combination sleepers. It pairs a pillow top and foam comfort layers with pocketed coils, and Helix says the coils are zoned to give extra support under the lumbar area while letting the shoulders sink. That combination answers the most common side-sleeper complaint, a sore shoulder on a firm bed, without leaving the hips unsupported. Helix rates the feel as medium. Some Amazon listings include the GlacioTex cooling cover, which is worth choosing if you run warm. Owners commonly describe it as plush but supportive and note good edge support for a hybrid. The trade-off is price, which sits above most of this list, and a feel that is too soft for dedicated stomach sleepers."
  },
  {
    "id": "tempur-adapt-2-medium-11",
    "name": "TEMPUR-Adapt 2.0 Medium 11 inch Memory Foam Mattress",
    "category": "Memory foam, medium",
    "badge": "Best Memory Foam",
    "amazonUrl": "#",
    "specs": [
      [
        "Type",
        "TEMPUR memory foam"
      ],
      [
        "Height",
        "11 in"
      ],
      [
        "Feel",
        "Medium (Tempur-Pedic)"
      ],
      [
        "Motion isolation",
        "Very high (owner reports)"
      ],
      [
        "Best for",
        "Pressure relief, light sleepers"
      ]
    ],
    "pros": [
      "Deep, even pressure relief from dense TEMPUR material",
      "Excellent motion isolation for couples",
      "Holds its shape well over time, owners report",
      "Medium feel works for side and back sleepers",
      "Established brand with wide service network"
    ],
    "cons": [
      "Expensive for an all-foam bed",
      "Slow, sinking feel and warmer than a hybrid"
    ],
    "bottomLine": "The pick for people who want classic memory foam pressure relief and a partner they never feel move.",
    "description": "Tempur-Pedic invented the consumer memory foam mattress, and the TEMPUR-Adapt is the core of its line. The 2.0 Medium version on Amazon is an 11-inch all-foam bed built from the brand's dense TEMPUR material, which responds slowly and molds closely around the body. That gives some of the best pressure relief and motion isolation available, which is why it is popular with side sleepers, people with joint pain and couples on different schedules. The trade-offs are the ones that come with dense memory foam: it sleeps warmer than a hybrid, and the slow response can make changing position feel like effort. It is also expensive for an all-foam mattress. Owners commonly report that it keeps its shape for many years, which goes some way to justifying the price. If you want the same feel with coils underneath, Tempur-Pedic sells LuxeAdapt and ProAdapt hybrid versions."
  },
  {
    "id": "casper-original-hybrid-11",
    "name": "Casper Sleep Original 11\" Hybrid Mattress – Medium Feel",
    "category": "Hybrid, medium, zoned",
    "badge": "Best for Back Sleepers",
    "amazonUrl": "#",
    "specs": [
      [
        "Type",
        "Foam over pocketed coils"
      ],
      [
        "Height",
        "11 in"
      ],
      [
        "Feel",
        "Medium (Casper)"
      ],
      [
        "Support",
        "Zoned support (Casper)"
      ],
      [
        "Trial",
        "100 nights (per listing)"
      ]
    ],
    "pros": [
      "Zoned foam is firmer under the hips, softer at the shoulders",
      "Balanced medium feel for back and combination sleepers",
      "Coils add airflow and bounce",
      "CertiPUR-US certified foams",
      "100-night trial"
    ],
    "cons": [
      "Shorter trial than Nectar",
      "Edges softer than coil-heavy hybrids"
    ],
    "bottomLine": "A balanced, zoned hybrid that keeps back sleepers' hips level without feeling hard.",
    "description": "The Casper Original Hybrid is an 11-inch mattress with foam layers over pocketed coils, and its key feature is zoned support: Casper says the foam is firmer under the hips and lower back and softer under the shoulders. For back sleepers, that zoning is exactly what keeps the pelvis from sinking and the lower back from aching. The medium feel also suits combination sleepers, and the coils give it more bounce and airflow than Casper's all-foam models. The Amazon listing notes CertiPUR-US certified foams and a 100-night trial, which is shorter than Nectar's but still long enough to judge the bed properly. Owners commonly describe the feel as balanced rather than plush or firm. Its edges are softer than heavier coil-on-coil hybrids, so if you often sit on the side of the bed, consider that before buying."
  },
  {
    "id": "purple-mattress-original-9-25",
    "name": "Purple Mattress, 9.25 Inch, 2 Inch GelFlex Grid",
    "category": "Hyper-elastic polymer grid over foam",
    "badge": "Best for Hot Sleepers",
    "amazonUrl": "#",
    "specs": [
      [
        "Type",
        "GelFlex Grid over foam"
      ],
      [
        "Height",
        "9.25 in"
      ],
      [
        "Comfort layer",
        "2 in GelFlex Grid"
      ],
      [
        "Feel",
        "Medium-firm, responsive (owner reports)"
      ],
      [
        "Made in",
        "USA (per listing)"
      ]
    ],
    "pros": [
      "Open grid lets air move, so it sleeps cool",
      "Unique feel that cushions without sinking",
      "Responsive, easy to change position",
      "Made in the USA",
      "Good motion isolation for a bouncy surface"
    ],
    "cons": [
      "The grid feel is unusual and not for everyone",
      "Thinner than most picks at 9.25 inches"
    ],
    "bottomLine": "The coolest-sleeping non-coil bed here, with a grid that cushions without trapping you.",
    "description": "Purple's original mattress replaces memory foam with a 2-inch layer of GelFlex Grid, a stretchy polymer formed into open square cells. The grid collapses under pressure points such as shoulders and hips and stays firm elsewhere, which gives cushioning without the slow sink of memory foam. Because the grid is open, air moves through it, and owners consistently rank it among the coolest-sleeping mattresses without coils. The listing describes it as temperature neutral and made in the USA. The feel is genuinely different from anything else, often described as springy and slightly squishy, and some people dislike it on first contact, which makes the trial essential. At 9.25 inches it is thinner than the other picks, so heavier sleepers should look at Purple's hybrid models instead. For hot sleepers under about 230 pounds, it is the most interesting option here."
  },
  {
    "id": "tuft-needle-original-hybrid-legacy",
    "name": "Tuft & Needle Original Hybrid Legacy Medium Mattress",
    "category": "Hybrid, medium",
    "badge": "Best Value Hybrid",
    "amazonUrl": "#",
    "specs": [
      [
        "Type",
        "Foam over pocketed coils"
      ],
      [
        "Feel",
        "Medium (Tuft & Needle)"
      ],
      [
        "Warranty",
        "10 years (per listing)"
      ],
      [
        "Trial",
        "100 nights (per listing)"
      ],
      [
        "Made in",
        "USA (per listing)"
      ]
    ],
    "pros": [
      "Hybrid construction at a mid-range price",
      "Simple, honest spec sheet and medium feel",
      "10-year limited warranty and 100-night trial",
      "CertiPUR-US certified foam",
      "Made in the USA"
    ],
    "cons": [
      "Fewer comfort layers than premium hybrids",
      "Not firm enough for heavier stomach sleepers"
    ],
    "bottomLine": "A no-nonsense medium hybrid that gives most of the benefits of coils for less money.",
    "description": "Tuft & Needle has always sold a short line-up with plain descriptions, and the Original Hybrid is its middle-of-the-road coil bed. It puts the brand's adaptive foam over pocketed coils, giving a medium feel with more bounce and airflow than its all-foam original. The Amazon listing shows a 10-year limited warranty, a 100-night trial, CertiPUR-US certification and US manufacture. That is a strong package at its price. It has fewer comfort layers than premium hybrids, so pressure relief is good rather than exceptional, and side sleepers with sharp shoulders may want something plusher. For back and combination sleepers on a budget, and for guest rooms that get real use, it is the sensible buy. Owners commonly mention that the foam feels firmer and more supportive than typical memory foam, which suits people who dislike the sinking feel."
  },
  {
    "id": "zinus-green-tea-12-medium-firm",
    "name": "Zinus 12 Inch Green Tea Memory Foam Mattress, Medium Firm",
    "category": "Memory foam, medium-firm",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "specs": [
      [
        "Type",
        "Memory foam"
      ],
      [
        "Height",
        "12 in"
      ],
      [
        "Feel",
        "Medium firm (Zinus)"
      ],
      [
        "Certifications",
        "CertiPUR-US and OEKO-TEX (per listing)"
      ],
      [
        "Best for",
        "Budget, guest rooms, lighter sleepers"
      ]
    ],
    "pros": [
      "One of the lowest-priced full-height mattresses",
      "Medium-firm feel works for many back and side sleepers",
      "CertiPUR-US and OEKO-TEX listed",
      "Very easy to set up",
      "Huge number of owner reviews to judge by"
    ],
    "cons": [
      "Lower-density foam softens sooner than premium beds",
      "Sleeps warm and has weak edges"
    ],
    "bottomLine": "The bed to buy when price comes first: comfortable for lighter sleepers and guests, but not built to last a decade.",
    "description": "The Zinus Green Tea mattress has been one of Amazon's best-selling beds for years because it delivers a 12-inch memory foam mattress at a price most brands cannot touch. Zinus describes the 12-inch version as medium firm, and the listing notes CertiPUR-US and OEKO-TEX certifications. For a guest room, a teenager's room or a lighter adult on a tight budget, it is comfortable and easy to live with. Be realistic about the trade-offs. The foams are lower density than premium beds, and owners commonly report that it softens noticeably over a few years, faster for heavier sleepers. Like most all-foam beds it sleeps warm, and the edges compress when you sit on them. If you weigh over about 230 pounds or want a bed for ten years, spend more; otherwise this is the value pick."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Top Rated Mattresses",
          item: "https://www.allmetalbrake.com/best-mattress/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the top rated mattress type for most people?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A medium-firm hybrid suits the widest range of sleepers. Its coils give support, bounce and airflow, and its foam layers relieve pressure at the shoulders and hips. It works for back sleepers, most side sleepers and couples. Side sleepers who want more cushioning, and hot sleepers, may prefer a softer hybrid or a latex bed."
          }
        },
        {
          "@type": "Question",
          "name": "How long should a mattress last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most well-made mattresses last seven to ten years. Budget all-foam beds can soften within three to five years, especially under heavier sleepers. Replace a mattress when it has visible sagging, when you wake up stiff and feel better elsewhere, or when it has passed the warranty's sag depth."
          }
        },
        {
          "@type": "Question",
          "name": "Are mattress in a box beds any good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Rolling and compression do not harm well-made foam or pocketed coils, and online brands save money on showrooms. The main differences are the long home trial, which is a better test than lying on a bed in a store, and a day or two of expansion and off-gassing."
          }
        },
        {
          "@type": "Question",
          "name": "What firmness is best for back pain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Medium-firm is the most common recommendation, because it supports the lower back while letting the hips and shoulders settle enough to keep the spine straight. Very soft beds let the hips sag and very firm beds create pressure points. Persistent back pain is worth discussing with a doctor or physical therapist."
          }
        },
        {
          "@type": "Question",
          "name": "Should couples get a hybrid or memory foam mattress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Memory foam isolates motion best, so it suits couples where one partner is a light sleeper. Hybrids with pocketed coils still isolate motion well while adding bounce, edge support and airflow, and they handle two different body weights better. For most couples a hybrid is the better all-round choice."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a box spring for a new mattress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not. Most modern mattresses need a firm, flat base such as a platform bed, a slatted frame with slats close together, or a foundation, not a traditional box spring with springs inside. Check the maker's requirements, because an unsupported base can cause sagging and void the warranty."
          }
        },
        {
          "@type": "Question",
          "name": "When is the best time to buy a mattress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Online mattress brands run their deepest discounts around major holidays, including Presidents Day, Memorial Day, Labor Day and Black Friday. Many beds are discounted most of the year, so compare the actual sale price between brands rather than the percentage off, and buy when your current bed is failing."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Sleep & Mattresses",
    tags: [
      "top rated mattresses",
      "best mattresses",
      "best mattress",
      "best mattress in a box",
      "mattress comparison",
      "best rated mattress"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          Top Rated Mattresses: The 7 Best Mattresses
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          For most people the best mattress is a medium-firm hybrid: coils for support and airflow, foam on top for pressure relief. Side sleepers lean softer, stomach and heavier sleepers lean firmer, and a long home trial matters more than any showroom test.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/shaheer-ali-khan/" class="font-bold text-gray-900 no-underline hover:underline">Shaheer Ali Khan</a></p>
            <p class="text-xs text-gray-500 m-0">Materials &amp; Product Performance Specialist &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">11 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#choose" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>How to Choose</span></a>
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>Top Picks</span></a>
              <a href="#types" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Mattress Types</span></a>
              <a href="#firmness" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Firmness by Position</span></a>
              <a href="#weight" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>Body Weight</span></a>
              <a href="#heat" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Sleeping Hot</span></a>
              <a href="#box" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>In a Box vs Store</span></a>
              <a href="#trials" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>Trials and Warranties</span></a>
              <a href="#budget" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>What to Spend</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
