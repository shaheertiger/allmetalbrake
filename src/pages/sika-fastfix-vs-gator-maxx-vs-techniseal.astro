---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/sika-fastfix-vs-gator-maxx-vs-techniseal.html?raw';

const title = "Sika FastFix vs Gator Maxx vs Techniseal RG+: Polymeric Sand";
const description = "Gator Maxx G2 fills 1/8 to 4 inch joints and is rain-safe 15 minutes after watering; Techniseal RG+ tops out at 1 inch; Sika FastFix-110 needs 24 h before foot traffic.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
