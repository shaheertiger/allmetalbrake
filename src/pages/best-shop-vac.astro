const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Shop Vac Picks",
          item: "https://www.allmetalbrake.com/best-shop-vac/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which shop vac is best for a typical garage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most garages and home workshops, a 12 to 14-gallon vac with a 2-1/2-inch hose and a drain port is the right size, and the Ridgid HD1400 NXT fits that description well. If you regularly deal with flooding or renovation debris, the Craftsman 16-gallon is worth the extra size. For cars and small spills, a compact 5 or 6-gallon vac is easier."
          }
        },
        {
          "@type": "Question",
          "name": "Is peak horsepower a useful way to compare shop vacs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The peak figure describes momentary motor output with no load, which never happens while vacuuming. Airflow in CFM and sealed suction in inches of water lift are more meaningful, along with hose diameter. Two vacs with the same peak HP rating can perform quite differently depending on the fan, housing and hose design."
          }
        },
        {
          "@type": "Question",
          "name": "What hose diameter should I choose?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For garage and workshop debris, choose a 2-1/2-inch hose, which passes chips, leaves and screws without clogging. A 1.875-inch hose suits general dust and connecting to tools. A 1.25-inch hose is for cars and small jobs. Many owners keep a wide hose for floors and an adapter or second hose for tools and tight spaces."
          }
        },
        {
          "@type": "Question",
          "name": "When is a HEPA filter actually necessary?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you clean up drywall dust, concrete or masonry dust, or fine sanding dust, a HEPA-rated filter plus a collection bag is strongly recommended. Concrete and masonry dust contain silica, and OSHA guidance for construction calls for HEPA vacuums in many cleanup tasks. For general debris, sawdust and water, a standard filter is fine."
          }
        },
        {
          "@type": "Question",
          "name": "Can a shop vac pick up water from a flooded basement?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, for shallow water. Remove the paper filter, fit a foam sleeve, plug into a GFCI outlet and keep the cord connection dry. Empty the tank through the drain port when the float shuts off airflow. For deep flooding, or water near outlets and appliances, cut power at the panel and call a professional before entering."
          }
        },
        {
          "@type": "Question",
          "name": "What usually causes a sudden drop in suction?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The usual causes, in order, are a clogged filter, a full tank with the float closed, a blockage in the hose or nozzle, a loose lid or missing gasket, and a damaged hose. Check suction at the tank inlet with the hose removed to narrow it down. Motor failure is possible but much less common than a clogged filter."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy a dust extractor instead of a shop vac?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if you sand, rout or cut indoors regularly and want dust captured at the tool. Extractors are quieter and filter better but cost several times more and use smaller hoses that are not ideal for floor debris. For garage cleanup, water and occasional sawdust, a shop vac with a good filter and a bag is the better value."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

