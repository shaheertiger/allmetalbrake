const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "7 Best Shop Vacs in 2026: Wet/Dry Vacuums by Hose and Tank";
const description =
  "Seven wet/dry shop vacs ranked for garages, workshops and flooded basements, with plain advice on airflow, hose size, filters, fine dust and peak HP.";

const PRODUCTS = [
  {
    "badge": "Top Pick Overall",
    "category": "14-Gallon Tank, 2.5-Inch Hose, 6.0 Peak HP",
    "name": "Ridgid HD1400 14 Gallon NXT",
    "description": "Ridgid's 14-gallon NXT is the vac most garages and home shops should start with. It pairs a 6.0 peak horsepower motor with a 2-1/2-inch hose, the diameter that matters most for picking up wood chips, leaves, gravel and drywall scraps without clogging. Fourteen gallons is large enough that you are not emptying it every ten minutes but still fits under a workbench. The drain port on the tank makes wet jobs much easier, since you can empty water into a floor drain without lifting a heavy, sloshing drum. Ridgid sells a wide range of filters for it, including fine dust and HEPA-rated cartridges and dust bags, and the attachments are easy to find at home centers. Ridgid backs its wet/dry vacs with a limited lifetime warranty. The NXT is not the quietest machine, and the on-board storage is basic, but for general garage and workshop cleanup it is the most sensible all-rounder.",
