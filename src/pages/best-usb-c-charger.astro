---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Charging Stations",
    "url": "/best-charging-station/"
  },
  {
    "title": "Best Laptop Power Banks",
    "url": "/best-laptop-power-bank/"
  },
  {
    "title": "Best Portable Chargers for Power Outages",
    "url": "/best-portable-chargers-for-power-outages/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "8 Best USB-C Chargers in 2026: GaN Blocks From 20W to 140W";
const description =
  "Eight USB-C charging blocks compared, from 20W phone bricks to 140W laptop chargers, with PD, PPS, GaN, port sharing, cable ratings and safety marks explained.";

const PRODUCTS = [
  {
    "id": "anker-prime-100w",
    "name": "Anker Prime 100W GaN USB-C Charger 3-Port",
    "category": "100W total, 2 USB-C + 1 USB-A, GaN, wall plug",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "Up to 100 watts from a single USB-C port, per Anker",
      "Charges a laptop, phone and earbuds from one wall plug",
      "GaN design makes it far smaller than a typical 100W laptop brick",
      "Covers most 14-inch laptops at full speed and 16-inch models at a useful rate",
      "Anker's Prime line is its top tier of chargers"
    ],
    "cons": [
      "Premium price band for a wall charger",
      "100W is shared when more than one port is in use",
      "Not enough for a 16-inch MacBook Pro's full 140W fast-charge rate"
    ],
    "bottomLine": "The best single charging block for most people: enough for a laptop on its own, and small enough to replace both the laptop brick and the phone brick in a bag.",
    "description": "Anker's Prime 100W charger is the one block we would hand to someone who wants a single charger for a laptop, a phone and something small. Anker rates it at up to 100 watts from one USB-C port, which is the ceiling of standard USB Power Delivery and enough for almost every 13- and 14-inch laptop at full speed. It has two USB-C ports and one USB-A, so a phone and a pair of earbuds can charge alongside the laptop, with the 100 watts divided between them when they do. GaN components let Anker fit that output into a block much smaller than the charger that came with most 100-watt laptops. It sits in a premium price band, and a 16-inch MacBook Pro will charge more slowly than on its own 140-watt adapter. For everyone else, this is the charger that lets you leave every other brick at home. Anker's Prime line has had a few revisions, so confirm the port layout on the listing."
  },
  {
    "id": "anker-735-nano-ii",
    "name": "Anker 735 Charger Nano II 65W GaN USB-C Charger",
    "category": "65W total, 2 USB-C + 1 USB-A, GaN II, compact wall plug",
    "badge": "Best 65W Charger",
    "amazonUrl": "",
    "pros": [
      "65 watts from a single USB-C port, per Anker, enough for most thin laptops",
      "Three ports in a block only a little larger than a phone charger",
      "Long-running model with a large base of owner reports",
      "Usually priced in the mid band, below Anker's Prime chargers"
    ],
    "cons": [
      "65W is shared across all three ports",
      "Will not fast-charge a 14-inch performance laptop at its full rating",
      "USB-A port is slow"
    ],
    "bottomLine": "The 65W charger to buy for a MacBook Air, thin ultrabook, tablet and phone: compact, proven and fairly priced.",
    "description": "The Anker 735, sold as the Nano II 65W, has been one of the most commonly recommended 65-watt chargers for years, and it still earns a place. Anker rates it at 65 watts from a single USB-C port, which is what a MacBook Air, most 13-inch Windows ultrabooks, Chromebooks and the Steam Deck ship with or want. Two USB-C ports and one USB-A port let it charge a phone and earbuds at the same time, splitting the 65 watts when they do. It uses Anker's second generation GaN design, which keeps it small enough to pass for an oversized phone charger in a bag. It will not charge a 14-inch performance laptop as quickly as that laptop's own 96- to 100-watt brick, and it has been on the market long enough that newer models from Anker and UGREEN match it. As a proven, compact 65W charger, though, it is still an easy recommendation."
  },
  {
    "id": "ugreen-nexode-65w",
    "name": "UGREEN Nexode 65W USB-C GaN Charger 3-Port",
    "category": "65W total, 2 USB-C + 1 USB-A, GaN, wall plug",
    "badge": "Best Value 65W",
    "amazonUrl": "",
    "pros": [
      "Up to 65 watts from a single USB-C port, per UGREEN",
      "Three ports for a laptop, phone and accessory",
      "Often priced below comparable Anker models",
      "UGREEN is one of the established GaN charger brands",
      "Compact for a laptop charger"
    ],
    "cons": [
      "Output drops on each port when several devices share it",
      "No display or app, so per-port output is guesswork",
      "Check PPS support on the listing if you have a Samsung phone"
    ],
    "bottomLine": "A strong, usually cheaper alternative to the Anker 735 for anyone charging a thin laptop and a phone from one block.",
    "description": "UGREEN's Nexode 65W 3-port charger covers the same ground as the Anker 735 and is often a little cheaper. UGREEN rates it at up to 65 watts from a single USB-C port, enough for a MacBook Air, most thin Windows laptops, an iPad Pro and any phone, with two USB-C ports and one USB-A for charging several devices at once. As with every multi-port charger, the 65 watts is shared, so a laptop on one port and a phone on another each get part of it. UGREEN has become one of the more trusted names in GaN charging, and owners commonly report it runs warm but not hot under a laptop load. There is little to choose between this and the Anker 735 on paper; buy whichever is cheaper on the day, and favor the UGREEN if you want a slightly newer design. Samsung owners chasing Super Fast Charging should confirm PPS support on the specific listing."
  },
  {
    "id": "ugreen-nexode-100w",
    "name": "UGREEN Nexode 100W USB-C GaN Charger 4-Port",
    "category": "100W total, 3 USB-C + 1 USB-A, GaN, wall plug",
    "badge": "Most Ports",
    "amazonUrl": "",
    "pros": [
      "Up to 100 watts from a single USB-C port, per UGREEN",
      "Four ports: three USB-C and one USB-A",
      "Replaces a laptop brick and two or three phone chargers",
      "Usually costs less than Anker's Prime 100W",
      "Good travel charger for a couple sharing one outlet"
    ],
    "cons": [
      "Larger and heavier than three-port 65W chargers",
      "100W total gets thin with a laptop and three other devices",
      "Bulky in outlets with tight spacing"
    ],
    "bottomLine": "The pick when you need four ports and a full 100W for a laptop, and value matters more than having the smallest block.",
    "description": "UGREEN's Nexode 100W 4-port charger is the value alternative to Anker's Prime 100W, and it adds a fourth port. UGREEN rates a single USB-C port at up to 100 watts, the top of standard USB Power Delivery, and the charger has three USB-C ports and one USB-A. That makes it a good travel charger for two people sharing a hotel outlet, or a desk charger for a laptop plus a phone, tablet and earbuds. The 100 watts is shared, so a laptop drops well below its full rate once three other devices join, but overnight that rarely matters. It is larger than the three-port 65-watt chargers on this list and can crowd the neighboring socket in a tight duplex outlet. In exchange, it usually costs less than Anker's flagship. If you would rather have the ports on the desk than on the wall, UGREEN sells a desktop version with a cord; our charging station guide covers it."
  },
  {
    "id": "belkin-boostcharge-pro-65w",
    "name": "Belkin BoostCharge Pro Dual USB-C GaN Wall Charger 65W",
    "category": "65W total, 2 USB-C, GaN, wall plug",
    "badge": "Best Two-USB-C",
    "amazonUrl": "",
    "pros": [
      "65 watts total across two USB-C ports, per Belkin",
      "Two USB-C ports with no slow USB-A port to drag output down",
      "Belkin is a long-standing accessory brand sold in Apple stores and big-box retailers",
      "Good laptop-plus-phone charger for an all-USB-C household"
    ],
    "cons": [
      "Often priced above Anker and UGREEN equivalents",
      "Only two ports",
      "Each port gets less when both are in use"
    ],
    "bottomLine": "A clean two-port 65W charger from a brand you can buy in almost any store, worth it if you want USB-C only and the price is close.",
    "description": "Belkin's BoostCharge Pro Dual USB-C GaN Wall Charger is a 65-watt, two-port block with no USB-A port at all, which suits a household that has moved entirely to USB-C. Belkin rates it at 65 watts, enough for a MacBook Air or thin Windows laptop on its own, and when a phone joins on the second port the output is split between them. Its main advantages are availability and brand. Belkin sells through Apple stores and most big-box retailers, so this is often the best 65-watt charger you can actually buy in person on the day you leave your laptop brick in a hotel. It is usually more expensive than Anker and UGREEN chargers with similar or better specs, and two ports is the minimum we would want in a laptop-class charger. If the price is close to the Anker 735, buy whichever you prefer; if it is much higher, the Anker or UGREEN is better value."
  },
  {
    "id": "anker-nano-20w",
    "name": "Anker Nano 20W USB-C Charger",
    "category": "20W, single USB-C, compact phone charger",
    "badge": "Best Phone Brick",
    "amazonUrl": "",
    "pros": [
      "20 watts over USB-C PD, enough to fast-charge iPhones, per Anker",
      "Very small, about the size of the old 5W cube",
      "Budget price band",
      "Good spare for nightstands, cars with outlets and travel bags"
    ],
    "cons": [
      "Single port",
      "Too little for laptops",
      "Will not reach the top charging speeds of some Android phones"
    ],
    "bottomLine": "The cheap, tiny phone brick to buy in multiples for every room and bag.",
    "description": "The Anker Nano 20W is the charger most people should buy when all they need is a phone brick. Anker rates it at 20 watts over USB-C Power Delivery, which is the figure Apple itself uses for fast-charging iPhones, and it is barely larger than the old five-watt cube that used to come in the iPhone box. It has one USB-C port and no tricks. That simplicity is the point: it is inexpensive enough to buy several, one for each nightstand, the office and a travel bag, and it is from a brand with a long record in charging. It is too small for a laptop, and phones that charge at 25 or 45 watts, such as recent Samsung Galaxy S models, will charge more slowly than on a PPS charger rated for their top speed. Anker has released several Nano revisions, including higher-watt versions, so confirm you are buying the 20-watt model you want."
  },
  {
    "id": "apple-20w-usb-c",
    "name": "Apple 20W USB-C Power Adapter",
    "category": "20W, single USB-C, iPhone and iPad charger",
    "badge": "Best Apple Original",
    "amazonUrl": "",
    "pros": [
      "Apple's own charger, designed for iPhone and iPad fast charging",
      "Sold everywhere, from Apple stores to pharmacies",
      "Simple and reliable",
      "Pairs with MagSafe chargers for iPhone wireless charging"
    ],
    "cons": [
      "Larger than the Anker Nano 20W",
      "Usually costs more than equivalent third-party chargers",
      "Counterfeits are common; buy from a trusted seller"
    ],
    "bottomLine": "Buy it if you want Apple's own adapter and can find it from a trustworthy seller; otherwise the Anker Nano does the same job for less.",
    "description": "Apple's 20W USB-C Power Adapter is the charger Apple sells for iPhone and iPad fast charging, and it does exactly that. It has one USB-C port and delivers 20 watts over USB Power Delivery, which Apple says can bring a compatible iPhone to around half charge in about 30 minutes with a USB-C cable. It is larger than Anker's Nano 20W and usually costs a little more, so on paper there is no reason to prefer it. In practice some people simply want Apple's adapter, and it is available almost anywhere. The caveat is counterfeits. Fake Apple chargers are common in marketplace listings and at discount sellers, and a counterfeit charger can lack basic safety protections. Buy it from Apple, a major retailer, or a listing sold and shipped by a trusted seller. Apple's newest MagSafe charger can go faster on recent iPhones with a higher-watt adapter, so check Apple's guidance if wireless speed matters."
  },
  {
    "id": "apple-140w-usb-c",
    "name": "Apple 140W USB-C Power Adapter",
    "category": "140W, single USB-C, USB PD 3.1 extended power range",
    "badge": "Best for 16-inch Laptops",
    "amazonUrl": "",
    "pros": [
      "140 watts over a single USB-C port using USB PD 3.1",
      "Enables the fastest charging rate on 16-inch MacBook Pro models, per Apple",
      "Works as a standard USB-C PD charger for other laptops, tablets and phones",
      "Apple's own adapter, so no compatibility questions with a MacBook Pro"
    ],
    "cons": [
      "Single port",
      "Large and heavy compared to GaN multi-port chargers",
      "Premium price band; needs a 240W-rated cable to deliver more than 100W"
    ],
    "bottomLine": "The right buy if you own a 16-inch MacBook Pro and want a spare charger that matches the one in the box; overkill for anything smaller.",
    "description": "Apple's 140W USB-C Power Adapter ships with the 16-inch MacBook Pro, and it is on this list because it is one of the clearest examples of USB Power Delivery 3.1, the extended power range that allows more than 100 watts over USB-C. It has a single USB-C port that can deliver 140 watts, which Apple uses to enable the fastest charging rate on its 16-inch laptops. Over a USB-C to MagSafe 3 cable or a USB-C cable rated for 240 watts, the laptop gets the full output; over an ordinary 100-watt cable, it drops to 100 watts. It also works as a standard USB-C charger for other laptops, tablets and phones, which just draw less. The drawbacks are size, weight, a premium price and a single port. If you own a 16-inch MacBook Pro and want a second charger for the office, this is the simplest choice. If you do not, a 100-watt multi-port GaN charger is more useful."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best USB-C Chargers",
          item: "https://www.allmetalbrake.com/best-usb-c-charger/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best USB-C charger for most people?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For one block that charges a laptop and a phone, the Anker Prime 100W is the strongest all-rounder, with the UGREEN Nexode 100W as a cheaper four-port alternative. If you only have a thin laptop, a 65-watt charger such as the Anker 735 or UGREEN Nexode 65W is enough. For phones alone, a 20-watt brick like the Anker Nano is all you need."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 65W charger safe for my phone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. USB-C Power Delivery chargers only supply what the device asks for, so a phone on a 65-watt charger negotiates its own rate, usually 20 to 45 watts, and the charger provides no more. The same applies to earbuds and watches. A higher-watt charger is never forced into a device; the device is always in control of what it draws."
          }
        },
        {
          "@type": "Question",
          "name": "What does GaN mean on a charger?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GaN stands for gallium nitride, a semiconductor material that wastes less energy as heat than silicon. It lets manufacturers build smaller, lighter chargers for the same wattage. It does not make devices charge faster; charging speed comes from wattage and protocol support. For any charger of 65 watts or more, GaN is now a baseline expectation rather than a premium feature."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a special cable for a 100W charger?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To get more than 60 watts, yes. Basic USB-C cables are limited to 3 amps, or 60 watts at 20 volts. For 100 watts you need a 5-amp e-marked cable, and anything above 100 watts, such as 140-watt MacBook Pro charging, requires a cable rated for 240 watts. Check the rating printed on the packaging or connector."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best charging block for an iPhone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 20-watt USB-C charger is the sweet spot for wired iPhone charging. Apple says its 20W adapter can bring a compatible iPhone to about half charge in around 30 minutes. The Anker Nano 20W does the same job in a smaller body for less. A bigger charger will not hurt the phone, and is worth it if you also charge an iPad or MacBook."
          }
        },
        {
          "@type": "Question",
          "name": "Can a USB-C charger power a laptop that came with a barrel plug?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not. Laptops with round barrel chargers do not accept USB-C power unless they also have a USB-C port that supports charging, which the manufacturer will list. Many gaming laptops have both, but USB-C charging often tops out at 100 watts and may only slow the drain under heavy use. Check the laptop's spec sheet before buying a charger for it."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy Anker, UGREEN, Belkin or Apple?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All four make good chargers when you buy the genuine article. Anker and UGREEN tend to offer the most ports and wattage for the money, Belkin is easy to find in stores, and Apple's adapters are simple, reliable and more expensive. Choose by the wattage and port count you need, then buy whichever reputable model is cheapest from a trustworthy seller."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "best usb-c charger",
      "anker charging block",
      "best charging block",
      "usb c charging block",
      "gan charger",
      "65w charger"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The Best USB-C Chargers for Phones and Laptops
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          One small block can replace every charger in your bag, if you buy the right wattage. Here is how to match a charger to your laptop and phone, what PD, PPS and GaN really mean, and eight charging blocks worth buying.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">12 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#watts" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>How Many Watts</span></a>
              <a href="#pd-pps" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>PD and PPS</span></a>
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>The Eight Picks</span></a>
              <a href="#comparison" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Comparison Table</span></a>
              <a href="#gan" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>What GaN Buys You</span></a>
              <a href="#sharing" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Power Sharing</span></a>
              <a href="#cables" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Cable Ratings</span></a>
