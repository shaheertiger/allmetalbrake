---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "EcoFlow vs Bluetti",
    "url": "/ecoflow-vs-bluetti/"
  },
  {
    "title": "Best Solar Generators",
    "url": "/best-solar-generator/"
  },
  {
    "title": "Best Portable Power Station for Home Backup",
    "url": "/best-portable-power-station-for-home-backup/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "The Best EcoFlow Power Stations: Every Model Matched to Its Job";
const description =
  "Every current EcoFlow power station compared, from the River 3 to the Delta Pro Ultra, with the right model for camping, CPAP, outages and whole-home backup.";

const PRODUCTS = [
  {
    "id": "ecoflow-delta-3-plus",
    "name": "EcoFlow Delta 3 Plus Portable Power Station",
    "category": "1,024Wh LFP, 1,800W, Expandable to about 5kWh",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "1,800W inverter covers a fridge, microwave or sump pump start",
      "Takes add-on batteries, so you can grow it later",
      "Fast wall charging, quoted at under an hour to full",
      "Fast UPS-style switchover for routers and computers",
      "Light enough at about 28 pounds to take camping"
    ],
    "cons": [
      "120V only, so no 240V well pumps or dryers",
      "Some useful settings are buried in the app",
      "Heavier than Jackery's 1kWh Explorer"
    ],
    "bottomLine": "The EcoFlow most people should buy: big enough for outages, small enough to carry, and expandable when 1kWh stops being enough.",
    "description": "The Delta 3 Plus is the center of EcoFlow's lineup and the one to start with unless you already know you need something smaller or much bigger. EcoFlow rates it at 1,024Wh of LFP (lithium iron phosphate) storage behind an 1,800W inverter, which is enough to start a refrigerator, run a microwave for a few minutes or keep a router, laptop and lights going through a long evening. EcoFlow quotes under an hour from empty to full on a wall outlet and a fast switchover when grid power drops, so it can sit between the outlet and your modem as a basic battery backup. The reason it beats the cheaper fixed-size boxes is the expansion port: add one of EcoFlow's extra batteries and the same unit grows toward 5kWh by EcoFlow's figures. At around 28 pounds it still goes in a car trunk, which makes it the rare model that is equally sensible for a weekend campsite and a two-day outage."
  },
  {
    "id": "ecoflow-river-3-plus",
    "name": "EcoFlow River 3 Plus Portable Power Station",
    "category": "286Wh LFP, 600W, About 10 lb",
    "badge": "Best for Camping",
    "amazonUrl": "",
    "pros": [
      "About 10 pounds, easy to carry one-handed",
      "600W runs a small cooler, CPAP or projector",
      "Snap-on extra battery roughly triples capacity",
      "LFP chemistry built for thousands of cycles",
      "Charges from the wall in about an hour"
    ],
    "cons": [
      "286Wh is one CPAP night or a day of devices, not an outage plan",
      "Will not run anything with a heating element"
    ],
    "bottomLine": "The best small EcoFlow: buy it for camping, car trips and CPAP nights, and add the extra battery if you need a second day.",
    "description": "The River 3 Plus is the EcoFlow to buy if the station will be carried more than it sits. EcoFlow rates it at 286Wh of LFP storage with a 600W inverter, in a box of about 10 pounds that fits on a car floor or under a tent vestibule. That is enough for a night of CPAP use without the heated humidifier, a day of phones, cameras and laptops, or a few hours of a 12V cooler. Six hundred watts covers small appliances like a projector, a blender on low or a soldering iron, but not a coffee maker, a hair dryer or an electric kettle. What sets it apart from rival 300Wh boxes is the expansion path: EcoFlow's snap-on extra battery for the River 3 series roughly triples capacity to about 858Wh, turning a day-trip box into a weekend box without buying a second station. One small folding panel keeps it topped up at camp."
  },
  {
    "id": "ecoflow-river-3",
    "name": "EcoFlow River 3 Portable Power Station",
    "category": "245Wh LFP, 300W, About 8 lb",
    "badge": "Best Budget",
    "amazonUrl": "",
    "pros": [
      "Lowest-cost way into the EcoFlow app and ecosystem",
      "About 8 pounds with LFP chemistry",
      "Quiet enough to sit on a nightstand",
      "Works as a basic battery backup for a router"
    ],
    "cons": [
      "300W rated output limits it to electronics and small fans",
      "Not expandable, unlike the River 3 Plus"
    ],
    "bottomLine": "A good router-and-phones backup in the under $300 class; spend the extra on the River 3 Plus if you want to run anything bigger than a laptop.",
    "description": "The River 3 is EcoFlow's entry ticket, usually sold in the under $300 class and often lower on sale. EcoFlow rates it at 245Wh of LFP storage and 300W of continuous output, in a case of roughly 8 pounds. That is a narrow brief, and it is worth being honest about it: this is a box for routers, phones, laptops, LED lamps, a small fan or a CPAP machine with the humidifier off. It will not start a refrigerator and it will not boil water. Within that brief it is very good. LFP cells handle years of regular cycling, the switchover is quick enough to keep a modem online when the power blinks, and it shares the same app as the bigger units. The reason it is not ranked higher is that the River 3 Plus doubles the output and adds an expansion port for a modest step up in price, which makes the Plus the better buy for most people."
  },
  {
    "id": "ecoflow-delta-2-max",
    "name": "EcoFlow Delta 2 Max Portable Power Station",
    "category": "2,048Wh LFP, 2,400W, Expandable to about 6kWh",
    "badge": "Best 2kWh Value",
    "amazonUrl": "",
    "pros": [
      "2kWh in one box covers a fridge for about a day",
      "2,400W handles a microwave and fridge together",
      "Dual solar inputs for a bigger panel array",
      "Expands with extra batteries to about 6kWh",
      "Older model, so it is frequently discounted"
    ],
    "cons": [
      "About 50 pounds, a two-hand lift",
      "120V only",
      "Previous generation; check the newer Delta 3 Max price before buying"
    ],
    "bottomLine": "The 2kWh EcoFlow to buy when it is on sale; if it is not, compare it against the newer Delta 3 Max first.",
    "description": "The Delta 2 Max is the one older-generation model on this list, and it earns its place on value. EcoFlow rates it at 2,048Wh of LFP storage with a 2,400W inverter, which is enough to run a full-size refrigerator for roughly a day or a fridge, CPAP, router and lights through a long night with room to spare. Two solar inputs let it accept a much larger panel array than the Delta 3 Plus can use well, and EcoFlow lists expansion to about 6kWh with its extra batteries. The trade-off is size: at roughly 50 pounds it is a box you set down in one place and leave there, not one you carry to a campsite. Because a newer 2kWh model, the Delta 3 Max, now sits above it in EcoFlow's range, the Delta 2 Max is regularly discounted. When it is, it is one of the cheapest ways to get 2kWh of LFP and real expansion in a single EcoFlow box."
  },
  {
    "id": "ecoflow-delta-pro-3",
    "name": "EcoFlow Delta Pro 3 Portable Power Station",
    "category": "4,096Wh LFP, 4,000W, 120/240V",
    "badge": "Best for Home Backup",
    "amazonUrl": "",
    "pros": [
      "4kWh of storage with native 120/240V output",
      "Runs a fridge, freezer, furnace blower and lights together",
      "Accepts a large rooftop or ground-mount solar array",
      "Expands into the tens of kilowatt-hours",
      "Integrates with EcoFlow's home panel and transfer options"
    ],
    "cons": [
      "Well over 100 pounds; wheels, not handles",
      "Needs an electrician to connect to the house properly",
      "Overkill for camping or a single fridge"
    ],
    "bottomLine": "The EcoFlow to buy for real home backup: 240V, serious solar input, and room to grow into a multi-day system.",
    "description": "The Delta Pro 3 is where EcoFlow stops making portable gadgets and starts making a home backup system. EcoFlow rates it at 4,096Wh of LFP storage, about 3,480Wh usable by its own figures, behind a 4,000W inverter that delivers both 120V and 240V. That 240V output is the point: it can feed a manual transfer switch or a generator inlet wired by an electrician, so the battery powers selected household circuits instead of extension cords. On the runtime math in this guide, it carries a typical refrigerator for about two days on its own, or the essential circuits of an efficient house through an overnight outage. Its solar inputs accept a far larger array than any carry-size unit, and add-on batteries take storage into the tens of kilowatt-hours. It is on wheels for a reason, weighing well over 100 pounds, and it is a poor choice for anyone who mainly wants to go camping."
  },
  {
    "id": "ecoflow-delta-pro-ultra",
    "name": "EcoFlow Delta Pro Ultra Home Backup Power Station",
    "category": "6kWh per battery, 7,200W, 120/240V, Stackable",
    "badge": "Best Whole-Home System",
    "amazonUrl": "",
    "pros": [
      "7,200W inverter can start central-air and well-pump loads",
      "Each stackable battery adds 6kWh",
      "Designed around EcoFlow's Smart Home Panel 2",
      "Very large solar input for a permanent array",
      "Scales by adding batteries and inverters"
    ],
    "cons": [
      "Not portable in any practical sense",
      "Professional installation is effectively required",
      "Priced like a home battery, not a power station"
    ],
    "bottomLine": "A home battery system sold through power-station channels; worth it only if you are wiring it into the house permanently.",
    "description": "The Delta Pro Ultra is technically sold alongside EcoFlow's power stations, but it behaves like a home battery. It is a modular system: an inverter unit that EcoFlow rates at 7,200W with 120/240V output, sitting on top of one or more 6kWh LFP battery modules. Stack more batteries for more storage, or link inverters for more output, and the system scales well past anything else EcoFlow sells. Paired with the Smart Home Panel 2, it can switch over the house automatically when the grid drops and manage which circuits stay on. Its solar input is sized for a permanent array rather than folding panels. None of that comes cheap, and none of it is portable: each module is a heavy lift, and the whole system is meant to live in a garage or utility room on a dedicated install. If you are pricing this, also price a permanent wall-mounted home battery and a standby generator before you decide."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best EcoFlow Power Stations",
          item: "https://www.allmetalbrake.com/best-ecoflow-power-station/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which EcoFlow power station is best for most people?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Delta 3 Plus. EcoFlow rates it at 1,024Wh and 1,800W, which starts a refrigerator and runs a microwave, and it accepts extra batteries if 1kWh proves too small. At about 28 pounds it is still portable enough for camping. Smaller households focused on electronics can save money with the River 3 Plus instead."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between EcoFlow River and Delta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "River models are small, light power stations for electronics, CPAP machines and camping, with a few hundred watts of output and under 300Wh of built-in storage. Delta models start around 1kWh with 1,800W or more of output, enough for kitchen appliances and refrigerators, and most accept add-on batteries. Delta Pro models add 240V for home backup."
          }
        },
        {
          "@type": "Question",
          "name": "Is an EcoFlow solar generator different from the power station?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. An EcoFlow solar generator is one of its power stations sold in a bundle with folding or rigid panels and cables. The station is identical to the one sold alone. Judge a bundle by whether the panel wattage is large enough to refill the battery in a day, roughly one watt of panel per three watt-hours of storage."
          }
        },
        {
          "@type": "Question",
          "name": "Can an EcoFlow power station run my whole house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not on a single portable unit. A Delta Pro 3 with 4kWh and 240V output can run selected essential circuits through a transfer switch, and a Delta Pro Ultra with several battery modules and the Smart Home Panel 2 approaches whole-home backup. Central air, electric ranges and electric water heaters will still drain any of them quickly."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy the Delta 3 Plus or the Delta Pro 3?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buy the Delta 3 Plus if you mainly need a fridge, internet and lights on extension cords, or want one unit for outages and camping. Buy the Delta Pro 3 if you need 240V, want to power house circuits through a transfer switch, or plan a large solar array. The Pro costs several times as much and weighs over 100 pounds."
          }
        },
        {
          "@type": "Question",
          "name": "Do EcoFlow power stations work without the app?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Every model works out of the box with its physical buttons and default settings, so you can plug in and go. The app adds real-time monitoring, charge limits, charging-speed control and remote output switching, and some settings are only reachable through it. Most owners install it once to set things up and then rarely open it."
          }
        },
        {
          "@type": "Question",
          "name": "How long do EcoFlow batteries last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Current EcoFlow models use LFP cells, which EcoFlow rates for thousands of charge cycles before capacity falls significantly. For a station used occasionally for outages and camping, that means the battery is likely to outlast its electronics. Store it at partial charge in a cool place and top it up every few months between uses to keep it healthy."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "best ecoflow power station",
      "ecoflow power station",
      "ecoflow portable power station",
      "ecoflow delta 3 plus",
      "ecoflow delta pro 3",
      "ecoflow river 3 plus",
      "ecoflow solar generator"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">EcoFlow Power Stations</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          EcoFlow sells a power station for every job from a phone charger to a whole-house battery. Here is which one fits yours, and which ones to skip.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#ecoflow-delta-3-plus"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Which One to Buy
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#lineup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Lineup at a Glance</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The Six Picks</a>
          <a href="#which-one" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Which One to Buy</a>
          <a href="#river-vs-delta" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. River vs Delta</a>
          <a href="#expansion" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Expansion Batteries</a>
          <a href="#home-backup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Smart Home Panel and 240V</a>
          <a href="#solar" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Solar Input and Bundles</a>
          <a href="#app-charging" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. App, UPS and Charging</a>
          <a href="#where-ecoflow-loses" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Where EcoFlow Loses</a>
          <a href="#runtime" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Runtime by Model</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          For most people the right EcoFlow is the Delta 3 Plus. The rest of the lineup is for people who need something much lighter or much bigger, and the trick is knowing which side of that line you are on.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="lineup" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The EcoFlow Lineup at a Glance
          </h2>

          <p>
            EcoFlow sells more power stations than any shopper needs to compare, and the names do not help. River, Delta, Delta Max, Delta Pro, Delta Pro Ultra and Trail all mean something specific, and the difference between a River 3 and a Delta Pro 3 is the difference between a lunchbox and a small appliance on wheels. The good news is that once you know what each line is for, the choice usually narrows to one or two models in a minute or two.
          </p>

          <p>
            The <strong>River</strong> line is the portable end: small LFP batteries, a few hundred watts of output, light enough to carry one-handed. The <strong>Delta</strong> line is the middle, running from about 1kWh to 2kWh with inverters big enough to start a refrigerator, and most Delta models take add-on batteries. The <strong>Delta Pro</strong> models are home backup machines with 240V output, wheels and huge solar inputs. The <strong>Delta Pro Ultra</strong> is a modular home battery. And the <strong>Trail</strong> units are DC-only power banks with no AC outlets, useful for USB and 12V gear on a hike or a car trip but not what most people mean when they search for an EcoFlow power station.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Model</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Battery</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">AC Output</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Expandable</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best For</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">River 3</td>
                    <td class="px-4 py-4 text-gray-700">245Wh LFP</td>
                    <td class="px-4 py-4 text-gray-700">300W</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                    <td class="px-4 py-4 text-gray-700">Router, phones, laptops</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">River 3 Plus</td>
                    <td class="px-4 py-4 text-gray-700">286Wh LFP</td>
                    <td class="px-4 py-4 text-gray-700">600W</td>
                    <td class="px-4 py-4 text-gray-700">Yes, to about 858Wh</td>
                    <td class="px-4 py-4 text-gray-700">Camping, car, CPAP nights</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Delta 3 Plus</td>
                    <td class="px-4 py-4 text-gray-700">1,024Wh LFP</td>
                    <td class="px-4 py-4 text-gray-700">1,800W</td>
                    <td class="px-4 py-4 text-gray-700">Yes, to about 5kWh</td>
                    <td class="px-4 py-4 text-gray-700">Most homes, mixed use</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Delta 2 Max</td>
                    <td class="px-4 py-4 text-gray-700">2,048Wh LFP</td>
                    <td class="px-4 py-4 text-gray-700">2,400W</td>
                    <td class="px-4 py-4 text-gray-700">Yes, to about 6kWh</td>
                    <td class="px-4 py-4 text-gray-700">2kWh in one box, on sale</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Delta Pro 3</td>
