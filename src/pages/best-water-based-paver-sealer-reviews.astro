---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Paver Sealer",
    "url": "/best-paver-sealer/"
  },
  {
    "title": "How to Stain a Concrete Patio to Look Like Stone",
    "url": "/how-to-stain-concrete-patio-to-look-like-stone/"
  },
  {
    "title": "Best Polymeric Sand for Pavers",
    "url": "/best-polymeric-sand-for-pavers/"
  },
  {
    "title": "Polymeric Sand vs Regular Sand",
    "url": "/polymeric-sand-vs-regular-sand-for-pavers/"
  },
  {
    "title": "Best Penetrating Concrete Sealer",
    "url": "/best-penetrating-concrete-sealer/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "Water-Based Paver Sealers Worth Buying: 6 Low-Odor Picks";
const description =
  "Six water-based paver sealers sorted by finish, plus the temperature, humidity and recoat rules that decide whether a low-VOC coat cures clear or turns milky.";

const PRODUCTS = [
  {
    "id": "foundation-armor-wb25",
