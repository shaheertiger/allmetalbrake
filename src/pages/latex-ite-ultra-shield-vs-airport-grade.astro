---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/latex-ite-ultra-shield-vs-airport-grade.html?raw';

const title = "Latexite Ultrashield vs Airport Grade: Which to Buy?";
const description = "Ultra Shield carries a 10-year warranty and its 2019 sheet allows 40°F; Airport Grade needs 55°F. Same 300–500 sq ft per pail and 24–48 hour cure. When to pay more.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
