---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Cordless Leaf Blowers",
    "url": "/best-cordless-leaf-blower/"
  },
  {
    "title": "Best Self-Propelled Lawn Mowers",
    "url": "/best-self-propelled-lawn-mower/"
  },
  {
    "title": "Best Lawn Mowers for Small Yards",
    "url": "/best-lawn-mower-for-small-yard/"
  },
  {
    "title": "How to Remove Moss From an Asphalt Driveway",
    "url": "/how-to-remove-moss-from-asphalt-driveway/"
  },
  {
    "title": "Top String Trimmers",
    "url": "/best-weed-eater/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 7 Weed Killer Picks: Matched to the Weed and the Spot";
const description =
  "Seven weed killers sorted by job: lawn-safe selectives, driveway residuals, glyphosate concentrates and vinegar, plus label rules for pets and runoff.";

const PRODUCTS = [
  {
    "badge": "Best Overall Non-Selective",
    "category": "Concentrate, Non-Selective",
    "name": "Roundup Weed & Grass Killer Super Concentrate",
    "description": "Roundup's Super Concentrate is the bottle most people mean when they say weed killer: a non-selective concentrate you mix in a pump sprayer to clear everything green from a fence line, a bed being reclaimed or a patch of weeds along a foundation. The label gives separate mix rates for routine weeds and tough perennials, and one bottle treats a large area, so the cost per sprayed square foot is low. Be aware that Bayer announced it would replace glyphosate in its US residential lawn and garden products starting in 2023, so the active ingredients on the shelf depend on which version you pick up. Check the ingredient panel and follow that label's rates, not a rate you remember from an older jug. Systemic formulas need several days to a couple of weeks to show full results, and they need actively growing leaves to work at all. Never spray it over a lawn you want to keep.",
    "pros": [
      "Concentrate makes many gallons of spray from one bottle",
      "Kills roots of most grasses and broadleaf weeds it is labeled for",
      "Widely sold, with clear mixing tables on the label",
      "Rainfast window is short once the spray dries"
    ],
    "cons": [
      "Kills any green plant it lands on, including lawn grass",
      "Formulations have changed, so the active ingredient varies by bottle",
      "Slow to show results compared with contact sprays"
    ],
    "bottomLine": "The default pick for clearing a fence line, bed edge or overgrown patch down to the roots, provided you read which formula is in your bottle.",
    "amazonUrl": "",
    "id": "roundup-super-concentrate"
  },
  {
    "badge": "Best for Lawns",
    "category": "Selective Lawn Herbicide",
    "name": "Tenacity Turf Herbicide",
    "description": "Tenacity uses mesotrione, a selective herbicide that most cool-season lawn grasses tolerate while many broadleaf weeds, crabgrass and nimblewill do not. Its standout feature is that the label allows use at seeding on many cool-season grasses, so you can kill weeds and grow new turf in the same season instead of waiting weeks between the two. The product is sold in a small, pricey bottle, but the label rate is measured in teaspoons per thousand square feet, so a single bottle stretches a long way. For post-emergent spraying the label calls for a nonionic surfactant to help it stick and penetrate. Expect treated weeds to bleach white within a week or two, which is normal and part of how the chemistry works. Read the turf list carefully: bermudagrass and some bentgrass are injured, and warm-season lawns vary. It is not a fast fix, and it usually takes a follow-up application to finish stubborn weeds.",
    "pros": [
      "Kills many broadleaf weeds and some grassy weeds without killing labeled turf",
      "Can be used at seeding on many cool-season lawns, which most herbicides cannot",
      "Small bottle treats a large lawn",
      "Also works as a pre-emergent on some weeds"
    ],
    "cons": [
      "Injures bermudagrass and some other turf types, so check the species list",
      "Needs a nonionic surfactant added for post-emergent spraying",
      "Treated weeds turn bright white before they die, which alarms some owners"
    ],
    "bottomLine": "The best choice for cleaning weeds out of a cool-season lawn, especially one you are also overseeding.",
    "amazonUrl": "",
    "id": "tenacity-turf-herbicide"
  },
  {
    "badge": "Best for Gravel and Driveways",
    "category": "Residual, Soil-Active",
    "name": "Ortho GroundClear Year Long Vegetation Killer",
    "description": "GroundClear Year Long is a total vegetation killer: it knocks down what is growing now and leaves an active ingredient in the top of the soil that keeps new seeds from establishing for up to a year, according to Ortho. That makes it efficient on gravel parking pads, along chain-link fence bases and in the joints of a back-lot path where you never want anything to grow. The same staying power is the risk. Residual herbicides do not stay exactly where they land; rain can carry them downhill, and tree roots routinely extend well past the drip line and under a driveway. Spraying it over the root zone of a maple or along a hedge can injure or kill plants you never sprayed. Read the label's site restrictions, keep it off slopes that drain into lawns or gardens, and never apply it near wells, ponds or streams. For simple driveway cracks, a non-residual product is the safer first choice.",
    "pros": [
      "Kills existing growth and keeps new weeds from sprouting for months",
      "Ready-to-use jug needs no mixing",
      "Fits gravel drives, fence rows and paver joints where nothing should grow",
      "Saves repeat spraying through the season"
    ],
    "cons": [
      "Residual chemistry can kill tree and shrub roots that reach under the treated area",
      "Not for any spot where you might plant later",
      "Can wash with runoff onto lawns and beds below a slope"
    ],
    "bottomLine": "Use it only where you want bare ground for a long time and no tree roots run underneath.",
    "amazonUrl": "",
    "id": "ortho-groundclear-year-long"
  },
  {
    "badge": "Best Fast-Acting",
    "category": "Fast-Acting Non-Selective",
    "name": "Spectracide Weed & Grass Killer Concentrate",
    "description": "Spectracide's concentrate is built around speed. Its contact-type chemistry burns down green tissue fast, and owners commonly report wilting on young annual weeds the same day. That suits cleanup jobs: weeds in patio joints before a party, a curb line before sealcoating, or a strip along the house before painting. The trade-off is that contact action does not travel far into roots, so perennial weeds such as dandelion, bindweed and quackgrass often return from the crown within weeks. Spectracide sells several weed and grass killers with nearly identical names and different active ingredients, so check the back panel to see whether you have a pure contact formula or one combined with a systemic ingredient. Mix strictly to the label rate, spray only the target, and keep it off desirable plants and lawn edges. For a weed problem that keeps coming back, pair it with a systemic product rather than spraying it every two weeks.",
    "pros": [
      "Visible wilting within hours on many annual weeds",
      "Concentrate is inexpensive per gallon mixed",
      "Good for cleanup before an event or a sealing job",
      "Easy to find at most hardware stores"
    ],
    "cons": [
      "Fast top-kill often leaves perennial roots alive to regrow",
      "Several similarly named versions exist with different actives",
      "Non-selective, so overspray browns lawn grass"
    ],
    "bottomLine": "Choose it when you want weeds visibly dead quickly, not when you need perennials gone for good.",
    "amazonUrl": "",
    "id": "spectracide-weed-grass-killer"
  },
  {
    "badge": "Best Budget Concentrate",
    "category": "Glyphosate 41%, Concentrate",
    "name": "Compare-N-Save Concentrate Grass & Weed Killer",
    "description": "This is plain 41% glyphosate in a large jug, the same active ingredient concentration farm stores have sold for years, at a fraction of the cost of name-brand consumer bottles. Rural owners use it on fence lines, around outbuildings, along ditches that are not water channels, and for clearing ground before a garden or a new lawn. Because glyphosate has no meaningful soil activity at label rates, an area can usually be replanted after the waiting period printed on the label, which is a major advantage over residual vegetation killers. The label gives different mix rates for annual weeds, perennials and woody brush, and it requires eye protection and gloves when handling the concentrate. The large container is the drawback for a small yard; diluted spray loses effectiveness after a day or so, so mix only what you will use. Apply to actively growing weeds on a calm, dry day for the best root kill.",
    "pros": [
      "41% glyphosate concentrate at a low price per gallon of mixed spray",
      "Large jug suits acreage, fence rows and long property lines",
      "Kills the roots of labeled perennials when applied correctly",
      "Straightforward glyphosate formula with no added residual"
    ],
    "cons": [
      "No added surfactant beyond what is in the formula, so results vary on waxy weeds",
      "Big jug is more than a small yard will use before it ages",
      "Label signal word and PPE requirements call for real care when mixing"
    ],
    "bottomLine": "The cheapest way to buy straight glyphosate in volume if you have the space and the patience to mix it correctly.",
    "amazonUrl": "",
    "id": "compare-n-save-concentrate"
  },
  {
    "badge": "Best Pre-Emergent",
    "category": "Granular Pre-Emergent",
    "name": "Preen Garden Weed Preventer",
    "description": "Preen is a granular pre-emergent based on trifluralin, which works by stopping germinating seeds from developing roots. It does not kill weeds you can already see, so the order of operations matters: pull or kill current weeds, apply Preen at the label rate, then water it in so it activates in the top layer of soil. Used that way around established perennials, shrubs and many transplanted vegetables, it sharply reduces the flush of seedlings that turns a fresh bed into a chore by midsummer. The label specifies reapplication at intervals through the growing season, and it lists which plants it can be used around, so check it before you scatter granules near seeded rows. The big limitation is that it cannot tell weed seeds from flower seeds; anything you sow directly in a treated area will struggle. Keep granules off driveways and walks, sweep stray ones back into the bed, and store the container away from pets.",
    "pros": [
      "Stops many weed seeds from establishing in beds",
      "Shaker bottle makes it easy to spread around established plants",
      "Labeled for use around a long list of flowers, shrubs and vegetables",
      "Cuts down on hand weeding through the season"
    ],
    "cons": [
      "Does nothing to weeds that are already growing",
      "Will stop desirable seeds you sow too",
      "Needs repeat applications through the season per the label"
    ],
    "bottomLine": "A smart prevention step for mulched beds, but only after the existing weeds are already pulled.",
    "amazonUrl": "",
    "id": "preen-garden-weed-preventer"
  },
  {
    "badge": "Best Non-Synthetic Option",
    "category": "Acetic Acid Contact Spray",
    "name": "Green Gobbler 20% Horticultural Vinegar",
    "description": "Sold at 20% acetic acid, this horticultural vinegar is four times the strength of kitchen vinegar, and it is far more dangerous to handle than its natural image suggests. At this concentration the label warns of serious eye damage and skin irritation, so wear goggles and chemical-resistant gloves and keep children and pets away while you spray. Applied undiluted on a sunny, warm day, it desiccates the leaves of young annual weeds within hours, which is useful in sidewalk cracks, gravel edges and paver joints where you want a quick visual result without a synthetic herbicide. The limits are real. It acts only on the tissue it touches, so established perennials usually resprout from their roots, and repeat applications add up in cost. It is also non-selective, so drift browns grass and garden plants. Spray on calm days, keep it off metal and stone you care about, and rinse the sprayer afterward because the acid corrodes fittings.",
    "pros": [
      "Burns down young annual weeds quickly in sun and warm weather",
      "No synthetic herbicide active ingredient",
      "Breaks down fast in soil with no lasting residue",
      "Works well on cracks and edges"
    ],
    "cons": [
      "20% acetic acid can cause serious eye injury and skin burns",
      "Rarely kills perennial roots, so weeds regrow",
      "Needs repeat spraying and costs more per square foot than synthetics"
    ],
    "bottomLine": "A reasonable choice for small cracks and young weeds, as long as you treat it as the hazardous acid it is.",
    "amazonUrl": "",
    "id": "green-gobbler-20-vinegar"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Weed Killer Picks",
          item: "https://www.allmetalbrake.com/best-weed-killer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which herbicide should I use on weeds in my grass?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For cool-season lawns, a selective product such as Tenacity or a three-way broadleaf herbicide labeled for your grass is the right tool, because it kills weeds while sparing turf. Check the label's grass list first, since some products injure bermudagrass, St. Augustine or centipede. Never use a non-selective glyphosate product on a lawn you want to keep, because it kills grass as readily as weeds."
          }
        },
        {
          "@type": "Question",
          "name": "How soon will I see sprayed weeds die?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Contact sprays and horticultural vinegar show wilting within hours on young weeds in warm sun. Systemic products such as glyphosate take longer, usually showing yellowing in several days and a full kill in one to two weeks, faster in warm weather and slower in cool. Selective lawn products often need two to three weeks and sometimes a second application to finish established perennial weeds."
          }
        },
        {
          "@type": "Question",
          "name": "Is glyphosate safe to use around my home?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The EPA's position is that glyphosate is not likely to cause cancer when used according to the label, while the World Health Organization's cancer research agency classified it as probably carcinogenic in 2015, and EPA's human health review is being redone after a 2022 court ruling. Practically, follow the label, wear gloves and eye protection, avoid drift, and keep people and pets off sprayed areas until dry."
          }
        },
        {
          "@type": "Question",
          "name": "How long should pets stay off a treated lawn?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Follow the label on your specific product. For most liquid herbicides it says to keep people and pets out of the treated area until the spray has dried, which often takes a few hours on a warm, dry day. Granular products frequently need to be watered in first. When in doubt, wait longer, keep pets on a lead away from treated edges, and store containers securely."
          }
        },
        {
          "@type": "Question",
          "name": "Will rain wash away weed killer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can if the rain arrives before the product is rainfast. Labels list a rainfast period, often ranging from under an hour to several hours after the spray dries on leaves. Rain before then dilutes the dose on the plant and can carry product off pavement into storm drains. Check the forecast and spray on a dry morning with no rain expected for the rest of the day."
          }
        },
        {
          "@type": "Question",
          "name": "What kills weeds permanently?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No product keeps ground weed-free forever. Systemic herbicides kill existing perennials to the roots, and soil-residual vegetation killers prevent new growth for months, but new seeds blow in and germinate eventually. The most durable results come from combining a root kill with prevention: mulch in beds, landscape fabric under gravel, dense healthy turf in lawns, and a pre-emergent where it is labeled."
          }
        },
        {
          "@type": "Question",
          "name": "Does vinegar work as a weed killer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Horticultural vinegar at 20% acetic acid burns down the leaves of young annual weeds quickly, especially in sunny, warm conditions. It does not move into roots, so established perennials such as dandelions usually grow back. Treat it with care: at that strength the label warns of serious eye damage, so goggles and gloves are required. Household 5% vinegar is much weaker and works only on tiny seedlings."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Yard & Outdoor Tools",
    tags: [
      "best weed killer",
      "glyphosate weed killer",
      "selective herbicide for lawns",
      "pre-emergent weed control",
      "driveway weed killer",
      "pet safe weed control"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The 7 Best Weed Killers for Lawns, Beds and Driveways
        </h1>
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          The right herbicide depends on what you are killing and what has to survive next to it. Here is how to match the product to the problem, and how to use it without hurting pets, trees or the creek down the street.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">11 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>Top Picks</span></a>
              <a href="#choose-by-job" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>Choose by Job</span></a>
              <a href="#read-the-label" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Reading the Label</span></a>
              <a href="#glyphosate" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Glyphosate Facts</span></a>
              <a href="#pets-and-kids" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>Pets and Kids</span></a>
              <a href="#runoff-and-drift" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Runoff and Drift</span></a>
              <a href="#timing" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Timing</span></a>
              <a href="#mixing" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>Mixing and Spraying</span></a>
              <a href="#skip-the-spray" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>When Not to Spray</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Homeowners who end up unhappy with a herbicide usually made one error: they bought the strongest-sounding jug instead of the right chemistry. A product that wipes out a gravel path will also wipe out the lawn beside it, and a lawn-safe selective will barely slow down the grass growing through your patio cracks. Pick by job first, then by price, and read the label before the cap comes off.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Weed Killer Picks, Ranked by Job
          </h2>

          <p>
            Picks are based on each product's EPA-registered label: active ingredient and concentration, the weeds and sites it is labeled for, rainfast and re-entry directions, and coverage per container. We also weighed patterns in owner feedback and price per treated square foot at the time of writing. Nothing here is ranked on claims the label does not support.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} index={index} />
          ))}
        </div>

        <div id="choose-by-job" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Choose the Product by the Job, Not the Brand
          </h2>

          <p>
            Every weed killer on a store shelf can be sorted with three questions. Does it kill everything or only certain plants? Does it move through the plant to the roots or only burn what it touches? And does it work on weeds already growing or on seeds that have not sprouted yet? The answers are printed on the label in plain language, and they decide whether the product suits your problem far more than the brand name or the size of the bottle.
          </p>

          <p>
            <strong>Selective</strong> herbicides are built to spare certain plants, usually lawn grass, while killing broadleaf weeds or specific grassy weeds. <strong>Non-selective</strong> products kill nearly any green plant they wet. Spraying a non-selective product on a lawn to get rid of dandelions is the classic, costly homeowner error, because the brown patches take a full season to repair. When weeds grow mixed into turf worth saving, reach for a selective product labeled for your grass type.
          </p>

          <p>
            <strong>Systemic</strong> products are absorbed by leaves and carried down to the roots, so they kill perennials completely but take days to weeks. <strong>Contact</strong> products burn the leaves they touch within hours but often leave perennial roots alive. <strong>Pre-emergents</strong> form a barrier in the soil that stops seeds from establishing and do nothing to existing weeds. <strong>Residual</strong> vegetation killers combine a kill with months of soil activity, and they are the products that most often damage trees and lawns by accident.
          </p>

