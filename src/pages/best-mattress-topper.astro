  {
    "id": "linenspa-3in-gel-memory-foam-topper",
    "name": "Linenspa 3 Inch Gel Infused Memory Foam Mattress Topper",
    "category": "Gel memory foam, 2 or 3 in, medium",
    "badge": "Best Budget",
    "amazonUrl": "#",
    "specs": [
      [
        "Material",
