];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Mattress Topper",
          item: "https://www.allmetalbrake.com/best-mattress-topper/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best mattress topper?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, the ViscoSoft 3 Inch Select High Density. ViscoSoft lists its gel memory foam at 3.1 lb/ft³, describes the feel as medium-firm, and adds corner straps and a washable cover. Side sleepers should consider the Tempur-Adapt + Cooling, and anyone with back pain should try a firm latex topper."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best mattress topper for back pain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A medium or firm natural latex topper about 3 inches thick, such as the Pure Green, is the best mattress topper for back pain on a supportive bed. Latex pushes back against the hips and helps keep the spine level. If pain persists for weeks, see a doctor or physical therapist."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best mattress topper for side sleepers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A soft 3-inch memory foam topper, such as the Tempur-Pedic TEMPUR-Adapt + Cooling, is the best mattress topper for side sleepers on a firm mattress. It lets the shoulder and hip sink in while the waist stays supported. Soft latex is the cooler alternative if memory foam feels too warm."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 2 or 3 inch mattress topper better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 3-inch topper suits most people because it changes the feel of the bed noticeably without letting the hips sink too far. Choose 2 inches if you sleep on your back or stomach, or if your mattress is only slightly too firm. Go to 4 inches only as a side sleeper on a hard mattress."
          }
        },
        {
          "@type": "Question",
          "name": "Can a mattress topper fix a sagging mattress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A topper follows the shape of the mattress under it, so it will sink into a dip just as you do. It can soften a firm bed or slightly firm a soft one, but it cannot restore worn-out support. If your mattress has a visible dip, check its warranty and plan on replacing it."
          }
        },
        {
          "@type": "Question",
          "name": "Is latex or memory foam better for a mattress topper?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on what you want. Memory foam contours closely and relieves pressure, which side sleepers like, but it sleeps warmer and feels slow to move on. Latex is springier, cooler and usually more durable, and firm latex can add support. Latex also costs more. For back pain, it usually has the edge."
          }
        },
        {
          "@type": "Question",
          "name": "How do I keep my mattress topper from sliding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buy a topper with corner straps or a grippy base, like the ViscoSoft, if sliding would bother you. For a strapless topper, use a deep-pocket fitted sheet that covers the mattress and topper together, a zippered topper cover, or a non-slip rug pad underneath, and check that the mattress itself is not sliding."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Sleep & Mattresses",
    tags: [
      "best mattress topper",
      "best mattress toppers",
      "best mattress topper for back pain",
      "best mattress topper for side sleepers",
      "memory foam mattress topper",
      "latex mattress topper"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The 7 Best Mattress Toppers
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          A 3-inch topper of medium-firm memory foam or natural latex is the best mattress topper for most people, because it cushions shoulders and hips without letting the spine sink out of line. Here are seven worth buying, and the one problem no topper can fix.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
