                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pump size</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Approx. running watts</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Approx. starting watts</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Approx. 240V running amps</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">1/2 HP</td>
                    <td class="px-4 py-4 text-gray-700">1,000-1,200W</td>
