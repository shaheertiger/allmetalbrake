                    <td class="px-4 py-4 font-black text-gray-900">Acrylic latex</td>
                    <td class="px-4 py-4 text-gray-700">15 to 30 min</td>
                    <td class="px-4 py-4 text-gray-700">Several hours</td>
                    <td class="px-4 py-4 text-gray-700">1 to 4 hours</td>
                    <td class="px-4 py-4 text-gray-700">About 3 to 7 days</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Elastomeric latex</td>
                    <td class="px-4 py-4 text-gray-700">15 to 60 min</td>
                    <td class="px-4 py-4 text-gray-700">A few hours</td>
                    <td class="px-4 py-4 text-gray-700">1 to 24 hours</td>
                    <td class="px-4 py-4 text-gray-700">About 5 to 10 days</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">100% silicone</td>
                    <td class="px-4 py-4 text-gray-700">10 to 30 min</td>
                    <td class="px-4 py-4 text-gray-700">30 min to 3 hours</td>
                    <td class="px-4 py-4 text-gray-700">Not paintable</td>
                    <td class="px-4 py-4 text-gray-700">About 24 hours per thin bead</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Polyurethane</td>
                    <td class="px-4 py-4 text-gray-700">1 to 3 hours</td>
                    <td class="px-4 py-4 text-gray-700">Several hours</td>
                    <td class="px-4 py-4 text-gray-700">After firming, per label</td>
                    <td class="px-4 py-4 text-gray-700">3 to 7+ days</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Hybrid polymer</td>
                    <td class="px-4 py-4 text-gray-700">10 to 60 min</td>
                    <td class="px-4 py-4 text-gray-700">Often quick</td>
                    <td class="px-4 py-4 text-gray-700">Often same day</td>
                    <td class="px-4 py-4 text-gray-700">1 to 3 days per thin bead</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Butyl rubber</td>
                    <td class="px-4 py-4 text-gray-700">Hours</td>
                    <td class="px-4 py-4 text-gray-700">Varies</td>
                    <td class="px-4 py-4 text-gray-700">Rarely painted</td>
