                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Skin over</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Light water or rain</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Paint</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Full cure</th>
                  </tr>
                </thead>
                <tbody>
