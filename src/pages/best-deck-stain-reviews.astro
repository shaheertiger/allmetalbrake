                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Typical floor life</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best use</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Clear / toner</td>
                    <td class="px-4 py-4 text-gray-700">All of it</td>
