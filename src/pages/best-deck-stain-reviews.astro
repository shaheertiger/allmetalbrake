---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Deck Stain for Cedar",
    "url": "/best-deck-stain-for-cedar/"
  },
  {
    "title": "Best Oil-Based Deck Stain",
    "url": "/best-oil-based-deck-stain/"
  },
  {
    "title": "Best Deck Sealant",
    "url": "/best-deck-sealant/"
  },
  {
    "title": "Best Deck Paint",
    "url": "/best-deck-paint/"
  },
  {
    "title": "Can You Stain Pressure-Treated Wood?",
    "url": "/can-you-stain-pressure-treated-wood/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "7 Best Deck Stains in 2026: Picked by Wood, Climate and Upkeep";
const description =
  "Seven deck stains ranked by what your deck needs: wood species, sun exposure, old finish and how often you want to recoat, plus prep, coverage and cost.";

const PRODUCTS = [
  {
    "id": "armstrong-clark",
    "name": "Armstrong Clark Wood Stain (Semi-Transparent)",
    "category": "Oil-based penetrating stain",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "Penetrating oil blend that soaks in rather than building a film",
      "Fades by wearing away, so recoats need no stripping",
      "Available in semi-transparent and semi-solid",
      "Suits pressure-treated pine, cedar and redwood",
      "Strong owner loyalty among people who recoat every two to three years"
    ],
    "cons": [
      "Harder to find in big-box stores than mainstream brands",
      "Price per gallon sits above the store-brand tier",
      "Oil cleanup needs mineral spirits"
    ],
    "bottomLine": "The safest all-round choice for a softwood deck if you want a stain that ages gracefully and recoats without a fight.",
    "description": "Armstrong Clark is an oil-based penetrating stain that blends drying oils, which harden in the wood, with non-drying oils that stay supple and keep feeding the fibers. The result is a finish that sinks into the surface instead of sitting on top of it, which is exactly what a horizontal deck surface needs. When it wears, it thins and lightens rather than flaking, so the next maintenance coat is a wash, a light brighten and another thin application. The semi-transparent line shows grain while adding enough pigment to slow graying, and the semi-solid version gives older, blotchy boards more coverage without the peeling risk of a true solid stain. Owners commonly report getting two to three seasons on horizontal surfaces before a refresh, with railings and vertical boards lasting longer. It is not the cheapest gallon on the shelf and you may have to order it online, but it removes most of the ways a deck stain job goes wrong."
  },
  {
    "id": "ready-seal",
    "name": "Ready Seal Exterior Stain and Sealer (Natural Cedar)",
    "category": "Oil-based penetrating stain",
    "badge": "Easiest to Apply",
    "amazonUrl": "",
    "pros": [
      "Label says no back-brushing or primer needed",
      "Formulated to avoid lap marks even when you stop mid-board",
      "Sprays well with a pump or airless sprayer",
      "Color deepens to its final shade over roughly two weeks",
      "Can be recoated without stripping"
    ],
    "cons": [
      "Looks orange for the first days until it settles",
      "Lighter pigment load wears faster on south-facing decks",
      "Oil solvent smell during application"
    ],
    "bottomLine": "The pick for first-time stainers who are nervous about lap marks and streaks.",
    "description": "Ready Seal built its reputation on forgiveness. It is an oil-based stain and sealer that the manufacturer says goes on without back-brushing, without primer and without the lap marks that plague faster-drying products, so you can spray or roll a section, stop for lunch and pick up again without a visible line. That makes it the obvious choice for a first deck project or a large area you plan to spray. Natural Cedar is the best seller: it reads as a warm mid-tone on pine and pressure-treated lumber and settles into its true color over about two weeks as the solvent leaves the wood. The trade-off is durability on high-exposure surfaces. Owners in hot, sunny climates often report that the floor needs a refresh after one to two years, though the good news is that a refresh is simply a cleaning and another coat. It is a dependable, low-stress product, not a long-life one."
  },
  {
    "id": "twp-100-series",
    "name": "TWP 100 Series Deck & Wood Preservative",
    "category": "Oil-based semi-transparent preservative",
    "badge": "Best for Damp, Shaded Decks",
    "amazonUrl": "",
    "pros": [
      "Registered wood preservative with mildew and fungal protection",
      "Penetrating formula suited to rough and smooth lumber",
      "Long track record with deck restoration contractors",
      "Classic colors such as Cedartone and Redwood"
    ],
    "cons": [
      "Higher-VOC formula is not sold in every state",
      "Strong solvent odor",
      "Needs two wet-on-wet coats on thirsty wood"
    ],
    "bottomLine": "The right answer for decks under trees, near water or anywhere mildew comes back every spring.",
    "description": "TWP stands for Total Wood Preservative, and that is the point of the 100 Series: it carries mildewcides and fungicides and is registered as a wood preservative, not just sold as a cosmetic coating. If your deck sits under trees, faces north or stays damp into the afternoon, the green and black growth that shows up on other finishes is the problem you actually need to solve, and this is built for it. It is a penetrating oil product that soaks into rough-sawn and smooth boards alike, and contractors who restore decks for a living have used it for decades. The catch is regulatory. The 100 Series exceeds the VOC limits in some states, so buyers in those areas get the 1500 Series instead, which is the compliant version with a similar approach. Apply it thin, in two coats on very dry wood, and plan on a light maintenance coat every couple of years."
  },
  {
    "id": "defy-extreme",
    "name": "DEFY Extreme Semi-Transparent Wood Stain",
    "category": "Water-based semi-transparent stain",
    "badge": "Best Water-Based",
    "amazonUrl": "",
    "pros": [
      "Zinc oxide nano-particles for UV resistance",
      "Low odor and water cleanup",
      "Low-VOC formula legal in every state",
      "Dries fast enough to finish a deck in one day"
    ],
    "cons": [
      "Fast drying makes lap marks easier in hot weather",
      "Needs very careful prep to bond well",
      "Weathers more noticeably on high-traffic walkways"
    ],
    "bottomLine": "The best water-based pick for people who want low odor and quick turnaround without settling for a weak finish.",
    "description": "DEFY Extreme from Saver Systems is the water-based stain that oil loyalists tend to respect. Its selling point is UV protection from zinc oxide nano-particles, the same mineral used in sunscreen, which helps the pigment hold its color longer than many latex stains. It dries quickly, cleans up with water and carries a low-VOC formula that is legal everywhere, so it suits buyers in strict air-quality states or anyone staining close to the house with windows open. It behaves more like a penetrating finish than a paint, and it is designed to be recoated without stripping. Two cautions apply. The fast dry time means you must work in shade and keep a wet edge, or you will see overlap lines. And because water-based finishes are less forgiving of dirty or mill-glazed wood, the cleaning and brightening steps are not optional. Do those well and owners commonly report two years or more on a floor."
  },
  {
    "id": "cabot-aus-deck",
    "name": "Cabot Australian Timber Oil",
    "category": "Oil-based translucent penetrating oil",
    "badge": "Best for Hardwoods",
    "amazonUrl": "",
    "pros": [
      "Linseed and tung oil blend made for dense woods",
      "Translucent finish that keeps grain front and center",
      "Well suited to ipe, mahogany, teak and other exotics",
      "Widely available at paint and home stores"
    ],
    "cons": [
      "Translucent pigment means more frequent recoats in full sun",
      "Long dry time in cool or humid weather",
      "Overapplication leaves a sticky surface"
    ],
    "bottomLine": "The go-to for hardwood and exotic decks where the wood itself is the feature.",
    "description": "Cabot Australian Timber Oil is designed for the dense tropical hardwoods that resist most stains. It uses a blend of oils that includes linseed and tung, which penetrate tight-grained species such as ipe, cumaru and mahogany better than heavier-bodied stains that just sit on top and turn tacky. The translucent finish adds a warm tint while letting the grain dominate, and colors such as Honey Teak, Natural and Mahogany Flame are popular because they enrich rather than mask. It also works on cedar and redwood when you want a richer look than a clear sealer gives. Because translucent stains carry less pigment, they give up more ground to UV, so expect a refresh every year or two on a deck in full sun. Apply one thin coat, wipe any puddles within the window on the label, and resist the temptation to add a heavy second coat on dense wood, which is the most common cause of a tacky finish."
  },
  {
    "id": "olympic-maximum",
    "name": "Olympic Maximum Stain + Sealant in One (Solid)",
    "category": "Water-based solid color stain",
    "badge": "Best for Weathered Decks",
    "amazonUrl": "",
    "pros": [
      "Hides gray, mismatched and patched boards",
      "Wide range of solid colors tinted in store",
      "Strong UV blocking from heavy pigment load",
      "Easy to buy and easy to touch up"
    ],
    "cons": [
      "Film-forming finish can peel on horizontal surfaces",
      "Hides wood grain completely",
      "Very hard to go back to a lighter, transparent look later"
    ],
    "bottomLine": "Choose it for an old deck that no longer looks good bare, not for new wood you want to show off.",
    "description": "A solid stain is the honest answer for a tired deck. If your boards have been patched, have mismatched colors or carry a gray cast that cleaning will not lift, Olympic Maximum Solid covers all of it with a uniform color while still leaving some wood texture. It is tinted at the store in a broad range of shades and its heavy pigment gives the best UV blocking of anything on this list. The trade-off is the one that applies to every solid stain: it forms a film on the surface, and films on horizontal boards eventually crack and peel where water and foot traffic work at them. That is why it ranks here rather than higher. It does best on railings, fascia and vertical surfaces, and on floors that are fully dry and properly cleaned before it goes on. Commit to it knowing that you will be staying with solid colors, because stripping one back to bare wood is a weekend of hard labor."
  },
  {
    "id": "behr-premium-clear",
    "name": "Behr Premium Transparent Waterproofing Wood Finish",
    "category": "Water-based clear finish",
    "badge": "Best Budget",
    "amazonUrl": "",
    "pros": [
      "Low price per gallon",
      "Water-based, low odor, easy cleanup",
      "Shows off new wood with no added color",
      "Easy to find at Home Depot"
    ],
    "cons": [
      "Little to no UV protection without pigment",
      "Wood will still gray in the sun",
      "Needs reapplying roughly every year"
    ],
    "bottomLine": "Good for water repellency on a shaded deck or a budget refresh; not a long-term answer for sunny decks.",
    "description": "Behr Premium Transparent Waterproofing Wood Finish is the budget pick and it does one job well: it makes water bead and keeps moisture out of the boards, which limits cracking and checking. Because it is clear, it lets brand-new cedar or redwood show its natural color. What it cannot do is stop the sun. Ultraviolet light breaks down lignin in the wood surface whether or not water is beading on top, so a clear finish on a sunny deck will still turn silver-gray within a season or two. That makes this product a fit for covered porches, shaded decks and people who are happy to recoat every year, which is cheap and quick with a water-based product. If you want color retention, step up to a semi-transparent with real pigment. Behr does sell tinted versions in the same family, and those are a better buy for any deck that gets more than a few hours of direct sun."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Deck Stain Reviews",
          item: "https://www.allmetalbrake.com/best-deck-stain-reviews/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "When does a deck need restaining?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most decks need a maintenance coat on the floor every two to three years with a semi-transparent stain, every year with a clear or toner finish, and every three to five years with a solid stain. Sunny, south-facing decks and heavy foot traffic shorten that. When water stops beading and the high-traffic paths look faded, it is time to clean and recoat."
          }
        },
        {
          "@type": "Question",
          "name": "Should I choose an oil or a water-based deck stain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oil-based penetrating stains are more forgiving for most homeowners because they soak in deeply, rarely leave lap marks and fade rather than peel. Water-based stains dry faster, smell less, clean up with water and are legal in every state. A well-prepped deck can do well with either; the key is not mixing chemistries without stripping first."
          }
        },
        {
          "@type": "Question",
          "name": "Can fresh stain go over an older coat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if the old stain is a penetrating type that has worn evenly and is not peeling. Clean and brighten the deck, let it dry, and apply the same or a compatible product. If the old finish is a solid stain or film that is peeling, strip or sand the loose areas first. Switching from oil to water-based usually requires stripping."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best application method for deck stain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Spraying or rolling is fastest for the floor, but always back-brush right afterward to work the stain into the grain and even out puddles. A brush alone gives the best penetration on small decks. Pads work well on smooth boards. Whatever you use, work two or three boards at a time and finish each pass at a board end."
          }
        },
        {
          "@type": "Question",
          "name": "How long should I wait to stain a new deck?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the wood. Kiln-dried lumber can often be stained within weeks. Wet pressure-treated pine usually needs several weeks to a few months to dry, sometimes longer in humid climates. Use the water-drop test: if drops soak in within a few minutes, the wood is ready. If they bead, wait and test again."
          }
        },
        {
          "@type": "Question",
          "name": "Does deck stain protect against water?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Most deck stains contain water repellents in addition to pigment, so they reduce how much moisture the boards absorb. That limits swelling, cracking and checking. Pigment adds UV protection on top. Clear sealers repel water too but offer little sun protection, which is why decks finished with them still gray."
          }
        },
        {
          "@type": "Question",
          "name": "What deck stain color lasts the longest?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mid-tone semi-transparent and semi-solid colors such as cedar, redwood and light brown tend to hold up best. They carry enough pigment to block UV while hiding the gradual wear and dirt of foot traffic. Very light or clear finishes fade fastest, and very dark solid colors can show scuffs and heat up in direct sun."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Deck & Wood Finishes",
    tags: [
      "best deck stain reviews",
      "deck stain",
      "semi-transparent deck stain",
      "oil vs water deck stain",
      "deck stain for pressure treated wood",
      "deck refinishing"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The Best Deck Stains for Every Kind of Deck
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          A good stain on a badly prepped deck fails in a year. A middling stain on a well-prepped deck can go three. Here is how to get both halves right.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">12 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>Top 7 Picks</span></a>
              <a href="#opacity" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>Opacity Levels</span></a>
              <a href="#chemistry" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Oil vs Water</span></a>
              <a href="#match" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Match the Deck</span></a>
              <a href="#prep" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>Prep Work</span></a>
              <a href="#application" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Application</span></a>
              <a href="#coverage" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Coverage & Cost</span></a>
              <a href="#climate" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>Climate & Exposure</span></a>
              <a href="#maintenance" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>Maintenance</span></a>
              <a href="#alternatives" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Stain vs Paint vs Sealer</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">12.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most deck stain complaints are not really about the can. They come from putting a film-forming stain on wood that wanted a penetrating oil, staining boards that were still wet, or choosing a clear finish for a deck that sits in full sun. Pick the opacity and chemistry that fit your boards first, and the brand decision gets easy.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Best Deck Stains, Ranked
          </h2>

          <p>
            These picks are ranked on published manufacturer data (opacity, resin type, coverage, VOC compliance, recoat guidance), on what each product is designed to do, and on recurring patterns in owner feedback about peeling, fading and ease of maintenance. Nothing here is based on a lab test of our own, and no product paid for placement.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} index={index} />
          ))}
        </div>

        <div id="opacity" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Opacity Decides Most of the Outcome
          </h2>

          <p>
            Every deck stain sits somewhere on a scale from clear to solid, and the position is set by pigment. More pigment blocks more ultraviolet light, which is the main thing that breaks down the wood surface and turns boards gray. Less pigment shows more grain. That is the trade, and nearly every disappointment people have with deck stain traces back to choosing the wrong spot on that scale for the deck they have.
          </p>

          <p>
            <strong>Clear and toner finishes</strong> repel water but do little against the sun. They suit shaded decks and brand-new boards you want to keep looking natural, as long as you accept recoating every year. <strong>Translucent and semi-transparent stains</strong> are the sweet spot for most softwood decks: enough pigment to slow graying for two to three seasons, while the grain still shows. <strong>Semi-solid stains</strong> carry more pigment and tone down blotchy or patched boards. <strong>Solid stains</strong> hide the grain entirely and behave much more like a thin paint.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
