---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/paver-sand-vs-play-sand.html?raw';

const title = "Paver Sand vs. Play Sand — Why the Wrong Sand Sinks Your Patio | Home Fix Reviews";
const description = "Paver sand and play sand look identical in the bag and cost about the same, but only one belongs under pavers. What each sand actually is, why play sand fails, how much you need, and the right material for every layer of a paver installation.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
