---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import TopPick from "../components/TopPick.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Inverter Generators",
    "url": "/best-inverter-generator/"
  },
  {
    "title": "Best Generator Transfer Switches",
    "url": "/best-generator-transfer-switch/"
  },
  {
    "title": "Best Dual Fuel Generators",
    "url": "/best-dual-fuel-generator/"
  },
  {
    "title": "Best Small Generators for Home",
    "url": "/best-small-generator-for-home/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-19", modified: "2026-11-19" });
const title = "Best Time to Buy a Generator: Black Friday, Not Storm Week";
const description =
  "The best time to buy a generator is late fall through early spring, with Black Friday the sale worth checking; the worst is the 72 hours before a storm.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Time to Buy a Generator",
          item: "https://www.allmetalbrake.com/best-time-to-buy-a-generator/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Do generators go on sale for Black Friday?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Often, yes. Home centers, warehouse clubs and online retailers commonly include portable and inverter generators in their late-November outdoor-power promotions, and portable power station brands typically run their biggest sales of the year that week. Discounts vary by model and store, so check the 90-day price history before treating any banner as a real deal."
          }
        },
        {
          "@type": "Question",
          "name": "What month are generators cheapest?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There is no single guaranteed month, but late November through February is usually the best stretch. Black Friday and Cyber Monday bring the most promotions, and January and February bring the lowest demand and fullest stock. Prices are least likely to fall from June through October, when hurricane season and summer storms keep demand high."
          }
        },
        {
          "@type": "Question",
          "name": "Is it cheaper to buy a generator after hurricane season?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is often easier, and sometimes cheaper. Hurricane season ends on November 30, and in quiet years coastal stores may hold extra stock they ordered for storms that never arrived. In busy years the reverse happens and supply stays thin. Either way, buying after the season beats buying in the middle of it."
          }
        },
        {
          "@type": "Question",
          "name": "When is the best time to buy a portable power station?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Black Friday and Cyber Monday are usually the strongest week, with Prime Day in July a close second. Power station brands refresh their lines often, so outgoing models are commonly discounted when a new generation launches. An older model is a good buy if it uses LiFePO4 cells and has the output you need."
          }
        },
        {
          "@type": "Question",
          "name": "How far ahead should I plan a standby generator install?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plan on weeks to a few months from first quote to a working, inspected system. The process includes a site visit, a permit, gas and electrical work and an inspection, and installer queues grow sharply after a big outage. Starting in fall or winter puts you ahead of the spring and summer rush."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy a generator right before a storm?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if you have no other option, and then buy carefully. Stock is limited, prices are rarely discounted, and there is little time to set up or connect the unit safely. Check running watts against your must-run loads, never run it indoors or in a garage, and consider a power station for small loads."
          }
        },
        {
          "@type": "Question",
          "name": "Are open-box or refurbished generators a good deal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They can be, if they come from the manufacturer or an authorized retailer with a real warranty. Ask whether the unit has been run, check that the full model number matches the spec sheet, and inspect for missing parts like the wheel kit or cords. Avoid refurbished units from unknown marketplace sellers with no warranty support."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
  ],
};
---

<Layout
