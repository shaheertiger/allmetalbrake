                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Peel risk</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Hides stains and patches</th>
                  </tr>
                </thead>
                <tbody>
