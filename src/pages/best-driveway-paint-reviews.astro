---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Concrete Driveway Sealers",
    "url": "/best-concrete-driveway-sealer-reviews/"
  },
  {
    "title": "How Often Should You Seal Your Driveway",
    "url": "/how-often-should-you-seal-your-driveway/"
  },
  {
    "title": "Best Garage Floor Epoxy",
    "url": "/best-garage-floor-epoxy/"
  },
  {
    "title": "Best Porch Paint",
    "url": "/best-porch-paint/"
  },
  {
    "title": "How to Remove Oil Stains From a Driveway",
    "url": "/how-to-remove-oil-stains-from-driveway/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 6 Best Driveway Paints for Concrete and Asphalt";
const description =
  "Six driveway paints and color coatings for concrete and blacktop, ranked by job, plus the prep, hot-tire, slip and UV factors that decide whether paint lasts.";

const PRODUCTS = [
  {
    "id": "behr-premium-epoxy-acrylic",
    "name": "Behr Premium 1-Part Epoxy Concrete & Garage Floor Paint",
    "category": "1-part epoxy-acrylic paint for concrete",
    "badge": "Best Overall for Concrete",
    "amazonUrl": "",
    "pros": [
      "Single-component, no mixing or pot life",
      "Marketed for hot-tire pickup resistance",
      "Wide range of tintable colors",
      "Rated for interior and exterior concrete per the label",
      "Soap-and-water cleanup"
    ],
    "cons": [
      "Not as hard as a true two-part epoxy",
      "Needs proper etching or profiling to bond",
      "Full cure before vehicle traffic takes several days"
    ],
    "bottomLine": "The easiest way to get a durable, colored, tire-resistant finish on a sound concrete driveway without two-part epoxy hassles.",
    "description": "Behr's 1-Part Epoxy is an acrylic paint with epoxy ester modifiers, which gives it better adhesion and abrasion resistance than an ordinary porch paint while keeping the convenience of opening a can and rolling. It is marketed for garage floors and other concrete subject to vehicle traffic, with resistance to hot-tire pickup, the problem where warm tires lift paint off the surface. The label lists it for both interior and exterior concrete, which matters on a driveway exposed to sun and rain. It comes in a broad range of tintable colors, so you can match trim or choose a neutral gray that hides dirt. The catch is preparation. Like all floor coatings, it needs clean, profiled concrete to bond, which usually means degreasing and etching or grinding. It also needs several days of cure before cars should park on it, per the label. Owners commonly report good results on well-prepared slabs and peeling where prep was skipped, which is the pattern for almost every coating on this list."
  },
  {
    "id": "kilz-1-part-epoxy",
    "name": "KILZ 1-Part Epoxy Acrylic Concrete & Garage Floor Paint",
    "category": "1-part epoxy-acrylic paint for concrete",
    "badge": "Best Value",
    "amazonUrl": "",
    "pros": [
      "Typically priced below comparable 1-part epoxies",
      "Single-component, roll-on application",
      "Formulated for vehicle traffic areas",
      "Available in common neutral colors",
      "Water cleanup"
    ],
    "cons": [
      "Fewer color options than Behr",
      "Coverage drops on rough or porous concrete",
      "Same strict prep requirements as any floor paint"
    ],
    "bottomLine": "A cost-conscious alternative to Behr that does the same job on a well-prepared concrete driveway.",
    "description": "KILZ's 1-Part Epoxy Acrylic follows the same formula idea as the Behr pick: an acrylic paint with epoxy modifiers for improved toughness, sold as a single component so there is nothing to mix and no pot life to beat. It is designed for concrete floors, including areas that see vehicle traffic, and the label lists it for exterior use as well as garages. Where it stands out is price; it typically sells for less per gallon than comparable products, which adds up on a large two- or three-car driveway that needs two coats. The color selection is narrower, focusing on practical grays and tans, which is fine for most driveways where a neutral color hides tire marks and dirt. Rough, porous concrete soaks up more paint than smooth slabs, so expect coverage at the lower end of the label's range on an older broom-finished driveway. As with any floor paint, the bond depends on cleaning, degreasing and etching, so budget for those supplies alongside the paint."
  },
  {
    "id": "seal-krete-epoxy-seal",
    "name": "Seal-Krete Epoxy-Seal Concrete & Garage Floor Paint",
    "category": "Low-VOC epoxy-modified concrete paint",
    "badge": "Best Low-Odor Option",
    "amazonUrl": "",
    "pros": [
      "Low-VOC, water-based formula",
      "Single-component application",
      "Tintable to a range of colors",
      "Intended for interior and exterior concrete",
      "Lower odor makes garage-adjacent work easier"
    ],
    "cons": [
      "Can be harder to find in stores than Behr or KILZ",
      "Needs anti-slip additive for sloped drives",
      "Requires careful prep like any coating"
    ],
    "bottomLine": "A solid one-part concrete paint for owners who want a lower-odor, low-VOC option without giving up exterior durability.",
    "description": "Seal-Krete's Epoxy-Seal is another one-part, epoxy-modified concrete paint, distinguished mainly by its low-VOC, water-based formula. That means less odor during application, which is useful if your driveway runs right up to an attached garage or the house. It is intended for interior and exterior concrete and can be tinted to a range of colors. Like the other one-part products, it bonds best to clean, etched concrete and goes on with a roller in two thin coats. Seal-Krete also makes clear sealers and prep products, and some owners like using a single brand for cleaning, etching and coating so the instructions line up. Distribution is less universal than Behr or KILZ, so you may need to order it or visit a specific retailer. On a sloped driveway, adding an anti-slip aggregate to the final coat is a good idea, since a smooth painted surface can be slick when wet. For a well-prepared concrete slab, it delivers results comparable to the top picks with a gentler smell."
  },
  {
    "id": "rustoleum-epoxyshield-blacktop",
    "name": "Rust-Oleum EpoxyShield Blacktop Filler & Sealer",
    "category": "Asphalt coating with filler",
    "badge": "Best for Asphalt Driveways",
    "amazonUrl": "",
    "pros": [
      "Made specifically for asphalt driveways",
      "Fills fine cracks and surface voids as it seals",
      "Restores a uniform deep black",
      "Applied with a squeegee or broom",
      "Widely available at home centers"
    ],
    "cons": [
      "Black only; not a color option",
      "Wider cracks still need dedicated crack filler",
      "Weather window is strict like any water-based sealer"
    ],
    "bottomLine": "If your driveway is asphalt and you want it to look new, this kind of black filler-sealer is the right product, not paint.",
    "description": "Ordinary paint does not belong on asphalt. Its rigid film cannot flex with the pavement, and petroleum-based asphalt can bleed through and soften it. The right way to refresh blacktop is a coating designed for it, and Rust-Oleum's EpoxyShield Blacktop Filler & Sealer is a widely available option. It is a water-based asphalt coating with fillers that help close fine surface cracks and voids as it seals, leaving a uniform, deep black finish. Application is by squeegee or broom, the same as other driveway sealers, and it follows similar weather rules: warm, dry conditions above the label minimum and no rain for the specified period. It does not replace dedicated crack filler for anything wider than fine cracks, so plan to fill those first. Our guide to the best driveway crack fillers covers what to use. For owners who think they want to paint an asphalt driveway, this is almost always what they actually need."
  },
  {
    "id": "blackjack-drive-maxx-1000",
    "name": "Black Jack Drive-Maxx 1000 Driveway Sealer",
    "category": "Premium asphalt emulsion sealer",
    "badge": "Best Heavy-Duty Asphalt Coating",
    "amazonUrl": "",
    "pros": [
      "Premium-grade emulsion with additives for durability",
      "Deep black finish",
      "Suited to high-traffic driveways",
      "Squeegee application",
      "Long-standing driveway sealer brand"
    ],
    "cons": [
      "Costs more per pail than basic sealers",
      "Black only",
      "Requires the same strict weather and prep"
    ],
    "bottomLine": "A heavier-duty black coating for asphalt drives that see a lot of traffic, at a higher price than budget pails.",
    "description": "Black Jack's Drive-Maxx line sits at the premium end of home-center asphalt sealers, with the 1000 version aimed at heavier use. It is an asphalt emulsion with added polymers and fillers meant to resist wear in tire paths, turning areas and other spots that wear through cheaper sealers quickly. Like the Rust-Oleum pick, it restores asphalt to a uniform black rather than adding color, which is what most blacktop owners actually want when they talk about painting. Application is with a squeegee, ideally in two thin coats, on a clean, dry surface with cracks filled first. The price per pail is higher than basic sealers, but premium products often last longer between coats, which can make the cost per year comparable or better. The weather rules are the same as any water-based sealer: warm pavement, warm nights, and a dry forecast. For a full comparison of asphalt sealers by durability and coverage, our asphalt driveway sealer rankings go deeper."
  },
  {
    "id": "behr-porch-patio-low-luster",
    "name": "Behr Premium Porch & Patio Floor Paint, Low-Lustre",
    "category": "Acrylic floor enamel for foot traffic",
    "badge": "Best for Walks, Borders and Aprons",
    "amazonUrl": "",
    "pros": [
      "Huge range of tintable colors",
      "Low-luster finish hides minor imperfections",
      "Easy roll-on application",
      "Good for decorative borders and walkways",
      "Water cleanup"
    ],
    "cons": [
      "Not designed for heavy vehicle traffic in tire paths",
      "Can be slippery when wet without additive",
      "Shorter life than epoxy-modified paints on a driveway"
    ],
    "bottomLine": "Use it for the walkway, borders and decorative areas around the driveway, not for the tire paths themselves.",
    "description": "Behr's Porch & Patio Floor Paint is a tough acrylic enamel for concrete and wood floors that see foot traffic, and it has one of the widest color selections available. On a driveway, it has a specific role. It is a good choice for concrete walkways that lead from the drive, decorative borders and banding, and areas next to the drive that see feet rather than tires. It is not formulated for repeated vehicle traffic in the way the epoxy-modified paints above are, and in tire paths it tends to scuff, lift or show hot-tire marks sooner. Many owners use a combination: an epoxy-modified paint on the driving surface and this product in a coordinating color on walks and edges. The low-luster finish hides minor surface flaws better than gloss. Like any smooth floor paint, it can be slippery when wet, so adding an anti-slip additive is worth considering on steps and sloped walks. For more porch and patio options, see our best porch paint picks."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Driveway Paint",
          item: "https://www.allmetalbrake.com/best-driveway-paint-reviews/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Will paint hold up on a concrete driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, with a paint rated for exterior concrete and vehicle traffic, such as a one-part epoxy-acrylic paint. Success depends on prep: the concrete must be dry, clean, degreased and etched or ground. Check for moisture with a plastic sheet test first. If moisture is present, a penetrating stain or sealer is usually a better choice than paint."
          }
        },
        {
          "@type": "Question",
          "name": "Can you paint an asphalt driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not with regular paint. Asphalt flexes and contains oils that can crack or soften concrete and porch paints. To refresh an asphalt driveway, use a black asphalt sealer or filler-sealer. Colored asphalt coatings exist but are specialty acrylic products, mostly used on courts and commercial surfaces and often applied by contractors."
          }
        },
        {
          "@type": "Question",
          "name": "How long does driveway paint last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on prep, product, climate and traffic. A well-prepared one-part epoxy paint on concrete often lasts a few years before tire paths need touch-ups. Porch paint in tire areas wears faster. Poorly prepared surfaces can peel within a season. Asphalt sealers typically last two to three years before recoating."
          }
        },
        {
          "@type": "Question",
          "name": "What is hot-tire pickup?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hot-tire pickup happens when warm tires that have just been driven park on a painted or coated surface, soften it, and then lift it as they pull away. It is a common failure in garages and driveways. Products marketed for vehicle traffic are formulated to resist it, and allowing the full cure time before parking helps."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a primer for driveway paint?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many one-part epoxy floor paints are self-priming on properly etched bare concrete, but some manufacturers recommend a primer for very porous, previously painted or problem surfaces. Check the specific label. If repainting over old coatings, the old paint must be sound, cleaned and scuffed, and compatibility should be confirmed."
          }
        },
        {
          "@type": "Question",
          "name": "Is driveway paint slippery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Painted concrete is smoother than bare concrete and can be slippery when wet, especially on slopes. Choose a low-luster finish and add an anti-slip additive to the final coat, either mixed in or broadcast onto the wet paint. Pay extra attention near steps, entries and anywhere people walk regularly."
          }
        },
        {
          "@type": "Question",
          "name": "Is staining better than painting a driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For sound, evenly colored concrete without moisture problems, staining is often lower maintenance because penetrating stains do not peel. Paint gives more color control and hides stains and patches better but requires more prep and maintenance. If moisture rises through the slab, stain or sealer is the safer option."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Driveway & Asphalt",
    tags: [
      "best driveway paint reviews",
      "concrete driveway paint",
      "asphalt driveway coating",
      "1-part epoxy driveway paint",
      "hot tire pickup",
      "painting a driveway"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Driveway Paints</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Paint can refresh a tired driveway, but only products built for vehicle traffic, sun and water survive outdoors. These six are matched to the surface you actually have.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#behr-premium-epoxy-acrylic"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="6.4k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#paint-stain-sealer" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Paint, Stain or Sealer?</a>
          <a href="#surface" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Concrete vs. Asphalt</a>
          <a href="#what-matters" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. What to Look For</a>
          <a href="#prep" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Prepping Concrete</a>
          <a href="#applying" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Applying the Paint</a>
          <a href="#color" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Picking a Color</a>
          <a href="#asphalt" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Coloring Asphalt</a>
          <a href="#traction" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Slip Resistance</a>
          <a href="#cost-life" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Cost and Lifespan</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most painted driveways that fail do so for the same few reasons: the wrong product for outdoor vehicle traffic, skipped surface prep, or paint applied over concrete that was still pushing moisture up from below. Get those right and a driveway coating can look sharp for several years. Get them wrong and it peels in the tire paths by the first winter. This guide ranks six products for concrete and asphalt by the job each does best, then covers the decision most people skip, which is whether paint, stain or sealer is the right answer for their drive at all.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 6 Best Driveway Paints and Coatings, Ranked
          </h2>

          <p>
            We ranked these on what each manufacturer states about surfaces, exterior use, vehicle traffic and cure times, along with recurring themes in owner feedback. We did not lab-test them. Because concrete and asphalt need entirely different products, read the category line on each card before the rank.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-gray-500 text-sm font-bold">{product.rating}</span>
                    <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} ratings on Amazon)</span>
                  </div>
                  )}

                  <p class="text-gray-700 leading-relaxed mb-6">{product.description}</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 rounded-xl p-4">
                      <p class="text-xs font-black uppercase tracking-widest text-green-700 mb-3">Pros</p>
                      <ul class="space-y-2">
                        {product.pros.map((pro) => (
                          <li class="flex items-start gap-2 text-sm text-green-800">
