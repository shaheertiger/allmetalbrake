const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Deck Paint",
          item: "https://www.allmetalbrake.com/best-deck-paint/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is it better to paint or stain a deck?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Stain is usually better for decks in good condition because it soaks in or forms a thin, flexible layer that fades rather than peels. Paint or solid stain makes sense when the boards are weathered, mismatched or already coated with film. Paint gives a uniform color but commits you to film maintenance, and removing it later requires stripping and heavy sanding."
          }
        },
        {
          "@type": "Question",
          "name": "How many years will a painted deck hold up?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On an open, sunny deck, solid stain and porch paint typically last about three to five years before the traffic lanes need recoating, and longer on covered porches. Resurfacers can last several years when applied to dry, well-prepared wood but fail quickly when moisture gets behind them. Climate, sun exposure, foot traffic and preparation matter more than the brand."
          }
        },
        {
          "@type": "Question",
          "name": "Does a deck need primer before paint?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "That comes down to the product. Many solid stains and resurfacers are self-priming on bare wood, while porch and floor paints often require an exterior primer. Cedar and redwood bleed tannins, so a stain-blocking primer helps under light colors. When a manufacturer names a specific primer for its topcoat, use that one to keep the warranty and adhesion intact."
          }
        },
        {
          "@type": "Question",
          "name": "Can I paint over an old deck stain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can paint over an old stain only after it has worn away enough that water soaks in, or after you strip it. Paint applied over a penetrating stain that still repels water does not bond well and tends to peel. Clean the deck, sand lightly, let it dry and test a small area with tape before coating the whole surface."
          }
        },
        {
          "@type": "Question",
          "name": "Are deck resurfacers worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They can be on a structurally sound deck with rough, checked or splintered boards, where they hide damage and add traction. They are a poor choice on decks with soft wood, loose framing or chronic moisture. Resurfacers have a mixed track record, cost more per square foot because of low coverage and are very hard to remove, so weigh them against replacing worn boards."
          }
        },
        {
          "@type": "Question",
          "name": "What temperature do I need to paint a deck?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most acrylic deck coatings call for air and surface temperatures of at least 50 degrees, sometimes higher, and need to stay above that while they dry overnight. Avoid painting in direct midday sun and on evenings when dew will form before the paint sets. Check the specific label for its range and the rain-free period it needs afterward."
          }
        },
        {
          "@type": "Question",
          "name": "How do I make a painted deck less slippery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use a textured coating, or mix an anti-slip additive made for the paint into the final coat, especially on stairs, pool surrounds and shaded areas that stay damp. Stir the additive often because it settles. Keeping the deck clean also helps, since algae, mildew and wet leaves make any painted surface far more slippery."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
