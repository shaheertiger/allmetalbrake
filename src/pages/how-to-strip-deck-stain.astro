---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/how-to-strip-deck-stain.html?raw';

const title = "How to Strip Deck Stain: Step-by-Step DIY Guide";
const description = "When stripping is needed, caustic vs oxygen vs solvent strippers, dwell time, low-pressure rinsing, brightening with oxalic acid and drying before restaining.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
