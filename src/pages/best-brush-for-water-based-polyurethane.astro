---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/best-brush-for-water-based-polyurethane.html?raw';

const title = "Best Brush for Water-Based Polyurethane — 11 Applicators Tested | Home Fix Reviews";
