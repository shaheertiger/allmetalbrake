---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {"title": "Best Dual Fuel Generators", "url": "/best-dual-fuel-generator/"},
  {"title": "Best Inverter Generators", "url": "/best-inverter-generator/"},
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Small Generators for Home",
    "url": "/best-small-generator-for-home/"
  },
  {
    "title": "Best Gas Generators",
    "url": "/best-gas-generator/"
  },
  {
    "title": "Generac Generator Cost",
    "url": "/generac-generator-cost/"
  },
  {
    "title": "Best Whole House Surge Protectors",
    "url": "/best-whole-house-surge-protector/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "7 Best Home Generators for Power Outages (2026): Sized to Need";
const description =
  "The Generac Guardian 22kW leads 7 outage generators; essentials alone need about 3,500 to 5,000 running watts, and a sump or well pump pushes that higher.";

const PRODUCTS = [
  {
    "id": "generac-guardian-22kw",
    "name": "Generac Guardian 22kW",
    "category": "Air-Cooled Standby, Natural Gas or LP",
    "badge": "Top Pick: Automatic Whole-House",
    "amazonUrl": "",
    "pros": [
      "Starts and picks up the load by itself, usually within seconds of the grid failing",
      "22kW on propane and 19.5kW on natural gas covers most homes, central air included",
      "Runs for days on a natural gas line with no trips for fuel",
      "Exercises itself weekly and reports over Wi-Fi through Generac's app",
      "The largest dealer and service network of any standby brand"
    ],
    "cons": [
      "Installed cost commonly runs well into five figures",
      "Requires a permit, a concrete or composite pad and licensed trades",
      "Yearly service is essential if you want it to start when it counts"
    ],
    "bottomLine": "Where outages run long and often, nothing else on this list can stand in for an automatic standby unit.",
    "description": "For a household that wants the power back without anyone stepping outside, the Guardian 22kW is the standard answer. It is mounted permanently on a pad, piped to natural gas or a propane tank and wired through an automatic transfer switch, so it detects the outage, starts and carries the house without help. Generac rates it at 22,000 watts on propane and 19,500 on natural gas, enough for a typical 2,000 to 3,000 square foot home with a central air conditioner and gas heat, particularly with the load-shedding modules Generac sells. The air-cooled engine runs a weekly self-exercise and reports its status to the Mobile Link app. The drawbacks are cost and paperwork: the unit alone is roughly $5,500 to $6,500 at the time of writing, and permits, electrical work, gas piping and the pad commonly bring the installed total to $10,000 to $18,000 or more. Budget for yearly oil, filter and plug service from a dealer."
  },
  {
    "id": "champion-9200w-dual-fuel",
    "name": "Champion 9200W Dual Fuel",
    "category": "Open-Frame Portable, Gasoline + Propane",
    "badge": "Top Portable for Most Homes",
    "amazonUrl": "",
    "pros": [
      "Burns gasoline or a standard propane cylinder, a real edge when gas stations are dark",
      "Enough output to run a fridge, freezer, sump pump, furnace blower and lights together",
      "Electric start with a recoil backup",
      "Champion's CO Shield stops the engine if carbon monoxide builds up around it",
      "A 120/240V locking outlet suits a manual transfer switch or interlock inlet"
    ],
    "cons": [
      "Heavy enough that you will want the wheel kit and a helper",
      "Loud next to an inverter; the neighbors will hear it",
      "Produces less on propane than its gasoline rating"
    ],
    "bottomLine": "The best value for a family that wants most of the house running for several thousand dollars less than standby.",
    "description": "Most suburban homeowners should look at this portable first. The 9,200 figure is its peak starting rating on gasoline; running output is lower, and lower still on propane, so take the label's running-watt figure for each fuel when you build your load list. Even so, it sits in the class that can carry a refrigerator, a chest freezer, a sump pump, a gas furnace blower, Wi-Fi and a run of lights at once, with headroom for a window air conditioner if you stagger the start-ups. Dual fuel is worth more than the spec sheet implies: propane stores for years with no stabilizer, and after a hurricane or ice storm, a stack of filled cylinders is often easier to find than working gas pumps. Champion's CO Shield sensor shuts the engine down if carbon monoxide gathers around the unit. Expect roughly $1,000 to $1,400 at the time of writing, plus a transfer switch or interlock fitted by an electrician."
  },
  {
    "id": "westinghouse-igen4500",
    "name": "Westinghouse iGen4500",
    "category": "Inverter, 3,700W Running, Remote Start",
    "badge": "Quiet Mid-Size Choice",
    "amazonUrl": "",
    "pros": [
      "3,700 running and 4,500 peak watts in a quiet inverter body",
      "Clean inverter output suits electronics, furnace control boards and medical devices",
      "Electric start plus a remote key fob",
      "Long run time on its 3.4-gallon tank at light load",
      "Onboard display shows load, fuel level and remaining run time"
    ],
    "cons": [
      "120V only, so a 240V well pump is out",
      "Close to 100 pounds; you will use the wheels"
    ],
    "bottomLine": "The sweet spot for a home that has outgrown a 2,200W suitcase unit but does not want an open-frame engine droning all night.",
    "description": "The iGen4500 fills the gap many outage shoppers land in: more load than a small inverter can handle, but not the budget or patience for a 9,000-watt open frame. Westinghouse rates it at 3,700 running and 4,500 starting watts, which handles a refrigerator, a freezer, a gas furnace blower, a sump pump, lights and electronics as long as you are sensible about what runs at the same time. As an inverter, it makes power clean enough for sensitive electronics, and its engine throttles back at light load, which is where the long run time on a 3.4-gallon tank comes from. Owners commonly report it is clearly quieter than open-frame units of similar output, and remote start is a real comfort in a February storm. The limit is the 120V-only panel, which rules out a 240V well pump or an electric range. Expect roughly $1,000 to $1,300 at the time of writing."
  },
  {
    "id": "honda-eu2200i",
    "name": "Honda EU2200i",
    "category": "Inverter, 1,800W Running, 47 lb",
    "badge": "Quietest Essentials Backup",
    "amazonUrl": "",
    "pros": [
      "Honda GXR120 engine with a long reliability record",
      "About 47 pounds, so one adult can genuinely carry it",
      "Its 48 to 57 dBA rating is quiet enough for close neighbors",
      "Can run in parallel with a second unit for double the output",
      "CO-MINDER shuts it down automatically if carbon monoxide builds up"
    ],
    "cons": [
      "1,800 running watts restricts you to the essentials",
      "An under-1-gallon tank means several refills a day at heavier loads",
      "Priced noticeably above rival 2,200W inverters"
    ],
    "bottomLine": "The best small generator you can buy for keeping food cold, phones charged and a few lights on.",
    "description": "The EU2200i is the small inverter others are measured against, and the reasons are mostly unglamorous: it starts, it keeps starting, and dealer support for Honda engines is everywhere. Its ratings are 1,800 running and 2,200 starting watts, enough for a refrigerator plus lights, internet, phone charging and a TV, or a gas furnace blower by itself. Honda lists run time at about 3.2 hours at full rated load and about 8.1 hours at a quarter load on the 0.95-gallon tank, so build your fuel supply around those figures. Noise is rated at 48 to 57 dBA, which is why owners say they can run it near a neighbor's bedroom window without complaints. CO-MINDER stops the engine if carbon monoxide gathers nearby, a backup to good placement rather than a replacement for it. Two EU2200i units can be paralleled for more output. Expect roughly $1,100 to $1,300 at the time of writing."
  },
  {
    "id": "generac-gp8000e",
    "name": "Generac GP8000E",
    "category": "Open-Frame Portable, 8,000W Running",
    "badge": "Most Watts per Dollar",
    "amazonUrl": "",
    "pros": [
      "8,000 running and 10,000 starting watts on gasoline",
      "Electric start with a battery the generator keeps charged",
      "COsense automatic carbon monoxide shutoff",
      "Big tank for long runs between refills at half load",
      "A 120/240V locking outlet ready for a transfer switch"
    ],
    "cons": [
      "Runs on gasoline only",
      "Open-frame engine noise",
      "Fuel use at high load mounts quickly in a long outage"
    ],
    "bottomLine": "Plenty of running watts for the money from a brand with broad parts and service coverage.",
    "description": "Choose the GP8000E when you want large portable output and are happy to run on gasoline. Generac rates it at 8,000 running and 10,000 starting watts, enough for a 240V well pump, a refrigerator, a freezer, a furnace blower and lights through a transfer switch, or a window air conditioner in place of one of those. Electric start works from a key switch with a pull cord as backup, and the COsense module stops the engine if carbon monoxide gathers around it. The open frame and steel cradle are made to be hauled out of a shed, and the never-flat wheels help on gravel. Because it is a conventional generator rather than an inverter, the engine holds a fixed speed, so fuel burn and noise barely fall at light load. Set aside money for stabilized gasoline and approved cans. Expect roughly $1,000 to $1,300 at the time of writing."
  },
  {
    "id": "duromax-xp12000eh",
    "name": "DuroMax XP12000EH",
    "category": "Open-Frame Dual Fuel, 9,500W Running",
    "badge": "Biggest Portable Output",
    "amazonUrl": "",
    "pros": [
      "12,000 starting and 9,500 running watts on gasoline",
      "Dual fuel with a quick changeover between gasoline and propane",
      "50-amp 120/240V outlet for a larger transfer switch or interlock",
      "Copper alternator windings",
      "Electric start"
    ],
    "cons": [
      "Weighs well over 200 pounds",
      "Burns fuel heavily at high load",
      "Loud enough that placement and neighbors both need planning"
    ],
    "bottomLine": "The portable that gets closest to standby output, for buyers willing to live with the weight, noise and fuel burn.",
    "description": "The XP12000EH is close to the most generator most people would still call portable. DuroMax rates it at 12,000 starting and 9,500 running watts on gasoline, with lower figures on propane, and it has a 50-amp 120/240V outlet suited to a larger manual transfer switch or a panel interlock. That can run a central air conditioner in the smaller tonnage ranges alongside essentials, depending on its starting draw, or carry much of a house that has gas heat and a gas water heater. The compromises are physical. At well over 200 pounds it lives on its wheels, and at heavy load it burns many gallons of gasoline a day or needs a serious propane supply. If you are shopping at this size, get a price on a small standby unit as well; the gap shrinks once fuel, cans and labor are counted. Expect roughly $1,200 to $1,600 at the time of writing."
  },
  {
    "id": "ecoflow-delta-pro-solar",
    "name": "EcoFlow Delta Pro",
    "category": "3.6kWh LiFePO4 Battery Station",
    "badge": "Indoor-Safe Battery Backup",
    "amazonUrl": "",
    "pros": [
      "No engine, exhaust or carbon monoxide, so it can run inside the house",
      "3.6kWh LiFePO4 battery that expands with add-on packs",
      "3,600W continuous output",
      "Recharges from a wall outlet, solar panels, a car or a gas generator",
      "Silent, so it can run a CPAP or fridge overnight without disturbing anyone"
    ],
    "cons": [
      "Costly per kilowatt-hour stored",
      "Runs out in a long outage unless solar or a generator refills it",
      "120V only per unit"
    ],
    "bottomLine": "The right outage power for apartments, condos, medical devices and anyone who cannot run an engine safely.",
    "description": "The Delta Pro is a big lithium iron phosphate battery with an inverter, not a generator in the combustion sense, and that is precisely why it is here. With no engine, it can sit in a kitchen or bedroom running a refrigerator, a CPAP, a modem and lights with no carbon monoxide risk and no noise. EcoFlow rates the base unit at 3.6kWh of storage and 3,600 watts of continuous output, and extra battery packs expand the system. It recharges from a wall outlet, solar panels, a vehicle or EcoFlow's own smart gas generator, which turns it into a quiet buffer for a fuel-burning unit. The constraint is arithmetic: a typical refrigerator uses 1 to 2kWh a day, so one Delta Pro carries essentials for one to three days without solar. Expect roughly $2,500 to $3,500 at the time of writing, depending on bundles."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Outage Generators",
          item: "https://www.allmetalbrake.com/best-home-generator-for-power-outages/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How big a generator do I need for an average house during an outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Essentials alone, meaning a refrigerator, freezer, lights, internet and a gas furnace blower, need about 3,500 to 5,000 running watts. A sump pump or a 240V well pump moves you into the 6,000 to 8,000 watt range. Central air plus the whole panel usually takes a 20 to 24kW standby unit or a smaller one with load management. Read your appliance data plates instead of trusting averages."
          }
        },
        {
          "@type": "Question",
          "name": "Is a standby generator worth it over a good portable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "That turns on how often and how long your power goes out. Standby costs several times as much, but it starts itself, needs no refueling on natural gas and covers the whole house. Multi-day outages most years, a finished basement, or someone at home who cannot manage a portable usually justify it. For occasional outages, a portable with an interlock is much better value."
          }
        },
        {
          "@type": "Question",
          "name": "How far from the house should a portable generator be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Federal safety guidance calls for at least 20 feet from the house, with the exhaust aimed away from doors, windows and vents, and more distance is better. Never run one in a garage, a carport against the house, a basement, a crawlspace or a shed, even with the doors open. Back up good placement with a CO shutoff generator and battery-powered CO alarms on every level."
          }
        },
        {
          "@type": "Question",
          "name": "Can I plug my generator into a dryer outlet to power the house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. That is backfeeding, and it can electrocute utility workers, hurt neighbors, wreck your generator when grid power returns and start a fire. It also breaks electrical code. The legal routes to house circuits are a manual transfer switch or a listed panel interlock with an outdoor inlet, installed by a licensed electrician, or extension cords run straight to appliances."
          }
        },
        {
          "@type": "Question",
          "name": "Will a portable generator run my central air conditioner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sometimes. A 3-ton condenser usually runs on 3,000 to 4,000 watts but can need several times that to start. A large portable in the 9,000-plus running watt class can often manage it, especially with a soft-start kit fitted by an HVAC technician, though little may be left for anything else. Many households cool one room with a window unit instead."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a generator run on a tank of gas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Load decides it. A small inverter can run eight hours or more at light load on about a gallon, while a large open-frame portable might manage eight to twelve hours at half load on a big tank and much less near full load. Look up the manufacturer's run-time figures at 25 and 50 percent load and plan your fuel around realistic use."
          }
        },
        {
          "@type": "Question",
          "name": "Is a battery power station a real replacement for a generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For short outages, apartments and medical devices, yes, and it is the only backup you can run indoors. For multi-day outages it supplements a generator rather than replacing one, unless solar panels or a generator recharge it. A typical refrigerator uses 1 to 2 kWh a day, so divide the station's capacity by your daily loads to estimate how long it lasts."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "best home generator for power outages",
      "standby generator",
      "portable generator",
      "transfer switch",
      "generator sizing",
      "carbon monoxide safety"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The 7 Best Home Generators for Power Outages in 2026
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          Most houses need about 3,500 to 5,000 running watts for essentials, which a 7,000 to 9,500 watt dual fuel portable on an interlock covers with room to spare. Long, frequent outages, a well or sump pump, or central air push the answer toward the Generac Guardian 22kW standby. Below: seven picks, sizing math, safe hookup, carbon monoxide rules, fuel and real costs.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          Based on spec sheets, warranty terms, EPA, CARB and CO shutoff certifications, and owner feedback. Not hands-on tested. No paid placements. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">13 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>The Best Outage Generators</span></a>
              <a href="#short-answer" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>The Short Answer</span></a>
              <a href="#outage-profile" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Start With Your Outages</span></a>
              <a href="#four-classes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Which Type of Backup?</span></a>
              <a href="#sizing" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>How Many Watts You Need</span></a>
              <a href="#connecting" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Connecting It Safely</span></a>
              <a href="#carbon-monoxide" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Carbon Monoxide Safety</span></a>
              <a href="#fuel-plan" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>How Much Fuel to Store</span></a>
              <a href="#real-cost" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>What It Really Costs</span></a>
              <a href="#readiness" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Keeping It Ready</span></a>
              <a href="#matching" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>Which Pick Fits Your Home</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">12.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">13.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The right outage generator is the smallest machine that keeps your must-run loads going for as long as your outages really last, wired in through a transfer switch or interlock, and parked where its exhaust can never reach the house. Every section below builds on that idea.
