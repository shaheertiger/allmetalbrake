---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Small Generators for Home",
    "url": "/best-small-generator-for-home/"
  },
  {
    "title": "Best Gas Generators",
    "url": "/best-gas-generator/"
  },
  {
    "title": "Generac Generator Cost",
    "url": "/generac-generator-cost/"
  },
  {
    "title": "Best Whole House Surge Protectors",
    "url": "/best-whole-house-surge-protector/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "Home Generators for Power Outages: 7 Picks Ranked by Need";
const description =
  "Seven outage generators ranked for real households: standby, portable, inverter and battery, plus sizing math, transfer switch rules and carbon monoxide safety.";

const PRODUCTS = [
  {
    "id": "generac-guardian-22kw",
    "name": "Generac Guardian 22kW",
    "category": "Air-Cooled Standby, Natural Gas or LP",
    "badge": "Top Pick: Automatic Whole-House",
    "amazonUrl": "",
    "pros": [
      "Starts and takes the load on its own, usually within seconds of the grid dropping",
      "22kW on propane, 19.5kW on natural gas covers most homes including central air",
      "Runs for days on a natural gas line with no refueling trips",
      "Weekly self-test and Wi-Fi monitoring through Generac's app",
      "Largest dealer and service network of any standby brand"
    ],
    "cons": [
      "Installed cost commonly lands well into five figures",
      "Needs a permit, a concrete or composite pad, and licensed trades",
      "Annual service is not optional if you want it to start when it matters"
    ],
    "bottomLine": "If outages in your area run long and often, nothing on this list replaces an automatic standby unit.",
    "description": "The Guardian 22kW is the default answer for a household that wants the lights to come back on without anyone walking outside. It is permanently mounted on a pad, plumbed to natural gas or a propane tank, and wired through an automatic transfer switch, so it senses the outage, starts, and carries the house on its own. Generac rates it at 22,000 watts on propane and 19,500 on natural gas, enough for a typical 2,000 to 3,000 square foot home with a central air conditioner and gas heat, especially when paired with the load-shedding modules Generac offers. The air-cooled engine exercises itself weekly and reports status to the Mobile Link app. The catch is money and paperwork: the unit itself runs roughly $5,500 to $6,500 at the time of writing, and permits, electrical work, gas piping and the pad typically push the installed total to $10,000 to $18,000 or more. Plan on yearly oil, filter and plug service by a dealer."
  },
  {
    "id": "champion-9200w-dual-fuel",
    "name": "Champion 9200W Dual Fuel",
    "category": "Open-Frame Portable, Gasoline + Propane",
    "badge": "Top Portable for Most Homes",
    "amazonUrl": "",
    "pros": [
      "Runs on gasoline or a standard propane cylinder, a real advantage when gas stations are dark",
      "Enough output for a fridge, freezer, sump pump, furnace blower and lights at once",
      "Electric start with a recoil backup",
      "Champion's CO Shield shuts the engine down if carbon monoxide builds up around it",
      "120/240V locking outlet suits a manual transfer switch or interlock inlet"
    ],
    "cons": [
      "Heavy enough that you will want the wheel kit and a second person",
      "Loud by inverter standards; neighbors will hear it",
      "Propane output is lower than the gasoline rating"
    ],
    "bottomLine": "The strongest value for a family that wants most of the house running for a few thousand dollars less than standby.",
    "description": "This is the portable we would point most suburban homeowners toward first. The 9,200 figure is its peak starting rating on gasoline; running output is lower, and lower again on propane, so read the label's running-watt numbers for each fuel when you build your load list. Even so, it lands in the class that can carry a refrigerator, a chest freezer, a sump pump, a gas furnace blower, Wi-Fi and a bank of lights at the same time, with headroom for a window air conditioner if you stagger the start-ups. Dual fuel matters more than the spec sheet suggests: propane keeps for years without stabilizer, and after a hurricane or ice storm a stack of filled cylinders is often easier to find than open gas pumps. Champion's CO Shield sensor shuts the engine off if carbon monoxide accumulates around the unit. Expect roughly $1,000 to $1,400 at the time of writing, plus a transfer switch or interlock installed by an electrician."
  },
  {
    "id": "westinghouse-igen4500",
    "name": "Westinghouse iGen4500",
    "category": "Inverter, 3,700W Running, Remote Start",
    "badge": "Quiet Mid-Size Choice",
    "amazonUrl": "",
    "pros": [
      "3,700 running and 4,500 peak watts in a quiet inverter package",
      "Clean inverter power suits electronics, furnace control boards and medical devices",
      "Electric and remote key-fob start",
      "Long run time on a 3.4-gallon tank at light load",
      "Onboard data display shows load, fuel and remaining run time"
    ],
    "cons": [
      "120V only, so it cannot power a 240V well pump",
      "Close to 100 pounds; the wheels are not optional"
    ],
    "bottomLine": "The sweet spot for a house that needs more than a 2,200W suitcase unit but does not want to listen to an open-frame engine all night.",
    "description": "The iGen4500 fills the gap most outage buyers fall into: too much load for a small inverter, not enough budget or patience for a 9,000-watt open frame. Westinghouse rates it at 3,700 running and 4,500 starting watts, which covers a refrigerator, a freezer, a gas furnace blower, a sump pump, lights and electronics if you are sensible about what runs together. Because it is an inverter, the output is clean enough for sensitive electronics, and the engine throttles down at light load, which is where its long run time on a 3.4-gallon tank comes from. Owners commonly report it is noticeably quieter than open-frame units of similar output, and the remote start is a genuine convenience in a February storm. The limit is the 120V-only panel: a 240V well pump or electric range is off the table. Expect roughly $1,000 to $1,300 at the time of writing."
  },
  {
    "id": "honda-eu2200i",
    "name": "Honda EU2200i",
    "category": "Inverter, 1,800W Running, 47 lb",
    "badge": "Quietest Essentials Backup",
    "amazonUrl": "",
    "pros": [
      "Honda GXR120 engine with a long record of reliability",
      "About 47 pounds and genuinely carryable by one adult",
      "48 to 57 dBA rating is quiet enough for close neighbors",
      "Parallel capable with a second unit for double the output",
      "CO-MINDER automatically shuts it down if carbon monoxide builds up"
    ],
    "cons": [
      "1,800 running watts limits you to the essentials",
      "Under-1-gallon tank means refueling several times a day at heavier loads",
      "Costs noticeably more than rival 2,200W inverters"
    ],
    "bottomLine": "The best small generator money buys for keeping food cold, phones charged and a few lights on.",
    "description": "The EU2200i is the benchmark small inverter, and the reasons are mostly unglamorous: it starts, it keeps starting, and dealer support for Honda engines is everywhere. It is rated at 1,800 running and 2,200 starting watts, enough for a refrigerator plus lights, internet, phone charging and a TV, or a gas furnace blower on its own. Honda lists run time at about 3.2 hours at full rated load and about 8.1 hours at a quarter load on its 0.95-gallon tank, so plan your fuel supply around that. Noise is rated at 48 to 57 dBA, which is why it is the one owners say they can run next to a neighbor's bedroom window without complaints. CO-MINDER shuts the engine off if carbon monoxide accumulates near it, a backup to correct placement rather than a substitute. Two EU2200i units can be paralleled for more output. Expect roughly $1,100 to $1,300 at the time of writing."
  },
  {
    "id": "generac-gp8000e",
    "name": "Generac GP8000E",
    "category": "Open-Frame Portable, 8,000W Running",
    "badge": "Most Watts per Dollar",
    "amazonUrl": "",
    "pros": [
      "8,000 running and 10,000 starting watts on gasoline",
      "Electric start with a battery that the unit keeps topped up",
      "COsense automatic shutoff for carbon monoxide",
      "Large tank for a long run between refills at half load",
      "Transfer-switch-ready 120/240V locking outlet"
    ],
    "cons": [
      "Gasoline only",
      "Open-frame engine noise",
      "Fuel burn at high load adds up quickly in a long outage"
    ],
    "bottomLine": "A lot of running watts for the money from a brand with wide parts and service availability.",
    "description": "The GP8000E is the right pick when you want big portable output and are content to run on gasoline. Generac rates it at 8,000 running and 10,000 starting watts, enough to handle a well pump on 240V, a refrigerator, a freezer, a furnace blower and lights through a transfer switch, or a window air conditioner in place of one of those. The electric start is a key-switch affair, with a pull cord as backup, and the COsense module shuts the engine down if carbon monoxide accumulates around it. The open frame and steel cradle are built for being dragged out of a shed, and the never-flat wheels help on gravel. Because it is a conventional generator rather than an inverter, the engine runs at a fixed speed, so fuel burn and noise do not drop much at light load. Budget for stabilized gasoline and approved cans. Expect roughly $1,000 to $1,300 at the time of writing."
  },
  {
    "id": "duromax-xp12000eh",
    "name": "DuroMax XP12000EH",
    "category": "Open-Frame Dual Fuel, 9,500W Running",
    "badge": "Biggest Portable Output",
    "amazonUrl": "",
    "pros": [
      "12,000 starting and 9,500 running watts on gasoline",
      "Dual fuel with a quick switch between gasoline and propane",
      "50-amp 120/240V outlet for a larger transfer switch or interlock",
      "Copper alternator windings",
      "Electric start"
    ],
    "cons": [
      "Well over 200 pounds",
      "Very thirsty at heavy load",
      "Loud enough that placement and neighbors both need thought"
    ],
    "bottomLine": "The portable that comes closest to standby output, for buyers who accept the weight, noise and fuel burn.",
    "description": "The XP12000EH is about as much generator as most people can still call portable. DuroMax rates it at 12,000 starting and 9,500 running watts on gasoline, with lower figures on propane, and it carries a 50-amp 120/240V outlet that suits a larger manual transfer switch or a panel interlock. That is enough to run a central air conditioner in the smaller tonnage ranges alongside essentials, depending on its starting draw, or to carry a large share of a house that has gas heat and a gas water heater. The trade-offs are physical. It weighs well over 200 pounds, so it lives on its wheels, and at heavy load its fuel burn means many gallons of gasoline a day or a serious propane supply. If you find yourself shopping at this size, price out a small standby unit too; the gap narrows once you count fuel, cans and labor. Expect roughly $1,200 to $1,600 at the time of writing."
  },
  {
    "id": "ecoflow-delta-pro-solar",
    "name": "EcoFlow Delta Pro",
    "category": "3.6kWh LiFePO4 Battery Station",
    "badge": "Indoor-Safe Battery Backup",
    "amazonUrl": "",
    "pros": [
      "No engine, no exhaust, no carbon monoxide; can run inside the house",
      "3.6kWh LiFePO4 battery expandable with add-on packs",
      "3,600W continuous output",
      "Recharges from wall, solar panels, a car or a gas generator",
      "Silent, so it can power a CPAP or fridge overnight without disturbing anyone"
    ],
    "cons": [
      "Expensive per kilowatt-hour stored",
      "Capacity runs out in a long outage unless you have solar or a generator to refill it",
      "120V only per unit"
    ],
    "bottomLine": "The right outage power for apartments, condos, medical devices and anyone who cannot safely run an engine.",
    "description": "The Delta Pro is a large lithium iron phosphate battery with an inverter, not a generator in the combustion sense, and that is exactly its value. It has no engine, so it can sit in a kitchen or bedroom and run a refrigerator, a CPAP, a modem and lights with no carbon monoxide risk and no noise. EcoFlow rates the base unit at 3.6kWh of storage and 3,600 watts of continuous output, and the system can be expanded with extra battery packs. Recharge options include a wall outlet, solar panels, a vehicle and EcoFlow's own smart gas generator, which turns it into a quiet buffer for a fuel-powered unit. The limits are arithmetic: a typical refrigerator uses 1 to 2kWh a day, so a single Delta Pro carries essentials for one to three days without solar. Expect roughly $2,500 to $3,500 at the time of writing, depending on bundles."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Outage Generators",
          item: "https://www.allmetalbrake.com/best-home-generator-for-power-outages/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How big a generator do I need for an average house during an outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For essentials only, refrigerator, freezer, lights, internet and a gas furnace blower, about 3,500 to 5,000 running watts is enough. Add a sump pump or a 240V well pump and you are in the 6,000 to 8,000 watt range. Covering central air and the whole panel usually means a 20 to 24kW standby unit or a load-managed smaller one. Check your appliance data plates rather than relying on averages."
          }
        },
        {
          "@type": "Question",
          "name": "Is a standby generator worth it over a good portable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on how often and how long you lose power. Standby costs several times more but starts on its own, needs no refueling on natural gas, and covers the whole house. If you lose power for multiple days most years, have a finished basement, or someone at home cannot manage a portable, standby is usually worth it. For occasional outages, a portable and interlock is far better value."
          }
        },
        {
          "@type": "Question",
          "name": "How far from the house should a portable generator be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Federal safety guidance says at least 20 feet from the house, with the exhaust pointed away from doors, windows and vents, and farther is better. Never run it in a garage, carport against the house, basement, crawlspace or shed, even with doors open. Pair correct placement with a CO shutoff generator and battery-powered CO alarms inside on every level."
          }
        },
        {
          "@type": "Question",
          "name": "Can I plug my generator into a dryer outlet to power the house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. That is backfeeding, and it can electrocute utility workers, injure neighbors, damage your generator when grid power returns and start a fire. It also violates electrical code. The legal ways to power house circuits are a manual transfer switch or a listed panel interlock with an outdoor inlet, installed by a licensed electrician, or extension cords run directly to appliances."
          }
        },
        {
          "@type": "Question",
          "name": "Will a portable generator run my central air conditioner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sometimes. A 3-ton condenser typically runs on 3,000 to 4,000 watts but can need several times that to start. A large portable in the 9,000-plus running watt class can often handle it, especially with a soft-start kit installed by an HVAC technician, but there may be little left for anything else. Many households run a window unit in one room instead."
          }
        },
        {
          "@type": "Question",
          "name": "How long will a generator run on a tank of gas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It varies widely with load. A small inverter can run eight hours or more at light load on about a gallon, while a large open-frame portable might run eight to twelve hours at half load on a big tank and far less near full load. Check the manufacturer's run-time figures at 25 and 50 percent load and plan your fuel around realistic usage."
          }
        },
        {
          "@type": "Question",
          "name": "Is a battery power station a real replacement for a generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For short outages, apartments and medical devices, yes, and it is the only option you can run indoors. For multi-day outages it is a supplement, not a replacement, unless you add solar panels or a generator to recharge it. A typical refrigerator uses 1 to 2 kWh a day, so divide the station's capacity by your daily loads to see how long it lasts."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "best home generator for power outages",
      "standby generator",
      "portable generator",
      "transfer switch",
      "generator sizing",
      "carbon monoxide safety"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best Home Generators for <span class="text-[#38BDF8]">Power Outages</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Seven machines for seven kinds of outage, from a two-day ice storm to a week without the grid. Sized honestly, connected safely, and kept far away from your windows.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#generac-guardian-22kw"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="21.6k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Ranked Picks</a>
          <a href="#outage-profile" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Start With Your Outage</a>
          <a href="#four-classes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Four Classes of Backup</a>
          <a href="#sizing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Sizing the Generator</a>
          <a href="#connecting" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Connecting to the House</a>
          <a href="#carbon-monoxide" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Carbon Monoxide Safety</a>
          <a href="#fuel-plan" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Fuel Planning</a>
          <a href="#real-cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. What It Really Costs</a>
          <a href="#readiness" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Keeping It Ready</a>
          <a href="#matching" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Which Pick Fits Which Home</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The right outage generator is the smallest one that keeps your must-run loads alive for as long as your outages actually last, connected through a transfer switch or interlock, and parked where its exhaust can never reach the house. Everything below follows from that sentence.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Seven Outage Generators, Ranked
          </h2>

          <p>
            We ranked these from manufacturer spec sheets (running and starting watts, fuel burn, tank size, outlet panel), warranty terms, emissions and safety certifications such as EPA, CARB and the ANSI/PGMA G300 carbon monoxide shutoff standard, and the patterns that show up repeatedly in owner feedback. We did not run these units in a test program of our own. Order reflects how well each machine solves the most common outage problem for its class, not raw wattage.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
