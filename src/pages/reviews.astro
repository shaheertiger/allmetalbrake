---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import ProductImage from '../components/ProductImage.astro';
import { articles, articleUrl, productMap, shortName } from '../lib/data';
import { breadcrumbs, graph, itemList } from '../lib/schema';
const items = articles.filter((a) => a.kind === 'review');
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Brand Reviews', url: '/reviews/' }];
---
<Base title="Backup Power Brand Reviews: EcoFlow, Jackery, Anker SOLIX" description="Candid power station brand reviews: which EcoFlow, Jackery and Anker SOLIX models are worth buying for outages and camping, and which to skip for your loads." schema={graph(breadcrumbs(crumbs), itemList(items.map((a) => ({ name: a.h1, url: articleUrl(a) }))))}>
  <div class="wrap hub">
    <Crumbs items={crumbs} />
    <h1 class="hub-title">Backup Power Brand Reviews</h1>
    <p class="hub-dek">What each brand does well, where it falls short, and the specific models worth your money.</p>
    <div class="grid grid-3">
      {items.map((a) => {
        const top = a.picks?.[0] ? productMap.get(a.picks[0].product) : undefined;
        return <a class="card" href={articleUrl(a)}>{top && <ProductImage p={top} size={88} />}<span class="card-k">Brand Review</span><h3>{a.h1}</h3><span class="card-sub">{a.picks?.length} models ranked{top && ` · Top: ${shortName(top.name)}`}</span></a>;
      })}
    </div>
    <p class="fine" style="margin-top:1.5rem">Looking for a brand we haven't reviewed yet? Every brand we track is on the <a href="/brands/">brands page</a>.</p>
  </div>
</Base>
