                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Room Size</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Suggested BTU</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Example Pick</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">100 to 150 sq ft</td>
                    <td class="px-4 py-4 text-gray-700">5,000</td>
                    <td class="px-4 py-4 text-gray-700">Midea EasyCool, Frigidaire FFRA051WAE, BLACK+DECKER BD05MWT6</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">150 to 250 sq ft</td>
                    <td class="px-4 py-4 text-gray-700">6,000</td>
                    <td class="px-4 py-4 text-gray-700">LG LW6017R</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">250 to 300 sq ft</td>
                    <td class="px-4 py-4 text-gray-700">7,000</td>
                    <td class="px-4 py-4 text-gray-700">Step up to 8,000 if sunny</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">300 to 350 sq ft</td>
                    <td class="px-4 py-4 text-gray-700">8,000</td>
                    <td class="px-4 py-4 text-gray-700">Midea U-Shaped Inverter, Frigidaire FFRS0822SE</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div id="at-a-glance" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Small Window Air Conditioners Compared
