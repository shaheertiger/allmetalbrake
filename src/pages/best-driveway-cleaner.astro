---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Driveway Oil Stains on Asphalt and Concrete",
    "url": "/how-to-remove-oil-stains-from-driveway/"
  },
  {
    "title": "Getting Old Oil Out of Concrete",
    "url": "/how-to-get-oil-out-of-concrete/"
  },
  {
    "title": "Best Oil Stain Remover for Concrete",
    "url": "/best-oil-stain-remover-for-concrete/"
  },
  {
    "title": "Best Surface Cleaner for Pressure Washer",
    "url": "/best-surface-cleaner-for-pressure-washer/"
  },
  {
    "title": "Best Concrete Driveway Sealer Reviews",
    "url": "/best-concrete-driveway-sealer-reviews/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "7 Best Driveway Cleaners in 2026: For Oil, Rust and Mildew";
const description =
  "Driveway cleaners matched to the stain: degreasers for oil, oxygen cleaners for grime, rust removers and mildew treatments, plus how to wash the whole slab.";

const PRODUCTS = [
  {
    "id": "zep-driveway-cleaner",
    "name": "Zep Driveway and Concrete Pressure Wash Concentrate",
    "category": "Pressure washer concentrate",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "Made to run through a pressure washer detergent system",
      "Handles the general mix of dirt, tire marks and light oil",
      "Large jugs keep cost per square foot low",
      "Widely stocked at home centers"
    ],
    "cons": [
      "Not aggressive enough for heavy oil stains alone",
      "Does not treat rust",
      "Best results need a pressure washer"
    ],
    "bottomLine": "The best single product for washing an entire concrete driveway.",
    "description": "Zep's driveway concentrate is designed for whole-surface cleaning through a pressure washer's detergent tank or downstream injector, though it can also go on with a pump sprayer. It targets the combination most driveways actually have: dirt film, tire marks, organic grime and light oil drips. Follow the label dilution for your machine, apply from the bottom of the driveway up to avoid streaking, let it dwell without drying, then rinse with a high-pressure tip or a surface cleaner attachment. Owners commonly report a visibly brighter, more even slab after a single pass. It is not a specialty stain remover: heavy oil spots need a dedicated degreaser or poultice first, and rust stains need an acid-based rust remover. Think of it as the product you finish with so spot-cleaned areas blend into the rest. It is sold in gallon jugs at most home centers. Expect roughly $10 to $20 a gallon at the time of writing, typically enough for a standard two-car driveway at the recommended dilution."
  },
  {
    "id": "simple-green-oxy-solve-concrete",
    "name": "Simple Green Oxy Solve Concrete and Driveway Cleaner",
    "category": "Oxygenated cleaner concentrate",
    "badge": "Best for Gray Film and Organic Grime",
    "amazonUrl": "",
    "pros": [
      "Oxygenated formula lifts organic staining and dull gray film",
      "Runs through a pressure washer or pump sprayer",
      "Gentler on landscaping than chlorine products",
      "Brightens concrete evenly"
    ],
    "cons": [
      "Limited effect on old oil",
      "Pressure washer use recommended for best results",
      "Not a rust remover"
    ],
    "bottomLine": "A strong choice when the driveway looks dingy rather than oily.",
    "description": "Simple Green's Oxy Solve concrete cleaner uses oxygenated cleaning agents along with surfactants, aimed at the dull gray film, leaf tannins, dirt and light organic growth that make concrete look old. It is formulated for pressure washer use and also works through a pump sprayer with scrubbing. Because it does not rely on chlorine bleach, it is easier on lawn edges and plantings when rinsed well, although the label still calls for rinsing nearby plants. On a driveway that looks tired rather than oily, owners commonly report that it brightens the slab evenly in one pass. It is less effective on oil than a dedicated degreaser, and it does nothing for orange rust or fertilizer stains. Use it as the general wash on shaded, leaf-stained driveways and pair it with a degreaser for spots near the garage. Follow the dilution on the label, keep the surface wet during dwell, and rinse thoroughly. Expect roughly $15 to $25 a gallon at the time of writing."
  },
  {
    "id": "krud-kutter-concrete-driveway",
    "name": "Krud Kutter Concrete and Driveway Cleaner Degreaser",
    "category": "Degreaser and general cleaner",
    "badge": "Best Two-in-One",
    "amazonUrl": "",
    "pros": [
      "Degreases and cleans general grime in one product",
      "Works by brush, sprayer or pressure washer",
      "Water-based formula",
      "Good choice for driveways with scattered oil spots"
    ],
    "cons": [
      "Not as strong as a dedicated concentrate on heavy oil",
      "Ready-to-use sizes get expensive on large slabs",
      "Check asphalt guidance on the label"
    ],
    "bottomLine": "A balanced pick when you have some oil and some general dirt and want one bottle.",
    "description": "Krud Kutter's concrete and driveway cleaner sits between a pure degreaser and a general pressure washer detergent. It is water-based, designed to break down oil and grease while also lifting ordinary dirt, which makes it practical for a driveway with a few drips near the garage and grime everywhere else. You can scrub it in with a stiff brush on individual spots, spray it over larger areas, or run it through a pressure washer where the label allows. Owners commonly mention that it handles fresh and recent oil well and leaves a fairly uniform finish. Old, deep oil stains still need a poultice or enzyme treatment, because a cleaner like this only reaches what it touches during dwell time. As always on asphalt, read the current label for compatibility and test a small corner first. It is sold in several sizes; the concentrate is the better value for whole-driveway work. Expect roughly $12 to $25 depending on size at the time of writing."
  },
  {
    "id": "oil-eater-original",
    "name": "Oil Eater Cleaner Degreaser Concentrate (Original)",
    "category": "Heavy-duty degreaser",
    "badge": "Best for Oil",
    "amazonUrl": "",
    "pros": [
      "Strong on fresh and recent oil and grease",
      "Flexible dilution from light to heavy duty",
      "Non-flammable, water-based",
      "Low cost per gallon of working solution"
    ],
    "cons": [
      "Will not remove rust or organic stains well",
      "Deep stains need a poultice or enzyme follow-up",
      "Alkaline: gloves and eye protection needed"
    ],
    "bottomLine": "The oil specialist for the garage end of the driveway.",
    "description": "Oil Eater Original is a concentrated, water-based alkaline degreaser that has long been a staple for shop floors and driveways. Its strength is oil: diluted heavily, it washes a slab; used strong, it attacks grease drips, tire marks and fresh oil spots. Apply it to pre-wet concrete, scrub with a stiff nylon brush, keep it wet for the dwell time on the label, and rinse with a pressure washer or hose. It can also run through many pressure washer detergent systems. On a driveway with heavy oil near the garage, it is the best first product in this list, often followed by a general wash so the cleaned spot does not look lighter than the surrounding concrete. It is not designed for rust, fertilizer stains or algae, and like every degreaser it cleans shallow oil better than deep, old stains. Treat it with the respect any alkaline cleaner deserves, and keep it off aluminum trim. Expect roughly $15 to $30 a gallon at the time of writing."
  },
  {
    "id": "f9-barc",
    "name": "F9 BARC Rust and Fertilizer Stain Remover",
    "category": "Rust and mineral stain remover",
    "badge": "Best for Rust",
    "amazonUrl": "",
    "pros": [
      "Targets orange rust from sprinklers, fertilizer and metal",
      "Also used on battery acid and some mineral stains",
      "Professional-grade product sold to homeowners",
      "Small amounts treat many spots"
    ],
    "cons": [
      "Acid-based: needs careful handling and rinsing",
      "Can affect some sealers and colored concrete",
      "Pricier than general cleaners"
    ],
    "bottomLine": "The specialist to buy when the problem is orange, not black.",
    "description": "F9 BARC comes from Front 9 Restoration, a brand used by professional exterior cleaners, and it is aimed at the stains general cleaners cannot touch: orange rust from well-water sprinklers, fertilizer granules, metal furniture and fasteners, plus related mineral discoloration. Rust is iron oxide, and degreasers and oxygen cleaners do essentially nothing to it; an acid-based rust remover dissolves it. The manufacturer's instructions call for pre-wetting the surface, applying the product to the stain, brushing as needed and rinsing thoroughly. Owners commonly report that fertilizer speckles and sprinkler streaks fade quickly, often in a single application. Because it is acidic, wear gloves and eye protection, protect nearby plants, and test on colored, stamped or sealed concrete first, since acid can affect some finishes. Do not mix it with other cleaners, and especially not with bleach. It is more expensive per bottle than general washes but goes a long way on spot work. Expect roughly $40 to $70 for a gallon at the time of writing."
  },
  {
    "id": "wet-forget-outdoor",
    "name": "Wet and Forget Outdoor Mold, Mildew and Algae Stain Remover",
    "category": "No-scrub organic stain treatment",
    "badge": "Best for Mildew and Algae",
    "amazonUrl": "",
    "pros": [
      "No rinsing or scrubbing: spray and let weather do the work",
      "Treats green algae, black mildew and lichen",
      "Bleach-free formula",
      "Covers large areas cheaply over time"
    ],
    "cons": [
      "Slow: results take weeks to months",
      "No effect on oil or rust",
      "Requires dry weather right after application"
    ],
    "bottomLine": "The low-effort answer for shaded driveways with green and black growth.",
    "description": "Wet and Forget Outdoor works differently from everything else on this list. Instead of a scrub-and-rinse cleaner, it is a treatment you spray on a dry surface and leave. Rain and time then gradually wash away the dead mold, mildew, algae and lichen. The label notes results typically take weeks to months, depending on weather and how heavy the growth is. That makes it ideal for shaded driveway sections, north-facing walkways and areas under trees where green or black discoloration keeps coming back. It is bleach-free, and the manufacturer provides instructions for protecting plants during application. It will not touch oil, tire marks or rust, so it complements a degreaser rather than replacing one. The main practical rule is weather: you need a dry surface and a dry window after spraying for it to soak in. If you want instant results for a party next weekend, an oxygenated wash is faster. Expect roughly $25 to $45 for a concentrate that treats a large area at the time of writing."
  },
  {
    "id": "ef2000-concrete-cleaner",
    "name": "EF2000 Degreaser for Concrete",
    "category": "Biodegradable degreaser",
    "badge": "Best Low-Toxicity Option",
    "amazonUrl": "",
    "pros": [
      "Marketed as non-toxic and biodegradable",
      "Effective on fresh oil and grime",
      "Gentler to handle than strong alkaline degreasers",
      "Can be used near landscaping with sensible rinsing"
    ],
    "cons": [
      "Slower on heavy grease than caustic products",
      "Harder to find in stores",
      "Old stains still need deeper treatment"
    ],
    "bottomLine": "A sensible pick for households that want a gentler degreaser near kids, pets and plants.",
    "description": "EF2000 is sold as an environmentally friendly, biodegradable cleaner and degreaser for concrete, engines and shop floors. Its appeal is handling: it is marketed as non-toxic and non-caustic, which makes it more comfortable to use than high-pH degreasers when children, pets or vegetable gardens are close to the driveway. It still lifts fresh oil, grease and general grime well when it is scrubbed in and given time to work. On heavy or old stains it is slower than an aggressive alkaline product, so expect more rounds or pair it with a poultice. It works by brush or through a pump sprayer, and the manufacturer provides dilution guidance for different jobs. Availability is mostly online rather than on home center shelves. As with any cleaner, rinse thoroughly and keep runoff out of the storm drain, since even biodegradable products carry the oil they lifted. Expect roughly $20 to $40 a gallon depending on the source at the time of writing."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Driveway Cleaners",
          item: "https://www.allmetalbrake.com/best-driveway-cleaner/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which driveway cleaner should I buy first?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Start with a general pressure washer concentrate, such as Zep's, if the driveway is mostly dull and dirty. Add a degreaser like Oil Eater if you have oil spots, a rust remover if you see orange stains, and a biocide like Wet and Forget for shaded mildew. Buying by stain type gets better results than one all-purpose bottle."
          }
        },
        {
          "@type": "Question",
          "name": "Will dish soap or household detergent clean a driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dish soap is a mild degreaser and works on fresh oil spots, but it is weak for a whole driveway and can leave residue if not rinsed well. Laundry detergents containing oxygen bleach can brighten organic stains. Purpose-made driveway cleaners are designed for concrete, pressure washer dilution and outdoor rinsing, so they are usually more efficient."
          }
        },
        {
          "@type": "Question",
          "name": "Is oxygen bleach better than chlorine bleach for driveways?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homeowners, yes. Oxygen cleaners break down organic stains like tannins and mildew, are gentler on plants and metal, and do not create chlorine fumes. Chlorine bleach kills growth faster but is harsher on landscaping and can never be mixed with ammonia or acids. Neither removes oil or rust."
          }
        },
        {
          "@type": "Question",
          "name": "How do I get rust stains off a concrete driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use an acid-based rust remover formulated for concrete, such as F9 BARC. Wet the area, apply the product, brush it in, and rinse thoroughly. Test on colored or sealed concrete first. Then fix the source, usually sprinkler water with high iron or fertilizer granules left on the slab, or the stains will return."
          }
        },
        {
          "@type": "Question",
          "name": "Are driveway cleaners safe on asphalt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many water-based cleaners are, but not all. Solvent-based degreasers and very strong alkaline products can soften asphalt binder. Look for asphalt on the label, test a small corner, and keep pressure moderate, because a narrow tip can strip aggregate from older blacktop. Biocides and oxygen cleaners are generally asphalt-friendly."
          }
        },
        {
          "@type": "Question",
          "name": "How often should I clean my driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A general wash once a year keeps most driveways looking good and prevents buildup that needs aggressive treatment. Treat oil spots as they happen, ideally within an hour. Shaded driveways prone to mildew may benefit from a biocide treatment once or twice a year. Clean thoroughly before every sealing."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a pressure washer to clean a driveway?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, but it helps. A pump sprayer, stiff push broom and garden hose with a high-flow nozzle can clean a driveway well, especially with oxygen cleaners. A pressure washer with a surface cleaner attachment rinses faster and leaves a more uniform finish, which matters most before sealing."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Driveway Cleaning & Stains",
    tags: [
      "best driveway cleaner",
      "concrete driveway cleaner",
      "pressure washer detergent",
      "rust stain remover concrete",
      "driveway mildew cleaner",
      "driveway cleaning before sealing"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The Best Driveway Cleaners by Stain
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          A gray, blotchy driveway usually has three or four different stains at once. One bottle rarely handles all of them, so here is which cleaner fits which mess.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">12 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>Top Picks</span></a>
              <a href="#read-stains" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>Read Your Stains</span></a>
              <a href="#chemistry" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Cleaner Chemistry</span></a>
              <a href="#surfaces" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Concrete, Asphalt, Pavers</span></a>
              <a href="#application" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>Sprayer or Pressure Washer</span></a>
              <a href="#whole-wash" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Whole-Driveway Wash</span></a>
              <a href="#specialty" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Rust, Fertilizer, Mildew</span></a>
              <a href="#before-sealing" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>Cleaning Before Sealing</span></a>
              <a href="#coverage-cost" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>Coverage and Cost</span></a>
              <a href="#safety" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Plants, Pets and Runoff</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">12.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Driveway grime is a mix: tire marks and oil near the garage, green and black organic growth in the shade, orange rust from sprinklers and fertilizer, and a general gray film of dirt everywhere else. A degreaser cuts the oil but does little for algae. An oxygen cleaner brightens the gray film but will not move rust. That is why the best driveway cleaner is really a short kit matched to what is on your slab. The picks below cover each stain type, with notes on asphalt safety, pressure washer compatibility and coverage.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Seven Driveway Cleaners Worth Buying, Ranked
          </h2>

          <p>
            Picks are ranked on label claims and directions, product chemistry, surface compatibility, coverage per container, and consistent themes in owner feedback. We did not run our own test plots. Prices are approximate ranges at the time of writing.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} index={index} />
          ))}
        </div>

        <div id="read-stains" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Read the Stains Before You Buy Anything
          </h2>

          <p>
            Walk the driveway on a dry day and note the colors. Black, slick spots near the garage or where cars park are oil and tire residue. Dark gray to black patches in shaded areas, sometimes with a green tint, are mildew and algae. Orange or rust-brown speckles and streaks come from iron in sprinkler water, fertilizer granules, metal planters or rebar near the surface. Brown or tan blotches under trees are leaf tannins. And the even gray dullness everywhere else is ordinary dirt and airborne grime.
          </p>

          <p>
            Each of those has a different chemistry. Oil needs emulsifying. Organic stains like mildew, algae and tannins respond to oxidizers, which is why oxygen cleaners brighten shaded slabs so dramatically. Rust is a mineral and needs an acid to dissolve. Dirt film responds to almost anything plus pressure. Buy for the stains you actually have, and you will spend less and get better results than with a single all-purpose bottle.
          </p>

