---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/terms.html?raw';

const title = "Terms of Use — Home Fix Reviews";
const description = "Terms of use for Home Fix Reviews. Read the rules covering site usage, our content and reviews, affiliate links, disclaimers, and limitations of liability.";
---

<BaseLayout title={title} description={description} articleCss={false} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
