  },
  {
    "id": "wet-forget-outdoor",
    "name": "Wet & Forget Outdoor Moss, Mold, Mildew & Algae Stain Remover",
    "category": "Outdoor No-Rinse Treatment, Concentrate",
    "badge": "Best for Exterior Surfaces",
    "amazonUrl": "#",
    "rating": 4.0,
    "reviewCount": 1000,
    "pros": [
      "No scrubbing and no rinsing: spray on a dry day and let weather finish the job",
      "Bleach-free, so it is gentler on siding, roofs, decks and plants than chlorine washes",
      "Works on concrete, pavers, brick, wood, stone, stucco, vinyl and composite",
      "Treated surfaces often stay clean for a long time, per the maker"
    ],
    "cons": [
      "Slow: green growth fades over weeks, dark mold stains can take months",
      "Outdoor product only; not for interior mold"
    ],
    "bottomLine": "The low-effort way to clear mildew and algae from siding, roofs and decks, for anyone patient enough to let it work.",
    "description": "Exterior mold and mildew is a different problem from the patch on a basement wall. It grows on siding, roofs, decks, fences and patios, it is too big to scrub by hand, and pressure washing can damage wood, force water behind siding and strip a roof's granules. Wet & Forget Outdoor avoids all of that. You dilute the concentrate, spray it onto a dry surface and leave it, with no scrubbing and no rinsing. Wind and rain gradually wash away the dead growth. The catch is patience: the maker says green algae often fades within a few weeks, while darker mold and moss stains can take several months. It is bleach-free, so it does not carry the plant damage and corrosion risks of chlorine washes, but rinse any plants you accidentally spray. Wet & Forget lists a long range of compatible surfaces, including concrete, pavers, brick, wood, stone, slate, stucco, vinyl and composite. Note that this is an outdoor product. For mold inside the house, use one of the indoor products above and fix the moisture source. Outside, if you can wait for results, it is the easiest way we know to clean a mildewed north wall or a green roof."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
