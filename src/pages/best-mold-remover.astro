                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Products that fit</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Non-porous</td>
