                    <td class="px-4 py-4 font-black text-gray-900">Hearing protection</td>
                    <td class="px-4 py-4 text-gray-700">Gas saws damage hearing over time</td>
                    <td class="px-4 py-4 text-gray-700">Earmuffs with a high noise reduction rating</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Eye protection</td>
