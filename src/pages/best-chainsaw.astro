---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Log Splitter Picks",
    "url": "/best-log-splitter/"
  },
  {
    "title": "Hookaroon Picks",
    "url": "/best-hookaroon-reviews/"
  },
  {
    "title": "Weed Eater Picks",
    "url": "/best-weed-eater/"
  },
  {
    "title": "Best Cordless Leaf Blowers",
    "url": "/best-cordless-leaf-blower/"
  },
  {
    "title": "Best Compact Tractors",
    "url": "/best-compact-tractor/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 7 Best Chainsaws for Homeowners: Gas vs Battery Picks";
const description =
  "Seven gas and battery chainsaws matched to storm cleanup, firewood and pruning, with bar-length sizing, kickback safety, protective gear and chain care.";

const PRODUCTS = [
  {
    "badge": "Best Overall",
    "category": "Gas, 50.2cc Mid-Size",
    "name": "Stihl MS 271 Farm Boss",
    "description": "The MS 271 Farm Boss is the saw many rural owners recommend to anyone who heats with wood or cleans up after storms. Its 50.2cc two-stroke engine is sold with bar options around 16 to 20 inches, enough for firewood rounds and moderate-size downed trees without being exhausting to carry. Stihl equips it with a chain brake, a side-access chain tensioner on many configurations, and a long-life air filtration system that reduces how often you need to clean the filter. The real advantage is the dealer network: Stihl sells through local dealers who assemble the saw, explain safe starting and chain tension, and handle repairs. That service is worth money for a first-time owner. Like any mid-size gas saw, it is loud, it vibrates, and it needs mixed fuel and regular maintenance. It is far more saw than you need for occasional pruning, but for firewood and storm cleanup it is a durable, proven choice.",
    "pros": [
      "50.2cc engine handles firewood and storm cleanup",
      "Bar options in the 16 to 20-inch range",
      "Local dealer setup and service",
      "Long-life air filter system"
    ],
    "cons": [
      "Loud, with real vibration",
      "Mixed fuel and regular maintenance",
      "Too much saw for light pruning"
    ],
    "bottomLine": "The all-around gas saw to buy for firewood and storm work if you have a Stihl dealer nearby.",
    "amazonUrl": "",
    "id": "stihl-ms-271-farm-boss"
  },
  {
    "badge": "Best Gas Value",
    "category": "Gas, 50.2cc Mid-Size",
    "name": "Husqvarna 450 Rancher",
    "description": "Husqvarna's 450 Rancher is the main competitor to the Farm Boss and is often a little less expensive. It also uses a 50.2cc engine and is commonly sold with an 18 or 20-inch bar, and it is sold through both dealers and big-box stores. Husqvarna equips it with an inertia-activated chain brake, a starting system designed to reduce pull effort, an air injection system that spins heavier debris out before it reaches the air filter, and anti-vibration dampening. It suits firewood cutting, felling small to moderate trees and storm cleanup. Buying from a dealer gets you setup and service; buying from a big-box store often saves money but may mean you assemble it and adjust chain tension yourself, which you should learn to do properly before the first cut. As with any gas saw, store it with stabilized or ethanol-free fuel to keep the carburetor clean.",
    "pros": [
      "50.2cc engine with 18 to 20-inch bar options",
      "Often priced below comparable rivals",
      "Air injection pre-cleaning for the filter",
      "Sold at dealers and large retailers"
    ],
    "cons": [
      "Big-box purchases may need self-setup",
      "Loud and heavy for pruning",
      "Needs mixed fuel and care in storage"
    ],
    "bottomLine": "A strong-value mid-size gas saw for firewood and storm cleanup.",
    "amazonUrl": "",
    "id": "husqvarna-450-rancher"
  },
  {
    "badge": "Best for Bigger Wood",
    "category": "Gas, 59.8cc Large",
    "name": "Echo CS-590 Timber Wolf",
    "description": "Echo's CS-590 Timber Wolf steps up to a 59.8cc engine and bar options around 18 to 24 inches, which gives it more muscle in large hardwood rounds and bigger blowdowns than 50cc saws. Echo has built a reputation for long consumer warranties, and the Timber Wolf has been a long-running favorite among owners who cut a lot of firewood without paying professional saw prices. It is heavier than the mid-size saws on this list, and that weight matters over a long day. It is also more saw than most suburban owners need, and a larger saw with a longer bar demands more skill to control. For someone who heats with wood and processes several cords a year, or who regularly deals with large trees on rural property, it delivers a lot of power for the money. Read the warranty terms, which typically depend on using Echo's own two-stroke oil.",
    "pros": [
      "59.8cc engine for big hardwood and blowdowns",
      "Bar options up to about 24 inches",
      "Strong consumer warranty reputation",
      "Excellent power for the price"
    ],
    "cons": [
      "Heavy for long sessions",
      "More saw than most homeowners need",
      "Demands experience to control"
    ],
    "bottomLine": "The pick for serious firewood cutters who need more than a 50cc saw.",
    "amazonUrl": "",
    "id": "echo-cs-590-timber-wolf"
  },
  {
    "badge": "Best Battery Chainsaw",
    "category": "56V Battery, 18-Inch Bar",
    "name": "EGO Power+ CS1800 56V Battery Chainsaw",
    "description": "EGO's CS1800 is an 18-inch battery saw built on EGO's 56-volt platform with a brushless motor, and it is one of the closest battery saws to a mid-size gas saw for homeowner use. It starts at the press of a trigger, idles silently between cuts, needs no fuel mix, and is far quieter than gas. EGO equips it with a chain brake and an automatic chain oiler, and many versions include tool-free chain tensioning. For storm cleanup, cutting downed limbs and occasional firewood, it is a genuinely capable tool. Runtime depends on battery size and wood; a large battery covers a cleanup session, but cutting several cords of hardwood will need multiple batteries and charging breaks. Heavier hardwood also bogs it more than a gas saw. If you already own EGO batteries, it is the easiest way to get a full-size saw without gas.",
    "pros": [
      "18-inch bar on a 56V brushless platform",
      "Instant start, quiet idle, no fuel",
      "Chain brake and automatic oiler",
      "Shares batteries with EGO yard tools"
    ],
    "cons": [
      "Runtime limits big firewood jobs",
      "Slower than gas in large hardwood",
      "Heavy with a large battery"
    ],
    "bottomLine": "The best battery saw for homeowners who want near-gas capability without the fuel.",
    "amazonUrl": "",
    "id": "ego-power-plus-cs1800"
  },
  {
    "badge": "Best for Milwaukee Owners",
    "category": "M18 Battery, 16-Inch Bar",
    "name": "Milwaukee M18 FUEL 16-inch Chainsaw",
    "description": "Milwaukee's M18 FUEL 16-inch chainsaw is one of the most capable saws on a tool battery platform, and it is aimed at contractors, arborists and serious DIYers already invested in M18 batteries. Paired with a high-output M18 battery, it has enough power for storm cleanup, limbing and moderate cutting, and it starts instantly with no warm-up. Milwaukee includes a chain brake, a metal bucking spike and a tool-free tensioning option on some versions. It is notably expensive as a bare tool and more so as a kit, and it performs best with Milwaukee's larger, more expensive batteries; small compact packs will run it briefly at best. For an M18 owner who needs a saw a few times a season, it is a strong choice. For someone starting from scratch, the cost of high-output batteries makes it a hard sell over EGO or a gas saw.",
    "pros": [
      "Strong power on a pro tool battery platform",
      "Instant start and quiet idle",
      "Metal bucking spike and chain brake",
      "Good fit for existing M18 owners"
    ],
    "cons": [
      "Expensive, especially with large batteries",
      "Needs high-output batteries to perform",
      "Shorter runtime than gas"
    ],
    "bottomLine": "A top battery saw for Milwaukee owners; costly for anyone new to the platform.",
    "amazonUrl": "",
    "id": "milwaukee-m18-fuel-16in"
  },
  {
    "badge": "Best Compact Battery",
    "category": "40V Battery, 14-Inch Bar",
    "name": "Ryobi 40V HP 14-inch Compact Chainsaw",
    "description": "Ryobi's 40-volt HP 14-inch saw is a lighter, more affordable battery saw for the jobs most suburban owners actually do: cutting downed limbs into manageable pieces, trimming back overgrown shrubs, and dealing with small trees and branches after a storm. The 14-inch bar and brushless motor are well matched, and the compact size is easier to control than a full-size saw for occasional users. It has a chain brake and an automatic oiler. It is not a firewood saw for big hardwood rounds, and it slows in thick wood. Kits are reasonably priced, and the 40-volt battery runs Ryobi's mowers, trimmers and blowers. If your saw use is a few weekends a year cleaning up the yard, this is plenty of saw and far less intimidating than a gas model.",
    "pros": [
      "Light and easy to control",
      "Brushless motor and 14-inch bar",
      "Affordable kit pricing",
      "Battery runs Ryobi 40V yard tools"
    ],
    "cons": [
      "Not suited to large firewood rounds",
      "Slows in thick hardwood",
      "Shorter bar limits log diameter"
    ],
    "bottomLine": "A smart choice for suburban owners who cut limbs and small trees a few times a year.",
    "amazonUrl": "",
    "id": "ryobi-40v-14in-compact"
  },
  {
    "badge": "Best Small Saw for Limbing",
    "category": "20V Battery, 12-Inch Bar",
    "name": "DeWalt 20V MAX XR 12-inch Compact Chainsaw",
    "description": "DeWalt's 20V MAX XR 12-inch chainsaw is a compact, rear-handle battery saw for limbing, pruning and cutting small branches. It runs on the same 20V MAX batteries as DeWalt drills and drivers, which keeps the cost down for existing owners, and the brushless motor and short bar make it light and easy to handle. Tool-free chain tensioning, a chain brake and an automatic oiler are included. Its sweet spot is light work: trimming branches off a downed tree, cutting brush, clearing a fence line, or cutting small limbs into firewood kindling. It is not intended for felling or bucking large logs, and pushing it into big wood is slow and hard on the battery. For a DeWalt owner who needs a saw a few times a year for yard work, it is an easy addition.",
    "pros": [
      "Light, compact and easy to control",
      "Runs on common 20V MAX batteries",
      "Tool-free chain tensioning",
      "Brushless motor"
    ],
    "cons": [
      "12-inch bar limits it to small wood",
      "Not for felling or big logs",
      "Runtime depends on battery size"
    ],
    "bottomLine": "A handy limbing and pruning saw for DeWalt battery owners.",
    "amazonUrl": "",
    "id": "dewalt-20v-max-xr-12in"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Chainsaw Picks",
          item: "https://www.allmetalbrake.com/best-chainsaw/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which saw size suits a typical homeowner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For pruning and small limbs, a 12 to 14-inch battery saw is enough. For storm cleanup and occasional firewood, a 16 to 18-inch battery saw or a 40 to 50cc gas saw is the sweet spot. Larger saws with 20-inch bars and up make sense only for big hardwood and experienced users. Buy the smallest saw that handles your typical wood."
          }
        },
        {
          "@type": "Question",
          "name": "Are battery chainsaws strong enough for firewood?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Good 56 to 80-volt battery saws and high-output pro platform saws can cut firewood, especially softer woods and moderate log diameters. The limit is runtime: a large hardwood pile drains batteries quickly, and you will need several batteries and charging time. For several cords a year of hardwood, a 50 to 60cc gas saw remains the more practical tool."
          }
        },
        {
          "@type": "Question",
          "name": "What keeps a saw from kicking back at me?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Keep the upper quarter of the bar tip away from logs, branches and the ground. Hold the saw firmly with both hands, thumbs wrapped, with your left arm straight. Start cuts at full speed, stand to the side of the cutting line, never cut above shoulder height, and keep the chain sharp. Use low-kickback chain and test the chain brake before every use."
          }
        },
        {
          "@type": "Question",
          "name": "Which protective gear is required for running a saw?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At minimum: chainsaw chaps or protective pants meeting a recognized standard such as ASTM F1897, a helmet with a face screen, hearing protection, safety glasses, sturdy gloves and boots with protective toes. Keep a first aid kit that can control serious bleeding, avoid loose clothing, and do not cut alone when you can help it."
          }
        },
        {
          "@type": "Question",
          "name": "When does a saw chain need filing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sharpen whenever the saw starts producing fine dust instead of chips or needs pushing to cut. For many homeowners that means a few file strokes per cutter after every couple of tanks of fuel or battery charges. Any contact with dirt or rocks dulls the chain immediately. Keeping a spare chain lets you swap and sharpen later."
          }
        },
        {
          "@type": "Question",
          "name": "Can I cut down a tree myself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Small trees in open ground can be felled by a homeowner with proper training, gear, a planned notch and back cut, and clear escape routes. Leave any tree that leans toward a building, has dead limbs overhead, is near power lines, is hung in another tree or is larger than your experience to a certified arborist. Mistakes in felling are often severe."
          }
        },
        {
          "@type": "Question",
          "name": "What fuel mix does a chainsaw use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most modern two-stroke chainsaws use a 50 to 1 gasoline and two-stroke oil mix, but always follow the ratio in your owner's manual. Use a quality oil designed for air-cooled two-stroke engines, fresh fuel with stabilizer or ethanol-free premixed fuel, and never use straight gas, which can destroy the engine in minutes."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Yard & Outdoor Tools",
    tags: [
      "best chainsaw",
      "best chainsaw for homeowners",
      "battery chainsaw",
      "gas chainsaw for firewood",
      "chainsaw safety gear",
      "chainsaw bar length"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Chainsaws</span> for Storm Cleanup, Firewood and Pruning
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          The right saw depends on the wood you cut and how often you cut it. These picks run from a 12-inch battery saw for limbing to a 60cc gas saw for a winter of firewood, with the safety basics every owner needs.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#stihl-ms-271-farm-boss"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="15.9k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#gas-or-battery" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Gas or Battery</a>
          <a href="#bar-length" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Bar Length</a>
          <a href="#power" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Engine and Motor Power</a>
          <a href="#safety-features" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Built-In Safety Features</a>
          <a href="#protective-gear" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Protective Gear</a>
          <a href="#kickback" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Avoiding Kickback</a>
          <a href="#felling-and-storms" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Trees and Storm Damage</a>
          <a href="#chain-care" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Chain Care</a>
          <a href="#fuel-and-cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Fuel, Storage and Cost</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          A chainsaw is the most dangerous tool most homeowners will ever own, and also one of the most useful after a storm. Buy the smallest saw that handles your typical wood, not the biggest one in the case. A lighter saw is easier to control, which matters more for safety than raw power. Then buy the protective gear before you pull the cord or squeeze the trigger for the first time.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Best Chainsaws, Ranked by Job
          </h2>

          <p>
            Picks rely on manufacturer specifications such as engine displacement or battery voltage, recommended bar lengths, weight, chain brake and other safety features, and warranty terms, plus the service network behind each brand and recurring patterns in owner feedback. We matched each saw to a realistic homeowner job. None of the rankings rest on cutting tests we did not perform.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-gray-500 text-sm font-bold">{product.rating}</span>
                    <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} ratings on Amazon)</span>
                  </div>
                  )}

                  <p class="text-gray-700 leading-relaxed mb-6">{product.description}</p>

