  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Fuel Transfer Pump",
          item: "https://www.allmetalbrake.com/best-fuel-transfer-pump/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best fuel transfer pump for a home generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most homeowners refueling from five-gallon cans, a battery powered transfer pump like the TERA PUMP TRFA01 is the best choice. It keeps the can on the ground, moves fuel at a controllable rate and avoids the lift-and-pour spills that cause fires. Always shut the generator off and let it cool before refueling outdoors."
          }
        },
        {
          "@type": "Question",
          "name": "Are 12V fuel transfer pumps safe for gasoline?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if the manufacturer specifically approves them for gasoline. Pumps such as the Fill-Rite FR1210G are listed for gasoline, but many cheaper 12V pumps are diesel-only because their motors and seals are not designed for gasoline vapor. Check the exact model's label and manual, and follow its bonding and grounding instructions."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a battery operated transfer pump for diesel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, most battery operated and 12V transfer pumps that handle gasoline also handle diesel, and many pumps are diesel-only. Diesel is less volatile, so a wider range of pumps is suitable. Use a separate pump or flush the hose if you switch between fuels, and fit a filter if you are refueling diesel engines."
          }
        },
        {
          "@type": "Question",
          "name": "How do I avoid static sparks when pumping fuel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Place portable containers on the ground, never in a truck bed or on carpet. Keep the nozzle in contact with the container's opening, fill slowly and do not get back into a vehicle mid-fill. When pumping between metal drums or tanks, bond and ground them as the pump manual describes."
          }
        },
        {
          "@type": "Question",
          "name": "Can I siphon gas from my car into a generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many modern cars have anti-siphon or rollover valves that block a siphon hose, and forcing one in can damage the filler. Never siphon by mouth; swallowing or inhaling gasoline can cause serious lung injury. Keep stabilized fuel in approved cans for outages instead of relying on your car's tank."
          }
        },
        {
          "@type": "Question",
          "name": "What ethanol blends can a fuel transfer pump handle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the pump. Most fuel-equipment makers list compatibility with common blends like E10 and often E15. Higher blends like E85 need a pump specifically rated for them. Check the exact model's specification sheet before pumping anything above E10, since seals and hoses can degrade in incompatible fuels."
          }
        },
        {
          "@type": "Question",
          "name": "How long can I store gasoline for a generator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Untreated gasoline can go stale within a few months, which is a common reason generators fail to start in an outage. Add fuel stabilizer when you fill storage cans, rotate the fuel into a vehicle on a regular schedule, and consider ethanol-free gasoline where available. Check local fire codes on how much fuel you may store."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
