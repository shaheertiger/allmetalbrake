import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Home Generator for Power Outages",
    "url": "/best-home-generator-for-power-outages/"
  },
  {
    "title": "Best Gas Generator",
    "url": "/best-gas-generator/"
  },
  {
    "title": "Best Small Generator for Home",
