                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Type</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Power</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Rated flow</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Fuels (per maker)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fill-Rite FR1210G</td>
                    <td class="px-4 py-4 text-gray-700">12V drum / tank pump</td>
                    <td class="px-4 py-4 text-gray-700">12V DC battery</td>
                    <td class="px-4 py-4 text-gray-700">13 GPM</td>
                    <td class="px-4 py-4 text-gray-700">Gasoline, diesel, kerosene</td>
                    <td class="px-4 py-4 text-gray-700">Drums and transfer tanks</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">GPI M-150S</td>
                    <td class="px-4 py-4 text-gray-700">12V tank pump</td>
                    <td class="px-4 py-4 text-gray-700">12V DC battery</td>
                    <td class="px-4 py-4 text-gray-700">15 GPM</td>
                    <td class="px-4 py-4 text-gray-700">Gasoline and diesel</td>
                    <td class="px-4 py-4 text-gray-700">Pickup transfer tanks</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
