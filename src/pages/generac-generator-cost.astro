---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import TopPick from "../components/TopPick.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Home Generators for Power Outages",
    "url": "/best-home-generator-for-power-outages/"
  },
  {
    "title": "Gasoline Generators for Home Backup",
    "url": "/best-gas-generator/"
  },
  {
    "title": "Small Generators for Home Use",
    "url": "/best-small-generator-for-home/"
  },
  {
    "title": "Portable Power Stations Ranked",
    "url": "/best-portable-power-station/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "Generac Generator Cost: Typically $10,000 to $20,000 Installed";
const description =
  "A Generac standby system usually costs $10,000 to $20,000 installed, and the generator is often a third to half of that; here is each line item on a quote.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Generac Generator Cost",
          item: "https://www.allmetalbrake.com/generac-generator-cost/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How much does a Generac 22kW cost installed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A simple 22kW job on an existing natural gas line usually totals roughly $10,000 to $16,000, and the generator itself accounts for about $5,500 to $6,500 of it. Totals climb with long gas or electrical runs, a new propane tank, panel upgrades, load management modules or a hard site. Collect at least three itemized quotes, since bids for identical work differ widely."
          }
        },
        {
          "@type": "Question",
          "name": "Why does Generac installation cost so much?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Several trades share the job. An electrician installs the transfer switch and wiring, a gas fitter runs the piping and sometimes arranges a meter upgrade, the site is prepared for a pad, and each piece needs permits and inspections. That labor, material and coordination often matches or tops the price of the generator, particularly when the unit sits far from the meter and panel."
          }
        },
        {
          "@type": "Question",
          "name": "What size Generac do I need for my house?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your appliances decide it more than your square footage does. Homes with gas heat and gas appliances often manage with 14 to 18kW for essentials, or 22kW for nearly everything. All-electric homes and houses with several air conditioners may need 24kW or more, or load management. Ask the dealer for a load calculation built from the appliances you actually own."
          }
        },
        {
          "@type": "Question",
          "name": "How much does it cost to run a Generac during an outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "That depends on the fuel and the load. Running near half load, a 22kW burns roughly 2 gallons of propane an hour, which can pass $100 a day of nonstop running at typical propane prices. Natural gas usually costs far less per day. The weekly exercise cycle uses only a few dollars of fuel a month."
          }
        },
        {
          "@type": "Question",
          "name": "How much is annual Generac maintenance?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Expect roughly $200 to $400 a year for a dealer service visit covering oil, filters, spark plugs and a battery and system check, and many dealers sell yearly plans in that range. Budget roughly $50 to $150 for a new starting battery every three to five years, and an extra oil change may be due after a long outage."
          }
        },
        {
          "@type": "Question",
          "name": "Does a Generac generator qualify for a tax credit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not at the federal level, because fuel-burning generators generally fall outside the clean-energy tax credits. Some states, utilities, municipalities and insurers do offer rebates, discounts or medical-need programs for backup power, so ask locally. A medical necessity can affect tax treatment in some cases; get that answer from a tax professional, not from a sales pitch."
          }
        },
        {
          "@type": "Question",
          "name": "Can I install a Generac myself to save money?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In most places that is neither legal nor safe. A standby install means service-entrance electrical work, gas piping, and permits with inspections, and Generac's warranty typically calls for installation by qualified professionals. Doing your own site prep, such as clearing a path or leveling the area, may trim a little. Leave the electrical and gas connections to licensed trades."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "generac generator cost",
      "generac installation cost",
      "whole house generator cost",
      "generac 22kw price",
      "standby generator maintenance cost",
      "generac guardian price"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Outage Generator Picks",
    link: "/best-home-generator-for-power-outages/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Cost Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          Generac Generator Cost
        </h1>
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          A Generac whole-home standby system usually costs $10,000 to $20,000 installed, and the generator is only about a third to a half of that bill. Your fuel source, the distance between unit, gas meter and panel, and the size you choose move the total most. Below: unit prices by size, every installation line item, ownership costs, cheaper options and ways to trim a quote.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          Based on typical installed totals and Generac unit pricing at the time of writing, plus dealer maintenance plan rates. No paid placements. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
