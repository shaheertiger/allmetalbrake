import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import TopPick from "../components/TopPick.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Garage Floor Epoxy",
    "url": "/best-garage-floor-epoxy/"
  },
  {
    "title": "Epoxy Garage Floor Cost",
    "url": "/epoxy-garage-floor-cost/"
  },
  {
    "title": "Best Garage Floor Coating",
    "url": "/best-garage-floor-coating/"
  },
  {
    "title": "Rust-Oleum EpoxyShield Review",
    "url": "/rust-oleum-epoxyshield-review/"
  },
  {
    "title": "Best Garage Floor Tiles",
    "url": "/best-garage-floor-tiles/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "How to Apply Garage Floor Epoxy: A Day-by-Day Plan";
const description =
  "A day-by-day plan for applying garage floor epoxy: slab tests two weeks out, grinding and repairs, mixing and rolling, flakes, topcoat and the cure week.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How to Apply Garage Floor Epoxy",
          item: "https://www.allmetalbrake.com/how-to-apply-garage-floor-epoxy/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How many days does a DIY epoxy garage floor take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plan on at least two days of work, often three: one for emptying, degreasing and grinding, one for repairs and the base coat, and sometimes another for the topcoat. Then add three to seven days of cure before parking. Spreading the work over two weekends is common and sensible. Larger garages take longer."
          }
        },
        {
          "@type": "Question",
          "name": "Can I skip grinding and just use the etch in the kit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only on older, porous concrete that absorbs water quickly. Most garage slabs are smooth and dense, and many have sealers or curing compounds that etching cannot remove. If water beads after etching, you need to grind. Grinding is the most reliable way to get a lasting bond. Rental grinders are widely available."
          }
        },
        {
          "@type": "Question",
          "name": "Is cold or humid weather a problem for epoxy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most kits need a slab temperature of roughly 50 to 90 degrees Fahrenheit and a slab well above the dew point. Cold slows curing and can prevent a full cure; humidity can cause blush or poor adhesion. Check both before mixing. Polyaspartic products tolerate cooler temperatures but cure very fast."
          }
        },
        {
          "@type": "Question",
          "name": "Should I fill the control joints?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a choice. Filling gives a smoother, cleaner look but a crack may reappear along the joint as the slab moves seasonally. Leaving them open avoids that but collects dirt. Many owners fill them with a flexible joint filler for appearance and accept occasional hairline cracks. Either way, decide before coating day."
          }
        },
        {
          "@type": "Question",
          "name": "How do I avoid lap marks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Keep a wet edge by working in small sections and overlapping into still-wet coating. Work with a helper so one person cuts in edges while the other rolls. Do not go back over areas that have started to set. Good lighting helps you see thin spots and missed areas. Plan the layout before you mix."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a topcoat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Over a water-based base coat, a topcoat is strongly recommended because the base is thin. It adds a wear layer, locks in flakes and, with a UV-stable product, prevents yellowing. Over a thick 100% solids base, it is optional but still helps with gloss, traction and stain resistance. Apply it within the label's recoat window."
          }
        },
        {
          "@type": "Question",
          "name": "Can I epoxy over a painted garage floor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if the paint is well bonded and compatible, which is rare with old floor paint. Usually the paint must be ground off. Do a firm tape test in several spots; if paint lifts, remove it. Coating over weak paint bonds the new layer to a surface that is already failing."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
  ],
};
