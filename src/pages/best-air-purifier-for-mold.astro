    "url": "/how-to-waterproof-a-basement/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 6 Best Air Purifiers for Mold: HEPA Picks by Room Size";
const description =
  "Six HEPA air purifiers for mold spores and musty odors, compared on CADR, room size, carbon, and filter cost, plus what a purifier can and cannot fix.";

