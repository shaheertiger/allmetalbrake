const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Air Purifier for Mold",
          item: "https://www.allmetalbrake.com/best-air-purifier-for-mold/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Will a HEPA purifier capture mold spores?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. True HEPA filters capture at least 99.97 percent of particles at 0.3 microns and an even higher share of larger particles, and mold spores are roughly 1 to 30 microns. A sealed HEPA purifier sized for the room will remove most airborne spores that pass through it. It will not remove mold growing on surfaces, so the source still has to be cleaned."
          }
        },
        {
          "@type": "Question",
          "name": "What CADR do I need for a musty room?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aim for a dust or pollen CADR of at least two-thirds of the room's floor area in square feet, which gives several air changes per hour. A 300 square foot bedroom needs about 200, and a 600 square foot basement den needs about 400. For high ceilings or open floor plans, go higher or use two units."
          }
        },
        {
          "@type": "Question",
          "name": "Does an air purifier get rid of mildew odor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if it has enough activated carbon. The smell is made of gases released by mold, and HEPA filters do not catch gases. Units with a heavy carbon bed, like the Austin Air HealthMate Plus, handle persistent odor far better than units with a thin carbon sheet. Removing the moisture and growth stops the smell at its source."
          }
        },
        {
          "@type": "Question",
          "name": "Should an air purifier run all day for mold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, run it continuously. Spore levels rebuild within a couple of hours after a purifier is switched off, especially in a basement with any ongoing growth. Use auto mode or a low setting overnight and higher speeds during the day or during cleanup. The electricity cost of most purifiers on low is small."
          }
        },
        {
          "@type": "Question",
          "name": "Is a dehumidifier or air purifier better for mold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For preventing mold, a dehumidifier is more important because it removes the moisture mold needs to grow. A purifier then catches spores already in the air and helps with allergies. In a damp basement, buy the dehumidifier first. If symptoms persist after humidity stays below about 50 percent, add a purifier."
          }
        },
        {
          "@type": "Question",
          "name": "Do UV-C air purifiers kill mold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A small UV-C lamp inside a purifier has limited effect on mold spores because air passes it too quickly for a lethal dose. Spores trapped on a HEPA filter are already removed from the air. UV-C is not harmful in a sealed, certified unit, but the HEPA filter does the meaningful work, so do not pay extra for the lamp."
          }
        },
        {
          "@type": "Question",
          "name": "Can a purifier replace mold remediation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A purifier lowers airborne spores but does nothing to colonies on walls, wood, or carpet, which keep releasing spores. Clean small areas yourself with the right product and protection. For growth larger than about 10 square feet, contamination in ducts, or mold after sewage or flood water, hire a qualified remediation contractor."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
