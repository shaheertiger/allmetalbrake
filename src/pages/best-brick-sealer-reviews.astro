---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Concrete Sealers",
    "url": "/best-concrete-sealer/"
  },
  {
    "title": "Best Chimney Sealers",
    "url": "/best-chimney-sealer/"
  },
  {
    "title": "Best Penetrating Concrete Sealers",
    "url": "/best-penetrating-concrete-sealer/"
  },
  {
    "title": "Silane vs Siloxane Sealers",
    "url": "/silane-vs-siloxane-sealers/"
  },
  {
    "title": "Best Cinder Block Sealers",
    "url": "/best-cinder-block-sealer-reviews/"
  },
  {
    "title": "Best Grout Sealers",
    "url": "/best-grout-sealer/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "7 Best Brick Sealers in 2026: Breathable Picks for Walls";
const description =
  "Seven brick sealers for walls, patios, chimneys and fireplaces, why breathability decides most of the choice, and when brick is better left unsealed.";

const PRODUCTS = [
  {
    "id": "siloxa-tek-8500",
    "name": "Ghostshield Siloxa-Tek 8500",
    "category": "Silane-Siloxane Repellent, Natural Look",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "Penetrating silane-siloxane blend for brick, block and concrete",
      "Vapor permeable, so walls dry out",
      "No change to color or texture",
      "Rated for exterior vertical and horizontal surfaces",
      "Concentrated formula covers a large area per gallon"
    ],
    "cons": [
      "Pricier than big-box masonry sealers",
      "Needs 24 to 48 hours of dry weather around application"
    ],
    "bottomLine": "The first choice for exterior brick walls, chimneys and retaining walls that need breathable water repellency.",
    "description": "Ghostshield is a concrete and masonry sealer specialist, and Siloxa-Tek 8500 is its penetrating silane-siloxane repellent. Silanes are small molecules that travel deep into dense masonry; siloxanes are larger and work closer to the surface on more porous material. A blend covers both, which suits brick walls where the units and mortar differ in porosity. Once reacted, the treatment causes water to bead and roll off but allows vapor to pass, so moisture trapped in the wall can still evaporate. That breathability is the single most important property for brick in freeze-thaw climates. The look stays natural, with no gloss or darkening once dry. The maker sells it as a ready-to-use formula and states coverage figures on the data sheet that vary with porosity; plan on testing a small area to see how much your brick absorbs. Gallons run roughly $90 to $140 at the time of writing, but they go a long way on dense brick."
  },
  {
    "id": "masonry-defender",
    "name": "Masonry Defender Brick Sealer",
    "category": "Water-Borne Silane-Siloxane",
    "badge": "Best Value",
    "amazonUrl": "",
    "pros": [
      "Breathable penetrating formula",
      "Low odor water-based carrier",
      "Natural, matte appearance",
      "Good price for large wall areas"
    ],
    "cons": [
      "Smaller brand with less retail presence",
      "Coverage drops sharply on very porous old brick"
    ],
    "bottomLine": "A cost-effective breathable sealer for homeowners treating a whole house of brick.",
    "description": "Masonry Defender is a water-based penetrating sealer marketed for brick, block, stucco and stone. It uses silane-siloxane chemistry in a water carrier, which makes it easy to apply with a pump sprayer and much more pleasant to work with than solvent products, especially near windows and doors. Like the best breathable repellents, it leaves the surface looking the same as before, and it allows the wall to release vapor. The appeal is value across large areas: a full brick house can take several gallons, and the cost difference between a premium brand and this one adds up. On very porous antique brick, coverage figures fall well below the label maximum, so buy enough to apply a saturating coat. Wet the wall to the point of slight rundown, as most silane-siloxane labels recommend, and let it dry. Expect roughly $50 to $90 per gallon at the time of writing."
  },
  {
    "id": "foundation-armor-wb25-brick",
    "name": "Foundation Armor SX5000 WB",
    "category": "Water-Based Penetrating Repellent",
    "badge": "Best Water-Based",
    "amazonUrl": "",
    "pros": [
      "Silane-siloxane blend in water carrier",
      "Low odor and easy cleanup",
      "Breathable once cured",
      "Rated for brick, concrete, pavers and block"
    ],
    "cons": [
      "Must stay dry for the cure time on the label",
      "May need two coats on soft brick"
    ],
    "bottomLine": "A reliable water-based choice for brick walls and patios where solvent odor is a concern.",
    "description": "Foundation Armor sells a wide range of concrete and masonry sealers, and the SX5000 WB is its water-based silane-siloxane penetrating repellent. It is designed for brick, concrete, pavers and block, and it targets the same job as the premium solvent and water-based blends: stop water absorption, keep vapor moving, and leave no visible coating. The water-based carrier means low odor and soap-and-water cleanup, which helps when sealing brick near living areas, porches or a home with open windows. The maker positions it for both vertical and horizontal surfaces, so it works on a brick patio as well as a wall. Soft, old or very absorbent brick usually benefits from a second coat applied wet on wet. Avoid application when rain is forecast within the window on the label, typically a day or so. Gallon pricing is commonly about $60 to $100 at the time of writing."
  },
  {
    "id": "ghostshield-wet-look",
    "name": "Ghostshield Siloxa-Tek 8510",
    "category": "Penetrating Repellent with Wet Look",
    "badge": "Best Enhanced Look",
    "amazonUrl": "",
    "pros": [
      "Deepens brick color for a damp, rich look",
      "Still breathable unlike film-forming gloss sealers",
      "Same silane-siloxane base as 8500",
      "Good for faded patio and garden-wall brick"
    ],
    "cons": [
      "Permanently darkens brick; test first",
      "Effect is subtle on dark or glazed brick"
    ],
    "bottomLine": "For brick patios and walls that look faded and could use richer color without a plastic shine.",
    "description": "Siloxa-Tek 8510 is the color-enhancing sibling of Ghostshield 8500. It contains the same penetrating silane-siloxane water repellent but adds an enhancer that darkens the surface slightly, producing a look similar to brick that has just been rained on. That is appealing for patios, steps and garden walls that have faded with years of sun. Because it is still a penetrating product rather than a film, it does not become slippery or peel the way acrylic wet-look sealers can on brick pavers, and it remains vapor permeable. The enhancement is essentially permanent, so try it on a hidden brick or a spare paver and view it dry before treating the whole area. On dark red or glazed brick, the change is often minimal. Pricing is similar to the 8500, roughly $100 to $150 per gallon at the time of writing."
  },
  {
    "id": "thompsons-water-seal",
    "name": "Thompson's WaterSeal Multi-Surface Waterproofer",
    "category": "Big-Box Multi-Surface Repellent",
    "badge": "Most Accessible",
    "amazonUrl": "",
    "pros": [
      "Sold in nearly every hardware and home store",
      "Works on brick, concrete and wood",
      "Inexpensive for small projects",
      "Easy brush, roller or sprayer application"
    ],
    "cons": [
      "Shorter service life than dedicated masonry repellents",
      "Not as deep-penetrating on dense brick"
    ],
    "bottomLine": "Fine for small brick projects and planters; serious walls deserve a dedicated silane-siloxane product.",
    "description": "Thompson's WaterSeal is the brand most homeowners recognize, and its clear multi-surface waterproofer is labeled for brick and concrete as well as wood. It is convenient: you can buy it almost anywhere, it applies with a brush, roller or garden sprayer, and it costs less than the specialist masonry sealers on this list. For small jobs such as a brick planter, a garden edging or a short wall, that convenience counts. Its limitations show on larger and more exposed brickwork. Multi-surface products are formulated to work on wood as well, so they are not optimized for deep penetration into dense masonry, and owners commonly report needing to reapply more often than with a silane-siloxane repellent. For a whole house, a chimney or a retaining wall, a dedicated masonry product will last longer and protect better. A gallon typically costs about $20 to $35 at the time of writing."
  },
  {
    "id": "drylok-masonry-sealer",
    "name": "DRYLOK Natural Look Masonry Sealer",
    "category": "Siloxane Masonry Repellent",
    "badge": "Best for Chimneys",
    "amazonUrl": "",
    "pros": [
      "Siloxane repellent from a well-known masonry brand",
      "Breathable, no change in appearance",
      "Good on chimneys, foundations and walls",
      "Widely available"
    ],
    "cons": [
      "Less depth than silane-rich blends on dense brick",
      "Requires dry weather before and after application"
    ],
    "bottomLine": "A dependable, widely sold breathable repellent, especially handy for chimney brick.",
    "description": "DRYLOK is best known for basement waterproofing paint, but its Natural Look penetrating masonry sealer is a different product: a clear, breathable repellent for above-grade brick, block and stone. Siloxane-based repellents work well on the moderately porous brick found on many houses and chimneys, and this one leaves the surface with no sheen or darkening once it dries. That combination is what you want on a chimney, which takes rain from every side and must also release moisture rising from inside the flue structure. It is easy to find at home centers, which makes it a practical choice when you need to treat a chimney before a wet season and do not want to wait for a specialist order. Apply to clean, dry brick with a brush, roller or low-pressure sprayer, flooding the surface. A gallon is usually around $40 to $60 at the time of writing."
  },
  {
    "id": "seal-krete-clear-seal",
    "name": "Seal-Krete Clear-Seal",
    "category": "Acrylic Film-Former, Satin",
    "badge": "Best Film-Forming",
    "amazonUrl": "",
    "pros": [
      "Adds a satin or gloss sheen and deepens color",
      "Seals dust on interior brick walls and fireplaces",
      "Easy to apply with roller or brush",
      "Inexpensive"
    ],
    "cons": [
      "Not breathable; can trap moisture in exterior brick",
      "Wears and needs stripping or recoating over time",
      "Can make brick pavers slippery when wet"
    ],
    "bottomLine": "Use it on interior brick or covered surfaces where you want a sheen, not on exterior walls in cold climates.",
    "description": "Seal-Krete Clear-Seal is a water-based acrylic that forms a film on the surface rather than soaking in. It adds a satin or glossy look, deepens the color of brick, and binds loose dust, which is why it is popular for interior brick walls, exposed brick in lofts, and the outside face of fireplace surrounds away from the firebox. Those are low-moisture settings where breathability matters less. Outdoors, especially on walls in freeze-thaw climates, a film can trap moisture that enters from behind or from the top of the wall, leading to spalling and peeling. That is why it ranks last for exterior use here despite being a good product for what it does. On patios, film-formers can also become slippery when wet. If you want a sheen indoors, apply thin coats and let each dry fully. A gallon generally costs $30 to $50 at the time of writing."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Brick Sealers",
          item: "https://www.allmetalbrake.com/best-brick-sealer-reviews/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Will a product sold for concrete work on a brick wall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sometimes. Many penetrating silane-siloxane sealers are labeled for concrete, brick, block and pavers, and those work on brick. Film-forming concrete sealers, such as high-gloss acrylics meant for driveways, are a poor choice for exterior brick walls because they limit breathability. Check that the label lists brick and describes the product as vapor permeable before using it on a wall."
          }
        },
        {
          "@type": "Question",
          "name": "What is a realistic reapplication schedule for brick?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "With a quality penetrating repellent, walls often go 5 to 10 years between treatments, according to typical manufacturer claims, while patios and caps need attention sooner. Use the hose test every year or two: if water soaks in and the brick stays dark, it is time. Film-forming sealers need recoating more often, sometimes every one to three years."
          }
        },
        {
          "@type": "Question",
          "name": "Does a clear repellent darken or shine brick?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard penetrating repellents are designed to leave brick looking the same once they dry, though it may look darker for a few hours while wet. Enhancing products like Ghostshield 8510 intentionally darken it, and acrylic films add a sheen and deepen color. Test any product on a hidden area and view it fully dry before sealing a whole wall."
          }
        },
        {
          "@type": "Question",
          "name": "Can a repellent cure white salt deposits on a wall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can reduce future efflorescence by limiting how much water enters the brick, but it does not remove existing deposits and will not stop efflorescence driven by water from behind or below the wall. Clean the deposits, fix gutters, grading and flashing, and seal only once the wall stays dry. Sealing over active salts can damage the brick."
          }
        },
        {
          "@type": "Question",
          "name": "Is it safe to treat brick around a fireplace?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can seal the brick surround and hearth with a product rated for fireplace use, often a film-forming sealer that controls dust and adds a soft sheen. Do not seal the inside of the firebox, which reaches temperatures most sealers are not designed for. Make sure the fireplace has been cold for at least a day before applying anything."
          }
        },
        {
          "@type": "Question",
          "name": "Should historic or soft brick be treated?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Old, soft brick and lime mortar need to breathe more than modern brick. If sealing is necessary, use only a highly breathable penetrating repellent and test it first. Many preservation specialists recommend against sealing historic masonry unless there is a specific water problem that repairs alone cannot solve. A non-breathable film on historic brick can be very damaging."
          }
        },
        {
          "@type": "Question",
          "name": "Is painting brick a good alternative?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can, but paint is a long-term commitment and changes how the wall manages moisture. If you paint, use a breathable masonry paint or mineral silicate paint rather than ordinary exterior latex, and make sure the brick is dry and free of efflorescence. A clear penetrating repellent is less invasive if your goal is only water protection."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Concrete & Masonry Sealers",
    tags: [
      "best brick sealer reviews",
      "brick sealer",
      "silane siloxane brick sealer",
      "sealing brick walls",
      "brick patio sealer",
      "masonry water repellent",
      "efflorescence"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The Best Brick Sealers That Let Masonry Breathe
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          Brick has to shed rain and let vapor out at the same time. The right sealer does both; the wrong one traps water inside the wall and pops the faces off in the first hard freeze.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          We judge every product on its spec sheet, its label and what owners report over time, not on the marketing. No paid placements, and commission never sets a ranking. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">14 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>The 7 Picks</span></a>
              <a href="#should-you-seal" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>Should You Seal?</span></a>
              <a href="#breathability" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Breathability</span></a>
              <a href="#efflorescence" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Efflorescence and Spalling</span></a>
              <a href="#choosing" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>How to Choose</span></a>
              <a href="#prep" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Preparation</span></a>
              <a href="#application" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Application</span></a>
              <a href="#coverage" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>Coverage and Cost</span></a>
              <a href="#maintenance" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>Reapplication</span></a>
              <a href="#patios" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>Patios and Walkways</span></a>
              <a href="#retaining-walls" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>Retaining Walls</span></a>
              <a href="#interior-brick" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">12.</span><span>Interior Brick</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">13.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">14.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Plenty of brick never needs sealing. A well-built wall with sound mortar, good flashing and working gutters can go a century without any treatment. Sealing helps when brick is soaking up rain faster than it dries: soft or old brick, walls with heavy weather exposure, chimneys, retaining walls and patios. In those cases a breathable penetrating repellent, usually a silane-siloxane blend, is the right tool, and a glossy film is almost always the wrong one.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Best Brick Sealers, Ranked
          </h2>

          <p>
            This ranking draws on manufacturer technical data sheets, the substrates and exposures each product is rated for, active-ingredient content where published, warranty terms, and recurring themes in owner feedback. Breathable penetrating repellents rank highest because they suit the most brick in the most climates; film-formers appear only where their look is the goal.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} index={index} />
          ))}
        </div>

        <div id="should-you-seal" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Should You Seal Brick at All?
          </h2>

          <p>
            Brick is fired clay, and good-quality face brick is durable on its own. The weak points in most walls are not the bricks but the mortar joints, flashing, caps and gutters. If a wall is getting wet, the first step is finding out why: overflowing gutters, missing drip edges, failed caulk around windows, or eroded mortar. Sealing a wall with those problems treats the symptom and not the cause.
          </p>

          <p>
            Sealing makes sense when the brick itself absorbs too much water. Signs include brick that stays dark for hours after rain, white efflorescence salts, spalling where faces are popping off, interior damp patches on the inside of solid masonry walls, and moss or algae on shaded faces. Soft historic brick, sand-molded brick and heavily exposed walls are the usual candidates.
          </p>

          <p>
            A simple field test helps. Spray a section of wall with a garden hose for a minute and watch. If the water runs off and the brick lightens again within a few minutes, absorption is modest and sealing is optional. If the brick drinks the water and stays dark for an hour, it is taking on more moisture than is healthy for it, especially before a winter.
          </p>

          <p>
            Before sealing, also check the mortar. Joints recessed more than about a quarter inch, or mortar that crumbles when scraped with a key, need repointing first. Sealer will not hold in failing mortar, and repointing is the repair that actually stops water at the joints.
          </p>
        </div>

        <div id="breathability" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Why Breathability Matters More Than Anything
          </h2>

          <p>
            Water gets into brick walls from many directions: rain on the face, wicking from the ground, condensation inside the wall, and leaks at the top. A healthy wall handles this by drying out, mostly through the face. Vapor-permeable sealers preserve that drying path. Non-breathable films block it.
          </p>

          <p>
            In freeze-thaw climates, trapped water is destructive. When water in the outer layer of brick freezes, it expands by roughly 9 percent, and repeated cycles break off the face of the brick, a failure called spalling. A glossy acrylic or a heavy paint on exterior brick can concentrate moisture just behind the film and make spalling worse.
          </p>

          <p>
            Penetrating silane and siloxane repellents line the pores with a water-repellent layer but do not close them. Liquid water beads and runs off, while vapor still moves outward. The same logic runs through our <a href="/best-concrete-sealer/">concrete sealer guide</a>. For this reason, masonry restoration guidance from organizations such as the Brick Industry Association favors breathable clear repellents over films when a treatment is needed at all.
          </p>

          <p>
            For a deeper explanation of how silanes and siloxanes differ, see our guide on <a href="/silane-vs-siloxane-sealers/">silane vs siloxane sealers</a>. In short, silanes penetrate deepest into dense material, siloxanes work well on more porous surfaces, and blends cover both, which suits brick walls where brick and mortar absorb differently.
          </p>

