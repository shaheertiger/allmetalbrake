---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Concrete Sealers",
    "url": "/best-concrete-sealer/"
  },
  {
    "title": "Best Chimney Sealers",
    "url": "/best-chimney-sealer/"
  },
  {
    "title": "Best Penetrating Concrete Sealers",
    "url": "/best-penetrating-concrete-sealer/"
  },
  {
    "title": "Silane vs Siloxane Sealers",
    "url": "/silane-vs-siloxane-sealers/"
  },
  {
    "title": "Best Cinder Block Sealers",
    "url": "/best-cinder-block-sealer-reviews/"
  },
  {
    "title": "Best Grout Sealers",
    "url": "/best-grout-sealer/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "Best Brick Sealer Reviews (2026): 7 Breathable Picks Ranked";
const description =
  "Ghostshield Siloxa-Tek 8500 is the top brick sealer of 7 picks; a breathable silane-siloxane repellent often lasts 5 to 10 years on walls between coats.";

const PRODUCTS = [
  {
    "id": "siloxa-tek-8500",
    "name": "Ghostshield Siloxa-Tek 8500",
    "category": "Silane-Siloxane Repellent, Natural Look",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "Penetrating silane-siloxane blend for brick, block and concrete",
      "Vapor permeable, so walls dry out",
      "No change to color or texture",
      "Rated for exterior vertical and horizontal surfaces",
      "Concentrated formula covers a large area per gallon"
    ],
    "cons": [
      "Pricier than big-box masonry sealers",
      "Needs 24 to 48 hours of dry weather around application"
    ],
    "bottomLine": "The first choice for exterior brick walls, chimneys and retaining walls that need breathable water repellency.",
    "description": "Siloxa-Tek 8500 is the penetrating silane-siloxane repellent made by Ghostshield, a company that specializes in concrete and masonry sealers. The two halves of the blend do different jobs: silanes are small molecules that reach deep into dense masonry, while the larger siloxanes work nearer the surface of more porous material. A brick wall mixes units and mortar of different porosity, so a blend that handles both is a natural fit. Once it has reacted, rain beads up and rolls off, yet water vapor can still pass, so moisture already trapped in the wall is free to evaporate. For brick in a freeze-thaw climate, that breathability matters more than any other property. When dry, the wall keeps its natural look, with no gloss and no darkening. The maker sells it as a ready-to-use formula and prints coverage figures on the data sheet that shift with porosity, so treat a small area first to learn how thirsty your brick is. Gallons run roughly $90 to $140 at the time of writing, but each one stretches a long way on dense brick."
  },
  {
    "id": "masonry-defender",
    "name": "Masonry Defender Brick Sealer",
    "category": "Water-Borne Silane-Siloxane",
    "badge": "Best Value",
    "amazonUrl": "",
    "pros": [
      "Breathable penetrating formula",
      "Low odor water-based carrier",
      "Natural, matte appearance",
      "Good price for large wall areas"
    ],
    "cons": [
      "Smaller brand with less retail presence",
      "Coverage drops sharply on very porous old brick"
    ],
    "bottomLine": "A cost-effective breathable sealer for homeowners treating a whole house of brick.",
    "description": "Masonry Defender is sold as a water-based penetrating sealer for brick, block, stucco and stone. Its silane-siloxane chemistry rides in a water carrier, so it goes on easily with a pump sprayer and is far more pleasant to use than a solvent product, particularly around windows and doors. Like the better breathable repellents, it leaves the surface looking just as it did and still lets the wall release vapor. Its case is value across big areas: a whole brick house can use several gallons, and the price gap between a premium brand and this one grows with every gallon. Very porous antique brick soaks up far more than the label's best coverage figure, so buy enough for a saturating coat. As most silane-siloxane labels advise, wet the wall until it just begins to run down, then leave it to dry. Expect roughly $50 to $90 per gallon at the time of writing."
  },
  {
    "id": "foundation-armor-wb25-brick",
    "name": "Foundation Armor SX5000 WB",
    "category": "Water-Based Penetrating Repellent",
    "badge": "Best Water-Based",
    "amazonUrl": "",
    "pros": [
      "Silane-siloxane blend in water carrier",
      "Low odor and easy cleanup",
      "Breathable once cured",
      "Rated for brick, concrete, pavers and block"
    ],
    "cons": [
      "Must stay dry for the cure time on the label",
      "May need two coats on soft brick"
    ],
    "bottomLine": "A reliable water-based choice for brick walls and patios where solvent odor is a concern.",
    "description": "The SX5000 WB is the water-based silane-siloxane penetrating repellent in Foundation Armor's broad lineup of concrete and masonry sealers. It is designed for brick, concrete, pavers and block, and it chases the same goals as the premium solvent and water-based blends: stop water soaking in, keep vapor moving, and leave no visible coating behind. The water carrier keeps odor low and lets tools clean up with soap and water, which helps when you are sealing brick next to living areas or porches, or with the windows open. The maker positions it for vertical and horizontal surfaces alike, so a brick patio is as good a target as a wall. Soft, old or very absorbent brick usually does better with a second coat applied wet on wet. Do not apply it if rain is forecast inside the window on the label, which is typically a day or so. Gallon pricing is commonly about $60 to $100 at the time of writing."
  },
  {
    "id": "ghostshield-wet-look",
    "name": "Ghostshield Siloxa-Tek 8510",
    "category": "Penetrating Repellent with Wet Look",
    "badge": "Best Enhanced Look",
    "amazonUrl": "",
    "pros": [
      "Deepens brick color for a damp, rich look",
      "Still breathable unlike film-forming gloss sealers",
      "Same silane-siloxane base as 8500",
      "Good for faded patio and garden-wall brick"
    ],
    "cons": [
      "Permanently darkens brick; test first",
      "Effect is subtle on dark or glazed brick"
    ],
    "bottomLine": "For brick patios and walls that look faded and could use richer color without a plastic shine.",
    "description": "Siloxa-Tek 8510 is the color-enhancing sibling of Ghostshield 8500. It carries the same penetrating silane-siloxane water repellent plus an enhancer that darkens the surface slightly, so the brick looks as if a shower has just passed over it. That look suits patios, steps and garden walls bleached by years of sun. Because it soaks in rather than building a film, it does not turn slippery or peel the way acrylic wet-look sealers can on brick pavers, and the brick stays vapor permeable. The deeper color is essentially permanent, so try it on a hidden brick or a spare paver and judge it dry before treating the whole area. Dark red or glazed brick often shows very little change. It costs about the same as the 8500, roughly $100 to $150 per gallon at the time of writing."
  },
  {
    "id": "thompsons-water-seal",
    "name": "Thompson's WaterSeal Multi-Surface Waterproofer",
    "category": "Big-Box Multi-Surface Repellent",
    "badge": "Most Accessible",
    "amazonUrl": "",
    "pros": [
      "Sold in nearly every hardware and home store",
      "Works on brick, concrete and wood",
      "Inexpensive for small projects",
      "Easy brush, roller or sprayer application"
    ],
    "cons": [
      "Shorter service life than dedicated masonry repellents",
      "Not as deep-penetrating on dense brick"
    ],
    "bottomLine": "Fine for small brick projects and planters; serious walls deserve a dedicated silane-siloxane product.",
    "description": "Thompson's WaterSeal is the name most homeowners already know, and its clear multi-surface waterproofer is labeled for brick and concrete as well as wood. Convenience is the draw: almost every hardware and home store stocks it, a brush, roller or garden sprayer will put it on, and it costs less than the specialist masonry sealers on this list. For a small job such as a brick planter, garden edging or a short wall, that convenience is worth having. Its limits show on larger, more exposed brickwork. A multi-surface product has to work on wood too, so it is not tuned for deep penetration into dense masonry, and owners commonly report reapplying it more often than a silane-siloxane repellent. For a whole house, a chimney or a retaining wall, a dedicated masonry product will last longer and protect better. A gallon typically costs about $20 to $35 at the time of writing."
  },
  {
    "id": "drylok-masonry-sealer",
    "name": "DRYLOK Natural Look Masonry Sealer",
    "category": "Siloxane Masonry Repellent",
    "badge": "Best for Chimneys",
    "amazonUrl": "",
    "pros": [
      "Siloxane repellent from a well-known masonry brand",
      "Breathable, no change in appearance",
      "Good on chimneys, foundations and walls",
      "Widely available"
    ],
    "cons": [
      "Less depth than silane-rich blends on dense brick",
      "Requires dry weather before and after application"
    ],
    "bottomLine": "A dependable, widely sold breathable repellent, especially handy for chimney brick.",
    "description": "DRYLOK's name is tied to basement waterproofing paint, but its Natural Look penetrating masonry sealer is a different product altogether: a clear, breathable repellent for above-grade brick, block and stone. Siloxane repellents perform well on the moderately porous brick found on many houses and chimneys, and this one dries with no sheen and no darkening. That pairing is exactly what a chimney needs, since it takes rain from every side and must also let out moisture rising from inside the flue structure. Home centers carry it widely, which makes it a practical answer when a chimney needs treating before a wet season and a specialist order would take too long. Flood it onto clean, dry brick with a brush, roller or low-pressure sprayer. A gallon usually costs around $40 to $60 at the time of writing."
  },
  {
    "id": "seal-krete-clear-seal",
    "name": "Seal-Krete Clear-Seal",
    "category": "Acrylic Film-Former, Satin",
    "badge": "Best Film-Forming",
    "amazonUrl": "",
    "pros": [
      "Adds a satin or gloss sheen and deepens color",
      "Seals dust on interior brick walls and fireplaces",
      "Easy to apply with roller or brush",
      "Inexpensive"
    ],
    "cons": [
      "Not breathable; can trap moisture in exterior brick",
      "Wears and needs stripping or recoating over time",
      "Can make brick pavers slippery when wet"
    ],
    "bottomLine": "Use it on interior brick or covered surfaces where you want a sheen, not on exterior walls in cold climates.",
    "description": "Seal-Krete Clear-Seal is a water-based acrylic that builds a film on top of the brick instead of soaking in. It adds a satin or glossy finish, deepens the color of the brick and locks down loose dust, which is why people use it on interior brick walls, exposed brick in lofts and the outer face of fireplace surrounds well away from the firebox. Moisture is low in those settings, so breathability counts for less. Outdoors, and especially on walls in freeze-thaw climates, a film can hold in moisture that gets in from behind or through the top of the wall, and spalling and peeling follow. That is why it ranks last for exterior use here, even though it does its own job well. Film-formers can also turn slippery on wet patios. For an indoor sheen, apply thin coats and let each one dry fully. A gallon generally costs $30 to $50 at the time of writing."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Brick Sealers",
          item: "https://www.allmetalbrake.com/best-brick-sealer-reviews/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Will a product sold for concrete work on a brick wall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the type. Penetrating silane-siloxane sealers are often labeled for concrete, brick, block and pavers alike, and those suit brick. Film-forming concrete sealers, such as high-gloss acrylics made for driveways, limit breathability and are a poor match for exterior brick walls. Before putting a concrete product on a wall, confirm the label names brick and calls the product vapor permeable."
          }
        },
        {
          "@type": "Question",
          "name": "What is a realistic reapplication schedule for brick?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Typical manufacturer claims put walls treated with a quality penetrating repellent at 5 to 10 years between coats, with patios and wall caps due sooner. Run the hose test every year or two: when water soaks in and the brick stays dark, it is time to reapply. Film-forming sealers need recoating more often, in some cases every one to three years."
          }
        },
        {
          "@type": "Question",
          "name": "Does a clear repellent darken or shine brick?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A standard penetrating repellent is meant to leave brick looking unchanged once it dries, although the wall can look darker for a few hours while still wet. Enhancing products such as Ghostshield 8510 darken it on purpose, and acrylic films add a sheen and deepen the color. Try any product on a hidden spot and judge it fully dry before sealing the whole wall."
          }
        },
        {
          "@type": "Question",
          "name": "Can a repellent cure white salt deposits on a wall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not on its own. It can cut future efflorescence by limiting how much water gets into the brick, but it leaves existing deposits in place and cannot stop salts driven by water from behind or below the wall. Clean off the deposits, repair gutters, grading and flashing, and seal only once the wall stays dry. Sealing over active salts can damage the brick."
          }
        },
        {
          "@type": "Question",
          "name": "Is it safe to treat brick around a fireplace?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, on the surround and hearth, using a product rated for fireplace use; that is often a film-forming sealer that controls dust and adds a soft sheen. Keep every sealer out of the firebox itself, which reaches temperatures most sealers are not designed to handle. Let the fireplace sit cold for at least a day before you apply anything."
          }
        },
        {
          "@type": "Question",
          "name": "Should historic or soft brick be treated?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only with care. Old, soft brick and lime mortar depend on breathing more than modern brick does, so if sealing is truly needed, use only a highly breathable penetrating repellent and test it first. Many preservation specialists advise against sealing historic masonry unless repairs alone cannot solve a specific water problem. A non-breathable film on historic brick can do serious damage."
          }
        },
        {
          "@type": "Question",
          "name": "Is painting brick a good alternative?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can be, but paint is a long-term commitment that changes how the wall handles moisture. If you go ahead, choose a breathable masonry paint or a mineral silicate paint instead of ordinary exterior latex, and paint only brick that is dry and free of efflorescence. When the only goal is keeping water out, a clear penetrating repellent is the less invasive choice."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Concrete & Masonry Sealers",
    tags: [
      "best brick sealer reviews",
      "brick sealer",
      "silane siloxane brick sealer",
      "sealing brick walls",
      "brick patio sealer",
      "masonry water repellent",
      "efflorescence"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          Best Brick Sealer Reviews
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          Ghostshield Siloxa-Tek 8500 is the best brick sealer for most exterior walls, a breathable silane-siloxane repellent of a type labels rate for 5 to 10 years. Where the brick sits changes the pick: patios, chimneys, tight budgets and interior walls each favor another product. Below: seven ranked picks, whether to seal at all, breathability, efflorescence, prep, application, coverage, cost and upkeep.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          Based on manufacturer technical data sheets, rated substrates, active-ingredient content, warranty terms and owner feedback. No paid placements. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">15 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#short-answer" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>The Short Answer</span></a>
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>The 7 Best Brick Sealers</span></a>
              <a href="#should-you-seal" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>Should You Seal Brick?</span></a>
              <a href="#breathability" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Why Breathability Matters</span></a>
              <a href="#efflorescence" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>Efflorescence and Spalling</span></a>
              <a href="#choosing" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Which Sealer Where</span></a>
              <a href="#prep" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>How to Prep Brick</span></a>
              <a href="#application" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>How to Apply It</span></a>
              <a href="#coverage" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>How Much You Need</span></a>
              <a href="#maintenance" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>How Long It Lasts</span></a>
              <a href="#patios" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>Patios and Walkways</span></a>
              <a href="#retaining-walls" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">12.</span><span>Retaining Walls</span></a>
              <a href="#interior-brick" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">13.</span><span>Interior Brick</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">14.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">15.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most brick never needs a sealer. A well-built wall with sound mortar, good flashing and gutters that work can stand for a century untreated. Sealing earns its place when brick takes on rain faster than it can dry it out: soft or old brick, walls that face the weather, chimneys, retaining walls and patios. For those jobs the right tool is a breathable penetrating repellent, usually a silane-siloxane blend. A glossy film is almost never the answer outdoors.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Best Brick Sealer: The Short Answer
