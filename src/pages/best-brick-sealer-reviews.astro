---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/best-brick-sealer-reviews.html?raw';

const title = "Best Brick Sealers — 9 Tested Over Two Years | Home Fix Reviews";
const description = "More brick is ruined by the wrong sealer than by weather. Nine tested on walls, chimneys and interior brick, and why breathability decides everything.";
