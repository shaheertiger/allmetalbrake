---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Ceiling Paint",
    "url": "/best-ceiling-paint/"
  },
  {
    "title": "Best Porch Paint",
    "url": "/best-porch-paint/"
  },
  {
    "title": "Best Concrete Floor Paint",
    "url": "/best-concrete-floor-paint/"
  },
  {
    "title": "Best Fence Stain",
    "url": "/best-fence-stain/"
  },
  {
    "title": "Best Deck Stain",
    "url": "/best-deck-stain-reviews/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "The 7 Best Paint Sprayers: Airless, HVLP and Cordless Picks";
const description =
  "Seven paint sprayers matched to real jobs, from whole-house airless rigs to small HVLP units, plus the tip, thinning, masking and safety rules that matter.";

const PRODUCTS = [
  {
    "category": "Stand-mounted airless sprayer",
    "name": "Graco Magnum X7 Airless Paint Sprayer",
    "badge": "Best Overall",
    "amazonUrl": "",
    "id": "graco-magnum-x7",
    "pros": [
      "Sprays unthinned latex for walls, ceilings and exteriors",
      "Draws paint directly from a 1- or 5-gallon bucket",
      "Supports long hose runs for whole-house exteriors",
      "Adjustable pressure for different materials",
      "Rebuildable piston pump"
    ],
    "cons": [
      "Overkill for small furniture or single rooms",
      "Significant overspray requires thorough masking",
      "Cleanup takes time"
    ],
    "bottomLine": "The best all-round choice for homeowners painting exteriors, fences, decks and full interiors.",
    "description": "The Magnum X7 is Graco's step-up homeowner airless sprayer and the sprayer we would suggest for most people with large projects. It uses a piston pump to push paint at high pressure through a small tip, atomizing it into a fan that covers walls, siding and fences far faster than rolling. It draws directly from a 1- or 5-gallon bucket through a suction tube, so there is no small cup to refill, and Graco lists it as capable of spraying unthinned latex as well as stains and primers. Pressure is adjustable, and it supports longer hose runs than entry-level airless units, which helps on two-story exteriors. The pump is designed to be serviced rather than replaced. The main trade-offs are overspray, which means careful masking, and cleanup, which takes time after each use. For single rooms or small pieces it is overkill, but for exteriors, fences, decks and whole-house interiors it is a strong, well-supported choice."
  },
  {
    "category": "Handheld airless sprayer",
    "name": "Graco TrueCoat 360 DS Paint Sprayer",
    "badge": "Best Handheld Airless",
    "amazonUrl": "",
    "id": "graco-truecoat-360",
    "pros": [
      "Airless atomization in a handheld unit, no hose to manage",
      "Can spray in any direction, including straight up",
      "Good for trim, doors, small rooms and furniture",
      "Quick setup and simpler cleanup than full airless rigs"
    ],
    "cons": [
      "Small cup needs frequent refills",
      "Heavier in the hand than it looks when full"
    ],
    "bottomLine": "The best choice for trim, doors, small rooms and furniture when you want airless quality without a hose.",
    "description": "The TrueCoat 360 DS packs airless spraying into a handheld unit with an onboard paint cup, so there is no hose, bucket or separate pump to set up. That makes it ideal for small and medium jobs: doors, trim, a bathroom, a set of shelves or a piece of furniture. Graco designed it to spray in any direction, including upward for ceilings and overhead trim, which many cup-fed sprayers cannot do well. It uses airless tips, so the finish quality is close to that of larger airless units, and it can handle many latex paints without heavy thinning, depending on the paint and tip. The trade-offs come with size: the cup holds a limited amount of paint and needs refilling often, and when full it gets heavy over a long session. Cleanup is simpler than a full airless sprayer, but it still requires thorough flushing. For people who paint in small batches, it is an excellent and versatile tool."
  },
  {
    "category": "HVLP turbine sprayer",
    "name": "Wagner FLEXiO 5000 HVLP Paint Sprayer",
    "badge": "Best HVLP",
    "amazonUrl": "",
    "id": "wagner-flexio-5000",
    "pros": [
      "Interchangeable nozzles for walls and fine detail work",
      "Lower overspray than airless sprayers",
      "Adjustable air and material flow",
      "Easier setup and cleanup than airless",
      "Good for furniture, cabinets and small rooms"
    ],
    "cons": [
      "Slower than airless on large surfaces",
      "Thick latex usually needs thinning"
    ],
    "bottomLine": "A versatile HVLP for furniture, cabinets, trim and small rooms where control matters more than speed.",
    "description": "The Wagner FLEXiO 5000 is a high-volume, low-pressure sprayer that relies on a turbine that moves lots of gently pressurized air to break the paint into droplets. That approach produces less overspray and a softer spray pattern than airless sprayers, making it easier to control on furniture, cabinets, doors, trim and smaller rooms. Wagner supplies interchangeable nozzles: a wider nozzle for walls and larger surfaces, and a detail nozzle for finer work. Air and material flow are adjustable, so you can dial in the pattern for different coatings. Setup and cleanup are quicker than with airless units. The trade-off is speed. On a fence or whole-house exterior, an HVLP is much slower than an airless sprayer. Thicker latex paints often need thinning to spray well, so a viscosity cup and some trial runs on cardboard are part of the process. For detail work and medium projects, owners commonly cite its control and versatility."
  },
  {
    "category": "Low-pressure airless sprayer",
    "name": "Wagner Control Pro 130 Power Tank Paint Sprayer",
    "badge": "Best Beginner Airless",
    "amazonUrl": "",
    "id": "wagner-control-pro-130",
    "pros": [
      "Lower-pressure airless design that Wagner says reduces overspray",
      "Includes a 1.5-gallon paint tank",
      "Softer spray pattern is easier to control",
      "Sprays unthinned latex for many uses",
      "Good for fences, sheds and interior walls"
    ],
    "cons": [
      "Lower pressure limits thicker coatings and larger tips",
      "Not as fast as full-size piston airless sprayers"
    ],
    "bottomLine": "A friendlier airless sprayer for first-timers who want speed with less overspray.",
    "description": "Wagner's Control Pro 130 uses what Wagner calls high-efficiency airless technology, spraying at lower pressure than conventional airless units. Wagner says that reduces overspray and produces a softer spray pattern, which makes it more forgiving for beginners. It draws from an included 1.5-gallon tank, reducing the need to refill compared with cup sprayers, and Wagner lists it as able to spray unthinned latex for many projects. It suits fences, sheds, interior walls and ceilings, and medium-sized exterior projects. The lower pressure has limits. It is not as fast as a full-size piston airless sprayer and is less suited to very thick coatings or long hose runs. For a homeowner taking on a first sprayer project, the reduced overspray and easier control can be worth more than raw speed. Owner feedback commonly praises its ease of use and lower mess compared with high-pressure airless sprayers, with some noting its limits on larger exterior projects."
  },
  {
    "category": "Budget HVLP sprayer",
    "name": "Wagner Control Spray Max HVLP Sprayer",
    "badge": "Best Budget HVLP",
    "amazonUrl": "",
    "id": "wagner-spraytech-control-spray",
    "pros": [
      "Affordable HVLP for stains, sealers and thinned paints",
      "Adjustable spray pattern and flow",
      "Low overspray compared with airless",
      "Good for fences, decks, furniture and small projects"
    ],
    "cons": [
      "Thick latex requires thinning",
      "Slower than airless sprayers on large areas",
      "Turbine is louder than you might expect"
    ],
    "bottomLine": "A low-cost way to spray stains, sealers and thinned paints on fences, decks and furniture.",
    "description": "The Control Spray Max is Wagner's budget HVLP option, and it is especially good with thinner materials: stains, sealers, varnishes and thinned latex. For fences, decks, outdoor furniture and smaller projects, it provides controlled, low-overspray coverage at a modest price. The spray pattern and flow are adjustable, so it can switch between horizontal, vertical and round patterns for different surfaces. As with most HVLP sprayers, thick latex paint needs thinning to atomize properly, and it is slower than airless sprayers on large areas. The turbine is also fairly loud. It is a strong choice for people who mainly spray stains and sealers. If you are planning a fence or deck project, our guides to the best fence stain and best deck stain cover which coatings suit those surfaces. Owner feedback generally praises value and control with thin materials, with the familiar caution that thick paints need patience and thinning."
  },
  {
    "category": "Compact handheld HVLP",
    "name": "HomeRight Finish Max HVLP Paint Sprayer",
    "badge": "Best for Small Furniture",
    "amazonUrl": "",
    "id": "homeright-finish-max",
    "pros": [
      "Very affordable and simple to use",
      "Lightweight handheld design",
      "Good for small furniture, crafts and cabinets",
      "Quick cleanup"
    ],
    "cons": [
      "Small cup and slow output limit it to small projects",
      "Most latex paints need thinning",
      "Not suited to walls or exteriors"
    ],
    "bottomLine": "An inexpensive starter sprayer for small furniture and craft projects, not for rooms or exteriors.",
    "description": "HomeRight's Finish Max is a compact, inexpensive HVLP sprayer aimed at furniture refinishing, crafts and small projects. It is lightweight, simple to set up and quick to clean, which makes it appealing for someone painting a dresser, a few chairs, shelves or a small set of cabinet doors. Like other small HVLP units, it works best with thinner materials, and most latex paints need thinning to spray smoothly, so expect some experimentation. The small cup and modest output mean it is not practical for walls, ceilings or exteriors; trying to paint a room with it would take longer than rolling. For its intended use, though, it gives smoother results than brushing on flat surfaces, without the cost or setup of larger sprayers. HomeRight also sells accessories such as a spray shelter tent to contain overspray indoors. Owner feedback is generally positive for small projects, with complaints usually coming from people who attempted larger jobs than it is designed for."
  },
  {
    "category": "Cordless handheld airless sprayer",
    "name": "Graco Ultra Cordless Airless Handheld Paint Sprayer",
    "badge": "Best Cordless",
    "amazonUrl": "",
    "id": "graco-ultra-cordless",
    "pros": [
      "Cordless airless spraying with no hose or cord",
      "Professional-grade finish for trim, doors and touch-ups",
      "Runs on common power tool batteries",
      "Sprays in any direction",
      "Fast setup for small jobs"
    ],
    "cons": [
      "Expensive for a handheld",
      "Small cup and battery life limit continuous spraying"
    ],
    "bottomLine": "A premium cordless sprayer for pros and serious DIYers who do lots of trim, doors and touch-ups.",
    "description": "Graco's Ultra Cordless is a handheld airless sprayer that runs on power tool batteries, with versions built around DeWalt's 20V MAX platform, so there is no cord, hose or separate pump. It uses airless tips and delivers a finish close to that of a full-size airless sprayer, which makes it popular with painters for trim, doors, cabinets, railings and touch-ups. Being cordless, it is easy to carry from room to room or around a job site, and it can spray in any direction. The trade-offs are cost and capacity. It is considerably more expensive than corded handheld sprayers, the cup holds a limited amount of paint, and battery life limits long continuous sessions, so spare batteries help. For a homeowner with a single project, a corded handheld sprayer offers better value. For someone who paints often and values speed and convenience, it is an excellent tool. Owner feedback commonly highlights finish quality and convenience, with price as the main complaint."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Paint Sprayers",
          item: "https://www.allmetalbrake.com/best-paint-sprayer/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which type of paint sprayer suits a first-time buyer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the projects. For house exteriors, fences and large rooms, an airless sprayer like the Graco Magnum X7 is the most useful. For cabinets and furniture, an HVLP sprayer gives more control and less overspray. For trim, doors and small rooms, a handheld airless sprayer offers convenience without hoses or buckets."
          }
        },
        {
          "@type": "Question",
          "name": "Does paint need thinning before it goes through a sprayer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Airless sprayers usually spray latex without thinning, though some thick paints benefit from a small amount. HVLP sprayers often need thinner material, so use the viscosity cup and the sprayer manual's guidance. Never thin beyond the paint manufacturer's recommendation, and always strain paint before spraying to prevent clogs."
          }
        },
        {
          "@type": "Question",
          "name": "How much more paint does spraying use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Spraying usually uses more paint than rolling because of overspray, often an extra 20 to 30 percent or more outdoors, depending on wind, technique and sprayer type. HVLP sprayers generally waste less than airless sprayers. Using the correct tip size and lowest effective pressure helps reduce waste."
          }
        },
        {
          "@type": "Question",
          "name": "Can a paint sprayer handle a ceiling?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Airless sprayers and some handheld airless sprayers can spray ceilings efficiently, especially in empty rooms or new construction. Use a ceiling paint suitable for spraying, mask walls and floors thoroughly, and wear eye protection. Many painters back-roll after spraying for a more uniform finish on drywall."
          }
        },
        {
          "@type": "Question",
          "name": "Are airless paint sprayers dangerous?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They can be. The high-pressure stream can inject paint through skin, which is a medical emergency even if the wound looks small. Never point the gun at anyone, keep the tip guard in place, use the trigger lock, and relieve pressure before cleaning or changing tips. Wear eye protection and a respirator suited to the material."
          }
        },
        {
          "@type": "Question",
          "name": "How long does cleaning a sprayer take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Expect roughly 20 to 45 minutes for a full airless sprayer and less for handheld and HVLP units. Clean immediately after use, flushing with water for latex or the specified solvent for oil-based materials, and clean the tip and filters. Follow the manufacturer's storage instructions to keep the pump and seals in good condition."
          }
        },
        {
          "@type": "Question",
          "name": "Should I rent or buy a paint sprayer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rent if you have a single large project, such as a house exterior, and do not expect to spray again soon. Buy if you have recurring projects such as fences, decks, rooms and cabinets, or if you want a smaller HVLP or handheld unit for detail work. Rental airless units are often larger and more powerful than homeowner models."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Paint & Floor Coatings",
    tags: [
      "best paint sprayer",
      "airless paint sprayer",
      "hvlp paint sprayer",
      "paint sprayer for house",
      "sprayer tip size",
      "cordless paint sprayer"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The 7 Best <span class="text-[#38BDF8]">Paint Sprayers</span> for Every Size of Job
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          A sprayer can turn a week of brushing into an afternoon, or wreck a car under a cloud of overspray. The right type for the job decides which.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#graco-magnum-x7"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare All Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="12.8k" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. Top Picks</a>
          <a href="#types" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Sprayer Types</a>
          <a href="#match-job" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Match the Job</a>
          <a href="#tips" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Tips and Pressure</a>
          <a href="#thinning" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Thinning and Viscosity</a>
          <a href="#masking-safety" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Masking and Safety</a>
          <a href="#technique" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Spray Technique</a>
          <a href="#cleanup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Cleanup and Storage</a>
          <a href="#worth-it" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Is It Worth It?</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Paint sprayers are sold as time savers, and on the right job they are: a fence, a house exterior, a room full of trim or a set of kitchen cabinets can go from days to hours. On the wrong job, they cost more time than they save, because masking and cleanup take longer than painting. Most disappointing sprayer purchases come from buying the wrong type, not a bad model. This guide matches seven sprayers to the jobs they do best, then covers the tips, thinning, masking and safety rules that decide whether the finish looks professional.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The 7 Best Paint Sprayers, Ranked
          </h2>

          <p>
            We ranked these sprayers using manufacturer specifications such as pump type, maximum tip size, pressure, hose length and power source, along with the materials each manufacturer says the unit can spray, warranty terms, and consistent patterns in owner feedback. We have not run our own spray or durability tests on them. Where a point comes from a spec sheet or owner reports, we say so.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-gray-500 text-sm font-bold">{product.rating}</span>
                    <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} ratings on Amazon)</span>
                  </div>
                  )}

