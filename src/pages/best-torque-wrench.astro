    "pros": [
      "Very low price for a wrench with a stated accuracy rating",
      "10-150 ft-lb range suits car wheels and brakes",
      "Includes case, extension and certificate"
    ],
    "cons": [
      "Softer click is easier to miss",
      "More mixed reports on long-term consistency",
      "Scale markings harder to read"
    ],
    "bottomLine": "Fine for occasional lug-nut duty on a tight budget; step up if you will use it often.",
    "amazonUrl": ""
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Torque Wrench Picks",
          item: "https://www.allmetalbrake.com/best-torque-wrench/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which torque wrench size suits lug nuts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most cars and small SUVs, a half-inch drive wrench covering roughly 10 to 150 foot-pounds is right, since wheel specs usually fall between about 76 and 100 foot-pounds. Full-size pickups and vans often specify 140 foot-pounds or more, so owners of those vehicles should buy a wrench that reaches 200 or 250. Check the owner's manual for your exact specification before buying."
          }
        },
        {
          "@type": "Question",
          "name": "Do I really need to wind a torque wrench down after use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a click wrench, yes. Its internal spring loses accuracy if left compressed for long periods. Turn the setting to the lowest value marked on the scale before putting it away, but not past it. Split beam, beam and digital wrenches do not use a loaded spring at rest, so they can be stored at any setting without harm."
          }
        },
        {
          "@type": "Question",
          "name": "How often does a torque wrench need recalibrating?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The common guidance, based on ISO 6789, is every 12 months or 5,000 cycles, whichever comes first, and right away after a drop or overload. Light home use rarely hits the cycle count, so many owners check every one or two years. Tool stores and calibration labs offer testing for a modest fee, and some makers recalibrate their own wrenches."
          }
        },
        {
          "@type": "Question",
          "name": "Are digital torque wrenches worth paying extra for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is worth it if you need angle measurement for torque-to-yield fasteners, if you have trouble hearing or feeling a click, or if you want a peak reading to check existing fasteners. For lug nuts, brakes and routine maintenance, a good click wrench is accurate enough, costs far less, and never fails because of a dead battery."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use an extension with a torque wrench?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Extensions that run straight out from the drive square leave the applied torque unchanged, so use whatever length you need and support it to keep the pull square. Adapters that lengthen the wrench, such as an inline crowfoot, do change it and require a correction. Turning a crowfoot 90 degrees to the handle avoids the calculation."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my torque wrench click in reverse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many click wrenches will ratchet and even break over when turned counterclockwise, but most are only calibrated clockwise. Unless the manufacturer lists a counterclockwise accuracy rating, do not trust it for left-hand threads. Never use the reverse direction to loosen fasteners, since that can overload the mechanism. Beam and most digital wrenches read in both directions."
          }
        },
        {
          "@type": "Question",
          "name": "Should I torque wheels with the car on the ground?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Snug the lug nuts by hand while the car is raised, then lower it so the tire carries weight and the wheel cannot spin, and do the final torque in a star pattern. Many shops make two passes. Recheck the torque after 50 to 100 miles, particularly with alloy wheels or after new wheels or studs are installed."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
