---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Portable Power Stations",
    "url": "/best-portable-power-station/"
  },
  {
    "title": "Best Power Stations for Home Backup",
    "url": "/best-portable-power-station-for-home-backup/"
  },
  {
    "title": "Best Solar Generators",
    "url": "/best-solar-generator/"
  },
  {
    "title": "EcoFlow vs. Jackery",
    "url": "/ecoflow-vs-jackery/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-03", modified: "2026-11-03" });
const title = "The Best Portable Chargers for Power Outages: Power Banks to Stations";
const description =
  "Six portable chargers for power outages, from pocket power banks to 1kWh stations, with mAh-to-Wh math, real phone-charge counts and USB-C wattage explained.";

const PRODUCTS = [
  {
    "id": "anker-737-power-bank",
    "name": "Anker 737 PowerCore 24K Power Bank",
    "category": "24,000mAh (~86-89Wh), 140W USB-C",
    "badge": "Best Laptop Power Bank",
    "amazonUrl": "",
    "pros": [
      "24,000mAh, three to four phone charges in one pack",
      "Up to 140W over USB-C, enough for most laptops",
      "Display shows remaining charge, so you know what is left",
      "Under the 100Wh airline limit"
    ],
    "cons": [
      "Heavy and bulky for a pocket",
      "The 140W figure needs a compatible device and cable",
      "No AC outlet for non-USB devices"
    ],
    "bottomLine": "The best single power bank for an outage drawer: phone charges for a family member for days, plus real laptop support.",
    "description": "The Anker 737, sold as the PowerCore 24K, is the power bank we would put in a drawer for outages if we could only have one. Anker rates it at 24,000mAh, which works out to somewhere around 86-89 watt-hours, about as large as a power bank can be while staying under the 100Wh limit airlines allow without approval. In practical terms that is three to four full charges for a typical smartphone, or a meaningful top-up for a laptop. What sets it apart from cheaper 20,000mAh banks is output: Anker lists USB-C Power Delivery up to 140W, so it can charge a large laptop at close to full speed instead of trickling, and it refills itself quickly when power briefly comes back, which matters in a rolling outage. The built-in display showing remaining charge removes the guesswork of four blinking dots. The trade-off is heft; it is a dense brick, not something you forget is in your pocket."
  },
  {
    "id": "anker-powercore-10000",
    "name": "Anker PowerCore 10000 Power Bank",
    "category": "10,000mAh (~36-37Wh), USB-A, Pocket Size",
    "badge": "Best Pocket Power Bank",
    "amazonUrl": "",
    "pros": [
      "Small and light enough to live in a pocket or glovebox",
      "About two phone charges",
      "Inexpensive enough to buy one per person",
      "Long track record and widely available"
    ],
    "cons": [
      "Will not charge a laptop",
      "Classic version charges over USB-A at standard speed",
      "Capacity runs out quickly in a long outage"
    ],
    "bottomLine": "A cheap, proven pocket bank: buy one for each person in the household and keep them charged.",
    "description": "Not every charger has to be the biggest. The PowerCore 10000 has been one of the best-known small power banks for years because it does one thing simply: it carries roughly 36-37 watt-hours in a package about the size of a deck of cards, enough to refill a typical phone once and get well into a second charge. That is the right amount for a school bag, a car glovebox or the nightstand of someone who does not want to share the big bank. In an outage, several small banks often beat one large one, because a single shared pack becomes a bottleneck, and at this size you can afford one per person. Know its limits: it is a phone charger, not a laptop charger, and the classic model charges over USB-A at ordinary speed. Anker sells several variants under similar names, some with USB-C, so read the listing for the ports you want."
  },
  {
    "id": "anker-solix-c300x",
    "name": "Anker SOLIX C300X Portable Power Station",
    "category": "288Wh LFP, 300W AC, Multi-Port USB-C",
    "badge": "Best Outage Charging Hub",
    "amazonUrl": "",
    "pros": [
      "288Wh is roughly three times the largest airline-legal power bank",
      "Several USB-C ports charge phones and laptops at once",
      "AC outlets for a lamp, router or radio",
      "Long-life LFP cells at about 9 pounds"
    ],
    "cons": [
      "300W AC limit rules out appliances",
      "Too large to fly with",
      "Not expandable"
    ],
    "bottomLine": "The best value step up from power banks: a whole household's phones, laptops and router through a one- to two-day outage.",
    "description": "The SOLIX C300X sits right where a power bank turns into a power station, and for outage charging that is the sweet spot. Anker rates its LFP battery at 288 watt-hours, about as much as three of the biggest power banks you can buy, and because it charges USB devices from its DC side rather than through an inverter, most of that energy reaches your phones: roughly 15-17 phone charges by our planning math, or several full laptop charges. At about 9 pounds it sits on a kitchen counter as the family charging station, with enough ports that nobody has to take turns. The AC outlets are the bonus. A Wi-Fi router and modem draw around 15-25 watts together, so it can keep home internet up for much of a day while also charging phones, or run an LED lamp or small fan. It will not run anything with a heating element or a compressor; 300 watts is a firm ceiling."
  },
  {
    "id": "ecoflow-river-3-plus",
    "name": "EcoFlow River 3 Plus Portable Power Station",
    "category": "286Wh LFP, 600W AC, Expandable",
    "badge": "Best Small Power Station",
    "amazonUrl": "",
    "pros": [
      "600W inverter handles a CPAP, fan or small cooler",
      "Works as a UPS for a router or desktop",
      "Optional add-on battery extends capacity",
      "About 10 pounds with LFP cells"
    ],
    "cons": [
      "Costs more than the C300X for similar capacity",
      "Still too small to run a fridge for long",
      "Limited solar input"
    ],
    "bottomLine": "Choose it over the C300X if you need to run a CPAP, a fan or a home-office UPS, not just charge devices.",
    "description": "The River 3 Plus holds almost exactly the same energy as the Anker C300X, with EcoFlow listing 286 watt-hours of LFP storage, so for pure phone charging the two are nearly interchangeable. The reason to pay a little more is the inverter. EcoFlow rates it at 600 watts, which comfortably covers a CPAP machine without its heated humidifier, a box fan in summer heat, a small cooler, or a TV and streaming box for an evening, all things that push or exceed a 300W unit. It also works as an uninterruptible power supply: leave it plugged into the wall with the router, modem or a desktop plugged into it, and when the grid drops it takes over fast enough that the internet stays up. That turns a box that would otherwise sit in a closet into something useful every day. If one evening of capacity is not enough, EcoFlow's snap-on extra battery roughly triples it, a cheaper path than buying a second unit."
  },
  {
    "id": "jackery-explorer-1000-v2",
    "name": "Jackery Explorer 1000 v2 Portable Power Station",
    "category": "1,070Wh LFP, 1,500W (3,000W Surge)",
    "badge": "Best for Charging Plus a Fridge",
    "amazonUrl": "",
    "pros": [
      "1,070Wh: dozens of phone charges plus appliance power",
      "1,500W with 3,000W surge starts a refrigerator",
      "Light for its size at about 24 pounds",
      "Simple to use, LFP chemistry"
    ],
    "cons": [
      "Far more than you need for phones alone",
      "Not expandable",
      "A real lift compared with a power bank"
    ],
    "bottomLine": "The jump from charging to backup: phones, laptops, router and a fridge through a short outage, in a box one person can carry.",
    "description": "Once you want to keep the refrigerator cold as well as the phones charged, you have left the portable charger category and need a 1kWh class power station. The Explorer 1000 v2 is the lightest common way in. Jackery lists 1,070 watt-hours of LFP storage, which could in theory charge a phone more than 50 times, but its real value is the 1,500W inverter and 3,000W surge rating, which can start a fridge compressor and keep it running. Run the numbers with the usual rule of thumb, watt-hours times 0.85 divided by the load, and a fridge averaging 65 watts gets roughly 14 hours, while a 20W router alone would run for about 45. In a real outage you split the battery: the fridge for a few hours at a time, the router all evening, the phones whenever they need it. At about 24 pounds it is carryable, simple to use and frequently discounted."
  },
  {
    "id": "ecoflow-delta-3-plus",
    "name": "EcoFlow Delta 3 Plus Portable Power Station",
    "category": "1,024Wh LFP, 1,800W, Expandable",
    "badge": "Best Expandable Upgrade",
    "amazonUrl": "",
    "pros": [
      "1,800W output covers a fridge, microwave or coffee maker",
      "Expandable with add-on batteries",
      "Fast UPS switchover for home offices",
      "Accepts solar for multi-day outages"
    ],
    "cons": [
      "Around 28 pounds",
      "App needed for some settings",
      "Overkill if charging is the only goal"
    ],
    "bottomLine": "Buy it if you want one battery that handles charging today and grows into real home backup later.",
    "description": "The Delta 3 Plus is the pick for households that suspect they will outgrow a charging setup. EcoFlow rates it at 1,024 watt-hours, a near match for the Jackery, but its 1,800W inverter adds headroom for a microwave or coffee maker alongside the fridge, and it accepts EcoFlow's add-on batteries, so you can start at 1kWh and add capacity later rather than buying a second box. In an outage charging plan it plays the role of the central battery: everyone's phones and laptops, the router in UPS mode, lights and a fridge. EcoFlow quotes a wall recharge in about an hour when power briefly returns, and it takes solar panels if the grid stays down. The costs are weight, at around 28 pounds, an app for some of the deeper settings, and the simple fact that it is far more battery than you need if charging phones is the only goal."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Portable Chargers for Power Outages",
          item: "https://www.allmetalbrake.com/best-portable-chargers-for-power-outages/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best portable charger for a power outage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most households, a 20,000 to 25,000 mAh USB-C power bank such as the Anker 737 PowerCore 24K is the best single charger. It stores roughly 86 to 89 Wh, enough for three to four phone charges or most of a laptop charge. If several people need to stay connected for more than a day, or you want the Wi-Fi router running, a 300 Wh station such as the Anker SOLIX C300X is better value per charge."
          }
        },
        {
          "@type": "Question",
          "name": "How many times will a 20,000 mAh power bank charge a phone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually about three times, not four or five. At the cells' 3.6 to 3.7 volts, 20,000 mAh is about 72 to 74 Wh. Power banks typically deliver 60 to 70 percent of that after conversion and heat losses, so roughly 44 to 52 Wh arrives. A typical phone battery holds around 15 Wh, so that is about three full charges; a compact phone may get closer to four."
          }
        },
        {
          "@type": "Question",
          "name": "How do I convert mAh to watt-hours?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Multiply the mAh figure by the battery voltage and divide by 1,000. Power bank cells are nominally 3.6 to 3.7 volts, so a 10,000 mAh bank holds about 36 to 37 Wh and a 27,000 mAh bank sits right around the 100 Wh airline limit. Many banks print the Wh figure on the case for airline purposes; when it is there, use it instead of calculating."
          }
        },
        {
          "@type": "Question",
          "name": "Is a power bank or a power station better for outages?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They do different jobs. A power bank is small, cheap and portable, the right tool for keeping one or two phones alive through a short outage or in a go-bag. A power station holds far more energy and adds AC outlets, so it can charge a family's devices for days and run a router, lamp, fan or CPAP. Most well-prepared households own both: pocket banks per person and one station as the hub."
          }
        },
        {
          "@type": "Question",
          "name": "Can a power bank charge a laptop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if it has a USB-C Power Delivery port with enough wattage and your laptop charges over USB-C. Thin laptops typically need 45 to 65 watts, most 14 to 15 inch laptops 65 to 100 watts, and large performance laptops up to 140. You also need a cable rated for the wattage, since a standard 3 A cable caps the connection at 60 watts. Barrel-jack laptops need an AC outlet."
          }
        },
        {
          "@type": "Question",
          "name": "Can I take a power bank on a plane?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, in your carry-on only, if it is 100 Wh or less, which is roughly 27,000 mAh or less. Banks between 100 and 160 Wh need airline approval and are usually limited to two per passenger. Anything over 160 Wh, including every power station in this guide, is not allowed at all. Make sure the capacity is printed legibly on the case, and check your airline's current in-flight policy."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a power bank hold its charge in storage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A healthy lithium-ion bank typically loses a few percent of its charge per month, so it is still mostly full after a few months but noticeably lower after six months to a year. Heat speeds both self-discharge and permanent aging, so store banks indoors. Top up every three months or so, and retire any bank that swells, cracks or gets hot while idle."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Power & Generators",
    tags: [
      "portable chargers for power outages",
      "power bank for power outage",
      "emergency phone charger",
      "mah to wh",
      "usb-c power delivery",
      "power bank airline limit"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated November 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Portable Chargers</span> for Power Outages
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          When the lights go out, your phone becomes your flashlight, radio and lifeline. Here is how to turn mAh into real phone charges, which USB-C wattage you need, and six chargers that keep a household connected from the first hour to the third day.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#anker-737-power-bank"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#top-picks"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Jump to the Picks
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">Alex Rivers</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Home Improvement Editor</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof users="" />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Six Picks</a>
          <a href="#mah-vs-wh" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. mAh vs. Wh</a>
          <a href="#phone-charges" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Phone Charge Math</a>
          <a href="#usb-c" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. USB-C Wattage</a>
          <a href="#essentials" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Phones, Lights, Radios, Medical</a>
          <a href="#car" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Car, Crank and Solar</a>
          <a href="#travel" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. The 100 Wh Rule</a>
          <a href="#kit" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Outage Charging Kit</a>
          <a href="#storage" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Storage and Self-Discharge</a>
          <a href="#choosing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Which One to Buy</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most outages are not dramatic. Within a few hours the real problem is that every phone in the house is draining faster than usual, hunting for a weak signal and doubling as a flashlight. A portable charger is the cheapest piece of outage equipment you can own, and for a short outage it is often the only one you need, as long as you buy it in watt-hours rather than marketing.
        </p>

        <QuickPicks products={PRODUCTS} />


        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Six Chargers, Smallest to Largest
          </h2>

          <p>
            The category spans pocket power banks, laptop banks and 1 kWh power stations that can also run a refrigerator, all sold as portable chargers and labeled in different units. These six widely sold options from Anker, EcoFlow and Jackery are arranged from smallest to largest and described from their manufacturers' published specifications, not hands-on testing. Power banks in particular are revised and renamed often, so check capacity, output wattage and port types on the listing before you buy. The short version: every household should own one 20,000 to 25,000 mAh USB-C bank; step up to a roughly 300 Wh station for longer outages, a CPAP or several people; and buy a 1 kWh unit only if the fridge is part of the plan.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <h3 class="text-white font-black text-lg leading-snug m-0"><span class="block text-[#38BDF8] text-xs font-bold uppercase tracking-wide mb-1 sm:hidden">{product.badge}</span>{product.name}</h3>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && product.reviewCount && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-gray-500 text-sm font-bold">{product.rating}</span>
                    <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} ratings)</span>
                  </div>
                  )}

                  <p class="text-gray-700 leading-relaxed mb-6">{product.description}</p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div class="bg-green-50 rounded-xl p-4">
