const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Leaf Vacuum",
          item: "https://www.allmetalbrake.com/best-leaf-vacuum/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best leaf vacuum for most people?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The WORX WG509 TriVac suits most suburban yards. WORX rates it at an 18:1 mulch ratio, the highest of the handhelds we picked, with a two-stage metal impeller, a 1.2-bushel bag, 9.3 pounds of weight and a 3-year warranty. If you want a bigger bag, the Sun Joe SBJ606E holds 18 gallons; if you want more vacuum airflow, the Toro UltraPlus lists 405 CFM."
          }
        },
        {
          "@type": "Question",
          "name": "Is a leaf vacuum better than a leaf blower?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They do different jobs. A blower moves leaves into piles quickly across open ground; a vacuum picks up and shreds those piles and cleans beds, corners and window wells a blower only scatters. Most 3-in-1 vacuums blow too, so one tool covers a small yard. For big open lawns, a dedicated blower plus a mulching mower usually works better than bagging everything."
          }
        },
        {
          "@type": "Question",
          "name": "What mulch ratio should I look for in a leaf vacuum?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Look for 16:1 or higher on a corded model; that means sixteen bags of loose, dry leaves shrink to one. The WORX WG509 is rated 18:1, while compact cordless models sit lower, around 12:1 on the WORX WG583. Treat ratios as relative, because makers rate them with dry leaves, and owners report less reduction when leaves are damp or mixed with twigs."
          }
        },
        {
          "@type": "Question",
          "name": "Can a leaf vacuum pick up pine needles and acorns?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pine needles go through most leaf vacuums, though they mulch less than broad leaves and can bridge across the intake in thick mats. Acorns, pine cones, sticks and stones are a different story: they jam the tube and can chip or bend the impeller. Rake or pick out hard debris first, and a metal impeller survives the occasional miss far better than plastic."
          }
        },
        {
          "@type": "Question",
          "name": "Are cordless leaf vacuums powerful enough?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For beds, patios and small yards, yes. The WORX WG583 lists 350 CFM on high and the Ryobi 40V mulches at 16:1. Runtime is the limit: Ryobi quotes over 30 minutes on a 4Ah battery, which will not clear a large wooded lot in one go. Owners with big yards keep a second battery charging or use a corded model for the heavy fall cleanup."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a leaf vacuum to clean gutters?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some models support it. Sun Joe sells the SBJ606E as a 4-in-1 with a gutter-cleaning attachment, which lets you blow debris out of gutters from the ground. A standard handheld vac does not reach a roof line safely. If gutter cleaning is a recurring chore, our guide to the <a href=\"/best-gutter-guards/\">best gutter guards</a> covers ways to keep leaves out of gutters in the first place."
          }
        },
        {
          "@type": "Question",
          "name": "How do I stop my leaf vacuum from clogging?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Vacuum only dry leaves, feed the tube into the edge of a pile rather than its center, and keep sticks, cones and stones out. Empty the bag before it is packed full, and shake out fine dust after each session so the bag can breathe. If it jams, unplug it or remove the battery and wait for the impeller to stop before clearing the intake."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Yard & Outdoor Tools",
    tags: [
      "best leaf vacuum",
      "leaf vacuum mulcher",
      "blower vacuum mulcher",
      "cordless leaf vacuum",
      "leaf mulch ratio"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          Best Leaf Vacuum
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          Vacuum, shred and bag leaves instead of raking them. Seven picks ranked by mulch ratio, bag capacity and impeller build, from maker spec sheets and owner reports.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/alex-rivers/" class="font-bold text-gray-900 no-underline hover:underline">Alex Rivers</a></p>
            <p class="text-xs text-gray-500 m-0">Home Improvement Editor &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          Ranked from WORX, Toro, Sun Joe, BLACK+DECKER, Ryobi and Agri-Fab spec sheets, mulch ratios, bag capacities and owner reports; we did not run these leaf vacuums ourselves. No paid placements. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">13 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#short-answer" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>The Short Answer</span></a>
