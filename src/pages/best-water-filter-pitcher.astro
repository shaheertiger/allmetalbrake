                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Standard</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">What it covers</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">What it does not prove</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">NSF/ANSI 42</td>
                    <td class="px-4 py-4 text-gray-700">Chlorine taste and odor, particulates</td>
                    <td class="px-4 py-4 text-gray-700">Any health benefit</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">NSF/ANSI 53</td>
                    <td class="px-4 py-4 text-gray-700">Lead, mercury, cysts, some VOCs, PFOA/PFOS</td>
                    <td class="px-4 py-4 text-gray-700">Every contaminant listed on the box</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">NSF/ANSI 401</td>
                    <td class="px-4 py-4 text-gray-700">Selected pharmaceuticals, pesticides, BPA</td>
                    <td class="px-4 py-4 text-gray-700">Lead or heavy metals</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">NSF/ANSI 473</td>
                    <td class="px-4 py-4 text-gray-700">PFOA and PFOS reduction</td>
                    <td class="px-4 py-4 text-gray-700">Other PFAS compounds by default</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Tested to NSF</td>
                    <td class="px-4 py-4 text-gray-700">One-off lab run to the protocol</td>
                    <td class="px-4 py-4 text-gray-700">Ongoing audited certification</td>
                  </tr>
