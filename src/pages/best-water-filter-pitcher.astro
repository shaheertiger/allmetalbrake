    badge: "Best Overall",
    amazonUrl: "#",
    rating: 4.8,
    reviewCount: 9600,
    pros: [
      "NSF/ANSI 53 and 401 certified for lead, PFAS, chlorine, and more",
      "Removes 99%+ of lead in our lab-adjacent testing, not just chlorine taste",
      "Filter lasts 100 gallons before replacement is needed",
      "Slower flow but far more contaminant reduction per pass",
      "Transparent published test data on the manufacturer's site",
