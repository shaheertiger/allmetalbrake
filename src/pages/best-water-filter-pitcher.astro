  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Water Filter Pitcher Picks",
          item: "https://www.allmetalbrake.com/best-water-filter-pitcher/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which water filter pitcher removes lead?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Look for a cartridge certified to NSF/ANSI 53 for lead specifically, with the claim listed on its performance data sheet. Brita's Elite filter, PUR Plus, ZeroWater and Clearly Filtered all list certified lead reduction. Brita's standard white filter and the Stream filter do not. Always check the current data sheet, because certifications change between cartridge generations and sometimes between pitcher bodies."
          }
        },
        {
          "@type": "Question",
          "name": "Do water filter pitchers remove PFAS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some do. Look for PFOA and PFOS listed under NSF/ANSI 53 or 473 on the data sheet. Clearly Filtered lists broad PFAS reduction, and some other cartridges carry PFOA/PFOS claims. A basic carbon cartridge certified only to Standard 42 should not be relied on for PFAS. For high PFAS levels, an under-sink reverse osmosis system gives a larger margin."
          }
        },
        {
          "@type": "Question",
          "name": "How often should I change a pitcher filter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Change it at the rated gallon capacity or the time limit, whichever comes first. Standard cartridges are usually rated for 40 gallons or about two months, and long-life cartridges for 100 to 120 gallons. A family that drinks two gallons a day reaches 40 gallons in under three weeks, so track volume rather than relying only on the calendar indicator."
          }
        },
        {
          "@type": "Question",
          "name": "What makes a pitcher filter so slowly?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "New cartridges often hold trapped air, so soak them as the instructions say. Dense carbon blocks certified for lead and PFAS are slower by design, often several minutes per refill. Flow also drops as a cartridge loads up with sediment near the end of its life. If a new filter is still very slow after soaking, reseat it firmly or exchange it."
          }
        },
        {
          "@type": "Question",
          "name": "Is filtered pitcher water safe to leave out?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Filtered water has lost the residual chlorine that kept it sanitary in the pipes, so bacteria can grow faster at room temperature. Keep the pitcher in the refrigerator, drink filtered water within a day or two, and wash the pitcher with mild soap every few weeks. Never leave it in direct sunlight, which encourages algae growth."
          }
        },
        {
          "@type": "Question",
          "name": "Is ZeroWater better than Brita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on your water. ZeroWater removes nearly all dissolved solids and is certified for lead and chromium, so it suits soft or moderate water and anyone who wants neutral taste. In hard water its cartridges exhaust quickly and cost far more per gallon. The Brita Elite filter is cheaper to run and certified for lead, with a longer rated life."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy a pitcher or an under-sink filter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A pitcher suits renters, small households and anyone who drinks under about a gallon or two a day. An under-sink filter costs more up front and needs a simple install, but it delivers faster flow, often costs less per gallon over time and can include reverse osmosis. If you refill a pitcher several times a day, the sink system is usually worth it."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
