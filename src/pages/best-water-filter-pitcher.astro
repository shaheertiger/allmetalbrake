---
import Layout from "../layouts/Layout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { authorSchema, authorName } from "../data/authors";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import ProductCard from "../components/ProductCard.astro";
import PlanTheJob from "../components/PlanTheJob.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Water Filtration Systems for Home",
    "url": "/best-water-filtration-system-for-home/"
  },
  {
    "title": "Best Drain Snakes",
    "url": "/best-drain-snake/"
  },
  {
    "title": "Best Whole House Surge Protectors",
    "url": "/best-whole-house-surge-protector/"
  },
  {
    "title": "Best Circuit Breaker Finders",
    "url": "/best-circuit-breaker-finder/"
  },
  {
    "title": "Best Gas Water Heaters",
    "url": "/best-gas-water-heater/"
  }
];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-02", modified: "2026-11-02" });
const title = "6 Best Water Filter Pitchers (2026): By Certification and Cost";
const description =
  "The Brita Large 10-Cup with Elite filter tops 6 pitchers; it is certified to NSF/ANSI 53 for lead, which Brita's standard and Stream filters are not.";

const PRODUCTS = [
  {
    "id": "brita-elite-10-cup",
    "name": "Brita Large 10-Cup Pitcher with Elite Filter",
    "category": "Long-Life Carbon Block, NSF 42/53/401",
    "badge": "Best Overall",
    "amazonUrl": "",
    "pros": [
      "Elite cartridge rated for 120 gallons, roughly six months",
      "Data sheet lists certified lead reduction plus many other contaminants",
      "Low cost per gallon for a lead-certified filter",
      "Compatible pitcher bodies sold in several sizes",
      "Free cartridge recycling program"
    ],
    "cons": [
      "Pours more slowly than standard Brita filters",
      "Filtered volume per fill is well below the 10-cup label"
    ],
    "bottomLine": "The starting point for most households that want certified lead reduction without paying much to keep it running.",
    "description": "The Elite filter, sold earlier as Longlast+, is why this Brita sits at the top. Its cartridge is rated for 120 gallons, about six months in a typical home, and the performance data sheet lists certified reduction of lead, chlorine, several industrial chemicals, some pesticides and particulates under NSF/ANSI 42, 53 and 401. Pairing a health certification with a long rating keeps the cost per gallon among the lowest of any lead-certified pitcher. The 10-cup body fits most fridge doors, and an indicator on the lid tracks cartridge age. Speed is the trade-off: the denser media passes water more slowly than Brita's basic white cartridge, and owners commonly report waiting several minutes per refill. As with any reservoir pitcher, each fill yields closer to five or six cups of filtered water. A cheaper standard cartridge is enough if taste is all you want, but in an older home with lead risk, this is where most people should start."
  },
  {
    "id": "clearly-filtered-pitcher",
    "name": "Clearly Filtered 10-Cup Water Filter Pitcher",
    "category": "Dense Carbon Block, Broad Contaminant Claims",
    "badge": "Best for PFAS",
    "amazonUrl": "",
    "pros": [
      "Lists reduction of a very wide range of contaminants, PFOA/PFOS included",
      "Brand lists third-party certification to NSF/ANSI 42, 53, 401 and 473",
      "Claims fluoride reduction, rare for a pitcher",
      "Cartridge rated for 100 gallons"
    ],
    "cons": [
      "Costly cartridges, roughly $45-$55 each",
      "Slow flow, more so as the cartridge ages",
      "Tall body can be a squeeze in fridge doors"
    ],
    "bottomLine": "The strongest pitcher for PFAS and wide-ranging chemical concerns, provided you can live with the high cartridge price.",
    "description": "Clearly Filtered is built for people who read their water report line by line. The brand lists reduction of hundreds of contaminants, among them lead, PFOA and PFOS, many pesticides and pharmaceuticals, and it also claims fluoride reduction, which almost no other pitcher does. Its certifications to NSF/ANSI 42, 53, 401 and 473 are listed through IAPMO, so check that public listing for the contaminants that concern you. The cartridge is rated for 100 gallons, roughly four months in most homes. Cost is the clear weakness. Replacement filters run roughly $45 to $55 each at the time of writing, close to 50 cents per gallon and about three times the Brita Elite. Flow is slow, and owners commonly report needing 10 minutes or more to empty the reservoir late in a cartridge's life. If your report flags PFAS and an under-sink system is off the table, this is the pitcher to get; for taste alone, it is more than you need."
  },
  {
    "id": "pur-plus-11-cup",
    "name": "PUR Plus 11-Cup Water Filter Pitcher",
    "category": "Carbon + Ion Exchange, NSF 42/53/401",
    "badge": "Best Value Lead Filter",
    "amazonUrl": "",
    "pros": [
      "Data sheet lists lead certification for the PUR Plus cartridge",
      "Low-cost pitcher body and filters stocked almost everywhere",
      "Lists reduction of mercury and some pesticides",
      "Indicator light on the lid for change reminders"
    ],
    "cons": [
      "40-gallon cartridge life means frequent swaps",
      "Some owners report loose lids and drips"
    ],
    "bottomLine": "An inexpensive route to certified lead reduction, as long as you plan for frequent cartridge changes.",
    "description": "According to PUR's performance data, the Plus cartridge is certified for lead and lists reduction of mercury, some pesticides and other chemicals under NSF/ANSI 42, 53 and 401. The pitcher body is cheap, and replacement filters sit on the shelf at most grocery and big-box stores, which helps when you run out on a Sunday night. Its 11-cup design gives a slightly bigger reservoir than standard 10-cup models. Cartridge life is the catch. At 40 gallons, about two months for a light household and nearer three weeks for a busy family, running costs come to around 20 to 30 cents per gallon, more than the Brita Elite. Owners commonly mention lids that shift while pouring and the occasional drip at the spout. Flow sits in the middle, quicker than dense carbon blocks and slower than basic taste-only cartridges. For a renter or small household that wants a lead-certified filter at the lowest entry price, it is a sensible choice."
  },
  {
    "id": "zerowater-10-cup",
    "name": "ZeroWater 10-Cup Ready-Pour Pitcher",
    "category": "5-Stage Ion Exchange, Includes TDS Meter",
    "badge": "Best for High TDS",
    "amazonUrl": "",
    "pros": [
      "Removes nearly all dissolved solids, as the included meter shows",
      "Brand lists certification for lead and chromium reduction",
      "Included TDS meter tells you exactly when to change",
      "Very clean, neutral taste"
    ],
    "cons": [
      "Cartridge life falls steeply in hard water",
      "Removes minerals, which some people find tastes flat",
      "Owners report a fishy smell once cartridges are spent"
    ],
    "bottomLine": "Excellent on soft to moderate water when you want a neutral taste; expensive to run on hard water.",
    "description": "ZeroWater's five-stage cartridge is built around ion exchange resin and removes almost all total dissolved solids. The included meter makes the result visible: fresh water reads at or close to zero, and the cartridge is due for a change when the reading reaches about 6 ppm. ZeroWater lists certification for lead and chromium reduction under NSF/ANSI 53, so it is a real health filter rather than a taste product. Hard water is where the economics fall apart. Dissolved minerals use up the resin, so a cartridge may last 25 to 40 gallons on soft water but only 8 to 15 gallons on water above 300 ppm, which sends the cost per gallon very high. Owners also commonly report a sour or fishy smell when a cartridge is exhausted, a sign to replace it right away. The water tastes very clean but flat, since the calcium and magnesium are gone. Check your tap TDS with the included meter during the first week to see whether it suits your supply."
  },
  {
    "id": "lifestraw-home-pitcher",
    "name": "LifeStraw Home 10-Cup Water Filter Pitcher",
    "category": "Membrane Microfilter + Carbon/Ion Exchange",
    "badge": "Best Glass Option",
    "amazonUrl": "",
    "pros": [
      "Glass body for buyers avoiding a plastic pitcher",
      "Membrane stage aimed at bacteria, parasites and microplastics",
      "Carbon and ion exchange stage for lead and taste",
      "Membrane has a long rated life, separate from the carbon stage"
    ],
    "cons": [
      "Two filter parts to track and replace",
      "Heavier and more breakable than plastic",
      "Flow slows as the membrane loads"
    ],
    "bottomLine": "A good match for buyers who want glass and a microbiological stage, though it costs more to run than a Brita.",
    "description": "The LifeStraw Home pitcher divides filtration between two parts: a hollow-fiber membrane microfilter aimed at bacteria, parasites and microplastics, and a carbon and ion exchange stage aimed at lead, chlorine and other chemicals. LifeStraw lists the carbon stage at about 40 gallons and the membrane at several hundred, so each is replaced on its own schedule. The popular version has a glass body, which appeals to anyone avoiding plastic and looks better on the counter. Weight and fragility come with the glass, and a full pitcher is noticeably heavier to lift off a fridge shelf. Flow is moderate when new and slows as the membrane traps particles. Certified claims differ by cartridge version, so check LifeStraw's current data sheet for the exact list. On city water the membrane adds little, because treated water is already disinfected. It earns its spot for households on a well with a clean, safe lab result, or for anyone who simply wants glass."
  },
  {
    "id": "brita-stream",
    "name": "Brita Stream Filter-as-You-Pour Pitcher",
    "category": "Filter-as-You-Pour Carbon, NSF 42",
    "badge": "Fastest Pour",
    "amazonUrl": "",
    "pros": [
      "Pour straight after filling, with no wait",
      "No top reservoir, so more of the volume is drinkable",
      "Low-cost replacement filters",
      "Simple, lightweight design"
    ],
    "cons": [
      "Certified for chlorine taste and odor, not lead",
      "Pours more slowly than a plain jug"
    ],
    "bottomLine": "The pitcher for taste-only problems and households that will not wait, not for lead or PFAS worries.",
    "description": "Brita Stream reverses the usual layout. Rather than a reservoir draining down through a cartridge, it filters water on its way out of the spout, so you can fill it and pour right away. That fixes the complaint people make most about pitchers, the wait. With no upper reservoir, the whole body holds water you can drink. Certification is the limit. The Stream cartridge carries an NSF/ANSI 42 listing for chlorine taste, odor and particulates and is not a lead filter, so it belongs in homes where the water is safe and the problem is taste or smell. Filters are rated for 40 gallons, about two months, and cost little. Because the filter sets the pour speed, filling a large bottle takes longer than from a plain jug. If your water report is clean and the family drinks from the tap because nobody waits for a pitcher, this breaks the habit."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.allmetalbrake.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: "https://www.allmetalbrake.com/best-of/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Water Filter Pitcher Picks",
          item: "https://www.allmetalbrake.com/best-water-filter-pitcher/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Which water filter pitcher removes lead?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "One whose cartridge is certified to NSF/ANSI 53 for lead specifically, with that claim on its performance data sheet. Brita's Elite filter, PUR Plus, ZeroWater and Clearly Filtered all list certified lead reduction; Brita's standard white filter and the Stream filter do not. Check the current data sheet, because certifications can change between cartridge generations and sometimes between pitcher bodies."
          }
        },
        {
          "@type": "Question",
          "name": "Do water filter pitchers remove PFAS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some do. Look on the data sheet for PFOA and PFOS listed under NSF/ANSI 53 or 473. Clearly Filtered lists broad PFAS reduction, and a few other cartridges carry PFOA/PFOS claims. Do not rely on a basic carbon cartridge certified only to Standard 42 for PFAS. Where PFAS levels are high, an under-sink reverse osmosis system gives a wider margin."
          }
        },
        {
          "@type": "Question",
          "name": "How often should I change a pitcher filter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At the rated gallon capacity or the time limit, whichever arrives first. Standard cartridges are usually rated for 40 gallons or about two months, and long-life cartridges for 100 to 120 gallons. A family drinking two gallons a day reaches 40 gallons in under three weeks, so track volume instead of trusting the calendar indicator alone."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my water filter pitcher filter so slowly?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "New cartridges often trap air, so soak them as the instructions describe. Dense carbon blocks certified for lead and PFAS are slow by design, often taking several minutes per refill, and flow also falls as a cartridge fills with sediment near the end of its life. If a new filter stays very slow after soaking, reseat it firmly or exchange it."
          }
        },
        {
          "@type": "Question",
          "name": "Is filtered pitcher water safe to leave out?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Filtering removes the residual chlorine that kept the water sanitary in the pipes, so bacteria can grow faster at room temperature. Keep the pitcher in the refrigerator, drink the filtered water within a day or two, and wash the pitcher with mild soap every few weeks. Keep it out of direct sunlight, which encourages algae."
          }
        },
        {
          "@type": "Question",
          "name": "Is ZeroWater better than Brita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "That depends on your water. ZeroWater removes nearly all dissolved solids and is certified for lead and chromium, so it suits soft or moderate water and people who want a neutral taste. On hard water its cartridges run out quickly and cost far more per gallon. The Brita Elite filter is cheaper to run, certified for lead and rated for longer."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy a pitcher or an under-sink filter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A pitcher fits renters, small households and anyone drinking less than about a gallon or two a day. An under-sink filter costs more up front and needs a simple install, but it flows faster, often costs less per gallon over time and can include reverse osmosis. If you refill a pitcher several times a day, the sink system usually pays off."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(Astro.url.pathname),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: "All Metal Brake" },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: authorName(Astro.url.pathname),
    section: "Water, Plumbing & Electrical",
    tags: [
      "best water filter pitcher",
      "lead filter pitcher",
      "nsf 53 pitcher",
      "pfas water filter",
      "brita vs pur vs zerowater",
      "filter cost per gallon"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest m-0 mb-4">
          <span class="text-[#D93A00]">Buyer's Guide</span>
          <span class="text-gray-300" aria-hidden="true">&bull;</span>
          <span class="text-gray-500">Updated {dates.display}</span>
        </p>
        <h1 class="text-[2.1rem] leading-[1.15] sm:text-5xl font-black tracking-tight text-gray-900 m-0">
          The Best Water Filter Pitcher
        </h1>
        <QuickAnswer products={PRODUCTS} />
        <p class="text-lg lg:text-xl text-gray-600 leading-relaxed mt-5 mb-0">
          The Brita pitcher with the Elite filter is the best water filter pitcher for most homes: it is certified to NSF/ANSI 53 for lead, and its cartridge is rated for 120 gallons. What is in your water changes the pick, since PFAS, hard water and taste-only problems each favor a different cartridge. Below, six pitchers are compared on certification, cost per gallon, pour speed and fit.
        </p>
        <!-- Author & Meta -->
        <div class="flex items-center gap-3 mt-7">
          <AuthorAvatar size={40} />
          <div class="min-w-0">
            <p class="text-sm text-gray-600 m-0">Written by <a href="/authors/shaheer-ali-khan/" class="font-bold text-gray-900 no-underline hover:underline">Shaheer Ali Khan</a></p>
            <p class="text-xs text-gray-500 m-0">Materials &amp; Product Performance Specialist &middot; Updated {dates.display}</p>
          </div>
          <SocialProof users="" />
        </div>
        <div class="flex items-center gap-4 mt-6">
          <TrustBadge />
          <span class="flex-1 h-px bg-gray-300"></span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-3 mb-0">
          Based on NSF/ANSI claims from each brand's performance data sheet, rated cartridge life and owner feedback. Not hands-on tested. No paid placements. <a href="/how-we-test/" class="font-bold text-gray-900 underline">Read how we pick</a>
        </p>
      </div>
    </header>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 pt-8">
      <details open class="group bg-white border border-gray-200 rounded-2xl px-5 pt-4 pb-2">
        <summary class="flex items-center gap-3 pb-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
          <span class="font-bold text-gray-900">In This Guide</span>
          <span class="text-xs font-semibold text-gray-400">12 sections</span>
          <svg class="w-5 h-5 ml-auto text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6" /></svg>
        </summary>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
              <a href="#short-answer" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">1.</span><span>The Short Answer</span></a>
              <a href="#top-picks" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">2.</span><span>The 6 Best Pitchers</span></a>
              <a href="#certifications" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">3.</span><span>What Certification Means</span></a>
              <a href="#what-to-remove" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">4.</span><span>Which Filter Your Water Needs</span></a>
              <a href="#cost-per-gallon" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">5.</span><span>Cost Per Gallon</span></a>
              <a href="#filter-types" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">6.</span><span>Carbon vs Ion Exchange vs Membrane</span></a>
              <a href="#daily-use" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">7.</span><span>Pour Speed and Fridge Fit</span></a>
              <a href="#filter-changes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">8.</span><span>When to Change Cartridges</span></a>
              <a href="#pitcher-limits" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">9.</span><span>What a Pitcher Cannot Do</span></a>
              <a href="#cleaning" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">10.</span><span>How to Clean a Pitcher</span></a>
              <a href="#mistakes" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">11.</span><span>Common Mistakes</span></a>
              <a href="#faq" class="flex items-baseline gap-3 py-2.5 border-t border-gray-100 text-[15px] text-gray-700 hover:text-[#1E90FF] no-underline"><span class="w-6 shrink-0 text-gray-400 font-semibold">12.</span><span>FAQ</span></a>
        </nav>
      </details>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Chlorine taste is why most people buy a filter pitcher, and nearly any pitcher solves it. Lead, PFAS and the other contaminants you cannot taste are the harder problem, and on those the difference between cartridges is huge. One rule settles it: open the performance data sheet, find the NSF/ANSI 53 and 401 claims for the exact contaminant you care about, and disregard everything printed on the front of the box.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Best Water Filter Pitcher: The Short Answer
          </h2>

          <p>
            For most homes the <strong>Brita with the Elite filter</strong> is the pick: it is certified for lead under NSF/ANSI 53 and costs about 13 to 17 cents per gallon to run. Choose <strong>Clearly Filtered</strong> when PFAS is the worry, <strong>PUR Plus</strong> for the lowest entry price on a lead filter, <strong>ZeroWater</strong> for soft water and a neutral taste, <strong>LifeStraw Home</strong> for glass, and <strong>Brita Stream</strong> when taste is the only problem. The table compares certification, cartridge life and running cost.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pitcher</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Certified for (per brand)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Rated cartridge life</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Approx. cost per gallon</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Brita with Elite filter</td>
                    <td class="px-4 py-4 text-gray-700">Most homes, lead</td>
                    <td class="px-4 py-4 text-gray-700">NSF/ANSI 42, 53, 401, incl. lead</td>
                    <td class="px-4 py-4 text-gray-700">120 gal / 6 months</td>
                    <td class="px-4 py-4 text-gray-700">13-17 cents</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Clearly Filtered</td>
                    <td class="px-4 py-4 text-gray-700">PFAS and broad chemicals</td>
                    <td class="px-4 py-4 text-gray-700">NSF/ANSI 42, 53, 401, 473 (IAPMO)</td>
                    <td class="px-4 py-4 text-gray-700">100 gal / 4 months</td>
                    <td class="px-4 py-4 text-gray-700">45-55 cents</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
