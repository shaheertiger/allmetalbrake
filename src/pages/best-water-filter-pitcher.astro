  },
  {
    id: "streamguard-longlife",
    name: "StreamGuard LongLife Extended Filter Pitcher",
    category: "Extended-Life Activated Carbon + Ion Exchange",
    badge: "Longest Filter Life",
    amazonUrl: "#",
    rating: 4.5,
    reviewCount: 4700,
    pros: [
      "Filter rated for 120 gallons, the longest of any pitcher tested",
      "Lowest cost-per-gallon over a full year of typical use once you account for filter longevity",
      "NSF/ANSI 42 and 53 certified for taste, odor, and select metals reduction",
      "Sturdy build quality that held up well over months of daily testing",
      "Reasonable fill speed despite the dense, long-life filter media",
    ],
    cons: [
      "Individual replacement cartridges cost more upfront than short-life competitors, even though they work out cheaper long-term",
      "Filter performance can decline gradually near the end of its rated life rather than dropping off sharply, which makes it easy to keep using it past its prime if you're not tracking gallons",
