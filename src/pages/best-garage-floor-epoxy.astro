                <p class="text-gray-400 text-xs mt-1">Years lifespan (DIY kit)</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">20+</p>
                <p class="text-gray-400 text-xs mt-1">Years (100% solids)</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">1 day</p>
                <p class="text-gray-400 text-xs mt-1">Typical application time</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#FF4500]">$3–$12</p>
                <p class="text-gray-400 text-xs mt-1">Per sq ft installed</p>
