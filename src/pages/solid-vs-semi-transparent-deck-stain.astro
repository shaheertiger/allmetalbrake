---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/solid-vs-semi-transparent-deck-stain.html?raw';

const title = "Solid vs Semi-Transparent Deck Stain: Which Should You Use?";
const description = "Semi-transparent soaks in and fades; solid sits on top and can peel. Compare lifespan, grain, maintenance and switching later to pick the right deck stain.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
