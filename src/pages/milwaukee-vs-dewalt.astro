                    <td class="px-4 py-4 text-gray-700">FLEXVOLT 60V MAX</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Premium tool line</td>
                    <td class="px-4 py-4 text-gray-700">FUEL</td>
                    <td class="px-4 py-4 text-gray-700">XR, plus ATOMIC compact</td>
                  </tr>
