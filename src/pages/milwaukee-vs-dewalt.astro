                    <td class="px-4 py-4 text-gray-700">FLEXVOLT 60V MAX</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Premium tool line</td>
                    <td class="px-4 py-4 text-gray-700">FUEL</td>
                    <td class="px-4 py-4 text-gray-700">XR, plus ATOMIC compact</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Standard tool warranty</td>
                    <td class="px-4 py-4 text-gray-700">5 years limited on most M18/M12 tools</td>
                    <td class="px-4 py-4 text-gray-700">3 years limited</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Extras</td>
                    <td class="px-4 py-4 text-gray-700">Tool tracking via ONE-KEY</td>
                    <td class="px-4 py-4 text-gray-700">90-day money back, 1 year free service</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Main US retail</td>
                    <td class="px-4 py-4 text-gray-700">Home Depot, pro distributors, specialty dealers</td>
                    <td class="px-4 py-4 text-gray-700">Home Depot, Lowe's, Amazon, Walmart, Ace, independents</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Strongest in</td>
                    <td class="px-4 py-4 text-gray-700">Plumbing, electrical and automotive tools</td>
                    <td class="px-4 py-4 text-gray-700">Carpentry, nailers and jobsite saws</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Modular storage</td>
                    <td class="px-4 py-4 text-gray-700">PACKOUT</td>
                    <td class="px-4 py-4 text-gray-700">ToughSystem</td>
                  </tr>
