---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/rust-converter-vs-rust-remover.html?raw';

const title = "Rust Converter vs. Rust Remover — Which to Use | Home Fix Reviews";
const description = "One dissolves rust off to bare metal, the other converts it in place to a paintable black coating. When each is right, and when to use both on one job.";
---

<BaseLayout title={title} description={description} articleCss={true} articleBody={body}>
  <Fragment set:html={body} />
</BaseLayout>
