    section: "Concrete & Masonry Sealers",
    tags: [
      "best concrete sealer",
      "concrete sealer for patio",
      "garage floor sealer",
      "basement concrete sealer",
      "penetrating vs acrylic sealer",
      "outdoor concrete protection"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <header data-hero class="bg-[#F4F6F8] border-b border-gray-200">
      <div class="max-w-3xl mx-auto px-4 pt-10 pb-8 lg:pt-14 lg:pb-10">
