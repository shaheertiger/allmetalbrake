---
import type { Article } from '../lib/types';
import { articleUrl, hubLabel } from '../lib/data';
interface Props { articles: Article[] }
const { articles } = Astro.props;
---
<div class="not-prose grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-4">
  {articles.map((a) => (
    <a href={articleUrl(a)} class="group block rounded-xl border border-slate-200 p-4 hover:border-brand-500 hover:shadow-sm no-underline">
      <p class="text-[11px] font-bold uppercase tracking-wide text-slate-500">{hubLabel(a.hub)}</p>
      <h3 class="mt-1 font-bold text-ink group-hover:text-brand-600 leading-snug">{a.h1}</h3>
      <p class="mt-1.5 text-sm text-slate-500 line-clamp-2">{a.metaDescription}</p>
    </a>
  ))}
</div>
