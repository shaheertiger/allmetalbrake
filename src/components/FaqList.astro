---
import type { FAQ } from '../lib/types';
import { md } from '../lib/md';
interface Props { faqs: FAQ[] }
const { faqs } = Astro.props;
---
<div class="faqs">
  {faqs.map((f) => (
    <details class="faq">
      <summary><h3>{f.q}</h3></summary>
      <div class="faq-a" set:html={md(f.a)} />
    </details>
  ))}
</div>
