---
import type { Pick } from '../lib/types';
import { getProduct, productUrl } from '../lib/data';
import { md } from '../lib/md';
import ProductImage from './ProductImage.astro';
import AmazonButton from './AmazonButton.astro';
import Score from './Score.astro';
import ProsCons from './ProsCons.astro';
interface Props { pick: Pick; index: number }
const { pick, index } = Astro.props;
const p = getProduct(pick.product);
const keys = p.keySpecs?.length ? p.keySpecs : Object.keys(p.specs).slice(0, 4);
---
<div id={`pick-${index}`} class="scroll-mt-20">
<section class="not-prose mt-10">
  <div class="rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="bg-ink text-white px-4 sm:px-5 py-2.5 flex items-center justify-between gap-3">
      <span class="text-xs sm:text-sm font-bold uppercase tracking-wide text-gold">{pick.award}</span>
      <Score score={p.score} />
    </div>
    <div class="p-4 sm:p-5 flex flex-col sm:flex-row gap-5">
      <div class="shrink-0 flex sm:block justify-center">
        <ProductImage product={p} size={400} class="w-44 h-44 rounded-xl" eager={index === 1} />
      </div>
      <div class="flex-1 min-w-0">
        <h3 class="text-xl sm:text-2xl font-extrabold text-ink leading-tight">{index}. {p.name}</h3>
        <p class="mt-1 text-sm text-slate-500">{p.priceBand} · Best for: {p.bestFor}</p>
        <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
          {keys.map((k) => (
            <div><dt class="text-slate-500 text-xs">{k}</dt><dd class="font-semibold text-ink">{p.specs[k]}</dd></div>
          ))}
        </dl>
        <div class="mt-4 flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3">
          <AmazonButton product={p} class="w-full sm:w-auto !py-3 sm:!py-2.5" />
          <a href={productUrl(p)} class="text-sm font-semibold text-brand-600 hover:text-brand-700 text-center sm:text-left py-1">Full specs &amp; score →</a>
        </div>
      </div>
    </div>
  </div>
</section>
<div class="prose mt-5" set:html={md(pick.body)} />
<ProsCons pros={pick.pros ?? p.pros} cons={pick.cons ?? p.cons} />
</div>
