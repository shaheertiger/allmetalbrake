---
import type { Pick } from '../lib/types';
import { getProduct, productUrl } from '../lib/data';
import ProductImage from './ProductImage.astro';
import AmazonButton from './AmazonButton.astro';
import Score from './Score.astro';
interface Props { picks: Pick[] }
const { picks } = Astro.props;
---
<div id="quick-picks" class="not-prose my-6 rounded-2xl border-2 border-gold/60 bg-amber-50/40 overflow-hidden">
  <p class="px-4 sm:px-5 pt-4 text-xs font-bold uppercase tracking-wider text-gold-dark">Our top picks at a glance</p>
  <ol class="divide-y divide-amber-200/70">
    {picks.map((pk, i) => {
      const p = getProduct(pk.product);
      return (
        <li class="flex items-center gap-3 sm:gap-4 px-4 sm:px-5 py-3">
          <span class="hidden sm:flex w-7 h-7 shrink-0 rounded-full bg-ink text-white text-xs font-bold items-center justify-center">{i + 1}</span>
          <ProductImage product={p} size={160} class="w-14 h-14 sm:w-16 sm:h-16 shrink-0 rounded-lg" eager={i < 3} />
          <div class="min-w-0 flex-1">
            <p class="text-[11px] font-bold uppercase tracking-wide text-gold-dark">{pk.award}</p>
            <a href={`#pick-${i + 1}`} class="block font-semibold text-ink hover:text-brand-600 leading-snug no-underline">{p.name}</a>
            <p class="text-xs text-slate-500 mt-0.5 flex items-center gap-2"><Score score={p.score} /> <span>{p.priceBand}</span></p>
          </div>
          <AmazonButton product={p} label="View" class="!px-3 !py-2 !text-sm shrink-0" />
        </li>
      );
    })}
  </ol>
</div>
