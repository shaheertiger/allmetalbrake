---
// Square logo mark in the enthusiastreview.com style: black tile, teal frame, white bolt.
const { class: cls = 'logo-mark' } = Astro.props;
---
<svg class={cls} viewBox="0 0 40 40" aria-hidden="true">
  <rect width="40" height="40" fill="#000" />
  <rect x="7" y="7" width="26" height="26" fill="none" stroke="#53c2be" stroke-width="3" />
  <path d="M22.5 10.5 14 22h5.5l-2 8 8.5-11.5h-5.5z" fill="#fff" />
</svg>
