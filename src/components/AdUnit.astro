---
interface Props {
  variant?: "in-article" | "display" | "top";
  slot?: string;
  style?: string;
}

const { variant = "in-article", slot, style } = Astro.props;

const slotDefaults = {
  "in-article": "",
  display: "",
  top: "",
} as const;

const resolvedSlot = slot ?? slotDefaults[variant];
const resolvedStyle = style ?? (variant === "in-article" ? "display:block; text-align:center;" : "display:block");
const isFluid = variant === "in-article";
---

{isFluid ? (
  <ins class="adsbygoogle"
       style={resolvedStyle}
       data-ad-layout="in-article"
       data-ad-format="fluid"
       data-ad-client="ca-pub-2963693328827195"
       data-ad-slot={resolvedSlot}></ins>
) : (
  <ins class="adsbygoogle"
       style={resolvedStyle}
       data-ad-client="ca-pub-2963693328827195"
       data-ad-slot={resolvedSlot}
       data-ad-format="auto"
       data-full-width-responsive="true"></ins>
)}
<script is:inline>
     (adsbygoogle = window.adsbygoogle || []).push({});
</script>
