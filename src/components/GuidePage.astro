---
// Buyer's guide and brand review body (rendered by src/pages/[slug].astro).
import Base from '../layouts/Base.astro';
import Crumbs from './Crumbs.astro';
import Score from './Score.astro';
import BuyButton from './BuyButton.astro';
import CatIcon from './CatIcon.astro';
import ProductImage from './ProductImage.astro';
import FaqList from './FaqList.astro';
import SectionBody from './SectionBody.astro';
import { SITE } from '../data/site';
import { NICHE } from '../data/niche';
import { getAuthor, authorSchema } from '../data/authors';
import { amazonLink } from '../data/affiliate';
import { publisherRef, productItemList } from '../lib/schema';
import {
  GUIDES, getGuide, seriesOf, sameSubject, subjectKeys, getProduct as findProduct, getProduct, mustProduct, getBrand, categoryOf, productsIn, productsOfBrand, comparesFor,
  guidePath, productPath, comparePath, brandPath, guideUpdated, guidePublished, fmtDate, priceBand, spec,
  readMinutes, guideText, guideQuery, newCtx, inline, plain, slugify, type Guide,
} from '../lib/data';

const { g } = Astro.props as { g: Guide };
const path = guidePath(g);
const ctx = newCtx(path);
const cat = categoryOf(g.category);
const brand = g.brand ? getBrand(g.brand) : undefined;
const author = getAuthor(g.author);
const updated = guideUpdated(g);
const published = guidePublished(g);
const picks = (g.picks ?? []).map((pk) => ({ ...pk, p: mustProduct(pk.id) }));
const top = picks[0];
const isBrand = g.type === 'brand';
const tracked = isBrand && brand ? productsOfBrand(brand.key) : productsIn(g.category);
const pickIds = new Set(picks.map((x) => x.id));
const related = (g.related ?? []).map(getGuide).filter((x): x is Guide => Boolean(x && !x.noindex));
const series = seriesOf(g);
const subjectGuides = sameSubject(g);
// The part this guide is built around (best GPU for the 9800X3D → the 9800X3D): its gear page and compare pages.
const subject = subjectKeys(g.slug).map(findProduct).find((x): x is NonNullable<typeof x> => Boolean(x));
const subjectCompares = subject ? comparesFor(subject.id) : [];
const sameCat = [...subjectGuides, ...GUIDES.filter((x) => x.slug !== g.slug && x.category === g.category && !related.includes(x))]
  .filter((x, i, a) => !related.includes(x) && a.indexOf(x) === i).slice(0, 3);
const shownRelated = [...related, ...sameCat].slice(0, 6);
const moreInCat = GUIDES.filter((x) => x.slug !== g.slug && x.category === g.category && !x.noindex && !shownRelated.includes(x));
const headToHead = [...new Map(picks.flatMap((x) => comparesFor(x.id)).map((c) => [comparePath(c), c])).values()].filter((c) => pickIds.has(c.a) && pickIds.has(c.b));

// Numbered H2 outline (Short Answer first, the Bing rule; then the sister sites' order).
const H = {
  short: `${g.h1}: The Short Answer`,
  about: brand ? `Who ${brand.name} Is` : '',
  how: `How We Ranked ${isBrand && brand ? `the ${brand.name} Lineup` : `These ${cat.label}`}`,
  picks: isBrand && brand ? `The ${brand.name} Lineup, Ranked` : `${g.h1}: Our ${g.picks.length} Picks`,
  specs: 'Spec Sheets Side by Side',
  mentions: 'Notable Mentions',
  mistakes: 'Common Mistakes to Avoid',
  bottom: 'The Bottom Line',
  faq: 'Frequently Asked Questions',
  sources: 'Sources and Recent Updates',
  tracked: isBrand && brand ? `Every ${brand.name} Product We Track` : `All ${cat.label} We Track`,
};
const outline = [
  ['short-answer', H.short],
  ...(g.about?.length ? [['who', H.about]] : []),
  ['how-we-ranked', H.how],
  ['picks', H.picks],
  ['specs', H.specs],
  ...(g.mentions?.length ? [['mentions', H.mentions]] : []),
  ...g.sections.map((s) => [slugify(s.h), s.h]),
  ['mistakes', H.mistakes],
  ['bottom-line', H.bottom],
  ['faq', H.faq],
  ['sources', H.sources],
  ['tracked', H.tracked],
] as [string, string][];
// Sister-site H2s carry their number ("1. Compare the Picks at a Glance"), matching the On this page list.
const num = (id: string) => `${outline.findIndex(([x]) => x === id) + 1}. `;
const words = readMinutes(guideText(g));
const pickAnchor = (id: string) => `pick-${id}`;

const crumbs = [
  { name: 'Home', href: '/' },
  isBrand ? { name: 'Brand Reviews', href: '/best-of/#brand-reviews' } : { name: 'Best Lists', href: '/best-of/' },
  { name: g.h1, href: path },
];
const OG_IMAGE = top?.p.image;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: g.title,
      description: g.description,
      datePublished: published,
      dateModified: updated,
      author: authorSchema(g.author),
      publisher: publisherRef(),
      mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE.url}${path}` },
      ...(OG_IMAGE ? { image: OG_IMAGE } : {}),
      articleSection: cat.label,
      keywords: [...new Set([guideQuery(g), g.h1.toLowerCase(), ...(g.keywords ?? [])])].join(', '),
      inLanguage: 'en-US',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: `${SITE.url}${c.href}` })),
    },
    // Each pick is a full Product + Review (the sister sites' "Product snippets" pattern).
    { ...productItemList(picks.map((x) => x.p), g.h1, g.author) },
    {
      '@type': 'FAQPage',
      mainEntity: g.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a) } })),
    },
  ],
};
---
<Base title={g.title} description={g.description} ogImage={top.p.image} ogType="article" article={{ published, modified: updated, section: cat.label }} jsonLd={jsonLd} noindex={g.noindex}>
  <article class="article">
    <header class="a-head col">
      <Crumbs items={crumbs} />
      <div class="kicker">{isBrand && brand ? `${brand.name} · Brand Review` : cat.label}</div>
      <h1 class="a-title">{g.h1}</h1>
      <p class="dek" set:html={inline(g.dek)} />
      <div class="byline">
        By <a href={`/authors/${author.slug}/`}>{author.name}</a> · Updated <time datetime={updated}>{fmtDate(updated)}</time> · {words} min read
        {published !== updated && <> · First published <time datetime={published}>{fmtDate(published)}</time></>}
      </div>
      <p class="disclosure">
        These picks are researched against {NICHE.pickBasis}; we have not bench-tested them ourselves. When you buy through our links we may earn a commission, at no cost to you. <a href="/how-we-review/">How we score</a> · <a href="/disclosure/">Disclosure</a>
      </p>
    </header>

    <div class="col body lede">
      {g.intro.map((t) => <p set:html={inline(t, ctx)} />)}
    </div>

    <div class="col">
      <section class="shortlist" aria-label="Shortlist">
        <p class="mini">Shortlist: which pick suits you</p>
        <ol>
          {picks.map((x, i) => (
            <li class={x.p.image ? 'has-thumb' : undefined}>
              <span class="sl-n">{i + 1}</span>
              {x.p.image && <ProductImage p={x.p} size={52} class="sl-thumb" />}
              <div class="sl-main">
                <div class="sl-label">{x.label}</div>
                <a class="sl-name" href={`#${pickAnchor(x.id)}`}>{x.p.name}</a>
                <div class="sl-for">{x.bestFor ?? x.p.bestFor}</div>
              </div>
              <div class="sl-side"><Score value={x.p.score.overall} /><span class="sl-price">{priceBand(x.p)}</span><a class="sl-view" href={amazonLink(x.p)} rel="sponsored nofollow noopener" target="_blank">View</a></div>
            </li>
          ))}
        </ol>
      </section>

      <nav class="toc" aria-label="On this page">
        <p class="mini">On this page</p>
        <ol>{outline.map(([id, h]) => <li><a href={`#${id}`}>{h}</a></li>)}</ol>
      </nav>
    </div>

    <div class="col body">
      <h2 id="short-answer">{num('short-answer')}{H.short}</h2>
      <div class="answer-box"><p set:html={inline(g.quickAnswer, ctx)} /></div>
      <div class="table-wrap">
        <table class="picks-table">
          <caption>{g.h1}: picks compared</caption>
          <thead><tr><th>Pick</th><th>Best for</th><th>Skip it if</th><th>Score</th><th>Price</th></tr></thead>
          <tbody>
            {picks.map((x) => (
              <tr>
                <td><span class="tag">{x.label}</span><a href={`#${pickAnchor(x.id)}`}>{x.p.name}</a></td>
                <td>{x.bestFor ?? x.p.bestFor}</td>
                <td>{x.skipIf ?? x.p.skipIf}</td>
                <td><Score value={x.p.score.overall} /></td>
                <td class="nowrap">{priceBand(x.p)}<br /><a class="cell-link" href={productPath(x.p)}>Specs</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {g.about?.length && brand && (
        <>
          <h2 id="who">{num('who')}{H.about}</h2>
          {g.about.map((t) => <p set:html={inline(t, ctx)} />)}
          <p class="fine">{[brand.founded && `Founded ${brand.founded}`, brand.hq && `Headquarters: ${brand.hq}`].filter(Boolean).join(' · ')} · <a href={brandPath(brand)}>All {brand.name} products we track</a></p>
        </>
      )}

      <h2 id="how-we-ranked">{num('how-we-ranked')}{H.how}</h2>
      <p set:html={inline(g.ranking!.intro, ctx)} />
      <ul class="criteria">
        {g.ranking!.criteria.map(([k, v]) => <li><strong>{k}.</strong> <span set:html={inline(v, ctx)} /></li>)}
      </ul>
      {g.ranking!.why && <p set:html={inline(g.ranking!.why, ctx)} />}
      <p class="fine">We track {tracked.length} {isBrand && brand ? `${brand.name} products` : cat.plural}; {picks.length} made this list. Scores are research scores, not lab results. <a href="/how-we-review/">How the {SITE.score} works</a>.</p>

      <h2 id="picks">{num('picks')}{H.picks}</h2>
    </div>

    <div class="col">
      {picks.map((x, i) => (
        <section class="pick" id={pickAnchor(x.id)}>
          <div class="pick-head">
            <ProductImage p={x.p} size={96} buy />
            <div>
              <div class="pick-label">{x.label}</div>
              <h3>{i + 1}. {x.p.name}</h3>
              <div class="pick-meta">{priceBand(x.p)} · Best for: {x.bestFor ?? x.p.bestFor}</div>
            </div>
            <Score value={x.p.score.overall} size="lg" />
          </div>
          <dl class="keyspecs">
            {x.p.specs.slice(0, 4).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
          <p class="skip-if"><strong>Skip it if:</strong> {x.skipIf ?? x.p.skipIf}</p>
          <div class="pick-cta"><BuyButton p={x.p} /><a class="more" href={productPath(x.p)}>Full specs &amp; score →</a></div>
          <div class="body">{x.writeup.map((t) => <p set:html={inline(t, ctx)} />)}</div>
          <div class="proscons">
            <div class="pros"><h4>Pros</h4><ul>{(x.pros?.length ? x.pros : x.p.pros).map((t) => <li>{t}</li>)}</ul></div>
            <div class="cons"><h4>Cons</h4><ul>{(x.cons?.length ? x.cons : x.p.cons).map((t) => <li>{t}</li>)}</ul></div>
          </div>
        </section>
      ))}
    </div>

    <div class="col body">
      <h2 id="specs">{num('specs')}{H.specs}</h2>
      <div class="table-wrap">
        <table class="spec-table">
          <caption>Key specs for every pick, from the manufacturers' spec sheets</caption>
          <thead><tr><th>Model</th>{(g.tableSpecs ?? []).map((s) => <th>{s}</th>)}<th>Score</th><th>Price</th><th>Buy</th></tr></thead>
          <tbody>
            {picks.map((x) => (
              <tr>
                <td><a href={productPath(x.p)}>{x.p.short}</a></td>
                {(g.tableSpecs ?? []).map((s) => <td>{spec(x.p, s) ?? '—'}</td>)}
                <td>{x.p.score.overall}</td>
                <td class="nowrap">{priceBand(x.p)}</td>
                <td class="nowrap"><a class="cell-link" href={amazonLink(x.p)} rel="sponsored nofollow noopener" target="_blank">Amazon →</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {g.mentions?.length && (
        <>
          <h2 id="mentions">{num('mentions')}{H.mentions}</h2>
          {g.mentions.map((m) => {
            const mp = m.id ? getProduct(m.id) : undefined;
            return (
              <div class={`mention${mp ? ' has-thumb' : ''}`}>
                {mp && <ProductImage p={mp} size={72} />}
                <div class="mention-main">
                  <h3>{mp ? <a href={productPath(mp)}>{mp.name}</a> : m.name}</h3>
                  {mp && <p class="mention-meta"><Score value={mp.score.overall} /> · {priceBand(mp)}</p>}
                  <p set:html={inline(m.text, ctx)} />
                </div>
              </div>
            );
          })}
        </>
      )}

      {g.sections.map((s) => (
        <>
          <h2 id={slugify(s.h)}>{num(slugify(s.h))}{s.h}</h2>
          <SectionBody s={s} ctx={ctx} />
        </>
      ))}

      <h2 id="mistakes">{num('mistakes')}{H.mistakes}</h2>
      {(g.mistakes ?? []).map(([k, v]) => (
        <>
          <h3>{k}</h3>
          <p set:html={inline(v, ctx)} />
        </>
      ))}

      <h2 id="bottom-line">{num('bottom-line')}{H.bottom}</h2>
      <p set:html={inline(g.bottomLine, ctx)} />
      <p><BuyButton p={top.p} label={`Check the ${top.p.short} on Amazon`} /></p>

      <h2 id="faq">{num('faq')}{H.faq}</h2>
      <FaqList faqs={g.faqs} ctx={ctx} />

      <h2 id="sources">{num('sources')}{H.sources}</h2>
      <h3>Recent updates</h3>
      <ul><li><time datetime={updated}>{fmtDate(updated)}</time>: picks, prices and specs rechecked.</li></ul>
      {g.sources.length > 0 && (
        <>
          <h3>What this page is based on</h3>
          <ul>{g.sources.map((s) => <li set:html={inline(s)} />)}</ul>
        </>
      )}
      <p class="fine">Spotted a spec that changed or a {NICHE.part} that went out of stock? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>

      <h2 id="tracked">{num('tracked')}{H.tracked}</h2>
      <div class="table-wrap">
        <table class="tracked">
          <thead><tr><th>Product</th><th>{isBrand ? 'Category' : 'Brand'}</th><th>Score</th><th>Price</th><th></th></tr></thead>
          <tbody>
            {tracked.map((p) => (
              <tr class={pickIds.has(p.id) ? 'is-pick' : undefined}>
                <td><a href={productPath(p)}>{p.name}</a>{pickIds.has(p.id) && <span class="tag">On this list</span>}</td>
                <td>{isBrand ? categoryOf(p.category).label : <a href={brandPath(p.brand)}>{getBrand(p.brand).name}</a>}</td>
                <td>{p.score.overall}</td>
                <td class="nowrap">{priceBand(p)}</td>
                <td><a href={amazonLink(p)} rel="sponsored nofollow noopener" target="_blank">Price</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {headToHead.length > 0 && (
        <>
          <h2 class="plain" id="head-to-head">Head-to-Head Comparisons</h2>
          <ul class="link-list">{headToHead.map((c) => <li><a href={comparePath(c)}>{mustProduct(c.a).short} vs {mustProduct(c.b).short}</a></li>)}</ul>
        </>
      )}

      {(subject || subjectGuides.length > 0) && (
        <>
          <h2 class="plain" id="more-for-subject">More for the {subject ? subject.short : g.h1.replace(/^.* for /, '')}</h2>
          <ul class="link-list">
            {subject && <li><a href={productPath(subject)}>{subject.name}: specs, score and price</a></li>}
            {subjectGuides.map((x) => <li><a href={guidePath(x)}>{x.h1}</a></li>)}
            {subjectCompares.map((c) => <li><a href={comparePath(c)}>{mustProduct(c.a).short} vs {mustProduct(c.b).short}</a></li>)}
          </ul>
        </>
      )}

      {series && (
        <>
          <h2 class="plain" id={`more-${series.series.key}`}>{series.series.heading}</h2>
          <ul class="link-list">{series.items.map((x) => <li><a href={guidePath(x)}>{x.h1}</a></li>)}{series.series.hub && <li><a href={series.series.hub.href}>{series.series.hub.text}</a></li>}</ul>
        </>
      )}
    </div>

    <aside class="wrap related">
      <h2 class="section-title">Related Guides</h2>
      <div class="grid grid-3">
        {shownRelated.map((r) => {
          const rp = r.picks?.[0] ? getProduct(r.picks[0].id) : getProduct(r.products?.[0] ?? '');
          return (
            <a class="card" href={guidePath(r)}>
              {rp ? <ProductImage p={rp} size={72} /> : <CatIcon cat={r.category} size={44} />}
              <span class="card-k">{r.type === 'brand' ? 'Brand Review' : r.type === 'article' ? 'Guide' : categoryOf(r.category).label}</span>
              <h3>{r.h1}</h3>
              <span class="card-sub">{r.dek}</span>
              {rp && r.picks?.length && <span class="card-sub">Top pick: {rp.short}</span>}
            </a>
          );
        })}
      </div>
      {moreInCat.length > 0 && (
        <div class="more-in">
          <p class="mini">More in {cat.label}</p>
          <div class="chips">
            {moreInCat.map((r) => <a href={guidePath(r)}>{r.h1}</a>)}
            <a href={`/gear/#${cat.key}`}>All {cat.plural} we track</a>
          </div>
        </div>
      )}
    </aside>

    <div class="sticky-buy" id="sticky-buy" aria-label="Top pick">
      <ProductImage p={top.p} size={40} />
      <span class="sb-text"><span class="sb-k">{top.label} · {SITE.score} {top.p.score.overall}/100 · {priceBand(top.p)}</span><strong>{top.p.name}</strong></span>
      <a class="buy buy-sm" href={amazonLink(top.p)} rel="sponsored nofollow noopener" target="_blank">Check Price</a>
      <button class="sb-close" type="button" aria-label="Dismiss" onclick="this.parentElement.hidden=true">×</button>
    </div>
  </article>
</Base>
