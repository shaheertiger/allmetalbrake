---
import { SITE } from '../data/site';
import { formatDate } from '../lib/data';
interface Props { updated: string; published?: string; minutes?: number }
const { updated, published, minutes } = Astro.props;
---
<div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-500">
  <span>By <a href="/about/" class="font-semibold text-slate-700 hover:text-brand-600 no-underline">{SITE.author}</a></span>
  <span aria-hidden="true">·</span>
  <span>Updated <time datetime={updated}>{formatDate(updated)}</time></span>
  {minutes && <><span aria-hidden="true">·</span><span>{minutes} min read</span></>}
  {published && published !== updated && <span class="sr-only">First published <time datetime={published}>{formatDate(published)}</time></span>}
</div>
<p class="mt-3 text-xs text-slate-500 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2">
  We research every product against its spec sheet, manuals and owner reports. When you buy through our links we may earn a commission, at no cost to you. <a href="/how-we-test/" class="underline">How we score</a> · <a href="/affiliate-disclosure/" class="underline">Disclosure</a>
</p>
