---
// Menu glyph: a product category icon, or one of the extra icons in src/data/nav.ts.
import { CATEGORY } from '../data/categories';
import { EXTRA_ICONS } from '../data/nav';
interface Props { icon: string; size?: number }
const { icon, size = 34 } = Astro.props;
const d = CATEGORY[icon]?.icon ?? EXTRA_ICONS[icon] ?? EXTRA_ICONS.guide;
---
<span class="cat-icon nav-icon" style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 24 24" width={Math.round(size * 0.6)} height={Math.round(size * 0.6)}><path d={d} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" /></svg>
</span>
