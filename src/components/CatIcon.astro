---
// Category glyph used where a product photo would go (no unverified photos on this site).
import { CATEGORY } from '../data/categories';
import { EXTRA_ICONS } from '../data/nav';
interface Props { cat: string; size?: number; label?: string }
const { cat, size = 56, label } = Astro.props;
const d = CATEGORY[cat]?.icon ?? (cat === 'brands' ? EXTRA_ICONS.brand : EXTRA_ICONS.guide);
---
<span class="cat-icon" style={`width:${size}px;height:${size}px`} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <svg viewBox="0 0 24 24" width={Math.round(size * 0.6)} height={Math.round(size * 0.6)}><path d={d} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" /></svg>
</span>
