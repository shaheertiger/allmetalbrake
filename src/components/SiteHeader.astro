---
/** Site-wide header: promo bar, centered wordmark, menu and search, category bar. */
const categories = [
  ['/best-lists/#driveway', 'Driveways & Outdoor'],
  ['/best-lists/#deck-wood', 'Decks & Wood'],
  ['/best-lists/#garage', 'Garage & Basement'],
  ['/best-lists/#stone', 'Stone & Surfaces'],
  ['/best-lists/#tools', 'Tools'],
  ['/guides/', 'How-To Guides'],
];
const main = [
  ['/best-lists/', 'Best Lists'],
  ['/guides/', 'Buying Guides'],
  ['/compare/', 'Compare'],
  ['/about/', 'About Us'],
];
---

<div class="promo-bar"><a href="/best-lists/">The 2026 Best Lists: our top picks in every category &rarr;</a></div>
<header class="site-header">
  <div class="header-inner">
    <button class="hamburger" type="button" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>
    <a href="/" class="logo" aria-label="Home Fix Reviews home">
      <span class="logo-icon"><svg viewBox="0 0 64 64" width="22" height="22" aria-hidden="true"><path d="M32 12 10 31h6v20h12V39h8v12h12V31h6z" fill="currentColor" /></svg></span>
      <span class="logo-text"><strong>homefix<em>reviews</em></strong></span>
    </a>
    <a href="/search/" class="header-search" aria-label="Search">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><circle cx="10" cy="10" r="6.5" fill="none" stroke="currentColor" stroke-width="2.6" /><path d="m15 15 6 6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg>
    </a>
  </div>
  <nav class="category-nav" aria-label="Categories">
    <div class="category-nav-inner">
      {[...categories, ...main.slice(0, 3)].map(([href, label]) => <a href={href}>{label}</a>)}
    </div>
  </nav>
  <div class="mobile-nav">
    {categories.map(([href, label]) => <a href={href}>{label}</a>)}
    <hr />
    {main.map(([href, label]) => <a href={href}>{label}</a>)}
    <a href="/search/">Search</a>
  </div>
</header>
