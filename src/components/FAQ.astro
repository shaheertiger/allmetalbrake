---
import type { FAQ } from '../lib/types';
import { md } from '../lib/md';
interface Props { faqs: FAQ[] }
const { faqs } = Astro.props;
---
<div class="not-prose divide-y divide-slate-200 border-y border-slate-200 mt-4">
  {faqs.map((f, i) => (
    <details class="group py-4" open={i < 2}>
      <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
        <h3 class="min-w-0 font-semibold text-ink text-[1.05rem] leading-snug">{f.q}</h3>
        <span class="shrink-0 w-5 text-center text-slate-500 group-open:rotate-45 transition text-xl leading-none" aria-hidden="true">+</span>
      </summary>
      <div class="prose mt-2 text-[0.98rem]" set:html={md(f.a)} />
    </details>
  ))}
</div>
