---
import type { Product } from '../lib/types';
import { amazonUrl, AFFILIATE_REL } from '../lib/amazon';
interface Props { product: Product; label?: string; class?: string }
const { product, label = 'Check Price on Amazon', class: cls = '' } = Astro.props;
---
<a href={amazonUrl(product)} rel={AFFILIATE_REL} target="_blank" class={`btn-amazon ${cls}`} data-asin={product.asin ?? ''} data-product={product.slug}>
  {label}
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
</a>
