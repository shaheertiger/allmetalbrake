---
import { amazonLink } from '../data/affiliate';
import type { Product } from '../lib/data';
interface Props { p: Product; label?: string; small?: boolean }
const { p, label = 'Check Price on Amazon', small } = Astro.props;
---
<a class={`buy${small ? ' buy-sm' : ''}`} href={amazonLink(p)} rel="sponsored nofollow noopener" target="_blank">{label}</a>
