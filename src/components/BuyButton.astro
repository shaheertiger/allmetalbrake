---
import type { Product } from '../lib/types';
import { amazonUrl, AFFILIATE_REL } from '../lib/amazon';
interface Props { p: Product; label?: string; small?: boolean }
const { p, label = 'Check Price on Amazon', small } = Astro.props;
---
<a class={`buy${small ? ' buy-sm' : ''}`} href={amazonUrl(p)} rel={AFFILIATE_REL} target="_blank" data-asin={p.asin ?? ''} data-product={p.slug}>{label}</a>
