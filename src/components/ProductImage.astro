---
// The product's official Amazon photo (src/data/catalog.json), or the category icon when we
// hold no verified listing. Links to Amazon when `buy` is set.
import CatIcon from './CatIcon.astro';
import { amazonLink } from '../data/affiliate';
import type { Product } from '../lib/data';
interface Props { p: Product; size?: number; buy?: boolean; eager?: boolean; class?: string }
const { p, size = 64, buy = false, eager = false, class: cls } = Astro.props;
const img = p.image;
---
{img ? (
  buy ? (
    <a class={`p-img${cls ? ` ${cls}` : ''}`} style={`width:${size}px;height:${size}px`} href={amazonLink(p)} rel="sponsored nofollow noopener" target="_blank">
      <img src={img} alt={p.name} width={size} height={size} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </a>
  ) : (
    <span class={`p-img${cls ? ` ${cls}` : ''}`} style={`width:${size}px;height:${size}px`}>
      <img src={img} alt={p.name} width={size} height={size} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </span>
  )
) : (
  <CatIcon cat={p.category} size={size} />
)}
