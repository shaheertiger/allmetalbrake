---
// The product's Amazon photo, or the category icon when we hold no verified listing.
// Links to Amazon when `buy` is set.
import CatIcon from './CatIcon.astro';
import type { Product } from '../lib/types';
import { amazonImage, amazonUrl, AFFILIATE_REL } from '../lib/amazon';
interface Props { p: Product; size?: number; buy?: boolean; eager?: boolean; class?: string }
const { p, size = 64, buy = false, eager = false, class: cls } = Astro.props;
// Retina: ask Amazon for twice the display size (min 160 so small thumbs stay sharp).
const img = amazonImage(p, Math.max(160, Math.min(1000, size * 2)));
const klass = `p-img${cls ? ` ${cls}` : ''}`;
---
{img ? (
  buy ? (
    <a class={klass} style={`width:${size}px;height:${size}px`} href={amazonUrl(p)} rel={AFFILIATE_REL} target="_blank">
      <img src={img} alt={p.name} width={size} height={size} loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer-when-downgrade" />
    </a>
  ) : (
    <span class={klass} style={`width:${size}px;height:${size}px`}>
      <img src={img} alt={p.name} width={size} height={size} loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer-when-downgrade" />
    </span>
  )
) : (
  <CatIcon cat={p.category} size={size} label={p.name} />
)}
