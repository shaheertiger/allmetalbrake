---
interface Props { items: { id: string; label: string }[]; variant: 'mobile' | 'desktop' }
const { items, variant } = Astro.props;
---
{variant === 'mobile' ? (
  <details class="not-prose my-6 rounded-xl border border-slate-200 bg-slate-50 p-4 lg:hidden">
    <summary class="cursor-pointer font-semibold text-sm py-1">On this page</summary>
    <ol class="mt-2 text-[15px]">{items.map((it) => <li><a href={`#${it.id}`} class="block py-2 text-slate-600 hover:text-brand-600 no-underline border-b border-slate-200/70 last:border-0">{it.label}</a></li>)}</ol>
  </details>
) : (
  <nav class="sticky top-24 not-prose" aria-label="Table of contents">
    <p class="text-xs font-bold uppercase tracking-wider text-slate-500">On this page</p>
    <ol class="mt-3 space-y-2 text-sm border-l border-slate-200">{items.map((it) => <li><a href={`#${it.id}`} class="block pl-3 -ml-px border-l border-transparent hover:border-brand-600 text-slate-600 hover:text-brand-600 no-underline leading-snug">{it.label}</a></li>)}</ol>
  </nav>
)}
