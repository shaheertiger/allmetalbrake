---
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { h1: string; intro?: string; crumbs: { name: string; url: string }[]; eyebrow?: string }
const { h1, intro, crumbs, eyebrow } = Astro.props;
---
<div class="bg-gradient-to-b from-slate-50 to-white border-b border-slate-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-8">
    <Breadcrumbs items={crumbs} />
    {eyebrow && <p class="mt-5 text-xs font-bold uppercase tracking-wider text-brand-600">{eyebrow}</p>}
    <h1 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-ink">{h1}</h1>
    {intro && <p class="mt-3 max-w-3xl text-lg text-slate-600 leading-relaxed" set:html={intro} />}
  </div>
</div>
