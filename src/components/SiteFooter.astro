---
/** Site-wide footer. */
const categories = [
  ['/best-lists/#driveway', 'Driveways & Outdoor'],
  ['/best-lists/#deck-wood', 'Decks & Wood'],
  ['/best-lists/#garage', 'Garage & Basement'],
  ['/best-lists/#stone', 'Stone & Surfaces'],
  ['/best-lists/#tools', 'Tools'],
  ['/guides/', 'How-To Guides'],
];
const popular = [
  ['/best-driveway-sealer/', 'Best Driveway Sealers'],
  ['/best-deck-stain-reviews/', 'Best Deck Stains'],
  ['/best-garage-floor-epoxy/', 'Best Garage Floor Epoxy'],
  ['/best-concrete-sealer/', 'Best Concrete Sealers'],
  ['/milwaukee-vs-dewalt/', 'Milwaukee vs. DeWalt'],
];
const company = [
  ['/about/', 'About Us'],
  ['/contact/', 'Contact'],
  ['/affiliate-disclosure/', 'Affiliate Disclosure'],
  ['/privacy/', 'Privacy Policy'],
  ['/terms/', 'Terms of Use'],
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">
          <span class="logo-icon"><svg viewBox="0 0 64 64" width="22" height="22" aria-hidden="true"><path d="M32 12 10 31h6v20h12V39h8v12h12V31h6z" fill="currentColor" /></svg></span>
          <span class="logo-text"><strong>homefix<em>reviews</em></strong></span>
        </a>
        <p>Plain-spoken reviews and buying guides for driveway, deck, garage, basement and workshop projects.</p>
      </div>
      <div class="footer-col"><h2>Categories</h2><ul>{categories.map(([h, t]) => <li><a href={h}>{t}</a></li>)}</ul></div>
      <div class="footer-col"><h2>Popular</h2><ul>{popular.map(([h, t]) => <li><a href={h}>{t}</a></li>)}</ul></div>
      <div class="footer-col"><h2>Company</h2><ul>{company.map(([h, t]) => <li><a href={h}>{t}</a></li>)}</ul></div>
    </div>
    <p class="disclosure">Home Fix Reviews earns commissions on qualifying purchases made through links on this site, including as an Amazon Associate. Commissions never decide our rankings. <a href="/affiliate-disclosure/">Learn more</a></p>
    <div class="footer-bottom">
      <span>&copy; 2026 Home Fix Reviews. All rights reserved.</span>
      <span>{company.slice(2).map(([h, t]) => <a href={h}>{t}</a>)}</span>
    </div>
  </div>
</footer>
