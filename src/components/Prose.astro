---
import Base from '../layouts/Base.astro';
import Crumbs from './Crumbs.astro';
interface Props { title: string; h1: string; description: string; dek?: string }
const { title, h1, description, dek } = Astro.props;
---
<Base title={title} description={description}>
  <article class="article">
    <header class="col a-head">
      <Crumbs items={[{ name: 'Home', href: '/' }, { name: h1, href: Astro.url.pathname }]} />
      <h1 class="a-title">{h1}</h1>
      {dek && <p class="dek">{dek}</p>}
    </header>
    <div class="col body"><slot /></div>
  </article>
</Base>
