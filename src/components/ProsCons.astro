---
interface Props { pros: string[]; cons: string[] }
const { pros, cons } = Astro.props;
---
<div class="grid sm:grid-cols-2 gap-3 not-prose my-4">
  <div class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-4">
    <p class="text-sm font-bold text-emerald-800">Pros</p>
    <ul class="mt-2 space-y-1.5 text-sm text-slate-700">{pros.map((p) => <li class="flex gap-2"><span class="text-emerald-600 font-bold" aria-hidden="true">+</span><span>{p}</span></li>)}</ul>
  </div>
  <div class="rounded-xl border border-rose-200 bg-rose-50/60 p-4">
    <p class="text-sm font-bold text-rose-800">Cons</p>
    <ul class="mt-2 space-y-1.5 text-sm text-slate-700">{cons.map((p) => <li class="flex gap-2"><span class="text-rose-600 font-bold" aria-hidden="true">−</span><span>{p}</span></li>)}</ul>
  </div>
</div>
