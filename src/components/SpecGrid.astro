---
interface Props { specs: Record<string, string>; }
const { specs } = Astro.props;
const entries = Object.entries(specs ?? {});
---

{entries.length > 0 && (
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-px bg-gray-200 border border-gray-200 rounded-xl overflow-hidden mb-6 not-prose">
    {entries.map(([label, value]) => (
      <div class="bg-gray-50 p-3">
        <p class="text-[10px] font-black uppercase tracking-widest text-gray-500 m-0">{label}</p>
        <p class="text-sm font-bold text-gray-900 m-0">{value}</p>
      </div>
    ))}
  </div>
)}
