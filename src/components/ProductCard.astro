---
// One product in a roundup's ranked list. The #1 pick sits in a gold frame with
// an "Our #1 Pick" tab; every card shows the badge chip, a large photo, a Check
// Price button, a spec list, "Our Take" / "Pros & Cons" tabs and the bottom line.
//
// `specs` is optional on a product: an array of [label, value] pairs from the
// maker's spec sheet. Without it the list falls back to the facts every product
// already carries (features, best-for badge, owner rating).
import { amazonLink } from "../data/affiliate";
import productImages from "../data/product-images.json";

interface Product {
  id: string;
  name: string;
  category?: string;
  badge?: string;
  amazonUrl?: string;
  rating?: number;
  reviewCount?: number;
  pros: string[];
  cons: string[];
  bottomLine?: string;
  description?: string;
  specs?: [string, string][];
}
interface Props {
  product: Product;
  index: number;
  ratingLabel?: string;
}
const { product, index, ratingLabel = "ratings on Amazon" } = Astro.props;
const isTop = index === 0;
const href = amazonLink(product.amazonUrl, product.name, product.id);
const thumb = (productImages as Record<string, string>)[product.id];
// Stored images are 160px thumbnails; Amazon serves the same photo at any size.
const image = thumb?.replace(/\._SL\d+_\./, "._SL500_.");

const specs: [string, string][] =
  product.specs && product.specs.length
    ? product.specs
    : ([
        product.category ? ["Type", product.category] : null,
        product.badge ? ["Best for", product.badge.replace(/^Best (for )?/i, "")] : null,
        product.rating && product.reviewCount
          ? ["Owner rating", `${product.rating} / 5 (${product.reviewCount.toLocaleString()} ${ratingLabel})`]
          : null,
      ].filter(Boolean) as [string, string][]);
const tabId = `pc-${product.id}`;
---

<div id={product.id} class={`scroll-mt-24 not-prose ${isTop ? "mt-10" : "mt-12"}`}>
  <div class={isTop ? "relative border-2 border-[#FACC15] rounded-2xl px-4 sm:px-6 pt-8 pb-6" : "relative border-t border-gray-200 pt-10"}>
    {isTop && (
      <span class="absolute -top-3.5 left-4 sm:left-6 inline-flex items-center gap-1.5 bg-[#FACC15] text-gray-900 text-[11px] font-black uppercase tracking-[0.16em] px-3 py-1.5 rounded-lg">
        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
        Our #1 Pick
      </span>
    )}

    <div class="flex items-start gap-3">
      <h3 class="flex-1 text-2xl font-black text-gray-900 leading-snug m-0">
        <span class="text-gray-400">{index + 1}.</span> {product.name}
      </h3>
      <a href={href} target="_blank" rel="sponsored nofollow noopener" class="shrink-0 mt-1 text-gray-400 hover:text-[#FF4500]" aria-label={`View ${product.name} on Amazon`}>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8" /></svg>
      </a>
    </div>
    {product.category && <p class="text-sm text-gray-500 mt-1 mb-0">{product.category}</p>}

    {product.badge && (
      <span class="inline-flex items-center gap-2.5 mt-4 border-2 border-[#FDE68A] bg-[#FFFBEB] rounded-xl pl-1.5 pr-3 py-1.5">
        <span class="w-7 h-7 rounded-md bg-gray-900 text-white text-[10px] font-black flex items-center justify-center">#{index + 1}</span>
        <span class="font-bold text-gray-900 text-[15px]">{product.badge}</span>
        <svg class="w-4 h-4 text-[#1E90FF]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 3h10v2h3a1 1 0 011 1v2a5 5 0 01-4.6 4.98A5.01 5.01 0 0113 15.9V18h3v3H8v-3h3v-2.1a5.01 5.01 0 01-3.4-2.92A5 5 0 013 8V6a1 1 0 011-1h3V3zm10 4v3.83A3 3 0 0019 8V7h-2zM5 7v1a3 3 0 002 2.83V7H5z" /></svg>
      </span>
    )}

    {image && (
      <a href={href} target="_blank" rel="sponsored nofollow noopener" class="block mt-5 bg-[#F4F6F8] rounded-2xl p-6 sm:p-8">
        <img src={image} alt={product.name} loading={isTop ? "eager" : "lazy"} width="500" height="500" class="mx-auto h-48 sm:h-60 w-auto max-w-full object-contain mix-blend-multiply" />
      </a>
    )}

    <a
      href={href}
      target="_blank"
      rel="sponsored nofollow noopener"
      class="mt-5 flex items-center justify-center gap-2 bg-[#FF4500] hover:bg-[#E63E00] text-white py-3.5 rounded-xl font-black no-underline transition-colors"
    >
      Check Price on Amazon
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
    <p class="text-center text-[11px] text-gray-500 mt-2 mb-0">We may earn a commission, at no cost to you</p>

    {product.rating && product.reviewCount && (
      <div class="flex items-center justify-center gap-2 mt-3">
        <div class="flex text-yellow-400">
          {[...Array(5)].map((_, i) => (
            <svg class={`w-4 h-4 ${i < Math.floor(product.rating!) ? "fill-current" : "text-gray-200"}`} viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
          ))}
        </div>
        <span class="text-gray-700 text-sm font-bold">{product.rating}</span>
        <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} {ratingLabel})</span>
      </div>
    )}

    {specs.length > 0 && (
      <ul class="mt-5 mb-0 pl-5 list-disc marker:text-gray-900 divide-y divide-gray-100 border-y border-gray-100">
        {specs.map(([label, value]) => (
          <li class="py-2.5 text-[15px] text-gray-800"><strong class="text-gray-900">{label}:</strong> {value}</li>
        ))}
      </ul>
    )}

    <div class="mt-6" data-pc-tabs>
      <div class="flex gap-1 border-b border-gray-200" role="tablist">
        <button type="button" role="tab" aria-selected="true" aria-controls={`${tabId}-take`} data-pc-tab={`${tabId}-take`} class="px-3 py-2.5 -mb-px border-0 border-b-2 border-gray-900 bg-transparent text-sm font-bold text-gray-900 cursor-pointer">Our Take</button>
        <button type="button" role="tab" aria-selected="false" aria-controls={`${tabId}-pros`} data-pc-tab={`${tabId}-pros`} class="px-3 py-2.5 -mb-px border-0 border-b-2 border-transparent bg-transparent text-sm font-semibold text-gray-500 cursor-pointer">Pros &amp; Cons</button>
      </div>
      <div id={`${tabId}-take`} role="tabpanel" class="pt-4">
        {product.description && <p class="text-gray-700 leading-relaxed m-0">{product.description}</p>}
      </div>
      <div id={`${tabId}-pros`} role="tabpanel" class="pt-4" hidden>
        <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <p class="text-xs font-black uppercase tracking-widest text-green-700 mb-2">Pros</p>
          <ul class="space-y-2 list-none p-0 m-0">
            {product.pros.map((pro) => (
              <li class="flex items-start gap-2 text-sm text-gray-800">
                <svg class="w-4 h-4 mt-0.5 shrink-0 text-green-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="text-xs font-black uppercase tracking-widest text-red-600 mb-2">Cons</p>
          <ul class="space-y-2 list-none p-0 m-0">
            {product.cons.map((con) => (
              <li class="flex items-start gap-2 text-sm text-gray-800">
                <svg class="w-4 h-4 mt-0.5 shrink-0 text-red-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
        </div>
      </div>
    </div>

    {product.bottomLine && (
      <div class="mt-5 bg-[#EFF6FF] border-l-4 border-[#1E90FF] rounded-r-xl px-4 py-3.5">
        <p class="text-[10px] font-black uppercase tracking-[0.16em] text-[#1E90FF] mb-1">The Bottom Line</p>
        <p class="text-gray-900 font-bold leading-snug m-0">{product.bottomLine}</p>
      </div>
    )}
  </div>
</div>

<script is:inline>
  // One delegated handler for every card's Our Take / Pros & Cons tabs.
  if (!window.__pcTabs) {
    window.__pcTabs = true;
    document.addEventListener("click", function (e) {
      var btn = e.target.closest && e.target.closest("[data-pc-tab]");
      if (!btn) return;
      var group = btn.closest("[data-pc-tabs]");
      group.querySelectorAll("[data-pc-tab]").forEach(function (b) {
        var on = b === btn;
        b.setAttribute("aria-selected", on ? "true" : "false");
        b.classList.toggle("border-gray-900", on);
        b.classList.toggle("text-gray-900", on);
        b.classList.toggle("border-transparent", !on);
        b.classList.toggle("text-gray-500", !on);
        var panel = document.getElementById(b.getAttribute("data-pc-tab"));
        if (panel) panel.hidden = !on;
      });
    });
  }
</script>
