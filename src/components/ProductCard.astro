---
// One product in a roundup's "picks" list. The #1 pick gets a gold frame and an
// "Our #1 Pick" tab; every card shows a large photo, a badge chip, pros and cons
// as labelled rows, a key-specs table and two Check Price buttons.
//
// `specs` is optional on a product: an array of [label, value] pairs taken from
// the maker's spec sheet. Without it the table falls back to the facts every
// product already carries (features, best-for badge, rating).
import { amazonLink } from "../data/affiliate";
import productImages from "../data/product-images.json";

interface Product {
  id: string;
  name: string;
  category?: string;
  badge?: string;
  amazonUrl?: string;
  rating?: number;
  reviewCount?: number;
  pros: string[];
  cons: string[];
  bottomLine?: string;
  description?: string;
  specs?: [string, string][];
}
interface Props {
  product: Product;
  index: number;
  ratingLabel?: string;
}
const { product, index, ratingLabel = "ratings on Amazon" } = Astro.props;
const isTop = index === 0;
const href = amazonLink(product.amazonUrl, product.name, product.id);
const thumb = (productImages as Record<string, string>)[product.id];
// Stored images are 160px thumbnails; Amazon serves the same photo at any size.
const image = thumb?.replace(/\._SL\d+_\./, "._SL500_.");

const specs: [string, string][] =
  product.specs && product.specs.length
    ? product.specs
    : ([
        product.category ? ["Key Features", product.category] : null,
        product.badge ? ["Best For", product.badge.replace(/^Best (for )?/i, "")] : null,
        product.rating && product.reviewCount
          ? ["Owner Rating", `${product.rating} / 5 (${product.reviewCount.toLocaleString()} ${ratingLabel})`]
          : null,
      ].filter(Boolean) as [string, string][]);
---

<div id={product.id} class="scroll-mt-24 mt-16 first:mt-10 not-prose">
  <div
    class={`relative bg-white rounded-3xl px-5 sm:px-8 pt-10 pb-6 ${
      isTop ? "border-[3px] border-[#FACC15] shadow-lg" : "border border-gray-200 shadow-sm"
    }`}
  >
    <span
      class={`absolute -top-4 left-5 sm:left-8 inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-black uppercase tracking-[0.18em] ${
        isTop ? "bg-[#FACC15] text-gray-900" : "bg-gray-900 text-white"
      }`}
    >
      {isTop ? (
        <>
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
          Our #1 Pick
        </>
      ) : (
        <>Pick #{index + 1}</>
      )}
    </span>

    <div class="flex items-start gap-4">
      <h3 class="flex-1 text-2xl sm:text-3xl font-black text-gray-900 leading-tight m-0">
        <span class="text-gray-400">{index + 1}.</span> {product.name}
      </h3>
      <a href={href} target="_blank" rel="sponsored nofollow noopener" class="shrink-0 mt-1 text-gray-500 hover:text-[#FF4500]" aria-label={`View ${product.name} on Amazon`}>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8" /></svg>
      </a>
    </div>
    {product.category && <p class="text-gray-500 text-base sm:text-lg mt-2 mb-0">{product.category}</p>}

    {product.badge && (
      <div class="mt-5">
        <span class="inline-flex items-center gap-3 border-2 border-[#FDE68A] bg-[#FFFBEB] rounded-2xl pl-2 pr-4 py-2">
          <span class="w-8 h-8 rounded-lg bg-gray-900 text-white text-[11px] font-black flex items-center justify-center">#{index + 1}</span>
          <span class="font-black text-gray-900 text-base sm:text-lg">{product.badge}</span>
          <svg class="w-5 h-5 text-[#1E90FF]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 3h10v2h3a1 1 0 011 1v2a5 5 0 01-4.6 4.98A5.01 5.01 0 0113 15.9V18h3v3H8v-3h3v-2.1a5.01 5.01 0 01-3.4-2.92A5 5 0 013 8V6a1 1 0 011-1h3V3zm10 4v3.83A3 3 0 0019 8V7h-2zM5 7v1a3 3 0 002 2.83V7H5z" /></svg>
        </span>
      </div>
    )}

    {image && (
      <a href={href} target="_blank" rel="sponsored nofollow noopener" class="block mt-6 bg-gray-50 rounded-2xl p-6 sm:p-10">
        <img src={image} alt={product.name} loading={isTop ? "eager" : "lazy"} width="500" height="500" class="mx-auto h-56 sm:h-72 w-auto max-w-full object-contain mix-blend-multiply" />
      </a>
    )}

    <a
      href={href}
      target="_blank"
      rel="sponsored nofollow noopener"
      class="mt-6 flex items-stretch rounded-2xl overflow-hidden border-2 border-[#FF4500] no-underline group"
    >
      <span class="flex-1 flex items-center justify-center px-4 py-4 bg-white text-gray-900 font-black text-sm sm:text-base">Check Today's Price</span>
      <span class="flex-1 flex items-center justify-center gap-2 px-4 py-4 bg-[#FF4500] group-hover:bg-[#E63E00] text-white font-black uppercase tracking-widest text-sm sm:text-base transition-colors">
        Amazon
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5" /></svg>
      </span>
    </a>

    {product.rating && product.reviewCount && (
      <div class="flex items-center justify-center gap-2 mt-4">
        <div class="flex text-yellow-400">
          {[...Array(5)].map((_, i) => (
            <svg class={`w-4 h-4 ${i < Math.floor(product.rating!) ? "fill-current" : "text-gray-200"}`} viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
          ))}
        </div>
        <span class="text-gray-700 text-sm font-bold">{product.rating}</span>
        <span class="text-gray-400 text-xs">({product.reviewCount.toLocaleString()} {ratingLabel})</span>
      </div>
    )}

    <div class="mt-8 border border-gray-200 rounded-2xl divide-y divide-gray-200">
      <div class="p-5 sm:p-6 sm:flex sm:gap-6">
        <p class="sm:w-24 shrink-0 text-xl font-black uppercase text-green-700 m-0 mb-3 sm:mb-0">Pros</p>
        <ul class="flex-1 space-y-3 list-none p-0 m-0">
          {product.pros.map((pro) => (
            <li class="flex items-start gap-3 text-gray-800 text-base leading-snug">
              <svg class="w-5 h-5 mt-0.5 shrink-0 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path stroke-linecap="round" stroke-linejoin="round" d="M8 12.5l2.5 2.5L16 9.5" /></svg>
              <span>{pro}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="p-5 sm:p-6 sm:flex sm:gap-6">
        <p class="sm:w-24 shrink-0 text-xl font-black uppercase text-red-600 m-0 mb-3 sm:mb-0">Cons</p>
        <ul class="flex-1 space-y-3 list-none p-0 m-0">
          {product.cons.map((con) => (
            <li class="flex items-start gap-3 text-gray-800 text-base leading-snug">
              <svg class="w-5 h-5 mt-0.5 shrink-0 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 9l6 6M15 9l-6 6" /></svg>
              <span>{con}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {specs.length > 0 && (
      <div class="mt-8">
        <p class="text-sm font-black uppercase tracking-[0.18em] text-gray-900 mb-3">Key Specs</p>
        <table class="w-full border-separate border-spacing-1 text-sm sm:text-base m-0">
          <tbody>
            {specs.map(([label, value]) => (
              <tr>
                <th scope="row" class="w-2/5 bg-[#CFF6FA] text-gray-900 font-black text-center px-3 py-4 align-middle">{label}</th>
                <td class="bg-[#ECFEFF] text-gray-900 font-semibold text-center px-3 py-4 align-middle">{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {product.description && (
      <div class="mt-8">
        <p class="text-sm font-black uppercase tracking-[0.18em] text-gray-900 mb-3">Our Take</p>
        <p class="text-gray-700 leading-relaxed text-base sm:text-lg m-0">{product.description}</p>
      </div>
    )}

    {product.bottomLine && (
      <div class="mt-6 bg-gray-900 rounded-2xl p-5">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-[#FACC15] mb-1">The Bottom Line</p>
        <p class="text-white font-bold leading-snug m-0">{product.bottomLine}</p>
      </div>
    )}

    <a
      href={href}
      target="_blank"
      rel="sponsored nofollow noopener"
      class="mt-6 block bg-[#FF4500] hover:bg-[#E63E00] text-white text-center py-4 rounded-2xl font-black no-underline transition-colors text-lg"
    >
      Check Price on Amazon &rarr;
    </a>
  </div>
</div>
