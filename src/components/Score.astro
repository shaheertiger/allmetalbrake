---
import { SCORE_NAME } from '../data/site';
interface Props { value: number; size?: 'sm' | 'lg' }
const { value, size = 'sm' } = Astro.props;
const tier = value >= 88 ? 'top' : value >= 80 ? 'good' : value >= 72 ? 'ok' : 'low';
---
<span class={`score score-${size} score-${tier}`} title={`${SCORE_NAME}: our research score out of 100`}><b>{value}</b><small>/100</small></span>
