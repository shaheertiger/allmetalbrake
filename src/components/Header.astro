---
// Header in the enthusiastreview.com structure: black topbar, centred logo, a nav strip with
// the "Best Lists" mega menu (icon, label, one-line tagline) and a mobile drawer from the same groups.
import LogoMark from './LogoMark.astro';
import NavIcon from './NavIcon.astro';
import { SITE } from '../data/site';
import { NAV_GROUPS, QUICK_LINKS } from '../data/nav';
const here = Astro.url.pathname;
---
<a class="skip" href="#main">Skip to content</a>
<div class="topbar">
  <div class="wrap">
    <span>{SITE.tagline}</span>
    <nav class="tb-links" aria-label="Site"><a href="/about/">About Us</a><a href="/how-we-test/">How We Score</a><a href="/affiliate-disclosure/">Disclosure</a></nav>
  </div>
</div>
<header class="site-header">
  <div class="wrap">
    <button class="menu-btn" type="button" aria-label="Open menu" aria-controls="drawer" data-drawer-open>
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" /></svg>
      <span class="sr-only">Menu</span>
    </button>
    <a class="logo" href="/" aria-label={`${SITE.name} home`}><LogoMark /><span class="logo-text">All Metal <span>Brake</span></span></a>
    <a class="search-btn" href="/best-of/">Best Lists</a>
  </div>
</header>
<div class="nav-wrap">
  <nav class="navstrip" aria-label="Main">
    <ul>
      <li><button class="mega-btn" type="button" aria-expanded="false" aria-controls="mega">Best Lists <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" /></svg></button></li>
      {QUICK_LINKS.map((n) => <li><a href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a></li>)}
    </ul>
  </nav>
  <div id="mega" class="mega" hidden>
    <div class="wrap">
      <div class="mega-top"><a href="/best-of/">All Best Lists →</a></div>
      <div class="mega-grid">
        {NAV_GROUPS.map((grp) => (
          <div class="mega-col">
            <p class="mega-h">{grp.label}</p>
            <ul>
              {grp.items.map((it) => (
                <li><a href={it.href}><NavIcon icon={it.icon} size={32} /><span><strong>{it.label}</strong><small>{it.tagline}</small></span></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
<div id="drawer" class="drawer">
  <div class="drawer-panel" role="dialog" aria-label="Menu">
    <button class="close" type="button" aria-label="Close menu" data-drawer-close>×</button>
    <p class="drawer-h">Best Lists</p>
    <a href="/">Home</a><a href="/best-of/">All Best Lists</a>
    {NAV_GROUPS.map((grp) => (
      <>
        <p class="drawer-h">{grp.label}</p>
        {grp.items.map((it) => <a href={it.href}>{it.label}<small>{it.tagline}</small></a>)}
      </>
    ))}
  </div>
</div>
<script is:inline>
(() => {
  const drawer = document.getElementById('drawer');
  const btn = document.querySelector('.mega-btn');
  const mega = document.getElementById('mega');
  const setMega = (open) => { btn.setAttribute('aria-expanded', String(open)); mega.hidden = !open; };
  document.querySelector('[data-drawer-open]').addEventListener('click', () => drawer.classList.add('open'));
  document.querySelector('[data-drawer-close]').addEventListener('click', () => drawer.classList.remove('open'));
  drawer.addEventListener('click', (e) => { if (e.target === drawer) drawer.classList.remove('open'); });
  btn.addEventListener('click', (e) => { e.stopPropagation(); setMega(mega.hidden); });
  document.addEventListener('click', (e) => { if (!mega.hidden && !mega.contains(e.target)) setMega(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { setMega(false); drawer.classList.remove('open'); } });
})();
</script>
