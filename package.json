{
  "name": "allmetalbrake",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/page-dates.mjs && node scripts/qa-content.mjs && astro build && node scripts/check-build.mjs && node scripts/build-markdown.mjs",
    "postbuild": "node scripts/submit-indexnow.js --auto",
    "preview": "astro preview",
    "qa": "node scripts/qa-content.mjs",
    "check:links": "node scripts/check-build.mjs",
    "images:fetch": "node --env-file-if-exists=.env scripts/fetch-product-images.mjs",
    "images:review": "node scripts/review-matches.mjs",
    "indexnow": "node scripts/submit-indexnow.js",
    "topics": "node scripts/next-topics.mjs",
    "dates": "node scripts/page-dates.mjs",
    "markdown": "node scripts/build-markdown.mjs",
    "audit:seo": "node scripts/seo-audit.mjs"
  },
  "dependencies": {
    "@dualmark/core": "^0.11.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/functions": "^3.11.3",
    "amazon-creators-api": "^1.2.2",
    "astro": "5.18.2",
    "marked": "15.0.12"
  }
}
