{
  "name": "allmetalbrake",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/qa-content.mjs && astro build && node scripts/check-build.mjs",
    "postbuild": "node scripts/submit-indexnow.js --auto",
    "preview": "astro preview",
    "qa": "node scripts/qa-content.mjs",
