{
  "name": "allmetalbrake",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "validate:words": "node scripts/validate-word-count.js",
    "build": "node scripts/unshallow-for-dates.mjs && node scripts/validate-word-count.js && node scripts/validate-seo.mjs && node scripts/validate-internal-links.js && node scripts/format-audit.mjs && node scripts/build-interlinks.mjs && node scripts/build-top-picks.mjs && astro build && npm run markdown",
    "postbuild": "node scripts/submit-indexnow.js --auto",
    "markdown": "node scripts/build-markdown.mjs --html dist --site https://www.allmetalbrake.com",
    "preview": "astro preview",
    "images:fetch": "node --env-file-if-exists=.env scripts/fetch-product-images.mjs",
    "indexnow": "node scripts/submit-indexnow.js",
    "validate:links": "node scripts/validate-internal-links.js",
    "validate:format": "node scripts/format-audit.mjs",
    "images:fetch:all": "node scripts/extract-all-products.mjs && node --env-file-if-exists=.env scripts/fetch-all-product-images.mjs",
    "images:review": "node scripts/review-matches.mjs",
    "clusters": "node scripts/cluster-report.mjs",
    "interlinks": "node scripts/build-interlinks.mjs --report",
    "topics": "node scripts/next-topics.mjs",
    "validate:new": "node scripts/validate-new-pages.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "validate:all": "npm run validate:words && npm run validate:seo && npm run validate:links && npm run validate:format && npm run validate:new",
    "gsc": "node scripts/gsc-report.mjs",
    "images:status": "node scripts/images-status.mjs",
    "affiliate:verify": "node --env-file-if-exists=.env scripts/verify-affiliate-links.mjs",
    "affiliate:quarantine": "node scripts/build-asin-quarantine.mjs",
    "affiliate:find": "node --env-file-if-exists=.env scripts/find-exact-asins.mjs",
    "affiliate:apply": "node scripts/apply-exact-asins.mjs",
    "top-picks": "node scripts/build-top-picks.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^6.0.2",
    "@dualmark/core": "0.11.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/functions": "3.10.3",
    "amazon-creators-api": "^1.2.2",
    "astro": "^5.17.2",
    "lucide-react": "^0.574.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
